#!/usr/bin/env bash
# =============================================================================
# oc-smoke — unified 4-leg smoke verification & verdict row generator
# =============================================================================
# Cycle 20260915-c14 (editor fire-and-forget pass):
# Wraps live identity verification (oc-smoke-evidence), optional behavioral
# probe execution, and canonical smoke-verdicts.log append into a single command.
#
# Usage: oc-smoke <issue> [--verdict PASS|FAIL] [--probe <cmd>]
#                         [--markers m1,m2] [--evidence <text>]
#   --probe and --evidence are INDEPENDENT and BOTH land in the row (#409:
#   an elif used to drop the whole --evidence argument whenever a probe was
#   supplied — i.e. on exactly the rows the 4-leg rubric requires).
#                         [--target <name>] [--unit <unit>]
#                         [--no-ledger] [--no-close]
#                         [--close-repo <owner/repo>] [--selftest]
#   --close is the DEFAULT on a PASS (#68): the issue is closed on the
#   behavioural receipt (class (d) behavioural-smoke-landed), because a `done`
#   row alone closes the CLAIM — the dispatch predicate then reads the issue as
#   landed and no sweep ever looks at it again, so it stayed OPEN forever.
#   --no-close suppresses it for a multi-leg issue (§D1 LEG-SCOPE) or a probe
#   run that is not the feature's closing verification.
#
# Exit codes:
#   0 Smoke PASS (identity match + probe pass + verdict row recorded)
#   1 Smoke FAIL (identity mismatch or probe failure; verdict row recorded)
#   2 Usage error (missing issue argument, invalid options)
#   3 Precondition/infra failure (state-dir missing, daemon dead)
# =============================================================================
# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -u
set -o pipefail
set -e

SCRIPT_DIR="$OC_TOOLS_DIR"
STATE_DIR="${OC_DEPLOY_STATE_DIR:-${OC_DEV_STATE:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}}"
# #673: the fork checkout, for the by-hand lineage ancestry check. Same
# convention as oc-ship (OC_FORK_REPO, else $HOME/opencrabs).
FORK_REPO="${OC_FORK_REPO:-$HOME/opencrabs}"
CANON_LOG="$STATE_DIR/smoke-verdicts.log"
EVIDENCE_TOOL="$SCRIPT_DIR/smoke/oc-smoke-evidence"
LEDGER_TOOL="$SCRIPT_DIR/state/oc-ledger"

. "$SCRIPT_DIR/lib/oc-log.sh" 2>/dev/null || true
. "$SCRIPT_DIR/lib/oc-gh-close.sh" 2>/dev/null || true
oc_log_init "oc-smoke" "$@"

PROG="oc-smoke"
ISSUE=""
VERDICT="PASS"
PROBE_CMD=""
MARKERS=""
EVIDENCE_TEXT=""
TARGET=""
UNIT="opencrabs-ops"
NO_LEDGER=0
SELFTEST=0
# #68: the close-on-PASS mechanism (class (d) behavioural-smoke-landed). ON by
# default — the owner's 2026-11-15 order is close-on-confirmation, and an opt-in
# flag reproduces exactly the discipline-not-trigger failure this fixes: the
# `done` row closes the CLAIM, the dispatch predicate then reads the issue as
# landed, and NO sweep ever looks at it again, so it stays OPEN forever
# (triage.md §D3: #330/#324/#302/#299/#297 all OPEN while already carrying a
# done row). `--no-close` is the suppression for the two legitimate cases where
# a PASS is not a closing receipt.
CLOSE_MODE=1
# #154: EMPTY means "resolve the board", not "use the fork". The old default was
# a constant, and a constant is a guess wearing a default's clothes: 121 issue
# numbers are held by BOTH live trackers (measured 2026-11-22), so `#68` is the
# fork's closed telegram fix AND this factory's smoke-order issue. Closing on
# the constant therefore aimed at whichever board the author had in mind, and
# where that board's number was already closed it either re-closed an unrelated
# issue or reported a no-op that hid the fact the real issue was never touched.
# Resolution now happens in oc_resolve_close_board (lib/oc-gh-close.sh): an
# explicit flag, then $OC_SMOKE_CLOSE_REPO, then a state-based probe of both
# trackers, and a refusal when the answer is ambiguous or absent.
CLOSE_REPO=""
# #68: the gh seam. Mirrors OC_LEDGER_BIN / OC_SMOKE_EVIDENCE_BIN so the
# selftest drives a fake and never touches the real tracker.
GH_BIN="${OC_GH:-gh}"
LINEAGE="unverified"
LINEAGE_DECLARED=0
# #598: the behavioral leg (leg 4). Empty means "caller did not declare";
# the probe block below sets it from the ACTUAL run, and the final
# resolution sets `absent` when no probe ran at all.  #306 gave lineage an
# `unverified` default on the reasoning that a leg this tool did not check
# must not read as a checked one; leg 4 had no equivalent guard, so a
# probe-less run was durably recorded as a 4-leg verdict.
# #673: `unverified` stays the DEFAULT, but it is no longer the ONLY thing
# this tool can say. The tool already resolves the sha and the deployed
# artifact for its identity leg, so when the caller does NOT declare
# --lineage it ATTEMPTS the ancestry check itself (fetch + merge-base
# --is-ancestor <deployed.sha> origin/main) and records verified/failed;
# it falls back to `unverified` only when the check cannot run. An explicit
# --lineage still overrides (LINEAGE_DECLARED), so the #306 caller contract
# is unchanged — the tool just stops under-claiming when it can do better.
BEHAVIORAL=""

usage() {
  local code="${1:-2}"
  local fd=2
  [ "$code" -eq 0 ] && fd=1
  # NOTE: this delimiter is DELIBERATELY unquoted -- the body expands $PROG.
  # Backticks in the body must therefore be ESCAPED (\`), or the shell runs
  # them: #618 measured `absent` and `na` executing and vanishing from the
  # help text. Do NOT "fix" this to <<'EOF' without removing $PROG first.
  cat <<EOF >&$fd
usage: $PROG <issue> [--verdict PASS|FAIL] [--probe <cmd>]
                 [--markers m1,m2] [--evidence <text>]
                 [--lineage verified|failed|unverified]
                 [--behavioral verified|failed|absent|na]
                 [--target <name>] [--unit <unit>] [--no-ledger]
                 [--close|--no-close] [--close-repo <owner/repo>] | --selftest

Options:
  <issue>             Issue number or slug (e.g. 235 or #235)
  --verdict <V>       Verdict token: PASS (default) or FAIL
  --probe <cmd>       Optional shell command to execute for behavioral proof
  --markers <m1,m2>   Comma-separated presence markers to verify in binary
  --evidence <text>   Prose summary of verification evidence (recorded IN
                      ADDITION to --probe, never instead of it)
  --lineage <tok>     Lineage leg status: verified|failed|unverified. When
                      OMITTED, oc-smoke runs the check itself (#673): best-effort
                      fetch, then \`git merge-base --is-ancestor <deployed.sha>
                      origin/main\` in the fork checkout, recording verified or
                      failed. It falls back to \`unverified\` only when the check
                      cannot run (no checkout, no origin/main ref, unknown
                      object). An explicit --lineage always overrides.
  --behavioral <tok>  Behavioral leg (leg 4) status when NO --probe is given:
                      verified|failed|absent|na. Default: derived — a probe that
                      runs sets verified/failed; with no probe it is \`absent\`,
                      and the row then opens "3-leg smoke pass" rather than
                      claiming a leg it never ran (#598). A \`na\` declaration is
                      the legitimate structural-N/A case the rubric allows.
  --target <name>     Deployment unit the verdict is about (default: live-ops)
  --unit <unit>       Systemd user unit to check (default: opencrabs-ops)
  --no-ledger         Skip automatic done stamp in workers-ledger.json on PASS
  --close             Close the issue on a PASS receipt (DEFAULT). Class (d)
                      behavioural-smoke-landed: the close cites BOTH receipts —
                      the verdict row and the done row written in THIS run.
  --no-close          Suppress the close. For a MULTI-LEG issue whose done row
                      covers only one leg (triage.md §D1 LEG-SCOPE), or a probe
                      run that is not the feature's closing verification.
  --close-repo <slug> Tracker holding the issue. NOT defaulted to a constant
                      (#154): a number is not a board, and 121 numbers live on
                      both trackers at once. Omitted, the board is RESOLVED —
                      \$OC_SMOKE_CLOSE_REPO, else a state-based probe of both
                      live trackers, which picks the one OPEN copy and REFUSES
                      (leaving the issue open) when two are open or none holds
                      it. Every gh call carries -R, because gh inside
                      ~/opencrabs defaults to UPSTREAM.
  --selftest          Run internal test battery

Exit codes:
  0 Smoke PASS
  1 Smoke FAIL
  2 Usage error
  3 Precondition/infra failure
EOF
  exit "$code"
}

die() {
  local code="$1"; shift
  echo "$PROG: ERROR: $*" >&2
  oc_log_finish "$code"
  exit "$code"
}

# Newline-safe append helper matching oc-smoke-evidence
# clip <text> <cap> — bound a field for the line-oriented verdict log and MARK
# any truncation. A silent cut is indistinguishable from a short value: the
# #409 report's row ends mid-word ("post-#28") and a reader cannot tell a
# 200-char probe from a truncated one. The cap is overridable so a lane that
# needs more probe detail does not have to edit the tool.
SMOKE_PROBE_CAP="${OC_SMOKE_PROBE_CAP:-400}"
clip() {
  local txt="$1" cap="$2" len
  len="${#txt}"
  if [ "$len" -le "$cap" ]; then
    printf '%s' "$txt"
  else
    # #588: the cut MUST be character-safe. `cut -c1-N` counts BYTES under
    # C.UTF-8, so a cap landing inside a multi-byte character stamped a
    # dangling lead byte into the durable log and the literal ellipsis after
    # it made the row undecodable — 2 such rows are in the canonical log
    # today, and grep/tail cannot see the damage. oc_clip_chars is bash's
    # character-safe `${var:0:N}`, in lib/oc-log.sh.
    printf '%s…[truncated at %s of %s chars]' "$(oc_clip_chars "$txt" "$cap")" "$cap" "$len"
  fi
}

# flatten <text> — the verdict log is ONE ROW PER LINE, so an embedded newline
# splits a row in two and every later reader sees a malformed record. The probe
# path always flattened; the --evidence path did not, so multi-line prose (the
# normal shape for a by-hand lineage derivation) silently corrupted the log.
# Returns the flattened text; sets FLATTENED=1 when it actually had to.
FLATTENED=0
flatten() {
  local txt="$1" flat
  flat="$(printf '%s' "$txt" | tr '\n\r\t' '   ')"
  [ "$flat" = "$txt" ] || FLATTENED=1
  printf '%s' "$flat"
}

append_log_safe() { # J-5: predicate lives in lib/oc-log.sh (one home)
  oc_append_line_safe "$1" "$2"
}

do_selftest() {
  local d
  d="$(mktemp -d)"
  trap 'rm -rf "$d"' EXIT
  local pass=0 fail=0

  t_ok()  { pass=$((pass+1)); echo "selftest: $1  OK"; }
  t_bad() { fail=$((fail+1)); echo "selftest: $1 FAIL"; }

  # Test 1: Usage without args -> 2
  local rc=0 out=""
  out="$("$0" 2>&1)" || rc=$?
  [ "$rc" -eq 2 ] && t_ok "no args -> 2" || t_bad "no args (rc=$rc out=$out)"

  # Create fake deployed state and fake evidence tool
  mkdir -p "$d/state"
  # #673: a HERMETIC fork checkout, so the new by-hand lineage check is
  # testable and NEVER touches the real $HOME/opencrabs. OC_FORK_REPO pins
  # every invocation below to this fixture; OC_SMOKE_NO_FET keeps it off the
  # network (the fixture has no remote anyway).
  export OC_FORK_REPO="$d/fork"
  export OC_SMOKE_NO_FET=1
  git init -q "$d/fork"
  git -C "$d/fork" config user.email "selftest@example.invalid"
  git -C "$d/fork" config user.name "selftest"
  printf 'base\n' > "$d/fork/f.txt"
  git -C "$d/fork" add f.txt
  git -C "$d/fork" commit -qm "base"
  git -C "$d/fork" branch -M main
  git -C "$d/fork" update-ref refs/remotes/origin/main HEAD
  local FORK_HEAD FORK_ORPHAN
  FORK_HEAD="$(git -C "$d/fork" rev-parse HEAD)"
  # An ORPHAN commit (no parent, hence not an ancestor of origin/main): the
  # negative control proving the auto-check can actually read `failed`.
  # commit-tree writes the object without touching the working tree or HEAD,
  # so there is no checkout churn to trip over.
  FORK_ORPHAN="$(git -C "$d/fork" commit-tree "$(git -C "$d/fork" rev-parse 'HEAD^{tree}')" -m orphan-673)"
  printf '%s\n' "$FORK_HEAD" > "$d/state/deployed.sha"
  printf '{"run_id":34917665398,"source_sha":"%s"}\n' "$FORK_HEAD" > "$d/state/deployed.meta.json"

  cat > "$d/fake-evidence" <<'EOF'
#!/usr/bin/env bash
if [ "${FAKE_EVIDENCE_RC:-0}" != "0" ]; then
  echo "VERDICT: IDENTITY-MISMATCH"
  exit 1
fi
echo "pid 1234"
echo "VERDICT: IDENTITY-MATCH — binary identity + feature presence on live opencrabs-ops"
exit 0
EOF
  chmod +x "$d/fake-evidence"

  # Test 2: Happy path PASS with probe
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 235 --probe "echo probe-ok" --evidence "tested feature" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && grep -q "PASS" "$d/state/smoke-verdicts.log" && grep -q "probe-ok" "$d/state/smoke-verdicts.log" && grep -q "sha=" "$d/state/smoke-verdicts.log"; then
    t_ok "happy path PASS with probe -> 0 and verdict row written"
  else
    t_bad "happy path (rc=$rc out=$out)"
  fi

  # Test 3: Probe failure -> exit 1 and FAIL verdict row
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 236 --probe "exit 4" --evidence "probe must fail" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && grep -q "236" "$d/state/smoke-verdicts.log" && grep -q "FAIL" "$d/state/smoke-verdicts.log"; then
    t_ok "probe failure -> 1 and FAIL verdict row written"
  else
    t_bad "probe failure (rc=$rc out=$out)"
  fi

  # Test 4: Identity mismatch -> exit 1
  rc=0
  out="$(FAKE_EVIDENCE_RC=1 OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 237 --evidence "identity mismatch test" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && case "$out" in *"IDENTITY-MISMATCH"*|*"mismatch"*) true ;; *) false ;; esac; then
    t_ok "identity mismatch from evidence tool -> exit 1"
  else
    t_bad "identity mismatch (rc=$rc out=$out)"
  fi

  # Test 5: Tab separation and fields in verdict row
  local row
  row="$(tail -n 1 "$d/state/smoke-verdicts.log")"
  local fields
  fields="$(printf '%s' "$row" | awk -F'\t' '{print NF}')"
  [ "$fields" -ge 7 ] && t_ok "verdict row has >=7 tab-separated fields" || t_bad "verdict row fields ($fields != >=7)"

  # Test 6: Auto-stamp ledger done on PASS
  cat > "$d/fake-ledger" <<'EOF'
#!/usr/bin/env bash
echo "$@" >> "$OC_DEPLOY_STATE_DIR/fake-ledger.calls"
exit 0
EOF
  chmod +x "$d/fake-ledger"
  touch "$d/state/workers-ledger.json"

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 238 --probe "echo probe-ok" --evidence "ledger auto-stamp test" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && grep -q "stamp done" "$d/state/fake-ledger.calls" && grep -q "#238" "$d/state/fake-ledger.calls"; then
    t_ok "PASS automatically stamps ledger done -> 0"
  else
    t_bad "auto-stamp ledger (rc=$rc out=$out)"
  fi

  # Test 6b (#699): the row the tool WRITES must be ADDRESSED to its issue.
  # Test 6 above only asserts the CALL carries "#238" -- it passed for years
  # while the row itself addressed nothing, because the ref sat mid-sentence.
  # This leg runs the REAL closure predicate against the PRODUCED row (never a
  # re-implementation: oc-claims-single-source fails the battery on a private
  # copy of that predicate under tools/).
  _row="$(sed -n 's/^stamp done //p' "$d/state/fake-ledger.calls" | tail -n 1)"
  if [ -n "$_row" ] && OC699_ROW="$_row" OC699_CLAIMS="$OC_TOOLS_DIR/lib/oc_claims.py" python3 -c '
import importlib.util, os, sys
spec = importlib.util.spec_from_file_location("oc_claims", os.environ["OC699_CLAIMS"])
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)
sys.exit(0 if m.is_addressed(os.environ["OC699_ROW"], 238) else 1)
'; then
    t_ok "the auto-stamped row is ADDRESSED to #238 -- it can close its own claim (#699)"
  else
    t_bad "auto-stamped row is UNADDRESSED and closes nothing: '$_row' (#699)"
  fi
  # CONTROL: the historical wording must be REJECTED by that same predicate, so
  # this leg cannot be satisfied by a predicate that accepts anything.
  if OC699_ROW="smoke PASS verified for issue #238" OC699_CLAIMS="$OC_TOOLS_DIR/lib/oc_claims.py" python3 -c '
import importlib.util, os, sys
spec = importlib.util.spec_from_file_location("oc_claims", os.environ["OC699_CLAIMS"])
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)
sys.exit(0 if m.is_addressed(os.environ["OC699_ROW"], 238) else 1)
'; then
    t_bad "#699 control: the OLD mid-sentence wording still reads as addressed"
  else
    t_ok "#699 control: the old mid-sentence wording is correctly UNADDRESSED"
  fi

  # Test 7: --no-ledger skips ledger stamping on PASS
  rm -f "$d/state/fake-ledger.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 239 --probe "echo probe-ok" --no-ledger 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && [ ! -f "$d/state/fake-ledger.calls" ]; then
    t_ok "--no-ledger suppresses ledger stamp -> 0"
  else
    t_bad "--no-ledger flag (rc=$rc out=$out)"
  fi

  # Test 8: FAIL verdict does not stamp ledger done
  rm -f "$d/state/fake-ledger.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 240 --probe "exit 1" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && [ ! -f "$d/state/fake-ledger.calls" ]; then
    t_ok "FAIL verdict does not stamp ledger done -> 1"
  else
    t_bad "FAIL verdict ledger stamp (rc=$rc out=$out)"
  fi

  # ---- #409: --probe and --evidence are INDEPENDENT (both must land) -------
  # Before this fix an `elif` made the probe branch win, so --evidence was
  # discarded whole. --probe is the NORMAL case (leg 4 of the rubric IS a live
  # probe), so the loss hit exactly the rows that matter. The assertions below
  # are on the ROW, not on stdout, because the row is the artifact of record.
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 241 --probe "echo probe-ok" --evidence "EVIDENCE-MARKER-409" 2>&1)" || rc=$?
  row241="$(grep 'issue=#241' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if grep -q "live_behavior=" <<< "$row241" && grep -q "evidence=EVIDENCE-MARKER-409" <<< "$row241" ; then
    t_ok "probe AND evidence both land in the row (#409)"
  else
    t_bad "probe+evidence both land (rc=$rc row=$row241)"
  fi

  # A raw newline in --evidence used to split the verdict row across lines,
  # because the probe path flattened and the evidence path did not.
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 242 --probe "echo p" --evidence "line one
line two" 2>&1)" || rc=$?
  n242="$(grep -c 'issue=#242' "$d/state/smoke-verdicts.log" || true)"
  if [ "$n242" = "1" ] && grep 'issue=#242' "$d/state/smoke-verdicts.log" | grep -q "line one line two"; then
    t_ok "multi-line --evidence flattened: row stays ONE line (#409)"
  else
    t_bad "multi-line evidence (rc=$rc rows_for_242=$n242)"
  fi

  # Truncation must be MARKED — a silent cut is indistinguishable from a short
  # value, and the #409 row ends mid-word with no way for a reader to tell.
  cat > "$d/longprobe" <<'EOF'
#!/usr/bin/env bash
head -c 500 /dev/zero | tr '\0' 'y'
EOF
  chmod +x "$d/longprobe"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 243 --probe "$d/longprobe" 2>&1)" || rc=$?
  if grep 'issue=#243' "$d/state/smoke-verdicts.log" | grep -q "truncated at 400 of 500 chars"; then
    t_ok "probe truncation is marked with the cap and the true length (#409)"
  else
    t_bad "probe truncation unmarked (rc=$rc row=$(grep 'issue=#243' "$d/state/smoke-verdicts.log" | tail -n1))"
  fi

  # ---- #588: the clip is CHARACTER-safe, not byte-safe --------------------
  # `cut -c1-N` counts BYTES under C.UTF-8 (this box's locale). A cap landing
  # inside a multi-byte character leaves a DANGLING LEAD BYTE, and the literal
  # ellipsis appended after it makes the row undecodable — so a plain
  # `open(path, encoding='utf-8').read()` over the whole durable log dies, while
  # grep/tail see nothing wrong. Measured in production: 2 rows of the canonical
  # smoke-verdicts.log carry `PASS \xe2\xe2\x80\xa6`, byte-identical to what the
  # mutant below produces. The probe emits three U+2705 marks and the cap is 6,
  # which lands INSIDE the first one (5 bytes of "PASS " + 1 byte of a 3-byte
  # char), so the assertion is the discriminating negative the issue names.
  cat > "$d/mbprobe" <<'MBEOF'
#!/usr/bin/env bash
printf 'PASS \342\234\205\342\234\205\342\234\205 tail text here repeated to exceed the cap'
MBEOF
  chmod +x "$d/mbprobe"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 OC_SMOKE_PROBE_CAP=6 \
    "$0" 256 --probe "$d/mbprobe" 2>&1)" || rc=$?
  if python3 -c "import sys; open(sys.argv[1], encoding='utf-8').read()" \
       "$d/state/smoke-verdicts.log" 2>/dev/null; then
    t_ok "a multi-byte probe clipped mid-character leaves the log decodable (#588)"
  else
    t_bad "multi-byte clip corrupted the log — byte-cut, not character-cut (#588)"
  fi

  # The cut must also be a CHARACTER count, so the marker's two units agree:
  # `${#txt}` reports characters, so `of N chars` must match a character cut.
  row256="$(grep 'issue=#256' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if grep -q 'truncated at 6 of 50 chars' <<< "$row256" ; then
    t_ok "the truncation marker reports the CHARACTER count it actually cut (#588)"
  else
    t_bad "truncation marker units disagree (row=$row256)"
  fi

  # A NON-multi-byte clip must still behave exactly as before (no regression on
  # the ordinary path): the #409 leg above is that control, and this one pins
  # the boundary case where the text is shorter than the cap.
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 OC_SMOKE_PROBE_CAP=400 \
    "$0" 257 --probe "$d/mbprobe" 2>&1)" || rc=$?
  row257="$(grep 'issue=#257' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q '✅✅✅' <<< "$row257" \
     && ! grep -q 'truncated' <<< "$row257" ; then
    t_ok "an unclipped multi-byte probe lands INTACT — no spurious marker (#588 control)"
  else
    t_bad "unclipped multi-byte probe (rc=$rc row=$row257)"
  fi

  # ---- #432: target= carries the DEPLOYMENT UNIT, not the subject ---------
  # The law (upstream-merge-runbook.md §Ledger hygiene laws, v0.4.218) fixes ONE
  # meaning for this key — the deployment unit — and ONE default, live-ops. The
  # seed was `Issue #<n>` — the smoke's own SUBJECT — so every run that omitted
  # --target wrote the value the ruling says the key must NOT carry, and the
  # DEFAULT path is the common path: 65 of the 178 non-conforming rows measured
  # in #432 are this tool's own default rather than lane prose. The override
  # must still win. (No leg covered the default before this fixture — which is
  # why the defect lived here unnoticed while oc-smoke-evidence conformed.)
  local row244 row245
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 244 --probe "echo probe-ok" 2>&1)" || rc=$?
  row244="$(grep 'issue=#244' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if grep -q "target=live-ops" <<< "$row244" ; then
    t_ok "no --target writes the deployment unit target=live-ops (#432)"
  else
    t_bad "default target= (rc=$rc row=$row244)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 245 --probe "echo probe-ok" --target unit-x 2>&1)" || rc=$?
  row245="$(grep 'issue=#245' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if grep -q "target=unit-x" <<< "$row245" ; then
    t_ok "--target still overrides the deployment-unit default (#432)"
  else
    t_bad "--target override (rc=$rc row=$row245)"
  fi

  # ---- #436 + #306 (+#673): the row must not contradict its own verdict ----
  # #436: the opening clause was the literal "4-leg smoke pass:" on EVERY row,
  # so all 7 FAIL rows in the canonical log asserted a pass in their first five
  # words — the precise rows a reader consults when something went wrong.
  # #306: the same clause asserted lineage=true for a leg this tool cannot
  # compute. #673 removed that premise: the tool now computes the ancestry
  # itself when the caller declares nothing, so an undeclared --lineage reads a
  # CHECKED token (verified in this fixture) and `unverified` survives only as
  # the cannot-run fallback. Both literals lived on ONE line, so they are
  # covered by ONE fixture. Assertions are on the ROW, never on stdout, because
  # the row is the artifact of record. The PASS-side control is row244, written
  # by the #432 fixture above.
  local row246 row247 row248 row249 v249 row246b row246c v246b
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 246 --probe "echo probe-ok" 2>&1)" || rc=$?
  row246="$(grep 'issue=#246' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q 'evidence="4-leg smoke pass: lineage=verified ' <<< "$row246" ; then
    t_ok "an undeclared --lineage reads the CHECKED token, not unverified (#673)"
  else
    t_bad "auto-check verified (rc=$rc row=$row246)"
  fi

  # #673 NEGATIVE CONTROL: a deployed sha that is NOT an ancestor of
  # origin/main must read `failed` AND force the row to FAIL. Without this leg
  # the auto-check could return `verified` unconditionally and still pass.
  printf '%s\n' "$FORK_ORPHAN" > "$d/state/deployed.sha"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 2461 --probe "echo probe-ok" 2>&1)" || rc=$?
  row246b="$(grep 'issue=#2461' "$d/state/smoke-verdicts.log" | tail -n 1)"
  v246b="$(printf '%s' "$row246b" | awk -F'\t' '{print $2}')"
  if [ "$rc" -eq 1 ] && [ "$v246b" = "FAIL" ] && grep -q 'lineage=failed' <<< "$row246b" ; then
    t_ok "a deployed sha outside origin/main reads lineage=failed and forces FAIL (#673)"
  else
    t_bad "auto-check failed leg (rc=$rc verdict=$v246b row=$row246b)"
  fi
  printf '%s\n' "$FORK_HEAD" > "$d/state/deployed.sha"

  # #673 FALLBACK: with no usable checkout the tool must fall back to
  # `unverified` — the #306 contract (a leg it did not check never reads as
  # checked) is preserved exactly where the check cannot run.
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 OC_FORK_REPO="$d/no-such-repo" \
    "$0" 2462 --probe "echo probe-ok" 2>&1)" || rc=$?
  row246c="$(grep 'issue=#2462' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q 'lineage=unverified ' <<< "$row246c" ; then
    t_ok "no fork checkout -> lineage falls back to unverified (#673/#306)"
  else
    t_bad "auto-check fallback (rc=$rc row=$row246c)"
  fi

  # #70: a LINKED WORKTREE is a git checkout whose `.git` is a FILE, not a
  # directory. A probe shaped `[ -d "$X/.git" ]` answers FALSE on it and
  # silently degrades a real checkout to `unverified`; `rev-parse --git-dir`
  # is the predicate that actually asks "is this a git checkout". This arm is
  # the POSITIVE CONTROL for the fallback above — without it, that arm passes
  # on a tool that never verifies anything at all.
  git -C "$d/fork" worktree add -q -b wt673 "$d/wt" main
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 OC_FORK_REPO="$d/wt" \
    "$0" 2463 --probe "echo probe-ok" 2>&1)" || rc=$?
  row246d="$(grep 'issue=#2463' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q 'lineage=verified ' <<< "$row246d" ; then
    t_ok "a LINKED WORKTREE is recognised as a checkout -> lineage verifies (#70)"
  else
    t_bad "linked-worktree lineage (rc=$rc row=$row246d)"
  fi

  # #70 NEGATIVE CONTROL: an EXISTING directory that is not a git checkout
  # must still fall back to `unverified`. Paired with the arm above, this is
  # what proves the predicate DISCRIMINATES instead of merely answering true.
  mkdir -p "$d/notgit"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 OC_FORK_REPO="$d/notgit" \
    "$0" 2464 --probe "echo probe-ok" 2>&1)" || rc=$?
  row246e="$(grep 'issue=#2464' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q 'lineage=unverified ' <<< "$row246e" ; then
    t_ok "an existing non-git dir still falls back to unverified (#70 control)"
  else
    t_bad "non-git control (rc=$rc row=$row246e)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 247 --verdict FAIL --evidence "smoke of a FAIL" 2>&1)" || rc=$?
  row247="$(grep 'issue=#247' "$d/state/smoke-verdicts.log" | tail -n 1)"
  # #436's property is "the FAIL row NAMES ITS OWN VERDICT and never opens by
  # claiming a pass". The leg count is not that property — #598 made the count
  # vary with whether leg 4 ran — so the assertion is on the verdict token and
  # on the absence of any pass claim, which is what the leg means.
  if grep -qE 'evidence="[34]-leg smoke FAIL: ' <<< "$row247" \
     && ! grep -q 'smoke pass' <<< "$row247" ; then
    t_ok "a FAIL row names its own verdict and never opens by claiming a pass (#436)"
  else
    t_bad "FAIL opening clause (rc=$rc row=$row247)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 248 --probe "echo probe-ok" --lineage verified 2>&1)" || rc=$?
  row248="$(grep 'issue=#248' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if grep -q 'lineage=verified ' <<< "$row248" ; then
    t_ok "a caller-supplied --lineage verified is what the row records (#306)"
  else
    t_bad "--lineage verified (rc=$rc row=$row248)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 249 --probe "echo probe-ok" --lineage failed 2>&1)" || rc=$?
  row249="$(grep 'issue=#249' "$d/state/smoke-verdicts.log" | tail -n 1)"
  v249="$(printf '%s' "$row249" | awk -F'\t' '{print $2}')"
  if [ "$rc" -eq 1 ] && [ "$v249" = "FAIL" ] && grep -q 'lineage=failed' <<< "$row249" ; then
    t_ok "a caller-reported lineage FAIL forces the row to FAIL, not PASS (#306)"
  else
    t_bad "--lineage failed (rc=$rc verdict=$v249 row=$row249)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 250 --lineage bogus 2>&1)" || rc=$?
  if [ "$rc" -eq 2 ]; then
    t_ok "--lineage rejects a token outside verified|failed|unverified -> 2"
  else
    t_bad "--lineage domain check (rc=$rc out=$out)"
  fi

  # ---- #598: the behavioral leg must be stated, never assumed ------------
  # A probe-less run is a 3-leg run. Before this fix every PASS row opened
  # "4-leg smoke pass" regardless, so leg 4 never ran and nothing said so —
  # the same class #306 fixed for lineage. The four arms below are the
  # discriminating set: absent (no probe) / verified (probe passed) /
  # failed (probe failed) / na (declared structural N/A).
  local row251 row252 row253 row254
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 251 --evidence "no probe" 2>&1)" || rc=$?
  row251="$(grep 'issue=#251' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q '3-leg smoke pass: ' <<< "$row251" \
     && grep -q 'behavioral=absent' <<< "$row251" \
     && ! grep -q '4-leg smoke pass' <<< "$row251" ; then
    t_ok "a probe-less run records 3 legs and behavioral=absent, never a 4-leg claim (#598)"
  else
    t_bad "probe-less leg count (rc=$rc row=$row251)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 252 --probe "echo probe-ok" 2>&1)" || rc=$?
  row252="$(grep 'issue=#252' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q '4-leg smoke pass: ' <<< "$row252" \
     && grep -q 'behavioral=verified' <<< "$row252" ; then
    t_ok "a probed run keeps 4 legs and records behavioral=verified (#598 control)"
  else
    t_bad "probed leg count (rc=$rc row=$row252)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 253 --probe "exit 4" 2>&1)" || rc=$?
  row253="$(grep 'issue=#253' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 1 ] && grep -q 'behavioral=failed' <<< "$row253" ; then
    t_ok "a FAILED probe records behavioral=failed (#598)"
  else
    t_bad "failed probe behavioral (rc=$rc row=$row253)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 254 --behavioral na --evidence "structural N/A" 2>&1)" || rc=$?
  row254="$(grep 'issue=#254' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && grep -q 'behavioral=na' <<< "$row254" ; then
    t_ok "a declared structural-N/A leg records behavioral=na and keeps 4 legs (#598)"
  else
    t_bad "behavioral na (rc=$rc row=$row254)"
  fi

  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 255 --behavioral bogus 2>&1)" || rc=$?
  if [ "$rc" -eq 2 ]; then
    t_ok "--behavioral rejects a token outside verified|failed|absent|na -> 2"
  else
    t_bad "--behavioral domain check (rc=$rc out=$out)"
  fi

  # ---- #68: close on a PASS receipt (class (d) behavioural-smoke-landed) ----
  # The `done` row closes the CLAIM; the dispatch predicate then reads the issue
  # as landed and no sweep ever looks at it again, so before this step the issue
  # stayed OPEN forever (triage.md §D3: #330/#324/#302/#299/#297 all OPEN while
  # already carrying a done row). The arms below are a SET — one POSITIVE
  # CONTROL that the close actually runs, then four that it is suppressed for a
  # stated reason, then one that a gh failure cannot touch the verdict. Without
  # the control, every "never closes" arm would pass on a tool whose close block
  # never runs at all.
  cat > "$d/fake-gh" <<'FAKEGHEOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${FAKE_GH_LOG:-/dev/null}"
case "${1:-}" in
  issue)
    case "${2:-}" in
      view)
        if [ "${FAKE_GH_VIEW_RC:-0}" != "0" ]; then
          echo "gh: could not resolve to an issue" >&2
          exit "${FAKE_GH_VIEW_RC}"
        fi
        # #154: per-board state. The real hazard is a number held by BOTH
        # trackers in DIFFERENT states, and a fake that answers one state for
        # every repo cannot express it — the resolver's probe would be
        # untestable. Format: "slug=STATE,slug=STATE". An unlisted board
        # answers ABSENT (empty), which is what a tracker that does not hold
        # the number actually does.
        _repo=""
        for _a in "$@"; do
          case "$_a" in -R) _next=1; continue ;; esac
          [ "${_next:-0}" = "1" ] && { _repo="$_a"; _next=0; }
        done
        if [ -n "${FAKE_GH_STATE_BY_REPO:-}" ]; then
          _hit=""
          IFS=',' read -ra _pairs <<< "$FAKE_GH_STATE_BY_REPO"
          for _p in "${_pairs[@]}"; do
            [ "${_p%%=*}" = "$_repo" ] && _hit="${_p#*=}"
          done
          [ -n "$_hit" ] && { printf '%s\n' "$_hit"; exit 0; }
          exit 0
        fi
        printf '%s\n' "${FAKE_GH_STATE:-OPEN}"
        exit 0 ;;
      close)
        if [ "${FAKE_GH_CLOSE_RC:-0}" != "0" ]; then
          echo "HTTP 500: could not close" >&2
          exit "${FAKE_GH_CLOSE_RC}"
        fi
        echo "closed"
        exit 0 ;;
    esac ;;
esac
exit 0
FAKEGHEOF
  chmod +x "$d/fake-gh"

  # (1) POSITIVE CONTROL: PASS + a done row written in this run closes, with the
  # selected repo and BOTH receipts named in the comment.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 260 --probe "echo probe-ok" --evidence "close on pass" \
    --close-repo leshchenko1979/opencrabs-dev-factory 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] \
     && grep -q 'issue close 260 -R leshchenko1979/opencrabs-dev-factory' "$d/gh.calls" \
     && grep -q 'class (d) behavioural-smoke-landed' "$d/gh.calls" \
     && grep -q 'done #260 smoke PASS verified' "$d/gh.calls" \
     && grep -q 'smoke verdict: PASS' "$d/gh.calls"; then
    t_ok "PASS closes the issue on the selected repo, comment citing BOTH receipts (#68)"
  else
    t_bad "close on PASS (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null))"
  fi

  # (2) FAIL never closes — guard 1.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 261 --probe "exit 1" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; }; then
    t_ok "a FAIL verdict never closes the issue (#68 guard 1)"
  else
    t_bad "FAIL must not close (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null))"
  fi

  # (3) --no-close never closes — the multi-leg / non-closing-probe escape.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 262 --probe "echo probe-ok" --no-close 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; }; then
    t_ok "--no-close suppresses the close and still exits 0 (#68)"
  else
    t_bad "--no-close (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null))"
  fi

  # (4) --no-ledger implies no close — guard 3, and the skip is STATED so it
  # cannot be mistaken for "ran and found it already closed".
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 263 --probe "echo probe-ok" --no-ledger 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; } \
     && case "$out" in *"--no-ledger means no done row"*) true ;; *) false ;; esac; then
    t_ok "--no-ledger writes no done row, so class (d) cannot close — and says so (#68 guard 3)"
  else
    t_bad "--no-ledger close (rc=$rc out=$out)"
  fi

  # (5) Already CLOSED: idempotent — a state read, no second close, rc unchanged.
  rm -f "$d/gh.calls"
  rc=0
  out="$(FAKE_GH_STATE=CLOSED OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 264 --close-repo leshchenko1979/opencrabs --probe "echo probe-ok" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && grep -q 'issue view 264' "$d/gh.calls" \
     && ! grep -q 'issue close' "$d/gh.calls" \
     && case "$out" in *"already CLOSED"*) true ;; *) false ;; esac; then
    t_ok "an already-CLOSED issue gets no second close and keeps rc 0 (#68 guard 4)"
  else
    t_bad "already-closed idempotency (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null))"
  fi

  # (6) A gh close FAILURE must not touch the verdict or the exit code — guard
  # 7. The verdict row is already durable; a close failure is a separate defect,
  # never a retroactive smoke failure.
  rm -f "$d/gh.calls"
  rc=0
  out="$(FAKE_GH_CLOSE_RC=1 OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 265 --close-repo leshchenko1979/opencrabs --probe "echo probe-ok" 2>&1)" || rc=$?
  row265="$(grep 'issue=#265' "$d/state/smoke-verdicts.log" | tail -n 1)"
  if [ "$rc" -eq 0 ] && case "$out" in *"WARNING: close of"*) true ;; *) false ;; esac \
     && grep -q 'issue close 265' "$d/gh.calls" \
     && grep -q 'PASS' <<< "$row265"; then
    t_ok "a failed close keeps rc 0, warns, and leaves the PASS row intact (#68 guard 7)"
  else
    t_bad "close failure must not change the verdict (rc=$rc row=$row265 out=$out)"
  fi

  # (7) An UNREADABLE state is not a licence to write: skip, warn, never blind
  # close. This is the fail-closed arm — a tool that closed on a guess would
  # satisfy (6) and still be wrong.
  rm -f "$d/gh.calls"
  rc=0
  out="$(FAKE_GH_VIEW_RC=1 OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 266 --close-repo leshchenko1979/opencrabs --probe "echo probe-ok" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && ! grep -q 'issue close' "$d/gh.calls" \
     && case "$out" in *"cannot read state"*) true ;; *) false ;; esac; then
    t_ok "an unreadable tracker state SKIPs the close instead of guessing (#68)"
  else
    t_bad "unreadable state must not close blind (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null))"
  fi

  # (8) --close-repo rejects a malformed slug before any tracker call.
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 267 --close-repo not-a-slug 2>&1)" || rc=$?
  if [ "$rc" -eq 2 ]; then
    t_ok "--close-repo rejects a non owner/repo value -> 2 (#68 guard 6)"
  else
    t_bad "--close-repo domain check (rc=$rc out=$out)"
  fi

  # (9) T-7: a probe-less PASS is UNPROVEN — it must NOT close, and must say so.
  # Everything else here is satisfied (PASS, and the fake ledger writes a done
  # row so LEDGER_RC=0), so the ONLY thing withholding the close is the
  # behavioural gate. Without arm (10) this arm would also pass on a tool whose
  # close block never runs at all, which is why the pair ships together.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 268 --evidence "structural only, no probe" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; } \
     && case "$out" in *UNPROVEN*) true ;; *) false ;; esac \
     && case "$out" in *"behavioral=absent"*) true ;; *) false ;; esac; then
    t_ok "a probe-less PASS leaves the issue OPEN and states UNPROVEN (T-7)"
  else
    t_bad "a probe-less PASS leaves the issue OPEN and states UNPROVEN (T-7) — absent behavioural leg must not close (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # (10) POSITIVE CONTROL for T-7: `--behavioral na` is a DECLARED escape — the
  # caller has stated the leg is structurally untestable, so it is not an
  # unproven one and the close proceeds. This is what keeps arm (9) from being
  # satisfiable by refusing every close.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 269 --close-repo leshchenko1979/opencrabs --behavioral na --evidence "declared structural N/A" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && grep -q 'issue close 269' "$d/gh.calls" \
     && ! case "$out" in *UNPROVEN*) true ;; *) false ;; esac; then
    t_ok "a DECLARED --behavioral na still closes — the escape is not the refusal (T-7 control)"
  else
    t_bad "a DECLARED --behavioral na still closes — the escape is not the refusal (T-7 control) — declared na must close (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # (11) T-7 ORDERING: --no-ledger AND no probe together. Both legs are
  # missing, but --no-ledger withholds the close even after a probe is added,
  # so it is the fundamental blocker and must be the one that speaks. This arm
  # is what makes that ordering load-bearing: reverse the two elifs and the
  # note names only the behavioural leg, telling the caller to add --probe —
  # advice that still would not close.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 270 --no-ledger --evidence "structural only, no probe" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; } \
     && case "$out" in *"--no-ledger means no done row"*) true ;; *) false ;; esac \
     && case "$out" in *"ALSO absent"*) true ;; *) false ;; esac; then
    t_ok "--no-ledger AND no probe: the receipt blocker speaks first and both legs are named (T-7 ordering)"
  else
    t_bad "--no-ledger AND no probe: the receipt blocker speaks first and both legs are named (T-7 ordering) — expected the --no-ledger note to lead and to disclose the absent leg (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # ---- #154: board RESOLUTION arms. The constant this replaced was wrong for
  # every factory issue, so the ladder itself is the fix; an untested ladder
  # would be the same blind spot one layer down. Each arm pins the SOURCE it
  # resolved by, because a close aimed by a probe and one aimed by a flag are
  # different claims and must not look alike in a log.
  #
  # (12) The shadow case, and the reason this exists: the number is CLOSED on
  # the fork and OPEN on the factory. A constant default would have re-closed
  # the fork's unrelated twin; the probe must pick the live board.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    FAKE_GH_STATE_BY_REPO="leshchenko1979/opencrabs=CLOSED,leshchenko1979/opencrabs-dev-factory=OPEN" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 271 --probe "echo probe-ok" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && grep -q 'issue close 271 .*leshchenko1979/opencrabs-dev-factory' "$d/gh.calls" \
     && ! grep -q 'issue close 271 .*leshchenko1979/opencrabs ' "$d/gh.calls" \
     && case "$out" in *"source=probe"*) true ;; *) false ;; esac; then
    t_ok "a CLOSED shadow on one board and an OPEN twin on the other resolves to the LIVE one (#154)"
  else
    t_bad "the probe must pick the OPEN board, never the closed shadow (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # (13) AMBIGUOUS: OPEN on both. There is no evidence in the tracker that says
  # which factory this smoke belongs to, so the only honest answer is to refuse
  # and name the flag. rc stays 0 — guard 7 — because the PASS stands.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    FAKE_GH_STATE_BY_REPO="leshchenko1979/opencrabs=OPEN,leshchenko1979/opencrabs-dev-factory=OPEN" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 272 --probe "echo probe-ok" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; } \
     && case "$out" in *AMBIGUOUS*) true ;; *) false ;; esac \
     && case "$out" in *"--close-repo"*) true ;; *) false ;; esac; then
    t_ok "OPEN on both boards is AMBIGUOUS: refuse, name the flag, leave rc 0 (#154)"
  else
    t_bad "two OPEN holders must refuse and name --close-repo (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # (14) ABSENT: neither board holds the number. A close here would create the
  # issue on whichever board the constant named — the loudest possible wrong.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    FAKE_GH_STATE_BY_REPO="someone/else=OPEN" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 273 --probe "echo probe-ok" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && { [ ! -f "$d/gh.calls" ] || ! grep -q 'issue close' "$d/gh.calls"; } \
     && case "$out" in *ABSENT*) true ;; *) false ;; esac; then
    t_ok "a number no checked board holds is ABSENT: no close, rc 0 (#154)"
  else
    t_bad "absent must refuse rather than close blind (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # (15) ENV: OC_SMOKE_CLOSE_REPO names the board, and the source says `env` so
  # a log cannot mistake a caller's assertion for a tracker's answer.
  rm -f "$d/gh.calls"
  rc=0
  out="$(OC_SMOKE_CLOSE_REPO="leshchenko1979/opencrabs-dev-factory" \
    OC_DEPLOY_STATE_DIR="$d/state" OC_SMOKE_EVIDENCE_BIN="$d/fake-evidence" \
    OC_LEDGER_BIN="$d/fake-ledger" OC_GH="$d/fake-gh" FAKE_GH_LOG="$d/gh.calls" \
    OPENCRABS_SESSION_ID="test-session-uuid" OC_TOOLS_NOLOG=1 \
    "$0" 274 --probe "echo probe-ok" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && grep -q 'issue close 274 .*leshchenko1979/opencrabs-dev-factory' "$d/gh.calls" \
     && case "$out" in *"source=env"*) true ;; *) false ;; esac; then
    t_ok "OC_SMOKE_CLOSE_REPO names the board and reports source=env (#154)"
  else
    t_bad "env-named board must close it and say source=env (rc=$rc calls=$(tr '\n' '|' < "$d/gh.calls" 2>/dev/null) out=$(printf '%s' "$out" | tr '\n' '|'))"
  fi

  # (16) USAGE PATH IS ALIVE. #154 put a literal `$OC_SMOKE_CLOSE_REPO` inside the
  # usage() heredoc, which is DELIBERATELY unquoted (it expands $PROG), so under
  # `set -u` the help text died with `unbound variable` before arg parsing ever
  # set it: rc=1, ZERO bytes on stdout, a shell diagnostic on stderr. Every
  # --selftest arm passed throughout, because none of them drove --help — the
  # battery caught it six ways and this tool caught it not at all. The stderr
  # assertion is the load-bearing one: a usage path that writes a SHELL
  # DIAGNOSTIC is broken even when it happens to exit 0.
  rc=0; _hout=""; _herr=""
  _hout="$("$0" --help 2>/tmp/oc-smoke-help.$$.err)" || rc=$?
  _herr="$(cat /tmp/oc-smoke-help.$$.err 2>/dev/null)"; rm -f /tmp/oc-smoke-help.$$.err
  if [ "$rc" -eq 0 ] && [ -n "$_hout" ] && [ -z "$_herr" ] \
     && case "$_hout" in *--close-repo*) true ;; *) false ;; esac; then
    t_ok "--help exits 0, writes usage to STDOUT, no shell diagnostic on stderr"
  else
    t_bad "--help must be a live usage path (rc=$rc stdout=$(printf '%s' "$_hout" | wc -c)B stderr=$(printf '%s' "$_herr" | tr '\n' '|'))"
  fi

  echo "selftest: $pass passed, $fail failed"
  [ "$fail" -eq 0 ] && exit 0 || exit 1
}

# Handle selftest flag before argument verification
for arg in "$@"; do
  if [ "$arg" = "--selftest" ]; then
    do_selftest
  fi
done

# Argument parsing
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      usage 0
      ;;
    --selftest)
      do_selftest
      ;;
    --verdict)
      [ $# -ge 2 ] || die 2 "--verdict requires a value (PASS|FAIL)"
      VERDICT="$2"
      shift 2
      ;;
    --probe)
      [ $# -ge 2 ] || die 2 "--probe requires a shell command string"
      PROBE_CMD="$2"
      shift 2
      ;;
    --markers|--strings)
      [ $# -ge 2 ] || die 2 "--markers requires a comma-separated list"
      MARKERS="$2"
      shift 2
      ;;
    --evidence)
      [ $# -ge 2 ] || die 2 "--evidence requires description text"
      EVIDENCE_TEXT="$2"
      shift 2
      ;;
    --lineage)
      [ $# -ge 2 ] || die 2 "--lineage requires a token (verified|failed|unverified)"
      case "$2" in
        verified|VERIFIED|failed|FAILED|unverified|UNVERIFIED)
          LINEAGE="$(printf '%s' "$2" | tr 'A-Z' 'a-z')"
          LINEAGE_DECLARED=1 ;;
        *)
          die 2 "--lineage accepts exactly verified|failed|unverified (got: $2)" ;;
      esac
      shift 2
      ;;
    --behavioral)
      # #598: the caller's declaration for leg 4 when NO probe is supplied.
      # `na` is the legitimate structural-N/A case the 4-leg rubric allows.
      # A probe that actually RUNS overrides this — the run is the evidence.
      [ $# -ge 2 ] || die 2 "--behavioral requires a token (verified|failed|absent|na)"
      case "$2" in
        verified|VERIFIED|failed|FAILED|absent|ABSENT|na|NA|n/a|N/A)
          BEHAVIORAL="$(printf '%s' "$2" | tr 'A-Z' 'a-z')" ;;
        *)
          die 2 "--behavioral accepts exactly verified|failed|absent|na (got: $2)" ;;
      esac
      shift 2
      ;;
    --target)
      [ $# -ge 2 ] || die 2 "--target requires a target/feature name"
      TARGET="$2"
      shift 2
      ;;
    --unit)
      [ $# -ge 2 ] || die 2 "--unit requires a systemd user unit name"
      UNIT="$2"
      shift 2
      ;;
    --no-ledger)
      NO_LEDGER=1
      shift
      ;;
    --close)
      CLOSE_MODE=1
      shift
      ;;
    --no-close)
      CLOSE_MODE=0
      shift
      ;;
    --close-repo)
      [ $# -ge 2 ] || die 2 "--close-repo requires an owner/repo slug"
      # Mechanical shape check: a bare owner or a path is not a slug, and a
      # malformed one would reach gh as a -R value that resolves nowhere.
      case "$2" in
        */*/*|/*|*/|*' '*) die 2 "--close-repo wants owner/repo (got: $2)" ;;
        */*) CLOSE_REPO="$2" ;;
        *) die 2 "--close-repo wants owner/repo (got: $2)" ;;
      esac
      shift 2
      ;;
    --issue)
      [ $# -ge 2 ] || die 2 "--issue requires an issue number"
      ISSUE="$2"
      shift 2
      ;;
    -*)
      die 2 "unknown option: $1 (see --help)"
      ;;
    *)
      if [ -z "$ISSUE" ]; then
        ISSUE="$1"
        shift
      else
        die 2 "unexpected positional argument: $1"
      fi
      ;;
  esac
done

[ -n "$ISSUE" ] || die 2 "issue number or identifier required (e.g. oc-smoke 235)"
ISSUE="${ISSUE###}" # strip leading # if provided

# Verify state directory
[ -d "$STATE_DIR" ] || die 3 "state directory not found: $STATE_DIR"

DEPLOYED_SHA="$(head -1 "$STATE_DIR/deployed.sha" 2>/dev/null || true)"
[ -n "$DEPLOYED_SHA" ] || die 3 "deployed.sha not found in $STATE_DIR"

RUN_ID=""
if [ -f "$STATE_DIR/deployed.meta.json" ]; then
  RUN_ID="$(jq -r '.run_id // empty' "$STATE_DIR/deployed.meta.json" 2>/dev/null || true)"
fi
RUN_ID="${RUN_ID:-unknown}"

ACTOR="${OPENCRABS_SESSION_ID:-}"
if [ -z "$ACTOR" ] && { [ -f "$STATE_DIR/events.jsonl" ] || [ -f "$STATE_DIR/workers-ledger.json" ]; }; then
  _smoke_ledger="$STATE_DIR/events.jsonl"
  [ -f "$_smoke_ledger" ] || _smoke_ledger="$STATE_DIR/workers-ledger.json"
  CLAIM_ACTOR="$("$LEDGER_TOOL" --ledger "$_smoke_ledger" events --kind claim --json --all 2>/dev/null | jq -r --arg iss "$ISSUE" '.[] | select((.issue|tostring) == $iss) | .actor // empty' | tail -1 || true)"
  if [ -n "$CLAIM_ACTOR" ]; then
    ACTOR="$CLAIM_ACTOR"
  else
    ACTOR="$("$LEDGER_TOOL" --ledger "$_smoke_ledger" workers --json 2>/dev/null | jq -r '.[-1].uuid // empty' || true)"
  fi
fi
ACTOR="${ACTOR:-unknown-actor}"

TARGET="${TARGET:-live-ops}"

EVIDENCE_BIN="${OC_SMOKE_EVIDENCE_BIN:-$EVIDENCE_TOOL}"

# 1. Run live identity verification
IDENTITY_OUT=""
IDENTITY_RC=0
if [ -x "$EVIDENCE_BIN" ]; then
  echo "$PROG: running identity verification on $UNIT..."
  set +e
  IDENTITY_OUT="$("$EVIDENCE_BIN" --unit "$UNIT" ${MARKERS:+--markers "$MARKERS"} 2>&1)"
  IDENTITY_RC=$?
  set -e
  printf '%s\n' "$IDENTITY_OUT"
  if [ "$IDENTITY_RC" -ne 0 ]; then
    echo "$PROG: identity verification failed (rc=$IDENTITY_RC)" >&2
    VERDICT="FAIL"
  fi
else
  echo "$PROG: WARNING: evidence tool $EVIDENCE_BIN not found/executable; skipping live identity leg" >&2
fi

# 2. Run behavioral probe if specified
PROBE_DETAILS=""
if [ -n "$PROBE_CMD" ]; then
  echo "$PROG: running behavioral probe: $PROBE_CMD"
  set +e
  PROBE_OUT="$(bash -c "$PROBE_CMD" 2>&1)"
  PROBE_RC=$?
  set -e
  printf '%s\n' "$PROBE_OUT"
  if [ "$PROBE_RC" -ne 0 ]; then
    echo "$PROG: behavioral probe FAILED (rc=$PROBE_RC)" >&2
    VERDICT="FAIL"
    PROBE_DETAILS="probe failed (rc=$PROBE_RC): $(clip "$(flatten "$PROBE_OUT")" "$SMOKE_PROBE_CAP")"
    BEHAVIORAL="failed"
  else
    echo "$PROG: behavioral probe PASSED"
    PROBE_DETAILS="probe passed: $(clip "$(flatten "$PROBE_OUT")" "$SMOKE_PROBE_CAP")"
    BEHAVIORAL="verified"
  fi
fi

# 2a-bis. By-hand lineage (#673). #306 made --lineage caller-only, which was
#     right while this tool had no way to check ancestry. It has one now: the
#     fork checkout and the deployed sha are both in hand (the identity leg
#     resolves them), so when the caller does NOT declare a token we ATTEMPT
#     leg 1 ourselves and record what the check returned — `verified`,
#     `failed`, or `unverified` when the check cannot run at all (no checkout,
#     no origin/main ref, unknown object). A best-effort fetch keeps the ref
#     fresh and is NEVER fatal (offline -> the local ref stands; set
#     OC_SMOKE_NO_FETCH=1 to skip the network entirely). An explicit --lineage
#     still wins, so the #306 caller contract is unchanged — the tool simply
#     stops under-claiming when it can do the check itself.
if [ "$LINEAGE_DECLARED" -eq 0 ]; then
  LINEAGE="unverified"
  # #70: the inner block already runs `git -C "$FORK_REPO" rev-parse`; a stray
  # `.git` FILE used to enter here and make the fetch a silent no-op.
  if git -C "$FORK_REPO" rev-parse --git-dir >/dev/null 2>&1; then
    if [ "${OC_SMOKE_NO_FETCH:-0}" != "1" ]; then
      timeout 20 git -C "$FORK_REPO" fetch --quiet origin main >/dev/null 2>&1 || true
    fi
    if git -C "$FORK_REPO" rev-parse --verify -q origin/main >/dev/null 2>&1; then
      set +e
      git -C "$FORK_REPO" merge-base --is-ancestor "$DEPLOYED_SHA" origin/main >/dev/null 2>&1
      _lin_rc=$?
      set -e
      case "$_lin_rc" in
        0) LINEAGE="verified" ;;
        1) LINEAGE="failed" ;;
        *) LINEAGE="unverified" ;;
      esac
    fi
  fi
  echo "$PROG: lineage auto-check (#673): $DEPLOYED_SHA vs origin/main -> $LINEAGE" >&2
fi

# 2b. The lineage leg (#306, revised #673). #306 made --lineage caller-only
#     because this tool ran no ancestry command, so it could not compute leg 1
#     of the 4-leg rubric and a leg it did not check had to read as unchecked.
#     #673 kept that rule but removed its premise: the ancestry check now runs
#     above (2a-bis) whenever the caller declares nothing, so the recorded
#     token is a CHECKED value where the check was possible and `unverified`
#     only where it was not. The caller's --lineage still overrides. A leg
#     reporting FAILED forces the row to FAIL, on the same reasoning that
#     already forces FAIL on an identity mismatch or a failed probe — a row
#     reading `PASS ... lineage=failed` is the self-contradiction #436 fixes
#     below.
if [ "$LINEAGE" = "failed" ]; then
  echo "$PROG: caller reported the lineage leg FAILED — verdict forced to FAIL" >&2
  VERDICT="FAIL"
fi

# 3. Assemble full evidence string
# #436: the opening clause names the ROW's OWN verdict. It was the literal
# `4-leg smoke pass:` on every row — including all 7 FAIL rows in the canonical
# log, which are exactly the rows a reader consults when something went wrong,
# so the durable record asserted a pass in its first five words while field 2
# said FAIL. PASS keeps the phrase byte-for-byte (no migration, no lost marker);
# a FAIL row now opens by naming its own verdict.
# #598: resolve leg 4's status. A probe that ran set BEHAVIORAL above; an
# absent probe leaves the caller's declaration, or `absent` when there is
# none. NEVER `verified` by default — that is the whole point.
if [ -z "$BEHAVIORAL" ]; then
  BEHAVIORAL="absent"
fi
# #598: the leg COUNT must describe the legs actually run. A probe-less run is
# a 3-leg run, and opening it "4-leg smoke pass" asserts a leg it never ran —
# the same class #306 fixed for lineage, and the shape the owner's 2026-09-16
# order forbids (a live behavioral receipt is mandatory for live-testable UX).
# The phrase stays byte-for-byte for a probed PASS row, so no migration.
LEG_COUNT=4
if [ "$BEHAVIORAL" = "absent" ]; then
  LEG_COUNT=3
fi
CLAUSE="${LEG_COUNT}-leg smoke ${VERDICT}"
if [ "$VERDICT" = "PASS" ]; then
  CLAUSE="${LEG_COUNT}-leg smoke pass"
fi
FULL_EVIDENCE="${CLAUSE}: lineage=${LINEAGE} behavioral=${BEHAVIORAL} identity=$( [ "$IDENTITY_RC" -eq 0 ] && echo "MATCH" || echo "MISMATCH" )"
if [ -n "$MARKERS" ]; then
  FULL_EVIDENCE="${FULL_EVIDENCE} markers=${MARKERS}"
fi
# #409: two INDEPENDENT ifs. The elif dropped the entire --evidence argument
# whenever --probe was also supplied — and --probe is the NORMAL case, since
# leg 4 of the 4-leg rubric IS a live behavioral probe. What was lost is the
# part a reviewer cannot reconstruct: the by-hand lineage computation — now
# recorded in the lineage= leg by --lineage above, since #306 stopped this tool
# asserting a leg it never computes — plus stated limits, non-duplicate
# provenance, packaging identity.
if [ -n "$PROBE_DETAILS" ]; then
  FULL_EVIDENCE="${FULL_EVIDENCE} live_behavior=${PROBE_DETAILS}"
fi
if [ -n "$EVIDENCE_TEXT" ]; then
  FLAT_EVIDENCE="$(flatten "$EVIDENCE_TEXT")"
  if [ "$FLATTENED" = "1" ]; then
    echo "$PROG: NOTE --evidence contained newlines/tabs; flattened to single spaces" >&2
    echo "$PROG:       so the verdict row stays ONE line (a raw newline would split it)" >&2
  fi
  FULL_EVIDENCE="${FULL_EVIDENCE} evidence=${FLAT_EVIDENCE}"
fi
# Never silent (#409 ask 2): state the truncation on stderr as well as in the row.
case "$PROBE_DETAILS" in
  *'…[truncated at '*) echo "$PROG: NOTE probe output truncated to ${SMOKE_PROBE_CAP} chars — full output was above; raise OC_SMOKE_PROBE_CAP to keep more" >&2 ;;
esac

# 4. Append canonical 4-leg smoke verdict row
TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
TAB=$'\t'
ROW="${TS}${TAB}${VERDICT}${TAB}issue=#${ISSUE}${TAB}sha=${DEPLOYED_SHA}${TAB}run=${RUN_ID}${TAB}target=${TARGET}${TAB}actor=${ACTOR}${TAB}evidence=\"${FULL_EVIDENCE}\""

append_log_safe "$CANON_LOG" "$ROW"
echo "$PROG: recorded verdict row ($VERDICT) for #$ISSUE in $CANON_LOG"

# 5. On PASS: optionally stamp workers-ledger.json done
#    #68: LEDGER_RC is the RECEIPT the close step gates on, so it must be
#    defined on EVERY path — 1 means "no done row was written in this run".
#    Left unset it would be a `set -u` crash on the FAIL and --no-ledger paths,
#    and worse, a stale 0 from a previous shell would read as a receipt.
LEDGER_RC=1
if [ "$VERDICT" = "PASS" ] && [ "$NO_LEDGER" -eq 0 ]; then
  ACTUAL_LEDGER_BIN="${OC_LEDGER_BIN:-$LEDGER_TOOL}"
  if [ -x "$ACTUAL_LEDGER_BIN" ] && { [ -f "$STATE_DIR/events.jsonl" ] || [ -f "$STATE_DIR/workers-ledger.json" ]; }; then
    echo "$PROG: stamping ledger done for issue #$ISSUE..."
    set +e
    # #699: the row must BEGIN with the issue ref. is_addressed() is anchored
    # (deliberately -- #305 fences off mid-sentence closure), so the historical
    # "smoke PASS verified for issue #N" wording wrote a row that addressed
    # NOTHING and closed nothing, silently: 104 such rows across 94 issues, each
    # reporting "read-back ok", which confirms the WRITE and never the
    # addressing. The fleet convention is the leading form (oc-ledger's own
    # fixture: `stamp done "#601 landed: b9ee661cc"`).
    LEDGER_OUT="$(OC_DEPLOY_STATE_DIR="$STATE_DIR" "$ACTUAL_LEDGER_BIN" stamp done "#${ISSUE} smoke PASS verified" 2>&1)"
    LEDGER_RC=$?
    set -e
    if [ "$LEDGER_RC" -eq 0 ]; then
      echo "$PROG: $LEDGER_OUT"
    else
      echo "$PROG: WARNING: oc-ledger stamp done exited $LEDGER_RC: $LEDGER_OUT" >&2
    fi
  fi
fi

# 6. On PASS with a done row written IN THIS RUN: close the issue (#68).
#    Owner order 2026-11-15: a fork issue is closed the moment a working
#    behavioural smoke is confirmed (triage.md §Autonomous closure, class (d)
#    behavioural-smoke-landed).
#
#    Class (d) requires BOTH receipts, so this gates on LEDGER_RC=0 — the done
#    row was written by THIS run, not inherited. That also makes `--no-ledger`
#    mechanically close-free: no done row, no receipt pair.
#
#    GUARD 7 — a gh failure NEVER changes the verdict or the exit code. The
#    verdict row is already on disk and the PASS stands; a close failure is a
#    separate defect, not a retroactive smoke failure.
#
#    An UNREADABLE state is not a licence to write. `gh issue view` failing
#    means CLOSED cannot be told from OPEN, and closing blind is the
#    fabricate-on-a-guess shape the fleet refuses everywhere else — so it SKIPs
#    with a warning rather than guessing, and says the close is owed.
#
#    T-7: class (d) is behavioural-smoke-landed, so the close needs a
#    BEHAVIOURAL receipt and not merely a green verdict. BEHAVIORAL is resolved
#    above to `absent` when no probe ran and the caller declared nothing (#598),
#    and a probe-less PASS proves the STRUCTURE — identity, sha, markers — while
#    saying nothing about whether the feature works for a user. Closing on it
#    would mark an issue resolved on evidence that never addressed the claim the
#    issue makes. The check is PRESENCE-only: it reads the leg this run already
#    resolved and never re-runs or re-interprets the probe, so `verified` closes,
#    `absent` refuses, and the two DECLARED states are honoured as declared —
#    `--behavioral na` (structurally untestable, stated) closes, because a leg
#    the caller has explicitly ruled out is not an unproven one.
if [ "$CLOSE_MODE" -eq 1 ] && [ "$VERDICT" = "PASS" ] && [ "$LEDGER_RC" -eq 0 ] && [ "$BEHAVIORAL" != "absent" ]; then
  # T-10: ONE implementation of class (d) closure. The lib carries the
  # guard set (numeric-only, unreadable-state skip, idempotent already-CLOSED,
  # printf-built comment); rc policy stays HERE, because the lib never exits
  # and guard 7 (a gh failure never changes the verdict) is this file's
  # promise, not the helper's. The catch-up sweep that used to share this
  # path was removed (factory #177).
  if command -v oc_resolve_close_board >/dev/null 2>&1; then
    # #154: resolve the BOARD before resolving the close. The source is printed
    # either way, because a close aimed by a probe and a close aimed by a flag
    # are different claims and the log must not make them look alike.
    # `set -e` is ON in this script, so a bare assignment from a failing
    # command kills the whole run: the resolver's rc 2/5/6 would exit the tool
    # BEFORE the refusal below could state itself, and a PASS smoke would leave
    # with a non-zero status — guard 7 (a close failure never changes the exit
    # code) broken by the very block that implements it. `|| rc=$?` is the
    # point of the line, not tidiness.
    _board_rc=0
    _board_line="$(oc_resolve_close_board "$PROG" "$GH_BIN" "$ISSUE" "$CLOSE_REPO")" || _board_rc=$?
    if [ "$_board_rc" -eq 0 ]; then
      _board="${_board_line%%$'\t'*}"; _src="${_board_line##*$'\t'}"
      echo "$PROG: close-board resolved ${_board}#${ISSUE} (source=$_src)" >&2
      if command -v oc_close_on_receipt >/dev/null 2>&1; then
        oc_close_on_receipt "$PROG" "$GH_BIN" "$_board" "$ISSUE" \
          "smoke verdict: PASS $TS sha=$DEPLOYED_SHA run=$RUN_ID — $FULL_EVIDENCE" \
          "ledger: done #$ISSUE smoke PASS verified" || true
      else
        echo "$PROG: WARNING: --close unavailable — lib/oc-gh-close.sh is missing" >&2
      fi
    else
      # Every refusal path is STATED. A quiet skip here would be
      # indistinguishable from a close that ran and found the issue already
      # closed, which is the same blind spot that let the constant default
      # report success while closing the wrong tracker. The resolver's own
      # NOTE has already reached stderr (it is NOT captured — only the slug on
      # stdout is), so this only has to say what it means for the verdict.
      echo "$PROG: NOTE --close skipped: the board could not be resolved unambiguously (rc=$_board_rc);" >&2
      echo "$PROG:       the issue is left OPEN and the PASS verdict row stands (guard 7)." >&2
    fi
  else
    echo "$PROG: WARNING: --close unavailable — lib/oc-gh-close.sh is missing" >&2
  fi
elif [ "$CLOSE_MODE" -eq 1 ] && [ "$VERDICT" = "PASS" ] && [ "$NO_LEDGER" -eq 1 ]; then
  # Stated, not silent: a PASS with --no-ledger has no receipt PAIR, so class
  # (d) does not apply and nothing closes. A quiet skip would look identical to
  # a close that ran and found the issue already closed.
  #
  # T-7 ORDERING: this branch precedes the UNPROVEN one ON PURPOSE. With
  # --no-ledger AND no probe, both legs are missing, but --no-ledger withholds
  # the close even if the probe is added — so it is the fundamental blocker and
  # must speak first. The reverse order told the caller to add --probe, which
  # would still not close: a refusal naming an escape that does not work is the
  # same dead end this block exists to avoid. When both are missing, say both.
  echo "$PROG: NOTE --close skipped: --no-ledger means no done row, and class (d) needs both receipts" >&2
  if [ "$BEHAVIORAL" = "absent" ]; then
    echo "$PROG:       the behavioural leg is ALSO absent (behavioral=absent), so adding --probe" >&2
    echo "$PROG:       alone would still not close: drop --no-ledger as well." >&2
  fi
elif [ "$CLOSE_MODE" -eq 1 ] && [ "$VERDICT" = "PASS" ] && [ "$BEHAVIORAL" = "absent" ]; then
  # T-7: UNPROVEN, and stated rather than skipped. A probe-less PASS leaves leg
  # 4 unresolved, so the issue is left OPEN on purpose — the close is not
  # withheld by an accident of configuration, it is withheld because the
  # evidence class does not reach it. Both escapes are named, because a refusal
  # that does not say how to satisfy it is a dead end: run the feature and pass
  # --probe, or declare the leg structurally untestable with --behavioral na.
  # (The done row IS present here — a --no-ledger run never reaches this branch.)
  echo "$PROG: NOTE --close skipped: behavioural leg UNPROVEN — this PASS ran no probe" >&2
  echo "$PROG:       (behavioral=absent), so it proves the structure and never that the feature" >&2
  echo "$PROG:       works. Class (d) needs the behavioural receipt: re-run with --probe <cmd>," >&2
  echo "$PROG:       or declare the leg structurally untestable with --behavioral na." >&2
  echo "$PROG:       The issue is left OPEN deliberately; the PASS verdict row stands." >&2
fi

if [ "$VERDICT" = "PASS" ]; then
  oc_log_finish 0
  exit 0
else
  oc_log_finish 1
  exit 1
fi
