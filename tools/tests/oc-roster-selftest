#!/usr/bin/env bash
# oc-roster --selftest — offline fixtures only: a fixture session DB, a fixture
# ledger, and an oc-wt shim. No network, no live DB, no live ledger, no writes
# outside the temp dir. Invoked by `oc-roster --selftest` (which also sets
# OC_TOOLS_NOLOG=1 through lib/oc-log.sh so the run never journals).
set -u
set -o pipefail
export OC_TOOLS_NOLOG=1

# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
SELF_DIR="$OC_TOOLS_DIR"
TOOL="$OC_TOOLS_DIR/state/oc-roster"
# SQLite reader: tools/lib/oc_sqlite, NOT the `sqlite3` CLI (#371). Until
# 2026-09-19 the CLI was not on this box at all, so the fixture DB below was
# never created — every live-DB leg then read "session DB unreadable" while the
# suite still reported success. One binding, three call sites.
SQLITE="$OC_TOOLS_DIR/lib/oc_sqlite"
D="$(mktemp -d)"
trap 'rm -rf "$D"' EXIT

pass=0; fail=0
ok()  { pass=$((pass+1)); echo "selftest: $1  OK"; }
bad() { fail=$((fail+1)); echo "selftest: $1  FAIL${2:+ — $2}"; }
chk() { [ "$2" = "$3" ] && ok "$1" || bad "$1" "want [$3] got [$2]"; }

NOW=1800000000
U1=aaaaaaaa-0000-4000-8000-000000000001
U2=aaaaaaaa-0000-4000-8000-000000000002
U3=aaaaaaaa-0000-4000-8000-000000000003
U4=aaaaaaaa-0000-4000-8000-000000000004
L1=11111111-1111-4111-8111-111111111111
L2=22222222-2222-4222-8222-222222222222
L3=33333333-3333-4333-8333-333333333333
L4=44444444-4444-4444-8444-444444444444
L5=55555555-5555-4555-8555-555555555555
# #404 FIXTURE: a frankenstein author — absent from the fixture session DB AND
# sorting BEFORE every real uuid, which is exactly the live 119-* shape (phantom
# 1a63f103-596e-… < real 1a63f103-b899-…). P1 SHADOWS U1's claim on #200, so the
# pre-fix tie-break handed 200-thing to P1 — the discriminator this file pins.
P1=00000000-0000-4000-8000-0000000000ff
FORUM=-1003936827469

# ---- fixture session DB -----------------------------------------------------
"$SQLITE" "$D/db.sqlite" <<SQL
CREATE TABLE sessions (id TEXT PRIMARY KEY, title TEXT, updated_at INTEGER, archived_at INTEGER);
CREATE TABLE session_bindings (session_id TEXT PRIMARY KEY, channel TEXT, chat_id TEXT, thread_id INTEGER);
INSERT INTO sessions VALUES ('$L1','lane-one',$((NOW-3600)),NULL);
INSERT INTO sessions VALUES ('$L2','lane-two',$((NOW-3600)),NULL);
INSERT INTO sessions VALUES ('$L3','lane-three',$((NOW-3600)),$NOW);
INSERT INTO sessions VALUES ('$L4','lane-four',$((NOW-100*3600)),NULL);
INSERT INTO sessions VALUES ('$L5','subagent:child',$((NOW-60)),NULL);
INSERT INTO sessions VALUES ('$U3','lane-three-archived',$((NOW-100*3600)),$NOW);
INSERT INTO sessions VALUES ('$U1','lane-u1-archived',$((NOW-100*3600)),$NOW);
INSERT INTO sessions VALUES ('$U2','lane-u2-archived',$((NOW-100*3600)),$NOW);
INSERT INTO session_bindings VALUES ('$L1','telegram','$FORUM',1);
INSERT INTO session_bindings VALUES ('$L2','telegram','-1000000000',1);
INSERT INTO session_bindings VALUES ('$L4','telegram','$FORUM',2);
SQL
chk "fixture-db-created" "$("$SQLITE" "$D/db.sqlite" 'SELECT count(*) FROM sessions;')" "8"

# ---- fixture ledger ---------------------------------------------------------
cat > "$D/ledger.json" <<JSON
{"workers":[{"uuid":"$U1","role":"editor"},{"uuid":"$U2","role":"triage"}],
 "events":[
  {"n":1,"t":"2026-09-11T00:00Z","by":"editor $U1","kind":"claim","what":"CLAIM #200 — open thing"},
  {"n":2,"t":"2026-09-11T00:01Z","by":"editor $U2","kind":"claim","what":"CLAIM #201 — closed thing"},
  {"n":3,"t":"2026-09-11T00:02Z","by":"editor $U2","kind":"confirm","what":"confirm #201 shipped"},
  {"n":4,"t":"2026-09-11T00:03Z","by":"editor $U3","kind":"claim","what":"CLAIM #202 — open orphan"},
  {"n":5,"t":"2026-09-11T00:04Z","by":"editor $U4","kind":"claim","what":"CLAIM #203 — frankenstein author"},
  {"n":6,"t":"2026-09-11T00:05Z","by":"editor $P1","kind":"claim","what":"CLAIM #200 — frankenstein SHADOWING a real claim"}
 ]}
JSON
chk "fixture-ledger-parses" "$(jq '.events|length' "$D/ledger.json")" "6"

# ---- oc-wt shim -------------------------------------------------------------
cat > "$D/oc-wt" <<'SH'
#!/usr/bin/env bash
printf '200-thing\t/root/oc-wt-200-thing\tfeat/200\t0\n'
printf '201-fix\t/root/oc-wt-201-fix\tfix/201\t2\n'
printf '202-orph\t/root/oc-wt-202-orph\tfeat/202\t0\n'
printf '203-phantom\t/root/oc-wt-203-phantom\tfeat/203\t0\n'
printf 'fix-200-prefixed\t/root/oc-wt-fix-200-prefixed\tfix/200\t0\n'
SH
chmod +x "$D/oc-wt"

# ---- run the tool -----------------------------------------------------------
export OC_ROSTER_DB="$D/db.sqlite" OC_ROSTER_LEDGER="$D/ledger.json"
export OC_ROSTER_WT="$D/oc-wt" OC_ROSTER_WT_REPO="$D/repo"
export OC_ROSTER_FORUM_CHAT="$FORUM" OC_ROSTER_NOW="$NOW"

"$TOOL" live           > "$D/live.out"   2>"$D/live.err";    chk "live-rc" "$?" "0"
"$TOOL" live --detail  > "$D/lived.out"  2>/dev/null
"$TOOL" forum          > "$D/forum.out"  2>/dev/null
"$TOOL" claims         > "$D/claims.out" 2>"$D/claims.err";  chk "claims-rc" "$?" "0"
"$TOOL" work           > "$D/work.out"   2>"$D/work.err"
"$TOOL" classify       > "$D/class.out"  2>"$D/class.err";   chk "classify-rc" "$?" "0"
"$TOOL" classify --json > "$D/class.json" 2>/dev/null;       chk "classify-json-rc" "$?" "0"
"$TOOL" live --json   > "$D/live.json"   2>/dev/null;       chk "live-json-rc" "$?" "0"
"$TOOL" forum --json  > "$D/forum.json"  2>/dev/null;       chk "forum-json-rc" "$?" "0"
"$TOOL" claims --json > "$D/claims.json" 2>/dev/null;       chk "claims-json-rc" "$?" "0"
"$TOOL" work --json   > "$D/work.json"   2>/dev/null;       chk "work-json-rc" "$?" "0"
"$TOOL" bogus >/dev/null 2>&1; chk "unknown-verb-rc2" "$?" "2"

chk "live-count"     "$(wc -l < "$D/live.out")" "3"
chk "live-no-subagent" "$(grep -c "$L5" "$D/live.out" || true)" "0"
chk "forum-count"    "$(wc -l < "$D/forum.out")" "2"
chk "claims-open-count" "$(wc -l < "$D/claims.out")" "4"
chk "work-count"     "$(wc -l < "$D/work.out")" "5"
chk "classify-rows"  "$(wc -l < "$D/class.out")" "5"

# independent re-derivation of the live set (set-equality, not eyeball)
"$SQLITE" "$D/db.sqlite" "SELECT id FROM sessions WHERE archived_at IS NULL AND (title IS NULL OR title NOT LIKE 'subagent:%');" \
  | sort > "$D/live.expected"
sort "$D/live.out" > "$D/live.got"
if diff -q "$D/live.expected" "$D/live.got" >/dev/null; then ok "live-set-equality"; else bad "live-set-equality" "$(diff "$D/live.expected" "$D/live.got" | head -3)"; fi

python3 - "$D" "$U1" "$U2" "$U3" "$U4" "$P1" "$TOOL" <<'PY'
import json, os, re, sys
D, U1, U2, U3, U4, P1, TOOL_PATH = sys.argv[1:8]
ok = fail = 0
def chk(name, cond, detail=""):
    global ok, fail
    if cond: ok += 1; print("selftest: %s  OK" % name)
    else:    fail += 1; print("selftest: %s  FAIL%s" % (name, " — " + detail if detail else ""))

uuid_re = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
rows = [l.split("\t") for l in open(D + "/class.out").read().splitlines() if l.strip()]
chk("classify-every-row-full-uuid", all(uuid_re.match(r[1]) for r in rows),
    "bad rows: %r" % [r[1] for r in rows if not uuid_re.match(r[1])])
tally = {}
for r in rows: tally[r[0]] = tally.get(r[0], 0) + 1
chk("classify-tally-sums-to-rows", sum(tally.values()) == len(rows),
    "tally=%r rows=%d" % (tally, len(rows)))
chk("classify-all-four-classes", set(tally) == {"ACTIVE","IDLE","ORPHAN","UNKNOWN"}, repr(tally))
chk("classify-active-is-l1", [r[1] for r in rows if r[0]=="ACTIVE"] == ["11111111-1111-4111-8111-111111111111"], repr([r[1] for r in rows if r[0]=="ACTIVE"]))
chk("classify-idle-is-l4", [r[1] for r in rows if r[0]=="IDLE"] == ["44444444-4444-4444-8444-444444444444"], repr([r[1] for r in rows if r[0]=="IDLE"]))
chk("classify-orphan-is-u2", [r[1] for r in rows if r[0]=="ORPHAN"] == [U2], repr([r[1] for r in rows if r[0]=="ORPHAN"]))
chk("classify-unknown-is-u1-u3", sorted(r[1] for r in rows if r[0]=="UNKNOWN") == sorted([U1,U3]))
def jload(name):
    """Parse a --json artifact. A parse error is a FAIL, never an abort: an
    uncaught JSONDecodeError kills the whole block and hides every later
    assertion (seen while proving these cases non-vacuous)."""
    try:
        return json.load(open(D + "/" + name))
    except Exception as e:
        chk(name + "-parses", False, repr(e))
        return {"rows": [], "tallies": {}, "phantoms": []}

j = jload("class.json")
chk("json-tally-matches-tsv", j["tallies"] == tally, "%r vs %r" % (j["tallies"], tally))
chk("json-row-count", len(j["rows"]) == len(rows))

# --json for the four non-classify verbs (2026-09-11): the usage line always
# advertised it; only classify implemented it, so callers got the human lines
# and a JSON parse error. Each verb now emits {"rows":[...]} and the row set
# must agree with the TSV path it shadows.
def slurp(p):
    return [l for l in open(D + p).read().splitlines() if l.strip()]
lj = jload("live.json")
chk("live-json-keys", all(set(r) == {"uuid", "title", "updated_at"} for r in lj["rows"]),
    repr(lj["rows"][:1]))
chk("live-json-set-matches-tsv", sorted(r["uuid"] for r in lj["rows"]) == sorted(slurp("/live.out")),
    "%r vs %r" % (sorted(r["uuid"] for r in lj["rows"]), sorted(slurp("/live.out"))))
fj = jload("forum.json")
chk("forum-json-keys", all(set(r) == {"uuid", "title", "updated_at"} for r in fj["rows"]))
chk("forum-json-set-matches-tsv", sorted(r["uuid"] for r in fj["rows"]) == sorted(slurp("/forum.out")),
    "%r vs %r" % (sorted(r["uuid"] for r in fj["rows"]), sorted(slurp("/forum.out"))))
cj = jload("claims.json")
chk("claims-json-keys", all(set(r) == {"uuid", "issue", "t", "what"} for r in cj["rows"]))
chk("claims-json-open-set", set(r["uuid"] for r in cj["rows"]) == {P1, U1, U3, U4},
    repr(sorted(r["uuid"] for r in cj["rows"])))
wj = jload("work.json")
chk("work-json-keys", all(set(r) == {"task", "path", "branch", "dirty", "attributed", "phantom"} for r in wj["rows"]))
chk("work-json-count-matches-tsv", len(wj["rows"]) == len(slurp("/work.out")))
chk("work-json-attach-200", [r["attributed"] for r in wj["rows"] if r["task"] == "200-thing"] == [U1],
    repr([r["attributed"] for r in wj["rows"] if r["task"] == "200-thing"]))
att = {l.split("\t")[0]: l.split("\t")[4] for l in open(D + "/work.out").read().splitlines() if l.strip()}
chk("work-attach-200", att.get("200-thing") == U1 and att.get("fix-200-prefixed") == U1, repr(att))
chk("work-attach-201", att.get("201-fix") == U2, repr(att))
chk("work-attach-202", att.get("202-orph") == U3, repr(att))
op = set(l.split("\t")[0] for l in open(D + "/claims.out").read().splitlines() if l.strip())
chk("claims-open-set", op == {P1, U1, U3, U4}, repr(op))
chk("role-from-ledger", any(r[2] == "editor" for r in rows), repr([r[2] for r in rows]))
chk("classify-excludes-phantom", all(r[1] not in (U4, P1) for r in rows))
chk("json-phantoms-is-p1-u4", j.get("phantoms") == [P1, U4], repr(j.get("phantoms")))
err = open(D + "/class.err").read()
chk("phantom-flagged-on-stderr", "PHANTOM" in err and U4 in err, err.strip()[:120])

# ---- #404: `work` must never attribute to a PHANTOM author -----------------
# The fixture is built so the PRE-FIX code fails here: P1 sorts before U1, so the
# old `att = u; break` picked P1 for 200-thing. And 203-phantom has NO real claim
# at all, so it must come back unattributed while still NAMING the phantom.
ph = {l.split("\t")[0]: l.split("\t")[5]
      for l in open(D + "/work.out").read().splitlines() if l.strip()}
chk("work-tsv-col-count",
    all(len(l.split("\t")) == 6 for l in open(D + "/work.out").read().splitlines() if l.strip()),
    repr([l for l in open(D + "/work.out").read().splitlines() if l.strip() and len(l.split("\t")) != 6][:2]))
chk("work-attach-200-real-beats-phantom", att.get("200-thing") == U1, repr(att))
chk("work-tsv-200-phantom-named", ph.get("200-thing") == P1, repr(ph))
chk("work-attach-203-phantom-unattributed", att.get("203-phantom") == "-", repr(att))
chk("work-tsv-203-phantom-named", ph.get("203-phantom") == U4, repr(ph))
chk("work-tsv-201-no-phantom-is-dash", ph.get("201-fix") == "-", repr(ph))
wj2 = {r["task"]: r for r in wj["rows"]}
chk("work-json-200-phantom-field", wj2.get("200-thing", {}).get("phantom") == P1, repr(wj2.get("200-thing")))
chk("work-json-203-attributed-dash", wj2.get("203-phantom", {}).get("attributed") == "-", repr(wj2.get("203-phantom")))
werr = open(D + "/work.err").read()
chk("work-stderr-phantom", "PHANTOM" in werr and P1 in werr and U4 in werr, werr.strip()[:160])

# ---- #424: `claims` MUST delegate closure to lib/oc_claims.py --------------
# The pre-fix private copy disagreed with the canonical predicate in TWO
# directions at once, and lib/oc_claims.py's own unit cases stayed GREEN the
# whole time -- they test the MODULE, never this consumer. So the fixture is
# built to fail a re-inlined private copy in both directions:
#   #501 canonical=closed  pre-fix=OPEN    (a foreign ADDRESSED sweep closes)
#   #504 canonical=OPEN    pre-fix=closed  (pre-fix matched "#504" inside the
#                                          "#5040" of a later row)
#   #502 is OPEN in BOTH -- the negative control that stops a close-everything
#   bug from passing.
# Both sets were re-derived mechanically before this literal was written
# (canonical [502,504] vs pre-fix [501,502]); never eyeball this list.
import subprocess as _sub, tempfile as _tf
_F = "bbbbbbbb-0000-4000-8000-000000000001"
_EV = [
 {"n": 1, "t": "t1", "by": "editor " + U1, "kind": "claim",
  "what": "CLAIM #501 - live work"},
 {"n": 2, "t": "t2", "by": "triage " + _F, "kind": "unclaim",
  "what": "#501 - closed-issue stale claim sweep"},
 {"n": 3, "t": "t3", "by": "editor " + U2, "kind": "claim",
  "what": "CLAIM #502 - live work"},
 {"n": 4, "t": "t4", "by": "triage " + _F, "kind": "unclaim",
  "what": "note: see #502 for detail"},
 {"n": 5, "t": "t5", "by": "editor " + U3, "kind": "claim",
  "what": "CLAIM #503 - live work"},
 {"n": 6, "t": "t6", "by": "editor " + U3, "kind": "unclaim",
  "what": "standdown complete; context in #503"},
 {"n": 7, "t": "t7", "by": "editor " + U4, "kind": "claim",
  "what": "CLAIM #504 - live work"},
 {"n": 8, "t": "t8", "by": "editor " + U4, "kind": "unclaim",
  "what": "#5040 - sweep"},
]
_fx = _tf.mkdtemp(prefix="fx424-")
with open(_fx + "/ledger.json", "w") as _fh:
    json.dump({"events": _EV}, _fh)
_env = dict(os.environ, OC_ROSTER_LEDGER=_fx + "/ledger.json",
            OC_TOOLS_NOLOG="1")
_p = _sub.run([TOOL_PATH, "claims", "--json"], capture_output=True,
              text=True, env=_env)
# NB: the python chk takes a CONDITION (the bash one takes got/want). Passing a
# bare value here is truthy and passes VACUOUSLY, testing nothing -- so every
# assertion below is written as an explicit comparison.
chk("#424 fixture tool rc", _p.returncode == 0,
    "rc=%d stderr=%s" % (_p.returncode, _p.stderr[:200]))
try:
    _live = sorted(int(r["issue"]) for r in json.loads(_p.stdout)["rows"])
except Exception as _e:
    _live = ["PARSE-ERROR %s" % _e]
chk("#424 claims delegates to the canonical predicate", _live == [502, 504],
    repr(_live))
chk("#424 negative control: foreign prose mention stays open", 502 in _live, repr(_live))
chk("#424 discriminating: foreign addressed sweep closes", 501 not in _live, repr(_live))
with open(D + "/pycnt", "w") as fh:
    fh.write("%d %d\n" % (ok, fail))
sys.exit(1 if fail else 0)
PY
if read -r pyok pyfail < "$D/pycnt" 2>/dev/null; then
  pass=$((pass + pyok)); fail=$((fail + pyfail))
else
  fail=$((fail + 1))
fi

echo "selftest: oc-roster — ${pass} passed, ${fail} failed"
[ "$fail" = "0" ] || exit 1
exit 0
