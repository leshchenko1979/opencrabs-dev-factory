# Fixture lanes for --selftest (UUID-shaped so the MALFORMED_TRAILER class this
# tool grows next cannot mistake them for malformed keys).
LANE_A = "1a63f103-0000-4000-8000-00000000000a"
LANE_B = "2fbfb2f8-0000-4000-8000-00000000000b"
LANE_C = "3c0d5e17-0000-4000-8000-00000000000c"

# The REAL malformed key observed on feat/notify-on-roll (spec §4): a bare
# issue number where a Session-Id belongs.  Kept verbatim -- it is the fixture's
# proof that a garbage trailer becomes a class instead of a 13th lane.
LANE_MALFORMED = "7198"

# The Session-Id trailer is a UUID in every commit this fleet writes; anything
# else is MALFORMED_TRAILER (the real `7198` on feat/notify-on-roll).  That is a
# CLASS, never a lane -- keying the rollup on it would report a garbage trailer
# as a worker (spec §4).
UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
                     r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")

def is_lane(key):
    """True when a Session-Id trailer value is a well-formed lane UUID."""
    return bool(UUID_RE.match(key or ""))

# ============================================================================
# git helpers (read-only)
# ============================================================================
def git(repo, *args):
    p = subprocess.run(["git", "-C", repo] + list(args),
                       capture_output=True, text=True)
    return p.returncode, p.stdout, p.stderr


def list_branches(repo, glob):
    """[(name, tip_sha)] from for-each-ref — the branch list is DERIVED, never
    read from a scratch file.  --branch matches the SHORT name (feat/x)."""
    rc, out, err = git(repo, "for-each-ref", "refs/heads",
                       "--format=%(refname:short) %(objectname)")
    if rc != 0:
        return None, err.strip()
    rows = []
    for ln in out.splitlines():
        if " " not in ln:
            continue
        name, sha = ln.rsplit(" ", 1)
        name, sha = name.strip(), sha.strip()
        if not name or not sha:
            continue
        if glob and not fnmatch.fnmatch(name, glob):
            continue
        rows.append((name, sha))
    return rows, ""


def merged_branches(repo, base):
    """Set of branch names whose tip is already reachable from base.

    ONE for-each-ref --merged call replaces N `merge-base --is-ancestor` calls
    (measured: 25 s -> 0.05 s over 383 branches) and is the same predicate.
    """
    rc, out, _ = git(repo, "for-each-ref", "refs/heads", "--merged", base,
                     "--format=%(refname:short)")
    if rc != 0:
        return set()
    return {l.strip() for l in out.splitlines() if l.strip()}


def trailers_batch(repo, shas, chunk=TRAILER_CHUNK):
    """sha -> Session-Id trailer ('' when absent), batched `chunk` shas per git
    call.  The naive per-commit form is ~700 invocations on a full sweep.

    A commit carrying MORE THAN ONE Session-Id trailer yields only its FIRST
    value: `%(trailers:key=...,valueonly)` separates multiple values with a
    newline, which `splitlines()` turns into a continuation line that does not
    match the `<sha>\\t` shape and is skipped.  Deterministic, and matches the
    reference implementation this tool was ported from.
    """
    out = {}
    shas = list(shas)
    for i in range(0, len(shas), chunk):
        rc, txt, _ = git(repo, "log", "--no-walk=unsorted",
                         "--format=%H\t%(trailers:key=Session-Id,valueonly)",
                         *shas[i:i + chunk])
        if rc != 0:
            continue
        for ln in txt.splitlines():
            if re.match(r"^[0-9a-f]{40}\t", ln):
                sha, tr = ln.split("\t", 1)
                out[sha] = tr.strip()
    return out


def cherry_plus(repo, base, branch):
    """The `+` shas of `git cherry <base> <branch>` (None on git failure).

    The EXACT form is required: substituting the merge-base as upstream is 20x
    faster but returns the whole-branch aggregate instead of the lane-scoped
    set, i.e. the wrong answer.
    """
    rc, out, _ = git(repo, "cherry", base, branch)
    if rc != 0:
        return None
    plus = []
    for ln in out.splitlines():
        if ln.startswith("+") and len(ln.split()) >= 2:
            plus.append(ln.split()[1])
    return plus


def base_tree(repo, base_sha):
    """path -> blob sha for the base tree -- ONE `ls-tree -r -z` read.

    The content leg's reference set.  A blob sha IS the content hash, so a `+`
    commit whose post-image blob for a path equals the base's blob for that
    same path has already landed there -- whatever its sha or patch-id says
    (the v0.4.214 hazard: patch-id matching is blind to a change already
    present by another route, so landed work still reports `+`).

    None on git failure: the caller REFUSES rather than degrade, because an
    unconditional leg that silently reports the pre-leg number is exactly the
    second code path this design rejected.
    """
    rc, out, _ = git(repo, "ls-tree", "-r", "-z", base_sha)
    if rc != 0:
        return None
    tree = {}
    for ln in out.split("\0"):
        if "\t" not in ln:
            continue
        meta, path = ln.split("\t", 1)
        parts = meta.split()
        if len(parts) >= 3:
            tree[path] = parts[2]
    return tree


def commit_blobs(repo, shas):
    """sha -> {path: post-image blob sha}, ONE batched `diff-tree --stdin`.

    Batched on purpose: the alternative (a `git cat-file -e` / `git grep` per
    pending commit) is N subprocesses where N is the whole pending set.

    ponytail: the ceiling is MEASURED, not guessed -- 20 000 commits through
    this pipeline cost 2 821 ms (11 163 raw rows, ~7 000 commits/s, measured
    2026-09-20), so the full pending set (~41 000) is ~6 s.  If a per-commit
    form is ever needed, add `--no-content-leg` as an escape hatch -- on a
    MEASUREMENT, not before.  Until then the leg runs UNCONDITIONAL: a flag
    whose off-state is the default is a second code path nobody exercises,
    and this leg is what makes the headline `+` count truthful.
    """
    out = {}
    shas = list(shas)
    if not shas:
        return out
    p = subprocess.run(["git", "-C", repo, "diff-tree", "-r", "--root",
                        "--stdin", "--raw"],
                       input="\n".join(shas) + "\n",
                       capture_output=True, text=True)
    if p.returncode != 0:
        return None
    cur = None
    for ln in p.stdout.splitlines():
        if not ln:
            continue
        if ln.startswith(":"):
            if cur is None:
                continue
            head, _, path = ln.partition("\t")
            fields = head.split()
            if path and len(fields) >= 4:
                out.setdefault(cur, {})[path] = fields[3]
        else:
            cur = ln.strip()
    return out


def content_present(tree, blobs):
    """True when EVERY path a commit changes already holds that blob in base.

    A deletion (post-image blob all-zeros) can never be present, which is
    right -- a deletion is a real change.  An empty blob map (a commit that
    changes nothing) is NOT present either: it carries no content to match.
    """
    if not tree or not blobs:
        return False
    for path, blob in blobs.items():
        if tree.get(path) != blob:
            return False
    return True


def classify(r, asker=""):
    """The spec §4 class for one row.  Never inverts a lane-scoped 0.

    ALREADY_ABSORBED is tested FIRST because it is terminal: a tip reachable
    from the base with nothing lane-scoped pending is absorbed for EVERYONE,
    whoever is asking.  A lane-scoped 0 on a branch still out says something
    different -- that the unabsorbed commits are not that lane's -- so it must
    never be reported as "absorbed" (the whole point of the wording rule).
    """
    if r.get("plus_total", 0) < 0:
        return "ERROR"
    tip_lane = r["tip_lane"]
    if r["tip_in_base"] == 0 and r["plus_own"] == 0:
        return "ALREADY_ABSORBED"
    if not tip_lane:
        return "UNATTRIBUTABLE"
    if not is_lane(tip_lane):
        return "MALFORMED_TRAILER"
    if asker:
        if tip_lane != asker:
            return "NOT_YOURS"
        return "YOUR_PENDING" if r["plus_own"] else "YOUR_PENDING_ZERO"
    return "LANE_PENDING" if r["plus_own"] else "LANE_ZERO_OWN"


def rollup(rows):
    """Per-lane sums of plus_own + the malformed-key hygiene list.

    Keyed on the tip_lane values actually OBSERVED, so a lane that tips no
    branch is ABSENT rather than a phantom 0; and non-UUID keys go to their own
    map, so a garbage trailer can never be counted as a worker (spec §4: `7198`
    is a class, not a 13th lane).

    `zero_own` names every real lane whose own total is 0 across every branch it
    tips -- exactly the population an aggregate-based advisory names falsely.
    The tool cannot know what a given advisory actually SAID, so it reports the
    population and does not claim a false-advisory verdict it cannot support.
    """
    lanes, malformed = {}, {}
    for r in rows:
        if r.get("plus_total", 0) < 0:
            continue
        tl = r["tip_lane"]
        if not tl:
            continue
        if not is_lane(tl):
            malformed[tl] = malformed.get(tl, 0) + 1
            continue
        lanes[tl] = lanes.get(tl, 0) + r["plus_own"]
    return {"lanes": lanes,
            "malformed_keys": malformed,
            "lanes_total": len(lanes),
            "sum_plus_own": sum(lanes.values()),
            "zero_own": sorted(k for k, v in lanes.items() if v == 0)}


def census(repo, base, glob, jobs, lane=""):
    """Return (rows, meta).  Raises CensusRefused on an unresolvable repo/base."""
    rc, _, err = git(repo, "rev-parse", "--git-dir")
    if rc != 0:
        raise CensusRefused("repo %s is not a git repository (%s)"
                            % (repo, err.strip().splitlines()[:1] or "no detail"))
    rc, base_sha, err = git(repo, "rev-parse", base)
    if rc != 0:
        raise CensusRefused("base ref %r does not resolve (%s)"
                            % (base, err.strip().splitlines()[:1] or "no detail"))
    base_sha = base_sha.strip()

    branches, err = list_branches(repo, glob)
    if branches is None:
        raise CensusRefused("cannot list refs/heads (%s)" % (err or "no detail"))

    in_base = merged_branches(repo, base)

    # Phase 2: the exact cherry sweep, bounded worker pool over subprocesses.
    pending = [n for (n, _) in branches if n not in in_base]
    plus_by_branch = {}
    if pending:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=max(1, jobs)) as ex:
            for name, plus in ex.map(lambda n: (n, cherry_plus(repo, base, n)),
                                     pending):
                plus_by_branch[name] = plus

    # Phase 3: ONE batched trailer lookup for every '+' sha and every tip.
    all_shas = set()
    for (_, tip) in branches:
        all_shas.add(tip)
    for plus in plus_by_branch.values():
        if plus:
            all_shas.update(plus)
    trailers = trailers_batch(repo, sorted(all_shas))

    # Phase 3b: the CONTENT leg -- UNCONDITIONAL, no flag (Design H §7).
    # `git cherry` reports `+` for work already landed under a rewritten sha
    # (v0.4.214), so every `+` is checked against the base TREE before it is
    # allowed to count as pending.  The leg only ever REMOVES false positives,
    # never adds a commit back, so the three arms still partition the set and
    # the census invariant survives by construction.
    pending_shas = set()
    for plus in plus_by_branch.values():
        if plus:
            pending_shas.update(plus)
    base_blob_map = base_tree(repo, base_sha)
    blob_map = commit_blobs(repo, sorted(pending_shas))
    if base_blob_map is None or blob_map is None:
        raise CensusRefused("content leg could not read the base tree of %s"
                            % base_sha)
    present = set(s for s in pending_shas
                  if content_present(base_blob_map, blob_map.get(s)))

    # Phase 4: decompose.  The three arms PARTITION the plus set:
    #   no trailer                      -> untrailered
    #   trailer == tip_lane (both set)  -> own
    #   trailer != tip_lane (tip set)   -> other
    #   trailer present, tip_lane empty -> untrailered   (see docstring)
    rows = []
    for (name, tip) in branches:
        tip_lane = trailers.get(tip, "")
        plus = plus_by_branch.get(name)
        if plus is None:
            # In base -> `base..branch` is empty -> plus is 0 by construction.
            plus = [] if name in in_base else None
        if plus is None:
            rows.append({"branch": name, "tip": tip, "tip_lane": tip_lane,
                         "tip_in_base": 1, "plus_total": -1, "plus": -1,
                         "plus_own": -1, "plus_untrailered": -1,
                         "plus_other": -1, "plus_content_present": 0,
                         "err": "cherry-failed"})
            continue
        dropped = 0
        kept = []
        for s in plus:
            if s in present:
                dropped += 1
            else:
                kept.append(s)
        plus = kept
        own = unt = oth = 0
        for s in plus:
            t = trailers.get(s, "")
            if not t:
                unt += 1
            elif tip_lane and t == tip_lane:
                own += 1
            elif tip_lane and t != tip_lane:
                oth += 1
            else:
                unt += 1
        total = len(plus)
        rows.append({"branch": name, "tip": tip, "tip_lane": tip_lane,
                     "tip_in_base": 0 if name in in_base else 1,
                     "plus_total": total, "plus": total,
                     "plus_own": own, "plus_untrailered": unt,
                     "plus_other": oth,
                     "plus_content_present": dropped})

    rows.sort(key=lambda r: r["branch"])
    # The class is derived from the row's OWN fields, never from the asker's
    # expectation -- classify() is the single home of that rule, and the error
    # row (plus_total -1) lands there as ERROR like any other.
    for r in rows:
        r["class"] = classify(r, lane)
    meta = {"repo": repo, "base": base, "base_sha": base_sha,
            "branch_glob": glob or "*", "jobs": jobs, "lane": lane,
            "branches": len(rows), "rollup": rollup(rows),
            "content_leg": "ran"}
    return rows, meta


class CensusRefused(Exception):
    pass


def check_invariant(rows):
    """plus_total == plus_own + plus_untrailered + plus_other, EVERY row."""
    bad = []
    for r in rows:
        if r.get("plus_total", 0) < 0:
            continue
        if r["plus_total"] != r["plus_own"] + r["plus_untrailered"] + r["plus_other"]:
            bad.append(r["branch"])
    return bad


def render(rows, meta):
    w = max([len(r["branch"]) for r in rows] + [6])
    wc = max([len(r.get("class", "")) for r in rows] + [len("CLASS")])
    out = []
    out.append("%-*s  %-*s  %-8s  %5s %5s %5s %5s %5s  %s"
               % (w, "BRANCH", wc, "CLASS", "IN-BASE",
                  "TOT", "OWN", "UNTR", "OTHER", "CP", "TIP_LANE"))
    for r in rows:
        if r.get("plus_total", 0) < 0:
            out.append("%-*s  %-*s  %-8s  %s"
                       % (w, r["branch"], wc, r.get("class", "ERROR"), "?",
                          r.get("err", "error")))
            continue
        out.append("%-*s  %-*s  %-8s  %5d %5d %5d %5d %5d  %s"
                   % (w, r["branch"], wc, r.get("class", ""),
                      "yes" if r["tip_in_base"] == 0 else "no",
                      r["plus_total"], r["plus_own"], r["plus_untrailered"],
                      r["plus_other"], r.get("plus_content_present", 0),
                      r["tip_lane"] or "-"))
    tot = {k: sum(r[k] for r in rows if r.get("plus_total", 0) >= 0)
           for k in ("plus_total", "plus_own", "plus_untrailered",
                     "plus_other", "plus_content_present")}
    inb = sum(1 for r in rows if r.get("tip_in_base") == 0)
    out.append("")
    out.append("%d branches · %d already in base · %d swept"
               % (len(rows), inb, len(rows) - inb))
    out.append("sum(plus_total)=%d = own %d + untrailered %d + other %d"
               % (tot["plus_total"], tot["plus_own"], tot["plus_untrailered"],
                  tot["plus_other"]))
    # The content leg's status is a CONSTANT field, not a branch: the leg is
    # unconditional (Design H §7), so its report reads the field rather than
    # deciding whether to mention it.  CP = `+` commits whose post-image
    # content is already in the base -- dropped, never counted as pending.
    out.append("content leg: %s (unconditional) · CP %d dropped as already "
               "present in the base"
               % (meta.get("content_leg", "?"), tot["plus_content_present"]))

    # The rollup: per-lane sums, keyed on the lane keys OBSERVED.  A lane that
    # tips no branch is absent here, not a phantom 0 -- the difference between
    # "this lane has nothing out" and "this lane does not exist".
    rl = meta.get("rollup") or {}
    lanes = rl.get("lanes") or {}
    out.append("%d lanes observed · sum(plus_own)=%d"
               % (rl.get("lanes_total", 0), rl.get("sum_plus_own", 0)))
    for k in sorted(lanes):
        out.append("  %s  %d" % (k, lanes[k]))
    if rl.get("zero_own"):
        out.append("lanes whose lane-scoped pending is 0 across EVERY branch "
                   "they tip (an aggregate advisory names these falsely): %d"
                   % len(rl["zero_own"]))
        for k in rl["zero_own"]:
            out.append("  %s" % k)
    mk = rl.get("malformed_keys") or {}
    if mk:
        out.append("MALFORMED_TRAILER keys — a CLASS, never a lane: %d" % len(mk))
        for k in sorted(mk):
            out.append("  %s  on %d tip(s)" % (k, mk[k]))
    out.append("base %s @ %s" % (meta["base"], meta["base_sha"]))
    return "\n".join(out)


def _fixture_repo(root):
    """Build the fixture repo used by --selftest.

    Every commit writes a DISTINCT file: `git cherry` compares PATCH-IDS, so a
    set of empty (or identical) commits would collapse onto one patch-id and the
    `+`/`-` classification would be meaningless.

    Graph (base = `main`):

        main                base commit + feat/absorbed's commit (ff-merged)
        feat/alpha          a1, a2          both LANE_A        -> own=2
        feat/mixed          m1 LANE_B, m2 LANE_A (tip)         -> own=1 other=1
        feat/tipbare        b1 LANE_B, b2 NO TRAILER (tip)     -> unt=2
        feat/absorbed       c1              ff-merged into main-> plus=0
        feat/malformed      x1, x2          tip lane `7198`    -> own=2, MALFORMED
        feat/peer           p1, p2          both LANE_B (tip)  -> own=2, NOT_YOURS
                                                                 when asking as LANE_A
        feat/dup            d1              same PATCH as c1   -> plus=0 (cherry says
                                            tip lane LANE_C       `-`), tip NOT an
                                                                 ancestor -> the
                                                                 YOUR_PENDING_ZERO case
        feat/content        k1 LANE_A,     k1's CONTENT is main's -> plus=1: k1 is
                            k2 LANE_A       f_dup.txt by another    DROPPED by the
                            (tip)           route, so cherry says  content leg, k2
                                            `+` (different patch)  is real work
        main                +1 commit      after the absorbed ff-merge: writes
                                            f_dup.txt + a SECOND file, so its
                                            patch-id differs from k1's (identical
                                            patch-ids would make cherry say `-`
                                            and the fixture would prove nothing)
    """
    def g(*a, **kw):
        p = subprocess.run(["git", "-C", root] + list(a),
                           capture_output=True, text=True)
        if p.returncode != 0 and not kw.get("allow_fail"):
            raise RuntimeError("fixture git %s failed: %s" % (" ".join(a), p.stderr.strip()))
        return p

    g("init", "-q")
    g("symbolic-ref", "HEAD", "refs/heads/main")
    g("config", "user.email", "census@selftest.invalid")
    g("config", "user.name", "oc-census selftest")

    def commit(fname, msg, lane=None):
        with open(os.path.join(root, fname), "w") as f:
            f.write(msg + "\n")
        g("add", fname)
        body = msg + "\n\nSession-Id: " + lane + "\n" if lane else msg + "\n"
        g("commit", "-q", "-m", body)

    commit("f_base.txt", "base")
    g("checkout", "-q", "-b", "feat/alpha")
    commit("f_a1.txt", "alpha 1", LANE_A)
    commit("f_a2.txt", "alpha 2", LANE_A)
    g("checkout", "-q", "-b", "feat/mixed", "main")
    commit("f_m1.txt", "mixed 1", LANE_B)
    commit("f_m2.txt", "mixed 2", LANE_A)
    g("checkout", "-q", "-b", "feat/tipbare", "main")
    commit("f_b1.txt", "bare 1", LANE_B)
    commit("f_b2.txt", "bare 2")            # TIP carries NO trailer
    g("checkout", "-q", "-b", "feat/absorbed", "main")
    commit("f_c1.txt", "absorbed 1")
    g("checkout", "-q", "-b", "feat/malformed", "main")
    commit("f_x1.txt", "malformed 1", LANE_MALFORMED)
    commit("f_x2.txt", "malformed 2", LANE_MALFORMED)   # TIP's lane is `7198`
    g("checkout", "-q", "-b", "feat/peer", "main")
    commit("f_p1.txt", "peer 1", LANE_B)
    commit("f_p2.txt", "peer 2", LANE_B)                # TIP belongs to LANE_B
    # feat/dup replays the SAME patch as feat/absorbed's c1 (same file, same
    # content, same diff) on a DIFFERENT parent, so it gets a new sha but a
    # matching patch-id: once c1 is in main, `git cherry` reports `-` and plus
    # is empty -- while the tip is still NOT an ancestor.  That is the
    # YOUR_PENDING_ZERO case, and the lane it tips is the population an
    # aggregate-based advisory names falsely.
    g("checkout", "-q", "-b", "feat/dup", "main")
    commit("f_c1.txt", "absorbed 1", LANE_C)
    # feat/content carries TWO `+` commits: k1 writes f_dup.txt with content
    # main will already hold, by a ONE-file patch, while main lands the same
    # f_dup.txt content inside a TWO-file commit.  Different patch-ids -> cherry
    # says `+` for k1 -- while k1's post-image content is already in the base.
    # That is the v0.4.214 hazard, and it is the content leg's only job.  k2 is
    # genuinely new work and MUST survive the leg, so the test discriminates
    # "subtracts" from "zeroes the row".
    g("checkout", "-q", "-b", "feat/content", "main")
    commit("f_dup.txt", "landed elsewhere", LANE_A)
    commit("f_new.txt", "genuinely new", LANE_A)
    g("checkout", "-q", "main")
    g("merge", "-q", "--ff-only", "feat/absorbed")
    with open(os.path.join(root, "f_dup.txt"), "w") as f:
        f.write("landed elsewhere\n")
    with open(os.path.join(root, "f_other.txt"), "w") as f:
        f.write("other\n")
    g("add", "f_dup.txt", "f_other.txt")
    g("commit", "-q", "-m", "landed by another route")


def selftest():
    import shutil
    import tempfile

    fails = []

    def ck(cond, msg):
        print(("  ok   - " if cond else "  FAIL - ") + msg)
        if not cond:
            fails.append(msg)

    tool = os.path.abspath(__file__)
    root = tempfile.mkdtemp(prefix="oc-census-selftest-")
    try:
        try:
            _fixture_repo(root)
        except Exception as e:
            print("  FAIL - fixture build failed: %s" % e)
            return 1

        def run(*args):
            # Invoke through the shebang (not sys.executable) so the selftest
            # also exercises the exec bit the battery's run_selftest requires,
            # and suppress the unified log -- a selftest run is not usage and
            # must not append ~10 rows to the real tools.log.
            p = subprocess.run([tool, "--repo", root, "--base", "main"] + list(args),
                               capture_output=True, text=True,
                               env=dict(os.environ, OC_TOOLS_NOLOG="1"))
            return p.returncode, p.stdout, p.stderr

        def _repo_state():
            # The fixture's ref store, HEAD and object store as one comparable
            # string.  `for-each-ref` is deliberately UNFILTERED: a stray write
            # outside refs/heads is still a write.
            out = []
            for args in (("for-each-ref", "--format=%(refname) %(objectname)"),
                         ("rev-parse", "HEAD"),
                         ("count-objects", "-v")):
                p = subprocess.run(["git", "-C", root] + list(args),
                                   capture_output=True, text=True)
                out.append(p.stdout)
            return "\n".join(out)

        # Pin the fixture's state BEFORE the first census run, so leg 17 can
        # prove the WHOLE battery left it untouched.  A snapshot taken at leg
        # 17 would already have absorbed any write made by legs 1-16 -- a
        # mutant that writes one ref per run would then look idempotent and
        # the leg would pass while measuring nothing.
        state_before = _repo_state()

        # ---- 1. --json well-formed, rc 0 ------------------------------------
        rc, out, err = run("--json")
        ck(rc == 0, "--json exits 0 (rc=%d, stderr=%r)" % (rc, err.strip()[:120]))
        try:
            doc = json.loads(out)
        except Exception as e:
            ck(False, "--json is well-formed (%s)" % e)
            return 1
        ck(True, "--json is well-formed")
        ck("rows" in doc and "meta" in doc, "document carries rows + meta (ref-state)")
        ck(doc["meta"].get("base") == "main", "meta.base names the ref the census was taken at")
        ck(bool(doc["meta"].get("base_sha")), "meta.base_sha pins that ref's sha")

        rows = {r["branch"]: r for r in doc["rows"]}
        ck(len(rows) == 9, "9 fixture branches censused (got %d: %s)"
           % (len(rows), sorted(rows)))

        # ---- 2. THE INVARIANT, every row -----------------------------------
        bad = [b for b, r in rows.items()
               if r["plus_total"] != r["plus_own"] + r["plus_untrailered"] + r["plus_other"]]
        ck(not bad, "plus_total == plus_own + plus_untrailered + plus_other on every row"
                    + (" (violations: %s)" % bad if bad else ""))

        # ---- 3. decomposition values ---------------------------------------
        exp = {
            "feat/alpha":     (2, 2, 0, 0, LANE_A),
            "feat/mixed":     (2, 1, 0, 1, LANE_A),
            "feat/tipbare":   (2, 0, 2, 0, ""),
            "feat/absorbed":  (0, 0, 0, 0, ""),
            "main":           (0, 0, 0, 0, ""),
            "feat/malformed": (2, 2, 0, 0, LANE_MALFORMED),
            "feat/peer":      (2, 2, 0, 0, LANE_B),
            "feat/dup":       (0, 0, 0, 0, LANE_C),
            # k1 is `+` by patch-id but its CONTENT is already in the base, so
            # the content leg drops it; k2 is real work and survives.  A row of
            # (1, 1, 0, 0) is the only shape that proves the leg SUBTRACTS
            # rather than zeroing the row or leaving it alone.
            "feat/content":   (1, 1, 0, 0, LANE_A),
        }
        for b, (tot, own, unt, oth, lane) in sorted(exp.items()):
            r = rows.get(b)
            if r is None:
                ck(False, "%s present in census" % b)
                continue
            got = (r["plus_total"], r["plus_own"], r["plus_untrailered"],
                   r["plus_other"], r["tip_lane"])
            ck(got == (tot, own, unt, oth, lane),
               "%s decomposition = total %d / own %d / untrailered %d / other %d, "
               "tip_lane %s (got %s)" % (b, tot, own, unt, oth, lane or "''", got))

        # ---- 4. in-base branch is NOT reported as pending ------------------
        ck(rows["feat/absorbed"]["tip_in_base"] == 0,
           "a branch whose tip is reachable from the base reports tip_in_base=0")
        ck(rows["feat/alpha"]["tip_in_base"] == 1,
           "a branch with pending commits reports tip_in_base=1")
        ck(rows["feat/absorbed"]["plus_total"] == 0,
           "an already-absorbed branch reports plus_total=0 (cherry skipped, not guessed)")

        # ---- 5. the tip-lane rule: the TIP's trailer names the lane ---------
        ck(rows["feat/tipbare"]["tip_lane"] == "",
           "a tip with no Session-Id yields tip_lane='' (unattributable), not a guessed lane")
        ck(rows["feat/tipbare"]["plus_untrailered"] == 2,
           "commits with no trailer AND commits whose lane is unknown both land untrailered")

        # ---- 6. determinism (two runs byte-identical) ----------------------
        rc2, out2, _ = run("--json")
        ck(rc2 == 0 and out2 == out, "two runs on an unchanged repo are byte-identical")

        # ---- 7. parallelism is EXACTLY equivalent to serial ----------------
        rc3, out3, _ = run("--json", "--jobs", "1")
        ck(rc3 == 0 and json.loads(out3)["rows"] == doc["rows"],
           "--jobs 1 and --jobs %d produce identical rows (pool is equivalence-preserving)"
           % DEFAULT_JOBS)

        # ---- 8. --branch glob narrows the sweep ----------------------------
        rc4, out4, _ = run("--json", "--branch", "feat/*")
        ck(rc4 == 0 and len(json.loads(out4)["rows"]) == 8,
           "--branch 'feat/*' narrows to the 8 feat/ branches")

        # ---- 9. refusal contract -------------------------------------------
        rc5, _, _ = run("--repo", os.path.join(root, "nope"), "--json")
        ck(rc5 == 1, "an unresolvable repo refuses with rc 1 (got %d)" % rc5)
        rc6, _, _ = run("--base", "no-such-ref-xyz", "--json")
        ck(rc6 == 1, "an unresolvable base refuses with rc 1 (got %d)" % rc6)

        # ---- 10. human table renders ---------------------------------------
        rc7, out7, _ = run()
        ck(rc7 == 0 and "sum(plus_total)=" in out7,
           "default output is the human table with the decomposition line")

        # ---- 11. MALFORMED_TRAILER is a CLASS, never a lane ----------------
        ck(rows["feat/malformed"]["class"] == "MALFORMED_TRAILER",
           "a non-UUID Session-Id on the tip is MALFORMED_TRAILER (got %s)"
           % rows["feat/malformed"]["class"])
        rl = doc["meta"]["rollup"]
        ck(LANE_MALFORMED not in rl["lanes"],
           "the malformed key NEVER inflates the lane count (absent from rollup.lanes)")
        ck(rl["malformed_keys"].get(LANE_MALFORMED) == 1,
           "it is held in its own map, keyed on the tips that carry it (got %s)"
           % rl["malformed_keys"])
        ck(rl["lanes_total"] == 3,
           "rollup counts the 3 real fixture lanes, not 4 (got %d)" % rl["lanes_total"])
        ck(rl["lanes"] == {LANE_A: 4, LANE_B: 2, LANE_C: 0},
           "per-lane sums of plus_own (got %s)" % rl["lanes"])

        # ---- 12. ALREADY_ABSORBED is terminal, tested FIRST ----------------
        ck(rows["feat/absorbed"]["class"] == "ALREADY_ABSORBED",
           "a tip reachable from the base with zero lane-scoped pending is ALREADY_ABSORBED")
        ck(rows["main"]["class"] == "ALREADY_ABSORBED",
           "tested FIRST: a trailless in-base row is not misfiled as UNATTRIBUTABLE")
        ck(rows["feat/tipbare"]["class"] == "UNATTRIBUTABLE",
           "a trailless tip that is NOT in base is UNATTRIBUTABLE")

        # ---- 13. the four --lane classes -----------------------------------
        rc8, out8, _ = run("--json", "--lane", LANE_A)
        c8 = {r["branch"]: r["class"] for r in json.loads(out8)["rows"]}
        ck(rc8 == 0 and c8["feat/alpha"] == "YOUR_PENDING",
           "--lane LANE_A: feat/alpha is YOUR_PENDING (got %s)" % c8.get("feat/alpha"))
        ck(c8["feat/peer"] == "NOT_YOURS",
           "--lane LANE_A: a branch tipping LANE_B is NOT_YOURS (got %s)" % c8.get("feat/peer"))
        ck(c8["feat/malformed"] == "MALFORMED_TRAILER",
           "a malformed tip stays MALFORMED_TRAILER even when asked as a lane")
        ck(c8["feat/tipbare"] == "UNATTRIBUTABLE",
           "a trailless tip stays UNATTRIBUTABLE even when asked as a lane")
        ck(c8["feat/absorbed"] == "ALREADY_ABSORBED",
           "an absorbed branch stays ALREADY_ABSORBED whatever the asker")

        # ---- 14. the wording rule: a lane-scoped 0 is NOT "absorbed" -------
        rc9, out9, _ = run("--json", "--lane", LANE_C)
        c9 = {r["branch"]: r["class"] for r in json.loads(out9)["rows"]}
        ck(c9["feat/dup"] == "YOUR_PENDING_ZERO",
           "--lane LANE_C: feat/dup (patch-id match, tip NOT an ancestor) is "
           "YOUR_PENDING_ZERO, never ALREADY_ABSORBED (got %s)" % c9.get("feat/dup"))
        ck(rows["feat/dup"]["tip_in_base"] == 1 and rows["feat/dup"]["plus_total"] == 0,
           "feat/dup is the live case: tip NOT in base, yet plus is 0 by patch-id match")
        ck(rl["zero_own"] == [LANE_C],
           "the lane-scoped-0 population is named (got %s)" % rl["zero_own"])

        # ---- 15. a malformed --lane is refused, not silently misread -------
        rc10, _, err10 = run("--json", "--lane", LANE_MALFORMED)
        ck(rc10 == 2, "a non-UUID --lane is refused with rc 2 (got %d)" % rc10)
        ck("--lane must be a Session-Id UUID" in err10,
           "the refusal names the argument it rejected")

        # ---- 16. the CONTENT leg (the v0.4.214 rewritten-sha hazard) -------
        # k1 is `+` by patch-id while its post-image content already sits in
        # the base by ANOTHER route; only a content check can see that, so a
        # census trusting the raw `+` reports landed work as pending.
        r = rows["feat/content"]
        ck(r["plus_total"] == 1,
           "a `+` whose content is already in the base is NOT counted as "
           "pending on a default run (feat/content plus_total=%d, want 1)"
           % r["plus_total"])
        ck(r.get("plus_content_present") == 1,
           "the dropped commit is REPORTED, not silently swallowed "
           "(plus_content_present=%r, want 1)" % r.get("plus_content_present"))
        ck(r["plus_total"] == r["plus_own"] + r["plus_untrailered"] + r["plus_other"],
           "the content leg leaves the three-arm partition intact -- it only "
           "ever removes false positives")
        ck(doc["meta"].get("content_leg") == "ran",
           "content_leg is a CONSTANT output field on a default run (got %r)"
           % doc["meta"].get("content_leg"))
        rc11, out11, _ = run("--json", "--lane", LANE_A)
        ck(rc11 == 0 and json.loads(out11)["meta"].get("content_leg") == "ran",
           "…and on a --lane run too: a field, never a branch")
        ck(doc["meta"]["totals"].get("plus_content_present") == 1,
           "meta.totals.plus_content_present agrees with the per-row sum (got %r)"
           % doc["meta"]["totals"].get("plus_content_present"))

        # ---- 17. THE READ-ONLY PROOF (task 14) ------------------------------
        # The census is a measurement, so it must leave the repo it measures
        # exactly as it found it: a run that wrote a ref or an object would
        # pass every leg above and still be unusable against a live repo.
        # state_before was pinned before leg 1, so this compares the fixture
        # across EVERY run this battery made -- not merely the two below.
        state_after = _repo_state()
        ck(state_before == state_after,
           "no census run in this battery wrote a ref or an object (refs + "
           "HEAD + object store byte-identical before/after)")
        rc12, _, _ = run("--json")
        ck(rc12 == 0 and state_before == _repo_state(),
           "…and a further full sweep on top of it writes nothing either "
           "(rc=%d)" % rc12)

        if fails:
            print("  %d FAILED" % len(fails))
            return 1
        print("  all checks passed")
        return 0
    finally:
        shutil.rmtree(root, ignore_errors=True)


def main(argv):
    ap = argparse.ArgumentParser(
        prog=TOOL, add_help=True,
        description="READ-ONLY pending-branch census (runbook Step 7 step 0).")
    ap.add_argument("--repo", default=DEFAULT_REPO, help="git repo (default %s)" % DEFAULT_REPO)
    ap.add_argument("--base", default=DEFAULT_BASE, help="base ref (default %s)" % DEFAULT_BASE)
    ap.add_argument("--branch", default="", help="only branches matching this glob (short name)")
    ap.add_argument("--jobs", type=int, default=DEFAULT_JOBS, help="cherry workers (default %d)" % DEFAULT_JOBS)
    ap.add_argument("--lane", default="", help="asker's Session-Id (a lane UUID); classifies "
                    "each row YOUR_PENDING / YOUR_PENDING_ZERO / NOT_YOURS")
    ap.add_argument("--json", action="store_true", help="emit JSON object {meta, rows, totals}")
    ap.add_argument("--selftest", action="store_true", help="run the built-in fixture test")
    ap.add_argument("--no-log", action="store_true", help="suppress the unified tools log")
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    if args.lane and not is_lane(args.lane):
        # A malformed --lane would classify EVERY row NOT_YOURS and read as
        # "you owe nothing" -- a wrong answer wearing a confident face.
        sys.stderr.write("%s: --lane must be a Session-Id UUID (got %r)\n"
                         % (TOOL, args.lane))
        return 2

    oc_log_init(TOOL)
    rc = 0
    try:
        try:
            rows, meta = census(args.repo, args.base, args.branch, args.jobs,
                                args.lane)
        except CensusRefused as e:
            sys.stderr.write("%s: REFUSED — %s\n" % (TOOL, e))
            oc_log_extra("verdict", "refused")
            rc = 1
            return rc

        bad = check_invariant(rows)
        oc_log_extra("branches", len(rows))
        oc_log_extra("invariant", "ok" if not bad else "BROKEN")
        if bad:
            sys.stderr.write("%s: INVARIANT BREAK on %d row(s): %s\n"
                             % (TOOL, len(bad), ", ".join(bad[:10])))
            rc = 3
            return rc

        if args.json:
            tot = {k: sum(r[k] for r in rows if r.get("plus_total", 0) >= 0)
                   for k in ("plus_total", "plus_own", "plus_untrailered",
                             "plus_other", "plus_content_present")}
            meta = dict(meta)
            meta["totals"] = tot
            meta["invariant"] = "plus_total == plus_own + plus_untrailered + plus_other"
            print(json.dumps({"meta": meta, "rows": rows},
                             indent=1, sort_keys=True))
        else:
            print(render(rows, meta))
        return rc
    finally:
        # rc, not a hardcoded 0: a refusal (1) and an invariant break (3) are
        # the two outcomes an auditor most needs to see in the log.
        oc_log_finish(rc)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
