#!/usr/bin/env bash
# =============================================================================
# oc-issue-create — creation-time parent gate for fleet issues
# =============================================================================
# Owner order 2026-09-25 ~21:35Z ("go filing gate"). The Continuous Issue
# Relationship Linking Mandate (owner 2026-09-16) LAPSED on 2026-09-22 because
# nothing mechanical enforced it: measured at filing, of 143 open fix-titled
# fork issues 107 had NO parent, and GitHub's PARENT_ISSUE_REMOVED timeline
# event was 0 across every sampled issue -- so this is never-created, not lost.
# A mandate with no gate lapses; this is the gate.
#
# The parent is settable AT CREATION: `gh issue create --parent <N>` exists
# (gh 2.100.0, `gh issue create --help:41`), so no follow-up edit is needed.
#
# Usage: oc-issue-create [--parent <N>] [--no-parent <reason>] [--propose-parent]
#                        [--assignee <login>] [--no-assignee <reason>]
#                        [--tracker factory|binary|fork] [--repo <slug>]
#                        [--repo-path <dir>] [--dry-run] [--selftest]
#                        [--] <gh issue create flags...>
# Exit:  0 created / 2 usage / 3 REFUSED by the gate (nothing filed)
#        4 gh failed / 5 no repo at --repo-path
#
# TRACKER (two streams, SKILL.md; owner order 2026-10-03, SUPERSEDED by the owner
# order 2026-10-09 -- fork-first binary issues): --tracker factory (DEFAULT)
# targets leshchenko1979/opencrabs-dev-factory; --tracker binary targets the FORK
# leshchenko1979/opencrabs, the single BINARY tracker since 2026-10-09 (the legacy
# value `fork` is accepted as an ALIAS of `binary`). UPSTREAM opencrabs/opencrabs
# is PRs-only and receives no issues; it stays reachable only through an explicit
# --repo override. --repo is a raw override that wins over --tracker. The resolved
# target is PRINTED on every run, so the default is DECLARED, never silent -- a
# silent default is what let this tool keep filing on a tracker after the law
# moved.
#
# GATE: a title matching ^(fix|bug)[(:] with NO --parent is REFUSED. The refusal
# prints the rule + law citation, mechanically-derived candidate parents, and
# the escape hatch. `--no-parent "<reason>"` files anyway and records the
# declaration as the first comment: the gate forbids a SILENT default, never a
# DECLARED one, so a legitimate orphan bug is not blocked.
#
# ASSIGNEE (factory #36): `gh issue create --assignee` existed all along, but this
# wrapper documented `--assignee` as "passed through to gh unchanged" and had NO
# handling for it, so the creation gate's assignment leg was carried by hand by
# every filing lane. --assignee is now OURS: it defaults per tracker and is
# VERIFIED to resolve before anything is filed. The default is MEASURED
# (2026-10-10): `gh api repos/<slug>/assignees` returns leshchenko1979 ALONE on
# BOTH live trackers. `adolfousier` is RETIRED -- he is not a collaborator on the
# fork, and `--add-assignee adolfousier` NO-OPS with rc 0, so the failure reads as
# SUCCESS. An assignee that does not resolve is REFUSED (rc 3, nothing filed):
# filing unassigned silently is the defect this closes.
#
# Solo-surface (editor.md:96): the create output is the only receipt of the
# identifier, so it is surfaced unambiguously on this tool's own stdout.
# =============================================================================
set -u

_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-issue-create" "$@"; else oc_log_finish() { :; }; oc_log_extra() { :; }; fi
trap 'oc_log_finish $?' EXIT

SELF="$0"
# Two streams (SKILL.md; owner order 2026-10-09). FACTORY is the default target
# for NEW issues; the FORK leshchenko1979/opencrabs is the single BINARY tracker
# (it also stays the CI host and the PR target). UPSTREAM receives no issues.
FACTORY_REPO="${OC_ISSUE_CREATE_FACTORY:-leshchenko1979/opencrabs-dev-factory}"
FORK_REPO="leshchenko1979/opencrabs"
# The assignee default (factory #36). MEASURED 2026-10-10: BOTH live trackers
# expose leshchenko1979 alone; `adolfousier` is 404 on the fork.
DEFAULT_ASSIGNEE="${OC_ISSUE_CREATE_ASSIGNEE:-leshchenko1979}"
REPO_PATH="${OC_ISSUE_CREATE_REPO:-$HOME/opencrabs}"
GH_BIN="${OC_ISSUE_CREATE_GH:-gh}"
UPSTREAM_SLUG="${OC_ISSUE_CREATE_UPSTREAM:-opencrabs/opencrabs}"
UPSTREAM_REMOTE="${OC_ISSUE_CREATE_UPSTREAM_REMOTE:-adolfousier}"

usage() { # C-#3: --help/-h answers 0 on STDOUT; a usage error answers 2 on STDERR
  local rc="${1:-2}" fd=2
  [ "$rc" = 0 ] && fd=1
  cat >&$fd <<'USAGE'
usage: oc-issue-create [--parent <N>] [--root <upstream:obj>] [--no-parent <reason>]
                       [--assignee <login>] [--no-assignee <reason>]
                       [--propose-parent]
                       [--tracker factory|binary|fork] [--repo <slug>]
                       [--repo-path <dir>] [--dry-run] [--selftest]
                       [--] <gh issue create flags...>

Wraps `gh issue create` and REFUSES a fix/bug-titled issue that names no parent.

  --parent <N>        set the parent AT CREATION (gh issue create --parent)
  --root <obj>        declare an UPSTREAM-INHERITED surface (upstream-rooted):
                      upstream:<sha|PR|path> in opencrabs/opencrabs. The object
                      must RESOLVE; an unresolvable root is REFUSED, because it
                      is --no-parent in better clothes. Recorded as the first
                      comment (`root: <obj>`), never as an orphan.
  --no-parent <why>   file anyway, recording the declaration as the first
                      comment. The gate forbids a SILENT default, not a
                      declared one. Last resort -- prefer --root when the
                      surface is upstream-inherited.
  --assignee <login>  the assignee for the new issue. Defaults to
                      leshchenko1979 (the only assignable account on both live
                      trackers). The login is VERIFIED against the target repo
                      before anything is filed; an unresolvable one is REFUSED.
                      With --repo <slug> (a third repo) there is no known
                      default, so an explicit --assignee or --no-assignee is
                      required.
  --no-assignee <why> file anyway, recording the declaration as the first
                      comment. The gate forbids a SILENT default, not a
                      declared one.
  --propose-parent    compute and print candidate parents only; file nothing
  --tracker <which>   target tracker: `factory` (default — the dev-factory repo,
                      leshchenko1979/opencrabs-dev-factory) or `binary` (the FORK
                      leshchenko1979/opencrabs, the single binary tracker since
                      2026-10-09). UPSTREAM opencrabs/opencrabs is PRs-only and
                      receives no issues. `fork` is accepted as an alias of
                      `binary`. Aliases: --factory / --binary.
  --repo <slug>       raw override of the target repo; WINS over --tracker
                      (default: whichever repo --tracker resolves to)
  --repo-path <dir>   override the git checkout used for blame (default ~/opencrabs)
  --dry-run           print the gh command without running it
  --selftest          run the built-in checks

Everything else is passed through to `gh issue create` unchanged
(--title, --body, --body-file, --label, --milestone, ...).
--assignee is OURS, not a passthrough (factory #36): it defaults per tracker and
is verified to resolve before anything is filed.

Exit: 0 created / 2 usage / 3 REFUSED (nothing filed) / 4 gh failed / 5 no repo

KNOWN LIMIT OF --propose-parent: the proposal blames the pre-image lines each
fix commit touched and takes the blamed commit's issue token. Blame is
confidently WRONG when a fix adds new plumbing whose pre-image lines were
written by unrelated infrastructure (live specimen: #487's top-1 blamed
candidate was #405; the real feature is #286). The proposal is an INPUT to your
judgement, never an auto-link. It is also structurally blind for the ~44% of
fix issues with no commit on main at all -- those print "no commit on main",
never a guess.
USAGE
  exit "$rc"
}

# ---- arg parsing: ours vs gh's ----------------------------------------------
PARENT=""; NO_PARENT=""; NO_PARENT_SET=0; ROOT=""; ROOT_SET=0; PROPOSE=0; DRY=0; SELFTEST=0
ASSIGNEE=""; NO_ASSIGNEE=""; NO_ASSIGNEE_SET=0
TRACKER="factory"; REPO_OVERRIDE=""; PASSTHRU=()
while [ $# -gt 0 ]; do
  case "$1" in
    --selftest) SELFTEST=1; shift ;;
    -h|--help) usage 0 ;;   # fleet contract (RC-CONTRACT): --help exits 0 on STDOUT
    --tracker) [ $# -ge 2 ] || { echo "oc-issue-create: --tracker needs a value" >&2; usage; }; TRACKER="$2"; shift 2 ;;
    --tracker=*) TRACKER="${1#--tracker=}"; shift ;;
    --factory) TRACKER="factory"; shift ;;
    --binary) TRACKER="binary"; shift ;;
    --parent) [ $# -ge 2 ] || { echo "oc-issue-create: --parent needs a value" >&2; usage; }; PARENT="$2"; shift 2 ;;
    --parent=*) PARENT="${1#--parent=}"; shift ;;
    --no-parent) [ $# -ge 2 ] || { echo "oc-issue-create: --no-parent needs a reason" >&2; usage; }; NO_PARENT="$2"; NO_PARENT_SET=1; shift 2 ;;
    --no-parent=*) NO_PARENT="${1#--no-parent=}"; NO_PARENT_SET=1; shift ;;
    --root) [ $# -ge 2 ] || { echo "oc-issue-create: --root needs a value" >&2; usage; }; ROOT="$2"; ROOT_SET=1; shift 2 ;;
    --root=*) ROOT="${1#--root=}"; ROOT_SET=1; shift ;;
    --assignee) [ $# -ge 2 ] || { echo "oc-issue-create: --assignee needs a value" >&2; usage; }; ASSIGNEE="$2"; shift 2 ;;
    --assignee=*) ASSIGNEE="${1#--assignee=}"; shift ;;
    --no-assignee) [ $# -ge 2 ] || { echo "oc-issue-create: --no-assignee needs a reason" >&2; usage; }; NO_ASSIGNEE="$2"; NO_ASSIGNEE_SET=1; shift 2 ;;
    --no-assignee=*) NO_ASSIGNEE="${1#--no-assignee=}"; NO_ASSIGNEE_SET=1; shift ;;
    --propose-parent) PROPOSE=1; shift ;;
    --repo) [ $# -ge 2 ] || usage; REPO_OVERRIDE="$2"; shift 2 ;;
    --repo=*) REPO_OVERRIDE="${1#--repo=}"; shift ;;
    --repo-path) [ $# -ge 2 ] || usage; REPO_PATH="$2"; shift 2 ;;
    --repo-path=*) REPO_PATH="${1#--repo-path=}"; shift ;;
    --dry-run) DRY=1; shift ;;
    --) shift; while [ $# -gt 0 ]; do PASSTHRU+=("$1"); shift; done ;;
    *) PASSTHRU+=("$1"); shift ;;
  esac
done

# ---- tracker -> target repo (two streams; owner order 2026-10-09) -----------
# A FACTORY issue (this tools/** tree, CI, release automation, process) belongs
# on the dev-factory tracker; a BINARY issue (runtime behaviour, channels,
# providers, TUI, memory, the src/brain/tools registry) belongs on the FORK
# leshchenko1979/opencrabs, the single binary tracker since 2026-10-09. UPSTREAM
# opencrabs/opencrabs is PRs-only and receives no issues. --repo is a raw
# override and WINS: a caller legitimately naming a third repo is not a mistake.
case "$TRACKER" in
  factory|dev-factory|devfactory) TRACKER="factory"; REPO_SLUG="$FACTORY_REPO" ;;
  binary|upstream|fork)           TRACKER="binary";  REPO_SLUG="$FORK_REPO" ;;
  *) echo "oc-issue-create: --tracker must be 'factory' or 'binary' ('fork' is accepted as an alias of 'binary') (got '$TRACKER')" >&2; usage ;;
esac
if [ -n "$REPO_OVERRIDE" ]; then REPO_SLUG="$REPO_OVERRIDE"; TRACKER="override"; fi

# ---- extract --title from the passthrough (both forms) -----------------------
TITLE=""
i=0
while [ $i -lt ${#PASSTHRU[@]} ]; do
  a="${PASSTHRU[$i]}"
  case "$a" in
    --title) i=$((i+1)); TITLE="${PASSTHRU[$i]:-}" ;;
    --title=*) TITLE="${a#--title=}" ;;
    -t) i=$((i+1)); TITLE="${PASSTHRU[$i]:-}" ;;
  esac
  i=$((i+1))
done

is_fix_title() {
  # ^(fix|bug)[(:] case-insensitive -- the mandate's own scope.
  printf '%s' "$1" | grep -Eiq '^(fix|bug)[(:]'
}

# ---- candidate proposal ------------------------------------------------------
LIB_PY="$OC_TOOLS_DIR/lib/oc_parent_propose.py"
OPEN_ISSUES_JSON="$(mktemp)"
trap 'rm -f "$OPEN_ISSUES_JSON"; oc_log_finish $?' EXIT

fetch_open_issues() {
  # A FAILED fetch must never read as "no candidates": the two lead to opposite
  # advice. Returns 1 and leaves the file empty on failure.
  if ! "$GH_BIN" issue list -R "$REPO_SLUG" --state open --limit 300 \
        --json number,title > "$OPEN_ISSUES_JSON" 2>/dev/null; then
    return 1
  fi
  [ -s "$OPEN_ISSUES_JSON" ]
}

print_scope_candidates() {  # $1 = title
  local title="$1"
  if ! fetch_open_issues; then
    echo "  (candidate lookup FAILED -- gh could not read the open-issue list;"
    echo "   this is NOT 'no candidates'. Re-run, or pass --parent explicitly.)"
    return 0
  fi
  python3 - "$LIB_PY" "$title" "$OPEN_ISSUES_JSON" <<'PYEOF'
import json, sys
sys.path.insert(0, sys.argv[1].rsplit("/", 1)[0])
import oc_parent_propose as pp
title, path = sys.argv[2], sys.argv[3]
issues = json.load(open(path))
scope, cands = pp.propose_by_scope(title, issues)
if scope is None:
    print("  no (scope) token in the title -- nothing mechanically derivable.")
elif not cands:
    print("  scope '%s': no OPEN issue shares it." % scope)
else:
    print("  scope '%s': %d open issue(s) share it. Newest 8:" % (scope, len(cands)))
    for n, t in cands[:8]:
        print("    #%d  %s" % (n, t[:88]))
    print("  (a shared scope is NOT a parent -- it narrows where to look.)")
PYEOF
}

print_blame_candidates() {  # $1 = issue number
  [ -f "$LIB_PY" ] || { echo "  (engine missing: $LIB_PY)"; return 0; }
  python3 - "$LIB_PY" "$REPO_PATH" "$1" <<'PYEOF'
import sys
sys.path.insert(0, sys.argv[1].rsplit("/", 1)[0])
import oc_parent_propose as pp
repo, iss = sys.argv[2], int(sys.argv[3])
r = pp.propose_by_blame(repo, iss)
st = r["status"]
if st == "no_commit":
    print("  no commit on main names #%d -- the blame engine is structurally" % iss)
    print("  blind here (~44%% of parentless issues). Not a guess: say so.")
elif st == "no_hunk":
    print("  commits found but ZERO hunks parsed (%d blamed lines) -- the" % r["blamed"])
    print("  hunk-regex trap; the engine is blind, not the tree.")
elif st == "no_originator":
    print("  commits found, %d hunks blamed, but no blamed commit carries an" % r["hunks"])
    print("  issue token (~25%% case). Not a guess.")
else:
    print("  blame-derived candidates (hits, blamed sha):")
    for tok, hits, sha in r["candidates"]:
        print("    #%-5d %3d hit(s)  %s" % (tok, hits, sha[:10]))
    print("  KNOWN LIMIT: blame is confidently wrong when a fix adds new plumbing")
    print("  whose pre-image lines came from unrelated infrastructure. Judgement,")
    print("  never an auto-link.")
PYEOF
}


# =============================================================================
# SELFTEST — hermetic. A stub gh stands in for the network; no issue is ever
# created. Both instrument traps get a POSITIVE CONTROL (a check that can only
# pass if the trap is avoided), because each produces a confident 0% rather
# than an error.
# =============================================================================
selftest() {
  local T rc out fails=0
  T="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$T'" RETURN
  mkdir -p "$T/bin"
  # Stub gh: `issue list` answers a canned open set; `issue create` answers a URL.
  cat > "$T/bin/gh" <<'STUB'
#!/bin/sh
# Dispatch on $1 and discriminate on the RIGHT positional (factory #35).
# The previous form was `case "$1 $2" in api)` -- a pattern that had to equal the
# WHOLE "api repos/<slug>/commits/<sha>" string, so it could never match and EVERY
# api/pr call fell through to `*) exit 0`. The stub answered rc 0 to everything,
# which made its own "DISCRIMINATE" comment false: o7/o8 resolved vacuously (any
# PR/sha number), and o9 refused only because ~/opencrabs/.git exists, so the
# refusal came from `git cat-file -e`, never from the stub. A zero from an
# instrument that cannot observe the failure class (rule 7).
# For `api` the discriminator is $2 (the path); for `pr` it is $3 (the number).
case "$1" in
  issue) case "$2" in
           list)    cat "$OC_STUB_ISSUES" ;;
           create)  echo "https://github.com/leshchenko1979/opencrabs-dev-factory/issues/4242" ;;
           comment) exit 0 ;;
           *)       exit 0 ;;
         esac ;;
  # --root resolution (#646): DISCRIMINATE, so an unresolvable root is testable.
  # A stub that answered 0 for everything would make the refusal leg vacuous.
  api)   case "$2" in
           */commits/5d326aa12*|*/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa*) echo "5d326aa12"; exit 0 ;;
           # factory #36: a commit whose message carries the trailer the parent
           # derivation reads, and one whose trailer names a number that does
           # NOT resolve on the target repo (the cross-tracker collision case).
           */commits/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb) printf 'fix(tools): a ported thing\n\nCloses #10\n'; exit 0 ;;
           */commits/cccccccccccccccccccccccccccccccccccccccc) printf 'fix(tools): a ported thing\n\nCloses #999\n'; exit 0 ;;
           # factory #36: the assignee leg. `gh api repos/<slug>/assignees/<login>`
           # answers 204 (rc 0) when the login is assignable and 404 (rc 1) when
           # it is not -- the discriminator the refusal leg rests on.
           */assignees/leshchenko1979|*/assignees/someone-else) exit 0 ;;
           */assignees/*) exit 1 ;;
           # factory #36: the target-repo issue lookup a derived parent is
           # validated against before use.
           */issues/10) echo "10"; exit 0 ;;
           */issues/*) exit 1 ;;
           *) exit 1 ;;
         esac ;;
  pr)    case "$3" in
           1662|1700) echo '{"number":'"$3"'}'; exit 0 ;;
           *) exit 1 ;;
         esac ;;
  *) exit 0 ;;
esac
STUB
  chmod +x "$T/bin/gh"
  cat > "$T/issues.json" <<'JSN'
[{"number":10,"title":"fix(tools): an older tools fix"},
 {"number":11,"title":"feat(telegram): a telegram feature"},
 {"number":12,"title":"fix(tools): a newer tools fix"}]
JSN
  export OC_ISSUE_CREATE_GH="$T/bin/gh" OC_STUB_ISSUES="$T/issues.json"

  chk() { # chk <label> <want-rc> <got-rc>
    if [ "$2" = "$3" ]; then echo "  ok   - $1 (rc=$3)"; else echo "  FAIL - $1 (want rc=$2 got $3)"; fails=$((fails+1)); fi
  }
  has() { # has <label> <file> <pattern>
    if grep -qE "$3" "$2"; then echo "  ok   - $1"; else echo "  FAIL - $1"; fails=$((fails+1)); fi
  }
  hasnt() { # hasnt <label> <file> <pattern> -- the absence leg, with a real counter
    if grep -qE "$3" "$2"; then echo "  FAIL - $1 (pattern present: $3)"; fails=$((fails+1)); else echo "  ok   - $1"; fi
  }

  # --- gate behaviours -------------------------------------------------------
  bash "$SELF" --title "fix(tools): probe" --body x >"$T/o1" 2>&1; chk "fix title + no parent REFUSES" 3 $?
  has "…the refusal names the law"        "$T/o1" 'Continuous Issue Relationship Linking'
  has "…and prints scope candidates"      "$T/o1" '#12|#10'
  has "…and the escape hatch"             "$T/o1" 'no-parent'
  bash "$SELF" --title "bug: bare colon" --body x >"$T/o2" 2>&1; chk "bug: form is also gated" 3 $?
  bash "$SELF" --title "fix(tools): with parent" --body x --parent 10 --dry-run >"$T/o3" 2>&1
  chk "fix + --parent passes" 0 $?
  has "…and the parent reaches gh"        "$T/o3" 'parent.*10'
  bash "$SELF" --title "fix(tools): declared" --body x --no-parent "standalone" --dry-run >"$T/o4" 2>&1
  chk "fix + --no-parent passes" 0 $?
  has "…and the declaration is recorded"  "$T/o4" 'no parent derivable: standalone'
  bash "$SELF" --title "feat(tools): unrelated" --body x --dry-run >"$T/o5" 2>&1
  chk "non-fix title is unaffected" 0 $?
  has "…and carries no parent"            "$T/o5" 'issue create'
  bash "$SELF" --propose-parent --title "fix(telegram): x" >"$T/o6" 2>&1
  chk "--propose-parent files nothing" 0 $?
  has "…and proposes by scope"            "$T/o6" "#11"

  # --- #646: --root (the upstream-rooted declaration channel) ----------------
  # Before this, an upstream-inherited fix had NO declaration channel: the gate
  # offered --parent (wrong: there is no fork parent) or --no-parent (which files
  # it AS AN ORPHAN, the mislabel the clause forbids). The law names --root in
  # five sites and the tool implemented zero.
  bash "$SELF" --title "fix(tools): root-pr" --body x --root upstream:1662 --dry-run >"$T/o7" 2>&1
  chk "fix + --root (PR) passes the gate" 0 $?
  has "…and the root is recorded"          "$T/o7" 'root: 1662'
  has "…and NOT as an orphan"              "$T/o7" '^ *\(then comment: root:'
  hasnt "…and does not claim orphanhood"   "$T/o7" 'no parent derivable' 

  bash "$SELF" --title "fix(tools): root-sha" --body x --root upstream:5d326aa12 --dry-run >"$T/o8" 2>&1
  chk "fix + --root (sha) passes"            0 $?
  has "…and a sha root is recorded"        "$T/o8" 'root: 5d326aa12'

  # DISCRIMINATING: an unresolvable root must REFUSE. The law says it is
  # "--no-parent in better clothes", so accepting it would satisfy the letter of
  # the gate while defeating it. The stub DISCRIMINATES (see its api/pr arms) --
  # a stub answering 0 for everything would make this leg vacuous.
  bash "$SELF" --title "fix(tools): root-bad" --body x --root upstream:no/such/path.xyz >"$T/o9" 2>&1
  chk "fix + UNRESOLVABLE --root REFUSES" 3 $?
  has "…and names the resolve requirement"  "$T/o9" 'does not RESOLVE'
  has "…and cites the law clause"           "$T/o9" 'better clothes'

  # The stub's api/pr arms are the instrument these three legs rest on. Before
  # factory #35 they were unreachable dead code: `o9` refused only by accident
  # (the local checkout, via `git cat-file -e`), and these two would have
  # "resolved" against a stub that answered 0 to everything. o7/o8 are the
  # POSITIVE controls (they redden if the stub always says no); these two are the
  # NEGATIVE pair (they redden if it always says yes). Only both together make
  # the stub trustworthy.
  bash "$SELF" --title "fix(tools): root-bad-sha" --body x --root upstream:deadbeefdeadbeefdeadbeefdeadbeefdeadbeef >"$T/o17" 2>&1
  chk "fix + UNRESOLVABLE --root sha REFUSES" 3 $?
  has "…and names the resolve requirement"  "$T/o17" 'does not RESOLVE'
  has "…and reports the kind it tried"      "$T/o17" 'kind: sha'
  bash "$SELF" --title "fix(tools): root-bad-pr" --body x --root upstream:999999 >"$T/o18" 2>&1
  chk "fix + UNRESOLVABLE --root PR REFUSES" 3 $?
  has "…and reports the kind it tried"      "$T/o18" 'kind: pr'

  bash "$SELF" --title "fix(tools): root-and-parent" --body x --parent 10 --root upstream:1662 --dry-run >"$T/o10" 2>&1
  chk "--parent + --root together pass"      0 $?
  has "…and the parent still reaches gh"   "$T/o10" 'parent.*10'
  has "…and the root is still recorded"    "$T/o10" 'root: 1662'

  # --- two-stream tracker routing (SKILL.md; owner order 2026-10-09) ----------
  # The default MUST be the factory tracker: a SILENT fork default is exactly the
  # defect this fixes. The `hasnt` leg is DISCRIMINATING -- the factory slug has
  # the fork slug as a prefix, so only the `$` anchor separates "defaulted to the
  # factory" from "defaulted to the fork".
  bash "$SELF" --title "feat(tools): routed" --body x --dry-run >"$T/o11" 2>&1
  chk "default-tracker create passes" 0 $?
  has "…and defaults to the FACTORY tracker" "$T/o11" 'tracker=factory target=leshchenko1979/opencrabs-dev-factory'
  hasnt "…and NOT to the fork"               "$T/o11" 'target=leshchenko1979/opencrabs$'
  bash "$SELF" --title "feat(tools): routed" --body x --tracker binary --dry-run >"$T/o12" 2>&1
  chk "--tracker binary passes" 0 $?
  has "…and targets the FORK"                "$T/o12" 'tracker=binary target=leshchenko1979/opencrabs$'
  bash "$SELF" --title "feat(tools): routed" --body x --binary --dry-run >"$T/o13" 2>&1
  has "…the --binary alias agrees"           "$T/o13" 'tracker=binary target=leshchenko1979/opencrabs$'
  # --tracker fork is the LEGACY alias of the binary stream (owner order
  # 2026-10-09): it must be REACHABLE and resolve to the fork slug, exactly as
  # `binary` does. The `$` anchor is DISCRIMINATING -- the factory slug has the
  # fork slug as a prefix.
  bash "$SELF" --title "feat(tools): routed" --body x --tracker fork --dry-run >"$T/o16" 2>&1
  chk "--tracker fork passes" 0 $?
  has "…and the legacy alias resolves to binary" "$T/o16" 'tracker=binary target=leshchenko1979/opencrabs$'
  bash "$SELF" --title "feat(tools): routed" --body x --tracker nonsense --dry-run >"$T/o14" 2>&1
  chk "an unknown --tracker is a usage error" 2 $?
  has "…and the error names the fork alias"  "$T/o14" "'fork' is accepted as an alias of 'binary'"
  # --assignee is explicit here: a --repo override names a repo with no known
  # assignee default, so #36 REFUSES it otherwise (leg o23 pins that).
  bash "$SELF" --title "feat(tools): routed" --body x --tracker binary --repo acme/widgets --assignee leshchenko1979 --dry-run >"$T/o15" 2>&1
  chk "--repo + --tracker still pass" 0 $?
  has "…and --repo WINS over --tracker"      "$T/o15" 'target=acme/widgets'

  # --- factory #36 ITEM 1: the assignee leg ----------------------------------
  # The creation gate's assignment leg. Before #36 `--assignee` was documented as
  # "passed through to gh unchanged" with NO handling: the leg was carried by hand
  # by every filing lane. The default is MEASURED (both live trackers expose
  # leshchenko1979 ALONE); `adolfousier` is RETIRED and no-ops with rc 0, so an
  # unresolvable assignee would file UNASSIGNED while reporting success.
  #
  # The declaration leg is MUTATION-SENSITIVE: delete DEFAULT_ASSIGNEE and the
  # declaration reads `assignee=none`, so the leg REDDENS. A leg that passes with
  # the default removed would test nothing.
  bash "$SELF" --title "feat(tools): assigned" --body x --dry-run >"$T/o19" 2>&1
  chk "the default assignee resolves" 0 $?
  has "…and is declared on stdout"           "$T/o19" 'assignee=leshchenko1979'
  has "…and reaches gh"                      "$T/o19" 'assignee leshchenko1979'
  bash "$SELF" --title "feat(tools): assigned" --body x --assignee=someone-else --dry-run >"$T/o20" 2>&1
  chk "an explicit --assignee resolves" 0 $?
  has "…and overrides the default"           "$T/o20" 'assignee=someone-else'
  # DISCRIMINATING: an assignee that does not resolve must REFUSE. The stub
  # answers 404 (rc 1) for any login but the two it knows -- so this leg reddens
  # if the resolver is dropped and the tool files unassigned instead.
  bash "$SELF" --title "feat(tools): assigned" --body x --assignee nobody-at-all --dry-run >"$T/o21" 2>&1
  chk "an UNRESOLVABLE --assignee REFUSES" 3 $?
  has "…and names the resolve requirement"   "$T/o21" 'does not RESOLVE'
  has "…and names the assignee it tried"     "$T/o21" 'assignee: nobody-at-all'
  bash "$SELF" --title "feat(tools): assigned" --body x --no-assignee "bot-only repo" --dry-run >"$T/o22" 2>&1
  chk "--no-assignee passes" 0 $?
  has "…and the declaration is recorded"     "$T/o22" 'no assignee: bot-only repo'
  has "…and nothing is declared assigned"    "$T/o22" 'assignee=none'
  # A --repo override has no known default: refuse, never file unassigned.
  bash "$SELF" --title "feat(tools): assigned" --body x --repo acme/widgets --dry-run >"$T/o23" 2>&1
  chk "an unknown --repo with no --assignee REFUSES" 3 $?
  has "…and says how to proceed"             "$T/o23" 'no known assignee default'

  # --- factory #36 ITEM 2: the trailer-derived parent -------------------------
  # Where the origin is a --root upstream:<sha> commit, the parent is derivable
  # from that commit's own `Closes #N` trailer (the law's ede0763be -> #737 case).
  # The derived number is an UPSTREAM number and upstream numbers COLLIDE with
  # ours, so it is VALIDATED against the target repo before use.
  bash "$SELF" --title "fix(tools): trailer" --body x --root upstream:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb --dry-run >"$T/o24" 2>&1
  chk "a sha root with a resolvable trailer passes" 0 $?
  has "…and the parent is derived"           "$T/o24" 'parent.*10'
  has "…and the derivation is declared"      "$T/o24" 'derived parent #10'
  bash "$SELF" --title "fix(tools): trailer" --body x --root upstream:cccccccccccccccccccccccccccccccccccccccc --dry-run >"$T/o25" 2>&1
  chk "a trailer naming an UNRESOLVABLE number REFUSES" 3 $?
  has "…and names the cross-tracker hazard"  "$T/o25" 'CROSS-TRACKER HAZARD'
  # An explicit parent is never overridden by a derivation.
  bash "$SELF" --title "fix(tools): trailer" --body x --root upstream:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb --parent 12 --dry-run >"$T/o26" 2>&1
  chk "--parent wins over the derivation" 0 $?
  has "…and the explicit parent is used"     "$T/o26" 'parent.*12'
  hasnt "…and no derivation ran"             "$T/o26" 'derived parent'

  # --- trap controls: each check can only pass if the trap is AVOIDED ---------
  # (a) `git blame -s` ABBREVIATES, so a 40-hex match finds nothing. The control
  #     proves the bare form yields zero matches and the --abbrev=40 form yields
  #     the full sha -- i.e. the engine's choice of flag is load-bearing.
  R="$T/repo"; mkdir -p "$R"; ( cd "$R" && git init -q . && git config user.email t@t && git config user.name t \
    && printf 'a\nb\nc\n' > f.txt && git add f.txt && git commit -qm one \
    && printf 'a\nB\nc\n' > f.txt && git add f.txt && git commit -qm two ) >/dev/null 2>&1
  local bare full
  bare="$(cd "$R" && git blame -s -L1,1 HEAD -- f.txt 2>/dev/null | awk '{print $1}')"
  full="$(cd "$R" && git blame -s --abbrev=40 -L1,1 HEAD -- f.txt 2>/dev/null | awk '{print $1}')"
  if [ "${#bare}" -ne 40 ] && [ "${#full}" -eq 40 ]; then
    echo "  ok   - trap(a) control: bare blame is ${#bare} chars, --abbrev=40 is 40 (the flag is load-bearing)"
  else
    echo "  FAIL - trap(a) control: bare=${#bare} full=${#full}"; fails=$((fails+1))
  fi
  # (b) `^@@` without re.M matches ZERO hunks on a real diff.
  local nom ult
  nom="$(cd "$R" && git diff HEAD~1 HEAD -- f.txt | grep -cE '^@@' || true)"
  ult="$(cd "$R" && git diff HEAD~1 HEAD -- f.txt | grep -c '@@' || true)"
  if [ "${nom:-0}" -eq 1 ] && [ "${ult:-0}" -ge 1 ]; then
    echo "  ok   - trap(b) control: anchored ^@@ finds the hunk (the re.M/anchoring choice is load-bearing)"
  else
    echo "  FAIL - trap(b) control: anchored=${nom:-0} unanchored=${ult:-0}"; fails=$((fails+1))
  fi
  # and the ENGINE's own regexes behave: HUNK_RE is compiled with re.M.
  local eng
  eng="$(python3 - "$OC_TOOLS_DIR" "$R" <<'OCPY' 2>/dev/null

import sys; sys.path.insert(0, sys.argv[1] + '/lib')
import oc_parent_propose as pp, re
d = open(sys.argv[2] + '/f.txt').read() or ''
diff = 'x\n@@ -1,2 +1,2 @@\n-a\n+b\n'
print(len(pp.HUNK_RE.findall(diff)))
OCPY
)"
  if [ "${eng:-0}" -eq 1 ]; then echo "  ok   - engine HUNK_RE is compiled with re.M (finds 1 hunk)";
  else echo "  FAIL - engine HUNK_RE found ${eng:-0} hunks (want 1)"; fails=$((fails+1)); fi

  # --- the FAILED-fetch guard: a failed candidate lookup must not read as none
  bash "$SELF" --title "fix(tools): x" --body x >"$T/o7" 2>&1
  mv "$T/issues.json" "$T/issues.gone"
  bash "$SELF" --title "fix(tools): x" --body x >"$T/o8" 2>&1
  has "a FAILED candidate lookup says so, never 'no candidates'" "$T/o8" 'lookup FAILED'
  mv "$T/issues.gone" "$T/issues.json"

  unset OC_ISSUE_CREATE_GH OC_STUB_ISSUES
  echo "oc-issue-create selftest: FAIL=$fails"
  return $(( fails > 0 ? 1 : 0 ))
}

if [ "$SELFTEST" = 1 ]; then selftest; exit $?; fi

# ---- propose-only mode -------------------------------------------------------
if [ "$PROPOSE" = 1 ]; then
  echo "oc-issue-create --propose-parent"
  if [ -n "$TITLE" ]; then
    echo "by scope (title: ${TITLE:0:80}):"
    print_scope_candidates "$TITLE"
  else
    echo "by scope: no --title given, nothing to derive a scope from."
  fi
  # An explicit numeric positional turns on the blame engine for an EXISTING issue.
  for a in "${PASSTHRU[@]:-}"; do
    case "$a" in
      ''|--*|-*) continue ;;
      [0-9]*)
        if [ ! -d "$REPO_PATH/.git" ]; then
          echo "oc-issue-create: no git checkout at $REPO_PATH -- the blame engine" >&2
          echo "needs one. Pass --repo-path <dir>." >&2
          exit 5
        fi
        echo; echo "by blame (existing issue #$a):"; print_blame_candidates "$a" ;;
    esac
  done
  exit 0
fi

# ---- the root resolver --------------------------------------------------------
# The law (SKILL.md:474-481, triage.md:201, editor.md:231, upstream-merge-runbook.md:312)
# names `--root upstream:<sha|PR|path>` for an upstream-inherited surface. The same clause
# says the object MUST RESOLVE, "or the flag is --no-parent in better clothes" -- so an
# unresolvable root is refused rather than recorded as a declaration.
#
# Accepted, all normalised to an `upstream:` prefix when the caller omits it:
#   upstream:<7-40 hex>   a commit in opencrabs/opencrabs
#   upstream:<digits>     a PR number there
#   upstream:<path>       a tracked path on that repo's main
root_kind() { # $1 = value -> echoes sha|pr|path, or nothing
  case "$1" in
    */*|*.*) printf 'path' ;;
    ''|*[!0-9a-fA-F]*) : ;;                       # has non-hex, non-slash -> unknown
    *[a-fA-F]*) [ ${#1} -ge 7 ] && printf 'sha' ;;  # carries a hex letter -> a sha
    *) [ ${#1} -ge 7 ] && printf 'sha' || printf 'pr' ;;
  esac
}

root_resolves() { # $1 = value (with or without upstream:). rc 0 = resolves
  local v kind
  v="${1#upstream:}"
  v="${v#opencrabs/opencrabs}"            # canonical slug (post-rename)
  v="${v#adolfousier/opencrabs}"          # legacy slug (pre-rename callers)
  kind="$(root_kind "$v")"
  case "$kind" in
    sha)  "$GH_BIN" api "repos/$UPSTREAM_SLUG/commits/$v" --jq .sha >/dev/null 2>&1 ;;
    pr)   "$GH_BIN" pr view "$v" -R "$UPSTREAM_SLUG" --json number >/dev/null 2>&1 ;;
    path) if [ -d "$REPO_PATH/.git" ]; then
            git -C "$REPO_PATH" cat-file -e "$UPSTREAM_REMOTE/main:$v" 2>/dev/null
          else
            "$GH_BIN" api "repos/$UPSTREAM_SLUG/contents/$v?ref=main" --jq .path >/dev/null 2>&1
          fi ;;
    *)    return 1 ;;
  esac
}

# ---- the gate ----------------------------------------------------------------
if [ -z "$TITLE" ]; then
  echo "oc-issue-create: no --title supplied; gh would prompt, which this wrapper" >&2
  echo "cannot do non-interactively. Pass --title (or --title=)." >&2
  exit 2
fi

if is_fix_title "$TITLE" && [ -z "$PARENT" ] && [ "$NO_PARENT_SET" = 0 ] && [ "$ROOT_SET" = 0 ]; then
  cat >&2 <<REFUSAL
oc-issue-create: REFUSED — nothing filed.

  The title is fix/bug-scoped and names no parent.
    title: $TITLE

  LAW: the Continuous Issue Relationship Linking Mandate (owner 2026-09-16;
  skills/opencrabs-dev/AGENTS.md § "Continuous Issue Relationship Linking")
  requires the relationship to be established AT CREATION. Measured at the gate's
  filing: 107 of 143 open fix-titled issues had NO parent, and GitHub recorded
  ZERO PARENT_ISSUE_REMOVED events — so this is never-created, not lost.

  MECHANICAL CANDIDATES (an input to your judgement, never an auto-link):
REFUSAL
  print_scope_candidates "$TITLE"
  cat >&2 <<ESCAPE

  ESCAPE HATCH — name the parent, or declare the origin:
    oc-issue-create --parent <N> ...              # a feature issue
    oc-issue-create --root upstream:<sha|PR|path> # the surface is upstream-
                                                 # inherited (upstream-rooted).
                                                 # The object must RESOLVE.
    oc-issue-create --no-parent "<reason>" ...    # last resort; the reason is
                                                 # recorded as the first comment
  A legitimate orphan bug is never blocked: the gate forbids a SILENT default,
  not a DECLARED one.
ESCAPE
  exit 3
fi

# ---- validate a declared root --------------------------------------------------
# Only reached when ROOT_SET=1 and no parent was given. An unresolvable root is
# refused: recording it would satisfy the letter of the gate while defeating it.
if [ "$ROOT_SET" = 1 ]; then
  if ! root_resolves "$ROOT"; then
    cat >&2 <<ROOTFAIL
oc-issue-create: REFUSED — nothing filed.

  --root was supplied but the object does not RESOLVE.
    root: $ROOT
    kind: $(root_kind "${ROOT#upstream:}" || true)

  LAW: "The --root object must RESOLVE, or the flag is --no-parent in better clothes"
  (SKILL.md:474-481, triage.md:201, editor.md:231). An unresolvable root is NOT
  a declaration: recording it would satisfy the letter of the gate while
  defeating it.

  Tried against $UPSTREAM_SLUG (main). If the object exists elsewhere, say so
  with --no-parent "<reason>" and record the provenance there instead.
ROOTFAIL
    exit 3
  fi
fi

# ---- assignee resolution (factory #36) ----------------------------------------
# The creation gate's assignment leg. Until #36 `--assignee` was documented as
# "passed through to gh unchanged" with NO handling at all, so every filing lane
# carried the leg by hand.
#
# The default is MEASURED (2026-10-10): `gh api repos/<slug>/assignees` returns
# leshchenko1979 ALONE on BOTH live trackers. `adolfousier` is RETIRED -- he is
# not a collaborator on the fork, and `--add-assignee adolfousier` NO-OPS with
# rc 0, so the failure reads as SUCCESS. That is why an unresolvable assignee is
# REFUSED (rc 3, nothing filed) rather than filed unassigned.
if [ "$NO_ASSIGNEE_SET" = 1 ]; then
  ASSIGNEE=""
elif [ -n "$ASSIGNEE" ]; then
  : # explicit -- verified below
elif [ "$TRACKER" = "override" ]; then
  cat >&2 <<NODEFAULT
oc-issue-create: REFUSED -- nothing filed.

  --repo $REPO_SLUG is a raw override and has no known assignee default.
    target: $REPO_SLUG

  Pass one of:
    --assignee <login>        # the login to assign
    --no-assignee "<reason>"  # declare that this repo takes no assignee
NODEFAULT
  exit 3
else
  ASSIGNEE="$DEFAULT_ASSIGNEE"
fi

if [ -n "$ASSIGNEE" ] && ! "$GH_BIN" api "repos/$REPO_SLUG/assignees/$ASSIGNEE" >/dev/null 2>&1; then
  cat >&2 <<ASSIGNFAIL
oc-issue-create: REFUSED -- nothing filed.

  The assignee does not RESOLVE on the target repo.
    assignee: $ASSIGNEE
    target:   $REPO_SLUG

  WHY REFUSED AND NOT FILED UNASSIGNED: `gh issue create --assignee <login>`
  NO-OPS with rc 0 when the login is not assignable, so an unresolvable assignee
  produces an UNASSIGNED issue that reports success. `adolfousier` is RETIRED on
  both trackers and fails exactly this way.

  Pass a login that resolves (measured 2026-10-10: leshchenko1979 is the only
  assignable account on both live trackers), or declare the exception:
    --no-assignee "<reason>"
ASSIGNFAIL
  exit 3
fi

# ---- derive --parent from a --root upstream:<sha> commit's own trailer ---------
# The law (AGENTS.md: Continuous Issue Relationship Linking, creation-time parent
# gate leg (b)): where the declared origin resolves to a SAME-TRACKER issue the
# native parent link is OBLIGATORY, and for --root upstream:<sha> the parent is
# derivable from that commit's own `Closes #N` / `Fixes #N` trailer.
#
# CROSS-TRACKER HAZARD (measured 2026-10-10): a trailer's `#N` is an UPSTREAM
# number, and upstream numbers COLLIDE with ours -- fork #737 is "oc-waiter is a
# RETIRED stub", upstream #737 is "Plan left dangling". Copying the number blind
# attaches a WRONG parent, which is worse than attaching none. So the derived
# number is VALIDATED against the TARGET repo, and a number that does not resolve
# there is refused rather than guessed.
if [ "$ROOT_SET" = 1 ] && [ -z "$PARENT" ] && [ "$NO_PARENT_SET" = 0 ]; then
  _rv="${ROOT#upstream:}"; _rv="${_rv#opencrabs/opencrabs}"; _rv="${_rv#adolfousier/opencrabs}"
  if [ "$(root_kind "$_rv")" = "sha" ]; then
    _msg="$("$GH_BIN" api "repos/$UPSTREAM_SLUG/commits/$_rv" --jq .commit.message 2>/dev/null || true)"
    _derived="$(printf '%s' "$_msg" | grep -oiE '(closes|fixes) #[0-9]+' | grep -oE '[0-9]+' | head -1)"
    if [ -n "$_derived" ]; then
      if "$GH_BIN" api "repos/$REPO_SLUG/issues/$_derived" --jq .number >/dev/null 2>&1; then
        PARENT="$_derived"
        echo "oc-issue-create: derived parent #$_derived from the root commit's trailer"
      else
        cat >&2 <<COLLIDE
oc-issue-create: REFUSED -- nothing filed.

  The root commit's trailer names #$_derived, but that number does not RESOLVE
  on the target repo.
    root:   $ROOT
    target: $REPO_SLUG

  CROSS-TRACKER HAZARD: a trailer's `#N` is an UPSTREAM number and upstream
  numbers collide with ours -- fork #737 is "oc-waiter is a RETIRED stub",
  upstream #737 is "Plan left dangling". Linking it blind would attach a WRONG
  parent. Name the parent explicitly instead:
    --parent <N>              # the same-tracker issue
    --no-parent "<reason>"    # declare the orphan
COLLIDE
        exit 3
      fi
    fi
  fi
fi

# ---- create ------------------------------------------------------------------
# Declare the resolved target AND assignee on every run: a SILENT tracker default
# is what let this tool keep filing on a stale tracker after the law moved.
# The assignee gets its OWN line rather than a third field on the target line: the
# selftest's fork legs anchor `target=leshchenko1979/opencrabs$`, and that `$` is
# LOAD-BEARING (it is what stops the fork slug from also matching the factory
# slug). Appending a field would silently disarm them -- a leg that can no longer
# fail is decoration.
echo "oc-issue-create: tracker=$TRACKER target=$REPO_SLUG"
echo "oc-issue-create: assignee=${ASSIGNEE:-none}"
CMD=("$GH_BIN" "issue" "create" "-R" "$REPO_SLUG")
[ -n "$PARENT" ] && CMD+=("--parent" "$PARENT")
[ -n "$ASSIGNEE" ] && CMD+=("--assignee" "$ASSIGNEE")
for a in "${PASSTHRU[@]:-}"; do [ -n "$a" ] && CMD+=("$a"); done

if [ "$DRY" = 1 ]; then
  echo "oc-issue-create --dry-run:"
  printf ' %q' "${CMD[@]}"; echo
  [ "$NO_PARENT_SET" = 1 ] && echo "  (then comment: no parent derivable: $NO_PARENT)"
  [ "$NO_ASSIGNEE_SET" = 1 ] && echo "  (then comment: no assignee: $NO_ASSIGNEE)"
  [ "$ROOT_SET" = 1 ] && echo "  (then comment: root: ${ROOT#upstream:})"
  exit 0
fi

OUT="$("${CMD[@]}" 2>&1)"; RC=$?
printf '%s\n' "$OUT"
if [ "$RC" != 0 ]; then
  echo "oc-issue-create: gh issue create failed rc=$RC" >&2
  exit 4
fi

# Solo-surface (editor.md:96): the create output is the ONLY receipt of the
# identifier, so restate it unambiguously on our own stdout.
NUM="$(printf '%s' "$OUT" | grep -oE '/issues/[0-9]+' | grep -oE '[0-9]+' | tail -1)"
if [ -n "$NUM" ]; then
  echo "oc-issue-create: created #$NUM"
  oc_log_extra "issue=$NUM"
  oc_log_extra "parent=${PARENT:-none}"
  oc_log_extra "assignee=${ASSIGNEE:-none}"
  [ "$ROOT_SET" = 1 ] && oc_log_extra "root=$ROOT"
  if [ "$ROOT_SET" = 1 ]; then
    BODY_FILE="$(mktemp)"
    printf 'root: %s\n' "${ROOT#upstream:}" > "$BODY_FILE"
    if "$GH_BIN" issue comment "$NUM" -R "$REPO_SLUG" --body-file "$BODY_FILE" >/dev/null 2>&1; then
      echo "oc-issue-create: recorded the root declaration on #$NUM"
    else
      echo "oc-issue-create: WARN — created #$NUM but the root declaration" >&2
      echo "  could NOT be recorded. Add it by hand; the gate's contract is that" >&2
      echo "  silence is impossible, so an unrecorded declaration is a breach." >&2
    fi
    rm -f "$BODY_FILE"
  fi
  if [ "$NO_PARENT_SET" = 1 ]; then
    BODY_FILE="$(mktemp)"
    printf 'no parent derivable: %s\n' "$NO_PARENT" > "$BODY_FILE"
    if "$GH_BIN" issue comment "$NUM" -R "$REPO_SLUG" --body-file "$BODY_FILE" >/dev/null 2>&1; then
      echo "oc-issue-create: recorded the no-parent declaration on #$NUM"
    else
      echo "oc-issue-create: WARN — created #$NUM but the no-parent declaration" >&2
      echo "  could NOT be recorded. Add it by hand; the gate's contract is that" >&2
      echo "  silence is impossible, so an unrecorded declaration is a breach." >&2
    fi
    rm -f "$BODY_FILE"
  fi
  if [ "$NO_ASSIGNEE_SET" = 1 ]; then
    BODY_FILE="$(mktemp)"
    printf 'no assignee: %s\n' "$NO_ASSIGNEE" > "$BODY_FILE"
    if "$GH_BIN" issue comment "$NUM" -R "$REPO_SLUG" --body-file "$BODY_FILE" >/dev/null 2>&1; then
      echo "oc-issue-create: recorded the no-assignee declaration on #$NUM"
    else
      echo "oc-issue-create: WARN — created #$NUM but the no-assignee declaration" >&2
      echo "  could NOT be recorded. Add it by hand; the gate's contract is that" >&2
      echo "  silence is impossible, so an unrecorded declaration is a breach." >&2
    fi
    rm -f "$BODY_FILE"
  fi
else
  echo "oc-issue-create: WARN — could not parse an issue number from gh's output" >&2
  echo "  above. The create may have SUCCEEDED; read the output before retrying." >&2
fi
exit 0
