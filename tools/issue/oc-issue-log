#!/usr/bin/env bash
# =============================================================================
# oc-issue-log — per-commit implementation comment on the tracked fork issue
# =============================================================================
# Duty-6 lens C3 (2026-08-31, incident-backed: mangled hand-posts, lane
# 212b3c83 burn). Composes the mandatory one-comment-per-commit
# implementation note (owner 2026-08-28 22:54Z) from git metadata and posts
# it via gh --body-file ONLY — the inline-heredoc shell-substitution class
# can never happen through this tool.
#
# Usage: oc-issue-log <issue-n> <sha> [--state <verification text>] [--repo <slug>] [--repo-path <dir>] [--dry-run] [--force] | --selftest
# Exit:  0 posted / 2 usage / 3 gh-fail / 4 no repo at --repo-path
#        0 is ALSO returned when the comment for this (issue, sha) already
#        exists — see the idempotency note below; both callers treat it as
#        success ("the mandatory note for this sha is on the issue").
#
# IDEMPOTENT per (issue, sha) since issue #392, and per (issue, PATCH) since
# issue #621. Before posting, the existing comments are read and searched for
# the body's own full-sha marker; a hit skips the post and exits 0. A miss then
# tries the CONTENT arm: every sha already cited on the issue is compared to
# this one with oc_same_patch (lib/oc-patch.sh — the fleet's patch-id
# predicate), so a content-identical REBASE skips too. `--force` bypasses both
# arms for a deliberate re-post. A FAILED read does not skip — it fails OPEN to
# posting, because the per-commit note is mandatory and a duplicate is cheaper
# than a missing note. This guard lives at the posting authority because the
# tool has two callers (oc-ship-chain LEG2, oc-commit); a caller-side guard
# would cover only one.
#
# Body composition: git log -1 subject + trailers (Session-Id, Issue-Ref) +
# --state text; written to a mktemp body file; no backticks, no substitutions.
#
# --repo-path (defect fix 2026-09-19, lane d18ce16a report): the sha was
# resolved with a BARE `git log` against the CALLER's cwd, so the same sha
# resolved from $HOME/opencrabs and failed rc 3 from the skill dir. Every
# caller now names the checkout explicitly (oc-commit passes its own --repo,
# oc-ship-chain passes $FORK_REPO). Default stays $PWD for backward
# compatibility, but the resolution no longer SILENTLY depends on cwd: a
# --repo-path that is not a git repo dies rc 4 rather than resolving against
# an unrelated tree.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-issue-log" "$@"; else oc_log_finish() { :; }; oc_log_extra() { :; }; fi
trap 'oc_log_finish $?' EXIT
# #621: the fleet's content-identity predicate — ONE home (lib/oc-patch.sh), the
# same oc_same_patch oc-ship-chain LEG1's carry uses. A missing lib degrades the
# patch-id arm to non-match, which is the FAIL-SAFE direction here: the note is
# mandatory, so a duplicate comment is cheaper than a missing one.
_OC_PATCH_LIB="$OC_TOOLS_DIR/lib/oc-patch.sh"
if [ -f "$_OC_PATCH_LIB" ]; then . "$_OC_PATCH_LIB"; else oc_same_patch() { return 1; }; fi

usage() { # C-#3: --help/-h answers 0 on STDOUT; a usage error answers 2 on STDERR
  local rc="${1:-2}" fd=2
  [ "$rc" = 0 ] && fd=1
  echo "usage: $0 <issue-n> <sha> [--state <text>] [--repo <slug>] [--repo-path <dir>] [--dry-run] [--force] | --selftest" >&$fd
  exit "$rc"
}
die() { echo "oc-issue-log: $2" >&2; exit "$1"; }

FORK="${OC_ISSUE_LOG_REPO:-leshchenko1979/opencrabs}"
REPO_PATH="${OC_ISSUE_LOG_REPO_PATH:-$PWD}"
ISSUE=""; SHA=""; STATE=""; DRY=0; FORCE=0
# GH_BIN is overridable so the idempotency guard can be exercised hermetically
# (issue #392 selftest legs) without reaching the network.
GH_BIN="${OC_ISSUELOG_GH:-gh}"
while [ $# -gt 0 ]; do
  case "$1" in
    --state) [ $# -ge 2 ] || { echo "oc-issue-log: --state needs a value" >&2; usage; exit 2; }; STATE=""$2""; shift 2 ;;
    --repo) [ $# -ge 2 ] || { echo "oc-issue-log: --repo needs a value" >&2; usage; exit 2; }; FORK=""$2""; shift 2 ;;
    --repo-path) REPO_PATH="${2:-}"; [ -n "$REPO_PATH" ] || usage; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --force) FORCE=1; shift ;;
    --selftest)
      d="$(mktemp -d)"
      git -C "$d" init -q 2>/dev/null; git -C "$d" -c user.email=t@t -c user.name=t commit -q --allow-empty -m "test subject" 2>/dev/null
      s="$(git -C "$d" rev-parse HEAD)"
      subj="$(git -C "$d" log -1 --format=%s "$s")"
      [ "$subj" = "test subject" ] || { echo "selftest: subject extraction broken" >&2; exit 1; }
      # --repo-path regression (defect fix 2026-09-19, lane d18ce16a report):
      # the sha MUST resolve from a --repo-path unrelated to the caller's cwd.
      # Before the fix, running the tool from a cwd that is not the repo died
      # rc 3 on a perfectly valid sha — the cwd-dependence that made
      # oc-ship-chain LEG2 fail open on every chain. Run the TOOL (not bare
      # git) from / so the caller's cwd cannot supply the answer.
      _SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
      s2="$(cd / && OC_TOOLS_NOLOG=1 bash "$_SELF" 1 "$s" --repo-path "$d" --dry-run 2>&1)"; rc2=$?
      [ "$rc2" = 0 ] || { echo "selftest: --repo-path resolution broken (rc=$rc2): $s2" >&2; exit 1; }
      case "$s2" in *"$s"*) : ;; *) echo "selftest: --repo-path body does not name the sha" >&2; exit 1 ;; esac
      # anti-vacuity: a NON-repo --repo-path must die rc 4, never resolve
      # against an unrelated tree and never masquerade as rc 3 not-found.
      (cd / && OC_TOOLS_NOLOG=1 bash "$_SELF" 1 "$s" --repo-path "$d/not-a-repo" --dry-run) >/dev/null 2>&1 && rc3=0 || rc3=$?
      [ "$rc3" = 4 ] || { echo "selftest: bad --repo-path expected rc 4, got $rc3" >&2; exit 1; }
      # ---- idempotency legs (issue #392) ------------------------------------
      # A fake gh keeps all four legs hermetic: no network, no real comment.
      cat > "$d/fakegh" <<'FAKEGH'
#!/usr/bin/env bash
case "$1 $2" in
  "issue view")
    [ -n "${OC_FAKE_VIEW_BODY:-}" ] && printf '%s\n' "$OC_FAKE_VIEW_BODY"
    exit "${OC_FAKE_VIEW_RC:-0}" ;;
  "issue comment")
    printf 'posted\n' >> "${OC_FAKE_SENTINEL:-/dev/null}"
    exit 0 ;;
  *) exit 0 ;;
esac
FAKEGH
      chmod +x "$d/fakegh"
      _il_run() { OC_TOOLS_NOLOG=1 OC_ISSUELOG_GH="$d/fakegh" OC_FAKE_SENTINEL="$d/sentinel" \
                    bash "$_SELF" 1 "$s" --repo-path "$d" "$@"; }
      # #621: same runner, but the posted sha is a parameter (the patch-id legs
      # need two commits that differ in sha and agree in content).
      _il_run_sha() { local _s="$1"; shift; OC_TOOLS_NOLOG=1 OC_ISSUELOG_GH="$d/fakegh" \
                    OC_FAKE_SENTINEL="$d/sentinel" bash "$_SELF" 1 "$_s" --repo-path "$d" "$@"; }
      # A. marker PRESENT -> skip: rc 0, self-reporting, and NOTHING posted.
      rm -f "$d/sentinel"
      a_out="$(OC_FAKE_VIEW_BODY="Implementation commit: \`$s\`" _il_run 2>&1)"; a_rc=$?
      [ "$a_rc" = 0 ] || { echo "selftest: idempotent skip expected rc 0, got $a_rc: $a_out" >&2; exit 1; }
      case "$a_out" in *"already posted"*) : ;; *) echo "selftest: skip did not report itself: $a_out" >&2; exit 1 ;; esac
      # #395: the verdict must be MACHINE-readable, not just prose — this is the
      # token oc-ship-chain LEG2 journals and tools.log's extra{} carries.
      case "$a_out" in *"idem=skip"*) : ;; *) echo "selftest: skip did not emit idem=skip: $a_out" >&2; exit 1 ;; esac
      [ ! -f "$d/sentinel" ] || { echo "selftest: skip STILL posted a comment" >&2; exit 1; }
      # B. marker ABSENT -> post.
      b_out="$(OC_FAKE_VIEW_BODY="an unrelated existing comment" _il_run 2>&1)"; b_rc=$?
      [ "$b_rc" = 0 ] || { echo "selftest: post expected rc 0, got $b_rc: $b_out" >&2; exit 1; }
      [ -f "$d/sentinel" ] || { echo "selftest: absent marker did NOT post" >&2; exit 1; }
      case "$b_out" in *"idem=posted"*) : ;; *) echo "selftest: post did not emit idem=posted: $b_out" >&2; exit 1 ;; esac
      # C. --force overrides a present marker.
      rm -f "$d/sentinel"
      c_out="$(OC_FAKE_VIEW_BODY="Implementation commit: \`$s\`" _il_run --force 2>&1)" || { echo "selftest: --force run failed" >&2; exit 1; }
      [ -f "$d/sentinel" ] || { echo "selftest: --force did NOT post" >&2; exit 1; }
      case "$c_out" in *"idem=forced"*) : ;; *) echo "selftest: --force did not emit idem=forced: $c_out" >&2; exit 1 ;; esac
      # D. unreadable comment list -> FAIL OPEN: post anyway, warn loudly.
      rm -f "$d/sentinel"
      d_out="$(OC_FAKE_VIEW_RC=1 _il_run 2>&1)"; d_rc=$?
      [ "$d_rc" = 0 ] || { echo "selftest: fail-open expected rc 0, got $d_rc: $d_out" >&2; exit 1; }
      [ -f "$d/sentinel" ] || { echo "selftest: failed read did NOT fail open to posting" >&2; exit 1; }
      case "$d_out" in *"WARNING"*) : ;; *) echo "selftest: fail-open did not warn: $d_out" >&2; exit 1 ;; esac
      case "$d_out" in *"idem=fail-open"*) : ;; *) echo "selftest: fail-open did not emit idem=fail-open: $d_out" >&2; exit 1 ;; esac
      # E. #395 DURABLE half. Legs A-D assert the stdout token; the point of the
      #    issue is the RECORD, so assert extra{} too. _il_run forces
      #    OC_TOOLS_NOLOG=1 (hermetic), so this leg runs the child WITHOUT it and
      #    points the log at a temp file. The child's own argv carries no
      #    selftest token, so oc_is_selftest is false inside it and it logs.
      rm -f "$d/sentinel"; : > "$d/tools.log"
      #    OC_TOOLS_NOLOG=0 is LOAD-BEARING, not belt-and-braces: the parent
      #    selftest process exported OC_TOOLS_NOLOG=1 in its own oc_log_init and
      #    the child would inherit it, silencing the very row under test.
      OC_TOOLS_NOLOG=0 OC_TOOLS_LOG="$d/tools.log" OC_ISSUELOG_GH="$d/fakegh" OC_FAKE_SENTINEL="$d/sentinel" \
        OC_FAKE_VIEW_BODY="Implementation commit: \`$s\`" \
        bash "$_SELF" 1 "$s" --repo-path "$d" >/dev/null 2>&1 || { echo "selftest: logged-run failed" >&2; exit 1; }
      e_idem="$(jq -r 'select(.tool=="oc-issue-log") | .extra.idem // ""' "$d/tools.log" 2>/dev/null | tail -1)"
      [ "$e_idem" = "skip" ] || { echo "selftest: tools.log extra.idem expected 'skip', got '$e_idem'" >&2; exit 1; }
      # ---- #621 patch-id legs ------------------------------------------------
      # A REBASE, hermetically: the SAME patch content committed on two
      # DIFFERENT bases => two distinct shas, ONE patch-id. The bases MUST
      # differ, and the difference must be STRUCTURAL: two commits sharing
      # tree+parent+message and landing in the same second mint the SAME
      # object, so a timing-dependent fixture reads c1 == c2 and asserts
      # nothing (measured 2026-10-05: it did exactly that on a fast run).
      git -C "$d" checkout -q -B cbase "$s" 2>/dev/null
      printf 'same\n' > "$d/f.txt"; git -C "$d" add f.txt
      git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "same patch"
      c1="$(git -C "$d" rev-parse HEAD)"
      git -C "$d" checkout -q -B cother "$s" 2>/dev/null
      printf 'noise\n' > "$d/noise.txt"; git -C "$d" add noise.txt
      git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "unrelated base shift"
      printf 'same\n' > "$d/f.txt"; git -C "$d" add f.txt
      git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "same patch"
      c2="$(git -C "$d" rev-parse HEAD)"
      # fixture sanity: the two shas MUST differ and their patch-ids MUST agree,
      # else the leg below asserts nothing (a vacuous control).
      [ "$c1" != "$c2" ] || { echo "selftest: #621 fixture did not mint two shas" >&2; exit 1; }
      p1="$(printf '%s' "$(git -C "$d" show --no-color --pretty=format: "$c1" | git patch-id --stable | cut -d' ' -f1)")"
      p2="$(printf '%s' "$(git -C "$d" show --no-color --pretty=format: "$c2" | git patch-id --stable | cut -d' ' -f1)")"
      [ -n "$p1" ] && [ "$p1" = "$p2" ] || { echo "selftest: #621 fixture patch-ids differ ($p1 vs $p2)" >&2; exit 1; }
      # F. the issue cites c1, we post c2 (same patch) -> SKIP, nothing posted.
      rm -f "$d/sentinel"
      f_out="$(OC_FAKE_VIEW_BODY="Implementation commit: \`$c1\`" _il_run_sha "$c2" 2>&1)"; f_rc=$?
      [ "$f_rc" = 0 ] || { echo "selftest: patch-id skip expected rc 0, got $f_rc: $f_out" >&2; exit 1; }
      [ ! -f "$d/sentinel" ] || { echo "selftest: patch-id skip STILL posted a comment" >&2; exit 1; }
      case "$f_out" in *"idem=skip-patch"*) : ;; *) echo "selftest: patch-id skip did not emit idem=skip-patch: $f_out" >&2; exit 1 ;; esac
      # G. NEGATIVE CONTROL: a genuinely DIFFERENT patch must still post — this
      #    is the leg that reddens if the arm ever degrades to "skip on any
      #    cited sha".
      printf 'different\n' > "$d/g.txt"; git -C "$d" add g.txt
      git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "different patch"
      c3="$(git -C "$d" rev-parse HEAD)"
      rm -f "$d/sentinel"
      g_out="$(OC_FAKE_VIEW_BODY="Implementation commit: \`$c1\`" _il_run_sha "$c3" 2>&1)"; g_rc=$?
      [ "$g_rc" = 0 ] || { echo "selftest: different-patch expected rc 0, got $g_rc: $g_out" >&2; exit 1; }
      [ -f "$d/sentinel" ] || { echo "selftest: a DIFFERENT patch was wrongly skipped (false skip)" >&2; exit 1; }
      case "$g_out" in *"idem=posted"*) : ;; *) echo "selftest: different-patch did not emit idem=posted: $g_out" >&2; exit 1 ;; esac
      # H. FAIL-CLOSED: a cited sha ABSENT from the local store cannot yield a
      #    patch-id, so it must never be read as "same" — post.
      Z40="$(printf '0%.0s' $(seq 1 40))"
      rm -f "$d/sentinel"
      h_out="$(OC_FAKE_VIEW_BODY="Implementation commit: \`$Z40\`" _il_run_sha "$c2" 2>&1)"; h_rc=$?
      [ "$h_rc" = 0 ] || { echo "selftest: fail-closed expected rc 0, got $h_rc: $h_out" >&2; exit 1; }
      [ -f "$d/sentinel" ] || { echo "selftest: an UNRESOLVABLE cited sha was wrongly read as same" >&2; exit 1; }
      case "$h_out" in *"idem=posted"*) : ;; *) echo "selftest: fail-closed did not emit idem=posted: $h_out" >&2; exit 1 ;; esac
      echo "selftest OK"; exit 0 ;;
    -h|--help) usage 0 ;;   # C-#3: help = 0 on STDOUT (usage takes the rc)
    *) if [ -z "$ISSUE" ]; then ISSUE="$1"; elif [ -z "$SHA" ]; then SHA="$1"; else usage; fi; shift ;;
  esac
done
[ -n "$ISSUE" ] && [ -n "$SHA" ] || usage
case "$ISSUE" in ''|*[!0-9]*) die 2 "issue-n must be numeric" ;; esac
# Repo guard: a --repo-path that is not a git checkout is a CALLER bug, not a
# missing sha. Distinguish it (rc 4) from "sha not in this repo" (rc 3) so the
# two failure modes cannot be read as each other.
git -C "$REPO_PATH" rev-parse --git-dir >/dev/null 2>&1 || die 4 "no git repo at --repo-path: $REPO_PATH"
FULL_SHA="$(git -C "$REPO_PATH" log --format=%H -1 "$SHA" 2>/dev/null)" || die 3 "sha not found in repo: $SHA (repo-path: $REPO_PATH)"
[ -n "$FULL_SHA" ] || die 3 "sha not found in repo: $SHA (repo-path: $REPO_PATH)"

SUBJECT="$(git -C "$REPO_PATH" log -1 --format=%s "$FULL_SHA")"
TRAILERS="$(git -C "$REPO_PATH" log -1 --format='%(trailers:key=Session-Id,valueonly)%(trailers:key=Issue-Ref,valueonly)' "$FULL_SHA" | sed '/^$/d')"
BODY="$(mktemp /tmp/oc-issue-log-body.XXXXXX.md)"
{
  echo "Implementation commit: \`$FULL_SHA\`"
  echo
  echo "- **Subject:** $SUBJECT"
  [ -n "$TRAILERS" ] && echo "- **Trailers:** $TRAILERS"
  [ -n "$STATE" ] && echo "- **Verification state:** $STATE"
  echo
  echo "<!-- posted by oc-issue-log (one comment per commit, owner 2026-08-28 22:54Z) -->"
} > "$BODY"

if [ "$DRY" = "1" ]; then cat "$BODY"; rm -f "$BODY"; echo "dry-run: body composed, nothing posted"; exit 0; fi

# ---- idempotency guard (defect fix 2026-09-19, issue #392) ------------------
# oc-ship-chain LEG2 runs ABOVE the ship lock (tools/ship/oc-ship-chain:766 posts,
# :792 acquires), so a chain that dies in LEG3-LEG5 and is re-run executes LEG2
# again with nothing serialising it — and this tool posted unconditionally, so
# every retry added an identical comment to the same issue for the same sha
# (live: #319 carried two for 6e26029d, 07:01Z and 07:15Z).
#
# The guard belongs HERE, at the posting authority, not in the caller: this tool
# has TWO callers (oc-ship-chain LEG2 and oc-commit, which folds in the same
# post-commit comment), so a caller-side guard protects one path and leaves the
# other able to duplicate. Identity marker = the FULL sha inside the body's own
# marker line, so it cannot collide across commits or with a sha prefix.
BT='`'
MARKER="Implementation commit: ${BT}${FULL_SHA}${BT}"

# The verdict is recorded from ONE place into TWO surfaces (issue #395). The
# guard's outcome was invisible in every durable record: skip, post and
# fail-open all exited 0 carrying extra{} in tools.log, and oc-ship-chain LEG2
# runs this tool under OC_TOOLS_NOLOG=1 -- so on THAT path (the retry that
# minted #392's duplicate) no row is written at all, and the chain's journal
# read a bare "LEG2 issue-log done" whether the comment posted or the guard
# skipped it. So: extra{} for the log, plus a stable `idem=<verdict>` stdout
# line that the chain parses and journals. Verdicts: posted | skip | skip-patch
# | fail-open | forced. _idem_emit is the single writer of both.
IDEM="posted"
_idem_emit() {
  IDEM="$1"
  oc_log_extra idem "$IDEM"
  printf 'idem=%s\n' "$IDEM"
}

if [ "$FORCE" = "1" ]; then
  echo "oc-issue-log: --force given — posting without the idempotency check" >&2
  IDEM="forced"
else
  EXISTING=""; _read_ok=0
  for _try in 1 2; do
    if EXISTING="$("$GH_BIN" issue view "$ISSUE" --repo "$FORK" --json comments --jq '.comments[].body' 2>/dev/null)"; then
      _read_ok=1; break
    fi
  done
  if [ "$_read_ok" = "1" ]; then
    if grep -qF "$MARKER" <<< "$EXISTING" ; then
      rm -f "$BODY"
      echo "already posted: $FORK#$ISSUE carries an implementation comment for $FULL_SHA — nothing to do (idempotent; use --force to re-post)"
      _idem_emit skip
      exit 0
    fi
    # ---- #621: the patch-id arm ------------------------------------------
    # The exact marker above is sha-pinned, so a content-identical REBASE (same
    # patch, new sha) slipped past it and the retry posted a SECOND
    # implementation comment for one logical change — measured 2026-09-26 on
    # #609: `af25718f` and `7acf0514`, both patch-id `8d18d30880a7aa9a…`. The
    # rebase is forced by the ship chain's OWN ff-merge precondition, so this
    # fires on the normal path, and it made the chain asymmetric: LEG1's carry
    # tolerates a rebase (#581) while LEG2 duplicated on one.
    #
    # Reuse the fleet's existing content predicate rather than adding a second
    # one — oc_same_patch from lib/oc-patch.sh, the same predicate oc-ship-chain
    # LEG1's carry and oc-rebase-safety's SAME/CHANGED arms use (one home, per
    # the oc-claims-single-source rule).
    #
    # FAIL-CLOSED: oc_same_patch returns non-zero for an uncomputable patch-id
    # (root commit, merge commit, sha absent from the local object store), so
    # "unknown" is never read as "same". The fail-OPEN behaviour on an
    # unreadable comment list is unchanged — that is the `else` arm below.
    while IFS= read -r _cand; do
      [ -n "$_cand" ] || continue
      [ "$_cand" = "$FULL_SHA" ] && continue
      if oc_same_patch "$REPO_PATH" "$FULL_SHA" "$_cand"; then
        rm -f "$BODY"
        echo "already posted: $FORK#$ISSUE carries an implementation comment for a content-identical commit ($_cand — same patch-id as $FULL_SHA) — nothing to do (idempotent rebase; use --force to re-post)"
        _idem_emit skip-patch
        exit 0
      fi
    done <<< "$(printf '%s\n' "$EXISTING" | grep -oE "Implementation commit: ${BT}[0-9a-f]{40}${BT}" | grep -oE '[0-9a-f]{40}' | sort -u)"
  else
    # FAIL-OPEN, deliberately. The per-commit note is MANDATORY (owner
    # 2026-08-28 22:54Z): a duplicate comment is cosmetic, a MISSING mandatory
    # note is a process breach. So an unreadable comment list must never turn
    # into a silent skip — it degrades to the old post-always behaviour, loudly.
    echo "oc-issue-log: WARNING — could not read existing comments on $FORK#$ISSUE; posting without the idempotency check (fail-open: the note is mandatory)" >&2
    IDEM="fail-open"
  fi
fi

if "$GH_BIN" issue comment "$ISSUE" --repo "$FORK" --body-file "$BODY"; then
  rm -f "$BODY"; echo "posted implementation comment on $FORK#$ISSUE for $FULL_SHA"
  _idem_emit "$IDEM"; exit 0
else
  rc=$?; die 3 "gh issue comment failed (rc=$rc) — body preserved at $BODY (set OC_ISSUE_LOG_REPO if the slug is wrong)"
fi
