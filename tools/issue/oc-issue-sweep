#!/usr/bin/env bash
# =============================================================================
# oc-issue-sweep — uniqueness-gate sweep in one call: search ALL THREE trackers
# (open + closed each) for candidate issues matching a query, harvest each
# candidate's close-reason line from its comments
# (paginated), fall back to the issue's state_reason (closed candidates only,
# via the REST issue endpoint — `gh search issues` has NO state-reason JSON
# field; v0.4.116 fixed a 100% failure rate caused by requesting it), print a
# deduped TSV table. The human "does one of these fit" judgment stays OUT
# (skill rule — report-only).
#
# Usage:
#   oc-issue-sweep '<query>' [--factory leshchenko1979/opencrabs-dev-factory]
#                            [--fork leshchenko1979/opencrabs]
#                            [--upstream opencrabs/opencrabs] [--limit N(=20)]
#   oc-issue-sweep --selftest
#
# Two-stream routing (SKILL.md; owner order 2026-10-03, SUPERSEDED by the owner
# order 2026-10-09 -- fork-first binary issues): the mandatory duplicate sweep
# covers the live trackers -- FACTORY (leshchenko1979/opencrabs-dev-factory) and
# the FORK (leshchenko1979/opencrabs, the single binary tracker since 2026-10-09)
# -- and also UPSTREAM (opencrabs/opencrabs), which receives no new issues but
# still holds a legacy corpus a duplicate may live in. A sweep that misses one
# tracker cannot discharge the law's duplicate-sweep duty.
#
# Exit codes: 0 no candidates · 1 candidates listed · 2 usage · 3 API failure
# Env: OC_SWEEP_GH (gh override — offline selftest shim), OC_TOOLS_LOG
# Output (TSV): repo <TAB> # <TAB> state <TAB> title <TAB> close-reason
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-issue-sweep" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

usage() { # C-#3: --help/-h answers 0 on STDOUT; a usage error answers 2 on STDERR
  local rc="${1:-2}" fd=2
  [ "$rc" = 0 ] && fd=1
  echo "usage: $0 '<query>' [--factory R] [--fork R] [--upstream R] [--limit N] | --selftest" >&$fd
  exit "$rc"
}
die() { echo "oc-issue-sweep: $2" >&2; exit "$1"; }

FACTORY="leshchenko1979/opencrabs-dev-factory"; FORK="leshchenko1979/opencrabs"
UPSTREAM="opencrabs/opencrabs"; LIMIT=20; QUERY=""; SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --factory) FACTORY="${2:-}"; shift ;;
    --fork) FORK="${2:-}"; shift ;;
    --upstream) UPSTREAM="${2:-}"; shift ;;
    --limit) LIMIT="${2:-}"; shift ;;
    --selftest) SELFTEST=1 ;;
    -h|--help) usage 0 ;;   # C-#3: help = 0 on STDOUT (usage takes the rc)
    *) [ -z "$QUERY" ] && QUERY="$1" || usage ;;
  esac
  shift
done
echo "$LIMIT" | grep -Eq '^[0-9]+$' || usage

if [ "$SELFTEST" -eq 1 ]; then
  d="$(mktemp -d)" || exit 3
  trap '_rc=$?; rm -rf "$d"; oc_log_finish "$_rc"' EXIT
  cat > "$d/gh" <<'SHIM'
#!/usr/bin/env bash
# offline gh shim: repo/state-driven canned search results + comments
repo=""; state=""; q=""; prev=""; jqf=""
for a in "$@"; do
  case "$prev" in
    --repo) repo="$a"; prev="" ;;
    --state) state="$a"; prev="" ;;
    --limit) prev="" ;;
    --jq) jqf="$a"; prev="" ;;
    *) [ "$prev" = "issues" ] && q="$a"; prev="$a" ;;
  esac
done
case "$q" in *nothing*) echo '[]'; exit 0 ;; esac
case "$*" in
  *comments*)
    case "$*" in
      *issues/102/comments*) echo '[{"body":"close-reason: duplicate of #101"}]' ;;
      *) echo '[]' ;;
    esac ;;
  *repos/*issues/*)
    # v0.4.116: issue-detail call (state_reason fallback for closed candidates);
    # gh applies --jq itself, so the shim mimics with local jq
    out='{}'
    case "$*" in
      *issues/102*) out='{"number":102,"state_reason":"duplicate"}' ;;
      *issues/202*) out='{"number":202,"state_reason":"completed"}' ;;
      *issues/7*)   out='{"number":7,"state_reason":"completed"}' ;;
    esac
    if [ -n "$jqf" ]; then printf '%s' "$out" | jq -r "$jqf"; else printf '%s\n' "$out"; fi ;;
  *)
    case "$repo:$state" in
      "leshchenko1979/opencrabs-dev-factory:open")   echo '[{"number":201,"title":"factory open dup","state":"OPEN","state_reason":null}]' ;;
      "leshchenko1979/opencrabs-dev-factory:closed") echo '[{"number":202,"title":"factory closed dup","state":"CLOSED","state_reason":"completed"}]' ;;
      "leshchenko1979/opencrabs:open")   echo '[{"number":101,"title":"gate probe","state":"OPEN","state_reason":null}]' ;;
      "leshchenko1979/opencrabs:closed") echo '[{"number":102,"title":"dup candidate","state":"CLOSED","state_reason":"duplicate"}]' ;;
      "opencrabs/opencrabs:open")      echo '[{"number":8,"title":"upstream open","state":"OPEN","state_reason":null}]' ;;
      "opencrabs/opencrabs:closed")    echo '[{"number":7,"title":"upstream closed","state":"CLOSED","state_reason":"completed"}]' ;;
      *) echo '[]' ;;
    esac ;;
esac
SHIM
  chmod +x "$d/gh"
  OUT="$(OC_SWEEP_GH="$d/gh" "$0" "gate" --limit 5)" || [ $? -eq 1 ] || { echo "selftest: candidates rc != 1" >&2; exit 1; }
  grep -q "leshchenko1979/opencrabs	101	open	gate probe	-" <<< "$OUT" || { echo "selftest: row 101 wrong: $OUT" >&2; exit 1; }
  grep -q "close-reason: duplicate of #101" <<< "$OUT" || grep -q "duplicate" <<< "$OUT" || { echo "selftest: close-reason not harvested: $OUT" >&2; exit 1; }
  grep -q "opencrabs/opencrabs	7	closed	upstream closed	completed" <<< "$OUT" || { echo "selftest: upstream fallback row wrong: $OUT" >&2; exit 1; }
  # Two-stream routing (SKILL.md v0.4.284): the FACTORY tracker must be swept too.
  # Discriminating by SLUG: the factory slug has the fork slug as a prefix, so the
  # `$`-anchored negative leg proves the factory rows are genuinely the factory's.
  grep -q "leshchenko1979/opencrabs-dev-factory	201	open	factory open dup	-" <<< "$OUT" || { echo "selftest: factory OPEN row missing: $OUT" >&2; exit 1; }
  grep -q "leshchenko1979/opencrabs-dev-factory	202	closed	factory closed dup	completed" <<< "$OUT" || { echo "selftest: factory CLOSED row missing: $OUT" >&2; exit 1; }
  grep -q "opencrabs/opencrabs	8	open	upstream open	-" <<< "$OUT" || { echo "selftest: upstream OPEN row missing: $OUT" >&2; exit 1; }
  [ "$(printf '%s\n' "$OUT" | grep -c .)" -eq 6 ] || { echo "selftest: row count $([ $(printf '%s\n' "$OUT" | grep -c .) ] && echo n) != 6: $OUT" >&2; exit 1; }
  OC_SWEEP_GH="$d/gh" "$0" "zzz-nothing" >/dev/null 2>&1; [ $? -eq 0 ] || { echo "selftest: no-candidates rc != 0" >&2; exit 1; }
  # v0.4.116: exit 3 must stay truthful — a hard gh failure (not a bad JSON
  # field) is what earns it; guard the exact defect that made 12/12 runs rc 3
  OC_SWEEP_GH=false "$0" "gate" >/dev/null 2>&1; [ $? -eq 3 ] || { echo "selftest: api-fail rc != 3" >&2; exit 1; }
  "$0" >/dev/null 2>&1; [ $? -eq 2 ] || { echo "selftest: no-args != 2" >&2; exit 1; }
  # M2-25 (2026-09-12, toolsmith self-found): the EXIT trap must remove EVERY
  # file the run creates, not just $TMP. A TMPDIR sandbox makes the leak
  # measurable hermetically -- the tool's own `mktemp` honours TMPDIR, so an
  # empty sandbox after a real run proves no sibling leaked.
  mkdir -p "$d/tmpdir"
  TMPDIR="$d/tmpdir" OC_SWEEP_GH="$d/gh" "$0" "gate" --limit 5 >/dev/null 2>&1
  LEAKED="$(ls -A "$d/tmpdir" 2>/dev/null | wc -l)"
  [ "$LEAKED" -eq 0 ] || { echo "selftest: temp siblings leaked ($LEAKED): $(ls -A "$d/tmpdir" 2>/dev/null | tr '\n' ' ')" >&2; exit 1; }
  echo "selftest OK"; exit 0
fi

[ -n "$QUERY" ] || usage
GH="${OC_SWEEP_GH:-gh}"

# 1. SIX searches: every tracker, open AND closed (SKILL.md v0.4.284 — the
# duplicate sweep covers both live streams plus the historical fork corpus)
TMP="$(mktemp)" || exit 3
# M2-25 (2026-09-12, toolsmith self-found, Duty TM1): the run writes THREE
# siblings of $TMP (.raw / .sorted / .final) but the trap removed only $TMP, so
# every invocation leaked 3 files into /tmp (measured 1070 files, 0.1 MB,
# oldest 2026-09-10). The trap must name every path the tool creates.
trap '_rc=$?; rm -f "$TMP" "$TMP.raw" "$TMP.sorted" "$TMP.final"; oc_log_finish "$_rc"' EXIT
for spec in "$FACTORY:open" "$FACTORY:closed" "$FORK:open" "$FORK:closed" "$UPSTREAM:open" "$UPSTREAM:closed"; do
  R="${spec%:*}"; S="${spec##*:}"
  # v0.4.116: only fields `gh search issues` actually supports (it has no
  # state_reason/stateReason and no html_url — those belong to `gh issue list`).
  # stderr is captured into the die message so a real API failure is
  # diagnosable from the exit-3 line alone (was: swallowed to /dev/null).
  ERR="$("$GH" search issues "$QUERY" --repo "$R" --state "$S" --limit "$LIMIT" \
    --json number,title,state 2>&1 > "$TMP.raw")" \
    || die 3 "gh search failed (repo=$R state=$S): ${ERR:-unknown}"
  jq -c --arg repo "$R" '.[] | {repo:$repo,number,title,state:(.state|ascii_downcase),reason:"-"}' "$TMP.raw" >> "$TMP"
done

# 2. per candidate: close-reason line from paginated comments (state_reason fallback)
while IFS= read -r item; do
  R="$(printf '%s' "$item" | jq -r .repo)"
  N="$(printf '%s' "$item" | jq -r .number)"
  BODIES="$("$GH" api --paginate "repos/$R/issues/$N/comments?per_page=100" 2>/dev/null | jq -r '.[] | .body // empty' 2>/dev/null)"
  REASON="$(printf '%s\n' "$BODIES" | sed -n 's/^[Cc]lose[- ]reason:[[:space:]]*//p' | head -1)"
  # state_reason fallback (closed only — search JSON cannot carry it, v0.4.116);
  # a failed/nulled detail fetch degrades to "-" rather than a false rc 3
  if [ -z "$REASON" ] && [ "$(printf '%s' "$item" | jq -r .state)" = "closed" ]; then
    REASON="$("$GH" api "repos/$R/issues/$N" --jq '.state_reason // "-"' 2>/dev/null)" || REASON=""
  fi
  [ -n "$REASON" ] || REASON="-"
  printf '%s\t%s\t%s\t%s\t%s\n' "$R" "$N" \
    "$(printf '%s' "$item" | jq -r .state)" \
    "$(printf '%s' "$item" | jq -r .title)" "$REASON"
done < "$TMP" | LC_ALL=C sort -t$'\t' -k1,1 -k2,2n > "$TMP.sorted"

# 3. dedupe by repo#num (belt-and-braces — searches are disjoint, but cheap)
awk -F'\t' '!seen[$1"#"$2]++' "$TMP.sorted" > "$TMP.final"

NROWS="$(grep -c . "$TMP.final")"
if [ "$NROWS" -gt 0 ]; then
  cat "$TMP.final"
  exit 1
fi
exit 0