            assert_true("#337 arm A POSITIVE CONTROL: a fork commit lands (#29)", 29 in _armA)
            assert_true("#337 arm A: an upstream citation is NOT fork space (#268)",
                        268 not in _armA)
            assert_true("#337 arm A: an explicit upstream ref is not ours (#1419)",
                        1419 not in _armA)
            assert_true("#337 arm A: a qualified fork ref lands (#343)", 343 in _armA)
            assert_true("#v0.4.284: a FACTORY-qualified ref is NOT fork space (#344)",
                        344 not in _armA)

            TRACKER_SLUG = TRACKER_SLUGS["factory"]
            _armF = fetch_landed_issues(_armA_repo)
            assert_true("#v0.4.284: a FACTORY-qualified ref lands under --tracker factory (#344)",
                        344 in _armF)
            assert_true("#v0.4.284: a FORK-qualified ref is NOT factory space (#343)",
