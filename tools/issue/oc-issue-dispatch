def check_journal_receipt(target_uuid, start_epoch, journal_path=None, poll_grace_secs=0,
                          send_budget_secs=0, sender_label=None, notify_id=None):
    """
    Verify if a delivery receipt for target_uuid exists in session-notify.journal
    since start_epoch. Supports a polling grace window for slow async daemon writes.

    `send_budget_secs` anchors the window to the SEND instead of to the moment
    this helper runs. That matters because the caller has usually just burned the
    whole notify timeout: measuring the grace from HERE would add a second,
    unrelated delay rather than covering the remainder of the send's own budget.
    A budget already spent yields exactly one pass, so a run that was SIGTERM'd
    far past its budget does not block here.

    #472 -- MESSAGE IDENTITY, not just (target, window). Returns a TRI-STATE
    string rather than a bare bool, because "a delivery reached this lane in the
    window" and "OUR delivery reached this lane" are different claims, and only
    the second settles a dispatch:

      "identity"  a row matched AND carried this send's own identity --
                  `caller=a2a:<sender_label>`, or `detail` holding
                  `notify_id=<notify_id>` (or the deferred form
                  `notification id <notify_id>`)
      "fallback"  a row matched on (target, window) ALONE: no identity was
                  supplied, so the claim is weaker and the caller must not read
                  it as an unqualified success (see classify_notify_rc)
      None        no match

    When an identity IS supplied, a (target, window) row that does not carry it
    is NOT a match -- that is precisely the #472 defect (Triage 41ca47a9,
    2026-09-21: #433's settle at 06:45:46.069Z fell inside #466's window, so
    #466 was stamped sent although no envelope for it ever landed).

    Why the sender label carries the identity on this tool's leg: the journal's
    `caller` field is `a2a:<label>` and the label is caller-controlled
    free-form, so a per-SEND label is an identifier no other send can produce.
    The CLI/A2A leg does NOT write the minted notify_id into `detail` for a
    delivered row (measured: 0 of 2333 `caller=a2a:` rows carry `notify_id=`),
    so `detail`-borne identity is unusable from here without a Rust change.
    """
    if not journal_path:
        journal_path = os.path.expanduser("~/.opencrabs/profiles/ops/logs/session-notify.journal")
        if not os.path.exists(journal_path):
            journal_path = os.path.expanduser("~/.opencrabs/logs/session-notify.journal")

    _want_caller = "a2a:" + sender_label if sender_label else None

    if send_budget_secs > 0:
        deadline = start_epoch + send_budget_secs
        if deadline < time.time():
            deadline = time.time()
    else:
        deadline = time.time() + (poll_grace_secs if poll_grace_secs > 0 else 0)
    while True:
        if os.path.exists(journal_path):
            try:
                with open(journal_path, "r", encoding="utf-8", errors="replace") as f:
                    tail = collections.deque(f, maxlen=JOURNAL_TAIL_LINES)
                for line in reversed(tail):
                    parts = line.strip().split("\t")
                    if len(parts) >= 5:
                        ts_str, caller, tgt, outcome, exit_str = parts[:5]
                        t_val = tgt.split("=", 1)[1] if "=" in tgt else tgt
                        o_val = outcome.split("=", 1)[1] if "=" in outcome else outcome
                        e_val = exit_str.split("=", 1)[1] if "=" in exit_str else exit_str
                        if t_val == target_uuid and o_val in ("delivered", "injected", "redirected", "queued") and e_val == "0":
                            try:
                                dt = datetime.datetime.fromisoformat(ts_str)
                            except Exception:
                                continue
                            if dt.timestamp() < start_epoch - 5:
                                continue
                            c_val = caller.split("=", 1)[1] if "=" in caller else caller
                            detail = "\t".join(parts[5:])
                            if _want_caller and c_val == _want_caller:
                                return "identity"
                            if notify_id and (f"notify_id={notify_id}" in detail
                                              or f"notification id {notify_id}" in detail):
                                return "identity"
                            if _want_caller or notify_id:
                                # The row is (target, window) but NOT ours -- the
                                # #472 false positive. Keep scanning: a later row
                                # may still be this send's own.
                                continue
                            return "fallback"
            except Exception:
                pass
        if time.time() >= deadline:
            break
        time.sleep(2)
    return None


def run_cmd(cmd, cwd=None, env=None, timeout=60):
    try:
        p = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=cwd,
            env=env,
            timeout=timeout
        )
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"Command timed out after {timeout}s"
    except Exception as e:
        return 1, "", str(e)


def extract_claimed_issues(ledger_data):
    """
    Issue numbers with a still-OPEN reservation in workers-ledger.json.

    TWO reservation kinds, both read through their ONE canonical predicate
    (tools/lib/oc_claims.py):

      * a `claim` row — a lane that is IMPLEMENTING the issue (#329);
      * a `hold` row — a lane that FILED the issue and parked it without
        implementing it (#312). Such a lane correctly holds no claim row, and
        before #312 it was invisible here, so the issue read as free: #286 was
        dispatched twice ~3.5 h apart and claimed by the SECOND target while
        its filer still held it in the owner design gate.

    Read-only; no ledger mutation.
    """
    events = ledger_data.get("events", [])
    reserved = oc_claims.open_claims(events) + oc_claims.open_holds(events)
    return {tok for row in reserved for tok in row["tokens"]}


