    # Test 12: #337 arm A -- fork-space scoping, probed against a REAL git repo.
    # origin/main is a fork branch that ALSO carries upstream's history, and
    # upstream PR numbers live in a DIFFERENT namespace that overlaps the low
    # fork range: a plain `#N` scan of all 2118 commits found upstream commits
    # citing #29 and #268 as PR numbers -- both REAL fork issue numbers. Without
    # the scope an upstream citation marks a fork issue landed and starves it of
    # dispatch. Session-Id is the discriminator: 452/455 fork commits carry it,
    # 0/73 upstream commits do.
    _armA_repo = tempfile.mkdtemp()
    try:
        def _g(*a):
            return subprocess.run(["git", "-C", _armA_repo, *a],
                                  capture_output=True, text=True, check=True)

        _g("init", "-q")
        _g("config", "user.email", "selftest@example.com")
        _g("config", "user.name", "selftest")
        _g("config", "commit.gpgsign", "false")

        def _mk(msg, trailers=()):
            with open(os.path.join(_armA_repo, "f.txt"), "a") as _fh:
                _fh.write(msg + "\n")
            _g("add", "f.txt")
            _args = ["commit", "-q", "--no-gpg-sign", "-m", msg]
            for _t in trailers:
                _args += ["--trailer", _t]
            _g(*_args)

        # (1) FORK commit landing #29 -- subject arm, fork space.
