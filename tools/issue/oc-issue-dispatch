    # Test 12: #337 arm A -- fork-space scoping, probed against a REAL git repo.
    # origin/main is a fork branch that ALSO carries upstream's history, and
    # upstream PR numbers live in a DIFFERENT namespace that overlaps the low
    # fork range: a plain `#N` scan of all 2118 commits found upstream commits
    # citing #29 and #268 as PR numbers -- both REAL fork issue numbers. Without
    # the scope an upstream citation marks a fork issue landed and starves it of
    # dispatch. Session-Id is the discriminator: 452/455 fork commits carry it,
    # 0/73 upstream commits do.
    _armA_repo = tempfile.mkdtemp()
    try:
        def _g(*a):
            return subprocess.run(["git", "-C", _armA_repo, *a],
                                  capture_output=True, text=True, check=True)

        _g("init", "-q")
        _g("config", "user.email", "selftest@example.com")
        _g("config", "user.name", "selftest")
        _g("config", "commit.gpgsign", "false")

        def _mk(msg, trailers=()):
            with open(os.path.join(_armA_repo, "f.txt"), "a") as _fh:
                _fh.write(msg + "\n")
            _g("add", "f.txt")
            _args = ["commit", "-q", "--no-gpg-sign", "-m", msg]
            for _t in trailers:
                _args += ["--trailer", _t]
            _g(*_args)

        # (1) FORK commit landing #29 -- subject arm, fork space.
        _mk("fix: fork landing (#29)",
            ["Session-Id: 11111111-1111-1111-1111-111111111111"])
        # (2) UPSTREAM commit citing its OWN PR #268 -- no Session-Id.
        _mk("fix(telegram): upstream thing (#268)")
        # (3) FORK commit citing upstream's namespace EXPLICITLY.
        _mk("chore: absorb upstream",
            ["Session-Id: 22222222-2222-2222-2222-222222222222",
             "Issue-Ref: opencrabs/opencrabs#1419"])
        # (4) FORK commit with the canonical QUALIFIED fork ref.
        _mk("fix(tools): qualified ref",
            ["Session-Id: 33333333-3333-3333-3333-333333333333",
             "Issue-Ref: leshchenko1979/opencrabs#343"])
        # (5) FORK commit with no issue reference at all.
        _mk("chore: no ref",
            ["Session-Id: 44444444-4444-4444-4444-444444444444"])
        # (6) FACTORY commit citing the dev-factory namespace EXPLICITLY (#v0.4.284).
        _mk("fix(tools): factory ref",
            ["Session-Id: 55555555-5555-5555-5555-555555555555",
             "Issue-Ref: leshchenko1979/opencrabs-dev-factory#344"])

        _g("update-ref", "refs/remotes/origin/main", "HEAD")
        # The landed scope follows --tracker (SKILL.md v0.4.284): a ref qualified
        # with a DIFFERENT tracker names a different number namespace and must not
        # mark THIS tracker's issue landed. Both directions are probed, because a
        # one-sided leg also passes on a predicate that ignores the slug entirely.
        _saved_armA_slug = TRACKER_SLUG
        try:
