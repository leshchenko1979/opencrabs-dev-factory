        assert_true("#390 every lane reads busy AND not-known when the table is unavailable",
                    bool(_lanes) and all(l["is_busy"] and not l["busy_known"] for l in _lanes))

        # (B) a FAST failure takes the same report path (rc 3, not a timeout)
        TOOL_DIR = _stub_roster("exit 3")
