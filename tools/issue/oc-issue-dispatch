    # Test 10: #337 landed-work predicate -- LANDED_KINDS, NOT CLOSING_KINDS.
    # The regression this pins: the first implementation reused
    # oc_claims.CLOSING_KINDS, which includes confirm/unclaim/reject -- kinds
    # that close a CLAIM without any work shipping. `unclaim` is the sharp case:
    # it RELEASES a claim, returning the issue to the pool unbuilt, yet a
    # CLOSING_KINDS-based landed filter read the release as "landed". Measured
    # 2026-09-18: 48 issues are reachable by `unclaim` alone and none of them is
    # git-landed -- latent starvation of dispatchable work. (All 48 happen to be
    # closed on GitHub today, so this is a latent-correctness fix rather than a
    # present outage; see the LANDED_KINDS docstring for the measurement.)
    _landed_fixture = {
        "events": [
            # LANDING evidence. Positive control: if the predicate returned an
            # empty set these two assertions fail, so the "does NOT land" half
            # below cannot pass for free.
            {"kind": "done", "by": "editor aaaa", "what": "DONE #201 -- merged"},
            {"kind": "close", "by": "triage bbbb", "what": "closed issue #202"},
            # BOOKKEEPING only -- none of these means the work landed.
            {"kind": "confirm", "by": "editor cccc",
             "what": "CONFIRM #203 -- claim verified live (workers[].confirmed=true)"},
            {"kind": "unclaim", "by": "triage dddd",
             "what": "#204 -- closed-issue stale claim sweep"},
            {"kind": "reject", "by": "editor eeee", "what": "REJECT #205 -- out of scope"},
            # The #329 phantom class: a done row lands only its ADDRESSED
            # target, never an issue merely mentioned in its body.
            {"kind": "done", "by": "editor ffff",
             "what": "DONE #206 -- shipped while fixing #207"},
        ]
    }
    _landed_pred = ledger_landed_issues(_landed_fixture)
    assert_true("#337 POSITIVE CONTROL: a done row lands its target (#201)",
                201 in _landed_pred)
    assert_true("#337 a close row lands its target (#202)", 202 in _landed_pred)
    assert_true("#337 confirm does NOT land (#203; the confirm/unclaim/reject regression)",
                203 not in _landed_pred)
    assert_true("#337 unclaim does NOT land (#204; claim released, work unbuilt)",
                204 not in _landed_pred)
    assert_true("#337 reject does NOT land (#205; claim refused, no work done)",
                205 not in _landed_pred)
    assert_true("#337 a done row lands its ADDRESSED target (#206)", 206 in _landed_pred)
    assert_true("#337 a body mention is not a landing (#207; the #329 phantom)",
                207 not in _landed_pred)

