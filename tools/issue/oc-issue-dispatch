        assert_true("#390 a non-timeout classify failure is reported too",
                    any(l.startswith(DEGRADED_MARKER) for l in _out2.getvalue().splitlines()))

        # (C) a MISSING oc-roster was the silent case: classify_ok stayed False
        # with no output at all before this fix.
        TOOL_DIR = tempfile.mkdtemp()
        _out3 = io.StringIO()
