def check_journal_receipt(target_uuid, start_epoch, journal_path=None, poll_grace_secs=0,
                          send_budget_secs=0):
    """
    Verify if a delivery receipt for target_uuid exists in session-notify.journal
    since start_epoch. Supports a polling grace window for slow async daemon writes.

    `send_budget_secs` anchors the window to the SEND instead of to the moment
    this helper runs. That matters because the caller has usually just burned the
    whole notify timeout: measuring the grace from HERE would add a second,
    unrelated delay rather than covering the remainder of the send's own budget.
    A budget already spent yields exactly one pass, so a run that was SIGTERM'd
    far past its budget does not block here.
    """
    if not journal_path:
        journal_path = os.path.expanduser("~/.opencrabs/profiles/ops/logs/session-notify.journal")
        if not os.path.exists(journal_path):
            journal_path = os.path.expanduser("~/.opencrabs/logs/session-notify.journal")

    if send_budget_secs > 0:
        deadline = start_epoch + send_budget_secs
        if deadline < time.time():
            deadline = time.time()
    else:
        deadline = time.time() + (poll_grace_secs if poll_grace_secs > 0 else 0)
    while True:
        if os.path.exists(journal_path):
            try:
                with open(journal_path, "r", encoding="utf-8", errors="replace") as f:
                    tail = collections.deque(f, maxlen=JOURNAL_TAIL_LINES)
                for line in reversed(tail):
                    parts = line.strip().split("\t")
                    if len(parts) >= 5:
                        ts_str, caller, tgt, outcome, exit_str = parts[:5]
                        t_val = tgt.split("=", 1)[1] if "=" in tgt else tgt
                        o_val = outcome.split("=", 1)[1] if "=" in outcome else outcome
                        e_val = exit_str.split("=", 1)[1] if "=" in exit_str else exit_str
                        if t_val == target_uuid and o_val in ("delivered", "injected", "redirected", "queued") and e_val == "0":
                            try:
                                dt = datetime.datetime.fromisoformat(ts_str)
                                if dt.timestamp() >= start_epoch - 5:
                                    return True
                            except Exception:
                                continue
            except Exception:
                pass
        if time.time() >= deadline:
            break
        time.sleep(2)
    return False


def run_cmd(cmd, cwd=None, env=None, timeout=60):
    try:
        p = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=cwd,
            env=env,
            timeout=timeout
        )
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"Command timed out after {timeout}s"
    except Exception as e:
        return 1, "", str(e)


def extract_claimed_issues(ledger_data):
    """
    Issue numbers with a still-OPEN claim in workers-ledger.json.

    Delegates to the canonical predicate (tools/lib/oc_claims.py, #329). The
    previous inline copy differed from it in TWO ways, both of which made this
    gate refuse work that no lane holds:

      * it scanned the WHOLE `what` for references, so an issue merely MENTIONED
        in a claim note read as claimed (#329's 13 phantoms);
      * it returned EVERY claim row ever written, never applying the closure
        predicate — so an issue whose claim had long since been closed stayed
        "claimed" and was never dispatchable again.

    Read-only; no ledger mutation.
    """
    return {tok for claim in oc_claims.open_claims(ledger_data.get("events", []))
            for tok in claim["tokens"]}


CLAIM_GATE_PATTERNS = [
    r"no claim without fresh approval",
    r"not scheduled work",
    r"filed for idea-box ranking",
    r"idea-box ranked",
    r"do not claim",
    r"blocked on owner",
    r"requires? owner approval before claim",
]

CLAIM_GATE_LABELS = {
    "idea-box",
    "parked",
    "hold",
    "on-hold",
    "needs-approval",
}


def check_issue_claim_gate(issue):
    """
    Check if an issue carries an explicit claim gate, idea-box ranking directive,
    or label that prevents autonomous dispatch to worker lanes.
    Returns (is_gated: bool, reason: str).
    """
    labels = [l.get("name", "").lower() for l in issue.get("labels", [])]
    for lbl in labels:
        if lbl in CLAIM_GATE_LABELS:
            return True, f"label:{lbl}"

    body = issue.get("body") or ""
    for pat in CLAIM_GATE_PATTERNS:
        m = re.search(pat, body, re.IGNORECASE)
        if m:
            return True, f"pattern:'{m.group(0)}'"

    return False, ""


