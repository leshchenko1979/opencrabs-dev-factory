    start = os.path.abspath(__file__ if '__file__' in globals() else (sys.argv[0] or "."))
    d = os.path.dirname(start)
    here = d
    while d and d != "/":
        if os.path.isfile(os.path.join(d, "lib", "oc-root.sh")) and not os.path.islink(os.path.join(d, "lib")):
            return d
        if os.path.basename(d) == "tools":
            break
        d = os.path.dirname(d)
    return here


