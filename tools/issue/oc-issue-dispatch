        assert_true("#390 a MISSING oc-roster is reported, not silent",
                    any(l.startswith(DEGRADED_MARKER) for l in _out3.getvalue().splitlines()))
    finally:
        TOOL_DIR, ROSTER_TIMEOUT_SECS = _saved_tool_dir, _saved_roster_budget

