        _disp_row = [{"n": 1, "t": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                      "by": "toolsmith 1234", "kind": "note",
                      "what": "Triage dispatch issue #370 to editor 11111111 -- wire zero-ack claim-first"}]
        _e370b = io.StringIO()
        with contextlib.redirect_stderr(_e370b):
            _rc_disp = cmd_targeted(_ns370(_disp_row))
        assert_eq("#370 cmd_targeted REFUSES an already-dispatched issue (rc 9)",
                  _rc_disp, RC_TARGETED_ALREADY_DISPATCHED)
        assert_true("#370 ...naming the lane it was already wired to",
                    "11111111" in _e370b.getvalue() and "--redispatch" in _e370b.getvalue())
        with contextlib.redirect_stderr(io.StringIO()):
            _rc_disp_ov = cmd_targeted(_ns370(_disp_row, redispatch=True))
        assert_eq("#370 ...and --redispatch bypasses that refusal (falls through to capacity)",
                  _rc_disp_ov, 4)
    finally:
        os.environ.pop("OC_DISPATCH_MOCK_ISSUES", None)
        shutil.rmtree(_f370, ignore_errors=True)
        shutil.rmtree(_repo370, ignore_errors=True)

    # Test 13: #414 -- a REOPENED issue OVERRIDES the landed arm AND the dedup arm.
    #
    # Both arms are INFERENCES about state: `landed` is derived from artifacts (an
    # Issue-Ref trailer on origin/main, or a ledger landing row) and `recent`
    # records only OUR OWN past dispatch. A reopen is a DELIBERATE act that
    # contradicts both, so it wins. Without the landed override the misreferenced
    # close is PERMANENT -- the poison that produced the wrong close still sits on
    # origin/main, so the arm re-marks the issue landed on every scan and the sweep
    # never re-wires it. Without the dedup override the fix merely moves the
    # stranding one arm over.
    #
    # Live scope measured 2026-09-19 (the three stranded issues this leg pins):
    # #199 (closed on b10ca242f, which touches 0 files under src/a2a/, and still
    # carrying Issue-Ref: #199), #253, and #324 (ALSO held by the 7-day dedup
    # memory -- "wired to aff7ff41 at 2026-09-18T11:24:13Z").
    _reopen_ts = (_now_utc - datetime.timedelta(days=1))

    def _iss(num, state_reason=None, title=None):
        d = {"number": num, "title": title or f"issue {num}", "labels": [],
             "body": ""}
        if state_reason is not None:
            d["stateReason"] = state_reason
        return d

    _r_open = [
        # 199: REOPENED and reads landed -> must be RELEASED.
        _iss(199, "REOPENED", "fix(a2a): gateway listener"),
        # 250: reads landed, NOT reopened -> must stay SKIPPED (negative control).
        _iss(250, None, "fix: landed and not reopened"),
        # 253: REOPENED, reads landed -> released.
        _iss(253, "REOPENED", "fix(test): stale assertions"),
        # 324: REOPENED, reads landed AND in dedup -> released by BOTH overrides.
        _iss(324, "REOPENED", "test(utils): image_util non_image_schemes"),
        # 400: reads landed, COMPLETED (not reopened) -> skipped (negative control
        # for the value, not just for the absence, of stateReason).
        _iss(400, "COMPLETED", "fix: closed normally"),
        # 401: REOPENED but neither landed nor recently dispatched -> ordinary
        # dispatchable, and it must NOT emit an override event (no false count).
        _iss(401, "REOPENED", "open work never wired"),
        # 402: no stateReason, in dedup only -> stays SKIPPED (dedup negative
        # control: the dedup arm still works for non-reopened issues).
        _iss(402, None, "wired recently, not reopened"),
        # 403: no stateReason, neither landed nor dedup -> ordinary dispatchable.
        _iss(403, None, "plain open work"),
    ]
    _r_landed = {199, 250, 253, 324, 400}
    _r_recent = {324: ("aff7ff41", _reopen_ts), 402: ("63d775f9", _reopen_ts)}
    _r_events, _r_dispatchable = classify_dispatch_arms(_r_open, _r_landed, _r_recent)
    _r_nums = [i["number"] for i in _r_dispatchable]
    _r_landed_skips = {i["number"] for k, i, _ in _r_events if k == "landed"}
    _r_dedup_skips = {i["number"] for k, i, _ in _r_events if k == "dedup"}
    _r_overrides = [(i["number"], arm) for k, i, arm in _r_events if k == "reopened"]

    assert_true("#414 POSITIVE: a REOPENED issue reading landed is RELEASED (#199)",
                199 in _r_nums)
    assert_true("#414 NEGATIVE CONTROL: a landed issue with NO stateReason is "
                "still SKIPPED (#250)",
                250 not in _r_nums and 250 in _r_landed_skips)
    assert_true("#414 a second REOPENED landed issue is RELEASED (#253)", 253 in _r_nums)
    assert_true("#414 a non-REOPENED stateReason does NOT override landed (#400 "
                "stateReason=COMPLETED)",
                400 not in _r_nums and 400 in _r_landed_skips)
    assert_true("#414 POSITIVE: a REOPENED issue in dedup is RELEASED by the dedup "
                "override (#324)",
                324 in _r_nums)
    assert_true("#414 NEGATIVE CONTROL: a dedup issue with no stateReason is still "
                "SKIPPED (#402)",
                402 not in _r_nums and 402 in _r_dedup_skips)
    assert_true("#414 a REOPENED issue that is neither landed nor in dedup is "
                "released WITHOUT emitting an override event (#401)",
                401 in _r_nums
                and 401 not in [n for n, _ in _r_overrides])
    assert_true("#414 an ordinary open issue is unaffected (#403)", 403 in _r_nums)
    assert_eq("#414 the dispatchable set is exactly the 4 released/plain issues",
              sorted(_r_nums), [199, 253, 324, 401, 403])
    assert_eq("#414 #324 fires BOTH overrides (landed then dedup, per-issue order "
              "follows the input scan order)",
              _r_overrides,
              [(199, "landed"), (253, "landed"), (324, "landed"), (324, "dedup")])
    assert_eq("#414 the override counts are SPLIT by arm (3 landed, 1 dedup) -- a "
              "merged total carrying one predicate is the defect this fixes",
              (sum(1 for _, a in _r_overrides if a == "landed"),
               sum(1 for _, a in _r_overrides if a == "dedup")), (3, 1))
    assert_eq("#414 the four arms PARTITION the unclaimed set",
              (sum(1 for k, _, _ in _r_events if k == "gated")
               + len(_r_landed_skips) + len(_r_dedup_skips) + len(_r_dispatchable)),
              len(_r_open))
    assert_true("#414 stateReason is matched case-insensitively (a lower-case "
                "'reopened' still overrides)",
                is_reopened({"number": 9, "stateReason": "reopened"})
                and not is_reopened({"number": 9, "stateReason": "COMPLETED"})
                and not is_reopened({"number": 9}))

    # The REPORTED numbers, not just the events they come from: a merged override
    # total printed as "defeated the landed arm" was the defect this fixes, so the
    # split is asserted directly against the summary the operator reads.
    _r_counts = summarize_arms(_r_events, _r_dispatchable)
    assert_eq("#414 reported counts: landed/dedup skips + split overrides "
              "(of the 5 landed issues, 3 are REOPENED and released; of the 2 "
              "dedup issues, 1 is REOPENED and released)",
              (_r_counts["gated"], _r_counts["landed"], _r_counts["dedup"],
               _r_counts["landed_override"], _r_counts["dedup_override"]),
              (0, 2, 1, 3, 1))
    assert_eq("#414 the reported override counts sum to the override EVENTS, "
              "and each is stated against its OWN arm",
              _r_counts["landed_override"] + _r_counts["dedup_override"],
              len(_r_overrides))

    # Test 13: #S -- a dispatch recorded as UNVERIFIED still defeats the dedup arm.
    # This is the regression test for the reported defect: a false "Delivery FAILED"
    # skipped the ledger stamp, so recent_dispatches() could not see the dispatch and
    # the NEXT --auto run re-wired the issue to a SECOND lane.
    _unv_ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
    _unv_row = "Triage dispatch issue #459 to editor 40427d4f \u2014 sent, receipt unverified (rc=124)"
    _unv_m = DISPATCH_ROW_RE.search(_unv_row)
    assert_true("#S the UNVERIFIED stamp text is readable by DISPATCH_ROW_RE", _unv_m is not None)
    assert_eq("#S the UNVERIFIED stamp keeps the issue number in group 1", _unv_m.group(1), "459")
    assert_eq("#S the UNVERIFIED stamp keeps the lane prefix in group 2", _unv_m.group(2), "40427d4f")
    _unv_recent = recent_dispatches(
        {"events": [{"kind": "note", "by": "toolsmith 1234", "t": _unv_ts, "what": _unv_row}]})
    assert_true("#S an unverified dispatch IS remembered by the dedup window (#459)", 459 in _unv_recent)
    assert_eq("#S ... and to the lane that was actually wired", _unv_recent[459][0], "40427d4f")

    # Test 14: #S -- the two verdict codes are distinct, so cmd_auto can tell
    # "may have landed" from "nothing sent" (they need OPPOSITE operator action).
    assert_true("#S RC_UNVERIFIED is distinct from 0 (success) and 3 (nothing sent)",
                RC_UNVERIFIED not in (0, 3))
    assert_eq("#S RC_UNVERIFIED is 6", RC_UNVERIFIED, 6)

    # Test 15: #S -- check_journal_receipt: send-anchored budget + streamed tail.
    # Hermetic: a temp journal, relative offsets only (no clock bomb), no ambient state.
    with tempfile.TemporaryDirectory() as _jd:
        _jp = os.path.join(_jd, "session-notify.journal")
        _now = time.time()
        _old_ts = datetime.datetime.fromtimestamp(_now - 600, datetime.timezone.utc).isoformat()
        _new_ts = datetime.datetime.fromtimestamp(_now - 1, datetime.timezone.utc).isoformat()
        with open(_jp, "w", encoding="utf-8") as _jf:
            _jf.write(f"{_old_ts}\tcaller=x\ttarget=aaaabbbb\toutcome=delivered\texit=0\n")
            _jf.write(f"{_new_ts}\tcaller=x\ttarget=ccccdddd\toutcome=delivered\texit=0\n")
        assert_true("#S a receipt inside the send window is FOUND",
                    check_journal_receipt("ccccdddd", _now - 5, _jp, send_budget_secs=30))
        assert_true("#S a receipt for a DIFFERENT target is not a match",
                    not check_journal_receipt("eeeeffff", _now - 5, _jp))
        assert_true("#S a receipt OLDER than the send window is not a match",
                    not check_journal_receipt("aaaabbbb", _now - 5, _jp))
        _t_spent = time.time()
        _spent = check_journal_receipt("gggghhhh", _now - 9999, _jp, send_budget_secs=1)
        _spent_elapsed = time.time() - _t_spent
        assert_true("#S a spent send budget returns False", not _spent)
        assert_true("#S a spent send budget does NOT sleep-poll (one pass, <1s)", _spent_elapsed < 1.0)
        assert_true("#S a missing journal is still False",
                    not check_journal_receipt("ccccdddd", _now - 9999, os.path.join(_jd, "nope"),
                                              send_budget_secs=1))


    # Test 16: #S -- the notify-rc classifier is a PURE predicate, so its
    # allowlist is asserted directly instead of through a scratch transport.
    # This is the hermetic half of the /tmp negative control's ARM 4 / ARM 5.
    assert_eq("#S classify_notify_rc: a receipt settles it as delivered",
              classify_notify_rc(True, 124), 0)
    assert_eq("#S classify_notify_rc: rc 2 is the ONE proven non-delivery",
              classify_notify_rc(False, 2), 3)
    assert_eq("#S classify_notify_rc: rc 124 (timeout) is UNVERIFIED",
              classify_notify_rc(False, 124), RC_UNVERIFIED)
    assert_eq("#S classify_notify_rc: rc 4 (transport catch-all) is UNVERIFIED (#433)",
              classify_notify_rc(False, 4), RC_UNVERIFIED)
    assert_eq("#S classify_notify_rc: a signal-death (negative rc) is UNVERIFIED",
              classify_notify_rc(False, -9), RC_UNVERIFIED)
    assert_eq("#S classify_notify_rc: rc 1 is ambiguous, so UNVERIFIED",
              classify_notify_rc(False, 1), RC_UNVERIFIED)
    # Set equality, not a count: rc 2 is the ONLY code in the tested population
    # that may leave the dispatch UNRECORDED (so a retry is correct).
    assert_eq("#S classify_notify_rc: rc 2 is the ONLY non-delivery verdict",
              sorted(c for c in (2, 4, 124, 1, -9, 137)
                     if classify_notify_rc(False, c) == 3), [2])

    # Test 16b (#576 follow-up): the pre-send IN FLIGHT note must be SETTLED on
    # the one path that writes no dispatch record (rc=2, the proven
    # non-delivery). Otherwise the ledger's ONLY trace of a send that never
    # happened is a note asserting one is in flight -- a durable record stating
    # a state the run is not in. The ledger is append-only, so the settlement is
    # a NEW row, and it must not carry the marker the dedup reader keys on, or
    # it would suppress the retry it exists to explain.
    # MUTATION KILL: delete the _stamp_not_sent call in dispatch_to_lane and
    # 16b-2 reddens; remove the helper and 16b-1 reddens.
    with open(os.path.abspath(__file__), "r") as _sf16:
        _src16 = _sf16.read()
    assert_true("#S _stamp_not_sent is defined (the settle path exists)",
                "def _stamp_not_sent(" in _src16)
    _disp16 = _src16.split("def dispatch_to_lane(")[1].split("\ndef ")[0]
    assert_true("#S the rc=2 path CALLS the settle (a retry stays correct, but "
                "no stale IN FLIGHT claim is left standing)",
                "_stamp_not_sent(issue_num, target_uuid, rc)" in _disp16)
    # The f-string is split across source lines, so join the body before
    # asserting on it -- a line-wise filter reads half the sentence.
    _settle16 = _src16.split("def _stamp_not_sent(")[1].split("\ndef ")[0]
    _emit16 = _settle16.split("run_cmd(")[1] if "run_cmd(" in _settle16 else ""
    assert_true("#S the settle row says NOT SENT, never a second IN FLIGHT claim",
                "NOT SENT" in _emit16 and "IN FLIGHT" not in _emit16)

    # Test 17 (#483): the open-issue fetch is a WINDOW with an explicit ceiling,
    # never a hardcoded page size, and a FAILED fetch is None -- not [].
    assert_eq("#483 the open-issue window is a ceiling above gh's own page size",
              OPEN_ISSUES_LIMIT >= 1000, True)
    # 17a. a FAILED read must not be readable as "no open issues": the two lead
    #      to opposite decisions (rc 3 vs a clean empty run). Pre-fix the function
    #      answered [] for both, which is what let the targeted path hand an
    #      unfetched number to a stub. The mock file is the seam -- an unreadable
    #      one models gh failing without touching the network.
    _f483 = tempfile.mkdtemp(prefix="oc483-")
    _bad = os.path.join(_f483, "bad.json")
    with open(_bad, "w") as f:
        f.write("{not json")
    os.environ["OC_DISPATCH_MOCK_ISSUES"] = _bad
    assert_eq("#483 an unreadable issue source reads as a FAILED fetch (None), not []",
              fetch_open_issues(""), None)
    assert_eq("#483 unreadable source: the single-issue lookup is also None, never a stub",
              fetch_issue("", 306), None)
    # 17b. the window-full WARNING fires exactly when the returned list reaches
    #      the ceiling, so a truncated window is never read as a complete one.
    #      MUTATION KILL: delete the _warn_if_window_full call and the
    #      "WARNING ... TRUNCATED" assertion below fails (the list assertions
    #      still pass -- the warning is the only thing separating the two).
    _saved_limit = OPEN_ISSUES_LIMIT
    OPEN_ISSUES_LIMIT = 3
    _full = os.path.join(_f483, "full.json")
    with open(_full, "w") as f:
        json.dump([{"number": n, "title": f"t{n}", "body": "", "labels": []} for n in (1, 2, 3)], f)
    os.environ["OC_DISPATCH_MOCK_ISSUES"] = _full
    _buf = io.StringIO()
    _real_stderr = sys.stderr
    sys.stderr = _buf
    try:
        _got = fetch_open_issues("")
    finally:
        sys.stderr = _real_stderr
    assert_eq("#483 a full window still returns every issue it fetched", len(_got), 3)
    assert_true("#483 a full window WARNS that it may be TRUNCATED",
                "TRUNCATED" in _buf.getvalue())
    # 17c. ...and stays SILENT one issue below the ceiling. Without this control,
    #      an unconditional warning would satisfy 17b.
    OPEN_ISSUES_LIMIT = 4
    _buf2 = io.StringIO()
    sys.stderr = _buf2
    try:
        fetch_open_issues("")
    finally:
        sys.stderr = _real_stderr
    assert_eq("#483 a window one below the ceiling does NOT warn", _buf2.getvalue(), "")
    OPEN_ISSUES_LIMIT = _saved_limit

    # 17d. an out-of-window target is resolved by the DIRECT lookup -- the
    #      #483 regression. The mock's list holds ONE issue (#306 absent), so
    #      the window cannot see it; the single-issue path must still answer
    #      with the REAL title and body. MUTATION KILL: restore the stub
    #      (title `Issue #306`, body "") and the title assertion fails.
    _win = os.path.join(_f483, "win.json")
    with open(_win, "w") as f:
        json.dump([{"number": 1, "title": "in-window", "body": "b", "labels": []}], f)
    _direct = os.path.join(_f483, "direct.json")
    with open(_direct, "w") as f:
        json.dump([{"number": 306, "title": "real #306 title", "body": "real body",
                    "labels": [{"name": "tools"}]}], f)
    os.environ["OC_DISPATCH_MOCK_ISSUES"] = _win
    assert_eq("#483 a target outside the window is absent from the list fetch",
              [i["number"] for i in fetch_open_issues("")], [1])
    os.environ["OC_DISPATCH_MOCK_ISSUES"] = _direct
    _resolved = fetch_issue("", 306)
    assert_eq("#483 ...and resolves by DIRECT lookup to the real title, not `Issue #306`",
              (_resolved or {}).get("title"), "real #306 title")
    assert_eq("#483 ...with the real BODY too (the stub's was empty)",
              (_resolved or {}).get("body"), "real body")

    # 17g. the RESOLUTION RULE, which is where the regression actually lived --
    #      the stub was constructed in cmd_targeted, not in the fetch. Three
    #      arms: in-window answers from the window and says nothing; out-of-window
    #      resolves by direct lookup and NAMES the window it fell outside; a
    #      number that resolves nowhere is None and the caller REFUSES.
    #      MUTATION KILL: restore the stub fallback (return {"number": n,
    #      "title": f"Issue #{n}", "body": ""}, "") and the real-title assertion
    #      fails; drop the refusal and the None arm returns a dict instead.
    os.environ["OC_DISPATCH_MOCK_ISSUES"] = _win
    _window = [{"number": 1, "title": "in-window", "body": "b", "labels": []}]
    _inwin, _inwin_note = resolve_target_issue("", 1, _window)
    assert_eq("#483 an in-window target answers from the window itself",
              (_inwin or {}).get("title"), "in-window")
    assert_eq("#483 ...and carries NO out-of-window note", _inwin_note, "")
    os.environ["OC_DISPATCH_MOCK_ISSUES"] = _direct
    _out_of_win, _note = resolve_target_issue("", 306, _window)
    assert_eq("#483 an OUT-OF-WINDOW target resolves to the real title, never a stub",
              (_out_of_win or {}).get("title"), "real #306 title")
    assert_true("#483 ...and the note names the window it fell outside",
                "outside the fetched open-issue window (1 listed)" in _note)
    _none, _none_note = resolve_target_issue("", 424242, [])
    assert_eq("#483 a target that resolves NOWHERE is None -- the caller then refuses",
              _none, None)
    assert_eq("#483 ...with no note to print (there is nothing to explain)",
              _none_note, "")
    # 17h. a FAILED list read is not a licence to fabricate either: the target
    #      still resolves by direct lookup, and the note says the list read
    #      failed rather than reporting a window size it never had.
    _withfail, _failnote = resolve_target_issue("", 306, None)
    assert_eq("#483 a FAILED list read still resolves the target directly",
              (_withfail or {}).get("title"), "real #306 title")
    assert_true("#483 ...and says the list read FAILED instead of citing a window",
                "the list read FAILED" in _failnote)
    # 17e. an unresolvable target resolves to None -- never a fabricated dict.
    assert_eq("#483 an unresolvable target returns None, never a stub",
              fetch_issue("", 999999), None)
    # 17f. the SAME mock feeds both reads, so they can never disagree about field
    #      shape (#483): number/title/labels/body are the fields the claim gate
    #      and the affinity scoring consume.
    assert_eq("#483 both reads request ONE shared JSON field list",
              ISSUE_JSON_FIELDS, "number,title,labels,body,stateReason,state")
    del os.environ["OC_DISPATCH_MOCK_ISSUES"]
    shutil.rmtree(_f483, ignore_errors=True)

    total = tests_passed + tests_failed
    print(f"selftest: {tests_passed}/{total} OK")
    return 0 if tests_failed == 0 else 1


def main():
    # #760: the canonical module (tools/lib/oc_log.py) arms the log and
    # self-suppresses on --selftest in either spelling, so there is no local
    # predicate to drift out of contract. bare_selftest=True keeps the one
    # behaviour dispatch had that oc-census did not. flood_guard_rc carries the
    # guard dispatch used to hand-roll at rc 7 -- now the fleet contract's rc 8
    # (the module's FLOOD_GUARD_RC_DEFAULT), so the guard is preserved, not
    # silently dropped with the copy.
    oc_log_init("oc-issue-dispatch", bare_selftest=True,
                flood_guard_rc=FLOOD_GUARD_RC_DEFAULT)
    # Line-buffer stdout (#451). This tool can block for minutes inside a
    # notify, and an outer `timeout` kills it, which DISCARDS a block-buffered
    # stdout: the run then reads as a silent hang with no output and no side
    # effect, when in fact it had reached the send. Line buffering leaves the
    # evidence of where it died. Guarded -- reconfigure() needs a real stdout
    # (not a replaced stream) and Python >= 3.7.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass
    parser = argparse.ArgumentParser(
        prog="oc-issue-dispatch",
        description="Mechanized issue vetting, lane selection, and dispatch tool.",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--auto", action="store_true", help="Auto-scan open issues and dispatch to idle lanes")
    parser.add_argument("issue", nargs="?", type=int, help="Target issue number to dispatch")
    parser.add_argument("--to", help="Target session UUID for targeted dispatch")
    parser.add_argument("--tracker", choices=["factory", "binary", "fork"], default=DEFAULT_TRACKER,
                        help="Issue tracker to dispatch from (default: factory — the dev-factory repo "
                             "leshchenko1979/opencrabs-dev-factory; 'binary' = upstream opencrabs/opencrabs; "
                             "'fork' = the historical leshchenko1979/opencrabs, read-only for NEW issues). "
                             "Two-stream routing, SKILL.md v0.4.284")
    # NOT a slug: this --repo is the PATH to the opencrabs checkout (used as cwd
    # for git). The tracker SLUG is --tracker. Do not conflate the two.
    parser.add_argument("--repo", default=DEFAULT_REPO, help="Path to opencrabs repo checkout (a PATH, not a slug)")
    parser.add_argument("--ledger", default=None, help="Path to workers-ledger.json")
    parser.add_argument("--dry-run", action="store_true", help="Preview dispatch actions without notifying or stamping ledger")
    parser.add_argument("--force", action="store_true", help="Force targeted dispatch even if issue has claim-gate markers")
    parser.add_argument("--allow-landed", action="store_true",
                        help="Propose issues whose fix already landed on origin/main or was closed in the ledger (disables the #337 landed filter)")
    parser.add_argument("--redispatch", action="store_true",
                        help=f"Re-propose an issue already dispatched within the last {DISPATCH_WINDOW_DAYS} days (disables #337 dedup memory)")
    parser.add_argument("--budget-secs", type=int, default=0,
                        help="Wall-clock budget for an --auto run; each notify's timeout is capped by what "
                             "remains (0 = one notify budget per issue, unbounded run). A single issue's real "
                             "ceiling is the notify budget PLUS the receipt grace, and --dry-run is the way to "
                             "plan a dispatch without sending")

    parser.add_argument("--selftest", action="store_true", help="Run hermetic offline test suite")

    args = parser.parse_args()

    # Resolve the tracker BEFORE any issue read: fetch_open_issues, fetch_issue,
    # fetch_landed_issues and format_wire_envelope all key on this global, so the
    # namespace being dispatched and the namespace being matched agree.
    global TRACKER_SLUG
    TRACKER_SLUG = TRACKER_SLUGS[args.tracker]

    if args.selftest:
        sys.exit(run_selftest())

    if not args.auto and args.issue is None:
        parser.print_help()
        oc_log_finish(2)
        sys.exit(2)

    try:
        if args.auto:
            rc = cmd_auto(args)
        else:
            rc = cmd_targeted(args)
    except SystemExit as se:
        rc = se.code if isinstance(se.code, int) else 1
    except Exception as e:
        sys.stderr.write(f"UNHANDLED ERROR: {e}\n")
        rc = 1
    finally:
        oc_log_finish(rc if 'rc' in locals() else 0)
    sys.exit(rc)


