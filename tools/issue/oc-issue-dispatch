#: The DECLARED markers that gate an issue out of autonomous dispatch. A label is a
#: declaration made ON the issue itself, by a human, on a STABLE surface -- which is
#: why the fixture family lives HERE and not in CLAIM_GATE_PATTERNS (#21). A fixture
#: is an issue that exists to exercise tooling, not work to be done; the convention
#: is that such an issue CARRIES the label. The tool never infers fixture-ness from
#: a terse body (`test`, `-`): body shape is not a declaration, and a short body is a
#: legitimate shape for real work -- inferring it would be a guess dressed as a guard.
#:
#: The names are chosen to be UNAMBIGUOUS. A bare `fixture` is deliberately NOT in
#: the set: this repo has a real `tools/tests/` surface, so an issue ABOUT test
#: fixtures would legitimately carry such a label, and gating it would be a false
#: positive on live work. `no-dispatch` is the general marker; `test-fixture` the
#: domain-specific one.
CLAIM_GATE_LABELS = {
    "idea-box",
    "parked",
    "hold",
    "on-hold",
    "needs-approval",
    "test-fixture",
    "no-dispatch",
}


def check_issue_claim_gate(issue):
    """
    Check if an issue carries an explicit claim gate, idea-box ranking directive,
    or label that prevents autonomous dispatch to worker lanes.
    Returns (is_gated: bool, reason: str).
    """
    labels = [l.get("name", "").lower() for l in issue.get("labels", [])]
    for lbl in labels:
        if lbl in CLAIM_GATE_LABELS:
            return True, f"label:{lbl}"

    body = issue.get("body") or ""
    for pat in CLAIM_GATE_PATTERNS:
        m = re.search(pat, body, re.IGNORECASE)
        if m:
            return True, f"pattern:'{m.group(0)}'"

    return False, ""


#: How many open issues the fetch may return (#483). gh paginates internally for
#: any limit above 100, so this is a CEILING on what the tool can see, never a
#: page size. The old hardcoded 100 was neither: the fork carried 149 open
#: issues on 2026-09-21, so ~49 sat outside every call and a targeted dispatch
#: for one of them fell through to a fabricated title with an EMPTY body.
OPEN_ISSUES_LIMIT = 1000

#: The JSON fields every issue read requests. ONE literal, so the LIST fetch and
#: the SINGLE-ISSUE fetch cannot drift into different shapes (#483).
ISSUE_JSON_FIELDS = "number,title,labels,body,stateReason,state,updatedAt"


def _env_mock_issues():
    """Issues from OC_DISPATCH_MOCK_ISSUES (a JSON file), or None when unset.

    The offline seam for the two fetch paths below. The selftest has no gh, so
    without it a fetch defect can only be tested in production.
    """
    path = os.environ.get("OC_DISPATCH_MOCK_ISSUES")
    if not path:
        return None
    with open(path) as f:
        return json.load(f)


def _warn_if_window_full(issues):
    """Say so when the returned window may be TRUNCATED (#483).

    A full window and a complete list are indistinguishable at the call site,
    which is the half of #483 that no amount of pagination removes: the limit is
    a ceiling, so the honest move is to report hitting it rather than to let a
    caller read a bounded list as an exhaustive one.
    """
    if len(issues) >= OPEN_ISSUES_LIMIT:
        print(f"WARNING: gh returned {len(issues)} open issues, exactly the "
              f"{OPEN_ISSUES_LIMIT}-issue window — the list may be TRUNCATED, and an "
              f"issue outside it cannot be told apart from a missing one. Raise "
              f"OPEN_ISSUES_LIMIT before trusting this window.", file=sys.stderr)


def fetch_open_issues(repo_path, mock_issues=None):
    """Every OPEN issue on the fork, or None when the fetch itself FAILED.

    None -- never [] -- on failure, because collapsing the two is what let
    cmd_targeted fabricate metadata for an issue it had simply not fetched
    (#483): "gh could not answer" and "there are no open issues" lead to
    opposite decisions and were the same value.

    The window is OPEN_ISSUES_LIMIT, and gh paginates internally for any limit
    above 100, so this is a CEILING on what the tool can see rather than a page
    size. The old hardcoded 100 was neither: the fork carried 149 open issues on
    2026-09-21, so ~49 sat outside every call.
    """
    if mock_issues is not None:
        _warn_if_window_full(mock_issues)
        return mock_issues

    try:
        mocked = _env_mock_issues()
    except Exception as e:
        print(f"ERROR: cannot read OC_DISPATCH_MOCK_ISSUES: {e}", file=sys.stderr)
        return None
    if mocked is not None:
        _warn_if_window_full(mocked)
        return mocked

    cmd = ["gh", "issue", "list", "--repo", TRACKER_SLUG, "--state", "open",
           "--limit", str(OPEN_ISSUES_LIMIT), "--json", ISSUE_JSON_FIELDS]
    rc, stdout, stderr = run_cmd(cmd, cwd=repo_path)
    if rc != 0:
        print(f"ERROR: Failed to fetch issues via gh: {stderr.strip()}", file=sys.stderr)
        return None
    try:
        issues = json.loads(stdout)
    except json.JSONDecodeError as e:
        print(f"ERROR: Failed to decode gh output: {e}", file=sys.stderr)
        return None
    _warn_if_window_full(issues)
    return issues


def fetch_issue(repo_path, number, mock_issues=None):
    """ONE issue by number, whatever the size of the open-issue list (#483).

    The authoritative lookup for a TARGETED dispatch. The list fetch is a
    WINDOW, so an absent number means "outside the window" at best -- and the
    old code answered that absence with a stub (title `Issue #N`, body "") that
    then fed the claim gate and the affinity scoring. Returns the issue dict, or
    None when the lookup failed or no such issue exists: NEVER a stub.
    """
    if mock_issues is not None:
        return next((i for i in mock_issues if i.get("number") == number), None)

    try:
        mocked = _env_mock_issues()
    except Exception as e:
        print(f"ERROR: cannot read OC_DISPATCH_MOCK_ISSUES: {e}", file=sys.stderr)
        return None
    if mocked is not None:
        return next((i for i in mocked if i.get("number") == number), None)

    cmd = ["gh", "issue", "view", str(number), "--repo", TRACKER_SLUG,
           "--json", ISSUE_JSON_FIELDS]
    rc, stdout, stderr = run_cmd(cmd, cwd=repo_path)
    if rc != 0:
        print(f"ERROR: could not resolve issue #{number} via gh issue view: {stderr.strip()}",
              file=sys.stderr)
        return None
    try:
        return json.loads(stdout)
    except json.JSONDecodeError as e:
        print(f"ERROR: Failed to decode gh output: {e}", file=sys.stderr)
        return []


# ---------------------------------------------------------------------------
# Landed-work detection + dispatch memory (#337)
#
# `--auto` derived eligibility from CLAIM ROWS ALONE, so an issue whose fix had
# already shipped was re-proposed for dispatch (Triage, 2026-09-18, all four
# proposed). Two independent arms, either of which marks an issue landed:
#
#   (A) origin/main carries a commit referencing it, or
#   (B) the ledger holds a LANDING-kind row targeting it.
#
# The two arms are genuinely independent, and each carries issues the other
# misses — measured against the live ledger + origin/main 2026-09-18:
#
#   arm A (git) 193   arm B (ledger) 103   both 63
#   arm A only  130   ARM B ONLY     40
#
# All four Triage-reported issues (#291/#297/#302/#324) are caught by BOTH arms:
# each has a genuine `Issue-Ref: #N` commit on origin/main AND a ledger landing
# row. Do not attribute them to one arm — the honest statement is that both arms
# independently caught all four. Arm B earns its place on the 40 issues that
# carry NO git reference at all (a `done`/`close` row with no commit naming the
# issue), which a git-only filter would re-propose for dispatch.
#
# ARM A IS SCOPED TO FORK-SPACE COMMITS (Session-Id trailer present). origin/main
# is a fork branch that also carries upstream's history, and upstream's PR
# numbers live in a DIFFERENT namespace that OVERLAPS the low fork range: a
# plain `#N` scan of all 2118 commits found upstream commits citing #29 and #268
# as PR numbers, both of which are REAL fork issue numbers. Measured 2026-09-18:
# 452/455 fork commits carry Session-Id, 0/73 upstream commits in the #1600s do.
# Without the scope an upstream PR citation silently marks fork issue #29 or
# #268 landed and starves it of dispatch — the wrong direction of error.
# ---------------------------------------------------------------------------

DISPATCH_WINDOW_DAYS = 7

def _env_positive_int(name, default):
    """A positive int from the environment, else `default`. Garbage -> default.

    A malformed override must not take the tool down: an empty value or a typo is
    a configuration slip, not a reason to refuse to dispatch.
    """
    try:
        value = int(os.environ.get(name, "") or default)
    except (TypeError, ValueError):
        return default
    return value if value > 0 else default

#: Wall-clock bound on ONE notify attempt. A notify that hits this bound is
#: KILLED, not failed: lib/oc-notify.sh gives its CLI leg its own budget
#: (OC_NOTIFY_CLI_TIMEOUT, default 90s) and then falls through to an A2A leg that
#: can still land the message, so a kill at THIS bound does not mean the send
#: failed. That is why a timeout is reported as UNVERIFIED rather than FAILED
#: (#S; the lib's own budget is #466).
#: Overridable (#451): under an outer `timeout N` an operator sets this BELOW N,
#: or the wrapper kills the run mid-send and the dispatch is neither reported nor
#: recorded -- the reported "hang with no output and no side effect".
NOTIFY_TIMEOUT_SECS = _env_positive_int("OC_DISPATCH_NOTIFY_TIMEOUT", 120)

#: Wall-clock bound on the ONE `oc-roster classify` call this tool routes on.
#: `oc-roster` allows ITSELF 120s for the same DB read (tools/state/oc-roster:154), so
#: an outer bound BELOW that kills work the inner tool was still doing -- the
#: outer number has to be at least the inner one or the inner one is
#: unreachable (#390). Measured live on this box, three consecutive IDLE runs:
#: 9.76s / 16.50s / 17.36s -- a 1.78x swing with nothing else changing, so the
#: old 60s had 3.5-6x headroom at best and none under carrier-build load, which
#: is exactly when a cron fires this tool.
#: Overridable (#390) so an operator under an outer `timeout N` can shorten it.
ROSTER_TIMEOUT_SECS = _env_positive_int("OC_DISPATCH_ROSTER_TIMEOUT", 120)

#: How long to keep re-reading the journal for a receipt after the send.
#: Overridable (#451) for the same reason as NOTIFY_TIMEOUT_SECS.
RECEIPT_GRACE_SECS = _env_positive_int("OC_DISPATCH_RECEIPT_GRACE", 30)

#: How long an `IN FLIGHT` row is believed. The row is stamped BEFORE the send
#: blocks and settled after it returns, so its natural lifetime is ONE send
#: budget: notify_timeout + RECEIPT_GRACE_SECS. This tool STRUCTURALLY outlives
#: its caller (see NOTIFY_TIMEOUT_SECS), so an outer `timeout` can kill the run
#: mid-send and no settle row ever lands -- measured 2026-10-06, #471: an
#: `IN FLIGHT` row with no successor. `recent_dispatches` used to skip EVERY
#: in-flight row, so that trace was invisible to dedup for the whole 7-day
#: window and the next `--auto` re-wired the issue to a SECOND lane -- the exact
#: vector #337 exists to stop. Past this ceiling the row is the trace of a DEAD
#: run and is read as a settled (unverified) dispatch. The 2x margin absorbs
#: env overrides and clock skew.
INFLIGHT_LIVE_SECS = _env_positive_int(
    "OC_DISPATCH_INFLIGHT_LIVE", 2 * (NOTIFY_TIMEOUT_SECS + RECEIPT_GRACE_SECS))

#: Journal lines kept while scanning for a receipt. The journal is append-only
#: and reaches megabytes, so it is streamed through a bounded deque rather than
#: slurped (host rule: stream, never read() a whole file into a list).
JOURNAL_TAIL_LINES = 60

#: Exit code for "the send may have landed but no receipt was seen". Deliberately
#: distinct from 3 (nothing sent) because the two need OPPOSITE operator action:
#: an unverified dispatch IS recorded and must not be re-sent, a failed one is NOT
#: recorded and must be retried. Collapsing them is what duplicated dispatches (#S).
RC_UNVERIFIED = 6

#: #370: the TARGETED path now runs the same eligibility arms as --auto, so its
#: two refusals need codes of their own. They must NOT reuse 6: that code means
#: "the send MAY have landed, the dispatch IS recorded, do NOT re-send", which is
#: the OPPOSITE operator action from a refusal that sent nothing. Collapsing them
#: is the same defect RC_UNVERIFIED's own note warns about. Registered in
#: tools/docs/RC-CONTRACT.md.
RC_TARGETED_LANDED = 8
RC_TARGETED_ALREADY_DISPATCHED = 9

#: #706: an EMPTY `available_lanes` has two unrelated causes, and the empty list
#: alone cannot tell them apart. `4` (CAPACITY_EXHAUSTED) is a verdict about the
#: FLEET ("no lane is free"). When the oc-roster classify read FAILED, every lane
#: defaults to busy (conservative safety, get_worker_roster) and the empty list is
#: an ARTEFACT of the broken instrument, not a capacity reading -- the roster is
#: UNKNOWN, not full. Collapsing the two sends the operator to wait for capacity
#: (or add lanes) when the fix is to repair the read: opposite actions, so the two
#: get distinct codes, the same discipline as 6 vs 8/9 above.
#: Registered in tools/docs/RC-CONTRACT.md.
RC_ROSTER_READ_FAILED = 10

#: Greppable marker for a dispatch that routed WITHOUT an affinity table (#390).
#: ONE home, so a caller can count degraded runs with `grep -c '^DEGRADED:'`.
DEGRADED_MARKER = "DEGRADED"


def report_roster_degraded(rc, err, budget):
    """Announce that the affinity table is unavailable, on BOTH streams (#390).

    The WARN this replaces went to stderr ONLY, and a cron-driven invocation
    discards stderr -- so a run that lost affinity routing left no trace at all
    and `classify_ok=False` was recorded nowhere. The marker also goes to stdout,
    where a caller can COUNT it, and it names the BUDGET because a timeout under
    load is the case this exists for.
    """
    detail = (err or "").strip() or f"rc={rc}"
    for stream in (sys.stdout, sys.stderr):
        print(f"{DEGRADED_MARKER}: affinity table unavailable -- oc-roster classify "
              f"failed (budget {budget}s, {detail}); routing WITHOUT affinity "
              f"(every lane treated busy).", file=stream)


_ISSUE_REF_VALUE_RE = re.compile(r"#([0-9]+)")

#: The dispatch row this tool writes (see dispatch_to_lane). Kept in one place
#: so the writer and the dedup reader cannot drift apart.
DISPATCH_ROW_RE = re.compile(
    r"dispatch issue #([0-9]+) to (?:editor|lane)\s+([0-9a-fA-F-]{8,})",
    re.IGNORECASE)

#: A dispatch row written BEFORE the send blocks, so an operator asking "did
#: this already run?" gets a hit during the window instead of a clean zero.
#: Measured 2026-09-25: the settled row is written only after the send returns,
#: and the send can block for roster(120s)+send(120s)+grace(30s) against a 120s
#: caller timeout -- so the tool STRUCTURALLY outlives its caller, and during
#: that window every available check (`messages`, `notify_queue`, the ledger)
#: reads absence. An operator re-sent by hand and the tool's own envelope landed
#: 19s later: two envelopes for one issue.
#:
#: The dedup reader SKIPS these. That is load-bearing: an rc=2 `no_route` is the
#: one PROVEN non-delivery and is deliberately NOT recorded so a retry stays
#: correct, and counting an in-flight row as settled would suppress that retry
#: for the whole 7-day window -- trading a visible duplicate for a silent loss.
INFLIGHT_ROW_RE = re.compile(r"\bIN FLIGHT\b", re.IGNORECASE)

def _parse_ledger_ts(value):
    """A ledger row's timestamp as an aware datetime, or None if unparseable."""
    try:
        ts = datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except (TypeError, ValueError):
        return None
    return ts if ts.tzinfo else ts.replace(tzinfo=datetime.timezone.utc)

# --- #455: the landed arm's IDENTITY leg -------------------------------------
# A trailer or auto-link naming `#N` is an ATTRIBUTION, not identity (the
# v0.4.216 close-identity guard, triage.md). `oc-commit` derives `Issue-Ref`
# from the actor's LATEST open claim, so a lane holding several claims stamps
# its BOOKKEEPING commits -- a battery receipt, a runtime-artifacts sweep --
# with whichever claim happens to be newest. Those commits touch none of the
# named issue's surface, yet the landed arm counted them, so an OPEN issue with
# zero work on it read as finished and was never re-proposed.
#
# Measured (this issue): #441's only claiming commit `6b90149c` changed
# `tools/tests/battery-last.json` alone, while #441's surface is
# `tools/state/oc-ledger`.
#
# The surface is "the path/module the issue NAMES" -- read from the issue's OWN
# title+body. It must NOT be derived from the commits that anchor the issue:
# that is CIRCULAR (the offending commit would define its own surface, so the
# leg would be a no-op on the very instance above -- verified live against
# `oc_claims.resolve_issue_files(441)`, which carries battery-last.json BECAUSE
# `6b90149c` is one of the anchoring commits).
#
# FAIL-OPEN BY CONSTRUCTION: an issue naming no repo path has an EMPTY surface
# and this leg does not fire. The change can therefore only ever REMOVE a false
# landing, never add one.

#: A repo-relative path token in issue prose: a known top-level dir, a slash,
#: then a path-ish run. The lookbehind keeps a URL tail (`.../issues/441`) from
#: reading as a path.
_ISSUE_PATH_RE = re.compile(
    r"(?<![A-Za-z0-9_./-])"
    r"((?:tools|src|skills|docs|tests|scripts)/[A-Za-z0-9_.\-]+"
    r"(?:/[A-Za-z0-9_.\-]+)*)")

def issue_surface(issue):
    """Repo paths the issue NAMES, as a set (empty when it names none)."""
    text = "%s\n%s" % (issue.get("title") or "", issue.get("body") or "")
    return set(_ISSUE_PATH_RE.findall(text))

def _file_on_surface(changed, tokens):
    """Is the changed file ``changed`` on the surface named by ``tokens``?"""
    c = str(changed or "").strip().strip("/")
    if not c:
        return False
    cb = os.path.basename(c)
    for token in tokens:
        t = str(token or "").strip().strip("/")
        if not t:
            continue
        if c == t or c.startswith(t + "/"):
            return True
        # Reorg-robust: the one-level-per-kind move renamed tools/oc-ledger to
        # tools/state/oc-ledger, so an issue naming the OLD path must still
        # recognise the file it names. Basename is the stable join.
        if cb == os.path.basename(t):
            return True
    return False

def issue_surfaces(issues):
    """``{issue_number: surface}`` for every issue whose surface is NON-EMPTY.

    An issue ABSENT from the map is one the identity leg does not fire for --
    the fail-open side of #455.
    """
    out = {}
    for iss in issues or []:
        try:
            num = int(iss.get("number"))
        except (TypeError, ValueError):
            continue
        surface = issue_surface(iss)
        if surface:
            out[num] = surface
    return out

def fetch_landed_issues(repo_path, mock_landed=None, surfaces=None):
    """Issue numbers whose fix is already on origin/main, in the ACTIVE tracker's
    number space (SKILL.md v0.4.284 — the scope follows --tracker).

    ``surfaces`` (#455) is the ``{issue: {paths}}`` map from
    :func:`issue_surfaces`: when present, a commit anchors an issue only if its
    changed files intersect that issue's NAMED surface. Omitted -- or an issue
    absent from the map -- ⇒ no identity leg, the pre-#455 behaviour.
    """
    if mock_landed is not None:
        return {int(n) for n in mock_landed}

    # `--name-only` carries each commit's changed files on the SAME pass that
    # already reads the trailers: one `git log`, never a per-commit subprocess.
    # `%x1e` OPENS every record so the field line and its file list travel as
    # one unit -- a bare `--format` + `--name-only` emits the files AFTER the
    # record boundary and would attribute them to the wrong commit.
    fmt = ("%x1e%H%x1f%s%x1f"
           "%(trailers:key=Issue-Ref,valueonly,separator=%x2C)%x1f"
           "%(trailers:key=Session-Id,valueonly,separator=%x2C)")
    rc, out, err = run_cmd(
        ["git", "log", "origin/main", "--no-merges", f"--format={fmt}",
         "--name-only"],
        cwd=repo_path, timeout=60)
    if rc != 0:
        print(f"WARN: cannot read origin/main for landed-work detection "
              f"(rc={rc}): {err.strip()}", file=sys.stderr)
        return set()

    landed = set()
    for record in out.split("\x1e"):
        lines = record.strip("\n").splitlines()
        if not lines:
            continue
        parts = lines[0].split("\x1f")
        if len(parts) < 4:
            continue
        subj, iref, sess = parts[1], parts[2], parts[3]
        if not sess.strip():
            continue            # upstream space — a different number namespace
        files = [ln.strip() for ln in lines[1:] if ln.strip()]

        def _anchors(num):
            """#455 identity leg: does this commit touch the issue's surface?"""
            if not surfaces:
                return True
            try:
                tokens = surfaces.get(int(num))
            except (TypeError, ValueError):
                return True
            if not tokens:
                return True     # issue names no path — fail open
            return any(_file_on_surface(f, tokens) for f in files)

        for value in iref.split(","):
            value = value.strip()
            if not value:
                continue
            # A ref qualified with a DIFFERENT tracker names a different number
            # namespace: `opencrabs/opencrabs#1419` is an EXPLICIT upstream
            # citation and must never mark a factory issue landed (the #337
            # defect, generalised to three trackers). Only bare refs and refs
            # qualified with the ACTIVE tracker are ours.
            if "/" in value and not value.startswith(TRACKER_SLUG + "#"):
                continue
            for num in _ISSUE_REF_VALUE_RE.findall(value):
                if _anchors(num):
                    landed.add(int(num))
        m = re.search(r"\(#([0-9]+)\)\s*$", subj.strip())
        if m and _anchors(m.group(1)):
            landed.add(int(m.group(1)))
    return landed

def ledger_landed_issues(ledger_data):
    """Issue numbers TARGETED by a LANDING ledger row (#337 arm B).

    Two independent constraints, both required:

    * `oc_claims.LANDED_KINDS` — NOT `CLOSING_KINDS`. The latter is claim
      bookkeeping: `confirm`/`unclaim`/`reject` close a claim without any work
      shipping, so using it here suppresses issues that are still open and
      still dispatchable (#248, #253, #268 were all wrongly filtered before
      this narrowing). See the LANDED_KINDS docstring in tools/lib/oc_claims.py.

    * `row["targets"]` — the canonical primary-target predicate, not every
      reference in the row: a done row that merely MENTIONS a second issue in
      prose does not land it (#329's phantom class).
    """
    rows = oc_claims.parse_events(ledger_data.get("events", []))
    out = set()
    for row in rows:
        if row["kind"] in oc_claims.LANDED_KINDS:
            out.update(row["targets"])
    return out

def recent_dispatches(ledger_data, window_days=DISPATCH_WINDOW_DAYS):
    """{issue: (lane, ts)} for dispatch rows inside the window (#337 dedup).

    Each `--auto` run previously started from scratch, so an issue already wired
    to a lane but not yet acked was wired to a SECOND lane. The window bounds
    the memory: past it, a dispatch is treated as expired and the issue becomes
    dispatchable again.
    """
    rows = oc_claims.parse_events(ledger_data.get("events", []))
    now = datetime.datetime.now(datetime.timezone.utc)
    cutoff = now - datetime.timedelta(days=window_days)
    live_cutoff = now - datetime.timedelta(seconds=INFLIGHT_LIVE_SECS)
    out = {}
    for row in rows:
        ts = _parse_ledger_ts(row["t"])
        if INFLIGHT_ROW_RE.search(row["what"]):
            # An attempt that has STARTED is not an attempt that has SETTLED:
            # while a send may still be running, the row must not suppress a
            # retry (see INFLIGHT_ROW_RE). That is true only while the send CAN
            # still be running. This tool structurally outlives its caller, so
            # an outer `timeout` kills it mid-send and the settle row never
            # lands -- measured 2026-10-06, #471. Past the send-budget ceiling
            # such a row is the trace of a DEAD run: fall through so it
            # suppresses the re-send like any other dispatch we made (a send
            # that may have landed is recorded, never omitted).
            if ts is None or ts >= live_cutoff:
                continue
        m = DISPATCH_ROW_RE.search(row["what"])
        if not m:
            continue
        if ts is None or ts < cutoff:
            continue
        issue = int(m.group(1))
        if issue not in out or ts > out[issue][1]:
            out[issue] = (m.group(2), ts)
    return out

def get_worker_roster(ledger_data, mock_classify=None, mock_sessions=None, db_path=None):
    """
    Retrieve workers, identifying idle editors and their topic affinity.
    Validates existence against the sessions SQLite database to filter phantom workers.
    """
    classify_rows = {}
    classify_ok = False
    if mock_classify is not None:
        classify_ok = True
        for r in mock_classify.get("rows", []):
            classify_rows[r.get("uuid")] = r
    else:
        roster_bin = os.path.join(TOOL_DIR, "state/oc-roster")
        if os.path.exists(roster_bin):
            rc, out, err = run_cmd([roster_bin, "classify", "--json"],
                                   timeout=ROSTER_TIMEOUT_SECS)
            if rc == 0:
                try:
                    cdata = json.loads(out)
                    for r in cdata.get("rows", []):
                        classify_rows[r.get("uuid")] = r
                    classify_ok = True
                except Exception as e:
                    print(f"WARN: Failed to parse oc-roster classify output: {e}", file=sys.stderr)
                    report_roster_degraded(rc, f"unparseable output: {e}", ROSTER_TIMEOUT_SECS)
            else:
                report_roster_degraded(rc, err, ROSTER_TIMEOUT_SECS)
        else:
            # A MISSING oc-roster is the same degradation as a failed one, and was
            # equally silent (#390): classify_ok stayed False with no output at all.
            report_roster_degraded(127, f"no such tool: {roster_bin}", ROSTER_TIMEOUT_SECS)

    # Validate sessions existence against SQLite database (or mock_sessions in tests)
    known_sessions = None
    if mock_sessions is not None:
        known_sessions = set(mock_sessions)
    else:
        target_db = db_path or os.environ.get(
            "OC_DEV_DB",
            os.environ.get(
                "OC_ROSTER_DB",
                os.path.expanduser("~/.opencrabs/profiles/ops/opencrabs.db")
            )
        )
        if os.path.exists(target_db):
            try:
                con = sqlite3.connect(f"file:{target_db}?mode=ro", uri=True)
                cur = con.cursor()
                cur.execute(
                    "SELECT id FROM sessions WHERE archived_at IS NULL AND (title IS NULL OR title NOT LIKE 'subagent:%')"
                )
                known_sessions = {row[0] for row in cur.fetchall()}
                con.close()
            except Exception as e:
                # If DB read fails, do not hard-crash, but report warning on stderr
                print(f"WARN: Failed to query sessions DB for liveness check: {e}", file=sys.stderr)

    workers = ledger_data.get("workers", [])
    editor_lanes = []

    # Map workers with their active state
    for w in workers:
        # A lane that OWNS a work surface is a candidate, not only role=editor: the
        # Toolsmith owns tools/** (fork #342). Roles owning no affinity domain (hq,
        # triage) deliberately stay out -- admitting them could only add zero-score
        # candidates, which is the misroute class this fix exists to remove.
        if w.get("role") not in ("editor", "toolsmith"):
            continue
        uuid = w.get("uuid")
        if not uuid:
            continue

        # Prune phantom workers whose UUID is absent from sessions DB
        if known_sessions is not None and uuid not in known_sessions:
            continue

        c_info = classify_rows.get(uuid, {})
        c_class = c_info.get("class")  # ACTIVE, IDLE, UNKNOWN
        dirty_trees = c_info.get("dirty", 0)
        c_worktrees = c_info.get("worktrees", "-")
        c_claims = c_info.get("claims", "-")

        # Determine if lane is busy:
        # If oc-roster classify failed completely, default to busy (conservative safety)
        # to avoid misrouting or colliding with busy lanes.
        if not classify_ok:
            is_busy = True
        else:
            # Busy if: has open claims in classify, or dirty trees > 0
            # Note: Stale/inactive worktrees on disk (without open claims or dirty files) do NOT make a lane busy.
            has_open_claims = c_claims not in ("-", "", None)
            is_busy = has_open_claims or (dirty_trees > 0)

        # Check topic and feature for domain affinity. Topic is optional in
        # workers-ledger.json; keep it explicit so a later topic cannot bypass
        # the shared matcher silently.
        feature = " ".join(filter(None, (w.get("feature"), w.get("topic"))))

        editor_lanes.append({
            "uuid": uuid,
            "topic": w.get("topic"),
            "topic_id": w.get("topic_id"),
            "feature": feature,
            "class": c_class or "UNKNOWN",
            "claims": c_claims,
            "worktrees": c_worktrees,
            "is_busy": is_busy,
            # Whether is_busy is a REAL reading. When classify fails every lane
            # defaults to busy (conservative safety, above); that unknown state must
            # not be read by the surface-owner override in select_best_lane as
            # "this owner is merely queued", or a broken classify would re-enable
            # dispatch exactly when we cannot tell who is free.
            "busy_known": classify_ok,
            "raw": w
        })

    return editor_lanes


def roster_read_failed(editor_lanes):
    """True when the roster read BROKE, so every lane defaulted to busy (#706).

    `available_lanes` is empty under two unrelated causes, and the empty list
    alone cannot tell them apart:

      * every lane is genuinely busy -- a verdict about the FLEET
        -> CAPACITY_EXHAUSTED (rc 4);
      * the oc-roster classify read FAILED, so get_worker_roster defaulted every
        lane to busy with `busy_known=False` -- the roster is UNKNOWN, not full
        -> ROSTER_READ_FAILED (rc 10).

    The second must not borrow the first's verdict: "no idle lanes" is an
    ARTEFACT of the failed read, and an operator acting on it would wait for
    capacity (or add lanes) instead of repairing the instrument. `busy_known` is
    the discriminator -- it is False on EVERY lane exactly when classify failed.

    An EMPTY roster is NOT this case: no registered lanes is a genuine (if
    unhelpful) capacity reading and keeps the capacity verdict.
    """
    return bool(editor_lanes) and not any(l.get("busy_known") for l in editor_lanes)


# A match whose token is the DIRECT OBJECT of a negation is not a surface claim
# (fork #605). A literal token has no polarity, so "NOT (tools):" read as the
# tools domain -- the matcher fired on the surface being RULED OUT. The guard
# requires the negation to be the LAST thing before the token, with at most an
# article between; that adjacency is what separates an exclusion ("not (tools):")
# from an instruction that still NAMES the surface ("do not touch
# tools/lib/oc-notify.sh" -- "touch" intervenes, so it still fires). A looser
# window would suppress the second, a false negative on a genuine mention.
_NEGATION_BEFORE_RE = re.compile(
    r"(?<![a-z])(?:not|never|no|nor|isn'?t|aren'?t|don'?t|doesn'?t|cannot|can'?t"
    r"|without|excluding|except|instead\s+of|rather\s+than|vs\.?)"
    r"(?![a-z])(?:\s+(?:a|an|the|any))?\s*$", re.I)

def _negated_at(text, i):
    """True when the token at i is directly negated by the words before it."""
    return _NEGATION_BEFORE_RE.search(text[max(0, i - 30):i]) is not None

def _keyword_matches(text, keyword):
    """Match structured scope tokens literally, prose tokens by word.

    Both classes carry the negation guard (#605): a token is only a claim when
    at least one occurrence is NOT directly negated.
    """
    text = text.lower()
    keyword = keyword.lower()
    if any(mark in keyword for mark in "(:/"):
        start = 0
        while True:
            i = text.find(keyword, start)
            if i == -1:
                return False
            if not _negated_at(text, i):
                return True
            start = i + 1
    for mt in re.finditer(r"(?<![a-z0-9_])" + re.escape(keyword)
                          + r"(?![a-z0-9_])", text):
        if not _negated_at(text, mt.start()):
            return True
    return False


def _domains_for_text(text):
    text = text.lower()
    return {domain for domain, kws in AFFINITY_KEYWORDS.items()
            if any(_keyword_matches(text, kw) for kw in kws)}


# ---------------------------------------------------------------------------
# The DECLARED scope prefix (fork #551)
# ---------------------------------------------------------------------------
# An issue title carries a deterministic domain declaration -- `type(scope):` --
# and the classifier used to ignore it, routing on noisy prose keywords alone.
# The declaration is now read FIRST and the keyword arm is the FALLBACK, so a
# scope that names a domain we hold affinity for is honoured even when the
# issue's prose never repeats the word.
#
# MEASURED (2026-10-05, 184 open fork issues, 172 prefixed, 37 distinct scopes):
# 22 of the 37 scope words were UNRECOGNISED by the keyword arm. The cause is
# structural, not accidental: `_keyword_matches` matches a prose token on WORD
# BOUNDARIES, so the plural/abbreviated form of a domain name never matches the
# singular keyword -- `fix(skills):` never matches the `skill` keyword,
# `fix(channels):` never matches `channel`, `fix(tg):` matches nothing at all.
# Only a handful of domains were reachable by declaration, and only because
# their scope token happened to be spelled exactly like their keyword.
#
# `_keyword_matches`'s negation guard (#605) does NOT apply here, and that is
# deliberate: a scope prefix is a DECLARATION, not a mention. "fix(daemon): not
# (tools): ..." declares daemon; there is no polarity to resolve.
_SCOPE_PREFIX_RE = re.compile(
    r"^\s*(?:fix|feat|chore|bug|refactor|docs|test|perf|ci|build|style)"
    r"\s*\(\s*([^)]+?)\s*\)\s*:", re.I)

#: Scope -> affinity domain. A scope is mapped ONLY when it names a domain this
#: classifier actually holds affinity for; an UNMAPPED scope is not an error and
#: not a domain -- it falls through to the keyword arm unchanged, which is what
#: preserves the zero-empty-domain invariant (measured: 0 empty sets across all
#: 184 open issues). Adding a scope here must therefore never invent a domain
#: that no lane owns: that is how a harness issue would hand the toolsmith lane
#: affinity for `tool_loop`, which owns no fleet script.
SCOPE_DOMAINS = {
    # The domain names themselves. Kept EXACT (#551): `(tools):` means the tools
    # domain and nothing else -- no fuzzy prefix matching.
    "tools": "tools", "plan": "plan", "goal": "goal", "provider": "provider",
    "telegram": "telegram", "mermaid": "mermaid", "db": "db", "cron": "cron",
    "memory": "memory", "skills": "skills", "notify": "notify",
    "harvest": "harvest", "bash": "bash", "config": "config",
    # Measured aliases -- the plural/abbreviated/synonym forms the keyword arm
    # structurally drops. Each one is a scope word observed on the live corpus,
    # or the obvious singular/plural twin of one.
    "skill": "skills", "slash": "skills", "prompt": "skills", "context": "skills",
    "tg": "telegram", "channels": "telegram", "channel": "telegram",
    "topics": "telegram", "topic": "telegram",
    "diagrams": "mermaid", "diagram": "mermaid",
    "dbs": "db", "sqlite": "db", "storage": "db", "retention": "db",
    "jobs": "cron", "scheduler": "cron", "scheduling": "cron",
    "notifications": "notify", "notification": "notify", "delivery": "notify",
    "upstream": "harvest", "census": "harvest", "sweep": "harvest",
    "tooling": "tools", "toolsmith": "tools", "ledger": "tools", "roster": "tools",
    "dispatch": "tools", "issue": "tools", "issues": "tools", "lint": "tools",
    "ship": "tools", "deploy": "tools", "smoke": "tools", "vendor": "tools",
    "prchecks": "tools", "battery": "tools", "selftest": "tools",
    "providers": "provider", "handshake": "provider",
    "plans": "plan", "cards": "plan",
    "goals": "goal",
    "codegraph": "memory", "embedding": "memory",
    "settings": "config", "toml": "config", "read_config": "config",
    "shell": "bash", "subshell": "bash", "spill": "bash",
}


def declared_scope_domains(issue):
    """Domains the title's `type(scope):` prefix DECLARES (fork #551).

    A compound scope names each of its parts ("tools, plan" / "tools/plan"),
    and the whole scope is tried first so a multi-word scope can be mapped as a
    unit before it is split. An unmapped scope returns the empty set -- never a
    guess, and never a fallback to the type verb.
    """
    mt = _SCOPE_PREFIX_RE.match(issue.get("title", "") or "")
    if not mt:
        return set()
    scope = mt.group(1).strip().lower()
    doms = set()
    direct = SCOPE_DOMAINS.get(scope)
    if direct:
        doms.add(direct)
    for part in re.split(r"[,\s/|+]+", scope):
        if part:
            d = SCOPE_DOMAINS.get(part)
            if d:
                doms.add(d)
    return doms


# The FLEET TOOL NAMES on disk (fork #641). A body that NAMES one of these makes
# a surface claim -- it points at a script that lives under tools/**. The SCOPE
# LABEL is not such a claim (see the `tools` bucket above): MEASURED over the
# #641 acceptance set, the label was the ONLY `tools` signal on all 14 rows, 8 of
# which must NOT hold it because their fix lands in src/brain/tools/**.
# `oc-issue-scope`'s header rules identically (variant 1, TITLE-PREFIX: "the
# prefix is a LABEL, not a surface"), so this is the same law, not a new one.
#
# A SYMBOL arm was built for the 14th acceptance row (#634) and REJECTED on
# measurement (2026-10-05). Three candidate signals, all measured against the
# 403-issue corpus and the 14-row acceptance set:
#   (1) camelCase-or-underscore ids present in tools/** but not src/** -> 10/14,
#       and it gave `tools` to 44 open issues (leaked capitalised English:
#       `Reproduced`, `Relationship`, `Infra`).
#   (2) underscore ids present in tools/** (no src subtraction) -> 6/14 with 102
#       open issues gained: dominated by fleet-wide builtins every body mentions
#       (`edit_file`, `write_file`, `session_notify`, `TOOL_EXEC`).
#   (3) underscore ids present in tools/** and NOT in src/** -> 14/14 acceptance,
#       but its ONLY live effect was to give `tools` to fork #757, a
#       `fix(telegram)` issue. Cause: tools/** docs and comments QUOTE other
#       subsystems' symbols -- `tools/harvest/oc-harvest-census` quotes
#       `spacing_ok` / `spacing_floor_ms` / `RichAdmission` from a telegram issue
#       inside a comment -- so "present in tools/, absent from src/" does NOT
#       imply "tools-specific". The vocabulary is contaminated at the source.
# The src subtraction is load-bearing either way, and it makes the arm depend on
# a foreign repo's checkout; (3) is therefore BOTH wrong on the live corpus and
# the most expensive. #634 (CLOSED) is the #610/#471 indistinguishability class
# `oc-issue-scope`'s header already rules unseparable: no text signal splits it
# from #471, and the acceptance row that demands one is over-specified.
_FLEET_TOOL_CACHE = None

def _fleet_tool_names():
    """The `oc-*` scripts that actually exist under tools/** (basenames)."""
    global _FLEET_TOOL_CACHE
    if _FLEET_TOOL_CACHE is None:
        names = set()
        try:
            for _dirpath, _dirs, files in os.walk(TOOL_DIR):
                for fn in files:
                    if fn.startswith("oc-") and not fn.endswith(".pyc"):
                        names.add(fn)
        except OSError:
            names = set()
        _FLEET_TOOL_CACHE = names
    return _FLEET_TOOL_CACHE

_FLEET_TOOL_RE = re.compile(r"(?<![a-z0-9_-])oc-[a-z][a-z0-9-]*")

# --- frame guards (#27): resolution ALONE is not a surface claim -------------
# A body can NAME a live tool while talking about something else, and the bare
# resolution test then hands the whole unit the factory tier. #605 gave
# oc-issue-scope these frames; oc-issue-dispatch kept the bare test, so #530
# (which names `oc-start` as the VICTIM of a false defect report) and #418 (which
# names `oc-deploy fanout` as a CONSUMER of a contract) both claimed `tools`.
# MIRRORED from tools/issue/oc-issue-scope:377-404 -- the measurements live there
# (#387 analogy, #678 victim, #605 polarity) and are NOT re-derived here; the
# CONSUMER frame is measured here (#418). Only the token a frame ATTACHES to is
# suppressed, never a lookback window: a window is measurably wrong (oc-issue-scope
# ANALOG_GAP records a fixture where it suppressed a real claim as well).
_NEG = re.compile(r"(?i)\b(not|never|outside|excluding|rather than|instead of|without)\b")
_NEG_WIN = 30
_ANALOG = re.compile(r"(?i)\b(same\s+\w*\s*(?:defect\s+)?class\s+as|same\s+as|"
                     r"analogous\s+to|compare\s+with|like\s+the\s+way)\b")
_ANALOG_GAP = 8
_VICTIM = re.compile(r"(?i)\b(?:false\s+defect|defect\s+report|falsely\s+attribut\w*"
                     r"|filed\s+against|reported\s+(?:on|against)"
                     r"|unrelated\s+to|blam(?:e|ed|ing)\s+(?:on|against))")
_VICTIM_GAP = 14
# #418: the tool is named as a CONSUMER of the thing under discussion -- "The
# consumers of this contract are mechanical fan-out tooling (`oc-deploy fanout`,
# #24)". Naming a downstream user is not claiming its surface.
_CONSUMER = re.compile(r"(?i)\b(?:consumers?|callers?|downstream|"
                       r"fan-?out\s+tooling|shells?\s+out\s+to)\b")
_CONSUMER_GAP = 14


def _fleet_frame_ends(low):
    """End offsets of every frame that DEMOTES the token following it."""
    return ([m.end() for m in _ANALOG.finditer(low)],
            [m.end() for m in _VICTIM.finditer(low)],
            [m.end() for m in _CONSUMER.finditer(low)])


def _fleet_tok_gated(low, pos, analog, victim, consumer):
    """True when the token at `pos` is NOT a surface claim (a frame attaches)."""
    if _NEG.search(low[max(0, pos - _NEG_WIN):pos]):        # (a) POLARITY
        return True
    if any(0 <= pos - e <= _ANALOG_GAP for e in analog):    # (a2) ANALOGY
        return True
    if any(0 <= pos - e <= _VICTIM_GAP for e in victim):    # (a3) VICTIM
        return True
    return any(0 <= pos - e <= _CONSUMER_GAP for e in consumer)  # (a4) CONSUMER


def _names_fleet_tool(text):
    """True when the text names a real `oc-*` script under tools/** (fork #641).

    Resolution is what separates a surface claim from a bare mention: a name that
    exists on disk claims the domain, a name that resolves NOWHERE (`oc-race`, a
    scratch fixture) does not. Resolution ALONE is not enough (#27): the name must
    also not sit inside a frame that says it is something ELSE -- the VICTIM of a
    defect report, an ANALOGY's sibling, a CONSUMER, or a NEGATED mention. A tool
    named as the SUBJECT ("`oc-x` fails to ...") still claims: the gates fire only
    on their own frames.
    """
    if not text:
        return False
    names = _fleet_tool_names()
    low = text.lower()
    analog, victim, consumer = _fleet_frame_ends(low)
    for m in _FLEET_TOOL_RE.finditer(low):
        if _fleet_tok_gated(low, m.start(), analog, victim, consumer):
            continue
        if m.group(0) in names:
            return True
    return False

def detect_issue_domains(issue):
    """Domains an issue touches: body surfaces, then the DECLARED prefix.

    The `(tools):` scope is CONFIRM-ONLY (#641): it spans two repos, so it may
    not establish the domain on its own. Every other scope keeps #551's
    behaviour (the declaration ADDS a domain, which is what preserves the
    zero-empty-domain invariant for the mapped scopes).
    """
    text = issue.get("title", "") + " " + issue.get("body", "")
    doms = _domains_for_text(text)
    if _names_fleet_tool(text):
        doms.add("tools")
    doms |= (declared_scope_domains(issue) - {"tools"})
    return doms

def title_disagrees(issue):
    """True when the `(tools):` LABEL claims a domain the body does not support.

    The disagreement is DISCLOSED, never scored (#641): a caller with a mechanism
    override can act on it, while the classifier itself refuses to guess which of
    the two repos the fix lands in. False for every issue that does not carry the
    label, so this is silent on the rest of the corpus.
    """
    if "tools" not in declared_scope_domains(issue):
        return False
    return "tools" not in detect_issue_domains(issue)

def role_owned_domains(lane):
    """Domains a lane OWNS by ROLE (fork #342), independent of its feature prose.

    The role lives on the RAW worker record: get_worker_roster's lane dicts expose
    uuid/topic/topic_id/feature/class/claims/worktrees/is_busy/raw and carry NO
    top-level "role" key, so read it from raw -- and degrade to no owned domain
    when raw is absent, which is the shape of the synthetic lanes in the selftest.
    """
    return set(ROLE_DOMAINS.get((lane.get("raw") or {}).get("role"), ()))

def lane_domains_for(lane):
    """Every domain a lane touches: its feature PROSE unioned with its ROLE.

    ONE predicate, shared by score_affinity's arithmetic and select_best_lane's
    domain gate (#668) -- a second copy is what lets the two disagree.
    """
    return _domains_for_text(lane.get("feature", "").lower()) | role_owned_domains(lane)

def owner_candidate_for(lane, issue_domains):
    """True when this lane's ROLE owns one of the issue's domains (fork #342).

    Ownership outranks the idle preference: a claim or a dirty tree on the owner
    means the issue QUEUES for the lane that will actually fix it, which is
    strictly better than handing it to a zero-affinity editor lane -- the live
    misroute this exists to close (measured 2026-09-20: the toolsmith lane scored
    93 on #451 while every editor scored 0-3, yet was excluded as busy and the
    issue went to a score-0 editor).

    Guarded on busy_known: when oc-roster classify FAILS, get_worker_roster marks
    every lane busy by conservative default, and that unknown state must never be
    read as "the owner is merely queued".

    ONE predicate, called from every site that decides candidacy (select_best_lane
    and both pre-filters) -- a second copy is what let the two disagree.
    """
    if not lane.get("busy_known", True):
        return False
    return bool(role_owned_domains(lane).intersection(issue_domains))

def score_affinity(issue, lane):
    """
    Score affinity between issue title/labels/body and lane feature/domain.
    Returns:
      score: integer. High positive = strong match. Negative = domain conflict / mismatch.
    """
    title = issue.get("title", "").lower()
    body = issue.get("body", "").lower()
    text = title + " " + body
    feature = lane.get("feature", "").lower()

    # Identify which domains the issue and lane touch. The issue half is shared
    # with select_best_lane's owner-candidacy test, so it lives in ONE place.
    issue_domains = detect_issue_domains(issue)
    # Role-owned domains are part of the lane's IDENTITY, not of its prose.
    owned = role_owned_domains(lane)
    lane_domains = lane_domains_for(lane)

    # If lane is specialized in domain(s) that directly conflict with the issue
    # e.g., lane is dedicated to mermaid or photo rendering, but issue is pure db/persistence
    # Enforce penalty to avoid dumping mismatched tasks onto specialized feature lanes
    specialized_domains = {"mermaid", "cron", "db", "memory", "bash"}
    lane_specialized = lane_domains.intersection(specialized_domains)
    if (lane_specialized
            and not lane_specialized.intersection(issue_domains)
            and not owned.intersection(issue_domains)):
        # Lane is specialized in a domain absent from this issue
        return -50

    score = 0
    # Direct token matches
    for domain in issue_domains.intersection(lane_domains):
        score += 20

    # A lane that OWNS a surface wins its own domain outright (fork #342). The 20
    # above is symmetric and loses to prose: an editor whose feature string merely
    # mentions three of the issue's domains banks 60, against the surface owner's
    # 23. Ownership is a stronger signal than vocabulary overlap, so it is weighted
    # decisively -- large enough to beat the prose accumulation it competes with.
    if issue_domains.intersection(owned):
        score += 70

    # Specific keyword matching
    for word in re.findall(r'[a-z0-9_-]{4,}', feature):
        if word in ("with", "from", "branch", "lane", "owner", "shipped", "fork", "main", "feature", "issue"):
            continue
        if word in text:
            score += 3

    return score


# Lanes too specialised to absorb a zero-affinity issue (#529/#639). Hoisted
# from two inline copies so the arm cannot drift from itself.
SPECIALIZED_REDIRECT = ("mermaid", "vector", "cron", "sqlite", "compaction", "loop-guard")


def best_affinity_score(issue, lanes):
    """Highest affinity any candidate scores for `issue` (#647).

    An ORDERING hint, not a gate: the assignment loop still enforces
    availability per unit. Without it a batch is greedy in INPUT order, so a
    weak match can consume the lane a later, stronger match needed (measured:
    #480, the wave's strongest match, was left with only 0-score lanes because
    # a 9-scorer took its lane 34s earlier).
    """
    issue_domains = detect_issue_domains(issue)
    best = 0
    for lane in lanes:
        if not lane["is_busy"] or owner_candidate_for(lane, issue_domains):
            s = score_affinity(issue, lane)
            if s > best:
                best = s
    return best


def select_best_lane(issue, candidate_lanes, allow_fallback=False):
    """
    Select the best idle lane for an issue respecting designated domain affinity.
    Does not dump mismatched issues onto specialized topic lanes.
    """
    issue_domains = detect_issue_domains(issue)

    # Filter idle lanes. A lane that OWNS this issue's domain stays a candidate
    # even when busy: see owner_candidate_for.
    available = [lane for lane in candidate_lanes
                 if not lane["is_busy"] or owner_candidate_for(lane, issue_domains)]
    # ONE definition of "available", used by both lane selection and the idle
    # count: no active claim and no dirty worktree (is_busy). Lane CLASS is
    # deliberately NOT part of it — oc-roster marks a lane ACTIVE for any update
    # inside RECENT_S (24h, oc-roster:96/:326), so treating ACTIVE as busy would
    # strand nearly every live lane and collapse dispatch capacity. The old
    # class-filtered fallback that stood here was dead code: `class in
    # (ACTIVE,IDLE) and not is_busy` is a strict SUBSET of the primary predicate,
    # so it could never rescue an empty primary (#310).
    if not available:
        return None

    # Score available lanes
    scored = []
    for lane in available:
        s = score_affinity(issue, lane)
        scored.append((s, lane))

    # Sort descending by score
    scored.sort(key=lambda x: x[0], reverse=True)
    
    # If the highest score is negative or zero, check if we allow arbitrary fallback.
    # By default, lanes with score < 0 (domain conflict) are strictly forbidden.
    # If highest score is <= 0 and lane has specialized feature, refuse to misroute.
    best_score, best_lane = scored[0]
    if best_score < 0 and not allow_fallback:
        return None
    # (#668) A POSITIVE score is NOT evidence of a domain match. The +3 leg in
    # score_affinity scores feature PROSE against the issue text, so a lane that
    # shares only vocabulary banks a positive total with ZERO domain intersection
    # -- measured at source: {notify, telegram} issue vs lane prose "demoted-host
    # guard" gives lane_domains set() and score 6. The sign guards below cannot
    # see that (they reject < 0, and == 0 only when the issue has domains), so
    # the intersection is enforced HERE, where both sets are already in scope.
    # Scoped to domain-bearing issues for the same reason the == 0 arm is: an
    # issue no domain covers would otherwise be unroutable rather than queued.
    if issue_domains and not allow_fallback:
        if not issue_domains.intersection(lane_domains_for(best_lane)):
            return None
    if best_score == 0 and not allow_fallback:
        # (#639 Wire C) A ZERO score is the ABSENCE of an affinity match, not a
        # weak one. Dispatching on it hands the unit to a lane that will refuse
        # it -- a guaranteed wasted turn -- and hides which units are actually
        # starved. fleet-directives.md clause 3 is explicit: with no matching
        # domain idle, leave the unit QUEUED or commission a domain-appropriate
        # lane; "random fallbacks across unrelated topics are blocked".
        #
        # Scoped to issues that HAVE detectable domains. An issue whose surface
        # no domain covers scores 0 against EVERY lane, so refusing there would
        # make it unroutable forever rather than merely queued; that case keeps
        # the specialised-lane guard below, which is all that can be decided.
        if issue_domains:
            return None
        # Check if lane has specialized feature
        lane_feat = best_lane.get("feature", "").lower()
        if any(d in lane_feat for d in SPECIALIZED_REDIRECT) and not allow_fallback:
            # Avoid polluting specialized topic with zero affinity
            # Look for a generic lane among scored
            generic_candidates = [l for s, l in scored if s >= 0 and not any(d in l.get("feature", "").lower() for d in SPECIALIZED_REDIRECT)]
            if generic_candidates:
                return generic_candidates[0]
            return None

    return best_lane


def classify_queue_reason(issue, available_lanes, allow_fallback=False):
    """Why a DISPATCHABLE issue was LEFT QUEUED: "capacity" or "affinity".

    `candidates` (the set cmd_auto actually selects from) EXCLUDES lanes already
    assigned in THIS cycle, so "no candidate matches" is ambiguous -- and reading
    it as affinity was measured WRONG (#21 follow-up, Triage census rev.3 intake
    ruling 2026-10-06): on the rev.3 census 36 of 38 queued issues matched a lane
    that the run's own first 7 dispatches had CONSUMED. Re-test against the FULL
    available set: a match there means the matching lane exists and was consumed
    this cycle (CAPACITY -- remedy: wait for a lane to free, or add lanes); no
    match anywhere means no idle lane holds the domain (AFFINITY -- remedy:
    commission a domain-appropriate lane). Two constraints, two remedies, so the
    tool must not collapse them into one message.
    """
    if select_best_lane(issue, available_lanes, allow_fallback=allow_fallback):
        return "capacity"
    return "affinity"


def format_wire_envelope(issue):
    """
    Format wire envelope conforming to v0.4.169 Zero-Ack law and explicit refusal affordance.
    """
    num = issue.get("number")
    title = issue.get("title", "").strip()
    
    # Generate clean branch slug
    # Remove fix(...): or feat(...): prefix
    slug_text = re.sub(r'^(?:fix|feat|chore|bug|refactor|docs)(?:\([^\)]+\))?:\s*', '', title, flags=re.IGNORECASE)
    slug = re.sub(r'[^a-zA-Z0-9]+', '-', slug_text).strip('-').lower()
    if len(slug) > 35:
        slug = slug[:35].rstrip('-')
    if not slug:
        slug = "patch"
    branch_target = f"fix/{num}-{slug}"

    envelope = f"""[ISSUE DISPATCH: #{num}]
Target Issue: #{num} ({title})
Issue URL: https://github.com/{TRACKER_SLUG}/issues/{num}
Branch Target: {branch_target}
Ack contract: NONE — claim on ledger (oc-ledger claim) and proceed. If occupied, gate-blocked, or domain-mismatched, reply with [REFUSE: <reason>]."""
    return envelope, branch_target


def _stamp_dispatch(issue_num, target_uuid, unverified=False, rc=0):
    """Record a dispatch in the ledger -- on BOTH paths (#S).

    `recent_dispatches()` keys on exactly this row, so a dispatch that is not
    recorded here is invisible to the 7-day dedup window and the issue is wired
    to a SECOND lane on the next `--auto`. A send that may have landed must
    therefore still be recorded; it is marked unverified rather than omitted.

    The text must keep matching `DISPATCH_ROW_RE` (defined above) or the dedup
    reader cannot see it -- that regex is the reader half of this writer.
    """
    ledger_bin = os.path.join(TOOL_DIR, "state/oc-ledger")
    if not os.path.exists(ledger_bin):
        return
    suffix = (f" \u2014 sent, receipt unverified (rc={rc})" if unverified
              else " \u2014 wire zero-ack claim-first")
    stamp_text = f"Triage dispatch issue #{issue_num} to editor {target_uuid[:8]}{suffix}"
    # A1: inherit the ambient environment so oc-ledger's derive_by() resolves
    # the ACTUAL dispatching session. Forcing the actor to a bare role label
    # here was a trap: derive_by() resolves UUIDs only and classifies any
    # non-hex/non-dash value as a LABEL it never resolves, so every dispatch
    # row was stamped 'unrostered-actor triage' while OPENCRABS_SESSION_ID
    # held the resolvable uuid (98 rows measured; issue #328).
    run_cmd([ledger_bin, "stamp", "note", stamp_text])


def _stamp_inflight(issue_num, target_uuid, budget_secs):
    """Record that a send has STARTED, before it blocks. See INFLIGHT_ROW_RE.

    Deliberately worded with the literal `IN FLIGHT` marker the dedup reader
    keys on, so the two halves cannot drift: if this text stops carrying the
    marker the reader stops skipping it, and a proven non-delivery would then
    suppress its own retry.
    """
    ledger_bin = os.path.join(TOOL_DIR, "state/oc-ledger")
    if not os.path.exists(ledger_bin):
        return
    try:
        run_cmd([ledger_bin, "stamp", "note",
                 f"Triage dispatch issue #{issue_num} to editor {target_uuid[:8]}"
                 f" \u2014 IN FLIGHT (send started, budget {budget_secs}s)"],
                timeout=30)
    except Exception:  # noqa: BLE001 -- best-effort by contract
        pass

def _stamp_not_sent(issue_num, target_uuid, rc):
    """Settle the in-flight note when the send is PROVEN not to have happened.

    The rc=2 path writes no dispatch record -- correctly, so a retry stays
    available -- but that leaves `_stamp_inflight`'s `IN FLIGHT` note as the
    ledger's only trace, asserting a send is in flight about one that provably
    never left. The ledger is append-only, so the settlement is a new row.
    """
    ledger_bin = os.path.join(TOOL_DIR, "state/oc-ledger")
    if not os.path.exists(ledger_bin):
        return
    try:
        run_cmd([ledger_bin, "stamp", "note",
                 f"Triage dispatch issue #{issue_num} to editor {target_uuid[:8]}"
                 f" \u2014 NOT SENT (rc {rc}: no route); a retry is correct"],
                timeout=30)
    except Exception:  # noqa: BLE001 -- best-effort by contract
        pass

def classify_notify_rc(receipt_seen, rc):
    """Pure predicate: what does a notify attempt's rc MEAN? (#S)

    Returns 0 when a journal receipt settles it as delivered, 3 when the send
    provably did NOT happen, or RC_UNVERIFIED when the transport is ambiguous.

    `receipt_seen` is the TRI-STATE from check_journal_receipt (#472):
      "identity" -- matched on this send's OWN identity: a full success.
      "fallback" -- matched on (target, window) alone, with no identity to
                    confirm it. It is EVIDENCE, not proof: the row could belong
                    to a neighbouring send to the same lane (#433's settle once
                    settled #466 that way). Deliberately NOT an unqualified
                    success -- returning 0 here would hand the defect back.
                    Unreachable from dispatch_to_lane, which always supplies a
                    sender label; it exists so a future caller that omits one
                    cannot silently regain the hole.
      falsy      -- no match.

    Non-delivery is the SPECIAL case, not the default -- the allowlist below
    holds exactly ONE code, because only rc 2 positively asserts "nothing sent,
    nothing created". Every other non-zero rc is ambiguous about delivery:
      2   -- `no_route`: the one PROVEN non-delivery. NOT recorded, so a retry
             is correct.
      124 -- our own timeout; the wrapper is killed while the CLI child may
             already have accepted the send (#451).
      4   -- a CATCH-ALL: a2a disabled, unreachable, bad response, usage errors
             and retired modes all land here (#418), and it delivered for 2 of 4
             lanes in a measured wave while reporting failure (#433).
      <0  -- run_cmd returns the RAW returncode, so a signal-killed wrapper
             surfaces as a negative rc.
      1   -- ambiguous: "the wrapper exited 1" or "run_cmd raised".

    The bias is deliberate: a duplicate dispatch is silent and hard to detect,
    while a 7-day suppression is visible and recoverable.
    """
    if receipt_seen == "identity":
        return 0
    if rc == 2:
        return 3
    return RC_UNVERIFIED

def dispatch_to_lane(target_uuid, envelope, issue_num, dry_run=False, ledger_path=DEFAULT_LEDGER_FILE,
                     notify_timeout=NOTIFY_TIMEOUT_SECS):
    """
    Deliver wire envelope to target session via lib/oc-notify.sh and stamp ledger.

    Returns 0 (delivered, receipt seen), RC_UNVERIFIED (the send may have landed
    but no receipt was seen -- the dispatch IS recorded so the next run does not
    re-wire it) or 3 (nothing sent -- NOT recorded, so a retry is correct).

    Only rc 2 (`no_route`) counts as proof of non-delivery, because it is the one
    rc that asserts "nothing sent, nothing created". Every other non-zero rc is
    ambiguous about delivery, and a timeout is deliberately not a failure:
    lib/oc-notify.sh gives its CLI leg its own budget (OC_NOTIFY_CLI_TIMEOUT,
    default 90s -- #466) and then falls through to a direct A2A leg that can
    still land the message, so a kill at THIS bound leaves the send genuinely
    ambiguous and the receipt may simply land after the poll window. Reporting
    that as FAILED produced both
    duplication vectors (#S): the next `--auto` re-dispatched an already-delivered
    issue, and an operator reading "nothing delivered" re-sent it by hand.
    """
    if dry_run:
        print(f"[DRY-RUN] Would notify session {target_uuid} for issue #{issue_num}")
        return 0

    notify_script = os.path.join(TOOL_DIR, "lib/oc-notify.sh")
    title = f"[ISSUE DISPATCH: #{issue_num}]"

    t0 = time.time()
    # Announce the send and its budget BEFORE blocking on it (#451): this call
    # can block for notify_timeout, and if the send does not return 0 it is
    # followed by up to RECEIPT_GRACE_SECS of receipt polling. An outer `timeout`
    # set below that ceiling kills the run mid-send, and the dispatch is then
    # neither reported nor recorded -- the reported "hang with no output and no
    # side effect".
    print(f"Dispatching issue #{issue_num} -> {target_uuid[:8]} "
          f"(notify budget {notify_timeout}s + {RECEIPT_GRACE_SECS}s receipt grace)")
    # BEFORE the send blocks: a row an operator can find DURING the run. Without
    # it the ledger is silent for the whole window and "still running" is
    # indistinguishable from "never ran" (HQ report 2026-09-25). Best-effort --
    # a stamp fault must never abort a dispatch that is about to go out.
    _stamp_inflight(issue_num, target_uuid, notify_timeout + RECEIPT_GRACE_SECS)
    # #472: a per-SEND sender label. The journal records it as
    # `caller=a2a:<label>` and the label is caller-controlled free-form, so this
    # send's row carries an identity no other send can produce -- which is what
    # lets the receipt check below demand OUR delivery rather than accept any
    # delivery to this lane inside the window.
    # OC_DISPATCH_SEND_LABEL pins it for a fixture (the same env-seam pattern as
    # OC_DEPLOY_FETCH / OC_SWAP_INFLIGHT_LISTER); unset, every send is unique.
    send_label = (os.environ.get("OC_DISPATCH_SEND_LABEL")
                  or f"oc-issue-dispatch/#{issue_num}-{os.urandom(4).hex()}")
    send_env = dict(os.environ, OC_NOTIFY_SENDER=send_label)
    if os.path.exists(notify_script):
        rc, out, err = run_cmd([notify_script, target_uuid, envelope, title],
                               timeout=notify_timeout, env=send_env)
        label = "lib/oc-notify.sh"
    else:
        # Direct CLI fallback if lib/oc-notify.sh missing. The subcommand is
        # `session notify` (two words) and the envelope is a --text payload; the
        # old `session-notify ... <uuid> <envelope>` form is not a command this
        # CLI has, so this leg could never deliver (#S).
        notify_bin = os.path.expanduser("~/.cargo/bin/opencrabs")
        if not os.path.exists(notify_bin):
            notify_bin = "/usr/local/bin/opencrabs"
        cmd = [notify_bin, "session", "notify", "--profile", "ops", "--mode", "turn-end",
               "--sender", send_label,
               "--title", title, "--text", envelope, target_uuid]
        rc, out, err = run_cmd(cmd, timeout=notify_timeout)
        label = "session notify"

    if rc != 0:
        # Fallback receipt check against session-notify.journal in case the
        # wrapper was killed while the send was already in flight.
        grace = notify_timeout + RECEIPT_GRACE_SECS
        if rc == 124:
            print(f"NOTE: {label} hit its {notify_timeout}s bound and was killed; "
                  f"polling for a receipt for another {RECEIPT_GRACE_SECS}s "
                  f"(window {grace}s) before calling the send unverified.",
                  file=sys.stderr)
        receipt_seen = check_journal_receipt(target_uuid, t0, send_budget_secs=grace,
                                             sender_label=send_label)
        verdict = classify_notify_rc(receipt_seen, rc)
        if verdict == 0:
            rc = 0
        elif verdict == RC_UNVERIFIED:
            if receipt_seen == "fallback":
                # A delivery reached the lane in the window but carries no
                # identity for THIS send (#472): weaker than proof, so the
                # dispatch stays UNVERIFIED rather than being stamped sent.
                print(f"WARN: {label} failed (rc={rc}); a delivery to "
                      f"{target_uuid[:8]} IS in session-notify.journal inside the window, "
                      f"but it carries no identity for this send "
                      f"(no caller=a2a:{send_label}) -- recording the dispatch as "
                      f"UNVERIFIED, not delivered (#472).", file=sys.stderr)
            else:
                print(f"WARN: {label} failed (rc={rc}) and no receipt for "
                      f"{target_uuid[:8]} is in session-notify.journal yet -- the send "
                      f"may still land.", file=sys.stderr)
            _stamp_dispatch(issue_num, target_uuid, unverified=True, rc=rc)
            return RC_UNVERIFIED
        else:
            print(f"ERROR: {label} failed (rc={rc}): {err.strip()}", file=sys.stderr)
            _stamp_not_sent(issue_num, target_uuid, rc)
            return 3

    _stamp_dispatch(issue_num, target_uuid, unverified=False, rc=rc)
    return 0



def is_reopened(issue):
    """#414 — did the issue carry GitHub's stateReason=REOPENED?

    `stateReason` is present only for CLOSED issues in gh's `issue list` schema,
    so on an OPEN issue it is the marker that the issue was closed and later
    reopened. Absent (or any other value) means "not reopened".
    """
    return str(issue.get("stateReason") or "").upper() == "REOPENED"


def reopen_unhandled(iss, recent):
    """#24 — has this issue CHANGED since our last dispatch of it?

    `stateReason=REOPENED` is a deliberate act and must defeat the landed and dedup
    arms — but only while it is UNHANDLED. The marker persists on the issue forever,
    so an override with no expiry releases the issue on every run for the rest of its
    life. Measured live 2026-10-06: #324 was reopened 18 days earlier
    (`updatedAt` 2026-09-18T05:25:36Z) and dispatched TODAY, yet the next `--auto`
    still released it — a duplicate-storm vector reached from the opposite side of
    #337, which the dedup guard cannot see because the override runs ahead of it.

    A reopen is handled once we dispatch the issue AFTER the last change on it, so
    this is True when there is no prior dispatch, or the issue's `updatedAt` is NEWER
    than our dispatch row's timestamp. A missing `updatedAt` is treated as UNHANDLED:
    fail-safe, it preserves the pre-#24 behaviour and never silently suppresses a
    legitimate reopen.
    """
    entry = recent.get(iss.get("number"))
    if entry is None:
        return True
    updated = _parse_ledger_ts(iss.get("updatedAt"))
    if updated is None:
        return True
    return updated > entry[1]

def evaluate_issue_arms(iss, landed, recent):
    """Arm decision for ONE issue — the single-issue core of the eligibility seam.

    Extracted from classify_dispatch_arms (#370) so the TWO entry points share ONE
    predicate. `--auto` consulted the landed and dedup arms; the TARGETED form
    (`oc-issue-dispatch <N>`, which the harvest patrol uses) called neither, so an
    already-landed issue was re-proposed and an issue already wired to a lane was
    wired to a SECOND one — the exact double-dispatch #337 was filed to stop. The
    fix for #337 was wired into one path and the other was left as-is, which is
    why the arithmetic lives here now rather than inline in either caller.

    Returns `(events, dispatchable)` where `events` is the ordered list of arm
    events this ONE issue produced (see classify_dispatch_arms for the vocabulary)
    and `dispatchable` says whether it survives every arm.
    """
    is_gated, reason = check_issue_claim_gate(iss)
    if is_gated:
        return [("gated", iss, reason)], False
    return evaluate_landed_and_dedup_arms(iss, landed, recent)


def evaluate_landed_and_dedup_arms(iss, landed, recent):
    """The LANDED and DEDUP arms for ONE issue, shared by both entry points (#370).

    Split from evaluate_issue_arms because the CLAIM gate above is the one arm the
    two paths treat differently: `--targeted` carries `--force` to bypass it, while
    `--auto` does not. The landed and dedup arms have no such difference — they are
    the same question on both paths — so they live here and neither caller may
    re-implement them.

    #414 — a REOPENED issue OVERRIDES both arms, because both are INFERENCES about
    state: `landed` comes from artifacts (an `Issue-Ref` trailer on origin/main, or
    a ledger landing row) and `recent` records only OUR OWN past dispatch, whereas a
    reopen is a DELIBERATE act that contradicts them. The override is part of THIS
    function, not of either caller, so the targeted path cannot lose it.

    #24 — the override EXPIRES: it applies only while the reopen is UNHANDLED (see
    reopen_unhandled above). An unbounded override is a duplicate-storm vector of its
    own, reached from the opposite side of #337.
    """
    events = []
    num = iss.get("number")
    reopened = is_reopened(iss) and reopen_unhandled(iss, recent)
    if num in landed and not reopened:
        return [("landed", iss, None)], False
    if num in landed and reopened:
        events.append(("reopened", iss, "landed"))
    if num in recent and not reopened:
        events.append(("dedup", iss, recent[num]))
        return events, False
    if num in recent and reopened:
        events.append(("reopened", iss, "dedup"))
    return events, True

def classify_dispatch_arms(unclaimed, landed, recent):
    """Partition `unclaimed` across the four dispatch arms, in evaluation order.

    Extracted from cmd_auto so the arm arithmetic is testable without gh, a repo
    checkout, or a ledger. Evaluation order is claim-gate -> landed -> dedup, and
    it is load-bearing: an issue skipped by an earlier arm NEVER reaches a later
    one, so the four arms partition `unclaimed` (they are disjoint, and
    gated + landed + dedup + dispatchable == len(unclaimed)).

    #414 — a REOPENED issue OVERRIDES the landed arm and the dedup arm. Both are
    INFERENCES about state: `landed` is derived from artifacts (an `Issue-Ref`
    trailer on origin/main, or a ledger landing row) and `recent` records only
    OUR OWN past dispatch. A reopen is a DELIBERATE act that contradicts both, so
    it wins. Without the landed override the misreferenced close is PERMANENT —
    the poison that produced the wrong close still sits on origin/main, so the arm
    re-marks the issue landed on every scan and the sweep never re-wires it (#199
    was closed on b10ca242f, which touches 0 files under src/a2a/). Without the
    dedup override the fix merely moves the stranding one arm over (#324 defeats
    the landed arm and is then suppressed by dedup memory).

    Returns (events, dispatchable):
      events       ordered list of tuples, one per non-dispatchable issue PLUS
                   one per REOPENED override that FIRED, in the SAME order
                   cmd_auto prints them:
                     ("gated",    issue, reason)
                     ("landed",   issue, None)
                     ("dedup",    issue, (lane, ts))
                     ("reopened", issue, "landed" | "dedup")
                   An issue reading landed AND present in `recent` yields TWO
                   "reopened" events — one per arm it defeated.
      dispatchable the issues that survive every arm, in input order
    """
    events = []
    dispatchable = []
    for iss in unclaimed:
        # #370: the per-issue decision lives in evaluate_issue_arms() so BOTH
        # entry points run ONE predicate; this loop is the multi-issue driver.
        evs, ok = evaluate_issue_arms(iss, landed, recent)
        events.extend(evs)
        if ok:
            dispatchable.append(iss)
    return events, dispatchable


def summarize_arms(events, dispatchable):
    """Tally the arm events into the counters cmd_auto reports.

    Split out so the reported NUMBERS are testable offline, not just the events
    they come from. A number must travel with its predicate: the two override
    counts defeat DIFFERENT arms, so they are counted and reported SEPARATELY.
    Reporting one merged total as "defeated the landed arm" was wrong for the
    dedup half (measured 2026-09-19: 4 override events, only 3 defeated landed).

    Returns a dict with keys gated/landed/dedup/landed_override/dedup_override.
    """
    return {
        "gated": sum(1 for k, _, _ in events if k == "gated"),
        "landed": sum(1 for k, _, _ in events if k == "landed"),
        "dedup": sum(1 for k, _, _ in events if k == "dedup"),
        "landed_override": sum(1 for k, _, arm in events
                               if k == "reopened" and arm == "landed"),
        "dedup_override": sum(1 for k, _, arm in events
                              if k == "reopened" and arm == "dedup"),
    }


def cmd_auto(args):
    """
    Automatic issue dispatch:
    1. Reads open issues from GitHub.
    2. Reads open claims from ledger.
    3. Finds unclaimed issues.
    4. Finds idle editor lanes.
    5. Matches topic affinities and dispatches.
    """
    ledger_file = args.ledger or DEFAULT_LEDGER_FILE
    if not os.path.exists(ledger_file):
        print(f"ERROR: Ledger file not found at {ledger_file}", file=sys.stderr)
        return 2

    with open(ledger_file, "r") as f:
        ledger_data = json.load(f)

    claimed_issues = extract_claimed_issues(ledger_data)
    open_issues = fetch_open_issues(args.repo)
    if open_issues is None:
        print("ERROR: could not fetch open issues from gh — refusing to judge eligibility "
              "against a window that FAILED to load (an empty list and a failed fetch "
              "lead to opposite decisions).", file=sys.stderr)
        return 3
    if not open_issues:
        print("No open issues found.")
        return 0

    unclaimed = [iss for iss in open_issues if iss.get("number") not in claimed_issues]

    # #337 arms A+B — an issue whose fix is already on origin/main, or which the
    # ledger already closed, is not work, whether or not a claim row exists.
    # `done`-stamped issues read as unclaimed under closer-aware claim semantics,
    # which is exactly how landed work was re-proposed.
    if args.allow_landed:
        landed = set()
    else:
        # #455: the identity leg needs each issue's NAMED surface, read from the
        # fetched issue list -- the same pass that supplies the candidates.
        landed = (fetch_landed_issues(args.repo,
                                      surfaces=issue_surfaces(open_issues))
                  | ledger_landed_issues(ledger_data))

    # #337 dedup — every run previously started from scratch, so an issue wired
    # to a lane but not yet acked was wired to a SECOND lane.
    recent = {} if args.redispatch else recent_dispatches(ledger_data)

    # #414: the arm arithmetic lives in classify_dispatch_arms() so it is testable
    # offline (see the selftest leg); cmd_auto is now only a printer.
    events, dispatchable = classify_dispatch_arms(unclaimed, landed, recent)

    counts = summarize_arms(events, dispatchable)
    gated_count = counts["gated"]
    landed_count = counts["landed"]
    dedup_count = counts["dedup"]
    landed_override_count = counts["landed_override"]
    dedup_override_count = counts["dedup_override"]

    if args.dry_run:
        for kind, iss, detail in events:
            num = iss.get("number")
            if kind == "gated":
                print(f"Skipping gated issue #{num}: {iss.get('title')} ({detail})")
            elif kind == "landed":
                print(f"Skipping landed issue #{num}: {iss.get('title')} "
                      f"(fix already on origin/main, or closed in the ledger)")
            elif kind == "dedup":
                lane, ts = detail
                print(f"Skipping already-dispatched issue #{num}: {iss.get('title')} "
                      f"(wired to {lane[:8]} at {ts.strftime('%Y-%m-%dT%H:%M:%SZ')})")
            elif detail == "landed":
                print(f"REOPENED override on issue #{num}: {iss.get('title')} "
                      f"(reads landed but stateReason=REOPENED — the landed arm "
                      f"yields to the reopen)")
            else:
                lane, ts = recent[num]
                print(f"REOPENED override on issue #{num}: {iss.get('title')} "
                      f"(re-dispatched despite the {lane[:8]} wiring at "
                      f"{ts.strftime('%Y-%m-%dT%H:%M:%SZ')} — a reopen defeats the "
                      f"dedup memory)")

    override_note = ""
    if landed_override_count or dedup_override_count:
        override_note = (f" ({landed_override_count} REOPENED override(s) defeated "
                         f"the landed arm, {dedup_override_count} defeated the "
                         f"dedup arm)")
    print(f"Found {len(open_issues)} open issues: {len(unclaimed)} unclaimed, "
          f"{gated_count} claim-gated/parked, {landed_count} landed/closed, "
          f"{dedup_count} already-dispatched, {len(dispatchable)} dispatchable."
          + override_note)
    if not dispatchable:
        print("No dispatchable issues found. All unclaimed issues are claim-gated or claimed.")
        return 0

    editor_lanes = get_worker_roster(ledger_data)

    # (#647) Order by best-available affinity DESC. Stable, so ties keep input
    # order and the previous behaviour is preserved within equal scores.
    _scores = {id(i): best_affinity_score(i, editor_lanes) for i in dispatchable}
    dispatchable.sort(key=lambda i: _scores[id(i)], reverse=True)
    # even when busy (fork #342). Without this the pre-filter drops the surface
    # owner BEFORE select_best_lane can score it, which is the live misroute: the
    # owner lane is busy whenever it has work -- i.e. exactly when its own issues
    # are the ones needing routing.
    wanted_domains = set()
    for _iss in dispatchable:
        wanted_domains |= detect_issue_domains(_iss)
    available_lanes = [l for l in editor_lanes
                       if not l["is_busy"] or owner_candidate_for(l, wanted_domains)]
    print(f"Candidate roster: {len(editor_lanes)} registered, {len(available_lanes)} idle/available "
          f"(available = no open claim + clean tree; a busy lane that OWNS a wanted domain stays "
          f"eligible -- this is NOT oc-roster's IDLE class, see #310).")

    if not available_lanes:
        # #706: an empty list here is either a full fleet or a BROKEN roster read.
        # Tell them apart before printing a verdict -- see roster_read_failed.
        if roster_read_failed(editor_lanes):
            print("ROSTER_READ_FAILED: the oc-roster classify read failed, so every "
                  "lane defaulted to busy -- 0 idle is an ARTEFACT of the failed "
                  "read, NOT a capacity verdict (see the DEGRADED line above); "
                  "repair the instrument and re-run.", file=sys.stderr)
            return RC_ROSTER_READ_FAILED
        print("CAPACITY_EXHAUSTED: No idle editor lanes available for dispatch.", file=sys.stderr)
        return 4

    dispatched_count = 0
    affinity_skipped = 0
    capacity_skipped = 0
    assigned_lanes = set()

    # Wall-clock budget for the whole run (#S). Without one, a hung notify costs
    # NOTIFY_TIMEOUT_SECS per issue and the operator's outer `timeout N` wrapper
    # SIGTERMs the run mid-send -- which is exactly how a slow run turns into an
    # unverified delivery. With one, the per-issue timeout shrinks to what is left
    # and the loop stops cleanly instead of being killed mid-flight.
    run_deadline = None
    if getattr(args, "budget_secs", 0) and args.budget_secs > 0:
        run_deadline = time.time() + args.budget_secs


    for issue in dispatchable:
        # Pick candidate lanes that haven't just been assigned in this run
        candidates = [l for l in available_lanes if l["uuid"] not in assigned_lanes]
        if not candidates:
            print("All available idle lanes have been assigned in this cycle.")
            break

        best_lane = select_best_lane(issue, candidates, allow_fallback=args.force)
        if not best_lane:
            # CAPACITY vs AFFINITY (#21 follow-up, Triage census rev.3 intake ruling
            # 2026-10-06). `candidates` EXCLUDES lanes already assigned in THIS cycle,
            # so "no candidate matches" is ambiguous -- and reporting it as affinity
            # was measured WRONG: on the rev.3 census 36 of 38 queued issues matched a
            # lane that the run's own first 7 dispatches had consumed. Re-test against
            # the FULL available set: a match there means the matching lane exists and
            # was consumed (CAPACITY); no match anywhere means the domain is unheld
            # (AFFINITY). Two different constraints, two different remedies.
            affinity_skipped += 1
            if classify_queue_reason(issue, available_lanes,
                                     allow_fallback=args.force) == "capacity":
                capacity_skipped += 1
                print(f"Skipping issue #{issue.get('number')}: matching lane already assigned "
                      f"in this cycle -- LEFT QUEUED (capacity, pass --force to override).")
            else:
                print(f"Skipping issue #{issue.get('number')}: no idle lane with matching domain "
                      f"affinity -- LEFT QUEUED (pass --force to override).")
            continue

        assigned_lanes.add(best_lane["uuid"])
        envelope, branch = format_wire_envelope(issue)
        num = issue["number"]

        print(f"\nDispatching issue #{num}: {issue['title']}")
        if title_disagrees(issue):
            # #641: the same signal `oc-issue-scope` emits (its report prints
            # `[TITLE-DISAGREES]`, its --json carries `title_disagrees`). The
            # classifier refuses to guess which repo the fix lands in, so the
            # disagreement is DISCLOSED here instead of being silently scored.
            print("  [TITLE-DISAGREES] the (tools): label claims a domain the body does "
                  "not support -- the fix may land in src/brain/tools/** (Editor) rather "
                  "than tools/** (Toolsmith). Verify before acting on the routing.")
        print(f"  Target: {best_lane['uuid']} (topic {best_lane['topic']})")
        print(f"  Branch: {branch}")
        print("  Payload:")
        for line in envelope.splitlines():
            print(f"    | {line}")

        notify_timeout = NOTIFY_TIMEOUT_SECS
        if run_deadline is not None:
            remaining = int(run_deadline - time.time())
            if remaining <= 0:
                print("Run budget exhausted; stopping before the outer wrapper kills a send mid-flight.")
                break
            # The send is followed by up to RECEIPT_GRACE_SECS of receipt polling
            # (#451), so the notify budget must leave room for that grace INSIDE
            # the remaining run budget -- otherwise a "budgeted" run still
            # overshoots its own deadline by the grace.
            notify_timeout = max(15, min(NOTIFY_TIMEOUT_SECS, remaining - RECEIPT_GRACE_SECS))

        rc = dispatch_to_lane(best_lane["uuid"], envelope, num, dry_run=args.dry_run,
                              ledger_path=ledger_file, notify_timeout=notify_timeout)
        if rc == RC_UNVERIFIED:
            print(f"  Delivery UNVERIFIED for issue #{num} -- sent, receipt not in the journal yet; "
                  f"RECORDED, so the next run will not re-dispatch it.")
        elif rc != 0:
            print(f"  Delivery FAILED for issue #{num} -- nothing sent, not recorded; safe to retry.")
        else:
            dispatched_count += 1
            if args.dry_run:
                print(f"  [DRY-RUN] Planned dispatch for issue #{num} -> {best_lane['uuid']}")
            else:
                print(f"  Delivery SUCCESS for issue #{num}")

    print(f"\nSummary: {dispatched_count} issue(s) dispatched"
          + (f", {affinity_skipped} left queued "
             f"({capacity_skipped} capacity / {affinity_skipped - capacity_skipped} affinity)"
             if affinity_skipped else "")
          + ".")
    if dispatched_count == 0 and affinity_skipped > 0:
        # A run that dispatched nothing must not report plain success: that is
        # the false-success shape clause 3 exists to prevent. Same code as the
        # no-idle-lanes case, told apart by the MESSAGE (the rc-8 precedent).
        print(f"CAPACITY_EXHAUSTED: {affinity_skipped} dispatchable issue(s) had no idle lane "
              f"({capacity_skipped} capacity / {affinity_skipped - capacity_skipped} affinity); "
              f"all left queued.", file=sys.stderr)
        return 4
    return 0


def resolve_target_issue(repo_path, issue_num, open_issues):
    """The issue a TARGETED dispatch acts on, plus a diagnostic note. (#483)

    Returns ``(issue, note)``. ``note`` is "" when the fetched window answered,
    else a sentence naming where the issue came from; ``issue`` is None when the
    number cannot be resolved at all -- NEVER a stub.

    Split out of cmd_targeted so the resolution RULE is testable without a lane,
    a ledger or a notify: the regression this exists for is not "the fetch is
    wrong" but "an out-of-window number was answered with a fabricated title and
    an EMPTY body", which then fed the claim gate and the affinity scoring.
    """
    if open_issues is not None:
        for iss in open_issues:
            if iss.get("number") == issue_num:
                return iss, ""

    # The fetched list is a WINDOW: it cannot tell "not in the list" from "no
    # such issue", so resolve the ONE issue directly instead of guessing.
    resolved = fetch_issue(repo_path, issue_num)
    if not resolved:
        return None, ""
    window = f"{len(open_issues)} listed" if open_issues is not None else "the list read FAILED"
    note = (f"NOTE: issue #{issue_num} was outside the fetched open-issue window "
            f"({window}) and was resolved by a direct lookup.")
    st = str(resolved.get("state") or "").upper()
    if st and st != "OPEN":
        note += (f" NOTE: it resolves with state={st}, not OPEN — dispatching it "
                 f"anyway because the number was named explicitly.")
    return resolved, note


def cmd_targeted(args):
    """
    Targeted dispatch for a specific issue number.
    """
    ledger_file = args.ledger or DEFAULT_LEDGER_FILE
    if not os.path.exists(ledger_file):
        print(f"ERROR: Ledger file not found at {ledger_file}", file=sys.stderr)
        return 2

    with open(ledger_file, "r") as f:
        ledger_data = json.load(f)

    issue_num = args.issue
    open_issues = fetch_open_issues(args.repo)

    # #483: an out-of-window number used to be answered with a STUB (title
    # `Issue #N`, body "") -- so a real, open, labelled issue was dispatched
    # under a fabricated title, and every downstream consumer of those fields
    # (the claim gate, the affinity scoring) then evaluated NOTHING. Resolve the
    # ONE issue by direct lookup instead, and REFUSE when even that fails: an
    # unresolvable target is a rejection, never a placeholder.
    target_issue, note = resolve_target_issue(args.repo, issue_num, open_issues)
    if note:
        print(note, file=sys.stderr)
    if not target_issue:
        print(f"ERROR: issue #{issue_num} could not be resolved on "
              f"{TRACKER_SLUG} — it was not in the fetched open-issue list "
              f"and `gh issue view` did not resolve it either. Refusing to dispatch: "
              f"a fabricated title/body would make the claim gate and affinity "
              f"scoring run blind. Check the number, and that the issue is OPEN and "
              f"lives in this repo's issue space.", file=sys.stderr)
        return 1

    is_gated, reason = check_issue_claim_gate(target_issue)
    if is_gated and not args.force:
        print(f"ERROR: Issue #{issue_num} is claim-gated ({reason}). Pass --force to bypass gate in targeted mode.", file=sys.stderr)
        return 5

    # #370: the TARGETED form consulted NEITHER eligibility guard, so an
    # already-landed issue was re-proposed and an issue already wired to a lane
    # was wired to a SECOND one — the double-dispatch #337 exists to stop. Both
    # entry points now run the SAME arms (evaluate_landed_and_dedup_arms), so the
    # two can never drift apart again.
    if args.allow_landed:
        landed = set()
    else:
        # #455: same identity leg on the targeted path -- the surface comes from
        # the fetched open list plus the resolved target itself.
        landed = (fetch_landed_issues(
                      args.repo,
                      surfaces=issue_surfaces((open_issues or []) + [target_issue]))
                  | ledger_landed_issues(ledger_data))
    recent = {} if args.redispatch else recent_dispatches(ledger_data)
    arm_events, arm_ok = evaluate_landed_and_dedup_arms(target_issue, landed, recent)
    if not arm_ok:
        for kind, _iss, detail in arm_events:
            if kind == "landed":
                print(f"ERROR: Issue #{issue_num} has LANDED — its fix is already on "
                      f"origin/main (an Issue-Ref trailer references it) or the ledger "
                      f"holds a landing row for it. Re-dispatching re-proposes shipped "
                      f"work. Pass --allow-landed to override.", file=sys.stderr)
                return RC_TARGETED_LANDED
            if kind == "dedup":
                lane, ts = detail
                print(f"ERROR: Issue #{issue_num} was ALREADY dispatched to {lane} at "
                      f"{ts} and is not yet acked. Dispatching again wires a SECOND lane "
                      f"to the same issue. Pass --redispatch to override.", file=sys.stderr)
                return RC_TARGETED_ALREADY_DISPATCHED

    editor_lanes = get_worker_roster(ledger_data)
    target_lane = None

    if args.to:
        for l in editor_lanes:
            if l["uuid"].startswith(args.to):
                target_lane = l
                break
        if not target_lane:
            # Custom uuid not in ledger
            target_lane = {
                "uuid": args.to,
                "topic": "custom",
                "topic_id": None,
                "feature": "",
                "is_busy": False
            }
    else:
        # Auto-select best idle lane (a busy lane that OWNS this issue's domain
        # stays a candidate -- fork #342, same predicate as the --auto path)
        available = [l for l in editor_lanes
                     if not l["is_busy"]
                     or owner_candidate_for(l, detect_issue_domains(target_issue))]
        if not available:
            # #706: same split as the --auto path -- a broken roster read must not
            # borrow the capacity verdict.
            if roster_read_failed(editor_lanes):
                print("ROSTER_READ_FAILED: the oc-roster classify read failed, so every "
                      "lane defaulted to busy -- 0 idle is an ARTEFACT of the failed "
                      "read, NOT a capacity verdict (see the DEGRADED line above); "
                      "repair the instrument and re-run.", file=sys.stderr)
                return RC_ROSTER_READ_FAILED
            print("CAPACITY_EXHAUSTED: No idle editor lanes available for dispatch.", file=sys.stderr)
            return 4
        target_lane = select_best_lane(target_issue, available, allow_fallback=args.force)

    if not target_lane:
        print("ERROR: Could not resolve target lane with matching domain affinity (pass --force to override).", file=sys.stderr)
        return 4

    envelope, branch = format_wire_envelope(target_issue)
    print(f"Target Editor: {target_lane['uuid']} (topic {target_lane['topic']})")
    print(f"Branch Target: {branch}")
    print("Wire Envelope:")
    print("---")
    print(envelope)
    print("---")

    rc = dispatch_to_lane(target_lane["uuid"], envelope, issue_num, dry_run=args.dry_run, ledger_path=ledger_file)
    if rc != 0:
        print(f"ERROR: Delivery failed with code {rc}", file=sys.stderr)
        return rc

    if args.dry_run:
        print(f"[DRY-RUN] Planned dispatch for issue #{issue_num} -> editor {target_lane['uuid']}.")
    else:
        print(f"SUCCESS: Issue #{issue_num} dispatched to editor {target_lane['uuid']}.")
    return 0


# --- Hermetic Offline Selftest ---
def run_selftest():
    # #483: the window-full warning is asserted by shrinking the module's window
    # global rather than by fabricating 1000 issues, so the PRODUCTION comparison
    # (len(issues) >= OPEN_ISSUES_LIMIT) is the thing under test.
    # #390: TOOL_DIR and ROSTER_TIMEOUT_SECS are swapped the same way -- the
    # production call site reads both as globals, so the test drives the real one.
    global OPEN_ISSUES_LIMIT, TOOL_DIR, ROSTER_TIMEOUT_SECS, TRACKER_SLUG
    print("Running oc-issue-dispatch --selftest battery...")
    tests_passed = 0
    tests_failed = 0

    def assert_eq(desc, actual, expected):
        nonlocal tests_passed, tests_failed
        if actual == expected:
            print(f"  ok {tests_passed + tests_failed + 1} - {desc}")
            tests_passed += 1
        else:
            print(f"  FAIL {tests_passed + tests_failed + 1} - {desc} (expected '{expected}', got '{actual}')")
            tests_failed += 1

    def assert_true(desc, condition):
        nonlocal tests_passed, tests_failed
        if condition:
            print(f"  ok {tests_passed + tests_failed + 1} - {desc}")
            tests_passed += 1
        else:
            print(f"  FAIL {tests_passed + tests_failed + 1} - {desc} (condition False)")
            tests_failed += 1

    # Test 1: Wire envelope formatting and contract compliance
    issue_sample = {
        "number": 181,
        "title": "fix(telegram): draft_streaming config flag is dead",
        "body": "The DM draft gate was dropped in a refactor"
    }
    envelope, branch = format_wire_envelope(issue_sample)
    assert_eq("Branch target derivation", branch, "fix/181-draft-streaming-config-flag-is-dead")
    assert_true("Wire envelope header present", "[ISSUE DISPATCH: #181]" in envelope)
    assert_true("Target issue line present", "Target Issue: #181 (fix(telegram): draft_streaming config flag is dead)" in envelope)
    assert_true("Issue URL line present",
                f"Issue URL: https://github.com/{TRACKER_SLUG}/issues/181" in envelope)
    assert_true("Branch Target line present", "Branch Target: fix/181-draft-streaming-config-flag-is-dead" in envelope)
    assert_true("Zero-Ack contract clause present", "Ack contract: NONE — claim on ledger (oc-ledger claim) and proceed." in envelope)
    assert_true("Refusal affordance clause present", "reply with [REFUSE: <reason>]." in envelope)
    assert_true("Gate-blocked refusal affordance present", "gate-blocked" in envelope)

    # Two-stream routing (SKILL.md v0.4.284): the envelope URL must follow the
    # SELECTED tracker, or a lane reads a link to a repo the issue is not in.
    # Both directions are probed: a one-sided leg passes on a hardcoded slug.
    _saved_slug = TRACKER_SLUG
    try:
        for _t, _slug in (("factory", TRACKER_SLUGS["factory"]),
                          ("binary", TRACKER_SLUGS["binary"]),
                          ("fork", TRACKER_SLUGS["fork"])):
            TRACKER_SLUG = _slug
            _env_t, _ = format_wire_envelope(issue_sample)
            assert_true(f"#v0.4.284: the envelope URL follows --tracker {_t}",
                        f"Issue URL: https://github.com/{_slug}/issues/181" in _env_t)
    finally:
        TRACKER_SLUG = _saved_slug

    # Test 2: Extraction of claimed issues from ledger events.
    # #329: the predicate is now the canonical one (tools/lib/oc_claims.py), so
    # this fixture pins the properties the local copy got WRONG, not just the
    # happy path. `Issue-Ref: 103` was dropped from the fixture deliberately: it
    # is not one of the canonical reference forms (`#N`, `issue N`, `issue=N`,
    # `issue#N`), and oc-ledger's write-time guard refuses a claim the scanner
    # cannot see — so a row in that shape cannot exist in the live ledger.
    mock_ledger = {
        "events": [
            {"kind": "claim", "by": "editor 1111", "what": "CLAIM #101 — some feature"},
            {"kind": "claim", "by": "editor 2222", "what": "issue #102 fix"},
            {"kind": "claim", "by": "editor 3333", "what": "issue 103 claimed"},
            {"kind": "note", "by": "triage", "what": "not a claim for #104"},
            # THE #329 REGRESSION: a body citation is not a second claim. Live
            # shape: n=8034 claimed #302 and mentioned #290 in a parenthetical,
            # which made the OPEN issue #290 undispatchable.
            {"kind": "claim", "by": "editor 44444444",
             "what": "CLAIM #105 — filed while fixing #104"},
            # The structured field wins over prose in both directions.
            {"kind": "claim", "by": "editor 55555555",
             "what": "CLAIM #106 — mentions #107 in the body", "issues": [106]},
            {"kind": "claim", "by": "editor 55555555",
             "what": "CLAIM #108, #109 — genuine dual claim", "issues": [108, 109]},
            # The closure predicate applies: a CLOSED claim must not block
            # dispatch forever (the old copy returned every claim ever written).
            {"kind": "claim", "by": "editor 66666666", "what": "CLAIM #110 — shipped"},
            {"kind": "done", "by": "editor 66666666", "what": "DONE #110 — merged"},
            # ...and a FOREIGN lane's prose mention releases nothing (#305).
            {"kind": "claim", "by": "editor 77777777", "what": "CLAIM #111 — held"},
            {"kind": "unclaim", "by": "triage 88888888",
             "what": "UNCLAIM #999 — stood down in favour of editor lane 77777777"},
            # #312: a HOLD is a reservation that is not a claim. The filer parked
            # the issue and is not implementing it, so it holds no claim row --
            # and before #312 the dispatcher could not see it at all.
            {"kind": "hold", "by": "editor 99999999",
             "what": "HOLD #112 — filed, parked in the owner design gate"},
            # ...and a hold is RELEASED by the same closing predicate as a claim.
            {"kind": "hold", "by": "editor 99999999",
             "what": "HOLD #113 — filed, parked pending owner"},
            {"kind": "unclaim", "by": "editor 99999999",
             "what": "UNCLAIM #113 — design gate dropped, resumable"},
            # Negative control: a bare prose mention in a non-reserving kind
            # must not hold anything (#329's phantom class, on the hold side).
            {"kind": "note", "by": "triage",
             "what": "noted that #114 is still parked"},
        ]
    }
    claimed = extract_claimed_issues(mock_ledger)
    assert_true("#101 recognized as claimed", 101 in claimed)
    assert_true("#102 recognized as claimed", 102 in claimed)
    assert_true("#103 (issue-N form) recognized as claimed", 103 in claimed)
    assert_true("#104 (negative control) not recognized as claimed", 104 not in claimed)
    assert_true("#105 claimed", 105 in claimed)
    assert_true("#329: prose mention #104 is NOT claimed", 104 not in claimed)
    assert_true("#329: structured issues honored (#106)", 106 in claimed)
    assert_true("#329: prose mention #107 is NOT claimed", 107 not in claimed)
    assert_true("#329: genuine dual claim keeps both", 108 in claimed and 109 in claimed)
    assert_true("#329: closed claim releases its issue (#110)", 110 not in claimed)
    assert_true("#305: foreign prose mention does not release (#111)", 111 in claimed)
    # #312: the hold legs. A `hold` row is a reservation by a lane that FILED
    # the issue and parked it in the owner design gate -- correctly without a
    # claim row, which is exactly why it used to read as free.
    assert_true("#312: a hold reserves its issue (#112)", 112 in claimed)
    assert_true("#312: a released hold releases its issue (#113)", 113 not in claimed)
    assert_true("#312: prose in a non-reserving kind holds nothing (#114)", 114 not in claimed)

    # Test 3: Topic affinity scoring
    issue_tg = {"number": 169, "title": "telegram_send re-poisons topic memory", "body": "stale-topic eviction"}
    issue_bash = {"number": 166, "title": "fix(bash): bash tool env carries no session identity", "body": "subshell env missing"}
    
    lane_tg = {"uuid": "lane-tg-1", "feature": "rich-formatting telegram-buttons", "is_busy": False, "class": "ACTIVE"}
    lane_bash = {"uuid": "lane-bash-1", "feature": "loop-guard bash-session-env", "is_busy": False, "class": "ACTIVE"}
    
    score_tg_to_tg = score_affinity(issue_tg, lane_tg)
    score_tg_to_bash = score_affinity(issue_tg, lane_bash)
    assert_true("Telegram issue scores higher on telegram lane", score_tg_to_tg > score_tg_to_bash)

    # Test 3b: Domain mismatch and specialized lane pollution protection
    issue_db = {
        "number": 278,
        "title": "feat(db): no retention policy for the messages table — session DB grows unbounded",
        "body": "sqlite vacuum and message retention ttl"
    }
    lane_mermaid = {"uuid": "lane-mermaid-1", "feature": "mermaid-rendering visual diagram", "is_busy": False, "class": "ACTIVE"}
    lane_generic = {"uuid": "lane-generic-1", "feature": "general editor", "is_busy": False, "class": "ACTIVE"}
    lane_db = {"uuid": "lane-db-1", "feature": "compaction-signal sqlite maintenance", "is_busy": False, "class": "ACTIVE"}

    assert_true("DB issue scores negative on mermaid specialized lane", score_affinity(issue_db, lane_mermaid) < 0)
    assert_true("DB issue scores positive on db maintenance lane", score_affinity(issue_db, lane_db) > 0)
    
    # select_best_lane must refuse to route DB issue to mermaid lane if only mermaid is available
    assert_true("Mismatched specialized lane refused when no matching lane available", select_best_lane(issue_db, [lane_mermaid]) is None)
    # But routes cleanly when db lane or generic lane is present
    assert_eq("Routes to matching domain lane", select_best_lane(issue_db, [lane_mermaid, lane_db])["uuid"], "lane-db-1")
    # (#639 Wire C) A zero score is the ABSENCE of a match, not a weak one. The
    # generic lane carries no `db` affinity, so routing to it is a guaranteed
    # wasted turn -- the mis-route class #626/#539/#606 all landed in. The law's
    # remedy (fleet-directives.md clause 3) is to leave the unit QUEUED. This leg
    # REPLACES an earlier one that asserted the mis-route itself.
    assert_true("Zero-affinity generic lane refused -- unit left queued (#639)",
                select_best_lane(issue_db, [lane_mermaid, lane_generic]) is None)
    # Control, and the reason the refusal is scoped to DOMAIN-BEARING issues: an
    # issue whose surface no domain covers scores 0 against EVERY lane, so
    # refusing there would make it unroutable forever rather than merely queued.
    # It keeps avoiding the specialised lane, which is all that can be decided.
    issue_nodomain = {"number": 9001, "labels": [],
                      "title": "chore: wheels turn slowly",
                      "body": "zzz qqq wibble"}
    assert_true("control: the domain-less fixture really has no domains",
                not detect_issue_domains(issue_nodomain))
    assert_eq("control: a domain-less issue still avoids the specialised lane",
              select_best_lane(issue_nodomain, [lane_mermaid, lane_generic])["uuid"],
              "lane-generic-1")
    # --force is the documented escape hatch and must still override.
    assert_eq("--force overrides the zero-affinity refusal",
              select_best_lane(issue_db, [lane_mermaid, lane_generic], allow_fallback=True)["uuid"],
              "lane-generic-1")

    # Test 3c (#551): the DECLARED `type(scope):` prefix is read FIRST, with the
    # keyword arm as FALLBACK. Before this the classifier routed on prose alone,
    # so a scope whose token differs from its keyword -- the plural, the
    # abbreviation -- declared a domain that was never read. `fix(skills):` was
    # invisible because `_keyword_matches` matches on WORD BOUNDARIES while the
    # corpus keyword is the singular `skill`; `fix(tg):` matched nothing at all.
    # MEASURED on the live corpus (184 open issues, 37 distinct scopes): the
    # declaration arm takes reachable scopes 15 -> 19 and loses zero.
    _N = "lorem ipsum dolor sit amet"          # neutral prose: no keyword can fire
    def _decl(title):
        return detect_issue_domains({"number": 1, "labels": [], "title": title, "body": _N})

    assert_eq("#551 a plural scope reaches its domain on a NEUTRAL body",
              sorted(_decl("fix(skills): zzz qqq")), ["skills"])
    assert_eq("#551 an abbreviated scope reaches its domain",
              sorted(_decl("fix(tg): zzz qqq")), ["telegram"])
    assert_eq("#551 a scope the prose arm can never reach",
              sorted(_decl("fix(read_config): zzz qqq")), ["config"])
    # Negative controls: a scope naming NO domain must stay empty, or the
    # declaration arm would be inventing affinity no lane owns.
    assert_true("#551 control: an unmapped scope declares nothing",
                not declared_scope_domains({"title": "fix(daemon): zzz qqq"}))
    assert_true("#551 control: a scope-less title declares nothing",
                not declared_scope_domains({"title": "zzz qqq"}))
    assert_true("#551 control: the type verb is not a domain",
                not declared_scope_domains({"title": "fix: zzz qqq"}))
    # A scope is a DECLARATION, not a mention, so #605's negation guard must NOT
    # apply: a title that negates the domain in its PROSE still declares it.
    assert_eq("#551 a scope is a declaration, not a mention (#605 does not apply)",
              sorted(declared_scope_domains({"title": "fix(tools): not (plan): zzz"})),
              ["tools"])
    # Compound scopes name each part.
    assert_eq("#551 a compound scope names each part",
              sorted(declared_scope_domains({"title": "fix(tools, plan): zzz"})),
              ["plan", "tools"])
    # The invariant: the declaration may only ADD. A prefix-less issue must read
    # EXACTLY as the prose arm alone did -- asserted against that arm directly,
    # never against a hand-guessed domain list.
    _plain = {"number": 2, "labels": [], "title": "chore: wheels turn slowly",
              "body": "telegram cron tools"}
    assert_eq("#551 a prefix-less issue reads EXACTLY as the prose arm did",
              sorted(detect_issue_domains(_plain)),
              sorted(_domains_for_text(_plain["title"] + " " + _plain["body"])))
    # ...and a PREFIXED issue is a SUPERSET of the prose arm, never a subset.
    _pref = {"number": 3, "labels": [], "title": "fix(telegram): cron flakiness",
             "body": "telegram cron tools"}
    assert_true("#551 a prefixed issue is a SUPERSET of the prose arm",
                _domains_for_text(_pref["title"] + " " + _pref["body"])
                <= detect_issue_domains(_pref))
    # Every target in the map must be a domain a lane can actually own, or the
    # arm would hand out affinity no role holds.
    _real_domains = set(AFFINITY_KEYWORDS)
    for _ds in ROLE_DOMAINS.values():
        _real_domains |= set(_ds)
    assert_true("#551 every mapped scope names a REAL domain",
                all(v in _real_domains for v in SCOPE_DOMAINS.values()))

    # Test 3d (#668): domain intersection is a GATE, not a score component. A
    # POSITIVE score built purely from feature PROSE used to satisfy both sign
    # guards above -- they reject only < 0, or == 0 with domains set -- so a lane
    # with ZERO domain intersection won on vocabulary alone. Reproduced at
    # source: issue domains {notify, telegram}, lane prose "demoted-host guard"
    # yields lane_domains set() and score 6, and this call dispatched to it.
    issue_464 = {"number": 464, "labels": [],
                 "title": "fix(telegram): the notify guard drops topics",
                 "body": "notify guard eviction in the demoted-host path"}
    lane_prose_only = {"uuid": "lane-prose-only", "class": "ACTIVE", "is_busy": False,
                       "feature": "demoted-host guard"}
    _d464 = detect_issue_domains(issue_464)
    assert_true("#668 precondition: the fixture issue HAS domains", bool(_d464))
    assert_true("#668 precondition: the lane has ZERO domain intersection",
                not _d464.intersection(lane_domains_for(lane_prose_only)))
    assert_true("#668 precondition: the prose score is POSITIVE -- the defect's entry",
                score_affinity(issue_464, lane_prose_only) > 0)
    assert_true("#668: a prose-only POSITIVE score must NOT win the lane",
                select_best_lane(issue_464, [lane_prose_only]) is None)
    lane_464_real = {"uuid": "lane-464-real", "class": "ACTIVE", "is_busy": False,
                     "feature": "telegram notify delivery"}
    assert_eq("#668 control: a domain-matching lane still routes",
              select_best_lane(issue_464, [lane_prose_only, lane_464_real])["uuid"],
              "lane-464-real")
    assert_eq("#668: --force still overrides the prose-only refusal",
              select_best_lane(issue_464, [lane_prose_only], allow_fallback=True)["uuid"],
              "lane-prose-only")

    # Test 3c: role-owned domain beats prose (fork #342 sufficiency leg). A lane that
    # OWNS tools/** must win a tools/ issue even when its feature prose never names the
    # surface -- and must still win against an editor whose prose happens to share
    # domains with the issue. The verbose lane is deliberately FIRST in the candidate
    # list, so an equal score would hand it the issue on sort stability alone.
    issue_tools = {
        "number": 451,
        "title": "fix(tools): oc-issue-dispatch hangs past 120s",
        "body": "the culprit is tools/issue/oc-issue-dispatch, with tools/lib/oc-log.sh in the path",
    }
    lane_toolsmith = {
        "uuid": "lane-toolsmith", "class": "ACTIVE", "is_busy": False,
        "feature": "TOOLSMITH lane: owns tools/ CLI (oc-ledger, oc-deploy, oc-prchecks)",
        "raw": {"role": "toolsmith"},
    }
    lane_editor_verbose = {
        "uuid": "lane-editor-verbose", "class": "ACTIVE", "is_busy": False,
        "feature": "harvest upstream port census sweep telegram notify queue delivery router bash cli exec dispatch",
        "raw": {"role": "editor"},
    }
    lane_tools_prose = {
        "uuid": "lane-tools-prose", "class": "ACTIVE", "is_busy": False,
        # #641: this feature must NAME the surface. It was the bare `(tools):`
        # label, which is no longer a domain signal -- left as-is, the leg below
        # would pass for a lane whose prose names nothing at all.
        "feature": "tools/issue/oc-issue-dispatch dispatch affinity",
        "raw": {"role": "editor"},
    }
    s_owner = score_affinity(issue_tools, lane_toolsmith)
    s_verbose = score_affinity(issue_tools, lane_editor_verbose)
    assert_true("Role-owned domain: surface owner scores positive on its own issue", s_owner > 0)
    assert_true("Role-owned domain: surface owner outranks a verbose multi-domain editor", s_owner > s_verbose)
    assert_eq("Role-owned domain: selection picks the surface owner",
              select_best_lane(issue_tools, [lane_editor_verbose, lane_toolsmith])["uuid"], "lane-toolsmith")

    # Mutation kill: strip the role binding at runtime and the surface owner must LOSE.
    # Without this the assertions above would still pass on a tie, proving nothing.
    try:
        _saved_role_domain = ROLE_DOMAINS.pop("toolsmith")
        s_unbound = score_affinity(issue_tools, lane_toolsmith)
    finally:
        ROLE_DOMAINS["toolsmith"] = _saved_role_domain
    assert_true("Role-owned domain: unbound surface owner loses its own issue", s_unbound < s_owner)
    # Retargeted by #546. The old form compared against lane_editor_verbose, which
    # shared the issue's domain ONLY through the pre-#546 over-firing ("oc-log.sh"
    # -> the 2-char "sh" token): the leg passed BECAUSE of the defect, and under the
    # narrowed vocabulary that lane is correctly penalised (-50). The invariant is
    # that prose alone cannot substitute for the role binding, so compare against a
    # lane whose prose NAMES the surface -- s_unbound 3 vs s_prose 26.
    assert_true("Role-owned domain: unbound surface owner does not outrank a prose domain match",
                s_unbound <= score_affinity(issue_tools, lane_tools_prose))

    # Test 3d: the ownership override must survive BUSY (fork #342, live-misroute
    # leg). Measured 2026-09-20: the toolsmith lane scored 93 on #451 while every
    # editor scored 0-3, yet select_best_lane dropped it as busy and handed the
    # issue to a score-0 editor. Ownership must outrank the idle preference, or the
    # fix is cosmetic on the live box, where the owner lane is busy whenever it has
    # work -- i.e. always, precisely when its own issues need routing.
    lane_owner_busy = dict(lane_toolsmith, is_busy=True, busy_known=True)
    assert_eq("Busy surface owner is still selected for its own domain",
              select_best_lane(issue_tools, [lane_editor_verbose, lane_owner_busy])["uuid"],
              "lane-toolsmith")

    # Mutation kill A: an UNKNOWN busy reading (classify failed -> every lane marked
    # busy by conservative default) must NOT be read as "the owner is merely queued".
    lane_owner_unknown = dict(lane_toolsmith, is_busy=True, busy_known=False)
    picked = select_best_lane(issue_tools, [lane_editor_verbose, lane_owner_unknown])
    assert_true("Unknown busy reading does not re-enable the owner override",
                picked is None or picked["uuid"] != "lane-toolsmith")

    # Mutation kill B: an idle editor outranks a busy NON-owner, so the override
    # cannot widen into a general "busy lanes are candidates" change.
    # Fixtures retargeted by #546 for the same reason as the leg above: the verbose
    # lane is now penalised on a tools issue, which destroyed this kill's contrast.
    # Generic lanes keep it: both score 0, so the busy-first order decides, and a
    # widened override picks the busy lane and reddens this leg.
    lane_editor_busy = {"uuid": "lane-editor-busy", "class": "ACTIVE", "is_busy": True,
                        "busy_known": True, "feature": "generic editor", "raw": {"role": "editor"}}
    lane_editor_idle = {"uuid": "lane-editor-idle", "class": "ACTIVE", "is_busy": False,
                        "feature": "generic editor", "raw": {"role": "editor"}}
    # Retargeted again by #639 Wire C: this kill needs BOTH lanes at score 0 so
    # the busy/idle order is what decides -- but issue_tools now carries the
    # `tools` domain, and a domain-bearing issue with no positive-affinity lane
    # is refused (left queued). A domain-less issue keeps both at 0, so the
    # availability filter is still the only thing under test here.
    assert_eq("Busy non-owner does not displace an idle editor",
              select_best_lane(issue_nodomain, [lane_editor_busy, lane_editor_idle])["uuid"],
              "lane-editor-idle")

    # Test 3e: the PLAN domain (fork #529, live mis-route). #506 was dispatched to
    # an unrelated editor lane on 2026-09-23 while the plan-tool lane sat idle.
    # Settled by simulation, not inference: the DEGRADED path (classify failed ->
    # every lane busy) makes select_best_lane return None, i.e. NO dispatch is
    # possible, so a dispatch having occurred EXCLUDES it. The mis-route was the
    # 0-score TIE: with every >0 scorer busy, 18 lanes scored exactly 0 and the
    # stable sort on score alone left roster order to decide -- and the plan-tool
    # lane sat at roster index 4 against the receiver's 2. Replaying that shape
    # now picks the plan lane.
    issue_plan = {"number": 506, "labels": [],
                  "title": "fix(plan): complete and start in one parallel block clobber each other",
                  "body": "the tool returns a SUCCESS receipt for a mutation that never persists"}
    lane_plan = {"uuid": "lane-plan", "feature": "plan-tool (#1231 re-stick relay)",
                 "is_busy": False, "busy_known": True, "class": "IDLE"}
    lane_generic = {"uuid": "lane-suggest", "feature": "suggest-options",
                    "is_busy": False, "busy_known": True, "class": "IDLE"}
    assert_true("plan domain: the scope prefix gives the issue the plan domain",
                "plan" in detect_issue_domains(issue_plan))
    s_plan = score_affinity(issue_plan, lane_plan)
    s_generic = score_affinity(issue_plan, lane_generic)
    assert_true("plan domain: the plan lane scores strictly above an unrelated lane",
                s_plan > s_generic)
    assert_eq("plan domain: selection picks the plan lane", 
              select_best_lane(issue_plan, [lane_generic, lane_plan])["uuid"], "lane-plan")
    # The lane-side match is PROSE (its feature says 'plan-tool'), not role-owned:
    # unlike #342's toolsmith there is no ROLE_DOMAINS entry, so this leg proves
    # the keyword path carries the lane half on its own.
    assert_true("plan domain: the lane half comes from its feature prose, not a role binding",
                "toolsmith" not in ROLE_DOMAINS or "plan" not in ROLE_DOMAINS.get("toolsmith", ()))
    # And the domain must NOT be handed to a telegram-rendering issue that merely
    # mentions a plan card -- measured: 'plan card' / 'plan tool' fire on #290,
    # #334, #399, #402 and were REJECTED for exactly this.
    issue_tg_card = {"number": 290, "labels": [],
                     "title": "fix(telegram): fallback to in-place HTML edit on plan card update error",
                     "body": "the plan card update endpoint returns a stale revision"}
    assert_true("plan domain: a telegram plan-card issue does NOT gain the plan domain",
                "plan" not in detect_issue_domains(issue_tg_card))

    # #543: shared matcher preserves structured scope tokens while blocking
    # incidental prose substrings on both issue and lane sides.
    issue_bash_noise = {"title": "fix: should push finished", "body": ""}
    assert_true("#543: prose sh does not match inside should/push/finished",
                "bash" not in detect_issue_domains(issue_bash_noise))
    # #543: structured scopes still map through the shared matcher. RETARGETED by
    # #641: the example here was `(tools):`, which is now CONFIRM-ONLY, so it can
    # no longer serve as the positive control for "a structured scope maps".
    issue_plan_scope = {"title": "fix(plan): card revision", "body": ""}
    assert_true("#543: structured plan scope keeps substring matching",
                "plan" in detect_issue_domains(issue_plan_scope))
    # #641: the tools LABEL alone no longer claims the domain -- it spans two
    # repos (tools/** Toolsmith, src/brain/tools/** Editor) and decides nothing.
    # A body that NAMES a real tools/** script still claims it (see #605 control).
    assert_true("#641: a bare (tools): label no longer claims the tools domain",
                "tools" not in detect_issue_domains(
                    {"title": "fix(tools): dispatch affinity", "body": ""}))
    assert_true("#641: the label/body disagreement is DISCLOSED, never scored",
                title_disagrees({"title": "fix(tools): dispatch affinity", "body": ""}))
    assert_true("#641: an agreeing label is not reported as a disagreement",
                not title_disagrees(
                    {"title": "fix(tools): dispatch affinity",
                     "body": "tools/issue/oc-issue-dispatch"}))
    assert_true("#641: an issue with no tools label is never a disagreement",
                not title_disagrees({"title": "fix(telegram): zzz", "body": ""}))
    # #641: the 14th acceptance row (#634) is NOT satisfiable by a symbol arm,
    # and this leg LOCKS that boundary so a later lane cannot re-ship one. The
    # fixture is the real measured counterexample: fork #757 is `fix(telegram)`,
    # yet a `tools/`-minus-`src/` symbol vocabulary gave it `tools` because
    # `tools/harvest/oc-harvest-census` quotes `spacing_ok` in a COMMENT. A
    # generic implementation symbol must therefore never confirm the domain --
    # only a tools/** path or a real oc-* script name may (see #605 control).
    assert_true("#641: a generic implementation symbol never confirms the domain",
                "tools" not in detect_issue_domains(
                    {"title": "fix(telegram): the #676 spacing floor governs droppable chrome only",
                     "body": "`src/channels/telegram/governor.rs`: "
                             "`if class.is_droppable() && !spacing_ok(peer, now, lim.spacing_floor)`"}))
    lane_topic = {"feature": "generic lane", "topic": "spill"}
    assert_true("#543: optional topic participates through shared matcher",
                "bash" not in _domains_for_text(lane_topic["feature"]))
    assert_true("#543: topic value is matched by shared matcher",
                "bash" in _domains_for_text(lane_topic["topic"]))
    assert_true("#543: shared matcher is the only keyword predicate",
                _keyword_matches("should", "sh") is False and _keyword_matches("sh", "sh"))

    # #605: a token is only a CLAIM when it is not the direct object of a
    # negation. A literal token has no polarity, so "NOT (tools):" fired as the
    # tools domain -- the matcher read the surface being RULED OUT.
    assert_true("#605: a negated structured token does NOT claim the domain",
                "tools" not in detect_issue_domains(
                    {"title": "", "body": "Surface: src/tests/** - Editor territory, NOT (tools):."}))
    assert_true("#605: a negated subdir token does NOT claim the domain",
                "tools" not in detect_issue_domains(
                    {"title": "", "body": "this is not tools/lib/oc-notify.sh work"}))
    assert_true("#605 control (retargeted by #641): naming a real tools/** script "
                "still claims the domain -- the bare label alone no longer does",
                "tools" in detect_issue_domains(
                    {"title": "fix(tools): dispatch affinity",
                     "body": "the culprit is tools/issue/oc-issue-dispatch"}))
    assert_true("#605: naming a tools file still claims it (control)",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "the culprit is tools/issue/oc-issue-dispatch"}))

    # #27: RESOLUTION is not a SURFACE CLAIM. _names_fleet_tool returned True for
    # any oc-* name that resolves on disk, so a body that NAMES a live tool while
    # talking about something else handed the issue the factory (tools) tier. Two
    # live specimens: #530 names `oc-start` as the VICTIM of a false defect report
    # ("false defect against oc-start") and won +70 -> 93; #418 names
    # `oc-deploy fanout` as a CONSUMER of a contract ("The consumers of this
    # contract are mechanical fan-out tooling (`oc-deploy fanout`, #24)"). Frames
    # are MIRRORED from oc-issue-scope:377-404 (analogy #387, victim #678, negation
    # #605); only the CONSUMER frame is new here (#418). Each negative leg is
    # paired with a SUBJECT control, so a guard that simply stopped matching --
    # losing every genuine claim -- cannot pass this block.
    assert_true("#27 VICTIM (#530): a tool named as the victim of a false report "
                "does not claim the domain",
                "tools" not in detect_issue_domains(
                    {"title": "", "body": "this is a false defect against oc-start, "
                                          "which never touches the surface"}))
    assert_true("#27 VICTIM control: the same tool as the SUBJECT still claims",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "oc-start fails to create the worktree"}))
    assert_true("#27 CONSUMER (#418): a tool named as a downstream consumer does "
                "not claim the domain",
                "tools" not in detect_issue_domains(
                    {"title": "", "body": "The consumers of this contract are "
                                          "mechanical fan-out tooling (oc-deploy fanout, #24)"}))
    assert_true("#27 CONSUMER control: the same tool as the SUBJECT still claims",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "oc-deploy fanout writes the wrong journal row"}))
    assert_true("#27 ANALOGY: a tool named only as an analogy's sibling does not "
                "claim the domain",
                "tools" not in detect_issue_domains(
                    {"title": "", "body": "the same defect class as oc-prchecks: the "
                                          "verdict never wakes the caller"}))
    assert_true("#27 ANALOGY control: the analogy's own subject still claims",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "oc-prchecks self-detaches and strands the verdict"}))
    assert_true("#27 NEGATION: a negated tool mention does not claim the domain",
                "tools" not in detect_issue_domains(
                    {"title": "", "body": "this is not oc-ledger work"}))
    assert_true("#27 NEGATION control: an un-negated mention still claims",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "oc-ledger writes a malformed roster row"}))
    assert_true("#27 control: a genuine surface claim survives every guard",
                "tools" in detect_issue_domains(
                    {"title": "fix(tools): oc-issue-dispatch grants the tools domain "
                              "for any resolved oc-* mention",
                     "body": "the culprit is tools/issue/oc-issue-dispatch"}))

    # #615: a HYPHENATED feature name tokenises into components, which is correct
    # for 8 of the 9 lanes it affects (`push-to-session`->notify,
    # `harvest-23units`->harvest, `rich-resume-guard`->telegram), so the hyphen
    # boundary is NOT the defect -- `options` is. It is ordinary English with a
    # large UI-feature collision surface, and it handed `suggest-options` (a
    # Telegram-UI lane) the `config` domain, on which token alone #606 -- an
    # src/config/profile.rs defect -- was dispatched to it.
    assert_true("#615: `suggest-options` no longer acquires the config domain",
                "config" not in _domains_for_text("suggest-options"))
    # CONTROLS -- each pins a match the removal must NOT have cost. Without these
    # the leg above passes for a keyword table that was simply emptied.
    assert_true("#615 control: `harvest-23units` still acquires harvest (the case "
                "that rules out closing the hyphen)",
                "harvest" in _domains_for_text("harvest-23units"))
    assert_true("#615 control: `#83 config-manager-warn` still acquires config via "
                "the literal component",
                "config" in _domains_for_text("#83 config-manager-warn (inline editor, watch)"))
    assert_true("#615 control: `push-to-session` still acquires notify",
                "notify" in _domains_for_text("push-to-session"))
    assert_true("#615 control: `cron-session-isolation` still acquires cron AND notify",
                {"cron", "notify"} <= _domains_for_text("cron-session-isolation"))
    assert_true("#615: `options` is absent from the config table (the removal is the fix)",
                "options" not in AFFINITY_KEYWORDS["config"])
    # Issue side: the 7 spurious `config` acquisitions measured live. #479 is a
    # db-topics issue whose body says "the options are ..." -- no config surface.
    assert_true("#615: a db-topics issue reaching config only via `options` loses it",
                "config" not in detect_issue_domains(
                    {"title": "fix(db): a forum's General topic and a DM are the same row",
                     "body": "the options are equivalent, so the row is shared"}))
    assert_true("#615 control: a real config issue still acquires config",
                "config" in detect_issue_domains(
                    {"title": "fix(config): types.rs drops the field", "body": ""}))
    # The adjacency requirement is what keeps an INSTRUCTION that names the
    # surface: a looser window would suppress this and lose a genuine mention.
    assert_true("#605: a negation with a verb between still names the surface",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "do not touch tools/lib/oc-notify.sh"}))
    # One occurrence negated, another not -> the domain still holds.
    assert_true("#605: a later un-negated occurrence still claims the domain",
                "tools" in detect_issue_domains(
                    {"title": "", "body": "not tools/lib/a.sh, but tools/lib/b.sh is the writer"}))
    # The prose class carries the same guard, and this is the pair that pins it.
    assert_true("#605: a negated prose token does not arm its domain",
                "harvest" not in detect_issue_domains(
                    {"title": "", "body": "no upstream PR implied by this"}))
    assert_true("#605: the un-negated prose form still arms it (control)",
                "harvest" in detect_issue_domains(
                    {"title": "", "body": "port this upstream"}))

    # #546: the bash vocabulary names the SHELL-TOOL surface, not generic English.
    # The pre-#546 list broke the -50 arm on BOTH sides: it fired on 156/163 open
    # issues, and 7 of the 9 armed lanes held the domain purely from an incidental
    # word in their own feature string. These legs pin the real feature strings.
    for _generic in ("rich-resume-guard",
                     "harvest retry-429 ladder",
                     "streaming-guard #105 transfer: rebase+gate feat/streaming-empty-finish-guard",
                     "#92 demoted-host guard",
                     "#438 local half - skill curation (compaction signal / token bound / mechanical shed)",
                     "TOOLSMITH lane: owns tools/ CLI (oc-ledger, oc-deploy, oc-prchecks)"):
        assert_true("#546: prose feature %r does NOT arm the bash domain" % _generic[:38],
                    "bash" not in _domains_for_text(_generic))
    for _shell in ("bash tool env carries no session identity",
                   "subshell env missing",
                   "tool-output spill dir has no retention policy",
                   "pipefail battery leg reports FAIL on a successful match"):
        assert_true("#546: shell surface %r DOES arm the bash domain" % _shell[:38],
                    "bash" in _domains_for_text(_shell))
    assert_true("#546: a lane naming the bash tool layer keeps the domain",
                "bash" in _domains_for_text(
                    "shared variation_directive() in nudge.rs, bash Layer 3 + loop-guard nudge"))
    assert_true("#546: generic prose issue does not gain the bash domain",
                "bash" not in detect_issue_domains(
                    {"title": "fix(telegram): normalise text-presentation glyphs in the flow chrome",
                     "body": "the phantom guard re-opens a turn and the retry loop repeats it"}))

    # Test 4: Selection when lane is busy.
    # Retargeted by #639 Wire C: the idle lane previously read "generic editor",
    # i.e. ZERO affinity, and a domain-bearing issue with no positive-affinity
    # lane is now refused (left queued) -- so the contrast this leg needs was
    # being supplied by the very behaviour Wire C removes. Both lanes now carry
    # the issue's domain, the busy one carries MORE of it, and the leg asserts
    # the busy lane is skipped anyway. The two assertions below pin that premise
    # so a future domain change reddens this leg instead of silently voiding it.
    lane_busy = {"uuid": "lane-busy", "feature": "telegram-buttons memory", "is_busy": True, "class": "ACTIVE"}
    lane_idle = {"uuid": "lane-idle", "feature": "telegram-buttons", "is_busy": False, "class": "IDLE"}
    assert_true("Test 4 premise: the idle lane has positive affinity for the issue",
                score_affinity(issue_tg, lane_idle) > 0)
    # Measured on the fixture: busy 43 (memory+telegram), idle 20 (telegram).
    assert_true("Test 4 premise: the busy lane scores strictly higher",
                score_affinity(issue_tg, lane_busy) > score_affinity(issue_tg, lane_idle))
    selected = select_best_lane(issue_tg, [lane_busy, lane_idle])
    assert_eq("Busy lane skipped even with higher affinity", selected["uuid"], "lane-idle")

