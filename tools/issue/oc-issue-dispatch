    # Test 6e (#390): the classify budget, and the degradation report.
    #
    # A stub `oc-roster` makes both arms deterministic. The stub `exec`s, so the
    # process `run_cmd` kills IS the sleeper -- without exec the kill lands on the
    # shell and the orphaned child keeps the stdout pipe open, which would make
    # the elapsed assertion below measure the stub's sleep instead of the budget.
    def _stub_roster(body):
        d = tempfile.mkdtemp()
        p = os.path.join(d, "oc-roster")
        with open(p, "w") as fh:
            fh.write("#!/bin/sh\n" + body + "\n")
        os.chmod(p, 0o755)
        return d

    _saved_tool_dir, _saved_roster_budget = TOOL_DIR, ROSTER_TIMEOUT_SECS
    try:
        # (A) the BUDGET governs the call: a 3s stub under a 1s budget is KILLED
        TOOL_DIR = _stub_roster("exec sleep 3")
        ROSTER_TIMEOUT_SECS = 1
        _out, _err = io.StringIO(), io.StringIO()
        _t0 = time.time()
        with contextlib.redirect_stdout(_out), contextlib.redirect_stderr(_err):
            _lanes = get_worker_roster(mock_ledger_classify_fail, mock_classify=None,
                                       mock_sessions={"lane-safety-1"},
                                       db_path="/tmp/nonexistent-db.sqlite")
        _elapsed = time.time() - _t0
        assert_true("#390 the classify budget governs the call (3s stub, 1s budget -> killed)",
                    _elapsed < 2.5)
        assert_true("#390 a killed classify is reported on STDOUT (countable by a cron)",
                    any(l.startswith(DEGRADED_MARKER) for l in _out.getvalue().splitlines()))
        assert_true("#390 ...and on STDERR (the stream it used to be alone on)",
                    any(l.startswith(DEGRADED_MARKER) for l in _err.getvalue().splitlines()))
        assert_true("#390 the report names the budget it exceeded",
