#!/usr/bin/env bash
# =============================================================================
# oc-issue-scope — body-surface scope classifier for factory-tracker issues
# =============================================================================
# Triage build order 2026-09-26. The factory-scoped patrol classifies ~180 open
# issues every cycle by reading each body for the file surface its fix lands on.
# That test was mechanized NOWHERE (grep body_surface|scope_classif|classify_scope
# across tools/ -> 0 hits), so every lane re-implemented it as an ad-hoc regex and
# THREE failure variants were hand-caught in ONE session:
#
#   1. TITLE-PREFIX — bucketing on fix(...) instead of the body surface. The owner
#      files every tool-related issue as `fix(tools):` whether the fix lands in
#      tools/** or src/brain/tools/**, so the prefix is a LABEL, not a surface.
#      Cost: #419/#471 wired out of scope (law fixed v0.4.236).
#   2. BARE-PREFIX NEGATION — #531's body reads
#      "- Surface: `src/tests/**` — Editor territory, not tools/**."
#      A bare token test matches `tools/**` and existence-testing `tools/`
#      returns TRUE (the directory exists), so a genuine src/** issue reads IN.
#   3. SUBSTRING — `src/brain/tools/registry.rs` CONTAINS `tools/`; #439's body
#      quotes exactly such a path from a log line. A substring test fires on a
#      path that is not at a path boundary.
#
# Usage: oc-issue-scope <N> [--json] [--repo <slug>] [--repo-path <dir>]
#        oc-issue-scope --open [--json] [--repo <slug>] [--repo-path <dir>]
#        oc-issue-scope --selftest
# Exit:  0 classified (IN or OUT) / 1 UNPINNED (no resolvable surface claim)
#        2 usage / 3 gh or git failed
# Emits: bucket (IN|OUT|UNPINNED -- the surface FACT) AND priority (1|2|3 -- the
#        ORDERING: 1 fix the factory, 2 fix the binary, 3 new features).
#
# TRACKER (two-stream routing, SKILL.md v0.4.284, owner order 2026-10-03): the
# DEFAULT repo is the FACTORY tracker leshchenko1979/opencrabs-dev-factory, whose
# open-issue population is the factory's own work units -- exactly what the
# factory-scoped patrol classifies. A BINARY issue (upstream adolfousier/opencrabs)
# is classified by passing --repo adolfousier/opencrabs. The historical fork
# leshchenko1979/opencrabs is READ-ONLY for new issues.
#
# THREE RULES, each measured before it was encoded:
#
# (a) POLARITY. A token inside a negation is not a surface claim. The window is
#     30 chars immediately before the token — MEASURED on the live corpus:
#   KNOWN LIMIT -- NOT mechanically resolvable, do not "fix" it by guessing:
#      #610 (fix(tools), body says only `src/**` as the AFFECTED POPULATION) and
#      #471 (fix(tools), body names NO path at all) are INDISTINGUISHABLE on
#      every signal here: same title scope, no concrete file claim, and the
#      correct buckets are OPPOSITE (IN vs OUT, Triage 2026-09-26). So a title
#      fallback on this shape is UNSAFE -- it would send #471 IN, which is
#      failure variant 1, the very pair (#419/#471) the scope law exists for.
#      Demoting globs is also unsafe: `Scope: tools/**` is a legitimate claim
#      (asserted by a selftest leg), and demoting it leaves #610 UNPINNED rather
#      than IN. The posture is therefore: bucket what the BODY proves, carry
#      title_disagrees=true, and let the patrol apply a mechanism override.
#     W<=40 suppresses exactly 3 tokens and ALL THREE are correct (#531 `tools/**`,
#     #359 `not in tools/`, #327 `excluding tools/tests/`), while W>=45 starts
#     eating REAL claims (#607 `tools/harvest/oc-harvest-census`, #343 `tools/**`,
#     #327 `tools/oc-harvest-census`) because a line-level negation test is not
#     local to the token. 30 sits mid-band. Do NOT widen it.
# (b) RESOLUTION. The token must resolve to a TRACKED path. The tracked index is
#     built once per repo, so a bare prefix that names nothing (e.g. tools/nope/)
#     is not evidence and is reported as unresolved rather than counted.
# (c) PATH BOUNDARY. The match must begin at a path start (`(?<![\w/.-])`), so
#     `src/brain/tools/registry.rs` yields `src/brain/tools/registry.rs` and never
#     a bare `tools/` inside it.
# (d) TOOL NAME (#616). A body naming a live `oc-*` tool is a surface claim too --
#     `oc-questions` IS tools/state/oc-questions -- and it is consulted ONLY when
#     the body carries no path claim, because a name is much weaker evidence: read
#     unconditionally it wired 11 src/** fixes to the tools lane (#299 quotes a
#     session's next-step text, #440 cites a "related defect", #531 calls one "the
#     CI-side twin of this defect", #457 names cron JOBS). A name resolving to no
#     live tool adds nothing, so the body stays UNPINNED. This is NOT a
#     title-prefix test: `fix(tools):` spans both repos, which is why #471 and
#     #405 name no live tool and correctly stay P2.
#
# The resolved path is always printed, so a reader can check the verdict rather
# than trust it. The TITLE scope is reported as CONTEXT and never decides the
# bucket — that is failure variant 1, and --json carries a `title_disagrees` flag
# so the patrol sees the #419/#471 shape the moment it recurs.
#
# -----------------------------------------------------------------------------
# PRIORITY TIER (owner order 2026-09-26, verbatim):
#   "I want to amend the in / out rule. Let there be priorities:
#    1. Fix the factory  2. Fix the binary  3. New features"
#
# The BUCKET above is the surface FACT and is unchanged; `priority` is the
# ORDERING layered on it. Both are emitted (--json carries `bucket` AND
# `priority`), so a consumer that keys on the surface keeps working.
#
#   P1  fix-typed, bucket IN          the factory surface (tools/**, .github)
#   P2  fix-typed, bucket != IN       src/** — the daemon
#   P3  feat-typed, ANY bucket        a new feature
#
# Non-fix/non-feat types (docs/chore/test/refactor, and a title carrying no type
# token at all) follow the SURFACE rule: IN -> P1, else P2. The tier is TOTAL and
# EXCLUSIVE — every issue gets exactly one, and a lower tier is DEPRIORITISED,
# never excluded. Order: P1 first; P2 only when P1 has no dispatchable residue;
# P3 last.
#
# THE EDGE CASE the definition settles and a naive implementation gets wrong: a
# feat-typed issue ON the factory surface is P3, NOT P1 — priority 1 is "fix the
# factory", and a new factory feature is a new feature. Live specimens: #393
# (feat(notify), tools/**), #318 and #278 all bucket IN and all read P3.
# Specimen over the live corpus: P1 16 · P2 149 · P3 16 = 181.
# =============================================================================
set -u

_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-issue-scope" "$@"; else oc_log_finish() { :; }; oc_log_extra() { :; }; fi

FACTORY_REPO="leshchenko1979/opencrabs-dev-factory"
SRC_REPO_PATH="${OC_SRC_REPO:-/root/opencrabs}"
SKILL_REPO_PATH="$(cd "$OC_TOOLS_DIR/.." && pwd)"

usage() { sed -n '/^# Usage:/,/^# Exit:/p' "$0" | sed 's/^# \{0,1\}//'; }

N=""; MODE="one"; JSON=0; REPO="$FACTORY_REPO"; RPATH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --open) MODE="open"; shift ;;
    --selftest) MODE="selftest"; shift ;;
    --json) JSON=1; shift ;;
    --repo) [ $# -ge 2 ] || { echo "oc-issue-scope: --repo needs a value" >&2; usage; exit 2; }; REPO=""$2""; shift 2 ;;
    --repo-path) [ $# -ge 2 ] || { echo "oc-issue-scope: --repo-path needs a value" >&2; usage; exit 2; }; RPATH=""$2""; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    -*) echo "oc-issue-scope: unknown flag $1" >&2; exit 2 ;;
    *) N="$1"; shift ;;
  esac
done
[ -n "$RPATH" ] && SRC_REPO_PATH="$RPATH"

# --- selftest (tests the SHIPPED classifier by marker) ----------------------
if [ "$MODE" = "selftest" ]; then
python3 - "$0" <<'PYEOF'
import sys
src = open(sys.argv[1], encoding='utf-8').read()
ns = {}
_B = '# --- CLASSIFIER ' + 'BEGIN ---'   # built, not typed: the literal would self-match below
_E = '# --- CLASSIFIER ' + 'END ---'
exec(compile(src[src.index(_B):src.index(_E)], 'classifier', 'exec'), ns)
ok = bad = 0
def ck(name, cond):
    global ok, bad
    if cond: print(f"  ok   - {name}"); ok += 1
    else:    print(f"  FAIL - {name}"); bad += 1
T = ns['build_index']([('skill','tools/lib/oc-notify.sh'), ('skill','tools/tests/run.sh'),
                       ('src','src/tests/x.rs'), ('src','.github/workflows/ci.yml')])
ext, claims, bucket, classify = ns['extract'], ns['claims'], ns['bucket'], ns['classify']

ck('boundary: src/brain/tools/registry.rs yields the WHOLE path (variant 3)',
   ext('src/brain/tools/registry.rs') == ['src/brain/tools/registry.rs'])
ck('boundary: a real tools path still extracts', 'tools/lib/x.sh' in ext('see tools/lib/x.sh'))
ck('polarity window is 30 (measured mid-band; W>=45 eats real claims)', ns['NEG_WIN'] == 30)

b531 = '- Surface: `src/tests/**` — Editor territory, not tools/**.'
ck('NEGATION: #531 yields no tools claim (variant 2)',
   not any(t.startswith('tools/') for t in claims(b531, T)))
ck('  and #531 buckets OUT', bucket(b531, T)[0] == 'OUT')

cl = claims('Scope: `tools/**`, excluding `tools/tests/`.', T)
ck('sub-path negation: exclusion dropped, surface kept', 'tools/**' in cl and 'tools/tests/' not in cl)
ck('  and that body buckets IN', bucket('Scope: `tools/**`, excluding `tools/tests/`.', T)[0] == 'IN')

cl = claims('written by `oc-ledger sync` (`tools/oc-ledger`:532), not in `tools/`.', T)
ck('local window: tools/oc-ledger kept, bare tools/ suppressed', 'tools/oc-ledger' in cl and 'tools/' not in cl)

# ANALOGY is not a surface claim. #387's ONLY tools token is a sibling-defect
# comparison while its own Fix section names src/cli/args.rs; bucketing it IN
# would wire an src/** fix to the tools lane.
b387 = ('This is the same defect class as `tools/lib/oc-notify.sh` accepting the '
        'retired mode. Source: `src/tests/x.rs`.')
ck('ANALOGY: #387 yields no tools claim (its token names a sibling defect)',
   not any(t.startswith('tools/') for t in claims(b387, T)))
ck('  and #387 buckets OUT on the real fix surface', bucket(b387, T)[0] == 'OUT')
# POSITIVE CONTROL: the same token OUTSIDE an analogy frame must still claim, or
# the rule has eaten the surface it was meant to leave alone.
ck('ANALOGY control: the same token without the frame still claims IN',
   any(t.startswith('tools/') for t in claims('Fix: `tools/lib/oc-notify.sh`:12.', T)))
ck('analogy demotes ONLY the compared object (gap 8)',
   ns['ANALOG_GAP'] == 8)
# The tightening's own negative direction: a fix surface named RIGHT AFTER the
# analogy sentence must survive, or the rule eats the surface it exists to leave.
b387b = ('This is the same defect class as `tools/lib/oc-notify.sh` accepting the '
         'retired mode. Source: `src/tests/x.rs`.')
ck('ANALOGY does not eat a following fix surface', 'src/tests/x.rs' in claims(b387b, T))

# VICTIM is not a surface claim (#678). #530's body names `oc-start` ONLY as the
# thing a false defect was filed against; its real surface is the src/** render
# path. The polarity window (30 chars) does not see this frame -- neither `not`
# nor `never` is in "filing a false defect against" -- so the fallback resolved
# tools/git/oc-start, bucketed an src/** unit INTO the factory tier, and its
# domains ({notify, telegram, skills, db, mermaid}) contain no `tools`, so the
# lane that owns tools/** could never match: a dispatchable unit turned
# unroutable. Measured: the frame appears in 7 of 209 corpus bodies.
# NOTE the token is `oc-notify`, NOT #530's `oc-start`: the selftest's index T
# carries only four fixture pairs, so `oc-start` would resolve to nothing and
# these legs would pass WITHOUT the gate -- the vacuous-leg trap. `oc-notify` IS
# in T, so the gate is the only thing that can suppress it.
b530 = ('Cost observed today: this lane came one step from filing a '
        '**false defect against `oc-notify`**, because the claim text rendered a '
        'branch name that does not exist.')
ck('VICTIM: the token is the REPORTED-AGAINST object, not a surface claim',
   claims(b530, T) == [])
ck('  and that body is not bucketed IN on it', bucket(b530, T)[0] != 'IN')
# DISCRIMINATOR: the identical sentence with the frame REMOVED must claim, so
# the leg above cannot be satisfied by a body that simply names nothing live.
b530_noframe = ('Cost observed today: this lane came one step from touching '
                '`oc-notify`, because the claim text rendered a branch name.')
ck('VICTIM control: the same sentence WITHOUT the frame still claims',
   any(t.startswith('tools/') for t in claims(b530_noframe, T)))
ck('victim demotes ONLY the attached object (gap 14)', ns['VICTIM_GAP'] == 14)
# The frame must not eat a REAL surface sitting right after it: the attached
# object is demoted, a later claim is not.
b530b = ('One step from filing a false defect against `oc-notify`. Fix: `tools/tests/run.sh`.')
ck('VICTIM does not eat a following fix surface',
   any(t.startswith('tools/tests/') for t in claims(b530b, T)))

ck('resolution: a bare prefix naming nothing is not evidence', claims('see tools/nope/here.sh', T) == [])
ck('UNPINNED: no path token at all', bucket('nothing to see here', T)[0] == 'UNPINNED')
ck('UNPINNED: token resolves nowhere', bucket('see tools/nope/x.sh', T)[0] == 'UNPINNED')
ck('IN: real tracked tools file', bucket('see tools/lib/oc-notify.sh', T)[0] == 'IN')
ck('OUT: src/ path with no factory claim', bucket('see src/tests/x.rs', T)[0] == 'OUT')
ck('IN: .github/workflows resolves', bucket('see .github/workflows/ci.yml', T)[0] == 'IN')

v, r, c, dis = classify('fix(tools): x', 'Surface: src/tests/**', T)
ck('TITLE-PREFIX: fix(tools) title + src body buckets OUT (variant 1)', v == 'OUT')
ck('  and the disagreement is FLAGGED for the patrol', dis is True)
v, r, c, dis = classify('fix(tools): x', 'Surface: `tools/lib/y.sh`', T)
ck('TITLE agrees with body -> not flagged', v == 'IN' and dis is False)

ck('rc contract: single UNPINNED is the rc-1 verdict (documented in the header)',
   ns['bucket']('no paths here', T)[0] == 'UNPINNED')

# --- PRIORITY TIER (owner order 2026-09-26) ---------------------------------
# "1. Fix the factory  2. Fix the binary  3. New features". The two legs the
# build order names as THE rule are first, in both directions.
pri, typ = ns['priority'], ns['type_of']
ck('PRIORITY: a feat-typed IN issue reads P3, not P1 (the edge case)',
   pri('feat(notify): x', 'IN') == 3)
ck('PRIORITY: a fix-typed OUT issue reads P2, not P1',
   pri('fix(agent): x', 'OUT') == 2)
ck('  and fix-typed IN reads P1 (fix the factory)', pri('fix(tools): x', 'IN') == 1)
ck('  and feat-typed OUT still reads P3', pri('feat(agent): x', 'OUT') == 3)
ck('  and fix-typed UNPINNED reads P2 (deprioritised, never excluded)',
   pri('fix(x): no paths here', 'UNPINNED') == 2)
ck('surface rule: an UNTYPED IN issue reaches P1 (no type token, still factory)',
   pri('tools: multi-line python bodies', 'IN') == 1)
ck('surface rule: an untyped OUT issue reads P2', pri('Stale doc comment on X', 'OUT') == 2)
ck('bug is fix-typed (its IN reads P1)', pri('bug(logging): x', 'IN') == 1)
ck('type_of reads the scope form and the bare form',
   typ('fix(tools): x') == 'fix' and typ('tools: x') == 'tools'
   and typ('Stale doc comment') == '' and typ('feat(db): x') == 'feat')
ck('tier is TOTAL and exclusive: every (type, bucket) gets exactly one tier',
   all(pri(f'{t}: x', b) in (1, 2, 3)
       for t in ('fix', 'feat', 'bug', 'test', 'docs', 'chore', 'refactor', 'tools', '')
       for b in ('IN', 'OUT', 'UNPINNED')))

# --- #616: a live TOOL NAME is a surface claim, a PATH outranks it -----------
# The fallback fires ONLY when the body carries no path claim. Measured over 184
# live issues: consulting names unconditionally flipped ELEVEN src/** fixes to
# the tools lane (#299 quotes "dispatch `oc-deploy ship`" from a session's
# next-step text; #440 cites a "related defect"; #531 calls one "the CI-side twin
# of this defect"; #457 names cron JOBS), while the seven legitimate ones name a
# tool and NO path. The fixture T carries `oc-notify` (tools/lib/oc-notify.sh).
ck('TOOL NAME: a name-only body resolves to its tracked path (#616)',
   bucket('Symptom. `oc-notify` composes a body naming the asking lane.', T)[:2]
   == ('IN', 'tools/lib/oc-notify.sh'))
ck('  and a name-only body with a NON-existent tool stays UNPINNED (control)',
   bucket('see `oc-nonexistent` for details', T)[0] == 'UNPINNED')
ck('  a PATH outranks an incidental tool name (the 12-issue class)',
   bucket('Fix: `src/tests/x.rs`. Same defect class as `oc-notify`.', T)[:2]
   == ('OUT', 'src/tests/x.rs'))
ck('  polarity applies to a name too (`not oc-notify` claims nothing)',
   bucket('this is not `oc-notify` at all', T)[0] == 'UNPINNED')
ck('  an incidental name beside a path does NOT reach the claims list',
   'tools/lib/oc-notify.sh' not in claims('Fix: `src/tests/x.rs`, unlike `oc-notify`.', T))

print(f"\n{'='*30}\n  PASS: {ok}   FAIL: {bad}")
sys.exit(1 if bad else 0)
PYEOF
exit $?
fi

# --- gather -----------------------------------------------------------------
command -v gh >/dev/null 2>&1 || { echo "oc-issue-scope: gh not found" >&2; exit 3; }
TMPD="$(mktemp -d)"; trap 'rm -rf "$TMPD"; oc_log_finish $?' EXIT
{
  git -C "$SKILL_REPO_PATH" ls-files 2>/dev/null | sed 's/^/skill\t/'
  [ -d "$SRC_REPO_PATH/.git" ] && git -C "$SRC_REPO_PATH" ls-files 2>/dev/null | sed 's/^/src\t/'
} > "$TMPD/index"
[ -s "$TMPD/index" ] || { echo "oc-issue-scope: no tracked paths (skill=$SKILL_REPO_PATH src=$SRC_REPO_PATH)" >&2; exit 3; }

if [ "$MODE" = "open" ]; then
  gh issue list -R "$REPO" --state open --limit 400 --json number,title,body > "$TMPD/payload" 2>/dev/null || exit 3
else
  [ -n "$N" ] || { usage >&2; exit 2; }
  case "$N" in ''|*[!0-9]*) echo "oc-issue-scope: <N> must be an issue number" >&2; exit 2 ;; esac
  gh issue view "$N" -R "$REPO" --json number,title,body 2>/dev/null > "$TMPD/one" || exit 3
  [ -s "$TMPD/one" ] || { echo "oc-issue-scope: issue $N not found in $REPO" >&2; exit 3; }
  printf '[%s]' "$(cat "$TMPD/one")" > "$TMPD/payload"
fi

python3 - "$0" "$TMPD/index" "$TMPD/payload" "$JSON" "$MODE" <<'PYEOF'
import json, sys
src = open(sys.argv[1], encoding='utf-8').read()
ns = {}
_B = '# --- CLASSIFIER ' + 'BEGIN ---'   # built, not typed: the literal would self-match below
_E = '# --- CLASSIFIER ' + 'END ---'
exec(compile(src[src.index(_B):src.index(_E)], 'classifier', 'exec'), ns)
T = ns['build_index']((l.split('\t', 1)[0], l.split('\t', 1)[1])
                      for l in open(sys.argv[2], encoding='utf-8') if '\t' in l)
issues = json.load(open(sys.argv[3], encoding='utf-8'))
as_json, mode = sys.argv[4] == '1', sys.argv[5]

rows = []
for it in issues:
    v, res, claims, dis = ns['classify'](it.get('title') or '', it.get('body') or '', T)
    ttl = it.get('title') or ''
    rows.append({'number': it['number'], 'title': ttl[:70],
                 'bucket': v, 'resolved': res, 'claims': claims,
                 'type': ns['type_of'](ttl),
                 'priority': ns['priority'](ttl, v),
                 'title_disagrees': dis})

if as_json:
    print(json.dumps(rows if mode == 'open' else rows[0], indent=2))
elif mode == 'open':
    from collections import Counter
    c = Counter(r['bucket'] for r in rows)
    p = Counter(r['priority'] for r in rows)
    print(f"oc-issue-scope: {len(rows)} open issue(s) — "
          f"P1 {p[1]} · P2 {p[2]} · P3 {p[3]}")
    print(f"  (surface: IN {c['IN']} · OUT {c['OUT']} · UNPINNED {c['UNPINNED']})\n")
    for tier, label in ((1, 'P1 — fix the factory'), (2, 'P2 — fix the binary'),
                        (3, 'P3 — new features')):
        grp = [r for r in rows if r['priority'] == tier]
        if not grp: continue
        print(f"{label} ({len(grp)})")
        for r in grp:
            flag = '  [TITLE-DISAGREES]' if r['title_disagrees'] else ''
            print(f"  #{r['number']:<5} {r['type'] or '-':<6} {r['bucket']:<9} "
                  f"{r['resolved'] or '-':<38}{flag}")
        print()
    print("TITLE-DISAGREES = the fix(...) prefix names a different surface than the")
    print("body does. That is the #419/#471 shape; the BODY decides the bucket.")
    print("Priority: 1 fix the factory · 2 fix the binary · 3 new features.")
else:
    r = rows[0]
    print(f"#{r['number']}  {r['bucket']}  P{r['priority']}")
    print(f"  type:     {r['type'] or '(none)'}")
    print(f"  resolved: {r['resolved'] or '(none)'}")
    print(f"  claims:   {', '.join(r['claims']) if r['claims'] else '(none)'}")
    if r['title_disagrees']:
        print("  NOTE: the title's fix(...) prefix disagrees with the body surface — the body decides.")
sys.exit(0 if mode == 'open' else (1 if rows[0]['bucket'] == 'UNPINNED' else 0))
PYEOF

