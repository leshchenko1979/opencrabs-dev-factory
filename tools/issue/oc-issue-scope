# reads "This is the same defect class as `tools/oc-notify-fanout` accepting the
# retired mode" while its own Fix section names src/cli/args.rs -- so the token
# names a SIBLING DEFECT, not the surface. Measured: suppressing it flips #387
# IN -> OUT and changes NO other issue of 181 (the frame is rare and explicit).
ANALOG = re.compile(r'(?i)\b(same\s+\w*\s*(?:defect\s+)?class\s+as|same\s+as|'
                    r'analogous\s+to|compare\s+with|like\s+the\s+way)\b')
# Only the COMPARED OBJECT is demoted -- the single token right after the frame.
# A lookback WINDOW is wrong here and measurably so: on a body where the real fix
# surface follows the analogy closely, a 90-char window suppressed BOTH, so the
# fixture lost its src claim and the tool read the body as having no claim at all.
ANALOG_GAP = 8
# #678: a path named as the VICTIM of a defect report is not the SURFACE. The
# polarity gate (NEG, above) reads the 30 chars before a token, but #530's frame
# is "filing a **false defect against `oc-start`**" -- neither `not` nor `never`
# is in it, so the token passed, resolved to tools/git/oc-start, and bucketed the
# whole unit INTO the factory tier while its real surface is src/**. Measured on
# a real corpus read: the frame is RARE AND EXPLICIT -- 7 of 209 bodies carry it,
# and only #530 and #455 have a tool token adjacent, both naming the tool in
# exactly this reporting sense. Same shape as ANALOG directly above: suppress
# only the token the frame ATTACHES to, never a lookback window (a window is
# measurably wrong here -- it suppressed an unrelated real claim in the fixture
# that motivated ANALOG_GAP).
VICTIM = re.compile(r'(?i)\b(?:false\s+defect|defect\s+report|falsely\s+attribut\w*'
                    r'|filed\s+against|reported\s+(?:on|against)'
                    r'|unrelated\s+to|blam(?:e|ed|ing)\s+(?:on|against))')
VICTIM_GAP = 14
FACTORY = ('tools/', '.github/workflows/')
SCOPE_IN_TITLE = re.compile(r'(?i)^\s*(?:fix|feat|bug|test|docs|chore)\s*\(([^)]*)\)')

def build_index(pairs):
    """(repo, tracked-path) pairs -> {dir/: repo} plus {dir/ + ext: repo}.

    The EXTENSION map is what rejects a truncated log path. `tools/registry.rs`
    names a directory that exists (tools/) with an extension that does not exist
    anywhere beneath it -- tools/ holds only .sh/.md/.py/.mjs/.json, because the
    real file is `src/brain/tools/registry.rs`. Without this check a quoted log
    line reads as a surface claim, which is failure variant 3 (#439).
    """
    idx = {}
    for repo, p in pairs:
        p = p.strip()
        if not p: continue
        idx.setdefault(p, repo)
        parts = p.split('/')
        for i in range(1, len(parts)):
            idx.setdefault('/'.join(parts[:i]) + '/', repo)
        if len(parts) > 1 and '.' in parts[-1]:
            ext = '.' + parts[-1].rsplit('.', 1)[1]
            idx.setdefault('/'.join(parts[:-1]) + '/' + ext, repo)
        # (#616) a TOOL NAME resolves to its tracked path. Recorded from the
        # pairs already in hand -- no extra git call. Path keys always contain
        # '/', name keys never do, so the two namespaces cannot collide. The
        # basename must BE the tool (oc-x.sh -> oc-x), never a suffix of it.
        base = parts[-1]
        stem = base.rsplit('.', 1)[0] if '.' in base else base
        if '/' in p and p.startswith('tools/') and re.fullmatch(r'oc-[a-z0-9][a-z0-9-]*', stem):
            idx.setdefault(stem, p)
    return idx

def _clean(tok):
    return tok.rstrip('.,;:)!?\"\'`')   # sentence punctuation is not part of a path

def extract(text):
    return [_clean(m.group(1)) for m in TOK.finditer(text)]

def _own_dir(tok):
    """The directory a token SITS IN, or itself when it names a directory/glob."""
    if tok.endswith('/') or any(ch in tok for ch in '*?'):
        return tok.rstrip('*').rstrip('/') + '/'
    parts = [x for x in tok.split('/') if x]
    return '/'.join(parts[:-1]) + '/' if len(parts) > 1 else ''


def _resolves(tok, T):
    """(dir, repo) when the token's OWN directory is tracked, else (None, None).

    Deliberately NOT a walk to the deepest tracked ancestor: that would make
    `tools/nope/here.sh` resolve to `tools/` and read as a claim. The token's own
    directory must exist -- a lane naming a file it is about to create still
    names the surface it lands on (`tools/lib/y.sh` -> tracked `tools/lib/`),
    while a path under a directory that does not exist is not evidence.
    """
    d = _own_dir(tok)
    if not d or d not in T: return None, None
    tail = tok.rstrip('/').rsplit('/', 1)[-1]
    if '.' in tail and not any(ch in tail for ch in '*?'):
        ext = '.' + tail.rsplit('.', 1)[1]
        if d + ext not in T:            # (b) the extension must exist THERE
            return None, None
    return d, T[d]


def _is_evidence(tok):
    """A token is a SURFACE CLAIM only if it is specific enough to be one.

    Requirement (b): a bare directory prefix is not evidence. `tools/` alone is
    a generic reference -- it resolves because the directory exists, which is
    exactly the trap that let #531's negated mention read as a claim. So a
    single-segment directory is NOT evidence; a glob, a path with 2+ segments,
    or a tracked FILE is.
    """
    if any(ch in tok for ch in '*?'): return True
    # The regex requires a '/', so a 1-segment token is always a bare directory.
    return len([x for x in tok.strip('/').split('/') if x]) >= 2

def claims(body, T):
    """Non-negated tokens that RESOLVE to tracked paths, in body order.

    PATHS first, and a TOOL NAME (#616) only when the body carries NO path claim
    at all. That precedence is measured, not stylistic: a name is much weaker
    evidence than a path, and consulting it unconditionally wired ELEVEN src/**
    fixes to the tools lane -- #299 quotes "dispatch `oc-deploy ship`" from a
    session's next-step text, #440 cites a "related defect" by tool name, #531
    calls one "the CI-side twin of this defect", #457 names cron JOBS, #344/#567
    cite a tool as EVIDENCE, #572/#418 name CONSUMERS. Every one of those bodies
    already carries a real src/ path, so the fallback never fires for them, while
    the seven legitimate ones (#612, #312, #363, #417, #551, #573, #530) name a
    tool and NO path -- the name is the only surface signal there is.
    A name contributes its TRACKED PATH, so the FACTORY prefix test buckets it
    with no new branch; a name resolving to no live tool contributes nothing.
    """
    out = []
    # (a2) COMPARISON is not a claim: the object of an analogy names a SIBLING
    # defect. Suppress only the token immediately following the frame.
    cmp_ends = [m.end() for m in ANALOG.finditer(body)]
    vic_ends = [m.end() for m in VICTIM.finditer(body)]

    def _gated(pos):
        """The token-shape gates, shared by both kinds."""
        if NEG.search(body[max(0, pos - NEG_WIN):pos]):        # (a) POLARITY
            return False
        if any(0 <= pos - e <= ANALOG_GAP for e in cmp_ends):  # (a2) ANALOGY
            return False
        # (a3) VICTIM: the token is what a defect was REPORTED AGAINST. Attached
        # to the frame only -- #530 and #455 name a tool this way; a body that
        # names a path as the thing being fixed has no such frame before it.
        return not any(0 <= pos - e <= VICTIM_GAP for e in vic_ends)

    for m in TOK.finditer(body):
        if not _gated(m.start()):
            continue
        tok = _clean(m.group(1))
        d, repo = _resolves(tok, T)                           # (b) RESOLUTION
        if d and _is_evidence(tok) and tok not in out:
            out.append(tok)
    if out:
        return out
    # FALLBACK: no path claim anywhere, so a live tool name is the only surface
    # evidence the body offers. Same gates, so `not oc-smoke` stays silent.
    for m in TOOLNAME.finditer(body):
        if not _gated(m.start()):
            continue
        p = T.get(m.group(1))
        if p and p not in out:
            out.append(p)
    return out

def bucket(body, T):
    cl = claims(body, T)
    if not cl:
        return 'UNPINNED', None, cl
    fac = [c for c in cl if c.startswith(FACTORY)]
    return ('IN' if fac else 'OUT'), (fac[0] if fac else cl[0]), cl

def classify(title, body, T):
    """(bucket, resolved, claims, title_disagrees). The BODY decides the bucket."""
    v, res, cl = bucket(body, T)
    dis = False
    m = SCOPE_IN_TITLE.match(title or '')
    if m:
        scope = m.group(1).strip().lower()
        title_in = any(scope.startswith(d.rstrip('/')) for d in FACTORY)
        dis = (title_in != (v == 'IN'))
    return v, res, cl, dis

# --- PRIORITY TIER (owner order 2026-09-26) ---------------------------------
# Owner, verbatim: "I want to amend the in / out rule. Let there be priorities:
#   1. Fix the factory  2. Fix the binary  3. New features"
# The BUCKET stays the surface FACT (other legs consume it); the TIER is the
# ORDERING. Total and exclusive -- every issue gets exactly one tier, and a
# lower tier is DEPRIORITISED, never excluded.
TYPE_RE = re.compile(r'(?i)^\s*([a-z]+)\s*(?:\([^)]*\))?\s*[:!]')
FIX_TYPES = ('fix', 'bug')          # the ACT of fixing

def type_of(title):
    """The conventional type token of a title, or '' when it carries none."""
    m = TYPE_RE.match(title or '')
    return m.group(1).lower() if m else ''

def priority(title, bucket_v):
    """1 = fix the factory, 2 = fix the binary, 3 = new features.

    A feat-typed issue ON the factory surface is P3, NOT P1: priority 1 is
    "fix the factory", and a new factory feature is a new feature. Live
    specimens the rule settles: #393/#318/#278 all bucket IN and all read P3,
    while #433 (fix, IN) reads P1 and #378 (feat, OUT) reads P3.

    fix-typed and non-fix/non-feat COLLAPSE to the same expression by design --
    both are "1 if the surface is the factory else 2". The branch is written
    separately below only so a reader can see the fix-typed case was considered
    rather than lost: measured over 181 open issues, the tier is INSENSITIVE to
    whether `bug` counts as fix-typed (all three bug-typed issues are UNPINNED,
    so they read P2 either way).
    """
    if type_of(title) == 'feat':
        return 3
    return 1 if bucket_v == 'IN' else 2
