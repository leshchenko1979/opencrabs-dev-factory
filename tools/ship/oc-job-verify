#!/usr/bin/env bash
# =============================================================================
# oc-job-verify — verify a quick-build run's identity + outcome BEFORE trusting it.
#
#   Under carrier dispatch, run headSha = carrier branch tip — NEVER the built
#   tree. The ONLY identity anchor is the JOB NAME embed "(<full-sha>, <features>)"
#   baked by the quick-build workflow (job/artifact names). This tool enforces
#   that embed against the expected source_ref. (Carrier lesson, codified.)
#
# Checks (each a hard gate):
#   1. RUN EXISTS  — gh run view resolves the run id              (else exit 5)
#   2. OUTCOME      - status completed? conclusion success?       (else 2 / 3)
#   3. IDENTITY     - job-name embed contains <source_ref> + all requested
#                     features; headSha is EXPECTED to be the carrier tip and
#                     is reported but never trusted                 (else exit 4)
#
# Exit codes: 0 VERIFIED | 1 invocation | 2 IN-FLIGHT (still running) |
#             3 FAILED (conclusion != success) | 4 REF-MISMATCH | 5 RUN-NOT-FOUND
#
# --identity-only: skip the OUTCOME gates (2/3) — verify ONLY the job-name
#   identity embed. Works on any terminal run regardless of conclusion; use
#   for provenance of RED runs (which build sha produced this failure?).
#
# Deps: gh (authenticated for the fork), jq.
# =============================================================================
# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-job-verify" "$@"; else oc_log_finish() { :; }; fi
_OC_EMBED="$OC_TOOLS_DIR/lib/oc-embed.sh"
[ -f "$_OC_EMBED" ] && source "$_OC_EMBED"   # single embed decoder (E2 finding 3, v0.4.72)
trap 'oc_log_finish $?' EXIT

REPO="${OC_REPO:-leshchenko1979/opencrabs}"
WAIT=0            # 0 = no polling; N = poll every 15s up to N seconds
FEATURES=""
JSON_OUT=0
IDENTITY_ONLY=0
VERBOSE=0

fail() { echo "oc-job-verify: $2" >&2; exit "$1"; }
say()  { [ "$VERBOSE" = 1 ] && echo "$*" >&2 || true; }

usage() { # C-#3: --help/-h answers 0 on STDOUT; a usage error keeps this tool's LEGACY rc 1 on STDERR
  # Deliberately does NOT exit: the callers choose the rc (this register's usage
  # error is 1, not the fleet's 2 -- RC-CONTRACT legacy row), so only the STREAM
  # is selected here. #748a: `--help` was rc=0 with the text on STDERR, so
  # `oc-job-verify --help | grep` found nothing while the rc leg stayed green.
  local fd=2
  [ "${1:-1}" = 0 ] && fd=1
  echo "Usage: oc-job-verify <run-id> <source-ref-40hex> [--features SET] [--wait N] [--repo R] [--json] [--identity-only] [--verbose] [--selftest]" >&$fd
  echo "Exit: 0 VERIFIED | 1 invocation | 2 IN-FLIGHT | 3 FAILED | 4 REF-MISMATCH | 5 RUN-NOT-FOUND" >&$fd
}

selftest() {
  local passed=0 total=15 rc d perr jout
  d="$(mktemp -d)"
  # gh is stubbed on PATH: the stub picks its payload from the --json value the
  # tool asks for, so every gate below runs with no network and no remote.
  mkdir -p "$d/bin"
  printf '%s\n' '#!/bin/sh' \
    '[ "${STUB_VIEW_FAIL:-0}" = "1" ] && [ "$1" = run ] && [ "$2" = view ] && exit 1' \
    'json=""; prev=""' \
    'for a in "$@"; do' \
    '  if [ "$prev" = "--json" ]; then json="$a"; break; fi' \
    '  prev="$a"' \
    'done' \
    'case "$json" in' \
    '  jobs)    printf "%s\n" "$STUB_JOBS" ;;' \
    '  status*) printf "%s\n" "$STUB_VIEW" ;;' \
    'esac' \
    'exit 0' > "$d/bin/gh"
  python3 -c 'import os,sys; os.chmod(sys.argv[1],0o755)' "$d/bin/gh" 2>/dev/null \
    || chmod +x "$d/bin/gh"

  local ref="aaaaaaaabbbbbbbbccccccccddddddddeeeeeeee"
  local head="ffffffffffffffffffffffffffffffffffffffff"   # carrier tip, never identity
  local other="9999999999999999999999999999999999999999"
  local run="32982457449"

  # (1-4) ARG SHAPE — unchanged, and still the only legs needing no fixture.
  "$0" >/dev/null 2>&1;                                rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))
  "$0" abc "$ref" >/dev/null 2>&1;                     rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))
  "$0" "$run" shortsha >/dev/null 2>&1;                rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))
  "$0" "$run" >/dev/null 2>&1;                         rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))

  # (5) RUN-NOT-FOUND — gh cannot resolve the run -> rc 5
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW_FAIL=1 "$0" "$run" "$ref" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 5 ] && grep -qF 'not found on' <<< "$perr" && passed=$((passed+1))

  # (6) IN-FLIGHT — status is not completed and no --wait -> rc 2
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"in_progress\",\"conclusion\":null,\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS='{"jobs":[]}' "$0" "$run" "$ref" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 2 ] && grep -qF 'IN-FLIGHT' <<< "$perr" && passed=$((passed+1))

  # (7) FAILED — completed but conclusion != success -> rc 3
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"failure\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS='{"jobs":[]}' "$0" "$run" "$ref" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 3 ] && grep -qF 'FAILED' <<< "$perr" && passed=$((passed+1))

  # (8-10) IDENTITY — three distinct rc-4 arms. All three return 4, so each leg
  # asserts the gate's OWN message; rc alone could not tell them apart.
  # (8) no job name carries an embed at all
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS='{"jobs":[{"name":"ORDER gates"}]}' "$0" "$run" "$ref" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 4 ] && grep -qF 'embed found in job names' <<< "$perr" && passed=$((passed+1))
  # (9) embed present, sha is a DIFFERENT ref
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"ship / Linux amd64 ($other, telegram,code-graph)\"}]}" \
    "$0" "$run" "$ref" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 4 ] && grep -qF 'job embed sha' <<< "$perr" && passed=$((passed+1))
  # (10) sha matches, a REQUESTED FEATURE is absent from the embed
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"ship / Linux amd64 ($ref, telegram)\"}]}" \
    "$0" "$run" "$ref" --features telegram,code-graph 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 4 ] && grep -qF 'missing requested' <<< "$perr" && passed=$((passed+1))

  # (11) VERIFIED — sha and every requested feature present -> rc 0
  jout="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"ship / Linux amd64 ($ref, telegram,code-graph)\"}]}" \
    "$0" "$run" "$ref" --features telegram,code-graph --json 2>/dev/null)"
  rc=$?
  [ "$rc" = 0 ] && grep -qF '"verified": true' <<< "$jout" && passed=$((passed+1))

  # (12) --identity-only on a RED run -> rc 0: the whole point of the flag is to
  # answer "which sha produced this failure?" without the outcome gates firing.
  PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"failure\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"ship / Linux amd64 ($ref, telegram)\"}]}" \
    "$0" "$run" "$ref" --identity-only >/dev/null 2>&1; rc=$?
  [ "$rc" = 0 ] && passed=$((passed+1))

  # (13-14) GATE MODE (factory #34) — a gate run carries NO two-field build-job
  # embed: its build job is SKIPPED, so that name renders as the literal
  # "gate / Linux amd64 (${{ inputs.source_ref }}, ${{ inputs.features }})" and
  # the ONLY 40-hex in the run is the bare "(<sha>)" on the gates job. Pass 2
  # must resolve it; the two-field embed stays preferred (pass 1) so a build run
  # is unaffected.
  # (13) gate-mode bare form, sha matches -> rc 0
  PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"pr-checks\",\"headSha\":\"$head\",\"name\":\"pr-checks\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"gate / PR-lane gates ($ref)\"},{\"name\":\"gate / Linux amd64 (\${{ inputs.source_ref }}, \${{ inputs.features }})\"},{\"name\":\"gate / ORDER gates (\${{ inputs.source_ref }})\"}]}" \
    "$0" "$run" "$ref" --identity-only >/dev/null 2>&1; rc=$?
  [ "$rc" = 0 ] && passed=$((passed+1))
  # (14) gate-mode bare form carrying a DIFFERENT sha -> rc 4 on the SAME sha
  # gate as the two-field leg (9), i.e. the fallback is not a blanket accept.
  perr="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"pr-checks\",\"headSha\":\"$head\",\"name\":\"pr-checks\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"gate / PR-lane gates ($other)\"},{\"name\":\"gate / Linux amd64 (\${{ inputs.source_ref }}, \${{ inputs.features }})\"}]}" \
    "$0" "$run" "$ref" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 4 ] && grep -qF 'job embed sha' <<< "$perr" && passed=$((passed+1))
  # (15) PREFERENCE — with BOTH shapes present, pass 1's two-field embed must win
  # even when the bare gate job is listed FIRST: the two-field name is the only
  # one carrying FEATURES, so falling through to the bare form would silently
  # drop them and verify a feature-requested run as if it carried none.
  jout="$(PATH="$d/bin:$PATH" STUB_VIEW="{\"status\":\"completed\",\"conclusion\":\"success\",\"displayTitle\":\"ship\",\"headSha\":\"$head\",\"name\":\"ship\"}" \
    STUB_JOBS="{\"jobs\":[{\"name\":\"gate / PR-lane gates ($other)\"},{\"name\":\"ship / Linux amd64 ($ref, telegram,code-graph)\"}]}" \
    "$0" "$run" "$ref" --features telegram,code-graph --json 2>/dev/null)"
  rc=$?
  [ "$rc" = 0 ] && grep -qF "\"embed_sha\": \"$ref\"" <<< "$jout" \
    && grep -qF '"embed_features": "telegram,code-graph"' <<< "$jout" && passed=$((passed+1))

  rm -rf "$d"
  if [ "$passed" = "$total" ]; then
    echo "selftest OK: $passed/$total cases (no network)"
  else
    echo "selftest FAIL: $passed/$total cases (no network)" >&2
  fi
  [ "$passed" = "$total" ]
}

RUN_ID=""
REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --features) FEATURES="$2"; shift 2 ;;
    --wait)     WAIT="$2"; shift 2 ;;
    --repo)     REPO="$2"; shift 2 ;;
    --json)     JSON_OUT=1; shift ;;
    --identity-only) IDENTITY_ONLY=1; shift ;;
    --verbose)  VERBOSE=1; shift ;;
    --selftest) selftest; exit $? ;;
    -h|--help)  usage 0; exit 0 ;;   # C-#3: help = 0 on STDOUT (usage takes the stream)
    *)
      if [ -z "$RUN_ID" ]; then RUN_ID="$1"
      elif [ -z "$REF" ]; then REF="$1"
      else usage; exit 1; fi
      shift ;;
  esac
done

[ -n "$RUN_ID" ] || fail 1 "missing <run-id>"
[ -n "$REF" ] || fail 1 "missing <source-ref-40hex>"
printf '%s' "$RUN_ID" | grep -Eq '^[0-9]+$' || fail 1 "run-id must be numeric, got '$RUN_ID'"
printf '%s' "$REF" | grep -Eq '^[0-9a-fA-F]{40}$' || fail 1 "source_ref must be a FULL 40-char sha (short shas fetch a literal <sha>* branch)"

# ---- 1. RUN EXISTS + initial state -----------------------------------------
VIEW="$(gh run view "$RUN_ID" -R "$REPO" --json status,conclusion,displayTitle,headSha,name 2>/dev/null)" \
  || fail 5 "run $RUN_ID not found on $REPO"
STATUS="$(printf '%s' "$VIEW" | jq -r .status)"
CONCLUSION="$(printf '%s' "$VIEW" | jq -r '.conclusion // "null"')"
HEAD_SHA="$(printf '%s' "$VIEW" | jq -r .headSha)"
DISPLAY="$(printf '%s' "$VIEW" | jq -r .displayTitle)"

# ---- 2. OUTCOME (with optional wait) ---------------------------------------
if [ "$STATUS" != "completed" ]; then
  if [ "$WAIT" -gt 0 ]; then
    say "run $RUN_ID still $STATUS — polling every 15s up to ${WAIT}s"
    waited=0
    while [ "$STATUS" != "completed" ] && [ "$waited" -lt "$WAIT" ]; do
      sleep 15; waited=$((waited+15))
      VIEW="$(gh run view "$RUN_ID" -R "$REPO" --json status,conclusion,displayTitle,headSha,name 2>/dev/null)" || fail 5 "run disappeared mid-wait"
      STATUS="$(printf '%s' "$VIEW" | jq -r .status)"
    done
  fi
fi
if [ "$IDENTITY_ONLY" != 1 ]; then
  [ "$STATUS" = "completed" ] || fail 2 "IN-FLIGHT: run $RUN_ID status=$STATUS (use --wait N to poll)"
  [ "$CONCLUSION" = "success" ] || fail 3 "FAILED: run $RUN_ID conclusion=$CONCLUSION — diagnose first error: gh run view $RUN_ID -R $REPO --log-failed"
else
  say "--identity-only: skipping outcome gates (status=$STATUS conclusion=$CONCLUSION)"
fi

# ---- 3. IDENTITY (job-name embed vs expected ref+features) -----------------
JOB_NAMES="$(gh run view "$RUN_ID" -R "$REPO" --json jobs | jq -r '.jobs[] | .name')" \
  || fail 5 "cannot read jobs for run $RUN_ID"
EMBED=""
while IFS= read -r jn; do
  [ -n "$jn" ] || continue
  EMBED="$(oc_decode_job_embed "$jn")"
  [ -n "$EMBED" ] && break
done <<EOF
$JOB_NAMES
EOF
# TWO accepted name shapes (factory #34). Pass 1 above prefers the two-field
# build-job embed "(<sha>, <features>)" because it carries the FEATURE list.
# Pass 2 below falls back to the bare gates-job form "(<sha>)" — the ONLY
# 40-hex a GATE-MODE run carries, since its build job is SKIPPED and its
# two-field name therefore never renders. The bare form has no features, so a
# --features request against a gate-mode run still fails closed below.
if [ -n "$EMBED" ]; then
  E_REF="${EMBED%%|*}"
  E_FEAT="${EMBED#*|}"
else
  E_REF=""
  while IFS= read -r jn; do
    [ -n "$jn" ] || continue
    E_REF="$(oc_decode_job_sha_any "$jn")"
    [ -n "$E_REF" ] && break
  done <<EOF
$JOB_NAMES
EOF
  E_FEAT=""
fi
[ -n "$E_REF" ] || fail 4 "REF-MISMATCH: no '(sha, features)' or bare '(sha)' embed found in job names of run $RUN_ID"

REF_MATCH=0
[ "$E_REF" = "$REF" ] && REF_MATCH=1
# tolerate prefix-truncation in old embeds: first 12 chars equal
[ "$REF_MATCH" = 0 ] && [ "${E_REF:0:12}" = "${REF:0:12}" ] && REF_MATCH=1
[ "$REF_MATCH" = 1 ] || fail 4 "REF-MISMATCH: job embed sha $E_REF != expected $REF (run headSha=$HEAD_SHA is the CARRIER tip — never the identity)"

FEAT_MATCH=1
if [ -n "$FEATURES" ]; then
  for f in $(printf '%s' "$FEATURES" | tr ',' ' '); do
    grep -qF "$f" <<< "$E_FEAT" || { FEAT_MATCH=0; break; }
  done
fi
[ "$FEAT_MATCH" = 1 ] || fail 4 "REF-MISMATCH: job embed features '$E_FEAT' missing requested '$FEATURES'"

say "headSha($HEAD_SHA) is carrier tip — expected, ignored, reported: $(printf '%s' "$HEAD_SHA" | cut -c1-8)…"

if [ "$JSON_OUT" = 1 ]; then
  jq -n --arg run "$RUN_ID" --arg status "$STATUS" --arg conclusion "$CONCLUSION" \
    --arg job "$(printf '%s\n' "$JOB_NAMES" | head -1)" --arg embed_sha "$E_REF" \
    --arg embed_features "$E_FEAT" --arg ref "$REF" --arg head "$HEAD_SHA" \
    '{verified:true, run_id:$run, status:$status, conclusion:$conclusion, job_name:$job, embed_sha:$embed_sha, embed_features:$embed_features, source_ref:$ref, head_sha_carrier_tip:$head}'
fi
exit 0