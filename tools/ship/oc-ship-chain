[ -z "$DIRTY" ] || die "fork checkout dirty — clean before chaining: $(printf '%s\n' "$DIRTY" | head -5)" 3
# REMOTE-BRANCH PRE-FLIGHT (defect fix 2026-09-11, lane facd50af report).
# LEG1 dispatches a gate that needs the branch ON THE FORK REMOTE, but nothing
# checked that before dispatching. A locally-committed, never-pushed branch
# therefore burned a dispatch and came back "sha ... not found on
# leshchenko1979/opencrabs", which the gate arm below classifies as INFRA rc=6
# ("gate infra") — sending the lane hunting a phantom infrastructure fault when
# the real cause was a missing precondition. One ls-remote fails fast in the
# SAME rc-3 class as the dirty check and costs no dispatch. The remote is
# resolved from the fork checkout's OWN `origin`, so the check cannot drift
# from the repo the ff-merge in LEG3 actually targets. `ls-remote --exit-code`
# returns 2 when the pattern matches nothing; any non-zero is treated as
# absent, and an unresolvable remote is itself rc 3 rather than a silent pass.
FORK_REMOTE="$(git -C "$FORK_REPO" remote get-url origin 2>/dev/null || true)"
[ -n "$FORK_REMOTE" ] || die "fork checkout has no 'origin' remote — cannot verify branch '$BRANCH' is pushed" 3
git -C "$FORK_REPO" ls-remote --exit-code --heads origin "refs/heads/$BRANCH" >/dev/null 2>&1 \
  || die "branch '$BRANCH' not on the fork remote ($FORK_REMOTE) — push it before chaining (LEG1's gate needs it there)" 3

