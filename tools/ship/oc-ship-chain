MAIN_WT="$(git -C "$FORK_REPO" worktree list --porcelain | awk '/^worktree /{wt=$2} /^branch refs\/heads\/main$/{found=wt} END{if (found) print found}')"
if [ -n "$MAIN_WT" ] && [ "$MAIN_WT" != "$FORK_REPO" ]; then
