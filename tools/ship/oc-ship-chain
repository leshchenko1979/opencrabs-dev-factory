#!/usr/bin/env bash
# oc-ship-chain — single-invocation orchestrator: CI gate → issue-log → ff-merge
# into fork main → oc-deploy ship → oc-deploy poll until SWAPPED.
#
# Owner GO 2026-09-09 16:16Z ("Go" on the 5→swapped design). Scope ends at
# SWAPPED: smoke (Phase 6b) and owner approval (Phase 7) stay OUTSIDE — the
# tool never touches them.
#
# Why: lanes kept stopping "at GREEN" (E-H1: verdict, not a deploy) and
# skipping the swap leg (#134 orphan class). One invocation = one clean
# attempt; there is NO legitimate exit point between gate verdict and swap.
# RED outcomes are structured exits — the LANE owns the fix round, the tool
# never retries internally.
#
# Usage:
#   oc-ship-chain --sha <sha> --branch <branch> [--issue <n>] [--issue-repo <slug>]
#                 [--repo <fork-slug>]
#                 [--gated-sha <sha>] [--gated-run <id>] [--wait <sec>]
#                 [--gate-wait <sec>] [--full] [--dry-run] [--no-ledger] [--selftest] [--help]
#   oc-ship-chain --eval-docs-skip [<sha>]
#
# Flags:
#   --eval-docs-skip [<sha>] Evaluate whether a commit qualifies for the docs-only
#                    LEG1 gate skip (rc 0 = docs-only / gate skippable; rc 1 = gate
#                    required; rc 2 = missing sha; rc 3 = bad commit or git error).
#                    Judges the WHOLE shipped range (merge-base of fork main and
#                    <sha> .. <sha>), not the tip commit alone — the chain
#                    fast-forwards the entire branch into main, so a code commit
#                    under a docs-only tip must gate (#322).
#                    Can also be paired with --sha <sha>.
#   --fast           Default gate mode (passes fast=true to oc-prchecks).
#   --full|--no-fast Opt-in full test suite gate (~30 min).
#
# --issue-repo <slug>  The tracker that OWNS --issue, for LEG2's mandatory
#                    per-commit comment. `--repo` above is the FORK CHECKOUT's
#                    slug (used by oc-prchecks); this is the ISSUE's tracker.
#                    Resolution order: --issue-repo, then OC_ISSUE_LOG_REPO,
#                    then a probe of the three known trackers (fork
#                    leshchenko1979/opencrabs, binary opencrabs/opencrabs,
#                    factory leshchenko1979/opencrabs-dev-factory).
#                    A number present on SEVERAL trackers is resolved to the
#                    one that is OPEN; if that is still ambiguous the chain
#                    defaults to the FORK and WARNS loudly -- refusing would
#                    break every fork ship whose number collides with an
#                    upstream issue, which is most numbers <= 766.
#                    OC_SHIPCHAIN_NO_ISSUE_PROBE=1 skips the probe.
#
# --wait <sec>       LEG4 ship/swap budget (default 2700 = 45 min; the 10 most
#                    recent successful carrier builds on this box ALL ran
#                    942-1344 s (15.7-22.4 min), so the old 900 s default
#                    expired on every one of them and surfaced as an INFRA
#                    failure — defect #336).
#                    Env: OC_SHIPCHAIN_SHIP_WAIT.
# --gate-wait <sec>  LEG1 CI-gate budget (default 2700 = 45 min; the PR-lane
#                    gate runs ~30 min here, and oc-prchecks' own default is
#                    600 s, which is SHORTER than the gate — see Exit 5/7).
#                    Env: OC_SHIPCHAIN_GATE_WAIT.
#
# Background execution:
#   Runs across Legs 1-3 sequentially. Call with bash tool parameter background: true.
#   The daemon auto-resumes the session when SWAPPED (rc 0) or on structured exit.
#
# Exit: 0 SWAPPED (full chain complete)
#       2 usage
#       3 precondition not met — pre-flight: dirty fork checkout, or $BRANCH
#         absent from the fork remote (push it); or the LEG1 gate returned
#         oc-prchecks rc 2 (its usage/sha-shape/unknown-ref class). A
#         precondition is the LANE's to fix — it is never an infra fault.
#       4 GATE-RED (oc-prchecks rc 3) or CARRIER-RED (ship wait verdict RED)
#       5 — FOUR distinguishable causes, named in the message and the journal
#         (Design E, #415 step 11). They share the code because the lane's
#         remedy differs, not the severity:
#           NON-FF         branch not fast-forwardable onto fork main and the
#                          tip is NOT a descendant of origin/main — a REAL
#                          divergence. Lane rebases via oc-rebase-safety.
#           STALE-LOCAL-MAIN  the v0.4.214 false alarm: local fork main is
#                          behind origin/main while the branch is correctly
#                          based on it. NOT a rebase problem — reconcile the
#                          checkout (`git merge --ff-only origin/main`), do
#                          NOT rebase. Previously shared NON-FF's text and
#                          sent lanes at a rebase they did not need.
#           TIP-MOVED      the branch tip no longer equals --sha: a
#                          rebase/force-push happened while the gate ran, so
#                          LEG3 must not land an ungated tip — re-gate and
#                          relaunch.
#           REBASE-GATE    oc-deploy ship's own in-tool auto-rebase refused
#                          the push (OC_DEPLOY_GATE=rebase-conflict /
#                          rebase-audit-failed). Same lane fix as NON-FF —
#                          rebase via oc-rebase-safety, then re-run.
#       6 dispatch/poll infra failure (prchecks rc 4/7/8, ship rc other).
#         A lineage-guard refusal surfaces here too (oc-deploy swap rc 2).
#         The guard is REBASE-AWARE since v0.4.151: a deployed sha orphaned by
#         a fork-main rebase whose change survives in the incoming lineage is
#         accepted automatically as rewrite-equivalent-swap — just re-run the
#         chain. Read-only verdict: `oc-deploy lineage-check --prev <deployed>
#         --sha <incoming>`. NEVER hand-edit deployed.sha to re-point around a
#         refusal — that is the regression the guard exists to catch. A genuine
#         stale build is refused with `OC_DEPLOY_SWAP_GUARD=stale-build`; the
#         fix is a fresh build from fork main, not a bypass.
#       NOTE — a swap whose journal stops at marker-write (no receipt step)
#       COMPLETED: the host is swapped, only the tail bookkeeping died. The
#       usual cause is a swap launched inside the very unit it bounces (cgroup
#       teardown at the restart line; fixed v0.4.153 by re-exec outside the
#       cgroup). Do NOT re-run the swap — repair the missing ledger row with
#       `oc-deploy recover-receipt` (rc 0 handled / rc 2 refused; `--dry-run`
#       to inspect first) and confirm the result with `oc-deploy status`.
#       7 gate still IN FLIGHT after its budget + resume-polls (prchecks rc 5,
#         non-terminal). The run id is printed — do NOT re-dispatch (that
#         concurrency-cancels the live run); wait for it and re-run with
#         --gated-run <id>, which pre-verifies and skips dispatch.
#       8 SHIP-WAIT-TIMEOUT — the carrier build did not reach a terminal
#         state within the LEG4 --wait budget (oc-deploy ship rc 5, with no
#         rebase-gate token). The run is still BUILDING — do NOT re-dispatch
#         it; wait for it and resume with
#         `oc-deploy poll --sha <sha> --execute --wait <sec>`, or re-run the
#         chain with a larger --wait. Distinct from 6 (INFRA) so "the build
#         is slow" and "the build is broken" stop sharing an exit code.
#       9 SHIP-LOCK-TIMEOUT — another chain held the landing lock for the whole
#         queue budget. NOT infra: the gate is fine and the holder is a real
#         carrier build. Do NOT re-dispatch the gate (that burns a full gate
#         cycle for the same answer) — wait for the holder, or raise the budget
#         with SHIP_LOCK_TIMEOUT=<sec> / OC_SHIPCHAIN_LOCK_WAIT=<sec>.
#         Distinct from 6 (INFRA) for the same reason 7 and 8 are: lock
#         contention is a queue condition, not a broken component.
#
# Chain-id: every leg stamps the ledger under one id (kind=shipchain)
#   CHAIN-<shortsha>-<UTCstamp>  →  retrieve the whole run with
#   jq -r '.events[] | select(.kind=="shipchain")
#          | select(.what | contains("<CHAIN-id>")) | .what' \
#      <state-dir>/workers-ledger.json
#   (the old help named an `oc-ledger show` verb that does not exist — fixed
#    2026-09-11, same defect report as the kind: an auditor following a
#    non-existent retrieval path reads "no rows" as "chain never ran".)
#
# Env (selftest hooks — never needed in production):
#   OC_PRCHECKS_BIN  default tools/harvest/oc-prchecks
#   OC_SHIPCHAIN_NO_DOCS_SKIP=1  force the LEG1 gate even for a docs-only sha
#                    (test/debug hook — the skip is AUTO-DETECTED, never
#                    lane-declared; see the #20 note at leg 1)
#   OC_DEPLOY_BIN    default tools/ship/oc-deploy
#   OC_ISSUELOG_BIN  default tools/issue/oc-issue-log
#   OC_FORK_REPO     default ~/opencrabs (the fork checkout)
#   OC_ISSUE_LOG_REPO  the tracker LEG2's oc-issue-log posts the per-commit
#                    comment to. This is oc-issue-log's OWN env hook (its
#                    --repo is the same thing); the chain passes --repo
#                    explicitly, so the hook is honoured from BOTH surfaces.
#                    Needed only when the issue is not on the fork AND the
#                    probe cannot decide -- prefer --issue-repo on the CLI.
#   OC_SHIPCHAIN_NO_ISSUE_PROBE=1  skip the LEG2 tracker probe (hermetic
#                    tests / offline); the chain then defaults to the fork.
#   OC_SHIPCHAIN_PROBE_GH  the gh binary the tracker probe uses (default: gh);
#                    a selftest hook, so the probe never reaches the network.
#   OC_SHIPCHAIN_LEDGER  path for chain journal lines (default: oc-ledger)
#   OC_TOOLS_NOLOG=1     suppress ledger stamps (battery/selftest)
#
# Actor (attribution — v0.4.152 §Attribution & Goal Hygiene A1):
#   OC_ACTOR wins when set. Otherwise the chain derives the actor from the
#   `Session-Id` trailer on the --sha commit (every editor commit carries one)
#   and EXPORTS it, so this run's journal rows — and every child tool's rows —
#   are attributed instead of landing as `(unattributed — pass --by or export
#   OC_ACTOR)`. Nothing is invented: with no trailer and no OC_ACTOR the actor
#   stays unset and oc-ledger keeps its loud unattributed message.

# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -e
set -u
set -o pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
TOOLS_DIR="$OC_TOOLS_DIR"

# Content identity for a rebased commit (Duty-4 n=2520). Sourced from the SAME
# lib/ root the bootstrap resolved, so a fixture copy keeps its isolation.
if [ -f "$TOOLS_DIR/lib/oc-patch.sh" ]; then . "$TOOLS_DIR/lib/oc-patch.sh"; fi

_OC_LIB="$TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then
  source "$_OC_LIB"
  oc_log_init "oc-ship-chain" "$@"
else
  oc_log_finish() { :; }
fi
# Combined exit handler: cleans up lock, logs lost journal lines, finishes tool logging
# (#661) A structured non-zero exit must WAKE the arming lane. The header
# promises the daemon resumes on a structured exit, but that resume is a
# BOOT-TIME in-flight classifier: a lane that ARMED a chain and SETTLED is
# classified `completed_before_kill`, so a chain dying later leaves landed+gated
# work unlanded until somebody re-reads the chain by hand (measured: 7h20m on
# one lane; 21 PRE-ANCESTRY MISS rows in the recent ledger).
#
# The durable path is the lib's own, the same one the swap-tail fan-out uses and
# which reaches a SETTLED session. Best-effort by construction: a wake fault
# must never change the chain's exit status. Only non-zero, non-usage exits
# wake -- a usage error is the caller's typo, which it already sees.
_chain_wake_arming_lane() { # $1 = exit code
  local rc="$1" uuid="" chain_lib="" bin="" prof="" _dep="" _state=""
  case "$rc" in 0|2) return 0 ;; esac          # 0 = SWAPPED, 2 = usage
  [ "${OC_SHIPCHAIN_NO_WAKE:-0}" = 1 ] && return 0
  # HERMETICITY, and it must key on the ENVIRONMENT marker, not on argv.
  # oc_is_selftest() reads OC_LOG_ARGS -- the invocation's own argument list --
  # and a fixture child is launched as `bash "$SELF" --sha ... --branch feat`,
  # which carries NO --selftest token. Measured the hard way on 2026-09-27: the
  # argv-based guard let EVERY non-zero-exit leg of this file's selftest wake the
  # arming lane for real, 8 live notifies into one lane's inbound stream in 13
  # minutes, each one re-waking the lane that was debugging the leak.
  # OC_SHIPCHAIN_SELFTEST is the canonical marker and it is INHERITED: line 293
  # execs the selftest with it exported, so the fixture children carry it too.
  # A leg that means to assert the wake's content opts in explicitly. The opt-in
  # is a flag rather than "a stub binary was supplied" because with no stub a
  # missing guard reaches the real /usr/local/bin/opencrabs, sends a live notify,
  # and writes nothing to the leg's log -- the leg would pass while the
  # protection was gone.
  if [ "${OC_SHIPCHAIN_SELFTEST:-0}" = "1" ]; then
    [ "${OC_SHIPCHAIN_WAKE_ALLOW_SELFTEST:-0}" = 1 ] || return 0
  fi
  # #695: the pre-#695 text asserted "(not SWAPPED)" as FACT on any non-zero rc,
  # but rc is not the swap verdict -- the swap poll reads the deployed.sha MARKER,
  # and a post-swap step can fail while the marker stays set. Measured 2026-09-28
  # (chain oc-ship-680-225526, rc 141): the wake said "not SWAPPED" while the
  # chain's own journal read "SWAPPED sha=3eb5adb9..." and deployed.sha carried
  # that sha. Read the marker and STATE which state this actually is; a wake that
  # asserts an unchecked state sends the lane to disprove its own headline, and a
  # lane that trusts it may re-arm a chain for already-shipped work.
  #
  # ERR-EXIT SAFETY: this runs from the EXIT trap, where bash uses the trap's
  # final status as the script's. An unguarded failing command substitution here
  # REPLACES the chain's exit code -- measured 3 -> 1, which corrupted the very
  # audit surface the rc is (reproduced against the tool's own freeze legs).
  # Hence the `[ -r ]` guard and the `|| _dep=""`.
  _dep=""
  if [ -r "${STATE_DIR:-}/deployed.sha" ]; then
    _dep="$(cat "${STATE_DIR:-}/deployed.sha" 2>/dev/null)" || _dep=""
  fi
  _dep="$(printf '%s' "$_dep" | tr -d ' \n')" || _dep=""
  if [ -n "${SHA:-}" ] && [ -n "$_dep" ] && [ "$_dep" = "$SHA" ]; then
    _state="the ship LANDED for this sha -- deployed.sha carries it, so the failure is in a POST-SWAP step and the host is ALREADY swapped; do NOT re-run the swap"
  elif [ -n "$_dep" ]; then
    _state="the work may be landed but UNSHIPPED -- deployed.sha carries ${_dep}, NOT ${SHA:-?}"
  else
    _state="the work may be landed but UNSHIPPED -- deployed.sha is ABSENT, so no swap is recorded"
  fi
  # A1b (owner order 2026-09-27): the SELF uuid comes from the environment, and
  # OPENCRABS_SESSION_ID WINS over OC_ACTOR -- the latter is retired for the actor
  # and a continuation doc can carry a stale one. The commit's Session-Id trailer
  # is the last resort, not the first.
  uuid="${OPENCRABS_SESSION_ID:-${OC_ACTOR:-}}"
  if [ -z "$uuid" ] && [ -n "${SHA:-}" ] && command -v git >/dev/null 2>&1; then
    uuid="$(git -C "${FORK_REPO:-$HOME/opencrabs}" log -1 --format='%(trailers:key=Session-Id,valueonly)' "$SHA" 2>/dev/null | tr -d ' \n')"
  fi
  # only a real uuid: everything downstream keys on it, and a label would be a
  # wake addressed to nobody.
  case "$uuid" in
    ????????-????-????-????-????????????) : ;;
    *) return 0 ;;
  esac
  chain_lib="${OC_TOOLS_DIR:-${TOOLS_DIR:-}}/lib/oc-notify.sh"
  [ -f "$chain_lib" ] || return 0
  # shellcheck disable=SC1090
  . "$chain_lib" 2>/dev/null || return 0
  command -v oc_notify_session >/dev/null 2>&1 || return 0
  bin="$(oc_notify_resolve_bin 2>/dev/null)" || return 0
  prof="${OC_SHIPCHAIN_PROFILE:-ops}"
  oc_notify_session "$bin" "$prof" "oc-ship-chain" "$uuid" \
    "SHIP-CHAIN ${CHAIN:-?}: EXITED rc=$rc" \
    "The chain armed by this lane has STOPPED with rc=$rc. ${_state} -- re-read the chain journal for ${SHA:-?} before re-arming, and note that a stale fix often needs only --gated-run after a rebase. This wake exists because a settled lane is not resumed by the boot classifier." >/dev/null 2>&1 || true
}

_chain_exit_handler() {
  local rc=$?
  if command -v release_ship_lock >/dev/null 2>&1; then
    release_ship_lock
  fi
  if command -v journal_summary >/dev/null 2>&1; then
    journal_summary
  fi
  if command -v _chain_wake_arming_lane >/dev/null 2>&1; then
    _chain_wake_arming_lane "$rc"
  fi
  if command -v oc_log_finish >/dev/null 2>&1; then
    oc_log_finish $rc
  fi
}
trap '_chain_exit_handler' EXIT INT TERM

# selftest dispatch BEFORE arg parsing (avoids the unknown-arg gate)
# impl re-entry is guarded by OC_SHIPCHAIN_IMPL to prevent exec-loop
if [ "${OC_SHIPCHAIN_IMPL:-0}" = "1" ]; then
  SELFTEST_MODE=2          # 2 = inside the impl itself, never re-exec
elif [ "${1:-}" = "--selftest" ]; then
  SELFTEST_MODE=1          # 1 = run was --selftest: exec into impl
else
  SELFTEST_MODE=0
fi

PRCHECKS_BIN="${OC_PRCHECKS_BIN:-$TOOLS_DIR/harvest/oc-prchecks}"
DEPLOY_BIN="${OC_DEPLOY_BIN:-$TOOLS_DIR/ship/oc-deploy}"
ISSUELOG_BIN="${OC_ISSUELOG_BIN:-$TOOLS_DIR/issue/oc-issue-log}"
FORK_REPO="${OC_FORK_REPO:-$HOME/opencrabs}"
GH_BIN="${OC_GH:-gh}"

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$SELF"; exit 0; }
die() { printf 'oc-ship-chain: %s\n' "$1" >&2; exit "${2:-2}"; }

SHA=""; BRANCH=""; ISSUE=""; ISSUE_REPO_FLAG=""; REPO=""; DRY=0; NOLEDGER=0; GATED_SHA=""; GATED_RUN=""
# #672: set when NO leg runs in this chain and the gate is carried forward from an
# earlier run. The banner must not then claim a mode that never ran.
GATE_CARRIED_FORWARD=""
# #672: the docs-only SKIP is a third no-leg path -- same false banner (`FAST`
# claims fmt+clippy ran when nothing ran).
GATE_SKIPPED_DOCS=""
# #355: the run that gated THIS sha, resolved on the dispatch path too (it was
# previously parsed only inside the rc=5 resume loop), so LEG4 can name its
# gate to oc-deploy instead of landing silently.
GATE_RUN_ID="${GATE_RUN_ID:-}"
FAST=0
# LEG1 gate budget (defect fix 2026-09-11, lane 4b4463d5). The PR-lane gate on
# this box takes ~30 min end-to-end; oc-prchecks' own --wait default is 600 s,
# so a fresh chain ALWAYS timed out mid-build and died on a non-terminal code.
GATE_WAIT="${OC_SHIPCHAIN_GATE_WAIT:-2700}"        # 45 min — one gate, comfortably
GATE_RESUMES="${OC_SHIPCHAIN_GATE_RESUMES:-2}"     # max rc-5 resume-polls before an honest give-up
# LEG4 ship/swap budget (defect fix 2026-09-18, issue #336). The budget must
# outlast the carrier build it waits on. Predicate: `gh run list --repo
# leshchenko1979/opencrabs --workflow quick-build-linux.yml --limit 40`,
# COMPLETED runs with conclusion=success, duration = updatedAt - createdAt
# (queue + build — what this flag actually waits on). Of the 37 such runs
# read on 2026-09-18, the 10 most recent ALL exceeded the old 900 s default:
# 942-1344 s (15.7-22.4 min), median 1062 s (17.7 min), the boundary run
# starting 2026-09-17T23:47Z. The 27 before them ran 394-651 s (6.6-10.8 min)
# apart from one 963 s outlier — so a 900 s budget that held comfortably
# stopped holding entirely (11 of 37 successes now exceed 900 s), and every
# expiry surfaced as the generic INFRA branch (rc 6), indistinguishable from
# a genuinely broken carrier. 2700 s mirrors GATE_WAIT and leaves 22.6 min of
# headroom over the worst observed (1344 s).
WAIT="${OC_SHIPCHAIN_SHIP_WAIT:-2700}"             # 45 min — one carrier build, comfortably
# SHIP-LOCK queue budget (defect fix 2026-09-19, fork #391; reported
# independently by lanes 61161247 and c78e78e0). The lock is acquired at LEG3
# and released ONLY from the exit trap, so it is held across LEG3 (ff-merge,
# seconds) + LEG4 (WAIT above) + LEG5 (swap poll, 12 x 10 s + poll runtime).
# The old default was a hardcoded 600 s against a ~3300 s max hold: the queue
# budget was STRUCTURALLY SHORTER than the thing it serialized, so any chain
# that queued behind a real ship expired by construction. Volume measured over
# tools.log shipchain rows: 56 contended, 36 acquired-after-wait, 10 timeouts.
# Mirrors the LEG4 fix (#336) reasoning: a budget must outlast the hold it
# waits on, not the average. WAIT + 600 s covers LEG5 and leaves headroom.
# The timeout also stopped masquerading as INFRA: it now dies rc 9
# (SHIP-LOCK-TIMEOUT), because "another ship is ahead of you" is a QUEUE
# condition, not a broken component — the same split rc 7 and rc 8 got.
# The documented workaround SHIP_LOCK_TIMEOUT=<sec> keeps working and WINS
# over this default; OC_SHIPCHAIN_LOCK_WAIT is the file's own-prefix alias.
SHIP_LOCK_WAIT="${OC_SHIPCHAIN_LOCK_WAIT:-$((WAIT + 600))}"
[ "$SELFTEST_MODE" = "1" ] && OC_SHIPCHAIN_IMPL=1 OC_SHIPCHAIN_SELFTEST=1 exec bash "$SELF"
[ "$SELFTEST_MODE" = "2" ] && eval "$(sed -n '/^selftest_impl()/,/^}$/p' "$SELF")" && { selftest_impl; exit $?; }

# #21 (LAW 17): the detach re-execs this tool with its ORIGINAL argv, so the
# argv must be captured BEFORE the arg loop consumes it (a re-exec with an
# already-drained "$@" would launch a chain with no --sha and die rc 2).
ORIG_ARGS=("$@")

# `include_str!` resolves relative to the CONTAINING .rs file (not the crate
# root), so the containing file is captured alongside each literal and the pair
# is resolved together; output is repo-relative, one path per line.
shipchain_compiled_md_set() {
  local rs rel
  # Whole body in a subshell: the `cd` must not move the caller's cwd. Today's
  # only call site is a command substitution (already a subshell), but a cwd
  # leak out of a path-resolver is the kind of bug that surfaces a hundred lines
  # later in an unrelated `git` call.
  (
    cd "$FORK_REPO" 2>/dev/null || { printf '%s\n' "__OC_DERIVE_FAILED__"; exit 0; }
    grep -rloE 'include_(str|bytes)!\([[:space:]]*"[^"]+\.md"' src --include=*.rs 2>/dev/null \
      | while IFS= read -r rs; do
          grep -oE 'include_(str|bytes)!\([[:space:]]*"[^"]+\.md"' "$rs" 2>/dev/null \
            | sed -E 's/.*"([^"]+\.md)".*/\1/' \
            | while IFS= read -r rel; do
                realpath -m --relative-to=. "$(dirname "$rs")/$rel" 2>/dev/null || true
              done
        done | sort -u
  )
}

# The ref the shipped range is measured against. The chain's LEG3 fast-forwards
# fork main onto $SHA, so everything from the merge-base of main and $SHA is
# what this chain introduces. Prefer origin/main (the shared truth; a stale
# origin/main sits BEHIND and yields a LARGER range — the conservative
# direction), fall back to local main. No main ref -> the range is unjudgeable.
shipchain_main_ref() {
  local r
  for r in refs/remotes/origin/main refs/heads/main; do
    if git -C "$FORK_REPO" rev-parse --verify --quiet "$r^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "$r"
      return 0
    fi
  done
  return 1
}

# rc 0 = docs-only, prints the changed paths; rc 1 = must gate.
#
# #322 (editor lane #286 report): this judged `$SHA^..$SHA` — the TIP commit
# only — while LEG3 fast-forwards the WHOLE branch into main. A 2-commit branch
# (code commit under a docs-only tip) therefore skipped LEG1 and shipped
# ungated: the tip diff is pure markdown, the shipped range is not. The
# predicate now judges the range the chain actually introduces, so a code
# commit under a docs tip gates. Base = merge-base(main, $SHA); when that
# resolves to $SHA itself the branch adds nothing to main and the answer is
# gate (conservative, and the empty diff would gate anyway).
shipchain_docs_only() {
  local mainref base paths p compiled
  mainref="$(shipchain_main_ref)" || return 1   # no main ref: gate
  base="$(git -C "$FORK_REPO" merge-base "$mainref" "$SHA" 2>/dev/null || true)"
  [ -n "$base" ] || return 1                    # no common ancestor: gate
  [ "$base" != "$SHA" ] || return 1             # nothing new to introduce: gate
  paths="$(git -C "$FORK_REPO" diff --name-only "$base" "$SHA" 2>/dev/null || true)"
  [ -n "$paths" ] || return 1                   # empty diff: gate (conservative)
  compiled="$(shipchain_compiled_md_set)"
  # Fail CLOSED when the set cannot be derived. The derivation's own failure path
  # used to print nothing, which is indistinguishable from a legitimate "this
  # repo compiles in no markdown" — so a failed derivation made every markdown
  # path look non-compiled and the gate was SKIPPED. That is the same shape as
  # the rest of this family: an unverifiable check must never read as clean.
  case "$compiled" in
    *__OC_DERIVE_FAILED__*) return 1 ;;
  esac
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in *.md) ;; *) return 1 ;; esac   # any non-markdown -> gate
    # #537: NO PIPE. `printf ... | grep -q` under `set -o pipefail` is a latent
    # FALSE NEGATIVE — grep -q exits at the first match, printf takes SIGPIPE,
    # and the pipeline reports 141, so the `&& return 1` never fires and a
    # COMPILED markdown path is treated as docs-only, SKIPPING the CI gate.
    # Measured in the battery: eval-docs-skip-compiled-rc1 wanted rc=1 and got 0
    # with README.md listed as docs-only (README.md is include_str!'d from
    # src/lib.rs, so touching it changes compiled output and MUST gate).
    grep -qxF "$p" <<< "$compiled" && return 1   # compiled -> gate
  done <<EOF
$paths
EOF
  printf '%s\n' "$paths"
  return 0
}

FAST_GATE=1
EVAL_DOCS_SKIP=0
