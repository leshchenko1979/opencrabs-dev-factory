# --sha and --branch named). The EXIT-trap wake keys on this, so a NON-chain
# invocation -- `--help`, or `--eval-docs-skip` (which exits 1/3) -- can never
# wake a lane with a fabricated "your chain STOPPED". Measured 2026-10-05: five
# `--help` exits at rc 141 (SIGPIPE from a short reader) across four lanes, each
# one waking the lane that ran it, with SHA and STATE_DIR unset so the state line
# read "deployed.sha is ABSENT" off the root path and the sha rendered "?".
CHAIN_INTENT=0
# #672: set when NO leg runs in this chain and the gate is carried forward from an
# earlier run. The banner must not then claim a mode that never ran.
GATE_CARRIED_FORWARD=""
# #672: the docs-only SKIP is a third no-leg path -- same false banner (`FAST`
# claims fmt+clippy ran when nothing ran).
GATE_SKIPPED_DOCS=""
# #355: the run that gated THIS sha, resolved on the dispatch path too (it was
# previously parsed only inside the rc=5 resume loop), so LEG4 can name its
# gate to oc-deploy instead of landing silently.
GATE_RUN_ID="${GATE_RUN_ID:-}"
# #92: the superseder prchecks NAMED on a CANCELLED-superseded gate. Empty
# unless LEG1 captured one, so every other rc-6 exit keeps its old answer.
GATE_SUPERSEDING="${GATE_SUPERSEDING:-}"
FAST=0
# LEG1 gate budget (defect fix 2026-09-11, lane 4b4463d5). The PR-lane gate on
# this box takes ~30 min end-to-end; oc-prchecks' own --wait default is 600 s,
# so a fresh chain ALWAYS timed out mid-build and died on a non-terminal code.
GATE_WAIT="${OC_SHIPCHAIN_GATE_WAIT:-2700}"        # 45 min — one gate, comfortably
GATE_RESUMES="${OC_SHIPCHAIN_GATE_RESUMES:-2}"     # max rc-5 resume-polls before an honest give-up
# LEG4 ship/swap budget (defect fix 2026-09-18, issue #336). The budget must
# outlast the carrier build it waits on. Predicate: `gh run list --repo
# leshchenko1979/opencrabs --workflow quick-build-linux.yml --limit 40`,
# COMPLETED runs with conclusion=success, duration = updatedAt - createdAt
# (queue + build — what this flag actually waits on). Of the 37 such runs
# read on 2026-09-18, the 10 most recent ALL exceeded the old 900 s default:
# 942-1344 s (15.7-22.4 min), median 1062 s (17.7 min), the boundary run
# starting 2026-09-17T23:47Z. The 27 before them ran 394-651 s (6.6-10.8 min)
# apart from one 963 s outlier — so a 900 s budget that held comfortably
# stopped holding entirely (11 of 37 successes now exceed 900 s), and every
# expiry surfaced as the generic INFRA branch (rc 6), indistinguishable from
# a genuinely broken carrier. 2700 s mirrors GATE_WAIT and leaves 22.6 min of
# headroom over the worst observed (1344 s).
WAIT="${OC_SHIPCHAIN_SHIP_WAIT:-2700}"             # 45 min — one carrier build, comfortably
# SHIP-LOCK queue budget (defect fix 2026-09-19, fork #391; reported
# independently by lanes 61161247 and c78e78e0). The lock is acquired at LEG3
# and released ONLY from the exit trap, so it is held across LEG3 (ff-merge,
# seconds) + LEG4 (WAIT above) + LEG5 (swap poll, 12 x 10 s + poll runtime).
# The old default was a hardcoded 600 s against a ~3300 s max hold: the queue
# budget was STRUCTURALLY SHORTER than the thing it serialized, so any chain
# that queued behind a real ship expired by construction. Volume measured over
# tools.log shipchain rows: 56 contended, 36 acquired-after-wait, 10 timeouts.
# Mirrors the LEG4 fix (#336) reasoning: a budget must outlast the hold it
# waits on, not the average. WAIT + 600 s covers LEG5 and leaves headroom.
# The timeout also stopped masquerading as INFRA: it now dies rc 9
# (SHIP-LOCK-TIMEOUT), because "another ship is ahead of you" is a QUEUE
# condition, not a broken component — the same split rc 7 and rc 8 got.
# The documented workaround SHIP_LOCK_TIMEOUT=<sec> keeps working and WINS
# over this default; OC_SHIPCHAIN_LOCK_WAIT is the file's own-prefix alias.
SHIP_LOCK_WAIT="${OC_SHIPCHAIN_LOCK_WAIT:-$((WAIT + 600))}"
[ "$SELFTEST_MODE" = "1" ] && OC_SHIPCHAIN_IMPL=1 OC_SHIPCHAIN_SELFTEST=1 exec bash "$SELF"
if [ "$SELFTEST_MODE" = "2" ]; then   # body lives in tests/chain-selftest.sh
  _csf="$TOOLS_DIR/tests/chain-selftest.sh"
  if [ ! -f "$_csf" ]; then printf 'oc-ship-chain selftest: %s missing (broken LOCAL TOOL TREE)\n' "$_csf" >&2; exit 2; fi
  . "$_csf"; exit $?
fi

# #21 (LAW 17): the detach re-execs this tool with its ORIGINAL argv, so the
# argv must be captured BEFORE the arg loop consumes it (a re-exec with an
# already-drained "$@" would launch a chain with no --sha and die rc 2).
ORIG_ARGS=("$@")

# `include_str!` resolves relative to the CONTAINING .rs file (not the crate
# root), so the containing file is captured alongside each literal and the pair
# is resolved together; output is repo-relative, one path per line.
shipchain_compiled_md_set() {
  local rs rel
  # Whole body in a subshell: the `cd` must not move the caller's cwd. Today's
  # only call site is a command substitution (already a subshell), but a cwd
  # leak out of a path-resolver is the kind of bug that surfaces a hundred lines
  # later in an unrelated `git` call.
  (
    cd "$FORK_REPO" 2>/dev/null || { printf '%s\n' "__OC_DERIVE_FAILED__"; exit 0; }
    grep -rloE 'include_(str|bytes)!\([[:space:]]*"[^"]+\.md"' src --include=*.rs 2>/dev/null \
      | while IFS= read -r rs; do
          grep -oE 'include_(str|bytes)!\([[:space:]]*"[^"]+\.md"' "$rs" 2>/dev/null \
            | sed -E 's/.*"([^"]+\.md)".*/\1/' \
            | while IFS= read -r rel; do
                realpath -m --relative-to=. "$(dirname "$rs")/$rel" 2>/dev/null || true
              done
        done | sort -u
  )
}

# The ref the shipped range is measured against. The chain's LEG3 fast-forwards
# fork main onto $SHA, so everything from the merge-base of main and $SHA is
# what this chain introduces. Prefer origin/main (the shared truth; a stale
# origin/main sits BEHIND and yields a LARGER range — the conservative
# direction), fall back to local main. No main ref -> the range is unjudgeable.
shipchain_main_ref() {
  local r
  for r in refs/remotes/origin/main refs/heads/main; do
    if git -C "$FORK_REPO" rev-parse --verify --quiet "$r^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "$r"
      return 0
    fi
  done
  return 1
}

# rc 0 = docs-only, prints the changed paths; rc 1 = must gate.
#
# #322 (editor lane #286 report): this judged `$SHA^..$SHA` — the TIP commit
# only — while LEG3 fast-forwards the WHOLE branch into main. A 2-commit branch
# (code commit under a docs-only tip) therefore skipped LEG1 and shipped
# ungated: the tip diff is pure markdown, the shipped range is not. The
# predicate now judges the range the chain actually introduces, so a code
# commit under a docs tip gates. Base = merge-base(main, $SHA); when that
# resolves to $SHA itself the branch adds nothing to main and the answer is
# gate (conservative, and the empty diff would gate anyway).
shipchain_docs_only() {
  local mainref base paths p compiled
  mainref="$(shipchain_main_ref)" || return 1   # no main ref: gate
  base="$(git -C "$FORK_REPO" merge-base "$mainref" "$SHA" 2>/dev/null || true)"
  [ -n "$base" ] || return 1                    # no common ancestor: gate
  [ "$base" != "$SHA" ] || return 1             # nothing new to introduce: gate
  paths="$(git -C "$FORK_REPO" diff --name-only "$base" "$SHA" 2>/dev/null || true)"
  [ -n "$paths" ] || return 1                   # empty diff: gate (conservative)
  compiled="$(shipchain_compiled_md_set)"
  # Fail CLOSED when the set cannot be derived. The derivation's own failure path
  # used to print nothing, which is indistinguishable from a legitimate "this
  # repo compiles in no markdown" — so a failed derivation made every markdown
  # path look non-compiled and the gate was SKIPPED. That is the same shape as
  # the rest of this family: an unverifiable check must never read as clean.
  case "$compiled" in
    *__OC_DERIVE_FAILED__*) return 1 ;;
  esac
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in *.md) ;; *) return 1 ;; esac   # any non-markdown -> gate
    # #537: NO PIPE. `printf ... | grep -q` under `set -o pipefail` is a latent
    # FALSE NEGATIVE — grep -q exits at the first match, printf takes SIGPIPE,
    # and the pipeline reports 141, so the `&& return 1` never fires and a
    # COMPILED markdown path is treated as docs-only, SKIPPING the CI gate.
    # Measured in the battery: eval-docs-skip-compiled-rc1 wanted rc=1 and got 0
    # with README.md listed as docs-only (README.md is include_str!'d from
    # src/lib.rs, so touching it changes compiled output and MUST gate).
    grep -qxF "$p" <<< "$compiled" && return 1   # compiled -> gate
  done <<EOF
$paths
EOF
  printf '%s\n' "$paths"
  return 0
}

FAST_GATE=1
EVAL_DOCS_SKIP=0
# #77: scheduling class for this chain. `low` (nice 19 + ionice class idle) is
# the default because a chain is BACKGROUND work — it sits in remote-CI waits for
# minutes and must not compete with the daemon. `normal` is the opt-out.
PRIORITY="low"
PRIORITY_PROBE=0
# factory #39: the #1936 Stage-1 hang mitigation, forwarded to LEG1's
# oc-prchecks dispatch. The env default follows the house pattern
# (OC_SHIPCHAIN_GATE_WAIT / OC_SHIPCHAIN_SHIP_WAIT); EMPTY = not requested,
# the only value that leaves the dispatch byte-identical to pre-#39 behaviour.
TEST_THREADS="${OC_SHIPCHAIN_TEST_THREADS:-}"
# #78: env form of --no-rearm, so a lane can set it for a whole session without
# threading the flag through every invocation. Shape is validated like
# --test-threads: a typo must die at the boundary (rc 2) rather than read as
# "0" and silently leave the supervisor armed — an accepted-but-inert knob is
# indistinguishable from an honoured one (the #63 class).
case "${OC_SHIPCHAIN_NO_REARM:-}" in
  '') : ;;
  0) : ;;
  1) NO_REARM=1 ;;
  *) die "OC_SHIPCHAIN_NO_REARM needs 0 or 1 (got '$OC_SHIPCHAIN_NO_REARM')" 2 ;;
esac
case "$TEST_THREADS" in
  '') : ;;
  *[!0-9]*) die "OC_SHIPCHAIN_TEST_THREADS needs a non-negative integer (got '$TEST_THREADS')" 2 ;;
esac
while [ $# -gt 0 ]; do
  case "$1" in
    --eval-docs-skip)
      EVAL_DOCS_SKIP=1
      if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
        SHA="$2"
        shift 2
      else
        shift
      fi
      ;;
    --sha)       SHA="${2:?}"; shift 2 ;;
    --branch)    BRANCH="${2:?}"; shift 2 ;;
    --issue)     ISSUE="${2:?}"; shift 2 ;;
    --issue-repo) ISSUE_REPO_FLAG="${2:?}"; shift 2 ;;
    --repo)      REPO="${2:?}"
                 # #90: --repo is a gh SLUG, never a checkout path. A path
                 # reaches `gh -R` verbatim, gh refuses it ("expected the
                 # [HOST/]OWNER/REPO format"), and before this guard the
                 # stderr was swallowed so the chain died rc 4 blaming the
                 # RUN — sending the lane to hunt a phantom gate problem.
                 # Fail loud at the arg boundary instead, and name the knob
                 # that actually takes a path (the #63 class: an accepted-
                 # but-misread knob is indistinguishable from an honoured one).
                 case "$REPO" in
                   /*|./*|../*|~*)
                     die "--repo takes an owner/repo SLUG (e.g. leshchenko1979/opencrabs), not a checkout path: '$REPO'. The checkout is OC_FORK_REPO=<path>; --repo is only ever passed to gh -R." 2 ;;
                 esac
                 if [ -d "$REPO" ]; then
                   die "--repo takes an owner/repo SLUG, not a directory: '$REPO' exists on disk. The checkout is OC_FORK_REPO=<path>; --repo is only ever passed to gh -R." 2
                 fi
                 shift 2 ;;
    --wait)      WAIT="${2:?}"; shift 2 ;;
    --gate-wait) GATE_WAIT="${2:?}"; shift 2 ;;
    --gated-sha) GATED_SHA="${2:?}"; shift 2 ;;
    --gated-run) GATED_RUN="${2:?}"; shift 2 ;;
    --fast)            FAST_GATE=1; shift ;;
    # #78: opt out of the Class A re-arm supervisor. Two legitimate uses:
    # a lane that wants to SEE every mechanical failure (debugging the chain
    # itself), and an operator who wants the old wake-every-time behaviour.
    --no-rearm)        NO_REARM=1; shift ;;
    --full|--no-fast)  FAST_GATE=0; shift ;;
    --test-threads)    shift; TEST_THREADS="${1:-}"
                       # Shape is validated HERE, not left to the callee: a
                       # typo must die at the caller's own arg boundary (rc 2
                       # usage) rather than reach oc-prchecks as a bad input.
                       case "$TEST_THREADS" in
                         ''|*[!0-9]*) die "--test-threads needs a non-negative integer (got '$TEST_THREADS')" 2 ;;
                       esac
                       shift ;;
    --dry-run)   DRY=1; shift ;;
    --no-ledger) NOLEDGER=1; shift ;;
    # #77: scheduling class. Validated HERE so a typo dies at the caller's own
    # arg boundary (rc 2) instead of reaching the apply step as a bad input.
    --priority)
      PRIORITY="${2:-}"
      case "$PRIORITY" in
        low|normal) : ;;
        '') die "--priority needs 'low' or 'normal' (got nothing)" 2 ;;
        *)  die "--priority needs 'low' or 'normal' (got '$PRIORITY')" 2 ;;
      esac
      shift 2 ;;
    # #77: read-only probe — applies the REAL block, prints the resolved class,
    # exits 0 before any required-arg check or network call. This is what the
    # selftest drives; a re-implementation in the test would prove nothing.
    --resolve-priority) PRIORITY_PROBE=1; shift ;;
    --help|-h)   usage ;;
    *) die "unknown arg: $1 (see --help)" 2 ;;
  esac
done

# ---- scheduling priority (#77) ----------------------------------------------
# Applied to THIS process, so every child (gh, git, oc-prchecks) inherits it at
# fork. `renice` rather than a `nice -n 19` wrapper: the chain may already have
# re-exec'd itself once, and a second exec layer would make "which PID is the
# chain" depend on which branches fired.
# A failed renice/ionice is a WARNING and never a die — refusing to ship because
# we could not lower our own priority would trade a scheduling nicety for an
# outage. What the class actually APPLIED is re-read from the kernel and carried
# in the log line and the ledger row, so a run can be classified afterwards
# rather than inferred from the flag someone typed.
oc_priority_apply() {  # $1 = low|normal ; sets PRIORITY_NICE/PRIORITY_IOPRIO/PRIORITY_APPLIED
  local want="$1" a=""
  PRIORITY_APPLIED="none"
  PRIORITY_NICE="$(ps -o nice= -p $$ 2>/dev/null | tr -d ' ')"
  PRIORITY_IOPRIO="$(ionice -p $$ 2>/dev/null || true)"
  if [ "$want" = "low" ]; then
    if command -v renice >/dev/null 2>&1; then
      if renice -n 19 -p $$ >/dev/null 2>&1; then
        a="renice"
      else
        printf '%s\n' "oc-ship-chain: WARNING: renice -n 19 failed -- running at nice ${PRIORITY_NICE:-?} (#77)" >&2
      fi
    else
      printf '%s\n' "oc-ship-chain: WARNING: no renice -- running at nice ${PRIORITY_NICE:-?} (#77)" >&2
    fi
    if command -v ionice >/dev/null 2>&1; then
      if ionice -c3 -p $$ >/dev/null 2>&1; then
        a="${a:+$a+}ionice"
      else
        printf '%s\n' "oc-ship-chain: WARNING: ionice -c3 failed -- I/O priority unchanged (#77)" >&2
      fi
    else
      printf '%s\n' "oc-ship-chain: WARNING: no ionice -- I/O priority unchanged (#77)" >&2
    fi
    PRIORITY_APPLIED="${a:-none}"
    PRIORITY_NICE="$(ps -o nice= -p $$ 2>/dev/null | tr -d ' ')"
    PRIORITY_IOPRIO="$(ionice -p $$ 2>/dev/null || true)"
  fi
}
oc_priority_apply "$PRIORITY"
if [ "$PRIORITY_PROBE" = "1" ]; then
  # #77 req 2: a child spawned AFTER the renice must inherit it. Asserting only
  # the parent's nice cannot distinguish "applied before the children" from
  # "applied after" -- and a nice 19 parent does NOT yield a child that forked
  # at 0 (the issue's own warning). This forks a REAL child ($BASHPID inside
  # `bash -c` is the new process) and reports what it actually reads.
  PRIORITY_CHILD_NICE="$(bash -c 'ps -o nice= -p $$' 2>/dev/null | tr -d ' ')"
  printf 'priority=%s\nnice=%s\nioprio=%s\napplied=%s\nchild_nice=%s\n' \
    "$PRIORITY" "${PRIORITY_NICE:-}" "${PRIORITY_IOPRIO:-}" "${PRIORITY_APPLIED:-none}" "${PRIORITY_CHILD_NICE:-}"
  exit 0
fi
printf 'oc-ship-chain: priority=%s (nice=%s ioprio=%s applied=%s)\n' \
  "$PRIORITY" "${PRIORITY_NICE:-}" "${PRIORITY_IOPRIO:-}" "${PRIORITY_APPLIED:-none}" >&2

