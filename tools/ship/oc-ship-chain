# ---- cgroup detach (LAW 17, defect #21, 2026-09-12) ------------------------
# A chain launched from a session is a child of the daemon and therefore sits
# INSIDE the unit cgroup that a swap's `systemctl --user restart` tears down.
# The chain is then SIGTERM'd mid-leg and simply STOPS: no ledger row, no
# failure report, rc=-1 to the background task with no diagnosis. Two chains
# died exactly this way at the 11:36:46Z swap (CHAIN-b6fcbcb0 died `gate infra
# rc=143`; a second, correctly QUEUED on the ship lock, was killed for waiting
# — serialisation gave it a false sense of safety).
#
# TWO TEARDOWNS, NOT ONE (residual, reported by editor 462181e9 2026-09-12):
# the cgroup is not the only thing the launching tool call owns. A chain started
# from a captured tool call inherits that call's stdout/stderr PIPES, so the
# re-exec'd scope survives the cgroup teardown while its stderr still dies with
# the call that launched it: the first stderr write raises EPIPE and the chain
# ends silently — 0-byte log, no LEG row, no rc field. Field case: CHAIN-
# 6f62b2c1-20260912T115518Z died 26 minutes in, immediately after `SHIP-LOCK
# acquired`, whose `printf ... >&2` was the first stderr write. The re-exec
# therefore binds its stdio to a FILE — a caller-side redirect only covers
# callers who remember, and the tool must not depend on that.
#
# Same class as LAW 15 for oc-notify-fanout, and the same fix: re-exec outside
# the bounce cgroup via a transient scope, BEFORE the ship lock is taken, so a
# re-entry can never self-deadlock on a lock this process already holds. That
# pre-lock ordering matters MORE here than for a wave: the chain holds its lock
# across LEG3/LEG4 and a queued chain can wait minutes.
# Overrides: OC_SHIPCHAIN_UNIT (default opencrabs-ops.service) ·
# OC_SHIPCHAIN_IN_UNIT_CGROUP (auto|1|0 — test hook; auto inspects /proc/self/cgroup) ·
# OC_SHIPCHAIN_SELFTEST (1 = the selftest exports it, so `auto` resolves to 0 and
# the selftest never depends on the host's cgroup; detach tests set =1 explicitly)
# OC_SHIPCHAIN_DETACH_CMD (default `systemd-run --user --scope --collect`; MUST
# BLOCK and pass the child's rc through — use `setsid -w`, never bare `setsid`,
# or the chain's exit code is lost and a NON-FF refusal reads as success) ·
# OC_SHIPCHAIN_DETACHED (loop guard) ·
# OC_SHIPCHAIN_LOG (where the detached re-exec binds stdout+stderr; default
# /tmp/oc-ship-chain-detached-<pid>.log).
shipchain_in_bounce_cgroup() { # rc 0 = this process IS inside the unit's cgroup
  local unit="${OC_SHIPCHAIN_UNIT:-opencrabs-ops.service}" cg dflt=auto
  # SELFTEST HERMETICITY (2026-09-12): under `auto` this reads the HOST's
  # /proc/self/cgroup, so the selftest's result depended on WHERE it ran.
  # Inside opencrabs-ops.service the detach fired in seven tests that have
  # nothing to do with detaching, and they passed only because the re-exec
  # inherited the captured pipe — binding the re-exec's stdio to a file
  # (LAW 17 residual) removed that accident and they went red. The selftest
  # export below makes "outside the unit" the default there; the detach
  # tests set OC_SHIPCHAIN_IN_UNIT_CGROUP=1 explicitly.
  [ "${OC_SHIPCHAIN_SELFTEST:-0}" = "1" ] && dflt=0
  case "${OC_SHIPCHAIN_IN_UNIT_CGROUP:-$dflt}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -r /proc/self/cgroup ] || return 1
  cg="$(cat /proc/self/cgroup 2>/dev/null || true)"
  case "$cg" in *"/$unit"|*"/$unit/"*) return 0 ;; esac
  return 1
}

shipchain_ensure_detached() { # re-exec outside the bounce cgroup (argv from ORIG_ARGS)
  [ "${OC_SHIPCHAIN_DETACHED:-0}" = "1" ] && return 0   # already detached (loop guard)
  shipchain_in_bounce_cgroup || return 0
  local cmd="${OC_SHIPCHAIN_DETACH_CMD:-systemd-run --user --scope --collect}"
  echo "oc-ship-chain: chain is INSIDE ${OC_SHIPCHAIN_UNIT:-opencrabs-ops.service}'s cgroup — a swap's restart would SIGKILL it mid-leg, truncating the run with NO failure report (LAW 17, defect #21). Re-executing outside the unit via: $cmd" >&2
  # Bind stdio to a FILE. The scope is what survives the cgroup teardown; the
  # launching tool call still owns the pipes, so an unredirected re-exec dies
  # EPIPE on its first stderr write (see the block comment above).
  local dlog="${OC_SHIPCHAIN_LOG:-/tmp/oc-ship-chain-detached-$$.log}"
  OC_SHIPCHAIN_DETACHED=1 exec $cmd "$SELF" "${ORIG_ARGS[@]}" </dev/null >>"$dlog" 2>&1
}
shipchain_ensure_detached

# ---- chain id -------------------------------------------------------------
SHORT="$(printf '%s' "$SHA" | cut -c1-8)"
CHAIN="CHAIN-${SHORT}-$(date -u +%Y%m%dT%H%M%SZ)"

# ---- journal --------------------------------------------------------------
# One line per leg, all under the chain id. OC_TOOLS_NOLOG=1 or --no-ledger
# (selftests/battery) writes to stderr instead of the ledger.
#
# FAILURE IS LOUD, NEVER FATAL (2026-09-11, defect fix lane 4b4463d5): this
# used to be `... >/dev/null 2>&1 || true`, so a journal write that could NEVER
# succeed (stamping a kind absent from oc-ledger's enum -> permanent rc 2) was
# byte-identical to success. 216/216 journal stamps in tools.log died rc 2 and
# nobody knew; the ledger held ZERO chain rows while the help text promised a
# per-run trail, and an auditor reading it concluded "chain never ran".
# Telemetry must not kill a chain that has done real work (ff-merge, ship,
# swap) — so: first failure warns loudly with the real stderr, later ones are
# counted, and the run continues either way.
JOURNAL_FAILS=0
journal() {
  local line="[$CHAIN] $1"
  if [ -n "${OC_SHIPCHAIN_LEDGER:-}" ]; then
    printf '%s\n' "$line" >> "$OC_SHIPCHAIN_LEDGER"
  elif [ "$NOLEDGER" = "1" ] || [ "${OC_TOOLS_NOLOG:-0}" = "1" ]; then
    printf '%s\n' "$line" >&2
  else
    local out="" rc=0
    # --by fallback (#19, 2026-09-12): an anonymous ledger row is REFUSED by
    # oc-ledger now. ship_chain_default_actor() has already tried to derive the
    # real lane from the --sha Session-Id trailer; when even that fails, the
    # honest actor is the TOOL, not an anonymous row (precedent: oc-deploy
    # stamps `--by "oc-deploy recover-receipt"`). This keeps the chain's ledger
    # trail intact instead of trading it for a loud journal failure.
    out="$("$TOOLS_DIR/state/oc-ledger" stamp shipchain "$line" --by "${OC_ACTOR:-oc-ship-chain}" 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then
      JOURNAL_FAILS=$((JOURNAL_FAILS + 1))
      if [ "$JOURNAL_FAILS" -eq 1 ]; then
        printf '%s\n' "oc-ship-chain: WARNING — ledger journaling FAILED (rc=$rc) for $CHAIN." >&2
        printf '%s\n' "  oc-ledger said: $out" >&2
        printf '%s\n' "  first lost line: $line" >&2
        printf '%s\n' "  the chain CONTINUES, but this run will have NO ledger trail." >&2
        # #21 (LAW 17): this line used to print the SAME hypothesis for ANY
        # non-zero rc — including rc=143 SIGTERM from a swap's cgroup teardown.
        # But oc-ledger DOES accept kind 'shipchain' (every row of the killed
        # chain stamped cleanly), so the message sent the operator to repair a
        # component that was not broken, in the one failure mode where the
        # right advice is "re-run it". Branch on the cause; keep the rc visible
        # either way — it was the only clue that pointed at the restart.
        case "$rc" in
          143|137)
            printf '%s\n' "  cause: rc=$rc (SIGTERM/SIGKILL) — this chain was KILLED, most likely by a swap's cgroup teardown. Do NOT repair oc-ledger; RE-RUN the chain (LAW 17 now re-execs it outside the unit cgroup, so a re-run survives the next swap)." >&2 ;;
          2)
            # rc 2 IS the vocabulary case and the advice is correct here and only
            # here: oc-ledger:858 `die 2 "stamp: unknown kind ..."`. The #21 fix
            # stopped at 143/137 and left this text as the catch-all, so it kept
            # asserting a cause it had not established.
            printf '%s\n' "  fix: oc-ledger must accept kind 'shipchain' (see tools/state/oc-ledger KINDS). rc=$rc" >&2 ;;
          4)
            # rc 4 is with_lock's lock timeout (oc-ledger:603 `flock -w ... || die 4`).
            # The stamp was NEVER ATTEMPTED, so nothing about the ledger's schema or
            # vocabulary is in question. Measured 2026-09-27: ~12 processes queued on
            # workers-ledger.json.lock during a ship storm, and a 2.7 GB state repo
            # whose `git gc --auto` child INHERITS the lock fd (#655) can hold it for
            # minutes — over 12x the wait the tool's own message documents.
            printf '%s\n' "  cause: rc=4 — oc-ledger could not acquire the ledger lock within its wait budget, so the stamp was never attempted. The ledger's KINDS vocabulary is NOT in question; do not edit it. Re-run the chain, or raise the wait (OC_LEDGER_LOCK_WAIT). Contention, not a defect in the ledger." >&2 ;;
          *)
            # Cause-neutral. An unestablished cause printed as a confident remedy is
            # worse than no remedy: it sends the operator to repair a component that
            # is not broken, and the real cause stays unfixed.
            printf '%s\n' "  cause: not established for rc=$rc — read oc-ledger's own message above; it names the real fault. Do NOT repair KINDS on the strength of this warning." >&2 ;;
        esac
      fi
    fi
  fi
}
journal_summary() { # call before exit: one line if any journal write was lost
  [ "$JOURNAL_FAILS" -gt 0 ] || return 0
  printf '%s\n' "oc-ship-chain: $JOURNAL_FAILS journal line(s) lost for $CHAIN (see the first warning above)" >&2
}

# ---- pre-flight -----------------------------------------------------------
[ -d "$FORK_REPO/.git" ] || die "fork checkout not found: $FORK_REPO" 3

# ---- actor defaulting (v0.4.152 §Attribution & Goal Hygiene A1) ------------
# A tool that ALREADY KNOWS the owning session MUST default the actor to it —
# an `(unattributed — pass --by or export OC_ACTOR)` row is a TOOL defect, not
# lane sloppiness (fleet-directives.md §Attribution & Goal Hygiene A1, owner
# order 2026-09-12).
# This chain is handed the commit it is shipping (--sha), and every editor
# commit carries a `Session-Id: <full-uuid>` trailer (SKILL.md §Session-notify
# loop) — so the owning session is ON DISK, inside a sha the chain already
# holds. 34 unattributed rows landed in the 2026-09-12 night shift (n=3515
# class) with that very trailer sitting in the commit being shipped.
# Precedence: an explicit OC_ACTOR WINS (the caller knows better than a
# trailer) -> the --sha Session-Id trailer -> nothing invented, so oc-ledger
# keeps its loud unattributed message instead of a fabricated actor.
# Placed here deliberately: after the fork repo is proven to exist (so `git
# log` can run at all) and BEFORE the first journal() write, so every row of
# the run carries the actor.
ship_chain_default_actor() {
  if [ -n "${OC_ACTOR:-}" ]; then return 0; fi
  local t=""
  t="$(git -C "$FORK_REPO" log -1 --format='%(trailers:key=Session-Id,valueonly)' "$SHA" 2>/dev/null || true)"
  t="$(printf '%s\n' "$t" | grep -E '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' | tail -1 || true)"
  if [ -z "$t" ]; then return 0; fi
  export OC_ACTOR="$t"
  journal "actor defaulted to $OC_ACTOR (v0.4.152 A1 — from --sha Session-Id trailer; OC_ACTOR was unset)"
}
ship_chain_default_actor
# resolve the worktree that actually holds main (this repo may be a secondary
# ---- pre-flight: state dir & landing lock helpers --------------------------
STATE_DIR="${OC_DEPLOY_STATE_DIR:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}"
SHIP_LOCK_FILE="$STATE_DIR/ship.lock"
SHIP_LOCK_FD=200
LOCK_HELD=0

release_ship_lock() {
  if [ "$LOCK_HELD" = "1" ]; then
    journal "SHIP-LOCK released"
    eval "exec ${SHIP_LOCK_FD}>&-" 2>/dev/null || true
    LOCK_HELD=0
  fi
}

acquire_ship_lock() {
  local timeout="${1:-600}"
  local start_ts now elapsed
  # Skip lock in selftest / test override mode if requested
  [ "${OC_SKIP_SHIP_LOCK:-0}" = "1" ] && return 0
  mkdir -p "$STATE_DIR"
  eval "exec ${SHIP_LOCK_FD}>\"\$SHIP_LOCK_FILE\"" 2>/dev/null || true
  
  start_ts="$(date +%s)"
  if flock -n "$SHIP_LOCK_FD" 2>/dev/null; then
    LOCK_HELD=1
    journal "SHIP-LOCK acquired immediately (uncontended)"
    printf '%s\n' "oc-ship-chain: landing lock acquired (uncontended)" >&2
    return 0
  fi

  journal "SHIP-LOCK contended — waiting in queue (timeout=${timeout}s)..."
  printf '%s\n' "oc-ship-chain: landing lock contended — waiting in queue..." >&2

  while true; do
    if flock -n "$SHIP_LOCK_FD" 2>/dev/null; then
      LOCK_HELD=1
      now="$(date +%s)"
      elapsed=$((now - start_ts))
      journal "SHIP-LOCK acquired after ${elapsed}s wait"
      printf '%s\n' "oc-ship-chain: landing lock acquired after ${elapsed}s" >&2
      return 0
    fi
    now="$(date +%s)"
    elapsed=$((now - start_ts))
    if [ "$elapsed" -ge "$timeout" ]; then
      journal "SHIP-LOCK timeout after ${elapsed}s (budget ${timeout}s)"
      printf '%s\n' "oc-ship-chain: landing lock timeout after ${elapsed}s (budget ${timeout}s)" >&2
      die "SHIP-LOCK-TIMEOUT: another ship held the landing lock for the whole ${timeout}s queue budget. This is NOT an infrastructure fault and the gate is NOT broken — do NOT re-dispatch the gate (that burns another full gate cycle for the same answer). The holder is serializing LEG3+LEG4+LEG5, i.e. a real carrier build; re-run the chain once it finishes, or raise the budget with SHIP_LOCK_TIMEOUT=<sec> (or OC_SHIPCHAIN_LOCK_WAIT=<sec>)." 9
    fi
    sleep 1
  done
}

