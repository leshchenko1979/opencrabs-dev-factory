# NORMALISE an abbreviated --sha to the full 40-char commit id (#495, lane
# 2fbfb2f8 report). Nothing between argument parsing and the LEG1 dispatch
# resolved an abbreviation, so `--sha a32eebf8b` reached oc-prchecks, which
# refused it — correctly — as "short sha refused (carrier inputs are
# FULL-sha-bound; got 9 chars)". The chain then discarded that specificity and
# died rc 2 telling the lane the branch/sha was "not usable on the fork remote;
# push it and re-run" with the SAME abbreviation, so the printed remediation
# reproduced the identical failure forever and the lane spent a cycle
# investigating remote state that was already correct. The ref is already proven
# to resolve by the check immediately above, so resolving it here is free and
# every downstream consumer (gate dispatch, docs-only range, journal, the rc-2
# message and its re-run line) then works from ONE canonical full sha.
if [ "${#SHA}" -ne 40 ] && [ "${OC_SHIPCHAIN_SHA_AS_IS:-0}" != "1" ]; then
  FULL_SHA="$(git -C "$FORK_REPO" rev-parse --verify -q "$SHA^{commit}" 2>/dev/null || true)"
  if [ -n "$FULL_SHA" ]; then
    journal "sha '$SHA' is a ${#SHA}-char abbreviation — resolved to full $FULL_SHA (#495)"
    printf 'oc-ship-chain: --sha %s is a %d-char abbreviation; resolved to the full 40-char %s\n' \
      "$SHA" "${#SHA}" "$FULL_SHA" >&2
    SHA="$FULL_SHA"
  fi
fi
# OC_SHIPCHAIN_SHA_AS_IS=1 is the selftest hook that suppresses the normalisation
# above, so the rc-2 message split stays testable once the abbreviation no
