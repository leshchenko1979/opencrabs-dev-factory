#!/usr/bin/env bash
# =============================================================================
# oc-artifact-verify — the SWAP GATE. Verify a downloaded quick-build artifact
# before it may replace the live binary (tools/archive/compiler.md Step 3 items 2-3).
#
# Checks (each a hard gate):
#   1. EXISTS     — file present, readable, size > 0                   (else 2)
#   2. ELF        — 'file' says ELF 64-bit (fallback: od magic 7f ELF)(else 2)
#   3. IDENTITY   — sha256sum computed and RECORDED as the artifact's identity
#                   (recorded-identity model: does NOT have to equal the
#                   installed binary — a real update changes bytes)   (evid)
#   4. SANITY     — ./bin --version runs (execution SANITY signal only,
#                   decorative output, never build identity)         (evid)
#   5. PRESENCE   — S1 gate: every --marker must appear in the binary
#                   (strings|grep). NOT FOUND -> NO SWAP               (else 3)
#   6. --expect-sha mismatch                                           (else 4)
#   7. --run-id given + --source: job-name embed must contain source_ref
#                   (provenance chain; headSha is carrier tip, never trusted)
#                                                                       (else 4)
#
# Exit codes: 0 PASS | 1 invocation | 2 NOT-ELF/MISSING | 3 MARKER-MISSING |
#             4 SHA/PROVENANCE-MISMATCH | 5 VERSION-MISMATCH
#
# Deps: gh (only for --run-id), jq (only for --json), file or od, sha256sum,
#       strings or grep -a.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-artifact-verify" "$@"; else oc_log_finish() { :; }; fi
_OC_EMBED="$OC_TOOLS_DIR/lib/oc-embed.sh"
[ -f "$_OC_EMBED" ] && source "$_OC_EMBED"   # single embed decoder (E2 finding 3, v0.4.72)
trap 'oc_log_finish $?' EXIT

REPO="${OC_REPO:-leshchenko1979/opencrabs}"
SOURCE=""      # source_ref sha the artifact was built from (authentication)
RUN_ID=""      # run id for provenance via job-name embed
MARKERS=""     # comma-separated static markers (S1 presence gate)
EXPECT_SHA=""  # optional strict sha256 comparison
EXPECT_VER=""  # optional strict --version comparison
JSON_OUT=0
VERBOSE=0

fail() { echo "oc-artifact-verify: $2" >&2; exit "$1"; }
say()  { [ "$VERBOSE" = 1 ] && echo "$*" >&2 || true; }

usage() {
  echo "Usage: oc-artifact-verify <artifact-path> [--source <sha>] [--run-id <id>] [--markers m1,m2] [--expect-sha <sha256>] [--expect-version <v>] [--repo R] [--json] [--verbose] [--selftest]" >&2
  echo "Exit: 0 PASS | 1 invocation | 2 NOT-ELF/MISSING | 3 MARKER-MISSING | 4 SHA/PROVENANCE-MISMATCH | 5 VERSION-MISMATCH" >&2
}

selftest() {
  local passed=0 total=9 rc d jout
  d="$(mktemp -d)"
  printf '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00\x01\x00\x00\x00' > "$d/fake-bin-x64"
  printf 'SOME_MARKER_ABC123\nregular text\n' >> "$d/fake-bin-x64"
  # #401 fixture: the SAME three words as the phrase below, but NOT contiguous.
  # This is the file that reddens if the word-split bug ever returns: the old
  # code turned the phrase into three single words, so it PASSED on a binary
  # that never contained the phrase.
  printf '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00\x01\x00\x00\x00' > "$d/fake-bin-split"
  printf 'attempting\nbounded\nreclaim\n' >> "$d/fake-bin-split"
  printf 'attempting bounded reclaim\n' >> "$d/fake-bin-x64"
  printf '#!/bin/sh\necho 0.3.83-fake\n' > "$d/fake-ver"
  chmod +x "$d/fake-ver" 2>/dev/null
  "$0" "$d/fake-bin-x64" --markers SOME_MARKER_ABC123 >/dev/null 2>&1;      rc=$?; [ "$rc" = 0 ] && passed=$((passed+1))
  "$0" "$d/fake-bin-x64" --markers NO_SUCH_MARKER >/dev/null 2>&1;           rc=$?; [ "$rc" = 3 ] && passed=$((passed+1))
  "$0" "$d/fake-bin-x64" --expect-sha 0000000000000000000000000000000000000000 >/dev/null 2>&1; rc=$?; [ "$rc" = 4 ] && passed=$((passed+1))
  "$0" "$d/nonexistent" >/dev/null 2>&1;                                     rc=$?; [ "$rc" = 2 ] && passed=$((passed+1))
  # #401 (2026-09-19, Toolsmith): a marker is a WHOLE PHRASE; the COMMA is the
  # only separator. Four legs pin that semantics.
  # (5) the contiguous phrase IS present -> pass
  "$0" "$d/fake-bin-x64" --markers "attempting bounded reclaim" >/dev/null 2>&1; rc=$?; [ "$rc" = 0 ] && passed=$((passed+1))
  # (6) THE DISCRIMINATOR: same words, not contiguous -> MUST fail. Reddens on
  # the word-split regression (three common words each present -> old code said 0).
  "$0" "$d/fake-bin-split" --markers "attempting bounded reclaim" >/dev/null 2>&1; rc=$?; [ "$rc" = 3 ] && passed=$((passed+1))
  # (7) whitespace AROUND a comma-separated item is trimmed -> both found
  "$0" "$d/fake-bin-x64" --markers " SOME_MARKER_ABC123 , regular text " >/dev/null 2>&1; rc=$?; [ "$rc" = 0 ] && passed=$((passed+1))
  # (8) ...but a comma still SEPARATES: three single words on the split fixture pass
  "$0" "$d/fake-bin-split" --markers "attempting, bounded, reclaim" >/dev/null 2>&1; rc=$?; [ "$rc" = 0 ] && passed=$((passed+1))
  # (9) the JSON key is the WHOLE phrase, not three word-keys (the shape the
  # defect report saw: {"bounded":12,"reclaim":10,"attempting":9})
  jout="$("$0" "$d/fake-bin-x64" --markers "attempting bounded reclaim" --json 2>/dev/null)"
  grep -qF '"attempting bounded reclaim"' <<< "$jout" && passed=$((passed+1))
  rm -rf "$d"
  if [ "$passed" = "$total" ]; then
    echo "selftest OK: $passed/$total cases (no network)"
  else
    echo "selftest FAIL: $passed/$total cases (no network)" >&2
  fi
  [ "$passed" = "$total" ]
  [ "$passed" = "$total" ]
}

BIN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --source)      SOURCE="$2"; shift 2 ;;
    --run-id)      RUN_ID="$2"; shift 2 ;;
    --markers)     MARKERS="$2"; shift 2 ;;
    --expect-sha)  EXPECT_SHA="$2"; shift 2 ;;
    --expect-version) EXPECT_VER="$2"; shift 2 ;;
    --repo)        REPO="$2"; shift 2 ;;
    --json)        JSON_OUT=1; shift ;;
    --verbose)     VERBOSE=1; shift ;;
    --selftest)    selftest; exit $? ;;
    -h|--help)     usage; exit 0 ;;
    *)
      if [ -z "$BIN" ]; then BIN="$1"; else usage; exit 1; fi
      shift ;;
  esac
done

[ -n "$BIN" ] || fail 1 "missing <artifact-path>"
[ -f "$BIN" ] || fail 2 "artifact not found: $BIN"
[ -s "$BIN" ] || fail 2 "artifact is empty: $BIN"

# ---- 2. ELF ----------------------------------------------------------------
ELF_OK=0
if command -v file >/dev/null 2>&1; then
  file -b "$BIN" | grep -q 'ELF 64-bit' && ELF_OK=1
else
  [ "$(head -c4 "$BIN" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ] && ELF_OK=1
fi
[ "$ELF_OK" = 1 ] || fail 2 "artifact is not an ELF 64-bit binary (swap gate: build artifact only)"

# ---- 3. IDENTITY (recorded) ------------------------------------------------
SHA256="$(sha256sum "$BIN" | awk '{print $1}')"
[ -n "$SHA256" ] || fail 2 "sha256sum failed on $BIN"

# ---- 4. SANITY -------------------------------------------------------------
VER_OUT="$( "$BIN" --version 2>&1 | head -1 )"
if [ -n "$EXPECT_VER" ]; then
  # containment match: banners drift ("opencrabs 0.3.83", "0.3.83", "v0.3.83"…) —
  # the version string must APPEAR in the first --version line, not equal it
  grep -qF "$EXPECT_VER" <<< "$VER_OUT" \
    || fail 5 "VERSION-MISMATCH: --version printed '$VER_OUT' (no '$EXPECT_VER')"
fi

# ---- 5. PRESENCE (S1 gate) -------------------------------------------------
declare -A MARK_FOUND
if [ -n "$MARKERS" ]; then
  # #401: a marker is a WHOLE PHRASE; the COMMA is the only separator. The old
  # `for m in $(printf '%s' "$MARKERS" | tr ',' ' ')` was an UNQUOTED command
  # substitution, so it word-split on IFS whitespace AS WELL AS on the
  # translated commas: `--markers "attempting bounded reclaim"` became THREE
  # markers, each a common English word, and the S1 gate reported pass:true for
  # a phrase the artifact never contained — a FALSE PASS on the swap gate, on
  # the natural marker for a multi-word feature (#321's live marker is
  # "attempting bounded reclaim" where the pre-fix code says "attempting
  # VACUUM"; split, it can no longer tell fixed from unfixed). Split on the
  # comma ONLY, trimming whitespace AROUND each item so `--markers "m1, m2"`
  # keeps working, while preserving whitespace INSIDE a phrase.
  _oc_marker_ifs="$IFS"
  IFS=','
  for m in $MARKERS; do
    m="$(printf '%s' "$m" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -n "$m" ] || continue
    if command -v strings >/dev/null 2>&1; then
      c="$(strings "$BIN" | grep -cF "$m" 2>/dev/null || true)"
    else
      c="$(grep -acF "$m" "$BIN" 2>/dev/null || true)"
    fi
    MARK_FOUND["$m"]="$c"
    [ "${c:-0}" -ge 1 ] || fail 3 "MARKER-MISSING: '$m' NOT FOUND in artifact (S1 gate) — NO SWAP, report 'feature missing from build'"
  done
  IFS="$_oc_marker_ifs"
fi

# ---- 6. --expect-sha -------------------------------------------------------
if [ -n "$EXPECT_SHA" ]; then
  [ "$SHA256" = "$EXPECT_SHA" ] || fail 4 "SHA-MISMATCH: artifact $SHA256 != expected $EXPECT_SHA"
fi

# ---- 7. provenance (run-id -> job-name embed -> source) --------------------
SRC_MATCH="not-checked"
if [ -n "$RUN_ID" ] && [ -n "$SOURCE" ]; then
  printf '%s' "$SOURCE" | grep -Eq '^[0-9a-fA-F]{40}$' || fail 1 "source_ref must be a FULL 40-char sha"
  # select the JOB whose name carries the "(<sha>, <features>)" embed via the
  # SHARED decoder (lib/oc-embed.sh) — first job whose name decodes non-empty
  # (the ORDER gates job has no comma after the sha, so it decodes empty).
  JOB=""
  EMBED=""
  while IFS= read -r jn; do
    [ -n "$jn" ] || continue
    EMBED="$(oc_decode_job_embed "$jn")"
    if [ -n "$EMBED" ]; then JOB="$jn"; break; fi
  done <<EOF
$(gh run view "$RUN_ID" -R "$REPO" --json jobs 2>/dev/null | jq -r '.jobs[] | .name')
EOF
  [ -n "$JOB" ] || fail 4 "PROVENANCE: no embed-carrying job (name with '(<sha>,' pattern) for run $RUN_ID"
  E="${EMBED%%|*}"
  if [ "$E" = "$SOURCE" ] || { [ -n "$E" ] && [ "${E:0:12}" = "${SOURCE:0:12}" ]; }; then
    SRC_MATCH="verified"
  else
    SRC_MATCH="MISMATCH"
    fail 4 "PROVENANCE-MISMATCH: run $RUN_ID job embed sha ${E:-none} != source $SOURCE (headSha is carrier tip — never identity)"
  fi
elif [ -n "$SOURCE" ] && [ -z "$RUN_ID" ]; then
  SRC_MATCH="unverified-no-run-id"
fi

if [ "$JSON_OUT" = 1 ]; then
  {
    printf '{"pass":true,"artifact":"%s","elf64":true,"sha256":"%s","version":"%s","source_match":"%s","markers":{' "$BIN" "$SHA256" "$VER_OUT" "$SRC_MATCH"
    first=1
    for m in "${!MARK_FOUND[@]}"; do
      [ "$first" = 1 ] || printf ','
      first=0
      printf '"%s":%s' "$m" "${MARK_FOUND[$m]}"
    done
    printf '}}'
  } | jq .
fi
exit 0