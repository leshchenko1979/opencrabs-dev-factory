# ---- #355 GATE-BEFORE-LAND helpers ----------------------------------------
# `ship`'s push leg LANDS a sha on fork main. Until #355 it did so with NO gate
# consult, and a sha whose PR-lane gate was still IN FLIGHT reached the tip
# (2026-09-18, ee4f6797a): fork main went clippy-RED and every lane inherited a
# BASE-FAULT it did not own. These two helpers implement the guard, reusing
# oc-ship-chain's --gated-run / --gated-sha vocabulary (DRY — one gate
# vocabulary in the fleet, never a second) and the tool's OWN patch-id idiom
# (line ~238's lineage twin) for the content-identical-rebase carry.
#
# gate_verdict_for_run prints, to stdout, exactly one of:
#   green    the named run concluded success
#   red      the named run reached a terminal non-success conclusion
#   inflight the named run has not reached a terminal state
#   unknown  the run could not be read (API failure, absent id)
gate_verdict_for_run() {
  local rid="${1:-}" json st cl
  [ -n "$rid" ] || { printf 'unknown'; return 0; }
  json="$("$GH" api "repos/$FORK/actions/runs/$rid" 2>/dev/null || true)"
  [ -n "$json" ] || { printf 'unknown'; return 0; }
  st="$(printf '%s' "$json" | jq -r '.status // empty' 2>/dev/null)"
  cl="$(printf '%s' "$json" | jq -r '.conclusion // empty' 2>/dev/null)"
  case "$st" in
    completed)
      case "$cl" in
        success) printf 'green' ;;
        *)       printf 'red' ;;
      esac ;;
    queued|in_progress|waiting|pending|requested) printf 'inflight' ;;
    *) printf 'unknown' ;;
  esac
}

# oc_deploy_same_patch: content-identity, the same test the chain applies when
# it carries a gate forward across a rebase (Duty-4 n=2520).
oc_deploy_same_patch() {
  local a="${1:-}" b="${2:-}" pa pb repo
  [ -n "$a" ] && [ -n "$b" ] || return 1
  repo="${OC_DEPLOY_REPO:-${HOME:-/root}/opencrabs}"
  pa="$(git -C "$repo" show "$a" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}')"
  pb="$(git -C "$repo" show "$b" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}')"
  [ -n "$pa" ] && [ "$pa" = "$pb" ]
}

