#!/usr/bin/env bash
# =============================================================================
# oc-deploy — fleet ship/poll/swap script (target-process-20260827.md).
#
# ONE script for the ship -> build -> deploy loop, run as a background task
# from the invoking agent (owner directive 2026-08-27 19:17Z: ship 2+3 and
# poll 8-17 are the SAME script; the agent launches it, the runtime injects
# the result). Replaces compiler dispatch+poll duties per staged plan:
#   S0 inert (plan-only) -> S1 shadow ship (dispatch live, swaps stay
#   compiler) -> S2 pilot swap -> S3 cutover (DONE 2026-08-28: compiler
#   retired; poll = THE deploy path; runbook = tools/archive/compiler.md archived).
#
#   oc-deploy ship [--sha <40-hex>] [--features <set>] [--execute]
#   oc-deploy poll [--execute]
#   oc-deploy swap-execute --sha <40-hex> --run <id> [--features F]
#                          [--artifact-dir D] [--drill]        # Phase B
#   oc-deploy watch [--with-delta]       # stray-commit tripwire (report-only)
#                                        # + optional upstream arithmetic leg
#   oc-deploy status [--json]            # read-only deployment / daemon state summary
#   (contributors RETIRED v0.4.91 — use oc-attrib --contributors)
#   oc-deploy fanout --run <id> [--dry-run]   # issue #24: mechanical notify fan-out
#   oc-deploy lineage-check [--prev P] [--sha S] [--repo R] [--json]
#                                        # read-only swap-guard verdict (v0.4.151)
#   oc-deploy recover-receipt [--journal J] [--run R] [--sha S] [--dry-run] [--historical] [--json]
#                                        # repair a truncated swap's missing ledger row (v0.4.153)
#                                        # v0.4.157: --run/--sha SELECT the journal they name.
#                                        # A selector matching nothing REFUSES (rc 2) — it never
#                                        # falls back to the newest journal (pre-v0.4.157 it did,
#                                        # and echoed the caller's run beside another run's journal).
#                                        # Several matches: the one still lacking a receipt step
#                                        # wins; still ambiguous -> rc 2, name one with --journal.
#                                        # repair a truncated swap's missing ledger row (v0.4.153)
#   oc-deploy --selftest
#
# S2 WIRING — swap-execute runs under a transient unit so the bounce it triggers
#   cannot kill its own verifier; poll --execute hands off to that unit and exits
#   BEFORE any bounce (Phase A/B split). Journal file + per-step vocabulary, the
#   marker write, the ledger stamp, auto-rollback and the retired consent gate are
#   specified in s2-swap-journal-spec.md — that file is the register, this header is
#   not. (2026-08-28, owner tool-logging law.)
#
# LINEAGE GUARD — refuses to install an incoming sha that does not CARRY the
#   currently deployed change (stops a stale/delayed build regressing the live
#   binary). Four verdicts: monotonic / rewritten (same patch-id, accepted as
#   rewrite-equivalent-swap) / absent (rc 2, OC_DEPLOY_SWAP_GUARD=stale-build) /
#   unknown (guard skipped). FULL register — patch-id rules, the audited
#   --allow-rewritten-lineage escape hatch and the lineage-check diagnosis verb —
#   is the oc-deploy row in tools/docs/RC-CONTRACT.md.
#   NEVER hand-edit deployed.sha to re-point around a refusal: that is exactly the
#   regression this guard exists to catch.
#
# RESTART SURVIVAL / CGROUP SAFETY (v0.4.153) — a DIRECT swap-execute inherits the
#   launcher's cgroup; if that launcher is a session hosted by the unit being
#   bounced, step 8's restart SIGKILLs the swap AT the restart line and steps 9-12
#   (post-verify, sidecar-sync, receipt, fanout) never run — the host is swapped and
#   the ledger is SILENT, because the swap-result stamp is deliberately LAST (F-M1).
#   FIX: swap-execute re-execs under a transient scope outside the bounce cgroup
#   BEFORE any work (pre-lock); the detach MUST block and pass the child's rc
#   through — a non-blocking launcher returns 0 and a refusal would read as success.
#   Repair verb + full evidence: tools/docs/RC-CONTRACT.md (oc-deploy row,
#   "Restart survival / cgroup safety").
#
# ABORT & SAFETY LEVERS — kill file, plan-only default, S2 stage gate and the
#   shadow journal are lane procedure: see editor-ship.md §Abort & safety levers.
#   In one line each: the kill file aborts EVERY invocation first (rc 9, selftest
#   included); nothing is dispatched or swapped without --execute; swap actions need
#   stage >= S2; $STATE_DIR/oc-deploy-shadow.log records every run.
#

# Exit codes: 0 ok/noop | 1 usage | 2 rebase/gate/push/verify/rollback fail
#             / watch stray | 3 retired (was consent) | 4 stage gate / launch fail
#             | 5 poll --wait timeout (C-#2) | 9 kill file
# Deps: git, gh, jq, curl; oc-verify-order (ship execute);
#       oc-verify-artifact + oc-seal (swap-execute real mode)
# =============================================================================
#
# --- FOUR-WAY SPLIT (owner order, plan task T5-bis) ---------------------------
# This file used to be the whole tool: 2,768 lines doing four unrelated jobs.
# It is now a DISPATCHER over four tools that each own ONE stage of the
# pipeline, so a change to one stage stops dragging the other three through
# review:
#
#   tools/ship/oc-build    ship + features     dispatch a carrier build
#   tools/ship/oc-swap     swap-execute        install a verified artifact
#   tools/ship/oc-fanout   fanout              post-CI notifications (#24)
#   tools/ship/oc-status   status + poll + watch   read state, hand off
#   tools/lib/oc-deploy-lib.sh                 the SHARED body they all source
#
# Every function moved VERBATIM (byte-slices, no rewrites, no rc re-mapped).
# Each tool's header names the exact source line ranges it owns. The selftest
# is still ONE suite (tests/deploy-selftest.sh) and every arm can run it.
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -uo pipefail
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-deploy" "$@"; else oc_log_finish() { :; }; fi
# The dispatcher sources the shared body for the verbs it answers IN-PROCESS
# (contributors, lineage-check, recover-receipt, --selftest) and for `die`.
_OC_DEPLOY_LIB="$OC_TOOLS_DIR/lib/oc-deploy-lib.sh"
if [ -f "$_OC_DEPLOY_LIB" ]; then
  . "$_OC_DEPLOY_LIB"
else
  printf 'oc-deploy: %s missing (broken LOCAL TOOL TREE, not a test result)\n' "$_OC_DEPLOY_LIB" >&2
  exit 2   # (#932 discipline) a box fault, never a silent 0 or a bare 127
fi
trap 'oc_log_finish $?' EXIT

usage() {
  cat <<'USAGE'
usage: oc-deploy ship [--sha S] [--features F] [--execute] [--gated-run ID]
                      [--gated-sha SHA] [--allow-ungated-push "<justification>"]
                      [--allow-features-drop] [--priority low|normal]
                      [--resolve-priority]
       oc-deploy poll [--execute] [--wait N] [--notify-session UUID]
       oc-deploy swap-execute --sha S --run R [--features F] [--artifact-dir D]
                      [--drill] [--allow-features-drop]
                      [--allow-rewritten-lineage "<justification>" [--actor A]]
       oc-deploy fanout --run R [--dry-run]
       oc-deploy watch [--with-delta]
       oc-deploy status [--json]
       oc-deploy lineage-check [--prev P] [--sha S] [--repo R] [--json]
       oc-deploy recover-receipt [--journal J] [--run R] [--sha S] [--dry-run]
                      [--historical] [--json]
       oc-deploy features [--repo P] [--ref B]
       oc-deploy --selftest
       oc-deploy --help

oc-deploy is the DISPATCHER of a four-way split. It routes the verb and execs
the tool that owns that stage:

  ship, features          -> tools/ship/oc-build     (dispatch a carrier build)
  swap-execute            -> tools/ship/oc-swap      (install on the host)
  fanout                  -> tools/ship/oc-fanout    (notify contributors)
  poll, status, watch     -> tools/ship/oc-status    (read state, hand off)
  lineage-check, recover-receipt, contributors
                          -> in-process (tools/lib/oc-deploy-lib.sh)

Every spelling that worked before the split still works here; the argv is passed
through unchanged, and the tool's rc is the process rc (exec, never a wrapper).

Exit codes: 0 ok/noop | 1 usage | 2 rebase/gate/push/verify/rollback fail or
watch stray | 3 retired (was consent) | 4 stage gate / launch fail | 5 poll
--wait timeout (C-#2) | 9 kill file.  (contributors RETIRED — use
oc-attrib --contributors.)  Full contract: tools/docs/RC-CONTRACT.md
USAGE
}

MODE="${1:-}"; [ $# -gt 0 ] && shift
# C-F5 (v0.4.71): --help / -h exits 0 on stdout, before any validation.
# No args and an unknown verb are USAGE (rc 1) — never the kill-file brake's
# rc 9: the brake lives at the top of each REAL-mode arm, in the owning tool.
case "$MODE" in
  ship|features)     TOOL=oc-build ;;
  swap-execute)      TOOL=oc-swap ;;
  fanout)            TOOL=oc-fanout ;;
  poll|status|watch) TOOL=oc-status ;;
  # Verbs whose body lives in the shared library: no stage to route to, so the
  # dispatcher calls them in-process, exactly where it used to.
  contributors)      contributors_run "$@"; exit $? ;;      # RETIRED (v0.4.91)
  lineage-check)     lineage_check_run "$@"; exit $? ;;
  recover-receipt)   recover_receipt_run "$@"; exit $? ;;
  --selftest|selftest) selftest "$@"; exit $? ;;
  -h|--help)         usage; exit 0 ;;
  *)                 usage >&2; die 1 "usage: oc-deploy <verb> [flags] — verbs: ship | poll | swap-execute | fanout | watch | status | lineage-check | recover-receipt | features | --selftest (contributors RETIRED — use oc-attrib --contributors)" ;;
esac
# Hand the ORIGINAL argv to the owning tool, verb included, and EXEC so its rc
# is this process's rc and no second tools-log row is written for the hop.
_TOOL_PATH="$OC_TOOLS_DIR/ship/$TOOL"
[ -x "$_TOOL_PATH" ] || die 2 "$_TOOL_PATH missing (broken LOCAL TOOL TREE, not a test result)"
exec "$_TOOL_PATH" "$MODE" "$@"
