  echo "  use: $ATTRIB --repo <path> --contributors (--range <old>..<new> | --deployed) [--ledger <f>]" >&2
  die 1 "contributors: retired verb — see the oc-attrib command above"
}

# ------------------------------------------------------------- fan-out (#24) --
# issue #24: mechanical post-CI notifications, zero LLM. GREEN leg: one notify
# per contributing session post-swap (oc-attrib --deployed is the compute).
# RED leg: blame attribution + suspect cc (plan task 4). Idempotent via
# $FANOUT_STATE (re-run = no-op); standalone re-runnable. Verb rc != 0 (dead
# uuid) journals skip and moves on — never resurrects, never reaps (#17 class).
# Journal vocabulary fixed in the issue body. Exit: 0 done/noop | 2 usage
# | 3 gh/attrib fetch fail | 4 run not terminal. issue #42: single-flight
# flock per run (acquired BEFORE the idempotence guard, held through the
# mark) — a concurrent sweep exits 0 reason=inflight, never re-notifies.
# Lock files are never unlinked: unlink-while-held splits the lock.
FANOUT_STATE="$STATE_DIR/fanout.state"
# (#623) Bounded re-send for a TRANSIENT notify failure. The dominant case is
# structural, not a fault: this fan-out fires at the swap tail while the daemon
# is still opening its DB, so the A2A gateway is not bound yet. Measured
# 2026-09-27: 18/18 transport errors fell 1-169 s BEFORE a gateway bind, and the
# gateway binds ~7 s after the integrity line -- which itself takes ~2 min on
# the ops DB. `oc_notify_session`'s own retry is ~31.5 s worst case, 3-5x too
# short for that window, so 13.5% of attributed wakes were lost (fanout.state,
# 276 runs: notified=372 skipped=58).
# COST, stated because this fan-out runs INLINE in the swap chain: a transient
# failure now delays the swap-result stamp by up to this budget. The swap itself
# is already complete (binary swapped, markers written) before the fan-out runs,
# so the delay costs chain latency, never correctness. Set to 0 to disable.
# (#623 residual) 180, not 120: the budget must EXCEED the window it covers or
# the tail is uncovered by construction. Measured by an editor lane on its own
# swap -- the 120 s budget was consumed IN FULL and the send still failed
# (+127 s) -- while the window this file's own comment cites runs to 169 s.
NOTIFY_RETRY_BUDGET="${OC_DEPLOY_NOTIFY_RETRY_BUDGET:-180}"
NOTIFY_RETRY_INTERVAL="${OC_DEPLOY_NOTIFY_RETRY_INTERVAL:-15}"
NOTIFY_CMD="${OC_DEPLOY_NOTIFY:-opencrabs}"
NOTIFY_PROFILE="${OC_DEPLOY_PROFILE:-ops}"
REPO_DIR="${OC_DEPLOY_REPO:-$HOME/opencrabs}"

fanout_journal_init() { # $1 = run id
  mkdir -p "$JOURNAL_DIR"
  JF="$JOURNAL_DIR/fanout-$1-$(date +%s)-$$.jsonl"
  : > "$JF"; SEQ=0
}

notify_session() { # $1=uuid $2=title $3=text -> verb rc (0 delivered)
  # E-F4 (v0.4.97): wake logic delegated to lib/oc-notify.sh — single owner of
  # the session-notify exit-code contract + refused_in_flight interrupt retry.
  if [ "${DRYRUN:-0}" = 1 ]; then return 0; fi
  oc_notify_session "$NOTIFY_CMD" "$NOTIFY_PROFILE" "oc-deploy fan-out" "$1" "$2" "$3"
}

fanout_mark_done() { # $1=run $2=verdict $3=notified $4=skipped $5=unowned
  local tmp
  tmp="$(mktemp)" || return 1
  if [ -f "$FANOUT_STATE" ]; then
    jq --arg id "$1" --arg v "$2" --arg at "$(date -u +%FT%TZ)" \
       --argjson n "$3" --argjson s "$4" --argjson u "$5" \
       '.runs[$id] = {verdict:$v, at:$at, notified:$n, skipped:$s, unowned:$u}' \
       "$FANOUT_STATE" > "$tmp" && mv "$tmp" "$FANOUT_STATE"
  else
    jq -cn --arg id "$1" --arg v "$2" --arg at "$(date -u +%FT%TZ)" \
       --argjson n "$3" --argjson s "$4" --argjson u "$5" \
       '{runs:{($id):{verdict:$v, at:$at, notified:$n, skipped:$s, unowned:$u}}}' \
       > "$tmp" && mv "$tmp" "$FANOUT_STATE"
  fi
}

decode_job_sha_any() { # $1=job name -> 40-hex sha from EITHER name shape (#72): the build-job embed "(<sha>, <features>)" or the gates-job bare form "(<sha>)"; empty if none
  local s
  s="$(oc_decode_job_embed "$1" 2>/dev/null | cut -d'|' -f1)"
  [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  printf '%s\n' "${1:-}" | sed -nE 's/.*\(([0-9a-f]{40})\).*/\1/p'
}

run_built_sha() { # $1=run id -> echo sha from the FIRST job name that decodes (ANY shape, ALL jobs scanned — #72); rc 0/3
  local jn s
  while IFS= read -r jn; do
    [ -n "$jn" ] || continue
    s="$(decode_job_sha_any "$jn")" || continue
    [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  done < <("$GH" api "repos/$FORK/actions/runs/$1/jobs" 2>/dev/null | jq -r '.jobs[].name // empty')
  return 3
}

decode_built_sha() { # $1=run id -> echoes 40-hex sha from first decodable job name (any shape — #72); rc 0/3
  run_built_sha "$1"
}

# (#623) verb rc -> journal reason. ONE home, so the journal and the doc cannot
# drift. `dead` is RESERVED for rc 2 (no_route), the only PERMANENT outcome --
# before this, a transport failure and a timeout both journalled as "dead", so
# the durable record asserted an absent lane when the daemon was merely booting.
# Contract: tools/lib/oc-notify.sh:12-15. rc 124 is `timeout`'s own code, NOT in
# that contract: it is reached when the CLI hung AND the A2A fallback also
# failed, which is a distinct and worse condition than a plain transport error.
_notify_reason() { # $1 = verb rc -> reason token
  case "${1:-}" in
    2)   printf 'dead' ;;                 # no_route -- the lane is gone (PERMANENT)
    3)   printf 'refused_in_flight' ;;
    4)   printf 'transport' ;;
    124) printf 'timeout' ;;
    *)   printf 'unknown' ;;
  esac
}

# (#623) rc 2 is PERMANENT: re-sending to a dead uuid cannot help. Everything
# else is transient by construction. rc 0 is not a failure, so it is excluded.
_notify_retryable() { # $1 = verb rc -> rc 0 when a re-send is worth attempting
  case "${1:-}" in
    0|2) return 1 ;;
    *)   return 0 ;;
  esac
}

notify_one() { # $1=uuid $2=role $3=title $4=text $5=run -> journals notified|skip
  local nrc RETRIES=0
  if [ "${DRYRUN:-0}" = 1 ]; then
    jline notified 0 "{\"uuid\":\"$1\",\"run\":\"$5\",\"role\":\"$2\",\"dry_run\":true}"
    NOTIFIED=$((NOTIFIED+1)); return 0
  fi
  notify_session "$1" "$3" "$4"; nrc=$?
  # (#623) Bounded re-send, TRANSIENT codes only. A recovered wake journals the
  # attempt count so a recovery is VISIBLE rather than inferred from silence.
  if [ "$nrc" != 0 ] && _notify_retryable "$nrc" && [ "${NOTIFY_RETRY_BUDGET:-0}" -gt 0 ] 2>/dev/null; then
    local _dl; _dl=$(( $(date +%s) + NOTIFY_RETRY_BUDGET ))
    while [ "$(date +%s)" -lt "$_dl" ]; do
      sleep "${NOTIFY_RETRY_INTERVAL:-15}"
      RETRIES=$((RETRIES+1))
      notify_session "$1" "$3" "$4"; nrc=$?
      [ "$nrc" = 0 ] && break
      _notify_retryable "$nrc" || break
    done
    # Distinguish "still failing after every retry the budget allowed" from
    # "failed once". The first is RECOVERABLE (the gateway may bind later; a
    # sweep can re-drive), the second says the destination is unreachable.
    [ "$nrc" != 0 ] && [ "$(date +%s)" -ge "$_dl" ] && BUDGET_EXHAUSTED=1
  fi
  if [ "$nrc" = 0 ]; then
    if [ "$RETRIES" -gt 0 ]; then
      jline notified 0 "{\"uuid\":\"$1\",\"run\":\"$5\",\"role\":\"$2\",\"retried\":$RETRIES}"
    else
      jline notified 0 "{\"uuid\":\"$1\",\"run\":\"$5\",\"role\":\"$2\"}"
    fi
    NOTIFIED=$((NOTIFIED+1))
  else
    if [ "${BUDGET_EXHAUSTED:-0}" = 1 ]; then
      jline skip 0 "{\"uuid\":\"$1\",\"reason\":\"$(_notify_reason "$nrc")\",\"verb_rc\":$nrc,\"retries\":$RETRIES,\"budget_exhausted\":true,\"budget_secs\":$NOTIFY_RETRY_BUDGET}"
      BUDGET_EXHAUSTED=0
    else
      jline skip 0 "{\"uuid\":\"$1\",\"reason\":\"$(_notify_reason "$nrc")\",\"verb_rc\":$nrc,\"retries\":$RETRIES}"
    fi
    SKIPPED=$((SKIPPED+1))
  fi
}

attrib_at() { # $1=repo $2=sha $3=file $4=line -> culprit sha (empty if unowned)
  local out
  out="$(git -C "$1" blame -L "$4,$4" --porcelain "$2" -- "$3" 2>/dev/null | head -1 | cut -d' ' -f1)" || return 0
  case "$out" in
    *[!0-9a-f]*|"") return 0 ;;
    *) printf '%s' "$out" ;;
  esac
}

green_leg() { # $1=run id $2=built sha — one notify per contributing session
  local run="$1" bsha="$2" prev feat range rows sessions uuid title text nrc
  prev="$(jq -r '.prev_sha // empty' "$DEPLOYED_META" 2>/dev/null)"
  feat="$(jq -r '.features // "-"' "$DEPLOYED_META" 2>/dev/null)"
  range="${prev:-?}..${bsha}"
  local ATTRIB_RC=0 ATTRIB_OUT="" ATTRIB_ERR ATTRIB_SUM
  # E-F3 (v0.4.96, lens E): single projection shape — call oc-attrib --contributors directly,
  # no private awk copy of the TSV projection (column drift in oc-attrib used to re-break fanout).
  # Duty-4 P-01 (v0.4.133): pass --first-parent so upstream merge ancestry is NOT traversed into
  # historical foreign trailers (prevents falsely waking completed lanes on merge syncs).
  # #407: oc-attrib's stderr carries the novelty-filter accounting (raw/replayed/empty/
  # contributing); it is captured rather than discarded so the journal records WHY a range
  # produced no rows. oc-attrib never exits 0 with rows on stdout when it failed.
  ATTRIB_ERR="$(mktemp)" || die 3 "fanout: cannot create stderr capture for oc-attrib"
  ATTRIB_OUT="$("$ATTRIB" --repo "$REPO_DIR" --deployed --ledger "$LEDGER" --contributors --first-parent 2>"$ATTRIB_ERR")" || ATTRIB_RC=$?
  rows="$ATTRIB_OUT"
  ATTRIB_SUM="$(tr '\n' ' ' < "$ATTRIB_ERR" 2>/dev/null | sed 's/[[:space:]]*$//')"
  rm -f "$ATTRIB_ERR"
  if [ "$ATTRIB_RC" -ne 0 ]; then
    jline contributors 3 "{\"range\":\"$range\",\"rc\":$ATTRIB_RC,\"stderr\":$(printf '%s' "$ATTRIB_SUM" | jq -Rs .)}"
    die 3 "fanout: oc-attrib failed (rc=$ATTRIB_RC) for deployed range $range"
  fi
  # #407: rc 0 with ZERO rows is a legitimate green outcome, not a failure — after the
  # novelty filter an all-replayed / all-empty ship leaves nothing to attribute. The
  # filter summary goes to the journal so "no rows" is auditable as "nothing novel"
  # rather than indistinguishable from a silent attrib breakdown.
  if [ -z "$rows" ]; then
    jline contributors 0 "{\"range\":\"$range\",\"novel\":0,\"stderr\":$(printf '%s' "$ATTRIB_SUM" | jq -Rs .)}"
    echo "fanout green: no novel commits in range $range — nothing to notify"
    return 0
  fi
  sessions="$(printf '%s\n' "$rows" | awk -F'\t' '$1 ~ /^[0-9a-fA-F]{8}-[0-9a-fA-F-]{27}$/ {print $1}' | LC_ALL=C sort -u)"
  jline contributors 0 "{\"range\":\"$range\",\"sessions\":[$(printf '%s\n' "$sessions" | sed '/^$/d' | sed 's/.*/"&"/' | paste -sd, -)]}"
  if [ -z "$sessions" ]; then
    echo "fanout green: no session-attributed commits in $range — nothing to notify"
    return 0
  fi
  title="post-swap: ${bsha:0:8} live"
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    text="oc-deploy fan-out: run $run built ${bsha:0:8} is DEPLOYED (features=$feat, range $range). Your commits landed in this ship — please smoke-test your part on the live box. (issue #24 mechanical notify)"
    notify_one "$uuid" contributor "$title" "$text" "$run"
  done <<< "$sessions"
}

red_leg() { # $1=run id $2=run json — RED blame attribution + suspect cc (issue #24)
  local run="$1" runjson="$2"
  local head sha range sites site f l cs culprit cu uuid s title text
  local blamed_json suspect_json suspects cap tot
  head="$(printf '%s' "$runjson" | jq -r '.head_sha // empty')"
  echo "$head" | grep -Eq '^[0-9a-f]{40}$' || die 3 "fanout red: no usable head_sha for run $run"
  git -C "$REPO_DIR" fetch -q "$REMOTE" main 2>/dev/null || true
  git -C "$REPO_DIR" fetch -q "$REMOTE" "$head" 2>/dev/null || true   # PR head shas live off-main
  range="$(git -C "$REPO_DIR" rev-list --first-parent -n 21 "$head" 2>/dev/null | tail -1)" || true
  [ -n "$range" ] || die 3 "fanout red: cannot resolve commit range for $head"
  range="${range}..${head}"
  # sites from check-run annotations (file:line pairs)
  sites="$("$GH" api "repos/$FORK/actions/runs/$run/jobs" 2>/dev/null \
    | jq -r '.jobs[] | select(.conclusion=="failure") | .check_run_url' \
    | while IFS= read -r u; do
        [ -n "$u" ] || continue
        "$GH" api "${u#https://api.github.com/}/annotations" 2>/dev/null || printf '[]'
      done \
    | jq -r '.[]? | "\(.path):\(.start_line)"' 2>/dev/null | LC_ALL=C sort -u)" || true
  if [ -z "$sites" ]; then
    # zero-site fallback: every session in the run range + HUMAN-FLAG
    jline attributed 0 "{\"run\":\"$run\",\"owner\":\"-\",\"blamed\":[],\"suspect\":[],\"fallback\":\"no-sites\"}"
    title="CI RED: run $run — human review needed"
    text="oc-deploy fan-out: run $run FAILED with no parseable file:line annotations (HUMAN-FLAG). Sessions active in range ${range:0:19}…: $(git -C "$REPO_DIR" log --format='%b' "$range" 2>/dev/null | grep -Eo '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | LC_ALL=C sort -u | paste -sd' ' -). Blame attribution impossible from annotations — inspect the run manually. (issue #24 mechanical notify)"
    while IFS= read -r uuid; do
      [ -n "$uuid" ] || continue
      notify_one "$uuid" contributor "$title" "$text" "$run"
    done <<< "$(git -C "$REPO_DIR" log --format='%H' "$range" 2>/dev/null | while IFS= read -r cs; do oc_session_trailer "$(git -C "$REPO_DIR" log -1 --format='%B' "$cs" 2>/dev/null)"; done | sed '/^$/d' | LC_ALL=C sort -u)"
    return 0
  fi
  # blame each site at head_sha -> culprit sha -> Session-Id trailer
  blamed_json="{}"; UNOWNED_JSON="[]"
  while IFS= read -r site; do
    [ -n "$site" ] || continue
    f="${site%:*}"; l="${site##*:}"
    culprit="$(attrib_at "$REPO_DIR" "$head" "$f" "$l")"
    if [ -z "$culprit" ]; then
      jline unowned 0 "{\"site\":\"$site\",\"run\":\"$run\"}"
      UNOWNED=$((UNOWNED+1)); continue
    fi
    cu="$(oc_session_trailer "$(git -C "$REPO_DIR" log -1 --format='%B' "$culprit" 2>/dev/null)")"
    if [ -z "$cu" ]; then
      jline unowned 0 "{\"site\":\"$site\",\"run\":\"$run\",\"commit\":\"$culprit\"}"
      UNOWNED=$((UNOWNED+1)); continue
    fi
    blamed_json="$(jq -c --arg u "$cu" --arg s "$site" --arg c "${culprit:0:8}" \
      '.[$u] = ((.[$u] // {sites:[],commits:[]}) | .sites += [$s] | .commits += [$c])' <<< "$blamed_json")"
  done <<< "$sites"
  # suspect cc ON: sessions with OTHER commits touching any blamed file in the run range
  suspect_json="{}"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    suspects="$(git -C "$REPO_DIR" log --format='%H' "$range" -- "$f" 2>/dev/null | while IFS= read -r cs; do
      oc_session_trailer "$(git -C "$REPO_DIR" log -1 --format='%B' "$cs" 2>/dev/null)"
    done | sed '/^$/d' | LC_ALL=C sort -u)"
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      suspect_json="$(jq -c --arg u "$s" --arg f "$f" '.[$u] = ((.[$u] // []) + [$f])' <<< "$suspect_json")"
    done <<< "$suspects"
  done <<< "$(jq -r 'keys[] as $k | (.[$k].sites[] | split(":")[0])' <<< "$blamed_json" 2>/dev/null | LC_ALL=C sort -u)"
  suspect_json="$(jq -c --argjson b "$blamed_json" 'with_entries(.key as $k | select($b | has($k) | not))' <<< "$suspect_json")"
  jline attributed 0 "{\"run\":\"$run\",\"owner\":\"-\",\"blamed\":[$(jq -r 'keys[]' <<< "$blamed_json" | sed 's/.*/"&"/' | paste -sd, -)],\"suspect\":[$(jq -r 'keys[]' <<< "$suspect_json" | sed 's/.*/"&"/' | paste -sd, -)],\"detail\":$blamed_json,\"suspect_files\":$suspect_json}"
  # notify culprits (sites capped at 10 in the message; full list is in the journal)
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    cap="$(jq -r --arg u "$uuid" '.[$u].sites[:10] | join(", ")' <<< "$blamed_json")"
    tot="$(jq -r --arg u "$uuid" '.[$u].sites | length' <<< "$blamed_json")"
    if [ "${tot:-0}" -gt 10 ] 2>/dev/null; then cap="$cap (+$((tot-10)) more — full list in journal)"; fi
    cs="$(jq -r --arg u "$uuid" '.[$u].commits | unique | join(", ")' <<< "$blamed_json")"
    title="CI RED: run $run — your commits are blamed"
    text="oc-deploy fan-out: run $run FAILED. git blame at head points at your commit(s) $cs for: $cap. Fix-forward or respond in your lane. (issue #24 mechanical notify)"
    notify_one "$uuid" blamed "$title" "$text" "$run"
  done <<< "$(jq -r 'keys[]' <<< "$blamed_json")"
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    fs="$(jq -r --arg u "$uuid" '.[$u] | unique | join(", ")' <<< "$suspect_json")"
    title="CI RED: run $run — suspect cc"
    text="oc-deploy fan-out: run $run FAILED. Blame points elsewhere, but your commits touched the blamed file(s): $fs. cc only — no action needed unless the culprit is unreachable. (issue #24 mechanical notify)"
    notify_one "$uuid" suspect "$title" "$text" "$run"
  done <<< "$(jq -r 'keys[]' <<< "$suspect_json")"
  return 0
}

fanout_run() { # $1=run id $2=dry-run(0/1)
  local run="${1:-}" runjson status conclusion bsha dep suffix=""
  DRYRUN="${2:-0}"
  [ -n "$run" ] || die 2 "fanout: needs --run <id>"
  echo "$run" | grep -Eq '^[0-9]+$' || die 2 "fanout: run id not numeric: $run"
  fanout_journal_init "$run"
  # issue #42: single-flight flock per run. Advisory lock acquired BEFORE the
  # idempotence guard so guard+deliver+mark are atomic vs. other sweep
  # invocations — a mid-sweep re-run used to pass the guard and re-notify
  # everyone (13:21Z TOCTOU, 12 sessions double-carded). Held on fd 9 through
  # fanout_mark_done; released on process exit on every path (crash-safe,
  # no stale marker, no reaper). exec 9<> = no-truncate open so the holder
  # record survives; flock -n -E 4 = non-blocking, EWOULDBLOCK -> rc 4.
  # Name ENDS in .lock so the state repo's `*.lock` ignore rule matches it.
  # `fanout.lock.$run` ended in the run id and was UN-IGNORABLE by
  # construction: 12 such locks ended up tracked. Every other lock here
  # (LEDGER.lock, host-swap.lock, run/wave-*.lock) ends in .lock.
  local lockfile="$STATE_DIR/fanout.$run.lock"
  # stale-lock reaper (lens D 2026-08-31): holder records pid=; a dead pid +
  # existing file = leftover from a finished fan-out (exit releases flock but
  # intentionally never unlinks — unlink-after-release would let a second
  # process flock a fresh inode and break single-flight). Reap on entry only.
  if [ -f "$lockfile" ]; then
    local stale_pid
    stale_pid="$(grep -o 'pid=[0-9]*' "$lockfile" 2>/dev/null | head -1 | cut -d= -f2)"
    if [ -n "$stale_pid" ] && ! kill -0 "$stale_pid" 2>/dev/null; then
      rm -f "$lockfile"
      jline lock-reaped 0 "{\"run\":\"$run\",\"stale-pid\":\"$stale_pid\"}"
    fi
  fi
  exec 9<>"$lockfile" || die 3 "fanout: cannot open lock $lockfile"
  if ! flock -n -E 4 9; then
    local holder
    holder="$(cat "$lockfile" 2>/dev/null || echo unknown)"
    jline lock-busy 0 "{\"run\":\"$run\",\"holder\":\"$holder\"}"
    echo "fanout-skip run=$run reason=inflight (lock held by $holder)"
    exit 0
  fi
  printf 'pid=%s ts=%s run=%s\n' "$$" "$(date -u +%FT%TZ)" "$run" > "$lockfile"
  jline lock-acquired 0 "{\"run\":\"$run\",\"pid\":$$}"
  # idempotence: a completed fan-out for this run is a no-op
  if [ -f "$FANOUT_STATE" ] && jq -e --arg id "$run" '.runs[$id]' "$FANOUT_STATE" >/dev/null 2>&1; then
    jline skip 0 "{\"run\":\"$run\",\"reason\":\"done\"}"
    echo "fanout-skip run=$run reason=done (idempotent)"
    exit 0
  fi
  runjson="$("$GH" api "repos/$FORK/actions/runs/$run" 2>/dev/null)" \
    || { jline fanout-start 3 "{\"run\":\"$run\",\"error\":\"gh-api-fail\"}"; die 3 "fanout: gh api run fetch failed for $run"; }
  status="$(printf '%s' "$runjson" | jq -r '.status // empty')"
  conclusion="$(printf '%s' "$runjson" | jq -r '.conclusion // empty')"
  [ "$status" = completed ] || { jline fanout-start 4 "{\"run\":\"$run\",\"status\":\"$status\"}"; die 4 "fanout: run $run not terminal (status=$status)"; }
  jline fanout-start 0 "{\"run\":\"$run\",\"conclusion\":\"$conclusion\"}"
  NOTIFIED=0; SKIPPED=0; UNOWNED=0
  case "$conclusion" in
    success)
      bsha="$(decode_built_sha "$run")"
      [ -n "$bsha" ] || { jline fanout-end 3 "{\"run\":\"$run\",\"error\":\"built-sha-decode-fail\"}"; fanout_mark_done "$run" "decode-error" 0 0 0; die 3 "fanout: cannot decode built sha for run $run (marked decode-error — will not block future scans)"; }   # #63 family (v0.4.79): mark, don't re-strike forever
      dep="$(head -1 "$DEPLOYED" 2>/dev/null || echo none)"
      if [ "$bsha" != "$dep" ]; then
        jline fanout-end 0 "{\"run\":\"$run\",\"reason\":\"not-deployed-yet\",\"built\":\"$bsha\",\"deployed\":\"$dep\"}"
        echo "fanout noop: run $run built ${bsha:0:8} not deployed yet (deployed=${dep:0:8}) — re-run after swap (not marked done)"
        exit 0
      fi
      green_leg "$run" "$bsha"
      ;;
    failure) red_leg "$run" "$runjson" ;;
    *)
      jline fanout-end 0 "{\"run\":\"$run\",\"conclusion\":\"$conclusion\",\"reason\":\"non-build-conclusion\"}"
      echo "fanout noop: run $run conclusion=$conclusion (not success/failure)"
      exit 0
      ;;
  esac
  jline fanout-end 0 "{\"run\":\"$run\",\"notified\":$NOTIFIED,\"skipped\":$SKIPPED,\"unowned\":$UNOWNED}"
  [ "$DRYRUN" = 1 ] || fanout_mark_done "$run" "$conclusion" "$NOTIFIED" "$SKIPPED" "$UNOWNED"
  [ "$DRYRUN" = 1 ] && suffix=" (dry-run: not marked done)"
  echo "fanout-end run=$run verdict=$conclusion notified=$NOTIFIED skipped=$SKIPPED unowned=$UNOWNED$suffix"
}

# ------------------------------------------------------------- swap-execute --
# Phase B body (spec: s2-swap-journal-spec.md). Runs under a systemd transient
# in prod; env overrides sandbox every side effect for selftest.
swap_execute() {
  local SHA="$1" RUN_ID="$2" FEATURES="$3" DRILL="$4" ARTDIR="$5" ALLOW_DROP="${6:-0}"
  local SHORT="${SHA:0:8}"
  local STAGE; STAGE="$(stage)"
  [ "$STAGE" = "S2" ] || [ "$STAGE" = "S3" ] || { shadow_log swap "$SHA" "$FEATURES" "stage-gate"; die 4 "swap requires stage >= S2 (current: $STAGE)"; }

  # --- 0. features-compat gate (HQ LAW 2026-09-04, ruling on the 06:36Z rogue
  #     swap: run 33844429519 shipped features="telegram" over a live
  #     "telegram,code-graph" binary and the auto-swap consumed it — structural
  #     memory died silently for 12h. MANDATORY: refuse any artifact whose
  #     feature set DROPS a feature present in deployed.meta.json, unless the
  #     operator passes --allow-features-drop explicitly. Additions are fine;
  #     drops are the failure class. Catches BOTH rogue swaps of 2026-09-03/04.) ---
  if [ "$DRILL" != "1" ] && [ -f "$DEPLOYED_META" ]; then
    local DEP_FEATS MISSING
    DEP_FEATS="$(jq -r '.features // ""' "$DEPLOYED_META" 2>/dev/null || true)"
    if [ -n "$DEP_FEATS" ] && [ "$DEP_FEATS" != "null" ]; then
      MISSING="$(comm -23 \
        <(echo "$DEP_FEATS" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' | sort -u) \
        <(echo "$FEATURES" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' | sort -u))"
      if [ -n "$MISSING" ] && [ "$ALLOW_DROP" != "1" ]; then
        shadow_log swap "$SHA" "$FEATURES" "features-drop-gate"
        die 4 "features-compat gate (HQ law 2026-09-04): requested features '$FEATURES' DROP deployed feature(s): $(echo "$MISSING" | tr '\n' ' ')— live binary has '$DEP_FEATS'. Refusing swap. Pass --allow-features-drop to override deliberately."
      fi
    fi
  fi

  journal_init "$SHORT"
  local BASE_DIR; BASE_DIR="$(dirname "$(readlink -f "$LEDGER")")"
  local BASELINE="$BASE_DIR/baseline.json" ORDERS="$BASE_DIR/orders.json"

  echo "oc-deploy swap-execute: sha=$SHA run=$RUN_ID features=$FEATURES drill=$DRILL stage=$STAGE"
  echo "journal: $JF"

  # --- 1. auto-swap authorization (owner 2026-08-28 18:50Z: consent process
  #     ELIMINATED — GREEN carrier run + artifact verify IS the authorization;
  #     safety = ORDER gates + containment + sha-bound + backup chain. Post-
  #     smoke-FAIL rollback stays the owner's call: NO auto-rollback there.) ---
  jline auto-swap 0 "$(jq -cn --arg s "$SHA" --arg r "$RUN_ID" '{sha:$s, run_id:$r, reason:"green-run", consent:"eliminated-owner-2026-08-28"}')"

  # --- 2. artifact + verify ---
  local WORKDIR BIN EXPECTED SRC_FLAG
  WORKDIR="$(mktemp -d)" || die 2 "mktemp failed"
  # M2-22 (2026-09-12): this WORKDIR holds the downloaded ~83M release artifact
  # + state-backup and was never removed — /tmp reached 11G and the root fs 85%
  # (38 leaked dirs = 3.3G). swap_execute runs inside the subshell opened by the
  # swap-execute arm (the flock wrapper), so a trap set HERE fires when that
  # subshell exits, whether by normal return or by die. The path lives in a
  # NON-LOCAL on purpose: by the time the subshell exits, this function's
  # `local WORKDIR` is out of scope and the trap would rm -rf "" (measured).
  _OC_SWAP_WORKDIR="$WORKDIR"
  trap '[ -n "${_OC_SWAP_WORKDIR:-}" ] && rm -rf "$_OC_SWAP_WORKDIR"' EXIT
  if [ "$DRILL" = "1" ]; then
    # dummy artifact = byte-copy of the RUNNING binary; expected sha set
    # deliberately wrong so post-verify fails and exercises the rollback leg.
    cp "$SWAP_TARGET" "$WORKDIR/opencrabs" || die 2 "drill: cannot copy target"
    BIN="$WORKDIR/opencrabs"
    EXPECTED="deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
    jline verify 0 "$(jq -cn '{drill:true, note:"dummy artifact = copy of running binary; expected sha deliberately wrong; provenance skipped"}')"
  else
    if [ -n "$ARTDIR" ] && [ -d "$ARTDIR" ]; then
      cp -r "$ARTDIR/." "$WORKDIR/" || die 2 "artifact-dir copy failed"
    else
      "$GH" run download "$RUN_ID" --repo "$FORK" -n "opencrabs-linux-amd64-$FEATURES" -D "$WORKDIR" \
        || { jline verify 1 "$(jq -cn --arg r "$RUN_ID" '{run_id:$r, reason:"download-fail"}')"; die 2 "artifact download failed (run $RUN_ID)"; }
    fi
    BIN="$(find "$WORKDIR" -type f -name opencrabs | head -1)"
    [ -n "$BIN" ] || { jline verify 1 "$(jq -cn '{reason:"binary-not-in-artifact"}')"; die 2 "no 'opencrabs' binary inside artifact"; }
    EXPECTED="$(sha256sum "$BIN" | cut -d' ' -f1)"
    SRC_FLAG="$(grep -m1 '^source_ref=' "$WORKDIR/build-flags.txt" 2>/dev/null | cut -d= -f2 || true)"
    local AV_OUT AV_RC
    AV_OUT="$(OC_REPO="$FORK" "$ARTVERIFY" "$BIN" --source "$SHA" --run-id "$RUN_ID" --repo "$FORK" --json 2>&1)"; AV_RC=$?
    if [ "$AV_RC" -ne 0 ] || [ -n "$SRC_FLAG" ] && [ "$SRC_FLAG" != "$SHA" ]; then
      jline verify "${AV_RC:-1}" "$(jq -cn --arg r "$RUN_ID" --arg s "$SRC_FLAG" --arg o "${AV_OUT:0:400}" '{run_id:$r, source_ref:$s, artifact_sha256:$o, reason:"artifact-verify-fail"}')"
      die 2 "oc-artifact-verify FAILED (exit $AV_RC) or source_ref mismatch ($SRC_FLAG != $SHA) — nothing touched"
    fi
    jline verify 0 "$(jq -cn --arg r "$RUN_ID" --arg s "$SHA" --arg a "$EXPECTED" --arg f "$FEATURES" --arg sf "$SRC_FLAG" '{run_id:$r, source_ref:$s, artifact_sha256:$a, features:$f, build_flags_ref:$sf, provenance:"oc-artifact-verify PASS"}')"
  fi

  # --- 3. backup (MUST land before install; skip aborts the swap) ---
  local TS BAK BAK_SHA BAK_BYTES
  TS="$(date -u +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUP_DIR" || die 2 "backup dir missing"
  BAK="$BACKUP_DIR/opencrabs-${TS}-pre-$SHORT"
  cp -p "$SWAP_TARGET" "$BAK" 2>/dev/null || { jline backup 1 "$(jq -cn '{reason:"copy-fail"}')"; die 2 "backup FAILED — swap aborted before install"; }
  BAK_SHA="$(sha256sum "$BAK" | cut -d' ' -f1)"
  BAK_BYTES="$(stat -c %s "$BAK")"
  jline backup 0 "$(jq -cn --arg p "$BAK" --arg s "$BAK_SHA" --argjson b "$BAK_BYTES" '{backup_path:$p, backup_sha256:$s, bytes:$b}')"
  prune_binary_backups "$BAK"

  # --- 4. state backups for rollback (markers + baseline + orders) ---
  mkdir -p "$WORKDIR/state-backup"
  [ -f "$DEPLOYED" ] && cp -p "$DEPLOYED" "$WORKDIR/state-backup/deployed.sha"
  local HAD_META=0; [ -f "$DEPLOYED_META" ] && HAD_META=1
  [ -f "$DEPLOYED_META" ] && cp -p "$DEPLOYED_META" "$WORKDIR/state-backup/deployed.meta.json"
  [ -f "$BASELINE" ] && cp -p "$BASELINE" "$WORKDIR/state-backup/baseline.json"
  [ -f "$ORDERS" ] && cp -p "$ORDERS" "$WORKDIR/state-backup/orders.json"
  local PREV_SHA; PREV_SHA="$(cat "$DEPLOYED" 2>/dev/null || echo none)"
  # double-execution guard (found live 2026-08-31: run 33388930453 executed twice —
  # stall-hit session relaunched the leg after run 1 had already written markers;
  # run 2 then recorded prev_sha == deployed sha, corrupting attribution range).
  if [ "$PREV_SHA" = "$SHA" ]; then
    # v0.4.85 (HQ 2026-09-04): dedup guard is features-aware. Same sha +
    # same features = true double execution, refused. Same sha + DIFFERENT
    # features = legitimate redeploy (incident: rogue telegram-only swap
    # marked sha deployed; codegraph artifact of the SAME commit was then
    # unswappable). Feature-DROP still hard-refused per features-compat law.
    DEP_FEAT="$(jq -r '.features // ""' "$STATE_DIR/deployed.meta.json" 2>/dev/null || true)"
    FEAT_DROP=0
    if [ -n "$DEP_FEAT" ]; then
      IFS=',' read -ra OLD_F <<< "$DEP_FEAT"
      for f in "${OLD_F[@]}"; do
        [ -z "$f" ] && continue
        case ",$FEATURES," in *",$f,"*) ;; *) FEAT_DROP=1 ;; esac
      done
    fi
    if [ "$FEAT_DROP" = 0 ] && [ -n "$DEP_FEAT" ] && [ "$DEP_FEAT" != "$FEATURES" ]; then
      jline guard 0 "$(jq -cn --arg s "$SHA" --arg d "$DEP_FEAT" --arg f "$FEATURES" '{reason:"same-sha-redeploy-feature-change", deployed_features:$d, new_features:$f}')"
      echo "oc-deploy: same-sha redeploy with feature change ($DEP_FEAT -> $FEATURES) — proceeding"
    else
      jline guard 2 "$(jq -cn --arg s "$SHA" --arg d "$DEP_FEAT" --arg f "$FEATURES" '{reason:"already-deployed", deployed_sha:$s, deployed_features:$d, requested_features:$f}')"
      die 2 "swap-execute: $SHA is ALREADY the deployed sha — refusing double execution (if intentional, correct markers manually)"
    fi
  fi

  # Lineage guard (v0.4.148; rebase-aware v0.4.151): ensure the incoming SHA carries the currently
  # deployed change, if both exist in the local repo. Prevents older delayed/retried builds from
  # regressing the live binary. A fork-main rebase REWRITES shas, which orphaned the deployed sha
  # and made the plain ancestry test refuse EVERY legitimate post-rewrite swap — fleet-blocking
  # (reported 2026-09-12). An orphaned deployed commit whose PATCH CONTENT survives in the incoming
  # lineage is now accepted as equivalent; only a genuinely absent change is refused.
  if [ "$PREV_SHA" != "none" ] && [ -n "$PREV_SHA" ] && [ "$DRILL" != "1" ]; then
    LV_REPO="${OC_DEPLOY_REPO:-${HOME:-/root}/opencrabs}"
    LV_OUT="$(lineage_verdict "$LV_REPO" "$PREV_SHA" "$SHA")"
    LV_KIND="${LV_OUT%% *}"; LV_TWIN="${LV_OUT#* }"
    case "$LV_KIND" in
      monotonic)
        : ;;   # fast path — unchanged from v0.4.148
      rewritten)
        jline guard 0 "$(jq -cn --arg s "$SHA" --arg p "$PREV_SHA" --arg t "$LV_TWIN" \
          '{reason:"rewrite-equivalent-swap", current_deployed:$p, incoming_sha:$s, rewritten_twin:$t}')"
        echo "oc-deploy: deployed sha $PREV_SHA was orphaned by a rewrite; its change is preserved as $LV_TWIN in the incoming lineage — accepting" >&2
        ;;
      absent)
        if [ "$ALLOW_REWRITTEN_LINEAGE" = 1 ]; then
          jline guard 0 "$(jq -cn --arg s "$SHA" --arg p "$PREV_SHA" --arg j "$RW_JUSTIFY" --arg a "$RW_ACTOR" \
            '{reason:"rewritten-lineage-override", current_deployed:$p, incoming_sha:$s, justification:$j, actor:$a}')"
          echo "oc-deploy: WARNING — swap guard OVERRIDDEN via --allow-rewritten-lineage (actor=$RW_ACTOR): $RW_JUSTIFY" >&2
        else
          jline guard 2 "$(jq -cn --arg s "$SHA" --arg p "$PREV_SHA" '{reason:"non-monotonic-swap", current_deployed:$p, incoming_sha:$s}')"
          echo "OC_DEPLOY_SWAP_GUARD=stale-build" >&2
          die 2 "swap-execute: incoming sha $SHA does not carry deployed sha $PREV_SHA — refusing stale binary overwrite (diagnose: oc-deploy lineage-check --prev $PREV_SHA --sha $SHA)"
        fi
        ;;
      unknown)
        echo "oc-deploy: lineage guard SKIPPED — $PREV_SHA or $SHA is not an object in $LV_REPO (cannot judge)" >&2 ;;
    esac
  fi

  # --- 5. install (cp to .new, then atomic rename over target) ---
  local OLD_SHA NEW_SHA
  OLD_SHA="$(sha256sum "$SWAP_TARGET" | cut -d' ' -f1)"
  cp "$BIN" "$SWAP_TARGET.new" && chmod +x "$SWAP_TARGET.new" && mv -f "$SWAP_TARGET.new" "$SWAP_TARGET" \
    || { jline install 1 "$(jq -cn '{reason:"install-fail"}')"; die 2 "install failed — backup intact, target untouched or restored manually"; }
  NEW_SHA="$(sha256sum "$SWAP_TARGET" | cut -d' ' -f1)"
  jline install 0 "$(jq -cn --arg o "$OLD_SHA" --arg n "$NEW_SHA" --argjson b "$(stat -c %s "$SWAP_TARGET")" '{old_sha256:$o, new_sha256:$n, bytes:$b, method:"install+mv"}')"

  # --- 6. seal (baseline merge; drill skips) ---
  if [ "$DRILL" = "1" ]; then
    jline seal 0 "$(jq -cn '{drill:true, note:"seal skipped in drill"}')"
  else
    local CYC SEAL_RC
    CYC="$(jq -r '.cycle // 0' "$BASELINE" 2>/dev/null || echo 0)"
    "$SEAL" --baseline "$BASELINE" --orders "$ORDERS" --sha "$SHA" --run-id "$RUN_ID" --binary-sha "$EXPECTED" --features "$FEATURES" --cycle "$((CYC+1))" --set-note "oc-deploy S2 swap" >/dev/null 2>&1; SEAL_RC=$?
    jline seal "$SEAL_RC" "$(jq -cn --arg b "$BASELINE" --argjson c "$((CYC+1))" --argjson e "$SEAL_RC" '{baseline_path:$b, cycle:$c, seal_exit:$e}')"
    [ "$SEAL_RC" -eq 0 ] || die 2 "seal FAILED — new binary on disk, NOT restarted; markers NOT written; manual attention (rollback source: $BAK)"
  fi

  # --- 7. marker writes (between seal and restart — the 03:11Z gap) ---
  printf '%s\n' "$SHA" > "$DEPLOYED.tmp" && mv -f "$DEPLOYED.tmp" "$DEPLOYED" || { jline marker-write 1 "$(jq -cn '{reason:"write-fail"}')"; die 2 "marker write failed"; }
  jq -cn --arg s "$SHA" --arg r "$RUN_ID" --arg a "$EXPECTED" --arg f "$FEATURES" \
     --arg t "$(date -u +%FT%TZ)" --arg p "$PREV_SHA" \
     '{sha:$s, run_id:$r, artifact_sha256:$a, features:$f, swapped_at:$t, auth:"auto-swap", prev_sha:$p}' \
     > "$DEPLOYED_META.tmp" && mv -f "$DEPLOYED_META.tmp" "$DEPLOYED_META" || { jline marker-write 1 "$(jq -cn '{reason:"meta-write-fail"}')"; die 2 "meta marker write failed"; }
  jline marker-write 0 "$(jq -cn --arg p "$DEPLOYED" --arg s "$SHA" '{deployed_sha_path:$p, deployed_sha:$s, wrote:"deployed.sha+deployed.meta.json"}')"

  # --- 8. restart ---
  local RRC
  $RESTART_CMD >/dev/null 2>&1; RRC=$?
  jline restart "$RRC" "$(jq -cn --arg u "opencrabs-ops.service" --argjson e "$RRC" '{unit:$u, systemd_run_exit:$e}')"

  # --- sidecar sync (#47): the default/family daemons run the SAME binary as
  #     ops; a swap that bounces only ops leaves them stale (found live
  #     2026-08-31: default+family were 2 days behind after 3 swaps). After a
  #     GREEN ops post-verify, every active opencrabs-*.service user unit
  #     (primary excluded) whose MainPID exe sha != deployed sha is restarted
  #     and re-verified. NON-FATAL by design: a sidecar that refuses to bounce
  #     is journaled (sidecar-unit exit=1), never fails the swap.
  #     Gates: DRILL -> off; sandbox (non-default SWAP_TARGET) -> off unless
  #     OC_SWAP_SIDECARS=2 (selftest force); unset/0 -> always off (ruling
  #     1273 default; =1 opts a PROD target back in).
  #     Selftest shims: OC_SWAP_SIDECAR_LISTER/SHOW/ACTIVE/RESTART (command per
  #     unit) + OC_SWAP_PROC_PREFIX (fake /proc) + OC_SWAP_PRIMARY_UNIT.
  sidecar_sync() { # $1 = deployed binary sha ; GREEN path only
    local EXP="$1" EN=0 U PID PSHA ACT RRC NPID NSHA
    local RESTARTED=0 INSYNC=0 FAILED=0 DETAIL="[]"
    # Ruling 1273 (HQ, 2026-09-03, canonical): an ops-profile swap
    # restarts opencrabs-ops.service ONLY — sibling daemons legitimately keep
    # the old binary + (deleted) exe. Sidecar sync is therefore OPT-IN
    # (supersedes the 2026-08-31 auto-sync, whose default restart of family
    # violated 1273 during the f3c03269 auto-swap): OC_SWAP_SIDECARS=1 opts in
    # for a PROD target, =2 force-enables (selftest/sandbox), unset/0 = off.
    [ "$DRILL" = "1" ] && EN=0
    case "${OC_SWAP_SIDECARS:-0}" in
      2) EN=1 ;;
      1) [ "$SWAP_TARGET" = "/usr/local/bin/opencrabs" ] && EN=1 ;;
    esac
    if [ "$EN" != "1" ]; then
      jline sidecar-sync 0 '{"skipped":"drill-or-sandbox-or-disabled"}'
      return 0
    fi
    local LIST
    LIST="$( { if [ -n "${OC_SWAP_SIDECAR_LISTER:-}" ]; then "$OC_SWAP_SIDECAR_LISTER"; else systemctl --user list-units --plain --no-legend --all 'opencrabs-*.service' 2>/dev/null | awk '{print $1}'; fi; } 2>/dev/null || true)"
    while IFS= read -r U; do
      [ -n "$U" ] || continue
      [ "$U" = "${OC_SWAP_PRIMARY_UNIT:-opencrabs-ops.service}" ] && continue
      ACT="$( { if [ -n "${OC_SWAP_SIDECAR_ACTIVE:-}" ]; then "$OC_SWAP_SIDECAR_ACTIVE" "$U"; else systemctl --user is-active "$U" 2>/dev/null; fi; } 2>/dev/null || echo unknown)"
      if [ "$ACT" != "active" ]; then
        DETAIL="$(jq -cn --argjson d "$DETAIL" --arg u "$U" --arg a "$ACT" '$d + [{unit:$u, action:"skip-inactive", active:$a}]')"
        continue
      fi
      PID="$( { if [ -n "${OC_SWAP_SIDECAR_SHOW:-}" ]; then "$OC_SWAP_SIDECAR_SHOW" "$U"; else systemctl --user show -p MainPID --value "$U" 2>/dev/null; fi; } 2>/dev/null || echo 0)"
      PSHA=""
      if [ -n "$PID" ] && [ "$PID" != "0" ] && [ -r "${OC_SWAP_PROC_PREFIX:-/proc}/$PID/exe" ]; then
        PSHA="$(sha256sum "${OC_SWAP_PROC_PREFIX:-/proc}/$PID/exe" 2>/dev/null | cut -d' ' -f1)"
      fi
      if [ -z "$PSHA" ]; then
        DETAIL="$(jq -cn --argjson d "$DETAIL" --arg u "$U" --arg p "$PID" '$d + [{unit:$u, action:"skip-no-proc", mainpid:$p}]')"
        continue
      fi
      if [ "$PSHA" = "$EXP" ]; then
        INSYNC=$((INSYNC+1))
        DETAIL="$(jq -cn --argjson d "$DETAIL" --arg u "$U" '$d + [{unit:$u, action:"in-sync"}]')"
        continue
      fi
      # stale sidecar: bounce + re-verify, journal both ways, never fatal
      if [ -n "${OC_SWAP_SIDECAR_RESTART:-}" ]; then "$OC_SWAP_SIDECAR_RESTART" "$U" >/dev/null 2>&1; RRC=$?; else systemctl --user restart "$U" >/dev/null 2>&1; RRC=$?; fi
      NSHA=""
      sleep "${OC_SWAP_SETTLE:-5}"
      NPID="$( { if [ -n "${OC_SWAP_SIDECAR_SHOW:-}" ]; then "$OC_SWAP_SIDECAR_SHOW" "$U"; else systemctl --user show -p MainPID --value "$U" 2>/dev/null; fi; } 2>/dev/null || echo 0)"
      if [ -n "$NPID" ] && [ "$NPID" != "0" ] && [ -r "${OC_SWAP_PROC_PREFIX:-/proc}/$NPID/exe" ]; then
        NSHA="$(sha256sum "${OC_SWAP_PROC_PREFIX:-/proc}/$NPID/exe" 2>/dev/null | cut -d' ' -f1)"
      fi
      if [ "$RRC" -eq 0 ] && [ -n "$NSHA" ] && [ "$NSHA" = "$EXP" ]; then
        RESTARTED=$((RESTARTED+1))
        DETAIL="$(jq -cn --argjson d "$DETAIL" --arg u "$U" --arg o "$PSHA" --arg n "$NSHA" '$d + [{unit:$u, action:"restarted", old_sha:$o, new_sha:$n}]')"
        jline sidecar-unit 0 "$(jq -cn --arg u "$U" --arg o "$PSHA" --arg n "$NSHA" '{unit:$u, action:"restarted", old_sha256:$o, new_sha256:$n}')"
      else
        FAILED=$((FAILED+1))
        DETAIL="$(jq -cn --argjson d "$DETAIL" --arg u "$U" --argjson e "$RRC" --arg n "$NSHA" '$d + [{unit:$u, action:"failed", restart_exit:$e, new_sha:$n}]')"
        jline sidecar-unit 1 "$(jq -cn --arg u "$U" --argjson e "$RRC" --arg n "$NSHA" '{unit:$u, action:"failed", restart_exit:$e, new_sha256:$n}')"
      fi
    done <<< "$LIST"
    jline sidecar-sync 0 "$(jq -cn --argjson d "$DETAIL" --argjson r "$RESTARTED" --argjson c "$INSYNC" --argjson f "$FAILED" '{restarted:$r, in_sync:$c, failed:$f, detail:$d}')"
    echo "SIDECAR SYNC: restarted=$RESTARTED in_sync=$INSYNC failed=$FAILED"
  }

  # --- post-verify helper: active + disk + proc + markers ---
  post_verify() { # $1=expected_sha  $2=expected_marker_sha  $3=expect_meta(0/1) ; sets PV_MATCH/PV_DETAIL
    local i ACTIVE DISK_SHA PID PROC_SHA MARK_MARKER MARK_META META_OK
    PV_MATCH=0
    sleep "${OC_SWAP_SETTLE:-5}"
    for i in $(seq 1 "${OC_SWAP_TRIES:-30}"); do
      ACTIVE="$($ACTIVE_CMD 2>/dev/null || echo unknown)"
      DISK_SHA="$(sha256sum "$SWAP_TARGET" 2>/dev/null | cut -d' ' -f1)"
      MARK_MARKER="$(cat "$DEPLOYED" 2>/dev/null || echo MISSING)"
      MARK_META="absent"; [ -f "$DEPLOYED_META" ] && MARK_META="present"
      META_OK=0; if [ "$3" = "1" ]; then [ "$MARK_META" = "present" ] && META_OK=1; else [ "$MARK_META" = "absent" ] && META_OK=1; fi
      if [ "$ACTIVE" = "active" ] && [ "$DISK_SHA" = "$1" ] && [ "$MARK_MARKER" = "$2" ] && [ "$META_OK" = "1" ]; then
        if [ "$SKIP_PROC" = "1" ]; then PV_MATCH=1; break; fi
        PID="$($PID_CMD 2>/dev/null || echo 0)"
        if [ -n "$PID" ] && [ "$PID" != "0" ] && [ -r "${OC_SWAP_PROC_PREFIX:-/proc}/$PID/exe" ]; then
          PROC_SHA="$(sha256sum "${OC_SWAP_PROC_PREFIX:-/proc}/$PID/exe" 2>/dev/null | cut -d' ' -f1)"
          [ "$PROC_SHA" = "$1" ] && { PV_MATCH=1; break; }
        fi
      fi
      sleep 2
    done
    PV_DETAIL="$(jq -cn --arg a "$ACTIVE" --arg d "${DISK_SHA:-}" --arg e "$1" --arg mm "$MARK_MARKER" --arg mt "$MARK_META" --argjson x "$3" --argjson m "$PV_MATCH" '{is_active:$a, disk_sha256:$d, expected_sha256:$e, marker_sha:$mm, marker_meta:$mt, meta_expect:($x==1), match:($m==1)}')"
  }

  # --- 9. post-verify ---
  post_verify "$EXPECTED" "$SHA" 1
  if [ "$PV_MATCH" = 1 ]; then
    jline post-verify 0 "$PV_DETAIL"
    local BY_LBL="oc-deploy swap-execute"; [ "$DRILL" = "1" ] && BY_LBL="oc-deploy swap-execute DRILL"
    if [ "$DRILL" = "1" ]; then
      # drill with a match means the deliberately-wrong expected matched —
      # impossible by construction; treat as drill anomaly
      # (F-M1, v0.4.78: receipt journals BEFORE the ledger stamp — the stamp
      # lands last, matching the GREEN leg; a crash in between leaves receipt
      # evidence, never an unbacked stamp)
      jline receipt 1 "$(jq -cn '{note:"drill expected a rollback but verify matched — anomaly"}')"
      ledger_stamp "$BY_LBL" "swap-result DEPLOYED sha=$SHA run=$RUN_ID features=$FEATURES: install(seq5)+post-verify(seq$SEQ match=true)+marker-write; journal=$JF backup=$BAK auth=auto-swap" "swap-result"
      die 2 "drill anomaly: post-verify matched a deliberately wrong expected sha"
    fi
    sidecar_sync "$EXPECTED"
      A2A_RC=1; a2a_notify_retry "[oc-deploy PHASE B RECEIPT] DEPLOYED sha=$SHA run=$RUN_ID — post-verify match, markers written, backup $BAK. Journal: $JF" && A2A_RC=0
    jline receipt "$A2A_RC" "$(jq -cn --argjson a "$A2A_RC" '{topics:[30220], a2a_accepted:($a==0), note:"stamp follows fanout (issue #24 wiring)"}')"
    # --- GREEN fan-out (issue #24 wiring): notify contributor sessions of the
    #     live swap. Fires AFTER receipt seal + marker writes (design §5) and
    #     BEFORE the swap-result ledger stamp, so fanout-end is journaled first
    #     and the stamp lands last. Suppressed by OC_DEPLOY_NOFANOUT=1 (--drill
    #     never reaches this branch). Subshell: fanout_run exits on its own
    #     paths — must never leak into the swap's rc or skip the stamp.
    local FO_RC=0 FO_OUT="" FO_NOTE="skipped"
    if [ "${OC_DEPLOY_NOFANOUT:-0}" != "1" ]; then
      FO_OUT="$( ( fanout_run "$RUN_ID" 0 ) 2>&1 )" || FO_RC=$?
      FO_NOTE="rc=$FO_RC"
      jline fanout "$FO_RC" "{\"run\":\"$RUN_ID\"}"   # lens F HIGH-2 (v0.4.79): fanout rc in the swap journal — stderr-only surfacing was a silent-loss path
      [ "$FO_RC" = 0 ] || { echo "oc-deploy: GREEN fan-out rc=$FO_RC — swap stands; re-run 'oc-deploy fanout --run $RUN_ID'" >&2; printf '%s\n' "$FO_OUT" >&2; }
    fi
    ledger_stamp "$BY_LBL" "swap-result DEPLOYED sha=$SHA run=$RUN_ID features=$FEATURES: install(seq5)+post-verify(seq$SEQ match=true)+marker-write+receipt; journal=$JF backup=$BAK auth=auto-swap fanout=$FO_NOTE" "swap-result"
    shadow_log swap "$SHA" "$FEATURES" "deployed"
    echo "SWAP COMPLETE: sha=$SHA run=$RUN_ID verified disk==proc, markers written, fanout=$FO_NOTE, ledger stamped"
    exit 0
  fi
  jline post-verify 1 "$PV_DETAIL"

  # --- 10. AUTO-ROLLBACK --- (F-H1, v0.4.78: every restore leg rc-captured;
  #     the journal records what ACTUALLY happened — never an unconditional 0)
  echo "oc-deploy: post-verify FAILED — auto-rollback engaged (backup $BAK)" >&2
  RB_FAIL=0
  cp "$BAK" "$SWAP_TARGET.new" && chmod +x "$SWAP_TARGET.new" && mv -f "$SWAP_TARGET.new" "$SWAP_TARGET" || RB_FAIL=1
  # restore markers + baseline + orders to pre-swap truth (each leg rc-checked)
  if [ -f "$WORKDIR/state-backup/deployed.sha" ]; then cp -p "$WORKDIR/state-backup/deployed.sha" "$DEPLOYED" || RB_FAIL=1; else rm -f "$DEPLOYED" || RB_FAIL=1; fi
  if [ -f "$WORKDIR/state-backup/deployed.meta.json" ]; then cp -p "$WORKDIR/state-backup/deployed.meta.json" "$DEPLOYED_META" || RB_FAIL=1; else rm -f "$DEPLOYED_META" || RB_FAIL=1; fi
  if [ -f "$WORKDIR/state-backup/baseline.json" ]; then cp -p "$WORKDIR/state-backup/baseline.json" "$BASELINE" || RB_FAIL=1; fi
  if [ -f "$WORKDIR/state-backup/orders.json" ]; then cp -p "$WORKDIR/state-backup/orders.json" "$ORDERS" || RB_FAIL=1; fi
  [ "${OC_SWAP_ROLLBACK_FAIL:-0}" = 1 ] && RB_FAIL=1   # test-only hook (F-H1 selftest 11b): force the failed-restore branch
  if [ "$RB_FAIL" = 1 ]; then
    jline rollback 1 "$(jq -cn --arg b "$BAK" --arg s "$BAK_SHA" --arg r "post-verify mismatch after bounce" '{restored_backup:$b, restored_sha256:$s, reason:$r, restore_failed:true, error:"restore leg failed — binary state UNVERIFIED, manual recovery required"}')"
    echo "oc-deploy: ROLLBACK RESTORE FAILED — journal records rc=1; backup $BAK; MANUAL RECOVERY REQUIRED" >&2
  else
    jline rollback 0 "$(jq -cn --arg b "$BAK" --arg s "$BAK_SHA" --arg r "post-verify mismatch after bounce" '{restored_backup:$b, restored_sha256:$s, reason:$r, also_restored:"deployed.sha+meta+baseline+orders"}')"
  fi
  local RRC2
  $RESTART_CMD >/dev/null 2>&1; RRC2=$?
  jline restart "$RRC2" "$(jq -cn --arg u "opencrabs-ops.service" --argjson e "$RRC2" '{note:"post-rollback restart", unit:$u, systemd_run_exit:$e}')"
  post_verify "$BAK_SHA" "$PREV_SHA" "$HAD_META"
  jline post-verify "$([ "$PV_MATCH" = 1 ] && echo 0 || echo 1)" "$PV_DETAIL"
  local BY_LBL2="oc-deploy swap-execute"; [ "$DRILL" = "1" ] && BY_LBL2="oc-deploy swap-execute DRILL"
  if [ "$RB_FAIL" = 1 ]; then
    ledger_stamp "$BY_LBL2" "swap-result ROLLBACK-FAILED sha=$SHA run=$RUN_ID: post-verify mismatch after bounce (seq8 exit=1); restore leg FAILED — binary state UNVERIFIED, manual recovery required (backup $BAK); journal=$JF" "swap-result"
  else
    ledger_stamp "$BY_LBL2" "swap-result ROLLED_BACK sha=$SHA run=$RUN_ID: post-verify mismatch after bounce (seq8 exit=1); backup $BAK restored + re-verified match=$([ "$PV_MATCH" = 1 ] && echo true || echo false); markers+baseline restored; journal=$JF" "swap-result"
  fi
  A2A_RC=1; a2a_notify_retry "[oc-deploy PHASE B] ROLLBACK sha=$SHA run=$RUN_ID — post-verify failed after bounce, backup restored, re-verify match=$([ "$PV_MATCH" = 1 ] && echo true || echo false). DRILL=$DRILL. Journal: $JF" && A2A_RC=0
  jline receipt "$A2A_RC" "$(jq -cn --argjson a "$A2A_RC" '{result:"rolled-back", a2a_accepted:($a==0)}')"
  shadow_log swap "$SHA" "$FEATURES" "rolled-back"
  if [ "$DRILL" = "1" ]; then
    if [ "$PV_MATCH" = 1 ]; then
      echo "DRILL COMPLETE: rollback path exercised end-to-end — install, failed verify, backup restore, re-verify CLEAN, markers restored, ledger stamped"
      exit 0
    fi
    die 2 "DRILL FAILED: rollback re-verify did not match — manual attention"
  fi
  die 2 "AUTO-ROLLBACK executed for sha=$SHA — prod restored to $BAK_SHA; investigate journal $JF"
}

# ------------------------------------------------------------------ watchdog --
# S3 replacement for the archived tools/archive/compiler.md Step 1 WATCHDOG duty (owner
# directive 2026-08-28 16:26Z: NO cron — oc-deploy fires often enough, so the
# check piggybacks every ship/poll invocation; explicit run = `oc-deploy watch`).
# Tripwire semantics: fork main tip must be covered by deployed.sha OR a
# ship/swap event in this tool's own shadow log / ledger. Uncovered tip =
# stray commits on the branch production is built from. REPORT-ONLY: the watch
# never blocks the host invocation and NEVER builds autonomously.
watch_covered() { # $1=sha ; echoes reason, rc 0 covered / 1 uncovered
  local S="$1" DEP
  DEP="$(cat "$DEPLOYED" 2>/dev/null || true)"
  [ -n "$DEP" ] || DEP="$(jq -r '.sha // empty' "$(dirname "$LEDGER")/baseline.json" 2>/dev/null || true)"
  if [ -n "$DEP" ] && [ "$S" = "$DEP" ]; then echo "deployed-sha"; return 0; fi
  if [ -f "$SHADOW" ] && grep -F "$S" "$SHADOW" 2>/dev/null | grep -Eq '(dispatched|deployed|handed-off)'; then
    echo "ship-event"; return 0
  fi
  if jq -e --arg s "$S" '[ (.events // [])[] | select(.kind != null and ((.kind|tostring) | test("ship|swap")) and (((.what // "")|tostring) | contains($s))) ] | length > 0' "$LEDGER" >/dev/null 2>&1; then
    echo "ledger-event"; return 0
  fi
  return 1
}

watch_precheck() { # $1=tip-sha ; piggyback, report-only, never fails the host
  [ "${OC_DEPLOY_NO_WATCH:-0}" = "1" ] && return 0
  local REASON
  if REASON="$(watch_covered "$1")"; then
    shadow_log watch "$1" "-" "clean:$REASON"
    echo "WATCH-CLEAN: fork main ${1:0:8} covered ($REASON)"
  else
    shadow_log watch "$1" "-" "ALERT:stray"
    echo "WATCH-ALERT: fork main ${1:0:8} NOT covered (deployed=$(cut -c1-8 "$DEPLOYED" 2>/dev/null || echo none)) — run 'oc-deploy watch' for the stray list"
  fi
  return 0
}

watch_run() { # explicit `oc-deploy watch [--with-delta]` ; exit 0 clean | 2 stray (report-only)
  # $1 = WITH_DELTA. Merge B (v0.4.48): upstream arithmetic rides the same
  # duty call. The delta leg is READ-ONLY; its rc 1 = verdict (delta present),
  # NOT a failure — tripwire severity wins for the combined exit code.
  local WITH_DELTA="${1:-0}" TIP DEP REASON TRIP_RC=0 DELTA_TOOL DELTA_OUT DELTA_RC
  TIP="$(git ls-remote "$REMOTE" refs/heads/main 2>/dev/null | awk '{print $1}')"
  [ -n "$TIP" ] || die 2 "watch: cannot read fork main tip from $REMOTE"
  DEP="$(cat "$DEPLOYED" 2>/dev/null || echo none)"
  if REASON="$(watch_covered "$TIP")"; then
    shadow_log watch "$TIP" "-" "clean:$REASON"
    echo "WATCH-CLEAN: fork main ${TIP:0:8} covered ($REASON); deployed=${DEP:0:8}"
  else
    TRIP_RC=2
    shadow_log watch "$TIP" "-" "ALERT:stray"
    echo "WATCH-ALERT: fork main ${TIP:0:8} NOT covered by deployed sha (${DEP:0:8}) nor any ship/swap event"
    if [ "$DEP" != "none" ]; then
      "$GH" api "repos/$FORK/compare/$DEP...$TIP" 2>/dev/null \
        | jq -r '.commits[]? | "  \(.sha[0:8]) \(.commit.author.date) \(.commit.author.name): \(.commit.message | split("\n")[0])"' 2>/dev/null \
        || true
    fi
    echo "report-only: attribute via Session-Id trailers; oc-deploy NEVER builds autonomously"
  fi
  if [ "$WITH_DELTA" = "1" ]; then
    DELTA_TOOL="${OC_DEPLOY_DELTA_TOOL:-$TOOLS_DIR/harvest/oc-upstream-delta}"
    if [ -x "$DELTA_TOOL" ]; then
      DELTA_OUT="$("$DELTA_TOOL" 2>&1)"; DELTA_RC=$?
      printf '%s\n' "$DELTA_OUT" | sed 's/^/DELTA: /'
      case "$DELTA_RC" in
        0) shadow_log watch "$TIP" "-" "delta:clean" ;;
        1) shadow_log watch "$TIP" "-" "delta:present" ;;
        *) shadow_log watch "$TIP" "-" "delta:fail-rc$DELTA_RC"
           echo "WARN: oc-upstream-delta rc=$DELTA_RC (tripwire verdict stands)" >&2 ;;
      esac
    else
      echo "WARN: oc-upstream-delta not found at $DELTA_TOOL — delta leg skipped" >&2
    fi
  fi
  exit "$TRIP_RC"
}

# ----------------------------------------------------------------- status --
status_run() {
  local json_out=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json_out=1 ;;
      -h|--help) echo "usage: oc-deploy status [--json]"; exit 0 ;;
      *) die 1 "status: unknown arg: $1" ;;
    esac
    shift || true
  done

  local dep_sha="" dep_ts="" dep_stage="" dep_features="" dep_run="" dep_target=""
  if [ -f "$DEPLOYED_META" ]; then
    dep_sha="$(jq -r '.sha // empty' "$DEPLOYED_META" 2>/dev/null || true)"
    dep_ts="$(jq -r '.ts // empty' "$DEPLOYED_META" 2>/dev/null || true)"
    dep_stage="$(jq -r '.stage // empty' "$DEPLOYED_META" 2>/dev/null || true)"
    dep_features="$(jq -r '.features // empty' "$DEPLOYED_META" 2>/dev/null || true)"
    dep_run="$(jq -r '.run_id // empty' "$DEPLOYED_META" 2>/dev/null || true)"
    dep_target="$(jq -r '.target_host // empty' "$DEPLOYED_META" 2>/dev/null || true)"
  fi
  if [ -z "$dep_sha" ] && [ -f "$DEPLOYED" ]; then
    dep_sha="$(cat "$DEPLOYED" 2>/dev/null | tr -d ' \n\r\t' || true)"
  fi

  local daemon_pid="" daemon_uptime="" daemon_status="stopped"
  # #470: the ops unit's MainPID is the ONLY correct source for this daemon.
  # `pgrep -f opencrabs.*daemon | head -1` grabs whichever daemon sorts first —
  # three share this box — so `status` reported the DEFAULT profile's PID and
  # uptime, and uptime is the field a lane reads to tell whether a post-swap
  # restart actually happened. PID_CMD is the source the swap path already uses.
  daemon_pid="$($PID_CMD 2>/dev/null || echo 0)"
  # `kill -0 0` SUCCEEDS (it targets the caller's process group), so an
  # inactive unit reporting MainPID=0 would read as "running" unguarded.
  case "$daemon_pid" in ''|0|*[!0-9]*) daemon_pid="" ;; esac
  if [ -n "$daemon_pid" ] && kill -0 "$daemon_pid" 2>/dev/null; then
    daemon_status="running"
    daemon_uptime="$(ps -p "$daemon_pid" -o etime= 2>/dev/null | tr -d ' ' || true)"
  fi

  local current_stage="$(stage)"

  local last_journal="" last_journal_step="" last_journal_verdict=""
  if [ -d "$STATE_DIR/oc-deploy/journal" ]; then
    last_journal="$(ls -t "$STATE_DIR/oc-deploy/journal"/swap-*.jsonl 2>/dev/null | head -1 || true)"
    if [ -n "$last_journal" ] && [ -f "$last_journal" ]; then
      last_journal_step="$(tail -1 "$last_journal" | jq -r '.step // empty' 2>/dev/null || true)"
      last_journal_verdict="$(tail -1 "$last_journal" | jq -r '.status // empty' 2>/dev/null || true)"
    fi
  fi

  if [ "$json_out" = 1 ]; then
    jq -n \
      --arg sha "${dep_sha:-unknown}" \
      --arg ts "${dep_ts:-unknown}" \
      --arg stage "${current_stage:-unknown}" \
      --arg features "${dep_features:-unknown}" \
      --arg run "${dep_run:-unknown}" \
      --arg target "${dep_target:-unknown}" \
      --arg daemon_status "$daemon_status" \
      --arg daemon_pid "${daemon_pid:-}" \
      --arg daemon_uptime "${daemon_uptime:-}" \
      --arg last_swap_journal "${last_journal:-}" \
      --arg last_swap_step "${last_journal_step:-}" \
      --arg last_swap_verdict "${last_journal_verdict:-}" \
      '{deployed:{sha:$sha, ts:$ts, stage:$stage, features:$features, run_id:$run, target_host:$target}, daemon:{status:$daemon_status, pid:(if $daemon_pid == "" then null else ($daemon_pid|tonumber) end), uptime:$daemon_uptime}, last_swap:{journal:$last_swap_journal, step:$last_swap_step, verdict:$last_swap_verdict}}'
  else
    echo "DEPLOYMENT STATUS"
    echo "  Deployed SHA:    ${dep_sha:-unknown}"
    echo "  Timestamp:       ${dep_ts:-unknown}"
    echo "  Current Stage:   ${current_stage:-unknown}"
    echo "  Features:        ${dep_features:-unknown}"
    echo "  Carrier Run:     ${dep_run:-unknown}"
    echo "  Target Host:     ${dep_target:-unknown}"
    echo "DAEMON"
    echo "  Status:          $daemon_status"
    if [ "$daemon_status" = "running" ]; then
      echo "  PID:             $daemon_pid"
      echo "  Uptime:          $daemon_uptime"
    fi
    if [ -n "$last_journal" ]; then
      echo "LAST SWAP"
      echo "  Journal:         $last_journal"
      echo "  Step/Verdict:    ${last_journal_step:-unknown} / ${last_journal_verdict:-unknown}"
    fi
  fi
  return 0
}

# KILL FILE brake — invoked at the top of every REAL-mode arm of the dispatch
# case below, never from arg parsing (contract fix 2026-09-11, owner word via
# HQ d72bd52d). It used to run as "the first line of EVERY invocation", which
# also swallowed the surfaces the RC contract keeps ungated: with a kill file
# present `--help` reported 9 instead of 0, and the no-args / unknown-arg usage
# diags reported 9 instead of 1, because the brake sat above the -h|--help case
# and above the whole arg loop. Real ship / poll / swap-execute / watch / fanout
# work is still blocked, with the documented rc 9. `return 0` keeps the
# `[ -f ] && die` idiom from tripping `set -e` on the clean path.
kill_brake() {
  [ -f "$KILL_FILE" ] && die 9 "KILL FILE present ($KILL_FILE) — all oc-deploy invocations abort"
  [ -f "$KILL_FILE2" ] && die 9 "KILL FILE present ($KILL_FILE2) — all oc-deploy invocations abort"
  return 0
}

MODE="${1:-}"; [ $# -gt 0 ] && shift
# v0.4.153: preserve the argv BEFORE the flag loop below consumes $@ into
# globals — the cgroup detach must re-exec with the original flags.
ORIG_ARGS=("$@")
# C-F5 (v0.4.71): --help / -h exits 0 on stdout, before any validation
case "$MODE" in -h|--help) echo "usage: oc-deploy ship [--sha S] [--features F] [--execute] [--gated-run ID] [--gated-sha SHA] [--allow-ungated-push \"<justification>\"] [--allow-features-drop] | poll [--execute] | swap-execute --sha S --run R [--features F] [--artifact-dir D] [--drill] [--allow-features-drop] [--allow-rewritten-lineage \"<justification>\" [--actor A]] | lineage-check [--prev P] [--sha S] [--repo R] [--json] | recover-receipt [--journal J] [--run R] [--sha S] [--dry-run] [--historical] [--json] | watch [--with-delta] | status [--json] | fanout --run R [--dry-run] | --selftest  (contributors RETIRED — use oc-attrib --contributors)"; exit 0 ;; esac
# issue #24 D1: contributors takes its own arg shape (positional range /
# --deployed / --repo) — dispatch BEFORE the ship/poll flag loop so the
# positional range survives. contributors is RETIRED (dies rc 1); the
# kill-file brake now lives in the real-mode dispatch arms, below.
if [ "$MODE" = contributors ]; then contributors_run "$@"; exit $?; fi
if [ "$MODE" = status ]; then status_run "$@"; exit $?; fi
# v0.4.151: lineage-check takes its own arg shape (--prev/--sha/--repo/--json) —
# dispatch BEFORE the ship/poll flag loop so its flags are not rejected.
if [ "$MODE" = lineage-check ]; then lineage_check_run "$@"; exit $?; fi
# v0.4.153: recover-receipt takes its own arg shape (--journal/--run/--sha/--dry-run/--json) —
# dispatch BEFORE the ship/poll flag loop so its flags are not rejected.
if [ "$MODE" = recover-receipt ]; then recover_receipt_run "$@"; exit $?; fi
SHA=""; FEATURES=""; FEATURES_EXPLICIT=0; EXECUTE=0; RUN_ID=""; DRILL=0; ARTDIR=""; DRYRUN=0; WITH_DELTA=0; ALLOW_DROP=0   # FEATURES="" = resolve from carrier (KERNEL D2, 2026-08-28)
WAIT_SECS=0; NOTIFY_SESSION=""   # C-#2: poll --wait / --notify-session
ALLOW_REWRITTEN_LINEAGE=0; RW_JUSTIFY=""; RW_ACTOR="${OC_DEPLOY_ACTOR:-$(id -un 2>/dev/null || echo unknown)}"   # v0.4.151: audited swap-guard override
GATED_RUN=""; GATED_SHA=""; ALLOW_UNGATED=0; UNGATED_JUSTIFY=""   # #355: gate-before-land (reuses oc-ship-chain's --gated-run/--gated-sha contract)
# #675-safe: the KERNEL's per-process guard must not change.
while [ $# -gt 0 ]; do
  case "$1" in
    --sha)      SHA="${2:-}"; shift ;;
    --features) FEATURES="${2:-}"; shift; FEATURES_EXPLICIT=1 ;;
    --execute)  EXECUTE=1 ;;
    --run)      RUN_ID="${2:-}"; shift ;;
    --drill)    DRILL=1 ;;
    --allow-features-drop) ALLOW_DROP=1 ;;  # HQ law 2026-09-04: explicit escape hatch for the features-compat gate
    --allow-rewritten-lineage)   # v0.4.151: audited override for a genuinely-absent deployed change (justification MANDATORY)
      [ -n "${2:-}" ] || die 2 "OC_DEPLOY_GATE=override-needs-justification: --allow-rewritten-lineage requires a non-empty justification string (it is journaled with the actor)"
      ALLOW_REWRITTEN_LINEAGE=1; RW_JUSTIFY="${2:-}"; shift ;;
    --actor)    [ -n "${2:-}" ] || die 2 "--actor needs a value (lane uuid or name)"; RW_ACTOR="${2:-}"; shift ;;
    --gated-run) [ -n "${2:-}" ] || die 2 "OC_DEPLOY_GATE=gate-arg-empty: --gated-run needs a run id"; GATED_RUN="${2:-}"; shift ;;   # #355: the PR-lane gate run that gated this sha
    --gated-sha) [ -n "${2:-}" ] || die 2 "OC_DEPLOY_GATE=gate-arg-empty: --gated-sha needs a sha"; GATED_SHA="${2:-}"; shift ;;   # #355: the sha that WAS gated (this sha, or a content-identical rebase of it)
    --allow-ungated-push)   # #355: audited escape hatch, mirrors --allow-rewritten-lineage (justification MANDATORY)
      [ -n "${2:-}" ] || die 2 "OC_DEPLOY_GATE=override-needs-justification: --allow-ungated-push requires a non-empty justification string (it is journaled with the actor)"
      ALLOW_UNGATED=1; UNGATED_JUSTIFY="${2:-}"; shift ;;
    --dry-run)  DRYRUN=1 ;;   # issue #24: fanout rehearsal — never marks done
    --with-delta) WITH_DELTA=1 ;;   # merge B (v0.4.48): watch rides oc-upstream-delta too
    --wait)     WAIT_SECS="${2:-}"; shift ;;   # C-#2: poll blocks until a NEW green run (or timeout, rc 5)
    --notify-session) [ -n "${2:-}" ] || die 2 "--notify-session needs a session uuid"; NOTIFY_SESSION="${2:-}"; shift ;;   # C-#2: session uuid woken on handoff/timeout; guard lens C MED-3 (v0.4.79)
    --artifact-dir) ARTDIR="${2:-}"; shift ;;
    -h|--help)  echo "usage: oc-deploy ship [--sha S] [--features F] [--execute] [--gated-run ID] [--gated-sha SHA] [--allow-ungated-push \"<justification>\"] [--allow-features-drop] | poll [--execute] [--wait N] [--notify-session UUID] | swap-execute --sha S --run R [--features F] [--artifact-dir D] [--drill] [--allow-features-drop] [--allow-rewritten-lineage \"<justification>\" [--actor A]] | lineage-check [--prev P] [--sha S] [--repo R] [--json] | recover-receipt [--journal J] [--run R] [--sha S] [--dry-run] [--historical] [--json] | watch [--with-delta] | status [--json] | fanout --run R [--dry-run] | --selftest  (contributors RETIRED — use oc-attrib --contributors)"; exit 0 ;;
    *)          die 1 "unknown arg: $1" ;;
  esac
  shift || true
done

# KERNEL D2 (2026-08-28): --features omitted -> resolve the carrier's
# features default via oc-carrier-features. A carrier read FAILURE ABORTS —
# the hardcoded fallback set was deleted, never silently ship a wrong set.
# FEATURE-DEFAULT law (HQ 2026-09-07, incident #125 lane d5863180 / carrier
# run 34143410835): the carrier default (telegram) DESYNCED from the live
# deployment (deployed.meta.json: telegram,code-graph) — artifact name embeds
# features verbatim, so the Phase-B swap units died 'artifact download
# failed'. Ship now DEFERS to deployed.meta.json when the two disagree, and
# an EXPLICIT --features that mismatches the deployment fails fast here,
# BEFORE dispatch — never a silently non-swappable artifact.
if [ -z "$FEATURES" ]; then
  CARRIER_TOOL="${OC_DEPLOY_CARRIER:-$(cd "$(dirname "$0")" && pwd)/oc-carrier-features}"
  case "$MODE" in
    ship|poll)
      FEATURES="$("$CARRIER_TOOL" --fetch 2>/dev/null)" \
        || die 2 "carrier features read FAILED (tool: $CARRIER_TOOL) — aborting, no silent fallback set"
      shadow_log features-resolve "-" "$FEATURES" "carrier-default"
      ;;
    swap-execute) : ;;  # stage-gate in swap_execute decides first; empty FEATURES fails loudly downstream, never silently
  esac
fi
# ship-only reconciliation against the live deployment (runs AFTER carrier
# resolution so both default and explicit paths are covered; poll keeps the
# pre-incident behavior — the incident window was ship dispatch).
if [ "$MODE" = ship ] && [ -n "$FEATURES" ] && [ -f "$DEPLOYED_META" ]; then
  DEP_FEATS="$(jq -r '.features // ""' "$DEPLOYED_META" 2>/dev/null || true)"
  if [ -n "$DEP_FEATS" ]; then
    # order-insensitive set compare (comma lists), same normalization the
    # features-compat swap gate uses — 'a,b' == 'b,a' is not a mismatch
    if [ "$(printf '%s' "$DEP_FEATS" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' | sort -u)" \
      != "$(printf '%s' "$FEATURES" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^$' | sort -u)" ]; then
      if [ "$FEATURES_EXPLICIT" = 1 ]; then
        shadow_log ship "-" "$FEATURES" "features-mismatch-refused"
        die 2 "OC_DEPLOY_GATE=feature-mismatch: explicit --features '$FEATURES' != deployed '$DEP_FEATS' (deployed.meta.json) — refusing pre-dispatch: artifact name embeds features verbatim, this build could never be swapped. Deploy a matching set first or pass the deployed set."
      else
        shadow_log ship "-" "$FEATURES" "features-default-corrected:$DEP_FEATS"
        echo "oc-deploy: carrier default '$FEATURES' != deployed '$DEP_FEATS' — adopting deployed set (FEATURE-DEFAULT)"
        FEATURES="$DEP_FEATS"
      fi
    fi
  fi
fi

case "$MODE" in
  # ------------------------------------------------------------------ ship --
  ship)
    kill_brake
    # F-1 fusion (v0.4.97, editor.md Phase 6a lens E promise): --wait N on an
    # EXECUTE ship is now honoured — after a successful dispatch the SAME
    # process bounded-polls the carrier run (N seconds) and exits on GREEN /
    # terminal-RED / timeout. Plan mode still refuses: a poll needs a dispatch
    # to watch. --notify-session stays poll-only (ship-wait is fire-and-see).
    if [ "$WAIT_SECS" != 0 ]; then
      case "$WAIT_SECS" in ''|*[!0-9]*) die 1 "--wait needs an integer (seconds)" ;; esac
      if [ "$EXECUTE" != 1 ]; then
        die 2 "OC_DEPLOY_GATE=wait-plan-mode: --wait on ship requires --execute (plan mode has nothing to poll — chain poll --wait N explicitly)"
      fi
    fi
    [ -z "$NOTIFY_SESSION" ] || die 2 "OC_DEPLOY_GATE=notify-poll-only: --notify-session is poll-mode only; ship does not poll (chain the poll leg explicitly)"
    # Duty-6 lens F task 3: ship must NEVER silently adopt CWD HEAD — an
    # operator shipping from the wrong directory pushes an unintended sha.
    # --sha is mandatory; the sha must also be contained in the fork main
    # lineage (the push target), not just present as an unrelated object.
    [ -n "$SHA" ] || die 2 "OC_DEPLOY_GATE=missing-sha: ship requires --sha <40-hex> (no implicit CWD-HEAD adoption)"
    echo "$SHA" | grep -Eq '^[0-9a-f]{40}$' || die 1 "sha not 40-hex: $SHA"
    # n=1878 hard guard: format-valid does not mean real — refuse phantom
    # shas BEFORE any plan/rebase logic (fabricated sha incident: lane-planned
    # ship sha=4c0115ba…, bad object, misleading 'rebase needed' downstream).
    git cat-file -e "$SHA^{commit}" 2>/dev/null \
      || die 1 "sha not found in this repo (phantom?): $SHA — pass --sha <real commit sha>"
    plan "ship sha=$SHA features=$FEATURES stage=$(stage) execute=$EXECUTE"
    git fetch -q "$REMOTE" +refs/heads/main:refs/oc-deploy/main 2>/dev/null \
      || git fetch -q "$REMOTE" main \
      || { shadow_log ship "$SHA" "$FEATURES" "fetch-fail"; die 2 "OC_DEPLOY_GATE=fetch-fail: cannot fetch fork main from $REMOTE"; }
    MAIN_TIP="$(git rev-parse FETCH_HEAD 2>/dev/null || git rev-parse refs/oc-deploy/main 2>/dev/null)" \
      || die 2 "cannot resolve fork main tip"
    plan "fork main tip = $MAIN_TIP"
    watch_precheck "$MAIN_TIP"
    if git merge-base --is-ancestor "$MAIN_TIP" "$SHA" 2>/dev/null; then
      plan "FF ok: main is ancestor of sha — push would fast-forward"
    else
      if [ "$EXECUTE" != 1 ]; then
        shadow_log ship "$SHA" "$FEATURES" "rebase-needed"
        die 2 "OC_DEPLOY_GATE=rebase-needed: $SHA does not fast-forward main ($MAIN_TIP)"
      fi
      # In-tool auto-rebase on non-FF (v0.4.145)
      echo "oc-deploy: non-fast-forward detected (main=$MAIN_TIP, sha=$SHA) — attempting in-tool auto-rebase..." >&2
      PRE_REBASE_REF="$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse HEAD 2>/dev/null)"
      set +e
      REBASE_OUT="$(git rebase "$MAIN_TIP" "$SHA" 2>&1)"
      REBASE_RC=$?
      set -e
      if [ "$REBASE_RC" -ne 0 ]; then
        CONFLICTS="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
        git rebase --abort >/dev/null 2>&1 || true
        [ -n "$PRE_REBASE_REF" ] && git checkout -q "$PRE_REBASE_REF" >/dev/null 2>&1 || true
        shadow_log ship "$SHA" "$FEATURES" "rebase-conflict"
        echo "oc-deploy: REBASE_CONFLICT — automatic rebase failed with merge conflicts:" >&2
        if [ -n "$CONFLICTS" ]; then
          printf '  %s\n' $CONFLICTS >&2
        else
          printf '%s\n' "$REBASE_OUT" >&2
        fi
        die 5 "OC_DEPLOY_GATE=rebase-conflict: manual conflict resolution required"
      fi
      NEW_SHA="$(git rev-parse HEAD)"
      REBASE_SAFETY="${OC_DEPLOY_REBASE_SAFETY:-$TOOLS_DIR/git/oc-rebase-safety}"
      set +e
      AUDIT_OUT="$("$REBASE_SAFETY" audit --old-tip "$SHA" --new-tip "$NEW_SHA" 2>&1)"
      AUDIT_RC=$?
      set -e
      if [ "$AUDIT_RC" -ne 0 ]; then
        [ -n "$PRE_REBASE_REF" ] && git checkout -q "$PRE_REBASE_REF" >/dev/null 2>&1 || true
        shadow_log ship "$SHA" "$FEATURES" "rebase-audit-failed"
        echo "oc-deploy: REBASE_AUDIT_FAILED — oc-rebase-safety audit found dropped/changed hunks:" >&2
        printf '%s\n' "$AUDIT_OUT" >&2
        die 5 "OC_DEPLOY_GATE=rebase-audit-failed: auto-rebase lost edits, manual re-gate required"
      fi
      echo "oc-deploy: REBASE_CLEAN — auto-rebased $SHA -> $NEW_SHA (zero lost edits verified by oc-rebase-safety audit)" >&2
      shadow_log ship "$SHA" "$FEATURES" "auto-rebased:$NEW_SHA"
      SHA="$NEW_SHA"
    fi
    if [ "$EXECUTE" = 1 ]; then
      # ---- #355 GATE-BEFORE-LAND ------------------------------------------
      # The push below LANDS $SHA on fork main. Refuse it unless this
      # invocation carries a GREEN gate for that sha, or an audited override.
      # Fail CLOSED: an absent gate is a refusal, never a silent pass.
      GATE_STATE=""; GATE_SRC=""
      if [ -n "$GATED_RUN" ]; then
        GATE_SRC="run:$GATED_RUN"
        GATE_STATE="$(gate_verdict_for_run "$GATED_RUN")"
      elif [ -n "$GATED_SHA" ]; then
        GATE_SRC="sha:$GATED_SHA"
        if [ "$GATED_SHA" = "$SHA" ]; then
          GATE_STATE="green"
        elif oc_deploy_same_patch "$GATED_SHA" "$SHA"; then
          GATE_STATE="green"   # content-identical rebase: the chain's Duty-4 n=2520 carry
        else
          GATE_STATE="mismatch"
        fi
      else
        GATE_SRC="(none)"
        GATE_STATE="missing"
      fi
      case "$GATE_STATE" in
        green) : ;;
        *)
          if [ "$ALLOW_UNGATED" = 1 ]; then
            shadow_log ship "$SHA" "$FEATURES" "ungated-push-override:$GATE_STATE"
            echo "oc-deploy: UNGATED PUSH OVERRIDE ($GATE_STATE, gate=$GATE_SRC) — allowed by --allow-ungated-push: $UNGATED_JUSTIFY (actor ${RW_ACTOR})" >&2
          else
            shadow_log ship "$SHA" "$FEATURES" "gate-blocked:$GATE_STATE"
            die 2 "OC_DEPLOY_GATE=gate-$GATE_STATE: refusing to push $SHA to refs/heads/main — gate=$GATE_SRC, verdict=$GATE_STATE. Land only a GREEN-gated sha (--gated-run <id> / --gated-sha <sha>, the oc-ship-chain contract). If the landing is genuinely justified, override explicitly and audibly: --allow-ungated-push \"<justification>\"."
          fi ;;
      esac
      PUSH_OK=0
      for PUSH_ATTEMPT in 1 2; do
        if git push -q "$REMOTE" "$SHA:refs/heads/main" 2>/dev/null; then
          PUSH_OK=1; break
        fi
        if [ "$PUSH_ATTEMPT" -eq 1 ]; then
          echo "oc-deploy: push failed (concurrent update) — fetching latest main and retrying auto-rebase in 3s..." >&2
          sleep 3
          git fetch -q "$REMOTE" +refs/heads/main:refs/oc-deploy/main 2>/dev/null \
            || git fetch -q "$REMOTE" main 2>/dev/null || true
          MAIN_TIP="$(git rev-parse FETCH_HEAD 2>/dev/null || git rev-parse refs/oc-deploy/main 2>/dev/null)" || break
          if ! git merge-base --is-ancestor "$MAIN_TIP" "$SHA" 2>/dev/null; then
            PRE_REBASE_REF="$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse HEAD 2>/dev/null)"
            set +e
            REBASE_OUT="$(git rebase "$MAIN_TIP" "$SHA" 2>&1)"
            REBASE_RC=$?
            set -e
            if [ "$REBASE_RC" -ne 0 ]; then
              CONFLICTS="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
              git rebase --abort >/dev/null 2>&1 || true
              [ -n "$PRE_REBASE_REF" ] && git checkout -q "$PRE_REBASE_REF" >/dev/null 2>&1 || true
              shadow_log ship "$SHA" "$FEATURES" "rebase-conflict"
              echo "oc-deploy: REBASE_CONFLICT — automatic rebase failed with merge conflicts:" >&2
              [ -n "$CONFLICTS" ] && printf '  %s\n' $CONFLICTS >&2
              die 5 "OC_DEPLOY_GATE=rebase-conflict: manual conflict resolution required"
            fi
            NEW_SHA="$(git rev-parse HEAD)"
            REBASE_SAFETY="${OC_DEPLOY_REBASE_SAFETY:-$TOOLS_DIR/git/oc-rebase-safety}"
            set +e
            AUDIT_OUT="$("$REBASE_SAFETY" audit --old-tip "$SHA" --new-tip "$NEW_SHA" 2>&1)"
            AUDIT_RC=$?
            set -e
            if [ "$AUDIT_RC" -ne 0 ]; then
              [ -n "$PRE_REBASE_REF" ] && git checkout -q "$PRE_REBASE_REF" >/dev/null 2>&1 || true
              shadow_log ship "$SHA" "$FEATURES" "rebase-audit-failed"
              die 5 "OC_DEPLOY_GATE=rebase-audit-failed: auto-rebase lost edits, manual re-gate required"
            fi
            echo "oc-deploy: REBASE_CLEAN — auto-rebased $SHA -> $NEW_SHA" >&2
            shadow_log ship "$SHA" "$FEATURES" "auto-rebased:$NEW_SHA"
            SHA="$NEW_SHA"
          fi
        fi
      done
      if [ "$PUSH_OK" -ne 1 ]; then
        shadow_log ship "$SHA" "$FEATURES" "push-fail"
        die 2 "push to fork main failed"
      fi
      shadow_log ship "$SHA" "$FEATURES" "pushed"   # F-M2: remote mutation journaled before the next step can fail
      echo "pushed $SHA -> fork main"
      OC_REPO="$FORK" OC_LEDGER="$LEDGER" "$VALIDATE" --repo "$FORK" --ledger "$LEDGER" "$SHA" \
        || { shadow_log ship "$SHA" "$FEATURES" "gate-fail"; die 2 "ORDER gates failed post-push (see validator exit code)"; }
      echo "ORDER gates 4/4 PASS ($SHA)"
      "$GH" workflow run "$WF" --repo "$FORK" --ref "$CARRIER_REF" \
        -f source_repository="$FORK" -f source_ref="$SHA" -f features="$FEATURES" \
        || { shadow_log ship "$SHA" "$FEATURES" "dispatch-fail"; die 2 "carrier dispatch failed"; }
      echo "dispatched carrier run for $SHA (features=$FEATURES)"
      shadow_log ship "$SHA" "$FEATURES" "dispatched"
      # F-1 fusion (v0.4.97): bounded in-process poll of the run we just
      # dispatched — editor.md Phase 6a lens E F-1 promise. GREEN (or any
      # terminal state, success|failure) ends the poll; rc 6 = RED, rc 5 =
      # timeout. No --wait (or 0): classic fire-and-forget, poll leg chained
      # explicitly by the operator.
      if [ "$WAIT_SECS" != 0 ]; then
        POLL_INTERVAL="${OC_DEPLOY_POLL_INTERVAL:-15}"
        SW_DEADLINE=$(( $(date +%s) + WAIT_SECS ))
        while :; do
          RID=""
          for CANDID in $(RUNS_JSON="$("$GH" api "repos/$FORK/actions/workflows/$WF/runs?per_page=5" 2>/dev/null)" \
            && printf '%s' "$RUNS_JSON" | jq -r '.workflow_runs[].id // empty' 2>/dev/null); do
            # Carrier runs (workflow_dispatch on ci/quick-build-linux) have head_sha == carrier tip,
            # so decode target sha from the job names (or fallback to head_sha for test stubs).
            CAND_SHA="$(run_built_sha "$CANDID" 2>/dev/null || true)"
            if [ -z "$CAND_SHA" ]; then
              CAND_SHA="$("$GH" api "repos/$FORK/actions/runs/$CANDID" 2>/dev/null | jq -r '.head_sha // empty' 2>/dev/null)"
            fi
            # Ancestry-aware candidate matching (v0.4.148): accept if the run builds our exact SHA
            # OR a descendant commit containing our SHA (coalesced carrier run).
            if [ "$CAND_SHA" = "$SHA" ]; then
              : # exact match
            elif [ -n "$CAND_SHA" ] && git -C "${OC_DEPLOY_REPO:-${HOME:-/root}/opencrabs}" merge-base --is-ancestor "$SHA" "$CAND_SHA" 2>/dev/null; then
              echo "oc-deploy ship-wait: candidate run $CANDID built descendant $CAND_SHA (contains our sha $SHA — coalesced run)" >&2
            else
              continue
            fi
            RID="$CANDID"; break
          done
          if [ -n "$RID" ]; then
            CONCL="$("$GH" api "repos/$FORK/actions/runs/$RID" 2>/dev/null | jq -r '.status // empty' 2>/dev/null)"
            case "$CONCL" in
              completed)
                CONCL="$("$GH" api "repos/$FORK/actions/runs/$RID" 2>/dev/null | jq -r '.conclusion // empty' 2>/dev/null)"
                if [ "$CONCL" = success ]; then
                  B_SHA="$(run_built_sha "$RID" || true)"
                  shadow_log ship "$SHA" "$FEATURES" "ship-wait-green:$RID"
                  echo "SHIP-WAIT: run $RID GREEN (sha=${B_SHA:-unknown}) within --wait ${WAIT_SECS}s — swap chain ready: poll --execute"
                  exit 0
                fi
                shadow_log ship "$SHA" "$FEATURES" "ship-wait-red:$RID:$CONCL"
                die 6 "SHIP-WAIT: run $RID terminal-$CONCL within --wait ${WAIT_SECS}s — RED, no swap leg"
                ;;
              queued|in_progress|waiting|pending) : ;;   # keep polling
              *) echo "oc-deploy ship-wait: odd run status '$CONCL' — keep polling until deadline" >&2 ;;
            esac
          fi
          [ "$(date +%s)" -lt "$SW_DEADLINE" ] || {
            shadow_log ship "$SHA" "$FEATURES" "ship-wait-timeout"
            die 5 "ship --wait ${WAIT_SECS}s timed out: run ${RID:-?} never reached a terminal state (still building or not found)"
          }
          sleep "$POLL_INTERVAL"
        done
      fi
      echo "NEXT: fanout auto-notifies contributors on swap; poll --execute drives the swap chain"
    else
      plan "would: git push $REMOTE $SHA:refs/heads/main"
      plan "would: $VALIDATE --repo $FORK --ledger <ledger> $SHA   # 4 ORDER gates vs live remote"
      plan "would: $GH workflow run $WF --repo $FORK --ref $CARRIER_REF -f source_ref=$SHA -f features=$FEATURES"
      plan "would: shadow journal appended; fanout notifies contributors on swap"
      shadow_log ship-plan "$SHA" "$FEATURES" "planned"
      echo "plan complete — nothing executed (pass --execute to ship)"
    fi
    ;;
  # ------------------------------------------------------------------ poll --
  poll)
    kill_brake
    # Duty-6 lens F task 5: --wait validated FIRST — before the RED-scan
    # fanout side effects below (a bad --wait used to burn real fanout
    # API calls + fanout.state writes before dying on validation).
    case "$WAIT_SECS" in ''|*[!0-9]*) die 1 "--wait needs an integer (seconds)" ;; esac
    STAGE="$(stage)"
    plan "poll stage=$STAGE execute=$EXECUTE"
    W_TIP="$(git ls-remote "$REMOTE" refs/heads/main 2>/dev/null | awk '{print $1}')"
    [ -n "$W_TIP" ] && watch_precheck "$W_TIP"
    # --- RED scan (issue #24 wiring): latest FAILED carrier run -> fanout.
    #     Piggyback on every poll (same pattern family as the success query);
    #     idempotent via fanout.state; suppressed by OC_DEPLOY_NOFANOUT=1.
    #     Subshell: fanout_run's own exits must not kill the poll.
    if [ "${OC_DEPLOY_NOFANOUT:-0}" != "1" ]; then
      RED_JSON="$("$GH" api "repos/$FORK/actions/workflows/$WF/runs?status=failure&per_page=3" 2>/dev/null || true)"
      for RED_ID in $(printf '%s' "$RED_JSON" | jq -r '.workflow_runs[].id // empty' 2>/dev/null || true); do
        FO_RC=0; FO_OUT=""
        FO_OUT="$( ( fanout_run "$RED_ID" 0 ) 2>&1 )" || FO_RC=$?
        echo "RED scan: run=$RED_ID fanout rc=$FO_RC $(printf '%s' "$FO_OUT" | tail -1)"
      done   # v0.4.79: iterate (idempotence makes repeats no-ops) — stale newest failure no longer masks older real ones
    fi
    # C-#2 (v0.4.78): --wait N blocks until a NEW green run (built sha !=
    # deployed) appears or N seconds elapse (rc 5, optional --notify-session
    # wake) — absorbs the hand-rolled fetch+poll loops (lens C, 2026-08-31).
    # (validation moved to poll top — Duty-6 lens F task 5)
    POLL_DEADLINE=$(( $(date +%s) + WAIT_SECS ))
    POLL_INTERVAL="${OC_DEPLOY_POLL_INTERVAL:-30}"
    while :; do
      RUNS_JSON="$("$GH" api "repos/$FORK/actions/workflows/$WF/runs?status=success&per_page=3" 2>/dev/null)" \
        || { shadow_log poll "-" "-" "api-fail"; die 2 "gh api runs query failed"; }
      # #63 fix (v0.4.79) + #72 fix (this change): iterate the latest runs,
      # scanning ALL jobs of each run (gates-first ordering puts the build job
      # at jobs[1]) and accepting BOTH name shapes (embed + bare-sha gates
      # form). Skip a run only when NO job decodes (stale ORDER-gates /
      # pre-rename formats); skips are diagnosed on stderr, never fatal.
      RUN_ID=""; B_SHA=""
      for RID in $(printf '%s' "$RUNS_JSON" | jq -r '.workflow_runs[].id // empty' 2>/dev/null); do
        CAND="$(run_built_sha "$RID")"   # all jobs, both shapes (#72)
        if [ -n "$CAND" ]; then RUN_ID="$RID"; B_SHA="$CAND"; break; fi
        echo "poll: skip run $RID — no decodable build job (stale/non-build name)" >&2
      done
      if [ -z "$RUN_ID" ]; then
        [ "$(date +%s)" -lt "$POLL_DEADLINE" ] && { sleep "$POLL_INTERVAL"; continue; }
        if [ -n "$NOTIFY_SESSION" ]; then NS_RC=0; notify_session "$NOTIFY_SESSION" "oc-deploy poll" "poll --wait ${WAIT_SECS}s timed out: no decodable carrier run found" || NS_RC=$?; [ "$NS_RC" = 0 ] || echo "oc-deploy: notify-session rc=$NS_RC (wake FAILED — HQ not woken)" >&2; fi
        die 5 "poll: no decodable carrier runs within --wait ${WAIT_SECS}s"
      fi
      DEP="$(cat "$DEPLOYED" 2>/dev/null || echo none)"
      plan "latest green run=$RUN_ID built sha=$B_SHA deployed=$DEP"
      # Ship-pending law (defect family: 2e161df3 + ebbae0aa rc=5 misses,
      # disposed n=2003): when a ship dispatched a SPECIFIC sha (--sha), that
      # sha going GREEN means the swap is PENDING — the deployed marker
      # lagging behind it is expected mid-chain, not "nothing new". Only an
      # UNDISPATCHED poll treats B_SHA == DEP as idle.
      if [ -n "$SHA" ] && [ "$B_SHA" = "$SHA" ]; then
        plan "poll --wait: dispatched sha ${SHA:0:8} is GREEN — SWAP PENDING (deployed=${DEP:0:8} lagging is expected mid-chain)"
        break
      fi
      [ "$B_SHA" != "$DEP" ] && break
      if [ "$WAIT_SECS" -eq 0 ]; then
        echo "nothing to do: $B_SHA already deployed"
        exit 0
      fi
      if [ "$(date +%s)" -ge "$POLL_DEADLINE" ]; then
        if [ -n "$SHA" ] && [ "$B_SHA" = "$SHA" ]; then
          # Dispatched sha GREEN but swap didn't complete within the window —
          # a STUCK swap, never report "nothing new" (rc=5 miss family n=2003).
          if [ -n "$NOTIFY_SESSION" ]; then NS_RC=0; notify_session "$NOTIFY_SESSION" "oc-deploy poll" "poll --wait STUCK: dispatched sha ${SHA:0:8} GREEN but swap not completed in ${WAIT_SECS}s (deployed=${DEP:0:8}) — SWAP PENDING, investigate" || NS_RC=$?; [ "$NS_RC" = 0 ] || echo "oc-deploy: notify-session rc=$NS_RC (wake FAILED — HQ not woken)" >&2; fi
          die 5 "poll --wait ${WAIT_SECS}s: dispatched sha ${SHA:0:8} GREEN but swap PENDING (stuck — deployed marker still ${DEP:0:8})"
        fi
        if [ -n "$NOTIFY_SESSION" ]; then NS_RC=0; notify_session "$NOTIFY_SESSION" "oc-deploy poll" "poll --wait ${WAIT_SECS}s timed out: latest green $B_SHA already deployed — nothing new to swap" || NS_RC=$?; [ "$NS_RC" = 0 ] || echo "oc-deploy: notify-session rc=$NS_RC (wake FAILED — HQ not woken)" >&2; fi
        die 5 "poll --wait ${WAIT_SECS}s timed out: $B_SHA already deployed (nothing new)"
      fi
      plan "poll --wait: $B_SHA already deployed — next attempt in ${POLL_INTERVAL}s"
      sleep "$POLL_INTERVAL"
    done
    if [ "$STAGE" = S2 ] || [ "$STAGE" = S3 ]; then
      plan "auto-swap armed: GREEN run + artifact verify -> swap (consent eliminated owner 2026-08-28)"
      if [ "$EXECUTE" = 1 ]; then
        plan "swap chain: download artifact run=$RUN_ID -> oc-artifact-verify -> backup to $BACKUP_DIR -> atomic install -> seal -> marker writes -> bounce -> disk==proc verify -> ledger stamp -> receipt (auto-rollback on verify fail)"
        UNIT="oc-swap-${B_SHA:0:8}-$(date +%s)"
        OC_SWAP_DETACHED=1 $LAUNCH --unit="$UNIT" --collect "$SELF" swap-execute --sha "$B_SHA" --run "$RUN_ID" --features "$FEATURES" \
          || { shadow_log swap "$B_SHA" "$FEATURES" "launch-fail"; die 4 "systemd-run handoff failed — nothing touched"; }
        shadow_log swap "$B_SHA" "$FEATURES" "handed-off:$UNIT"
        echo "HANDOFF: Phase B transient unit $UNIT owns the swap (sha=$B_SHA run=$RUN_ID) — poll (Phase A) exits pre-bounce by design"
        if [ -n "$NOTIFY_SESSION" ]; then NS_RC=0; notify_session "$NOTIFY_SESSION" "oc-deploy poll" "HANDOFF: swap unit $UNIT owns sha=$B_SHA run=$RUN_ID (features=$FEATURES) — Phase B owns the bounce" || NS_RC=$?; [ "$NS_RC" = 0 ] || echo "oc-deploy: notify-session rc=$NS_RC (handoff wake FAILED)" >&2; fi   # C-#2 + lens C MED-1 rc capture (v0.4.79)
        exit 0
      fi
      plan "swap path armed at stage $STAGE — pass --execute when S2 pilot authorized"
    else
      plan "stage $STAGE < S2: swap LOCKED (shadow mode — set ledger meta.oc_deploy_stage to S2 to unlock)"
      plan "would (at S2): artifact verify + auto-swap chain for $B_SHA, receipt"
    fi
    shadow_log poll "$B_SHA" "-" "planned"
    echo "plan complete — nothing executed"
    ;;
  # ------------------------------------------------------------ swap-execute --
  swap-execute)
    kill_brake
    # v0.4.153: detach BEFORE the lock and before any work. A swap launched from
    # inside the unit it bounces is SIGKILLed at step 8 — steps 9-12 (receipt,
    # fanout, ledger stamp) are then lost and the swap goes unrecorded.
    swap_ensure_detached
    [ -n "$SHA" ] && [ -n "$RUN_ID" ] || die 1 "swap-execute needs --sha <40-hex> and --run <id>"
    echo "$SHA" | grep -Eq '^[0-9a-f]{40}$' || die 1 "sha not 40-hex: $SHA"
    # NOTE (n=1878): NO local cat-file guard here — swap-execute targets the
    # remote host; its sha is authenticated by the carrier-run job-name decode
    # inside swap_execute, not by the local object DB. Local guard = false stops.
    SWAP_LOCK="$STATE_DIR/host-swap.lock"
    (
      if command -v flock >/dev/null 2>&1; then
        exec 200>"$SWAP_LOCK"
        flock -x 200 || die 2 "failed to acquire host-swap.lock ($SWAP_LOCK)"
      fi
      swap_execute "$SHA" "$RUN_ID" "$FEATURES" "$DRILL" "$ARTDIR" "$ALLOW_DROP"
    )
    ;;
  # ---------------------------------------------------------------- fanout --
  fanout)
    kill_brake
    fanout_run "$RUN_ID" "${DRYRUN:-0}"
    ;;
  # ----------------------------------------------------------------- watch --
  watch)
    kill_brake
    watch_run "${WITH_DELTA:-0}"
    ;;
  # ---------------------------------------------------------------- status --
  status)
    status_run "$@"
    ;;
  --selftest|selftest) selftest "$@" ;;
  *) die 1 "usage: oc-deploy ship [--sha S] [--features F] [--execute] [--gated-run ID] [--gated-sha SHA] [--allow-ungated-push \"<justification>\"] [--allow-features-drop] | poll [--execute] | swap-execute --sha S --run R [--features F] [--artifact-dir D] [--drill] [--allow-features-drop] | watch [--with-delta] | status [--json] | fanout --run R [--dry-run] | --selftest  (contributors RETIRED — use oc-attrib --contributors)" ;;
esac