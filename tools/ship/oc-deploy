# ------------------------------------------------- lineage verdict (v0.4.151) --
# Rebase-aware swap-guard decision. A fork-main rebase REWRITES shas: the
# currently deployed sha is left orphaned (it is no longer an ancestor of the
# incoming build) even though its CHANGE is fully present under a new sha. The
# pre-v0.4.151 guard tested ancestry only, so after every rewrite it refused
# EVERY legitimate forward swap — fleet-blocking (reported 2026-09-12).
#
#   monotonic  PREV is an ancestor of SHA                    -> accept
#   rewritten  PREV is orphaned, but a commit in BASE..SHA carries the SAME
#              patch-id (identical change, new sha)           -> accept (twin sha printed)
#   absent     both objects exist and PREV's change is genuinely NOT in SHA's
#              lineage (a real stale/delayed build)           -> refuse
#   unknown    one of the objects is not in this repo — cannot judge -> skip
#              (preserves the pre-v0.4.151 "if both exist" behaviour)
#
# Prints "<verdict> <twin-sha-or-empty>" on stdout. Always rc 0.
lineage_verdict() { # <repo> <prev_sha> <sha>
  local repo="$1" prev="$2" sha="$3" base pid twin
  git -C "$repo" cat-file -e "$prev^{commit}" 2>/dev/null || { echo "unknown "; return 0; }
  git -C "$repo" cat-file -e "$sha^{commit}"  2>/dev/null || { echo "unknown "; return 0; }
  if git -C "$repo" merge-base --is-ancestor "$prev" "$sha" 2>/dev/null; then
    echo "monotonic "; return 0
  fi
  # Fast path failed. Compare CONTENT: the deployed commit's patch-id vs every
  # commit in the incoming lineage since the fork point (single pass).
  pid="$(git -C "$repo" show "$prev" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}')"
  [ -n "$pid" ] || { echo "absent "; return 0; }
  base="$(git -C "$repo" merge-base "$prev" "$sha" 2>/dev/null || true)"
  [ -n "$base" ] || { echo "absent "; return 0; }
  twin="$(git -C "$repo" log -p --no-merges --format='commit %H' "$base..$sha" 2>/dev/null \
    | git patch-id --stable 2>/dev/null | awk -v p="$pid" '$1==p {print $2; exit}')"
  [ -n "$twin" ] && { echo "rewritten $twin"; return 0; }
  echo "absent "
  return 0
}

# Post-rewrite runbook line, shared by the guard and the lineage-check verb.
lineage_next_step() { # <verdict> <prev> <sha> <twin>
  case "$1" in
    monotonic) echo "next: proceed — the incoming build is a descendant of the deployed sha." ;;
    rewritten) echo "next: proceed — the deployed change is preserved as $4 in the incoming lineage (accepted automatically; no action needed)." ;;
    absent)    echo "next: DO NOT swap. The incoming build does not carry the deployed change. Re-dispatch a fresh build from fork main (oc-ship-chain), or, if the regression is intentional and audited, re-run with --allow-rewritten-lineage \"<justification>\"." ;;
    unknown)   echo "next: cannot judge — $2 or $3 is not an object in this repo. Check OC_DEPLOY_REPO and that both shas were fetched." ;;
  esac
}

# ------------------------------------------------ cgroup safety (v0.4.153) --
# A DIRECT `swap-execute` inherits the cgroup of whoever launched it. When that
# launcher is a session hosted by the very unit the swap is about to bounce
# (opencrabs-ops.service), step 8's `systemctl --user restart` tears that cgroup
# down and SIGKILLs this process AT the restart line. Steps 9-12 (post-verify,
# sidecar-sync, receipt, fanout) never run — and because the swap-result ledger
# stamp is deliberately LAST (v0.4.78 F-M1: receipt evidence must exist before
# the stamp, so a crash can never leave an unbacked DEPLOYED row), NO row is
# written at all. The host ends up fully swapped with a SILENT ledger: a
# false-negative audit trail, the dangerous direction of error.
# Evidence 2026-09-12: journal swap-acb8e205-1789199968-2602580.jsonl stops at
# seq 7 marker-write (mtime == swapped_at second), while
# swap-74d85785-1789182884-2365240.jsonl — handed to a `systemd-run` transient
# unit by `poll --execute`, i.e. OUTSIDE the unit — carries all 11 seqs.
# Fix: re-exec under a transient scope outside the bounce cgroup BEFORE any work
# starts. Called pre-lock (main's swap-execute case runs it before the
# host-swap.lock flock) so a re-entry can never self-deadlock on a held lock.
# Overrides: OC_SWAP_UNIT (default opencrabs-ops.service) · OC_SWAP_IN_UNIT_CGROUP
# (auto|1|0 — test hook; auto inspects /proc/self/cgroup) · OC_SWAP_DETACH_CMD
# (default `systemd-run --user --scope --collect`; MUST BLOCK and pass the child's
# rc through — use `setsid -w`, never bare `setsid`, or the swap's exit code is
# lost and a guard refusal reads as success) · OC_SWAP_DETACHED (loop guard, also
# set by the poll handoff so the transient-unit path never re-detaches).
swap_in_bounce_cgroup() { # rc 0 = this process IS inside the unit's cgroup
  local unit="${OC_SWAP_UNIT:-opencrabs-ops.service}" cg
  case "${OC_SWAP_IN_UNIT_CGROUP:-auto}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -r /proc/self/cgroup ] || return 1
  cg="$(cat /proc/self/cgroup 2>/dev/null || true)"
  case "$cg" in *"/$unit"|*"/$unit/"*) return 0 ;; esac
  return 1
}

swap_ensure_detached() { # re-exec outside the bounce cgroup (argv from ORIG_ARGS)
  [ "${OC_SWAP_DETACHED:-0}" = "1" ] && return 0   # already detached (loop guard)
  [ "${OC_SWAP_IN_UNIT_CGROUP:-auto}" = "0" ] && return 0  # test/selftest hook: disabled
  swap_in_bounce_cgroup || return 0
  local cmd="${OC_SWAP_DETACH_CMD:-systemd-run --user --scope --collect}"
  echo "oc-deploy: swap-execute is INSIDE ${OC_SWAP_UNIT:-opencrabs-ops.service}'s cgroup — the step-8 bounce would SIGKILL it before the receipt/fanout/ledger steps (v0.4.153 silent-ledger defect). Re-executing outside the unit via: $cmd" >&2
  OC_SWAP_DETACHED=1 exec $cmd "$SELF" "$MODE" "${ORIG_ARGS[@]}"
}

lineage_check_run() { # [--prev P] [--sha S] [--repo R] [--json]
  local repo="${OC_DEPLOY_REPO:-${HOME:-/root}/opencrabs}" prev="" sha="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --prev) prev="${2:-}"; shift ;;
      --sha)  sha="${2:-}";  shift ;;
      --repo) repo="${2:-}"; shift ;;
      --json) json=1 ;;
      *) die 1 "lineage-check: unknown arg: $1" ;;
    esac
    shift || true
  done
  [ -n "$prev" ] || prev="$(cat "$DEPLOYED" 2>/dev/null || true)"
  [ -n "$sha" ]  || sha="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$prev" ] || die 1 "lineage-check: no deployed sha (pass --prev)"
  [ -n "$sha" ]  || die 1 "lineage-check: cannot resolve --sha (pass it explicitly)"
  local out kind twin
  out="$(lineage_verdict "$repo" "$prev" "$sha")"
  kind="${out%% *}"; twin="${out#* }"
  if [ "$json" = 1 ]; then
    jq -cn --arg v "$kind" --arg p "$prev" --arg s "$sha" --arg t "$twin" --arg r "$repo" \
      '{verdict:$v, current_deployed:$p, incoming_sha:$s, rewritten_twin:$t, repo:$r}'
  else
    echo "repo:              $repo"
    echo "current_deployed:  $prev"
    echo "incoming_sha:      $sha"
    echo "verdict:           $kind"
    [ "$kind" = "rewritten" ] && echo "rewritten_twin:    $twin"
    lineage_next_step "$kind" "$prev" "$sha" "$twin"
  fi
  case "$kind" in monotonic|rewritten) return 0 ;; *) return 2 ;; esac
}

# ------------------------------------------ receipt recovery (v0.4.153) --
# A swap launched INSIDE the unit it bounces is SIGKILLed at step 8 (the
# restart), so steps 9-12 never run and NO swap-result ledger row is written:
# the host is swapped, the ledger is silent — a false-negative audit trail
# (lane 2fbfb2f8, 2026-09-12; journal swap-acb8e205-1789199968-2602580.jsonl
# stops at seq 7 marker-write while the daemon really did bounce onto the new
# binary). The v0.4.153 cgroup self-detach fixes the CAUSE; this verb repairs
# the EVIDENCE for a swap already truncated, idempotently.
#
# It stamps ONLY when every guard holds, reading the journal alone (a crash is
# reconstructable from the journal by design):
#   - install exit=0 AND marker-write exit=0  -> the swap is REAL
#   - NO receipt step                         -> it was truncated (else: done)
#   - deployed.sha still == the journal sha   -> not superseded by a later swap
#   - no swap-result ledger row quoting sha+run -> idempotent, never double-stamp
# Fan-out is deliberately NOT replayed here (use `oc-deploy fanout --run <id>`):
# fanout has its own done-marker and a replay would re-notify contributors.
# rc: 0 = handled (recovered, or correctly nothing to do) · 2 = refused (the journal
# does not describe a recoverable real swap) — a caller scripting recovery can tell
# "done" from "needs attention".
recover_receipt_run() { # [--journal PATH] [--run R] [--sha S] [--dry-run] [--json]
  local jf="" run="" sha="" dry=0 json=0 cand hist=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --journal) jf="${2:-}"; shift ;;
      --run)     run="${2:-}"; shift ;;
      --sha)     sha="${2:-}"; shift ;;
      --dry-run) dry=1 ;;
      --json)    json=1 ;;
      --historical) hist=1 ;;   # sha no longer == deployed.sha: record as a superseded swap
      *) die 1 "recover-receipt: unknown arg: $1" ;;
    esac
    shift || true
  done
  if [ -z "$jf" ] && { [ -n "$run" ] || [ -n "$sha" ]; }; then
    # SELECTOR MODE (v0.4.157): --run/--sha MUST select the journal they name.
    # Pre-v0.4.157 both were parsed and then silently DROPPED - with no --journal
    # the code fell through to the default branch, took the newest truncated
    # journal regardless of the selectors, and echoed the caller's --run beside a
    # journal belonging to a DIFFERENT run. Observed live 2026-09-12 (lane
    # 2fbfb2f8): `--run 34685906807` resolved to a 4-seq journal of run
    # 34683445854 and returned rc 0 "the swap never installed" - a false negative
    # for a swap that had COMPLETED and was deployed. That is precisely the state
    # that tempts a re-run of a live swap, the failure this verb exists to stop.
    # A selector that cannot be satisfied REFUSES; it never falls back to a default.
    local matches="" m cand2 mrun2 msha2 what="--run ${run:-<none>} --sha ${sha:-<none>}"
    for cand2 in $(ls -1t "$JOURNAL_DIR"/swap-*.jsonl 2>/dev/null); do
      mrun2="$(jq -rs '[.[]|select(.step=="auto-swap")][-1].run_id // empty' "$cand2" 2>/dev/null)"
      msha2="$(jq -rs '[.[]|select(.step=="marker-write")][-1].deployed_sha // empty' "$cand2" 2>/dev/null)"
      if [ -n "$run" ] && [ "$mrun2" != "$run" ]; then continue; fi
      if [ -n "$sha" ]; then
        case "$msha2" in "$sha"*) : ;; *) continue ;; esac
      fi
      matches="$matches$cand2
"
    done
    matches="$(printf '%s' "$matches" | sed '/^$/d')"
    # NB: count with `grep -c .`, NOT `wc -l` — $( ) strips the trailing newline,
    # so wc -l undercounts by one (2 matches reads as 1, 1 match reads as 0).
    local nmatch; nmatch="$(printf '%s\n' "$matches" | grep -c . || true)"
    if [ "$nmatch" = 0 ]; then
      if [ "$json" = 1 ]; then
        echo "{\"recoverable\":false,\"reason\":\"no journal matches $what\"}"
      else
        echo "recover-receipt: NO journal in $JOURNAL_DIR matches $what" >&2
        echo "  refusing - a selector that matches nothing must never fall back to the newest journal." >&2
        echo "  pass --journal <path> to name one explicitly." >&2
      fi
      return 2
    fi
    jf=""
    if [ "$nmatch" = 1 ]; then
      jf="$matches"
    else
      # Several journals share the selector - one run can journal more than once
      # (a direct attempt plus a detached one; observed live: run 34683445854 has
      # a 4-seq truncated journal AND an 11-seq complete one).
      # A journal carrying a receipt step PROVES that run completed, and its row
      # was stamped by that very run. So a complete match wins outright: the
      # honest verdict is "nothing to recover". Picking the receipt-less sibling
      # instead would answer "the swap never installed" for a run that plainly
      # did - the same false-negative shape this selector fix exists to kill.
      local cpl="" c3
      for c3 in $matches; do
        [ "$(jq -s '[.[]|select(.step=="receipt")]|length' "$c3" 2>/dev/null || echo 0)" != 0 ] && cpl="$cpl$c3
"
      done
      cpl="$(printf '%s' "$cpl" | sed '/^$/d')"
      local ncpl; ncpl="$(printf '%s\n' "$cpl" | grep -c . || true)"
      if [ "$ncpl" -ge 1 ]; then
        jf="$(printf '%s' "$cpl" | head -1)"   # newest complete match
      else
        # no match completed: every one is a truncated candidate, so the choice
        # is genuinely ambiguous - refuse and name them rather than guess.
        echo "recover-receipt: AMBIGUOUS - $nmatch journals match $what, none with a receipt step:" >&2
        printf '%s\n' "$matches" | sed 's/^/    /' >&2
        die 2 "recover-receipt: name one with --journal"
      fi
    fi
  fi
  if [ -z "$jf" ]; then
    # default: the newest journal that LACKS a receipt step — i.e. the actionable
    # truncated one. A journal that carries receipt is complete and not our job.
    for cand in $(ls -1t "$JOURNAL_DIR"/swap-*.jsonl 2>/dev/null); do
      [ "$(jq -s '[.[]|select(.step=="receipt")]|length' "$cand" 2>/dev/null || echo 1)" = 0 ] && { jf="$cand"; break; }
    done
    if [ -z "$jf" ]; then
      [ "$json" = 1 ] && echo '{"recoverable":false,"reason":"no truncated journal found"}' \
        || echo "recover-receipt: no truncated journal in $JOURNAL_DIR — every swap carries a receipt step"
      return 0
    fi
  fi
  [ -f "$jf" ] || die 1 "recover-receipt: journal not found: $jf"
  # v0.4.157 belt-and-braces: never echo a selector the chosen journal does not
  # carry. The selection above filters on exactly these fields, so a mismatch
  # here means the selection logic broke - refuse rather than report a run id
  # belonging to a different journal (the 2fbfb2f8 false-negative shape).
  if [ -n "$run" ] || [ -n "$sha" ]; then
    local vrun vsha
    vrun="$(jq -rs '[.[]|select(.step=="auto-swap")][-1].run_id // empty' "$jf" 2>/dev/null)"
    vsha="$(jq -rs '[.[]|select(.step=="marker-write")][-1].deployed_sha // empty' "$jf" 2>/dev/null)"
    [ -z "$run" ] || [ "$vrun" = "$run" ] || die 2 "recover-receipt: selector mismatch - --run $run but $jf carries run=${vrun:-<none>}"
    if [ -n "$sha" ]; then
      case "$vsha" in "$sha"*) : ;; *) die 2 "recover-receipt: selector mismatch - --sha $sha but $jf carries sha=${vsha:-<none>}" ;; esac
    fi
  fi

  local has_install has_marker has_receipt jsha jrun
  has_install="$(jq -s '[.[]|select(.step=="install" and .exit==0)]|length' "$jf" 2>/dev/null || echo 0)"
  has_marker="$(jq -s '[.[]|select(.step=="marker-write" and .exit==0)]|length' "$jf" 2>/dev/null || echo 0)"
  has_receipt="$(jq -s '[.[]|select(.step=="receipt")]|length' "$jf" 2>/dev/null || echo 0)"
  jsha="$(jq -rs '[.[]|select(.step=="marker-write")][-1].deployed_sha // empty' "$jf" 2>/dev/null)"
  jrun="$(jq -rs '[.[]|select(.step=="auto-swap")][-1].run_id // empty' "$jf" 2>/dev/null)"
  [ -n "$run" ] || run="$jrun"
  [ -n "$sha" ] || sha="$jsha"

  local cur existing reason="" ok=1 superseded=0 refuse=0
  cur="$(cat "$DEPLOYED" 2>/dev/null || echo MISSING)"
  if [ "$has_receipt" != 0 ]; then reason="journal already carries a receipt step — swap completed, nothing to recover"; ok=0
  elif [ "$has_install" = 0 ]; then reason="journal has no install exit=0 — the swap never installed; refusing to stamp"; ok=0; refuse=2
  elif [ "$has_marker" = 0 ]; then reason="journal has no marker-write exit=0 — markers never written; refusing to stamp"; ok=0; refuse=2
  elif [ -z "$sha" ]; then reason="journal names no deployed sha (and --sha not given) — cannot judge"; ok=0; refuse=2
  elif [ "$cur" != "$sha" ]; then
    if [ "$hist" = 1 ]; then superseded=1
    else reason="deployed.sha ($cur) != journal sha ($sha) — a later swap superseded this one; refusing to stamp (pass --historical to record it as a superseded swap)"; ok=0; refuse=2
    fi
  fi
  if [ "$ok" = 1 ]; then
    existing="$(jq -r --arg s "sha=$sha" --arg r "run=$run" \
      '[.events[]|select(.kind=="swap-result" and (.what|contains($s)) and (.what|contains($r)))]|length' \
      "$LEDGER" 2>/dev/null || echo 0)"
    [ "$existing" = 0 ] || { reason="ledger already carries a swap-result row for sha=$sha run=$run — idempotent no-op"; ok=0; }
  fi

  if [ "$json" = 1 ]; then
    jq -cn --arg j "$jf" --arg s "$sha" --arg r "$run" --arg c "$cur" --arg why "$reason" \
      --argjson ok "$([ "$ok" = 1 ] && echo true || echo false)" \
      '{journal:$j, sha:$s, run:$r, deployed_sha:$c, recoverable:$ok, reason:$why}'
  else
    echo "journal:      $jf"
    echo "sha:          ${sha:-<none>}"
    echo "run:          ${run:-<none>}"
    echo "deployed.sha: $cur"
  fi
  if [ "$ok" != 1 ]; then
    [ "$json" = 1 ] || echo "verdict:      not recovered — $reason"
    return $refuse
  fi
  if [ "$dry" = 1 ]; then
    [ "$json" = 1 ] || echo "verdict:      RECOVERABLE (dry-run — no stamp written)"
    return 0
  fi
  local kw="RECOVERED" note=""
  [ "$superseded" = 1 ] && { kw="SUPERSEDED"; note=" (superseded by a later swap — deployed.sha is now $cur)"; }
  ledger_stamp "oc-deploy recover-receipt" \
    "swap-result $kw sha=$sha run=$run: install(exit=0)+marker-write(exit=0) present but the receipt step was lost to a truncated run; row reconstructed post-hoc from journal=$jf$note (v0.4.153 cgroup-kill defect)" \
    "swap-result"
  [ "$json" = 1 ] || echo "verdict:      $kw — swap-result row stamped"
  return 0
}

stage() { jq -r '.meta.oc_deploy_stage // "S0"' "$LEDGER" 2>/dev/null || echo S0; }
shadow_log() { # <op> <sha> <features> <result>
  printf '%s\t%s\t%s\t%s\t%s\tstage=%s\n' \
    "$(date -u +%FT%TZ)" "$1" "${2:--}" "${3:--}" "${4:--}" "$(stage)" \
    >> "$SHADOW" 2>/dev/null || true
}

# ------------------------------------------------------- journal (S2 spec) --
JF=""; SEQ=0
journal_init() { # $1 = short label
  mkdir -p "$JOURNAL_DIR"
  JF="$JOURNAL_DIR/swap-$1-$(date +%s)-$$.jsonl"   # Duty-6 lens F task 4: $$ suffix — same-second collision truncated the first run's crash journal (fanout already had $$)
  : > "$JF"; SEQ=0
}
jline() { # $1=step  $2=exit(int|null)  $3=extra-json-object (optional)
  SEQ=$((SEQ+1))
  jq -cn --arg ts "$(date -u +%FT%TZ)" --argjson seq "$SEQ" --arg step "$1" \
     --argjson exit "${2:-null}" --argjson extra "${3:-\{\}}" \
     '{ts:$ts, seq:$seq, step:$step, exit:$exit} + $extra' >> "$JF"
  sync -f "$JF" 2>/dev/null || sync 2>/dev/null || true
}

# --------------------------------------------------- backup retention (#497) --
prune_binary_backups() { # $1 = the backup JUST TAKEN (never a prune candidate)
  # Keep the newest $BAK_KEEP backups, delete older ones (#497, HQ toolshed
  # item 2). Rules, each answering a way this could destroy a rollback point:
  #
  #  * ONLY files matching the chain's own naming convention are ever touched —
  #    `opencrabs-YYYYMMDD-HHMMSS-pre-<hex>`. Anything else in the directory
  #    (a hand-made copy, a differently-named artefact) is left alone, so this
  #    cannot eat a file it did not create.
  #  * ORDER IS THE FILENAME STAMP, never mtime: `cp -p` preserves the source's
  #    timestamps, so mtimes tie and mislead (measured 4-way). The stamp is
  #    fixed-width, so a lexicographic sort IS chronological.
  #  * THE JUST-TAKEN BACKUP IS EXEMPT by construction — it is the newest name —
  #    but it is also passed in explicitly and skipped by path, so a clock skew
  #    (a machine whose clock stepped back between swaps) cannot make the fresh
  #    backup look oldest.
  #  * NOTHING IS PRUNED BELOW THE KEEP COUNT, so an in-flight swap's journaled
  #    `backup_path` is inside the window: rollback reads that exact path and
  #    never scans the directory.
  #  * A NO-OP IS SILENT. A prune that reports on every healthy swap is noise.
  local fresh="${1:-}" keep="${BAK_KEEP:-5}" f
  [ -d "$BACKUP_DIR" ] || return 0
  case "$keep" in ''|*[!0-9]*) return 0 ;; esac   # a bad value must not mean "prune everything"
  [ "$keep" -ge 1 ] || return 0

  local pruned=0 freed=0 size
  # Newest-first by NAME; skip the first $keep, prune the remainder.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -n "$fresh" ] && [ "$f" = "$fresh" ] && continue
    size="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    if rm -f "$f"; then
      pruned=$((pruned + 1))
      freed=$((freed + size))
    fi
  done <<EOF
$(ls -1 "$BACKUP_DIR" 2>/dev/null \
    | grep -E '^opencrabs-[0-9]{8}-[0-9]{6}-pre-[0-9a-f]+$' \
    | sort -r \
    | tail -n +"$((keep + 1))" \
    | sed "s|^|$BACKUP_DIR/|")
EOF

  if [ "$pruned" -gt 0 ]; then
    printf 'oc-deploy: backup retention: pruned %d old backup(s), %d MB freed, kept newest %d\n' \
      "$pruned" "$((freed / 1048576))" "$keep" >&2
    jline backup-prune 0 "$(jq -cn --argjson n "$pruned" --argjson b "$freed" \
      --argjson keep "$keep" '{pruned:$n, bytes_freed:$b, keep:$keep}')"
  fi
  return 0
}

# -------------------------------------------------- ledger stamp (flock'd) --
ledger_stamp() { # $1=by  $2=what  $3=kind
  [ "$3" = "swap-result" ] || { echo "oc-deploy: ledger_stamp kind must be swap-result (enum write-side guard, v0.4.77)" >&2; return 2; }
  (
    flock -x 9
    local n tmp
    n="$(jq '[.events[].n] | max // 0' "$LEDGER" 2>/dev/null || echo 0)"
    tmp="$(mktemp)" || exit 4
    jq --argjson n "$((n+1))" --arg t "$(date -u +%FT%TZ)" --arg by "$1" \
       --arg what "$2" --arg kind "$3" \
       '.events += [{n:$n, t:$t, by:$by, what:$what, kind:$kind}]' \
       "$LEDGER" > "$tmp" && mv "$tmp" "$LEDGER"
  ) 9>"$LEDGER.lock"
}

# ------------------------------------------------------------ A2A receipts --
a2a_notify() { # $1=text ; exit 0 accepted
  [ -n "$A2A_URL" ] || return 1
  curl -fsS --max-time 15 -X POST "$A2A_URL" -H 'Content-Type: application/json' \
    -d "$(jq -cn --arg t "$1" '{jsonrpc:"2.0", id:1, method:"message/send",
         params:{message:{role:"ROLE_USER", parts:[{kind:"text", text:$t}]}}}')" \
    >/dev/null 2>&1
}

a2a_notify_retry() { # $1=text — retry up to OC_A2A_TRIES (default 6), sleeping
  # OC_A2A_RETRY_SLEEP (default 10s) between tries; returns a2a_notify's rc.
  # WHY (2026-08-28, journal swap-87d3bcb8-1787916830 seq9 exit=1): the receipt
  # races the daemon restart the swap itself just triggered — the gateway is
  # down for several seconds, the single-shot POST died, and the owner never
  # heard about a successful swap. Retrying makes the receipt survive the gap.
  [ -n "$A2A_URL" ] || return 1
  local n=0 max=${OC_A2A_TRIES:-6} s=${OC_A2A_RETRY_SLEEP:-10}
  while :; do
    a2a_notify "$1" && return 0
    n=$((n+1)); [ "$n" -ge "$max" ] && return 1
    if [ "$s" -gt 0 ]; then sleep "$s"; fi
  done
}

