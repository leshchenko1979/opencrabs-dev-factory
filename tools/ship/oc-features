#!/usr/bin/env bash
# =============================================================================
# oc-features — print the carrier workflow's `features:` default set.
#
# KERNEL batch D1 (C1, 2026-08-28). The carrier branch ci/quick-build-linux
# owns the ONLY quick-build-linux.yml; its workflow_dispatch `features:` input
# default IS the canonical feature set (owner build-lane directive: prod
# builds carry the set the carrier defines). Replaces hand `grep -A2` of the
# yml at 4 sites; oc-build ship resolves its --features default through this
# tool and ABORTS on read failure (never a silent fallback set).
#
# Usage:
#   ./tools/ship/oc-features [--repo ~/opencrabs] [--ref ci/quick-build-linux]
#   ./tools/ship/oc-features --selftest
#
# Exit codes: 0 set printed · 2 usage · 3 carrier yml unreadable ·
#             4 no features input found / invalid shape
#
# THE CARRIER YML IS READ REMOTELY — that is the ONLY source, one code path.
#   gh api repos/<owner>/<repo>/contents/.github/workflows/quick-build-linux.yml?ref=<ref>
# The local-fetch leg is GONE (#168 cut 2). It measured 767.9 s and 292.5 s on
# 2026-11-19/20 and aborted ships with no carrier dispatched, while the same
# fetch measured 7.0-7.8 s minutes later — a stall with no bound worth keeping.
# The non-fetch path read origin/<ref> out of a local clone nothing else
# refreshes, so a stale mirror could name a set nobody ships. `oc-gate` already
# reads carrier workflow files this way. ANY read failure is rc 3: loud, never a
# silent fallback to a local mirror.
# Test seam: OC_CARRIER_GH overrides the `gh` binary (see the selftest).
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-features" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

PROG="$(basename "$0")"
usage() { [ -n "${1:-}" ] && echo "oc-features: $1" >&2; echo "usage: $0 [--repo <path>] [--ref <branch>] | --selftest" >&2; exit 2; }   # lens C MED-2 (v0.4.79)
help()   { echo "usage: $0 [--repo <path>] [--ref <branch>] | --selftest"; echo "Exit: 0 set printed / 2 usage / 3 carrier yml unreadable / 4 no-features-input"; }  # C-#3: help=0

# #166 hermeticity: the defaults are ENV-PINNABLE. A production caller passes
# nothing and keeps $HOME/opencrabs; a test harness pins OC_CARRIER_REPO to a
# fixture repo and OC_CARRIER_GH to a stub, so feature resolution never touches
# the live repo or the network. Explicit --repo/--ref flags still win over both
# env and default.
REPO="${OC_CARRIER_REPO:-$HOME/opencrabs}"; REF="${OC_CARRIER_REF:-ci/quick-build-linux}"; SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO="${2:-}"; shift ;;
    --ref) REF="${2:-}"; shift ;;
    --selftest) SELFTEST=1 ;;
    -h|--help) help; exit 0 ;;  # C-#3
    *) usage "unknown flag: $1" ;;
  esac
  shift
done
[ -n "$REPO" ] && [ -n "$REF" ] || usage "--ref is required"

# extract <yml-text> — features: input default on stdout; empty if absent
extract_features_default() {
  printf '%s\n' "$1" | awk '
    {
      line = $0
      indent = 0
      if (match(line, /[^ ]/)) indent = RSTART - 1
    }
    !inf && line ~ /^ *features:[[:space:]]*$/ { inf = 1; fi_indent = indent; next }
    inf {
      if (line ~ /^[[:space:]]*$/) next
      if (indent <= fi_indent) { inf = 0; next }        # left the features block
      if (line ~ /^ *default:/) {
        sub(/^ *default:[[:space:]]*/, "", line)
        gsub(/[\047"]/, "", line)                       # strip single/double quotes
        sub(/[[:space:]]+#.*$/, "", line)               # trailing comment
        gsub(/[[:space:]]/, "", line)
        print line
        exit
      }
    }
  '
}

valid_set() { printf '%s' "$1" | grep -Eq '^[a-z0-9_-]+(,[a-z0-9_-]+)*$'; }

GH_BIN="${OC_CARRIER_GH:-gh}"   # test seam: the remote read is stubbable

carrier_slug() { # owner/repo from $REPO's origin remote; rc 1 when unparseable
  local url rest
  url="$(git -C "$REPO" remote get-url origin 2>/dev/null)" || return 1
  url="${url%.git}"
  case "$url" in
    *github.com[:/]*) rest="${url#*github.com[:/]}" ;;
    *) return 1 ;;
  esac
  case "$rest" in ""|*/*/*) return 1 ;; esac   # exactly owner/repo
  printf '%s\n' "$rest"
}

read_carrier() { # -> yml on stdout, rc 3 on failure (never a fallback read)
  local slug out rc
  slug="$(carrier_slug)" \
    || { echo "$PROG: cannot derive owner/repo from the origin remote of $REPO — carrier yml unreadable (rc 3)" >&2; return 3; }
  out="$("$GH_BIN" api -H 'Accept: application/vnd.github.raw' \
    "repos/$slug/contents/.github/workflows/quick-build-linux.yml?ref=$REF" 2>/dev/null)"; rc=$?
  [ "$rc" -eq 0 ] \
    || { echo "$PROG: carrier yml unreadable at $slug@$REF ($GH_BIN api rc=$rc) — no fallback read (rc 3)" >&2; return 3; }
  printf '%s\n' "$out"
}

if [ "$SELFTEST" -eq 1 ]; then
  d="$(mktemp -d)" || exit 3
  trap '_rc=$?; rm -rf "$d"; oc_log_finish "$_rc"' EXIT
  mk_yml() { # $1=file $2=features-default line ("" = no features input at all)
    {
      printf 'name: quick-build-linux\non:\n  workflow_dispatch:\n    inputs:\n'
      printf '      source_ref:\n        description: full 40-char sha\n        required: true\n'
      if [ -n "$2" ]; then
        printf '      features:\n        description: comma set\n'
        printf '        %s\n' "$2"
      fi
      printf '      after_inputs_key:\n        default: nope\n'
      printf 'jobs:\n  build:\n    runs-on: ubuntu-latest\n'
    } > "$1"
  }
  mk_repo() { # $1=dir — origin is a github slug, so the read must be remote
    git init -q -b main "$1" || return 1
    git -C "$1" config user.email t@t; git -C "$1" config user.name t
    git -C "$1" remote add origin git@github.com:acme/carrier.git
  }
  mk_fx() { # $1=ref $2=features-default line — what the REMOTE serves for that ref
    mkdir -p "$d/fx"
    mk_yml "$d/fx/$(printf '%s' "$1" | tr '/' '_').yml" "$2"
  }
  # The gh stub: serves the fixture for the ref named in the contents URL and
  # fails for anything else. GH_FAIL=1 makes every call fail (the loud rc 3 arm).
  cat > "$d/gh" <<'SHIM'
#!/usr/bin/env bash
[ "${GH_FAIL:-0}" = 1 ] && { echo "gh: fixture failure" >&2; exit 1; }
for a in "$@"; do
  case "$a" in
    repos/*/contents/*)
      ref="${a##*ref=}"
      f="$GH_FX/$(printf '%s' "$ref" | tr '/' '_').yml"
      [ -f "$f" ] || { echo "gh: no carrier yml for ref $ref" >&2; exit 1; }
      cat "$f"; exit 0 ;;
  esac
done
echo "gh: unexpected args: $*" >&2; exit 1
SHIM
  chmod +x "$d/gh"
  export GH_FX="$d/fx" OC_CARRIER_GH="$d/gh"
  pass=0; fail=0
  chk() { if [ "$1" -eq "$2" ]; then pass=$((pass+1)); echo "selftest: $3 OK"; else fail=$((fail+1)); echo "selftest: $3 FAIL (rc=$1 want $2)"; fi }

  mk_repo "$d/good" || exit 3
  mk_fx "$REF" "default: 'telegram'"
  OUT="$("$0" --repo "$d/good")"; chk $? 0 "valid carrier prints set"
  [ "$OUT" = "telegram" ] && { pass=$((pass+1)); echo "selftest: exact set OK"; } || { fail=$((fail+1)); echo "selftest: got '$OUT' want 'telegram'"; }

  mk_fx "$REF" "default: 'telegram,browser'"
  OUT="$("$0" --repo "$d/good")"
  [ "$OUT" = "telegram,browser" ] && { pass=$((pass+1)); echo "selftest: multi-feature set OK"; } || { fail=$((fail+1)); echo "selftest: multi got '$OUT'"; }

  mk_fx "other-branch" "default: 'eval'"
  OUT="$("$0" --repo "$d/good" --ref other-branch)"
  [ "$OUT" = "eval" ] && { pass=$((pass+1)); echo "selftest: --ref selects the ref OK"; } || { fail=$((fail+1)); echo "selftest: --ref got '$OUT'"; }

  mk_fx "$REF" ""
  "$0" --repo "$d/good" >/dev/null 2>&1; chk $? 4 "no features input -> 4"

  mk_fx "$REF" "default: 'tele gram!'"
  "$0" --repo "$d/good" >/dev/null 2>&1; chk $? 4 "invalid shape -> 4"

  "$0" --repo "$d/good" --ref no-such-branch >/dev/null 2>&1; chk $? 3 "missing carrier branch -> 3"

  # ---- the read is REMOTE, and ONLY remote ---------------------------------
  # A repo carrying a DIFFERENT set on its own refs/remotes/origin/<ref> must
  # not be read: that ref is the stale local mirror the deleted path trusted.
  mk_fx "$REF" "default: 'telegram'"
  mkdir -p "$d/good/.github/workflows"
  mk_yml "$d/good/.github/workflows/quick-build-linux.yml" "default: 'stale'"
  git -C "$d/good" add -A >/dev/null 2>&1; git -C "$d/good" commit -qm stale >/dev/null 2>&1
  git -C "$d/good" update-ref "refs/remotes/origin/$REF" HEAD
  OUT="$("$0" --repo "$d/good")"
  [ "$OUT" = "telegram" ] \
    && { pass=$((pass+1)); echo "selftest: the local mirror is NOT read (remote wins) OK"; } \
    || { fail=$((fail+1)); echo "selftest: read a stale local mirror -- got '$OUT' want 'telegram'"; }

  # A remote-read failure is LOUD (rc 3) and never falls back to that mirror.
  GH_FAIL=1 "$0" --repo "$d/good" >/dev/null 2>&1; chk $? 3 "remote read failure -> 3 (no fallback)"
  ERR="$(GH_FAIL=1 "$0" --repo "$d/good" 2>&1 >/dev/null)"
  grep -q 'carrier yml unreadable' <<< "$ERR" \
    && { pass=$((pass+1)); echo "selftest: the read failure NAMES itself OK"; } \
    || { fail=$((fail+1)); echo "selftest: read-failure message absent (got: $ERR)"; }

  # The deleted flag is REFUSED, never silently accepted.
  "$0" --repo "$d/good" --fetch >/dev/null 2>&1; chk $? 2 "--fetch is refused (flag deleted)"

  git init -q "$d/nogit"
  "$0" --repo "$d/nogit" >/dev/null 2>&1; chk $? 3 "no origin remote -> 3"
  "$0" --repo "$d/nope" >/dev/null 2>&1; chk $? 3 "missing repo -> 3"

  [ "$fail" -eq 0 ] && { echo "selftest OK ($pass checks)"; exit 0; } || { echo "selftest FAILED ($fail)" >&2; exit 1; }
fi

YML="$(read_carrier)" || exit 3
SET="$(extract_features_default "$YML")"
[ -n "$SET" ] || { echo "$PROG: no features input default found in carrier yml" >&2; exit 4; }
valid_set "$SET" || { echo "$PROG: features default is not a comma-set: '$SET'" >&2; exit 4; }
printf '%s\n' "$SET"
exit 0
