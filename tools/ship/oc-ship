#!/usr/bin/env bash
# oc-ship — single-invocation orchestrator: CI gate → issue-log → ff-merge
# into fork main → oc-build ship → oc-status poll until SWAPPED.
#
# Owner GO 2026-09-09 16:16Z ("Go" on the 5→swapped design). Scope ends at
# SWAPPED: smoke (Phase 6b) and owner approval (Phase 7) stay OUTSIDE — the
# tool never touches them.
#
# Why: lanes kept stopping "at GREEN" (E-H1: verdict, not a deploy) and
# skipping the swap leg (#134 orphan class). One invocation = one clean
# attempt; there is NO legitimate exit point between gate verdict and swap.
# RED outcomes are structured exits — the LANE owns the fix round, the tool
# never retries internally.
#
# Usage:
#   oc-ship --sha <sha> --branch <branch> [--issue <n>] [--issue-repo <slug>]
#                 [--repo <fork-slug>]
#                 [--gated-sha <sha>] [--gated-run <id>] [--wait <sec>]
#                 [--gate-wait <sec>] [--full] [--test-threads <N>]
#                 [--dry-run] [--no-ledger] [--no-rearm] [--selftest] [--help]
#                 [--priority low|normal] [--resolve-priority]
#   oc-ship --eval-docs-skip [<sha>]
#
#   --priority low|normal  Scheduling class for the chain and every child it
#                    forks (default: low = nice 19 + I/O class idle). A chain is
#                    background work and must not compete with the daemon; pass
#                    `normal` for an interactive or debugging run.
#   --resolve-priority  Apply the real priority block, print the resolved class
#                    (priority=/nice=/ioprio=/applied=) and exit 0. Read-only
#                    probe; used by --selftest.
#
# Flags:
#   --eval-docs-skip [<sha>] Evaluate whether a commit qualifies for the docs-only
#                    LEG1 gate skip (rc 0 = docs-only / gate skippable; rc 1 = gate
#                    required; rc 2 = missing sha; rc 3 = bad commit or git error).
#                    Judges the WHOLE shipped range (merge-base of fork main and
#                    <sha> .. <sha>), not the tip commit alone — the chain
#                    fast-forwards the entire branch into main, so a code commit
#                    under a docs-only tip must gate (#322).
#                    Can also be paired with --sha <sha>.
#   --fast           Default gate mode (passes fast=true to oc-gate).
#   --full|--no-fast Opt-in full test suite gate (~30 min).
#   --no-rearm       Disable the #78 Class A re-arm supervisor for this run.
#                    #92: a CANCELLED-superseded gate is re-armed by RESUMING
#                    the superseder prchecks named (`--gated-run <id>`), never
#                    by dispatching a fresh gate onto the same ref -- that is
#                    what cancelled it. An unnamed superseder (`none found`,
#                    the TIMEOUT-cancel class) still refuses.
#                    Default is ON: a chain that dies of a MECHANICAL cause with
#                    nothing external in flight (ship-lock timeout rc 9; gate
#                    INFRA rc 6 from a pre-dispatch prchecks 4/7/8) restarts
#                    itself in-tool instead of waking the arming lane. A run
#                    stopped by a SIGNAL never re-arms, and neither does any
#                    class that already touched the world (a fresh dispatch onto
#                    a gated ref cancels the in-flight run — it would destroy
#                    the verdict it is waiting for). Budget: 2 attempts
#                    (OC_SHIPCHAIN_REARM_MAX). Env form: OC_SHIPCHAIN_NO_REARM=1.
#   --test-threads <N>  RETIRED 2026-11-20 (#181): the carrier declares
#                    `test_threads` and IGNORES it, so the #1936 Stage-1 hang
#                    mitigation (factory #39) is dead and NOTHING is forwarded
#                    to LEG1's oc-gate dispatch. The flag stays parsed for
#                    compatibility: the request is ACCEPTED, NOT FORWARDED and
#                    the chain SAYS SO on stderr + journal (the old INERT
#                    warning's carried-path caveat is now true on every path).
#                    Env: OC_SHIPCHAIN_TEST_THREADS (same shape; empty =
#                    not requested).
#
# --issue-repo <slug>  The tracker that OWNS --issue, for LEG2's mandatory
#                    per-commit comment. `--repo` above is the FORK CHECKOUT's
#                    slug (used by oc-gate); this is the ISSUE's tracker.
#                    Resolution order: --issue-repo, then OC_ISSUE_LOG_REPO,
#                    then a probe of the three known trackers (fork
#                    leshchenko1979/opencrabs, binary opencrabs/opencrabs,
#                    factory leshchenko1979/opencrabs-dev-factory).
#                    A number present on SEVERAL trackers is resolved to the
#                    one that is OPEN; if that is still ambiguous the chain
#                    defaults to the FORK and WARNS loudly -- refusing would
#                    break every fork ship whose number collides with an
#                    upstream issue, which is most numbers <= 766.
#                    OC_SHIPCHAIN_NO_ISSUE_PROBE=1 skips the probe.
#
# --wait <sec>       LEG4 ship/swap budget (default 2700 = 45 min; the 10 most
#                    recent successful carrier builds on this box ALL ran
#                    942-1344 s (15.7-22.4 min), so the old 900 s default
#                    expired on every one of them and surfaced as an INFRA
#                    failure — defect #336).
#                    Env: OC_SHIPCHAIN_SHIP_WAIT.
# --gate-wait <sec>  LEG1 CI-gate budget (default 2700 = 45 min; the PR-lane
#                    gate runs ~30 min here, and oc-gate' own default is
#                    600 s, which is SHORTER than the gate — see Exit 5/7).
#                    Env: OC_SHIPCHAIN_GATE_WAIT.
#
# Background execution:
#   Runs across Legs 1-3 sequentially. Call with bash tool parameter background: true.
#   The daemon auto-resumes the session when SWAPPED (rc 0) or on structured exit.
#
# Exit (FULL register: tools/docs/RC-CONTRACT.md — `oc-ship` row in the rc table):
#   0 SWAPPED · 2 usage · 3 precondition not met (fork checkout ABSENT or not a git
#   checkout — a LINKED WORKTREE is accepted, #69; dirty checkout; or $BRANCH absent
#   from the fork remote. Lane fix, NEVER infra) · 4 GATE-RED / CARRIER-RED
#   (structured verdict) · 6 dispatch/poll infra, incl. a lineage-guard refusal
#   (rebase-aware: re-run; diagnose with `oc-verify-lineage`) · 7 gate still
#   IN FLIGHT — do NOT re-dispatch, re-run with --gated-run <id> · 8 SHIP-WAIT-TIMEOUT
#   — the build is still RUNNING, resume with `oc-status poll --execute` · 9
#   SHIP-LOCK-TIMEOUT — another chain holds the landing lock; wait or raise
#   SHIP_LOCK_TIMEOUT / OC_SHIPCHAIN_LOCK_WAIT.
#   5 — EIGHT distinguishable causes, each a LANE fix; the message and journal name
#   which one (remedies differ, severity does not):
#     NON-FF              rebase via oc-rebase-safety, then re-run
#     STALE-BASE          origin/main moved since the gate; rebase with patch-id
#                         carry-forward — the gated sha will NOT survive
#     ALREADY-LANDED      nothing to land; do NOT re-gate
#     TIP-MOVED           tip != --sha (rebase+force-push mid-gate); re-gate
#     REBASE-GATE         oc-build's own auto-rebase refused; same fix as NON-FF
#     LOCAL-MAIN-AHEAD    the checkout's main is ahead of origin/main — wait for the
#                         owning lane; `merge --ff-only` is a silent no-op here
#     LOCAL-MAIN-DIVERGED both sides moved; settle with the owner of the ahead commits
#     STALE-LOCAL-MAIN    the WORKING TREE refused it, not history — read
#                         `git -C <fork> status`, clear it, re-run
#   Keep the count equal to `grep -c 'die ".*" 5$'` or delete the number.
#
# Re-arms (factory #78) — the classes this tool redoes BY ITSELF; a re-arm `exec`s a
#   fresh chain from the EXIT handler, so the wake below it is unreachable and the
#   suppression is structural, not a flag to remember.
#     rc 3/4/5  NO   a lane fix or a verdict; a restart reproduces it exactly
#     rc 6      YES  ONLY when GATE_RUN_ID is empty (nothing external happened yet)
#     rc 7/8    NO   the gate/build is still running — a re-dispatch destroys it
#     rc 9      YES  the lock holder is another real ship; wait-and-retry in-tool
#   Budget: OC_SHIPCHAIN_REARM_MAX (default 2), carried ACROSS the exec in the
#   environment. Opt out: --no-rearm / OC_SHIPCHAIN_NO_REARM=1. Class rationale and
#   measured counts: tools/docs/RC-CONTRACT.md (`oc-ship` row).

# Chain-id: every leg stamps the ledger under one id (kind=shipchain)
#   CHAIN-<shortsha>-<UTCstamp>  →  retrieve the whole run with
#   jq -r '.events[] | select(.kind=="shipchain")
#          | select(.what | contains("<CHAIN-id>")) | .what' \
#      <state-dir>/workers-ledger.json
#   (the old help named an `oc-ledger show` verb that does not exist — fixed
#    2026-09-11, same defect report as the kind: an auditor following a
#    non-existent retrieval path reads "no rows" as "chain never ran".)
#
# Env (selftest hooks — never needed in production):
#   OC_PRCHECKS_BIN  default tools/harvest/oc-gate
#   OC_SHIPCHAIN_NO_DOCS_SKIP=1  force the LEG1 gate even for a docs-only sha
#                    (test/debug hook — the skip is AUTO-DETECTED, never
#                    lane-declared; see the #20 note at leg 1)
#   OC_DEPLOY_BIN    overrides BOTH stage-tool paths below (one fake answering
#                    ship/poll/status is what the selftest fixtures need). Its
#                    per-verb defaults are oc-build (LEG4 ship) and oc-status
#                    (LEG5 poll/status) — since factory #168 cut 5 there is no
#                    `oc-deploy` dispatcher to point at.
#   OC_ISSUELOG_BIN  default tools/issue/oc-issue-log
#   OC_FORK_REPO     default ~/opencrabs (the fork checkout; a LINKED WORKTREE is
#                    accepted — #69. The chain still redirects to the MAIN worktree
#                    before the dirty/main checks, so that is where those run.)
#   OC_ISSUE_LOG_REPO  the tracker LEG2's oc-issue-log posts the per-commit
#                    comment to. This is oc-issue-log's OWN env hook (its
#                    --repo is the same thing); the chain passes --repo
#                    explicitly, so the hook is honoured from BOTH surfaces.
#                    Needed only when the issue is not on the fork AND the
#                    probe cannot decide -- prefer --issue-repo on the CLI.
#   OC_SHIPCHAIN_NO_ISSUE_PROBE=1  skip the LEG2 tracker probe (hermetic
#                    tests / offline); the chain then defaults to the fork.
#   OC_SHIPCHAIN_PROBE_GH  the gh binary the tracker probe uses (default: gh);
#                    a selftest hook, so the probe never reaches the network.
#   OC_SHIPCHAIN_LEDGER  path for chain journal lines (default: oc-ledger)
#   OC_TOOLS_NOLOG=1     suppress ledger stamps (battery/selftest)
#
# Actor (attribution — v0.4.152 §Attribution & Goal Hygiene A1): OC_ACTOR wins;
#   otherwise the actor is derived from the `Session-Id` trailer on the --sha commit
#   and EXPORTED, so this run's rows and every child tool's rows are attributed.
#   With neither, the actor stays unset and oc-ledger keeps its loud unattributed
#   message — nothing is invented. Canonical text: tools/docs/RC-CONTRACT.md
#   (`oc-ship` row, "Actor defaulting").

# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -e
set -u
set -o pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# #78: the re-arm supervisor `exec`s this chain again with its ORIGINAL argv, so
# the argv has to be captured before the parse loop consumes it. Captured here,
# immediately after SELF, because that is the first point where both the path
# and the argument list are known and nothing has shifted yet.
CHAIN_ARGV=("$@")
TOOLS_DIR="$OC_TOOLS_DIR"

# Content identity for a rebased commit (Duty-4 n=2520). Sourced from the SAME
# lib/ root the bootstrap resolved, so a fixture copy keeps its isolation.
if [ -f "$TOOLS_DIR/lib/oc-patch.sh" ]; then . "$TOOLS_DIR/lib/oc-patch.sh"; fi

_OC_LIB="$TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then
  source "$_OC_LIB"
  oc_log_init "oc-ship" "$@"
else
  oc_log_finish() { :; }
fi
# Combined exit handler: cleans up lock, logs lost journal lines, finishes tool logging
# (#661) A structured non-zero exit must WAKE the arming lane. The header
# promises the daemon resumes on a structured exit, but that resume is a
# BOOT-TIME in-flight classifier: a lane that ARMED a chain and SETTLED is
# classified `completed_before_kill`, so a chain dying later leaves landed+gated
# work unlanded until somebody re-reads the chain by hand (measured: 7h20m on
# one lane; 21 PRE-ANCESTRY MISS rows in the recent ledger).
#
# The durable path is the lib's own, the same one the swap-tail fan-out uses and
# which reaches a SETTLED session. Best-effort by construction: a wake fault
# must never change the chain's exit status. Only non-zero, non-usage exits
# wake -- a usage error is the caller's typo, which it already sees.
# THE WAKE'S REMEDY IS DERIVED FROM rc (factory #48 defect 1). Until this the
# message carried ONE sentence for every exit code -- "a stale fix often needs
# only --gated-run after a rebase" -- and both stops of one real chain showed
# it wrong (measured 2026-10-19): rc=3 was a checkout precondition that no gate
# name can touch (right by accident), and rc=6 was a dead user bus on a chain
# ALREADY armed with --gated-run 39281758213 (wrong twice: the gate was
# carried, and no gate naming fixes a bus). A remedy that is right by luck
# teaches the lane to name a gate instead of reading the cause, which is the
# opposite of what a wake is for.
#
# The arms below are the rc vocabulary this tool ACTUALLY emits -- read off its
# own `die` sites, not invented. An unlisted code falls back to the generic arm
# rather than to a confident guess.
chain_remedy() { # $1 = exit code
  case "${1:-}" in
    3) printf '%s' "a PRECONDITION refused before any gate ran, so no gate name can satisfy it -- fix the condition the journal line names (checkout not main, dirty tree, branch not pushed, missing Session-Id signature), then re-arm. Do NOT pass --gated-run: there is no gate to carry." ;;
    4) printf '%s' "a GATE or ORDER verdict, not infra -- read the run/validator output. If the branch was rebased since the gate, re-gate; --gated-run <id> is correct ONLY when that run still names the sha being landed." ;;
    5) printf '%s' "an rc 5 the chain did not classify, so its own message is unavailable -- and rc 5 covers EIGHT causes with OPPOSITE remedies (ALREADY-LANDED says do NOT re-gate; STALE-LOCAL-MAIN, LOCAL-MAIN-AHEAD and LOCAL-MAIN-DIVERGED say do NOT rebase; NON-FF says rebase). Read the journal line that names the LEG3 cause before acting; a blind rebase here rewrites a possibly correct gated tip and burns the gate." ;;
    6) printf '%s' "INFRASTRUCTURE, not a gate -- the wrapped tool's own message is in the journal, so read THAT line; naming a gate cannot fix a dead user bus, a failed handoff or a refused swap. Fix the cause, then resume the leg the journal names. The chain re-arms this class ONLY when the gate was never dispatched (GATE_RUN_ID empty), so seeing this wake means either an external action had already happened or the re-arm budget is spent -- do NOT re-dispatch a gate that already ran." ;;
    7) printf '%s' "the gate is still IN FLIGHT -- wait for the run, then re-arm with --gated-run <id>. Re-dispatching burns a second full gate cycle for the same answer." ;;
    8) printf '%s' "the carrier build did not reach a terminal state inside the LEG4 --wait budget -- do NOT re-dispatch it; wait, then resume with: oc-status poll --sha <sha> --execute --wait <sec>." ;;
    9) printf '%s' "the landing lock was held for the whole queue budget -- this is NOT infra and the gate is NOT broken. The chain ALREADY re-armed itself for this class before it woke you (budget OC_SHIPCHAIN_REARM_MAX, default 2), so a holder still holding after that many waits is worth inspecting rather than waiting a third time: check who owns the lock, or raise SHIP_LOCK_TIMEOUT / OC_SHIPCHAIN_LOCK_WAIT for the next run." ;;
    *) printf '%s' "re-read the chain journal for the failing leg -- the cause is in its last lines, not in a flag." ;;
  esac
}

# #78: WHICH exits may be re-armed in-tool, and which keep today's wake.
#
# The discriminator is NOT the exit code and NOT which leg it came from. It is
# whether the process died BEFORE any external side effect: a re-exec from line
# 1 is only safe while nothing outside this process is live. An rc that can
# mean "a gate run exists" must never restart, because a fresh dispatch onto
# the same gated ref CANCELS the in-flight run (pr-checks.yml keys its
# concurrency group on `prchecks-${{ inputs.ref }}`), so a careless re-arm
# destroys the very verdict it was waiting for.
#
# This is why the plan's shorthand -- "rc 6 AND the message names a LEG1 gate"
# -- is NOT what is implemented here. Four of the six rc-6 sites name a LEG1
# gate and every one of them had already touched the world (each cited by the
# die message it emits, never by line number -- the numbers rot on the next
# edit and a stale citation is a false receipt):
#
#   "gate resume failed"                 a run was LIVE, being resumed
#   "gate rc=5 but no run id on stdout"  a run existed, we cannot name it
#   "gate infra rc=6"                    prchecks CANCELLED-superseded
#   "ship infra rc=..."                  LEG4 build, oc-build touched it
#   "swap poll failed rc=..."            swap
#   "swap not confirmed after 12 polls"  swap
#
# Only "gate infra rc=" with prchecks' own pre-dispatch codes is re-armable,
# and those codes are the whole reason the distinction exists:
#
#   prchecks rc 4  dispatch api lock / dispatch refused -- NO run dispatched
#   prchecks rc 7  carrier head unresolvable            -- NO run dispatched
#   prchecks rc 8  AMBIGUOUS, dispatch refused          -- NO run dispatched
#   prchecks rc 5  in-flight timeout                    -- run existed, NO
#   prchecks rc 6  CANCELLED-superseded                 -- run existed, so a
#                                                         fresh dispatch is
#                                                         the one thing that
#                                                         must NOT happen; #92
#                                                         RESUMES the named
#                                                         superseder instead
#
# rc 9 (SHIP-LOCK-TIMEOUT) is the other re-armable class: the chain never got
# past the landing lock, so nothing outside it exists at all. It is matched on
# the CODE alone, because that exit has exactly one production site.
#
# Everything unlisted returns empty and keeps the current wake exactly as it
# is. Class B (rc 7 / rc 8) is deliberately absent -- owner decision
# 2026-11-18, and 0 of the 213 measured re-arms: their remedy is an in-leg
# wait extension, a different mechanism, never a restart.
chain_rearm_action() { # $1 = exit code; CHAIN_DIE_MSG + GATE_RUN_ID carry the state
  case "${1:-}" in
    9) printf '%s' "lock-retry" ;;
    6) case "${CHAIN_DIE_MSG:-}" in
         "gate infra rc=4"*|"gate infra rc=7"*|"gate infra rc=8"*)
           # A WITNESSED run is the disqualifier, not the code. prchecks'
           # pre-dispatch codes are safe only while no run was ever named: the
           # rc=5 resume loop sets GATE_RUN_ID and can then die rc 4 on its own
           # "run view failed" / "jobs fetch failed" sites, where the run very
           # much exists. Re-dispatching there cancels the verdict we waited
           # for. Empty GATE_RUN_ID is the only state that proves nothing was
           # dispatched, so the code class AND this guard are both required.
           if [ -z "${GATE_RUN_ID:-}" ]; then
             printf '%s' "gate-redispatch"
           fi ;;
         "gate infra rc=6"*)
           # #92: CANCELLED-superseded. A run DID exist here -- that is the
           # whole point -- so this arm must NOT inherit the empty-GATE_RUN_ID
           # guard above: that guard proves nothing was dispatched, which is
           # exactly false in this class. Resume the superseder prchecks named;
           # re-dispatching onto the same gated ref would cancel it a second
           # time. A non-numeric value means prchecks said `none found` (the
           # TIMEOUT-cancel class), and resuming nothing is not an action.
           case "${GATE_SUPERSEDING:-}" in
             ''|*[!0-9]*) : ;;
             *) printf 'gate-resume:%s' "$GATE_SUPERSEDING" ;;
           esac ;;
         *) : ;;
       esac ;;
    *) : ;;
  esac
}


_chain_wake_arming_lane() { # $1 = exit code
  local rc="$1" uuid="" chain_lib="" bin="" prof="" _dep="" _state="" _rem=""
  case "$rc" in 0|2) return 0 ;; esac          # 0 = SWAPPED, 2 = usage
  # #14: only a real chain ATTEMPT may wake. Set after the required-arg
  # checks, so --help (usage, rc 0 now) and --eval-docs-skip (rc 1/3) never
  # reach here with intent set. Without this, a routine `--help | head` woke
  # the querying lane (five times, four lanes, 2026-09-30..10-05).
  [ "${CHAIN_INTENT:-0}" = 1 ] || return 0
  [ "${OC_SHIPCHAIN_NO_WAKE:-0}" = 1 ] && return 0
  # HERMETICITY, and it must key on the ENVIRONMENT marker, not on argv.
  # oc_is_selftest() reads OC_LOG_ARGS -- the invocation's own argument list --
  # and a fixture child is launched as `bash "$SELF" --sha ... --branch feat`,
  # which carries NO --selftest token. Measured the hard way on 2026-09-27: the
  # argv-based guard let EVERY non-zero-exit leg of this file's selftest wake the
  # arming lane for real, 8 live notifies into one lane's inbound stream in 13
  # minutes, each one re-waking the lane that was debugging the leak.
  # OC_SHIPCHAIN_SELFTEST is the canonical marker and it is INHERITED: line 293
  # execs the selftest with it exported, so the fixture children carry it too.
  # A leg that means to assert the wake's content opts in explicitly. The opt-in
  # is a flag rather than "a stub binary was supplied" because with no stub a
  # missing guard reaches the real /usr/local/bin/opencrabs, sends a live notify,
  # and writes nothing to the leg's log -- the leg would pass while the
  # protection was gone.
  if [ "${OC_SHIPCHAIN_SELFTEST:-0}" = "1" ]; then
    [ "${OC_SHIPCHAIN_WAKE_ALLOW_SELFTEST:-0}" = 1 ] || return 0
  fi
  # #695: the pre-#695 text asserted "(not SWAPPED)" as FACT on any non-zero rc,
  # but rc is not the swap verdict -- the swap poll reads the deployed.sha MARKER,
  # and a post-swap step can fail while the marker stays set. Measured 2026-09-28
  # (chain oc-ship-680-225526, rc 141): the wake said "not SWAPPED" while the
  # chain's own journal read "SWAPPED sha=3eb5adb9..." and deployed.sha carried
  # that sha. Read the marker and STATE which state this actually is; a wake that
  # asserts an unchecked state sends the lane to disprove its own headline, and a
  # lane that trusts it may re-arm a chain for already-shipped work.
  #
  # ERR-EXIT SAFETY: this runs from the EXIT trap, where bash uses the trap's
  # final status as the script's. An unguarded failing command substitution here
  # REPLACES the chain's exit code -- measured 3 -> 1, which corrupted the very
  # audit surface the rc is (reproduced against the tool's own freeze legs).
  # Hence the `[ -r ]` guard and the `|| _dep=""`.
  _dep=""
  if [ -r "${STATE_DIR:-}/deployed.sha" ]; then
    _dep="$(cat "${STATE_DIR:-}/deployed.sha" 2>/dev/null)" || _dep=""
  fi
  _dep="$(printf '%s' "$_dep" | tr -d ' \n')" || _dep=""
  #
  # #137/#138: the marker alone cannot answer the question the sentence asks.
  # deployed.sha is a GLOBAL host marker, so `_dep = $SHA` is true for any chain
  # handed a sha that was deployed BEFORE the chain started -- including one that
  # dies at the first precondition and dispatches nothing. Measured 2026-11-22:
  # a --dry-run against an already-deployed sha, with the fork checkout off main,
  # woke with "the ship LANDED ... POST-SWAP step ... do NOT re-run the swap"
  # while its own journal carried ZERO rows for that sha. The marker answered
  # "is this sha deployed at all?", never "did THIS chain swap it?".
  #
  # The run-scoped receipt is SWAPPED, set to 1 in THIS process at the instant
  # LEG5's poll confirms the host carries the sha. It is a variable rather than a
  # journal read for two reasons: it cannot fail (an unguarded read in an EXIT
  # trap replaces the chain's rc -- see ERR-EXIT SAFETY above), and it cannot be
  # inherited from an earlier chain, which is precisely the defect. A genuine
  # post-swap death (the #695 shape: swap confirmed, then a signal) still carries
  # SWAPPED=1, so the positive control survives.
  if [ -n "${SHA:-}" ] && [ -n "$_dep" ] && [ "$_dep" = "$SHA" ]; then
    if [ "${SWAPPED:-0}" = "1" ]; then
      _state="the ship LANDED for this sha IN THIS CHAIN -- its own LEG5 poll confirmed the swap (SWAPPED=1) before the failure, so the failure is in a POST-SWAP step and the host is ALREADY swapped; do NOT re-run the swap"
    else
      case "$rc" in
        2|3)
          # Pre-flight: the rc legend places both BEFORE any gate ran. Here the
          # "nothing was dispatched" half is READ, not assumed.
          _state="PRE-FLIGHT refused (rc=$rc) -- nothing was dispatched and nothing was swapped. deployed.sha already carried this sha BEFORE this chain started (an earlier chain deployed it), so it is NOT a receipt for this run; fix the condition the die text names, then re-arm" ;;
        *)
          # Some other class, so "nothing dispatched" is NOT claimable (rc 6 can
          # be a swap-poll failure after a real dispatch). Claim only what was
          # read: this run recorded no swap.
          _state="deployed.sha already carried this sha BEFORE this chain started -- an earlier chain deployed it, and THIS chain recorded NO swap, so the failure above is NOT a post-swap step. Do not re-run the swap for this sha, and do not read the marker as this run having landed it; the die text above names the real cause" ;;
      esac
    fi
  elif [ -n "$_dep" ]; then
    _state="the work may be landed but UNSHIPPED -- deployed.sha carries ${_dep}, NOT ${SHA:-?}"
  else
    _state="the work may be landed but UNSHIPPED -- deployed.sha is ABSENT, so no swap is recorded"
  fi
  # A1b (owner order 2026-09-27): the SELF uuid comes from the environment, and
  # OPENCRABS_SESSION_ID WINS over OC_ACTOR -- the latter is retired for the actor
  # and a continuation doc can carry a stale one. The commit's Session-Id trailer
  # is the last resort, not the first.
  # #48 defect 1: the remedy is DERIVED from rc (chain_remedy, defined above).
  # Same ERR-EXIT SAFETY as _dep above: this runs from the EXIT trap, where a
  # failing command substitution would REPLACE the chain's own exit code.
  #
  # #55: the chain's OWN die text WINS over the code legend. A legend keyed on
  # the code cannot speak for a code that covers several causes with OPPOSITE
  # remedies, and rc 5 covers EIGHT: ALREADY-LANDED says do NOT re-gate,
  # STALE-LOCAL-MAIN and LOCAL-MAIN-AHEAD say do NOT rebase, NON-FF says
  # rebase. Measured 2026-10-25 (ledger n=15480): the wake carried "rebase onto
  # fork main and re-gate" while the SAME run's journal said "Do NOT rebase",
  # and following the wake would have rewritten a correctly-based gated tip and
  # burned a ~26-minute gate. The legend stays as the FALLBACK for an exit that
  # never reached a die -- a signal, or a wrapped tool's own rc 6/8/9 -- where
  # the code is genuinely all there is.
  _rem=""
  if [ -n "${CHAIN_DIE_MSG:-}" ]; then
    _rem="$CHAIN_DIE_MSG"
  else
    _rem="$(chain_remedy "$rc" 2>/dev/null)" || _rem=""
  fi
  uuid="${OPENCRABS_SESSION_ID:-${OC_ACTOR:-}}"
  if [ -z "$uuid" ] && [ -n "${SHA:-}" ] && command -v git >/dev/null 2>&1; then
    uuid="$(git -C "${FORK_REPO:-$HOME/opencrabs}" log -1 --format='%(trailers:key=Session-Id,valueonly)' "$SHA" 2>/dev/null | tr -d ' \n')"
  fi
  # only a real uuid: everything downstream keys on it, and a label would be a
  # wake addressed to nobody.
  case "$uuid" in
    ????????-????-????-????-????????????) : ;;
    *) return 0 ;;
  esac
  chain_lib="${OC_TOOLS_DIR:-${TOOLS_DIR:-}}/lib/oc-notify.sh"
  [ -f "$chain_lib" ] || return 0
  # shellcheck disable=SC1090
  . "$chain_lib" 2>/dev/null || return 0
  command -v oc_notify_session >/dev/null 2>&1 || return 0
  bin="$(oc_notify_resolve_bin 2>/dev/null)" || return 0
  prof="${OC_SHIPCHAIN_PROFILE:-ops}"
  # #78: when the supervisor's budget is EXHAUSTED, the wake must say so and
  # name the count. A wake that reads identically to a first-try failure hides
  # the one fact the lane needs: the chain already restarted itself N times and
  # the cause survived every restart, so it is NOT a transient queue condition.
  # Without this the operator cannot tell "failed once" from "failed after the
  # whole in-tool budget" -- which is precisely the judgement the wake exists
  # to support, and the reason a silent restart would be worse than the wake.
  # Non-numeric/absent attempts fall through to no note: the wake is still
  # correct without it, and arithmetic inside an EXIT trap can replace the rc.
  _rearm_note=""
  case "${OC_SHIPCHAIN_REARM_ATTEMPT:-0}" in
    ''|0) : ;;
    *[!0-9]*) : ;;
    *) _rearm_note=" This run was already RE-ARMED ${OC_SHIPCHAIN_REARM_ATTEMPT} time(s) in-tool (budget ${OC_SHIPCHAIN_REARM_MAX:-2}) and the restart did not clear it, so the cause is NOT transient." ;;
  esac
  oc_notify_session "$bin" "$prof" "oc-ship" "$uuid" \
    "SHIP-CHAIN ${CHAIN:-?}: EXITED rc=$rc" \
    "The chain armed by this lane has STOPPED with rc=$rc. ${_state} -- ${_rem:-Re-read the chain journal for the failing leg.} Re-read the chain journal for ${SHA:-?} before re-arming. This wake exists because a settled lane is not resumed by the boot classifier.${_rearm_note}" >/dev/null 2>&1 || true
}

# ---- #78: Class A re-arm supervisor ----------------------------------------
# A mechanically-doomed chain used to end in a human wake: the lane read "the
# chain armed by this lane has STOPPED", worked out that the cause was a lock
# timeout or a pre-dispatch gate failure, and re-ran it. Measured over 213
# re-arms, 70 were exactly that shape. This supervisor performs the restart
# in-tool so the wake is reserved for classes that need a human.
#
# WHAT MAY RE-ARM IS DECIDED IN chain_rearm_action(), not here: the
# discriminator is "did anything external already happen", which is why rc 6
# needs an unwitnessed run (GATE_RUN_ID empty) and why Class B (rc 7/rc 8) is
# absent by owner decision 2026-11-18.
#
# THE WAKE IS SUPPRESSED STRUCTURALLY: `exec` replaces this process, so the
# `_chain_wake_arming_lane` call below it is never reached on a re-arm. There
# is no flag to forget.
NO_REARM=""
# #92: the child argv for a gate RESUME. Every existing --gated-run / --gated-sha
# pair is REMOVED -- both the `--flag value` and `--flag=value` spellings -- and a
# single --gated-run <id> is appended, so the child waits on exactly the run that
# was named. Two --gated-run flags are last-wins at best and a silent misparse at
# worst, and a surviving --gated-sha beside a --gated-run describes two different
# gates. No wait is added here: the child's own --gated-run path already attaches
# to an in-flight run, and a supervisor-side wait would duplicate that path and
# give a SECOND timeout to reason about.
_chain_rearm_argv() { # $1 = run id; prints one argv token per line
  local _id="$1" _skip=0 _a
  for _a in "${CHAIN_ARGV[@]}"; do
    if [ "$_skip" = 1 ]; then _skip=0; continue; fi
    case "$_a" in
      --gated-run|--gated-sha) _skip=1; continue ;;
      --gated-run=*|--gated-sha=*) continue ;;
    esac
    printf '%s\n' "$_a"
  done
  printf '%s\n' "--gated-run" "$_id"
}

_chain_rearm_supervise() { # $1 = exit code; execs on re-arm, returns 1 otherwise
  # A signal never re-arms (#79). The operator stopped this on purpose; a
  # supervisor that resurrects it is the very bug #79 exists to prevent.
  [ "${CHAIN_SIGNALLED:-0}" -eq 0 ] || return 1
  [ -z "${NO_REARM:-}" ] || return 1
  # Never re-run the selftest suite from inside itself: argv carries
  # --selftest, so a re-arm would fork a second full suite per failing arm.
  local _a
  for _a in "${CHAIN_ARGV[@]}"; do
    [ "$_a" = "--selftest" ] && return 1
  done
  # HERMETICITY, and it must key on the ENVIRONMENT marker for the same reason
  # the wake guard does (_chain_wake_arming_lane): a fixture child is launched
  # as `bash "$SELF" --sha ... --branch feat`, whose argv carries NO --selftest
  # token, so the loop above cannot see it. Without this the suite HANGS
  # instead of failing -- measured 2026-11-18: a fixture child that died rc 9
  # re-armed, ran a FULL chain against the fixture's state dir, and the suite
  # sat on it for minutes with no output. A leg that means to assert a re-arm
  # opts in explicitly, exactly as the wake legs do.
  if [ "${OC_SHIPCHAIN_SELFTEST:-0}" = "1" ]; then
    [ "${OC_SHIPCHAIN_REARM_ALLOW_SELFTEST:-0}" = 1 ] || return 1
  fi
  local _act _n _max
  _act="$(chain_rearm_action "$1" 2>/dev/null)" || _act=""
  [ -n "$_act" ] || return 1
  # Budget is carried ACROSS the exec in the environment, because the new
  # process re-initialises every shell variable it does not inherit.
  _n="${OC_SHIPCHAIN_REARM_ATTEMPT:-0}"
  _max="${OC_SHIPCHAIN_REARM_MAX:-2}"
  # A non-numeric budget must not silently disable the bound: -lt on "abc"
  # errors, and an error inside an EXIT trap would replace the chain's rc.
  case "$_n"   in ''|*[!0-9]*) _n=0   ;; esac
  case "$_max" in ''|*[!0-9]*) _max=2 ;; esac
  [ "$_n" -lt "$_max" ] || return 1

  journal "RE-ARM attempt $((_n+1))/$_max after rc=$1 — $_act"
  oc_log_extra "rearm" "1" 2>/dev/null || true
  oc_log_extra "rearm_attempt" "$((_n+1))" 2>/dev/null || true
  oc_log_extra "rearm_rc" "$1" 2>/dev/null || true
  oc_log_finish "$1" 2>/dev/null || true
  export OC_SHIPCHAIN_REARM_ATTEMPT=$((_n+1))
  # #92: a resume substitutes the gate the child waits on (see _chain_rearm_argv
  # for why it is a replacement and not an append).
  case "$_act" in
    gate-resume:*)
      local -a _child=()
      mapfile -t _child < <(_chain_rearm_argv "${_act#gate-resume:}")
      exec bash "$SELF" "${_child[@]}" ;;
  esac
  exec bash "$SELF" "${CHAIN_ARGV[@]}"
}

_chain_exit_handler() {
  local rc=$?
  if command -v release_ship_lock >/dev/null 2>&1; then
    release_ship_lock
  fi
  if command -v journal_summary >/dev/null 2>&1; then
    journal_summary
  fi
  # #78: Class A supervisor. On a re-arm this `exec`s and never returns, so the
  # wake below is skipped by construction. `|| true` keeps a refusal (rc 1)
  # from replacing the chain's own exit code under `set -e`.
  if command -v _chain_rearm_supervise >/dev/null 2>&1; then
    _chain_rearm_supervise "$rc" || true
  fi
  # #205 P3b: the chain's TERMINAL ledger row. Before this, a chain's last row
  # was whichever leg it happened to be on — so a chain that shipped, a chain
  # killed at 03:00 and a chain still running were BYTE-IDENTICAL to a reader.
  # Measured 2026-11-28: of 65 chains in the last 1,500 shipchain rows, ZERO
  # ended on a terminal row.
  #
  # PLACEMENT IS THE WHOLE FIX: this sits AFTER _chain_rearm_supervise, which
  # `exec`s on a re-arm and never returns. Written before it, a re-arming chain
  # would stamp "ended" and then go on running — the exact false absence this
  # row exists to kill, re-created by the row itself.
  #
  # CHAIN_TERMINAL is set by the success path right after it stamps
  # "DONE SWAPPED", so a chain that lands keeps ONE terminal row, not two. The
  # consumer groups by chain id and reads the NEWEST row, so a duplicate would
  # be harmless but noisy — and it would make the row count lie about how many
  # endings happened.
  #
  # HONEST LIMIT: SIGKILL and the OOM killer cannot be trapped, so this is a
  # POST-MORTEM record, never a liveness test. A hard-killed chain still leaves
  # no terminal row; that is what pid= + `kill -0` in --in-flight is for.
  #
  # ERR-EXIT SAFETY: `|| true` and the `command -v` guard are both load-bearing
  # here. This runs from the EXIT trap, where bash adopts the trap's final
  # status as the script's — an unguarded failure would replace the chain's own
  # rc. journal() is also defined far below this point (1370) while the trap is
  # installed at 612, so a chain that dies in pre-flight has no journal yet and
  # the guard is what keeps that from erroring under `set -u`.
  if [ "${CHAIN_TERMINAL:-0}" != "1" ] \
     && [ -n "${CHAIN:-}" ] && [ -n "${JOURNAL_FAILS:-}" ] \
     && command -v journal >/dev/null 2>&1; then
    if [ "${CHAIN_SIGNALLED:-0}" = "1" ]; then
      journal "CANCELLED rc=$rc signal=${CHAIN_SIGNAL_NAME:-TERM} — terminated by a signal (post-mortem; SIGKILL cannot be trapped)" || true
    elif [ "$rc" -eq 0 ]; then
      journal "DONE rc=0 — chain exited cleanly" || true
    else
      journal "FAIL rc=$rc — chain exited non-zero" || true
    fi
  fi
  if command -v _chain_wake_arming_lane >/dev/null 2>&1; then
    _chain_wake_arming_lane "$rc"
  fi
  if command -v oc_log_finish >/dev/null 2>&1; then
    oc_log_finish $rc
  fi
}
# ---- #79: a signal must TERMINATE, and it must be LABELLED ------------------
# This used to be `trap '_chain_exit_handler' EXIT INT TERM`, installed AFTER
# lib/oc-log.sh's own `trap '... exit 143' TERM` -- and `_chain_exit_handler`
# never calls `exit`. So on SIGTERM the chain released the landing lock,
# journalled, woke the arming lane and finished its log row, and then RESUMED
# execution, unlocked, mid-leg, with a wake already sent: a kill read as a
# clean stop and was not one.
#
# It also leaves a supervisor blind, which is why #78 cannot ship without this:
# with the signal indistinguishable from any other exit path, nothing
# downstream can tell "the operator stopped this" from "this class is
# mechanical". CHAIN_SIGNALLED is that label, and the re-arm supervisor refuses
# to resurrect a chain carrying it.
CHAIN_SIGNALLED=0
# #205 P3b: 0 until a terminal ledger row is written. The success path sets it
# after stamping "DONE SWAPPED"; the EXIT trap stamps CANCELLED/DONE/FAIL only
# when it is still 0, so every chain gets exactly one terminal row.
CHAIN_TERMINAL=0
_chain_signal_handler() {
  local sig="${1:-TERM}" rc
  case "$sig" in
    INT) rc=130 ;;
    *)   rc=143 ;;
  esac
  CHAIN_SIGNALLED=1
  # #205 P3b: name the signal in the terminal ledger row instead of assuming
  # TERM. Read as ${CHAIN_SIGNAL_NAME:-TERM} there, so this stays optional.
  CHAIN_SIGNAL_NAME="$sig"
  # #205 P3b: remember WHICH signal, so the terminal ledger row can name it
  # rather than guessing TERM for every case. `${...:-TERM}` keeps this safe
  # under `set -u` when no terminal row is written at all.
  CHAIN_SIGNAL_NAME="$sig"
  # #74 regression guard: lib/oc-log.sh installs its own TERM/INT traps that
  # stamp extra.signal, and this handler is installed AFTER them -- so the
  # annotation would vanish with the trap it rode on. The label is half of what
  # #79 is for ("terminate AND be labelled"), so re-stamp it here rather than
  # letting the fix silently drop a field another fix added.
  oc_log_extra "signal" "$sig"
  # The EXIT trap still runs on this exit -- release the lock, journal, wake,
  # finish the log row -- and now sees the SIGNAL's code rather than whatever
  # the interrupted statement would have returned.
  exit "$rc"
}
trap '_chain_signal_handler INT' INT
trap '_chain_signal_handler TERM' TERM
trap '_chain_exit_handler' EXIT

# selftest dispatch BEFORE arg parsing (avoids the unknown-arg gate)
# impl re-entry is guarded by OC_SHIPCHAIN_IMPL to prevent exec-loop
if [ "${OC_SHIPCHAIN_IMPL:-0}" = "1" ]; then
  SELFTEST_MODE=2          # 2 = inside the impl itself, never re-exec
elif [ "${1:-}" = "--selftest" ]; then
  SELFTEST_MODE=1          # 1 = run was --selftest: exec into impl
else
  SELFTEST_MODE=0
fi

# #137: DECLARED, not absent. This is the run-scoped swap receipt the wake reads
# (see _chain_wake_arming_lane). A pre-flight death exits before LEG5 ever runs,
# so the wake must see "this chain swapped nothing" -- and it must see that as a
# DECLARATION, not as an unset variable that `${SWAPPED:-0}` happens to rescue.
# An inherited env var (a wrapper that exports SWAPPED=1) would otherwise make a
# chain that dispatched nothing claim the ship LANDED: the same defect class as
# reading the global deployed.sha marker as a per-run receipt.
SWAPPED=0
PRCHECKS_BIN="${OC_PRCHECKS_BIN:-$TOOLS_DIR/harvest/oc-gate}"
# #168 cut 5: the dispatcher is GONE, so LEG4 and LEG5 name their OWN tools.
# ONE env override (`OC_DEPLOY_BIN`) still drives both, because the fixtures need
# a single fake that answers all three verbs (ship / poll / status) and splitting
# the hook would have meant ~40 fixture edits for no gain in coverage. The name
# keeps its `OC_DEPLOY_` prefix deliberately (decision A5: state paths and env
# names stay, or a rebuilt box loses the hook).
BUILD_BIN="${OC_DEPLOY_BIN:-$TOOLS_DIR/ship/oc-build}"
STATUS_BIN="${OC_DEPLOY_BIN:-$TOOLS_DIR/ship/oc-status}"
ISSUELOG_BIN="${OC_ISSUELOG_BIN:-$TOOLS_DIR/issue/oc-issue-log}"
FORK_REPO="${OC_FORK_REPO:-$HOME/opencrabs}"
GH_BIN="${OC_GH:-gh}"
# T10 (plan #68): the post-4-way-split home of the rebase auditor. Named here
# so the STALE-BASE recovery below never hunts a tool in the wrong shard.
REBASE_SAFETY_BIN="${OC_REBASE_SAFETY_BIN:-$OC_TOOLS_DIR/git/oc-rebase-safety}"

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$SELF" || :; exit 0; }
# #55: the message is RECORDED before exiting so the EXIT-trap wake can carry
# the cause the chain actually found instead of a code-wide legend. One rc can
# cover several causes with OPPOSITE remedies -- rc 5 has EIGHT die sites (keep
# this equal to `grep -c 'die ".*" 5$'`), where ALREADY-LANDED says do NOT
# re-gate and the checkout-state arms say do NOT rebase while NON-FF says
# rebase -- so a legend keyed on the CODE can only be
# a fallback for an exit that never reached a die (a signal, or a wrapped
# tool's own rc). A plain assignment, never a command substitution: this runs
# on the exit path, where a failing substitution would REPLACE the chain's own
# rc and corrupt the very audit surface the code is.
CHAIN_DIE_MSG=""
die() { CHAIN_DIE_MSG="$1"; printf 'oc-ship: %s\n' "$1" >&2; exit "${2:-2}"; }

# #69: "is this a git checkout?" must be asked with GIT's predicate, never with a
# proxy for it. `[ -d "$repo/.git" ]` is false in a LINKED WORKTREE, where `.git`
# is a FILE (a gitdir pointer) rather than a directory, so a perfectly valid
# checkout was refused as "not found" — and that message names the wrong cause,
# sending the lane to look at paths instead of at the test. Measured 2026-11-17:
# OC_FORK_REPO=/root/opencrabs-wt/1930-compaction-budget (clean, on a branch) has
# a 62-byte ASCII `.git`, so `-d` failed while `rev-parse --git-dir` passed.
# It also bit one level up: the main-worktree auto-redirect already accepts a
# non-main worktree, but it runs AFTER this pre-flight, so an explicitly-passed
# worktree died before reaching the code that would have taken it. `-e` would
# accept any file, `-d` rejects every worktree; `rev-parse
# --git-dir` IS the predicate. Both call sites share this one implementation so
# they cannot drift back apart — the original defect was the same wrong test
# duplicated at two sites.
require_fork_checkout() { # $1 = path; dies rc 3 with the honest cause
  _rfc_path="$1"
  if [ ! -e "$_rfc_path" ]; then
    die "fork checkout not found: $_rfc_path (path does not exist)" 3
  fi
  git -C "$_rfc_path" rev-parse --git-dir >/dev/null 2>&1 \
    || die "fork checkout not found: $_rfc_path (path exists but is not a git checkout: no .git directory and no gitdir pointer)" 3
}

SHA=""; BRANCH=""; ISSUE=""; ISSUE_REPO_FLAG=""; REPO=""; DRY=0; NOLEDGER=0; GATED_SHA=""; GATED_RUN=""
# #14: set ONLY once the invocation has proven it is a chain attempt (both
# --sha and --branch named). The EXIT-trap wake keys on this, so a NON-chain
# invocation -- `--help`, or `--eval-docs-skip` (which exits 1/3) -- can never
# wake a lane with a fabricated "your chain STOPPED". Measured 2026-10-05: five
# `--help` exits at rc 141 (SIGPIPE from a short reader) across four lanes, each
# one waking the lane that ran it, with SHA and STATE_DIR unset so the state line
# read "deployed.sha is ABSENT" off the root path and the sha rendered "?".
CHAIN_INTENT=0
# #672: set when NO leg runs in this chain and the gate is carried forward from an
# earlier run. The banner must not then claim a mode that never ran.
GATE_CARRIED_FORWARD=""
# #672: the docs-only SKIP is a third no-leg path -- same false banner (`FAST`
# claims fmt+clippy ran when nothing ran).
GATE_SKIPPED_DOCS=""
# #355: the run that gated THIS sha, resolved on the dispatch path too (it was
# previously parsed only inside the rc=5 resume loop), so LEG4 can name its
# gate to oc-build instead of landing silently.
GATE_RUN_ID="${GATE_RUN_ID:-}"
# #92: the superseder prchecks NAMED on a CANCELLED-superseded gate. Empty
# unless LEG1 captured one, so every other rc-6 exit keeps its old answer.
GATE_SUPERSEDING="${GATE_SUPERSEDING:-}"
FAST=0
# LEG1 gate budget (defect fix 2026-09-11, lane 4b4463d5). The PR-lane gate on
# this box takes ~30 min end-to-end; oc-gate' own --wait default is 600 s,
# so a fresh chain ALWAYS timed out mid-build and died on a non-terminal code.
GATE_WAIT="${OC_SHIPCHAIN_GATE_WAIT:-2700}"        # 45 min — one gate, comfortably
GATE_RESUMES="${OC_SHIPCHAIN_GATE_RESUMES:-2}"     # max rc-5 resume-polls before an honest give-up
# LEG4 ship/swap budget (defect fix 2026-09-18, issue #336). The budget must
# outlast the carrier build it waits on. Predicate: `gh run list --repo
# leshchenko1979/opencrabs --workflow quick-build-linux.yml --limit 40`,
# COMPLETED runs with conclusion=success, duration = updatedAt - createdAt
# (queue + build — what this flag actually waits on). Of the 37 such runs
# read on 2026-09-18, the 10 most recent ALL exceeded the old 900 s default:
# 942-1344 s (15.7-22.4 min), median 1062 s (17.7 min), the boundary run
# starting 2026-09-17T23:47Z. The 27 before them ran 394-651 s (6.6-10.8 min)
# apart from one 963 s outlier — so a 900 s budget that held comfortably
# stopped holding entirely (11 of 37 successes now exceed 900 s), and every
# expiry surfaced as the generic INFRA branch (rc 6), indistinguishable from
# a genuinely broken carrier. 2700 s mirrors GATE_WAIT and leaves 22.6 min of
# headroom over the worst observed (1344 s).
WAIT="${OC_SHIPCHAIN_SHIP_WAIT:-2700}"             # 45 min — one carrier build, comfortably
# SHIP-LOCK queue budget (defect fix 2026-09-19, fork #391; reported
# independently by lanes 61161247 and c78e78e0). The lock is acquired at LEG3
# and released from the exit trap (on a SWAPPED path, also released
# explicitly after the swap, before the background state-repo `git gc --auto`
# is launched), so it is held across LEG3 (ff-merge, seconds) + LEG4 (WAIT
# above) + LEG5 (swap poll, 12 x 10 s + poll runtime) and NOT across the gc.
# The old default was a hardcoded 600 s against a ~3300 s max hold: the queue
# budget was STRUCTURALLY SHORTER than the thing it serialized, so any chain
# that queued behind a real ship expired by construction. Volume measured over
# tools.log shipchain rows: 56 contended, 36 acquired-after-wait, 10 timeouts.
# Mirrors the LEG4 fix (#336) reasoning: a budget must outlast the hold it
# waits on, not the average. WAIT + 600 s covers LEG5 and leaves headroom.
# The timeout also stopped masquerading as INFRA: it now dies rc 9
# (SHIP-LOCK-TIMEOUT), because "another ship is ahead of you" is a QUEUE
# condition, not a broken component — the same split rc 7 and rc 8 got.
# The documented workaround SHIP_LOCK_TIMEOUT=<sec> keeps working and WINS
# over this default; OC_SHIPCHAIN_LOCK_WAIT is the file's own-prefix alias.
SHIP_LOCK_WAIT="${OC_SHIPCHAIN_LOCK_WAIT:-$((WAIT + 600))}"
[ "$SELFTEST_MODE" = "1" ] && OC_SHIPCHAIN_IMPL=1 OC_SHIPCHAIN_SELFTEST=1 exec bash "$SELF"
if [ "$SELFTEST_MODE" = "2" ]; then   # body lives in tests/ship-selftest.sh
  _csf="$TOOLS_DIR/tests/ship-selftest.sh"
  if [ ! -f "$_csf" ]; then printf 'oc-ship selftest: %s missing (broken LOCAL TOOL TREE)\n' "$_csf" >&2; exit 2; fi
  . "$_csf"; exit $?
fi

# #21 (LAW 17): the detach re-execs this tool with its ORIGINAL argv, so the
# argv must be captured BEFORE the arg loop consumes it (a re-exec with an
# already-drained "$@" would launch a chain with no --sha and die rc 2).
ORIG_ARGS=("$@")

# `include_str!` resolves relative to the CONTAINING .rs file (not the crate
# root), so the containing file is captured alongside each literal and the pair
# is resolved together; output is repo-relative, one path per line.
shipchain_compiled_md_set() {
  local rs rel
  # Whole body in a subshell: the `cd` must not move the caller's cwd. Today's
  # only call site is a command substitution (already a subshell), but a cwd
  # leak out of a path-resolver is the kind of bug that surfaces a hundred lines
  # later in an unrelated `git` call.
  (
    cd "$FORK_REPO" 2>/dev/null || { printf '%s\n' "__OC_DERIVE_FAILED__"; exit 0; }
    grep -rloE 'include_(str|bytes)!\([[:space:]]*"[^"]+\.md"' src --include=*.rs 2>/dev/null \
      | while IFS= read -r rs; do
          grep -oE 'include_(str|bytes)!\([[:space:]]*"[^"]+\.md"' "$rs" 2>/dev/null \
            | sed -E 's/.*"([^"]+\.md)".*/\1/' \
            | while IFS= read -r rel; do
                realpath -m --relative-to=. "$(dirname "$rs")/$rel" 2>/dev/null || true
              done
        done | sort -u
  )
}

# The ref the shipped range is measured against. The chain's LEG3 fast-forwards
# fork main onto $SHA, so everything from the merge-base of main and $SHA is
# what this chain introduces. Prefer origin/main (the shared truth; a stale
# origin/main sits BEHIND and yields a LARGER range — the conservative
# direction), fall back to local main. No main ref -> the range is unjudgeable.
shipchain_main_ref() {
  local r
  for r in refs/remotes/origin/main refs/heads/main; do
    if git -C "$FORK_REPO" rev-parse --verify --quiet "$r^{commit}" >/dev/null 2>&1; then
      printf '%s\n' "$r"
      return 0
    fi
  done
  return 1
}

# rc 0 = docs-only, prints the changed paths; rc 1 = must gate.
#
# #322 (editor lane #286 report): this judged `$SHA^..$SHA` — the TIP commit
# only — while LEG3 fast-forwards the WHOLE branch into main. A 2-commit branch
# (code commit under a docs-only tip) therefore skipped LEG1 and shipped
# ungated: the tip diff is pure markdown, the shipped range is not. The
# predicate now judges the range the chain actually introduces, so a code
# commit under a docs tip gates. Base = merge-base(main, $SHA); when that
# resolves to $SHA itself the branch adds nothing to main and the answer is
# gate (conservative, and the empty diff would gate anyway).
shipchain_docs_only() {
  local mainref base paths p compiled
  mainref="$(shipchain_main_ref)" || return 1   # no main ref: gate
  base="$(git -C "$FORK_REPO" merge-base "$mainref" "$SHA" 2>/dev/null || true)"
  [ -n "$base" ] || return 1                    # no common ancestor: gate
  [ "$base" != "$SHA" ] || return 1             # nothing new to introduce: gate
  paths="$(git -C "$FORK_REPO" diff --name-only "$base" "$SHA" 2>/dev/null || true)"
  [ -n "$paths" ] || return 1                   # empty diff: gate (conservative)
  compiled="$(shipchain_compiled_md_set)"
  # Fail CLOSED when the set cannot be derived. The derivation's own failure path
  # used to print nothing, which is indistinguishable from a legitimate "this
  # repo compiles in no markdown" — so a failed derivation made every markdown
  # path look non-compiled and the gate was SKIPPED. That is the same shape as
  # the rest of this family: an unverifiable check must never read as clean.
  case "$compiled" in
    *__OC_DERIVE_FAILED__*) return 1 ;;
  esac
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in *.md) ;; *) return 1 ;; esac   # any non-markdown -> gate
    # #537: NO PIPE. `printf ... | grep -q` under `set -o pipefail` is a latent
    # FALSE NEGATIVE — grep -q exits at the first match, printf takes SIGPIPE,
    # and the pipeline reports 141, so the `&& return 1` never fires and a
    # COMPILED markdown path is treated as docs-only, SKIPPING the CI gate.
    # Measured in the battery: eval-docs-skip-compiled-rc1 wanted rc=1 and got 0
    # with README.md listed as docs-only (README.md is include_str!'d from
    # src/lib.rs, so touching it changes compiled output and MUST gate).
    grep -qxF "$p" <<< "$compiled" && return 1   # compiled -> gate
  done <<EOF
$paths
EOF
  printf '%s\n' "$paths"
  return 0
}

# --- #158: CONSUME THE GATE RECEIPT ------------------------------------------
# oc-gate persists what it actually VERIFIED to
# `<state>/oc-deploy/journal/gate-<run>.json` (#157). Before this check, LEG1
# adopted a run on IDENTITY alone — the run was green, its job name carried our
# sha — and LEG2 bound an artifact to it. Nothing proved the GREEN verdict was
# ABOUT the sha being shipped. Every run-list field is identical across
# concurrent dispatches (#631), so "green" without the receipt is a verdict with
# no subject: it authorizes whatever commit the caller names next.
#
# A DISTINCT rc PER FAILURE CLASS, because the remedy differs per class. One
# GATE-RED for all of them is precisely the undiagnosable verdict this plan
# exists to abolish.
#   0  receipt present, well-formed, names $2 as tested_sha, GREEN, gate job ok
#   1  no receipt for the run        -> re-run oc-gate (it writes one now)
#   2  malformed / wrong schema      -> corrupt receipt; re-run oc-gate
#   3  tested_sha != the sha shipped  -> the green was about a DIFFERENT commit
#   4  verdict is not GREEN          -> nothing to carry forward
#   5  no job reached `success`      -> a SKIPPED gate job is a false green
#   6  stale beyond the budget       -> re-gate
#   7  no successful job NAMES $2    -> the passing job does not prove this sha
#   8  earned on a DIFFERENT carrier -> re-gate against the carrier you ship on
shipchain_gate_receipt_check() { # $1=run_id $2=sha_about_to_ship
  local rid="${1:-}" want="${2:-}" rp schema tested verdict nsucc ts maxage now age _n _named _carrier _want_carrier
  GATE_RECEIPT_WHY=""
  GATE_RECEIPT_PATH=""
  [ -n "$rid" ] && [ -n "$want" ] || { GATE_RECEIPT_WHY="no run id or no sha to bind"; return 1; }
  rp="$STATE_DIR/oc-deploy/journal/gate-$rid.json"
  [ -f "$rp" ] || { GATE_RECEIPT_WHY="no receipt at $rp"; return 1; }
  command -v jq >/dev/null 2>&1 || { GATE_RECEIPT_WHY="jq absent — cannot verify the receipt"; return 2; }
  schema="$(jq -r '.schema // ""' "$rp" 2>/dev/null || true)"
  [ "$schema" = "oc-gate-receipt/1" ] || { GATE_RECEIPT_WHY="schema '${schema:-none}' is not oc-gate-receipt/1"; return 2; }
  tested="$(jq -r '.tested_sha // ""' "$rp" 2>/dev/null || true)"
  [ "${#tested}" -eq 40 ] || { GATE_RECEIPT_WHY="receipt tested_sha '${tested:-none}' is not a full 40-char sha"; return 2; }
  [ "$tested" = "$want" ] || { GATE_RECEIPT_WHY="receipt tested $tested but this chain ships $want"; return 3; }
  verdict="$(jq -r '.verdict // ""' "$rp" 2>/dev/null || true)"
  [ "$verdict" = "GREEN" ] || { GATE_RECEIPT_WHY="receipt verdict is '${verdict:-none}', not GREEN"; return 4; }
  # A GREEN receipt must still show a job that ACTUALLY PASSED. `blocking` is
  # derived in the writer as "conclusion is not success/skipped/neutral", so a
  # GREEN receipt legitimately carries ZERO blocking jobs — "no blocking job"
  # therefore cannot be the discriminator here, and asserting it would refuse
  # every valid receipt. The discriminator is a job whose conclusion is
  # literally `success`: a run whose gate job was SKIPPED produces no such job,
  # and carrying THAT forward is the false green this check exists to refuse.
  nsucc="$(jq -r '[.jobs[]? | select(.conclusion == "success")] | length' "$rp" 2>/dev/null || true)"
  [ "${nsucc:-0}" -gt 0 ] 2>/dev/null || { GATE_RECEIPT_WHY="receipt lists no job with conclusion=success (a skipped gate job is not evidence)"; return 5; }
  # ...and that passing job must NAME the sha, read with the SAME parser the
  # adoption gate uses. A second job-name parser here would be a second thing to
  # rot, and #631 already measured what a loose one costs.
  command -v oc_job_sha >/dev/null 2>&1 || { GATE_RECEIPT_WHY="oc_job_sha unavailable (tools/lib/oc-patch.sh not sourced)"; return 7; }
  _named=""
  while IFS= read -r _n; do
    [ -n "$_n" ] || continue
    if [ "$(oc_job_sha "$_n")" = "$tested" ]; then _named="1"; break; fi
  done <<EOF
$(jq -r '.jobs[]? | select(.conclusion == "success") | .name' "$rp" 2>/dev/null || true)
EOF
  [ -n "$_named" ] || { GATE_RECEIPT_WHY="no successful job names the tested sha $tested"; return 7; }
  # STALENESS. The tested commit is immutable, so age alone cannot make the
  # verdict WRONG about that commit; what age erodes is the claim that the tree
  # still looks the way it did when the verdict was earned. 24h default, env
  # override, 0 disables. An UNREADABLE ts is refused rather than assumed fresh:
  # "cannot bound the age" must never read as "fresh enough".
  maxage="${OC_SHIP_GATE_RECEIPT_MAX_AGE_SECS:-86400}"
  case "$maxage" in ''|*[!0-9]*) maxage=86400 ;; esac
  if [ "$maxage" -gt 0 ]; then
    ts="$(jq -r '.ts // ""' "$rp" 2>/dev/null || true)"
    age=""
    [ -n "$ts" ] && age="$(date -u -d "$ts" +%s 2>/dev/null || true)"
    if [ -z "$age" ]; then
      GATE_RECEIPT_WHY="receipt ts '${ts:-none}' is unreadable — cannot bound its age"
      return 6
    fi
    now="$(date -u +%s)"
    if [ "$((now - age))" -gt "$maxage" ]; then
      GATE_RECEIPT_WHY="receipt is $((now - age))s old, beyond the ${maxage}s budget — re-gate"
      return 6
    fi
  fi
  # ...and it must have been earned on the CARRIER this chain dispatches against.
  # A receipt written by a gate that ran on another branch proves a green about a
  # workflow this chain will not execute — while naming the SAME sha, so nothing
  # above discriminates it. rc 8, not rc 3: the subject is right, the instrument
  # is not, and the remedy is a gate on the carrier actually being shipped.
  _carrier="$(jq -r '.carrier_ref // ""' "$rp" 2>/dev/null || true)"
  _want_carrier="${OC_SHIP_CARRIER:-${CARRIER:-ci/quick-build-linux}}"
  [ -n "$_carrier" ] || { GATE_RECEIPT_WHY="receipt names no carrier_ref — cannot bind it to ${_want_carrier}"; return 2; }
  [ "$_carrier" = "$_want_carrier" ] || { GATE_RECEIPT_WHY="receipt was earned on carrier '${_carrier}' but this chain ships on '${_want_carrier}'"; return 8; }
  GATE_RECEIPT_PATH="$rp"
  return 0
}

FAST_GATE=1
EVAL_DOCS_SKIP=0
# #77: scheduling class for this chain. `low` (nice 19 + ionice class idle) is
# the default because a chain is BACKGROUND work — it sits in remote-CI waits for
# minutes and must not compete with the daemon. `normal` is the opt-out.
PRIORITY="low"
PRIORITY_PROBE=0
# factory #39 → RETIRED 2026-11-20 (factory #181): --test-threads carried the
# #1936 Stage-1 hang mitigation into LEG1's oc-gate dispatch; the carrier
# declares the input and IGNORES it, so the forward is GONE. The env default
# follows the house pattern (OC_SHIPCHAIN_GATE_WAIT / OC_SHIPCHAIN_SHIP_WAIT);
# the value is ACCEPTED and NOTED loudly, never sent (the dispatch is
# byte-identical with or without it).
TEST_THREADS="${OC_SHIPCHAIN_TEST_THREADS:-}"
# #78: env form of --no-rearm, so a lane can set it for a whole session without
# threading the flag through every invocation. Shape is validated like
# --test-threads: a typo must die at the boundary (rc 2) rather than read as
# "0" and silently leave the supervisor armed — an accepted-but-inert knob is
# indistinguishable from an honoured one (the #63 class).
case "${OC_SHIPCHAIN_NO_REARM:-}" in
  '') : ;;
  0) : ;;
  1) NO_REARM=1 ;;
  *) die "OC_SHIPCHAIN_NO_REARM needs 0 or 1 (got '$OC_SHIPCHAIN_NO_REARM')" 2 ;;
esac
case "$TEST_THREADS" in
  '') : ;;
  *[!0-9]*) die "OC_SHIPCHAIN_TEST_THREADS needs a non-negative integer (got '$TEST_THREADS')" 2 ;;
esac
# ---- #205 P3: `--in-flight` — what is shipping RIGHT NOW ---------------------
# Nothing answered this. Chains are transient systemd units (garbage-collected
# on exit) or bare process trees with no unit at all, so
# `systemctl --user list-units --all 'oc-ship-*'` returns ZERO rows even for a
# chain that finished an hour ago — and the absence was read as "nothing is
# shipping". Measured: of 571 `kind=shipchain` ledger rows, 0 carried a pid, so
# a killed chain's last row was byte-identical to a running one's and #1064 was
# reported chainless while 29 minutes into a ship.
#
# THE REGISTRY IS THE LEDGER THAT ALREADY EXISTS. No new file: STATE_DIR is a
# git repository whose .gitignore records that a transient untracked file
# "disarmed every clean-tree signal (#540 class)", so a new state file would
# need gitignore work and would risk exactly that. The ledger has no such cost.
#
# LIVENESS: `kill -0 <pid>`. A chain with NO pid (every historical row) is
# reported `UNKNOWN` — never guessed as running, because "no evidence of death"
# is not evidence of life and that is the direction that costs a lane hours.
ship_in_flight() {
  local n="${OC_SHIPCHAIN_INFLIGHT_N:-400}" ledger_out rc=0
  local state_dir="${OC_DEPLOY_STATE_DIR:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}"
  # OC_SHIP_LEDGER is the ONLY seam a test may use, and it exists because
  # OC_TOOLS_DIR cannot serve as one: the oc-root bootstrap RESOLVES it from
  # `$0`'s own location and OVERWRITES any inherited value on purpose (see
  # tools/lib/oc-root.sh, case 2 — a fixture copy beside fake siblings must
  # keep its own tree, so a walk that honoured the environment would escape
  # the fixture and defeat the isolation). Measured 2026-11-28: the selftest
  # arms set OC_TOOLS_DIR="$T/faketools" and the stub was never read — the
  # verb answered from the REAL fleet ledger (17 real chains, zero fixture
  # chains) while every fixture assertion read as a product defect.
  local led="${OC_SHIP_LEDGER:-${OC_TOOLS_DIR:-$TOOLS_DIR}/state/oc-ledger}"
  if [ ! -x "$led" ]; then
    printf 'oc-ship: --in-flight needs %s (the fleet ledger tool) — not found\n' "$led" >&2
    return 2
  fi
  # `--n` is MANDATORY on the events verb: it is a TAIL whose default window is
  # 20 rows, so a bare `events --kind shipchain` returns an empty result that is
  # INDISTINGUISHABLE from "no rows exist". --all would dump the whole record
  # (8k+ rows); a bounded tail is what an in-flight question needs, and the
  # bound is overridable for an unusually long tail.
  # `--json` (an ARRAY), not `--jsonl`: the filter below indexes the whole
  # document (`.[]`), and NDJSON would hand it one object per line — which fails
  # every row and reads as "no parseable prefix" over a perfectly good tail.
  ledger_out="$("$led" events --kind shipchain --n "$n" --full --json 2>/dev/null)" || rc=$?
  # rc 1 from `events` is its NO-MATCH VERDICT, not an error: the tail held no
  # shipchain row, which IS the answer to "what is shipping" (nothing). Any
  # other rc is a real read failure and must not be dressed as a clean answer —
  # that conflation is the whole defect class this verb exists to kill.
  if [ "$rc" -eq 1 ]; then
    printf 'oc-ship: --in-flight: no shipchain row in the last %s ledger rows — nothing shipping\n' "$n"
    return 0
  fi
  if [ "$rc" -ne 0 ]; then
    printf 'oc-ship: --in-flight could not read the ledger (rc=%s) — this is NOT "nothing is shipping"\n' "$rc" >&2
    return 2
  fi
  if [ -z "$ledger_out" ]; then
    printf 'oc-ship: --in-flight: the ledger tail (%s rows) holds no shipchain row — nothing shipping, or the tail is too short; raise OC_SHIPCHAIN_INFLIGHT_N\n' "$n" >&2
    return 0
  fi
  # Group by chain id, keep the NEWEST row per chain (rows are appended oldest ->
  # newest, so the last row seen for a chain id wins), and emit TSV so the shell
  # never parses JSON: cid, issue, sha, pid, event, ts.
  local rows
  rows="$(printf '%s\n' "$ledger_out" | jq -r '
    # THE `?` OPERATOR IS LOAD-BEARING, and `try ... catch` is NOT a substitute:
    # jq'"'"'s capture() RAISES on a non-match, and in jq 1.7 a `try (…|capture(…))
    # catch ""` inside an array constructor silently DROPS the element instead of
    # substituting the catch value — measured here, over a 40-row tail, it
    # returned one row where `? // ""` returned forty. A filter that drops rows
    # reads downstream as "no parseable prefix", which is exactly the false
    # absence this verb exists to end.
    def cid: ((.what // "") | capture("^\\[(?<c>[^]]+)\\]") | .c)? // "";
    def cwhat: ((.what // "") | sub("^\\[[^]]*\\] "; "")) // (.what // "");
    def field($k): (cwhat | capture("(?:^|\\s)" + $k + "=(?<v>[^\\s]+)") | .v)? // "";
    def ev: (cwhat
             | if test("^START ") then "START"
               elif test("^DONE ") then "DONE"
               elif test("^SHIP-LOCK released") then "RELEASED"
               elif test("^SHIP-LOCK ") then "SHIP-LOCK"
               elif test("^LEG") then (capture("^(?<l>LEG[0-9]+)") | .l)
               elif test("^(FATAL|FAIL|RED)") then "FAIL"
               else (split(" ")[0] // "?") end);
    [ .[] | select(cid != "") | {
        cid: cid, t: (.t // ""), ev: ev,
        issue: (field("issue")), sha: (field("sha")), pid: (field("pid"))
      } ]
    # THE LAST ROW ANSWERS "WHAT IS IT DOING", THE EARLIER ONES ANSWER "WHO IS
    # IT". `map(last)` alone took the newest row for every field, and the newest
    # row of a running chain is a LEG line that carries no pid and no issue — so
    # a chain 29 minutes into a ship printed `-` for its issue and UNKNOWN for
    # its liveness, which is the exact false absence this verb exists to kill
    # (#1064 read chainless for that reason). Only START stamps issue=/pid=, so
    # those fields must be CARRIED FORWARD from the newest row that has them.
    # The event and its instant still come from the newest row: that is the
    # the chain present state, not its identity.
    | group_by(.cid)
    | map( (last) as $l
           | { cid: .[0].cid, t: ($l.t // ""), ev: $l.ev,
               issue: ([.[].issue | select(. != "")] | last // ""),
               sha:   ([.[].sha   | select(. != "")] | last // ""),
               pid:   ([.[].pid   | select(. != "")] | last // "") } )
    | sort_by(.t) | .[]
    # \u001f (UNIT SEPARATOR), never a TAB: `read` splits on IFS and TAB is IFS
    # WHITESPACE, so consecutive tabs COLLAPSE and every empty field silently
    # shifts the columns after it — measured here, the ts landed in the sha
    # column on every chain whose issue was empty. A non-whitespace separator
    # preserves empty fields, which is what makes a missing fact READ as missing
    # rather than as the neighbouring fact.
    | [ .cid, (.issue // ""), (.sha // ""), (.pid // ""), .ev, .t ] | join("\u001f")' 2>/dev/null)" || rows=""

  if [ -z "$rows" ]; then
    printf 'oc-ship: --in-flight: ledger rows present but none carried a parseable [CHAIN-...] prefix — cannot group; raw tail follows\n' >&2
    printf '%s\n' "$ledger_out" | tail -20 >&2
    return 2
  fi

  # TERMINAL events: a chain whose newest row is one of these has FINISHED (or
  # failed) and is not in flight. It is listed as ENDED rather than dropped, so
  # "absent" and "finished" stay distinguishable — the distinction whose absence
  # started this issue.
  local cid issue sha pid ev ts verdict shown=0
  printf 'CHAIN\tISSUE\tSHA\tPID\tLAST\tAT\tVERDICT\n'
  while IFS="$(printf '\037')" read -r cid issue sha pid ev ts; do
    [ -n "$cid" ] || continue
    shown=$((shown + 1))
    case "$ev" in
      # #205 P3b: CANCELLED is the row _chain_exit_handler now stamps when a
      # signal terminated the chain. Without it in this set a cancelled chain
      # falls to the pid branch below and reads DEAD-or-UNKNOWN, which is the
      # same answer a chain that was hard-killed gets — so the two would stay
      # indistinguishable. ENDED is the honest verdict for a signal: the chain
      # is over, and its own row says WHY.
      DONE|RELEASED|FAIL|CANCELLED) verdict="ENDED" ;;
      *)
        if [ -n "$pid" ] && [ "$pid" != "none" ]; then
          if kill -0 "$pid" 2>/dev/null; then verdict="RUNNING"; else verdict="DEAD"; fi
        else
          verdict="UNKNOWN"
        fi ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$cid" "${issue:--}" "${sha:--}" "${pid:--}" "$ev" "${ts:--}" "$verdict"
  done <<EOF
$rows
EOF
  if [ "$shown" -eq 0 ]; then
    printf 'oc-ship: --in-flight: no chain rows in the ledger tail — nothing shipping in the last %s shipchain rows\n' "$n" >&2
  fi
  return 0
}

while [ $# -gt 0 ]; do
  case "$1" in
    --eval-docs-skip)
      EVAL_DOCS_SKIP=1
      if [ $# -gt 1 ] && [[ "$2" != -* ]]; then
        SHA="$2"
        shift 2
      else
        shift
      fi
      ;;
    --sha)       SHA="${2:?}"; shift 2 ;;
    --branch)    BRANCH="${2:?}"; shift 2 ;;
    --issue)     ISSUE="${2:?}"; shift 2 ;;
    --issue-repo) ISSUE_REPO_FLAG="${2:?}"; shift 2 ;;
    --repo)      REPO="${2:?}"
                 # #90: --repo is a gh SLUG, never a checkout path. A path
                 # reaches `gh -R` verbatim, gh refuses it ("expected the
                 # [HOST/]OWNER/REPO format"), and before this guard the
                 # stderr was swallowed so the chain died rc 4 blaming the
                 # RUN — sending the lane to hunt a phantom gate problem.
                 # Fail loud at the arg boundary instead, and name the knob
                 # that actually takes a path (the #63 class: an accepted-
                 # but-misread knob is indistinguishable from an honoured one).
                 case "$REPO" in
                   /*|./*|../*|~*)
                     die "--repo takes an owner/repo SLUG (e.g. leshchenko1979/opencrabs), not a checkout path: '$REPO'. The checkout is OC_FORK_REPO=<path>; --repo is only ever passed to gh -R." 2 ;;
                 esac
                 if [ -d "$REPO" ]; then
                   die "--repo takes an owner/repo SLUG, not a directory: '$REPO' exists on disk. The checkout is OC_FORK_REPO=<path>; --repo is only ever passed to gh -R." 2
                 fi
                 shift 2 ;;
    --wait)      WAIT="${2:?}"; shift 2 ;;
    --gate-wait) GATE_WAIT="${2:?}"; shift 2 ;;
    --gated-sha) GATED_SHA="${2:?}"; shift 2 ;;
    --gated-run) GATED_RUN="${2:?}"; shift 2 ;;
    --fast)            FAST_GATE=1; shift ;;
    # #78: opt out of the Class A re-arm supervisor. Two legitimate uses:
    # a lane that wants to SEE every mechanical failure (debugging the chain
    # itself), and an operator who wants the old wake-every-time behaviour.
    --no-rearm)        NO_REARM=1; shift ;;
    --full|--no-fast)  FAST_GATE=0; shift ;;
    --test-threads)    shift; TEST_THREADS="${1:-}"
                       # Shape is validated HERE, not left to the callee: a
                       # typo must die at the caller's own arg boundary (rc 2
                       # usage) rather than reach oc-gate as a bad input.
                       case "$TEST_THREADS" in
                         ''|*[!0-9]*) die "--test-threads needs a non-negative integer (got '$TEST_THREADS')" 2 ;;
                       esac
                       shift ;;
    --dry-run)   DRY=1; shift ;;
    --no-ledger) NOLEDGER=1; shift ;;
    # #77: scheduling class. Validated HERE so a typo dies at the caller's own
    # arg boundary (rc 2) instead of reaching the apply step as a bad input.
    --priority)
      PRIORITY="${2:-}"
      case "$PRIORITY" in
        low|normal) : ;;
        '') die "--priority needs 'low' or 'normal' (got nothing)" 2 ;;
        *)  die "--priority needs 'low' or 'normal' (got '$PRIORITY')" 2 ;;
      esac
      shift 2 ;;
    # #77: read-only probe — applies the REAL block, prints the resolved class,
    # exits 0 before any required-arg check or network call. This is what the
    # selftest drives; a re-implementation in the test would prove nothing.
    --resolve-priority) PRIORITY_PROBE=1; shift ;;
    # #205 P3: read-only. Answers "what is shipping right now" from the ledger
    # that already exists; takes no --sha/--branch, so it exits HERE rather than
    # tripping the required-arg checks below.
    --in-flight) ship_in_flight; exit $? ;;
    --help|-h)   usage ;;
    *) die "unknown arg: $1 (see --help)" 2 ;;
  esac
done

# ---- scheduling priority (#77) ----------------------------------------------
# Applied to THIS process, so every child (gh, git, oc-gate) inherits it at
# fork. `renice` rather than a `nice -n 19` wrapper: the chain may already have
# re-exec'd itself once, and a second exec layer would make "which PID is the
# chain" depend on which branches fired.
# A failed renice/ionice is a WARNING and never a die — refusing to ship because
# we could not lower our own priority would trade a scheduling nicety for an
# outage. What the class actually APPLIED is re-read from the kernel and carried
# in the log line and the ledger row, so a run can be classified afterwards
# rather than inferred from the flag someone typed.
oc_priority_apply() {  # $1 = low|normal ; sets PRIORITY_NICE/PRIORITY_IOPRIO/PRIORITY_APPLIED
  local want="$1" a=""
  PRIORITY_APPLIED="none"
  PRIORITY_NICE="$(ps -o nice= -p $$ 2>/dev/null | tr -d ' ')"
  PRIORITY_IOPRIO="$(ionice -p $$ 2>/dev/null || true)"
  if [ "$want" = "low" ]; then
    if command -v renice >/dev/null 2>&1; then
      if renice -n 19 -p $$ >/dev/null 2>&1; then
        a="renice"
      else
        printf '%s\n' "oc-ship: WARNING: renice -n 19 failed -- running at nice ${PRIORITY_NICE:-?} (#77)" >&2
      fi
    else
      printf '%s\n' "oc-ship: WARNING: no renice -- running at nice ${PRIORITY_NICE:-?} (#77)" >&2
    fi
    if command -v ionice >/dev/null 2>&1; then
      if ionice -c3 -p $$ >/dev/null 2>&1; then
        a="${a:+$a+}ionice"
      else
        printf '%s\n' "oc-ship: WARNING: ionice -c3 failed -- I/O priority unchanged (#77)" >&2
      fi
    else
      printf '%s\n' "oc-ship: WARNING: no ionice -- I/O priority unchanged (#77)" >&2
    fi
    PRIORITY_APPLIED="${a:-none}"
    PRIORITY_NICE="$(ps -o nice= -p $$ 2>/dev/null | tr -d ' ')"
    PRIORITY_IOPRIO="$(ionice -p $$ 2>/dev/null || true)"
  fi
}
oc_priority_apply "$PRIORITY"
if [ "$PRIORITY_PROBE" = "1" ]; then
  # #77 req 2: a child spawned AFTER the renice must inherit it. Asserting only
  # the parent's nice cannot distinguish "applied before the children" from
  # "applied after" -- and a nice 19 parent does NOT yield a child that forked
  # at 0 (the issue's own warning). This forks a REAL child ($BASHPID inside
  # `bash -c` is the new process) and reports what it actually reads.
  PRIORITY_CHILD_NICE="$(bash -c 'ps -o nice= -p $$' 2>/dev/null | tr -d ' ')"
  printf 'priority=%s\nnice=%s\nioprio=%s\napplied=%s\nchild_nice=%s\n' \
    "$PRIORITY" "${PRIORITY_NICE:-}" "${PRIORITY_IOPRIO:-}" "${PRIORITY_APPLIED:-none}" "${PRIORITY_CHILD_NICE:-}"
  exit 0
fi
printf 'oc-ship: priority=%s (nice=%s ioprio=%s applied=%s)\n' \
  "$PRIORITY" "${PRIORITY_NICE:-}" "${PRIORITY_IOPRIO:-}" "${PRIORITY_APPLIED:-none}" >&2

if [ "$EVAL_DOCS_SKIP" = "1" ]; then
  [ -n "$SHA" ] || die "--sha or commit argument required for --eval-docs-skip" 2
  require_fork_checkout "$FORK_REPO"
  git -C "$FORK_REPO" rev-parse --verify --quiet "$SHA^{commit}" >/dev/null 2>&1 \
    || die "bad commit or unknown ref: $SHA" 3
  if EVAL_PATHS="$(shipchain_docs_only)"; then
    printf '%s\n' "$EVAL_PATHS"
    printf 'oc-ship: DOCS-ONLY gate skip permitted for %s\n' "$SHA" >&2
    exit 0
  else
    printf 'oc-ship: GATE-REQUIRED for %s (contains code or compiled-in markdown)\n' "$SHA" >&2
    exit 1
  fi
fi

