#!/usr/bin/env bash
# =============================================================================
# oc-fanout — the NOTIFY leg of the four-way oc-deploy split (issue #24).
#
# Owns the `fanout` verb: mechanical post-CI notification, zero LLM. GREEN leg
# = one notify per contributing session once a swap lands; RED leg = blame
# attribution plus a cc to the suspects. Idempotent via $FANOUT_STATE, single
# flight per run (#42), bounded re-send for a TRANSIENT failure (#623), and it
# never resurrects a dead uuid (#17 class).
#
# WHAT MOVED HERE, VERBATIM (byte-slice of oc-deploy@5f81c599: 881-1360, plus
# the `fanout)` dispatch arm at 2753-2757): the whole #24 fan-out section —
# the constants, fanout_journal_init, notify_session, fanout_mark_done,
# decode_job_sha_any, run_built_sha, decode_built_sha, _notify_reason,
# _notify_retryable, notify_one, attrib_at, green_leg, red_leg, fanout_run.
# Nothing was rewritten and no rc was re-mapped. The A2A receipt helper, the
# journal, the ledger stamp and the argv loop are SHARED (tools/lib/).
#
# #192 — THE ADDRESS IS RESOLVED BEFORE ANYTHING IS WOKEN. A commit trailer can
# name a SUB-AGENT session (`sessions.title LIKE 'subagent:%'`) or a uuid that
# exists in no store; measured on fork main, 45% of the last 60 commits were
# unusable for attribution while this fan-out reported success. `resolve_lane`
# walks child -> owning lane through `tools/lib/oc-sessions.sh`, and every notify
# in this file goes through `notify_one`, so there is ONE resolution point and no
# call site to forget. Three outcomes are counted SEPARATELY, because they are
# different facts: `notified` (a lane was woken), `skipped` (the transport
# refused — rc 2 no_route / rc 4 transport, a verdict about the LANE), and
# `unresolved` (the STORE could not attribute the trailer: a child with no
# parent recorded, or no such session — a defect in the commit, which is why it
# is never folded into the transport's number). An unreadable store or a missing
# library degrades to today's verbatim behaviour and SAYS SO on stderr: a fact
# about this box must never be reported as a fact about a lane (#932).
#
# RC CONTRACT: tools/docs/RC-CONTRACT.md (the oc-fanout row).
# =============================================================================
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

# ----------------------------------------------------------------------------
# functions moved VERBATIM (source 881-1360): the whole #24 fan-out section
# ----------------------------------------------------------------------------
# ------------------------------------------------------------- fan-out (#24) --
# issue #24: mechanical post-CI notifications, zero LLM. GREEN leg: one notify
# per contributing session post-swap (oc-attrib --deployed is the compute).
# RED leg: blame attribution + suspect cc (plan task 4). Idempotent via
# $FANOUT_STATE (re-run = no-op); standalone re-runnable. Verb rc != 0 (dead
# uuid) journals skip and moves on — never resurrects, never reaps (#17 class).
# Journal vocabulary fixed in the issue body. Exit: 0 done/noop | 2 usage
# | 3 gh/attrib fetch fail | 4 run not terminal. issue #42: single-flight
# flock per run (acquired BEFORE the idempotence guard, held through the
# mark) — a concurrent sweep exits 0 reason=inflight, never re-notifies.
# Lock files are never unlinked: unlink-while-held splits the lock.
# (#68-plan T5-bis) LAZY, and it must stay lazy. This function block sits ABOVE
# the prologue that sources lib/oc-deploy-lib.sh, and STATE_DIR is defined THERE.
# An eager `FANOUT_STATE="$STATE_DIR/fanout.state"` at this line therefore
# evaluates BEFORE STATE_DIR exists and collapses to "/fanout.state" — root-
# writable, so it silently ACCUMULATED every fixture run id and made each fan-out
# arm read as already-done (measured: /fanout.state held 222, 666, 998, ... i.e.
# exactly the selftest's own run ids, and the suite went 49 FAIL). Resolving at
# USE time is the only form that works in all three call paths: a normal run, a
# `OC_DEPLOY_FUNCS_ONLY=1` source (prologue skipped, STATE_DIR unset), and a
# child re-exec.
fanout_state_file() {
  # Loud, never silent: an empty STATE_DIR would print "/fanout.state", which is
  # the exact path the eager form collapsed to. A caller that skipped the lib
  # gets a named fault, not a root-writable state file.
  if [ -z "${STATE_DIR:-}" ]; then
    printf 'fanout: STATE_DIR is unset — lib/oc-deploy-lib.sh was not sourced\n' >&2
    return 2
  fi
  printf '%s/fanout.state' "$STATE_DIR"
}
# (#623) Bounded re-send for a TRANSIENT notify failure. The dominant case is
# structural, not a fault: this fan-out fires at the swap tail while the daemon
# is still opening its DB, so the A2A gateway is not bound yet. Measured
# 2026-09-27: 18/18 transport errors fell 1-169 s BEFORE a gateway bind, and the
# gateway binds ~7 s after the integrity line -- which itself takes ~2 min on
# the ops DB. `oc_notify_session`'s own retry is ~31.5 s worst case, 3-5x too
# short for that window, so 13.5% of attributed wakes were lost (fanout.state,
# 276 runs: notified=372 skipped=58).
# COST, stated because this fan-out runs INLINE in the swap chain: a transient
# failure now delays the swap-result stamp by up to this budget. The swap itself
# is already complete (binary swapped, markers written) before the fan-out runs,
# so the delay costs chain latency, never correctness. Set to 0 to disable.
# (#623 residual) 180, not 120: the budget must EXCEED the window it covers or
# the tail is uncovered by construction. Measured by an editor lane on its own
# swap -- the 120 s budget was consumed IN FULL and the send still failed
# (+127 s) -- while the window this file's own comment cites runs to 169 s.
NOTIFY_RETRY_BUDGET="${OC_DEPLOY_NOTIFY_RETRY_BUDGET:-180}"
NOTIFY_RETRY_INTERVAL="${OC_DEPLOY_NOTIFY_RETRY_INTERVAL:-15}"
NOTIFY_CMD="${OC_DEPLOY_NOTIFY:-opencrabs}"
NOTIFY_PROFILE="${OC_DEPLOY_PROFILE:-ops}"
REPO_DIR="${OC_DEPLOY_REPO:-$HOME/opencrabs}"

fanout_journal_init() { # $1 = run id
  mkdir -p "$JOURNAL_DIR"
  JF="$JOURNAL_DIR/fanout-$1-$(date +%s)-$$.jsonl"
  : > "$JF"; SEQ=0
}

notify_session() { # $1=uuid $2=title $3=text -> verb rc (0 delivered)
  # E-F4 (v0.4.97): wake logic delegated to lib/oc-notify.sh — single owner of
  # the session-notify exit-code contract + refused_in_flight interrupt retry.
  if [ "${DRYRUN:-0}" = 1 ]; then return 0; fi
  # (#932 criterion 3) rc 4 = `transport` in the session-notify vocabulary: the wake
  # could not be ATTEMPTED, which is a delivery failure, NOT `2`/no_route -- that
  # token means the LANE IS GONE (permanent, #623), and a missing library on this box
  # says nothing about the lane. Never 127: that is an undeclared code.
  if [ "${_OC_NOTIFY_MISSING:-0}" = 1 ] || ! command -v oc_notify_session >/dev/null 2>&1; then
    printf 'notify unavailable: %s missing or does not define oc_notify_session — cannot wake any lane (#932)\n' \
      "${_OC_NOTIFY_LIB:-lib/oc-notify.sh}" >&2
    return 4
  fi
  oc_notify_session "$NOTIFY_CMD" "$NOTIFY_PROFILE" "oc-fanout" "$1" "$2" "$3"
}

fanout_mark_done() { # $1=run $2=verdict $3=notified $4=skipped $5=unowned [$6=unresolved]
  # (#192) $6 is DEFAULTED, not required: every pre-#192 caller passes five
  # arguments, and a record that cannot be written because a new field arrived is
  # a worse outcome than a record without it. An absent value is stored as 0, so
  # "no unresolved sessions" and "this run predates the field" both read 0 —
  # which is the honest reading, since neither run notified a dead child.
  local tmp fs unr="${6:-0}"
  fs="$(fanout_state_file)"
  tmp="$(mktemp)" || return 1
  if [ -f "$fs" ]; then
    jq --arg id "$1" --arg v "$2" --arg at "$(date -u +%FT%TZ)" \
       --argjson n "$3" --argjson s "$4" --argjson u "$5" --argjson r "$unr" \
       '.runs[$id] = {verdict:$v, at:$at, notified:$n, skipped:$s, unowned:$u, unresolved:$r}' \
       "$fs" > "$tmp" && mv "$tmp" "$fs"
  else
    jq -cn --arg id "$1" --arg v "$2" --arg at "$(date -u +%FT%TZ)" \
       --argjson n "$3" --argjson s "$4" --argjson u "$5" --argjson r "$unr" \
       '{runs:{($id):{verdict:$v, at:$at, notified:$n, skipped:$s, unowned:$u, unresolved:$r}}}' \
       > "$tmp" && mv "$tmp" "$fs"
  fi
}

decode_job_sha_any() { # $1=job name -> 40-hex sha from EITHER name shape (#72): the build-job embed "(<sha>, <features>)" or the gates-job bare form "(<sha>)"; empty if none. DELEGATES to the shared decoder (lib/oc-embed.sh) — the predicate has ONE home (factory #34); this wrapper keeps the #72 call-site name.
  # (#932) A MISSING decoder is NOT a negative answer. Without this pre-check the
  # shell answers rc 127 for an undefined command, which every caller reads as
  # "this name carries no sha" — see the _OC_EMBED_MISSING note at the source site.
  # rc 2, NOT the rc-5 transient arm: #84's 5 means "the jobs list could not be
  # READ" (a gh blip, worth retrying), while this is "the decoder is not on this
  # checkout" — a fault of the LOCAL TOOL TREE that no retry can fix and that says
  # nothing whatsoever about the run. Collapsing the two is what let a partial
  # checkout keep reporting itself as an unattributable range (#932's symptom).
  if [ "${_OC_EMBED_MISSING:-0}" = 1 ] || ! command -v oc_decode_job_sha_any >/dev/null 2>&1; then
    printf 'decode unavailable: %s missing or does not define oc_decode_job_sha_any — this checkout cannot evaluate ANY job name; restore the library (a broken tools tree, not a fact about the run) (#932)\n' \
      "${_OC_EMBED:-lib/oc-embed.sh}" >&2
    return 2
  fi
  oc_decode_job_sha_any "${1:-}"
}

run_built_sha() { # $1=run id -> echo sha from the FIRST job name that decodes (ANY shape, ALL jobs scanned — #72); rc 0/2/3/5
  # (#84) rc 3 and rc 5 are DIFFERENT FACTS and conflating them cost two fan-outs
  # their attribution permanently. rc 3 = the jobs list was READ and no job name
  # decodes: a statement about the RUN, permanent. rc 5 = the jobs list could not
  # be READ: a statement about gh or this box, transient.
  #
  # Both used to be rc 3, because `gh api`'s stderr was discarded into a pipe: a
  # failed read produced empty input, the loop body never ran, and the function
  # fell out as if the run carried no decodable job. An unreadable predicate was
  # read as a negative answer. Measured: runs 33563606624 (2026-09-01) and
  # 44420005606 (2026-11-18) both recorded decode-error with notified=0 while a
  # plain re-run decoded the same run seconds later.
  #
  # rc 2 is the third fact and the one #932 was filed for: the EMBED DECODER IS
  # NOT ON THIS CHECKOUT. It is not a statement about the run at all — no job name
  # can even be evaluated — so it is neither permanent (rc 3) nor worth a blind
  # retry (rc 5): it is a broken local tools tree, and the caller must say so
  # rather than report the run as unattributable.
  #
  # (#932) This DOES reach the user: `fanout` branches on rc 2 and dies 2 naming
  # the missing library. An earlier version of this comment claimed "internal code
  # only — no user-facing rc changes"; that stopped being true the moment a
  # missing decoder got its own code, because the whole point is that the operator
  # sees "restore tools/lib/oc-embed.sh" instead of "run has no decodable job".
  # The three other callers (ship --wait candidate scans, poll) still treat empty
  # output as "skip this candidate" and never branch on this rc, so they are
  # unaffected.
  local jn s jobs jobs_rc names dec_rc
  # (#932) Check the LOCAL defect BEFORE the network call. A missing decoder is
  # both the more actionable fact and the one no retry can fix, so it must never
  # be masked by a gh blip: with the check below, a broken checkout reports rc 2
  # deterministically and makes no API call at all.
  if [ "${_OC_EMBED_MISSING:-0}" = 1 ] || ! command -v oc_decode_job_sha_any >/dev/null 2>&1; then
    printf 'decode unavailable: %s missing or does not define oc_decode_job_sha_any — this checkout cannot evaluate ANY job name; restore the library (a broken tools tree, not a fact about the run) (#932)\n' \
      "${_OC_EMBED:-lib/oc-embed.sh}" >&2
    return 2
  fi
  jobs="$("$GH" api "repos/$FORK/actions/runs/$1/jobs" 2>&1)"; jobs_rc=$?
  if [ "$jobs_rc" != 0 ]; then
    printf 'gh api jobs rc=%s: %s' "$jobs_rc" \
      "$(printf '%s' "$jobs" | head -c 200 | tr '\n\r\t' '   ' | tr -d '"\\')" >&2
    return 5
  fi
  names="$(printf '%s' "$jobs" | jq -r '.jobs[].name // empty' 2>/dev/null)"; jobs_rc=$?
  if [ "$jobs_rc" != 0 ]; then
    printf 'jobs payload unparseable (jq rc=%s) — read failed, not an absent sha' "$jobs_rc" >&2
    return 5
  fi
  while IFS= read -r jn; do
    [ -n "$jn" ] || continue
    s="$(decode_job_sha_any "$jn")"; dec_rc=$?
    # (#932) `|| continue` was the swallow point: it turned EVERY non-zero decode
    # rc into "this name carries no sha". Propagate BOTH non-negative causes
    # instead — 2 = this checkout has no decoder (fix it and re-run), 5 = the jobs
    # list could not be read (retry) — so neither ever becomes a permanent verdict
    # on the run.
    [ "$dec_rc" = 2 ] && return 2
    [ "$dec_rc" = 5 ] && return 5
    [ -n "$s" ] && { printf '%s' "$s"; return 0; }
  done <<< "$names"
  return 3
}

decode_built_sha() { # $1=run id -> echoes 40-hex sha from first decodable job name (any shape — #72); rc 0/2/3/5 (rc 2 = decoder lib missing from THIS checkout, #932)
  run_built_sha "$1"
}

# (#623) verb rc -> journal reason. ONE home, so the journal and the doc cannot
# drift. `dead` is RESERVED for rc 2 (no_route), the only PERMANENT outcome --
# before this, a transport failure and a timeout both journalled as "dead", so
# the durable record asserted an absent lane when the daemon was merely booting.
# Contract: tools/lib/oc-notify.sh:12-15. rc 124 is `timeout`'s own code, NOT in
# that contract: it is reached when the CLI hung AND the A2A fallback also
# failed, which is a distinct and worse condition than a plain transport error.
_notify_reason() { # $1 = verb rc -> reason token
  case "${1:-}" in
    2)   printf 'dead' ;;                 # no_route -- the lane is gone (PERMANENT)
    3)   printf 'refused_in_flight' ;;
    4)   printf 'transport' ;;
    124) printf 'timeout' ;;
    *)   printf 'unknown' ;;
  esac
}

# (#623) rc 2 is PERMANENT: re-sending to a dead uuid cannot help. Everything
# else is transient by construction. rc 0 is not a failure, so it is excluded.
_notify_retryable() { # $1 = verb rc -> rc 0 when a re-send is worth attempting
  case "${1:-}" in
    0|2) return 1 ;;
    *)   return 0 ;;
  esac
}

# (#192) resolve_lane <uuid> — WHICH SESSION SHOULD ACTUALLY BE WOKEN?
# The fan-out's input is a commit trailer, and a trailer can name a session that
# no human-facing lane ever reads. Measured on fork main at #192: 25% of the last
# 60 commits named a `subagent: <label>` session, 1.7% named a session that
# exists in NO store. Every one of those was handed to notify_one verbatim, so
# the wake either landed in a queue with no reader (and journalled `notified`, a
# durable claim of success) or died rc 2 and journalled `skip` — and the lane
# that owns the work was never told its part shipped.
#
# ONE resolution step, called from notify_one, which every notify in this file
# goes through: one implementation, four call sites (green contributor, red
# no-site fallback, blamed, suspect cc). Wrapping the call sites instead would
# leave the next one unwrapped — the shape that produced this bug.
#
# NO STDOUT. It answers in three variables, and that is load-bearing rather than
# stylistic: `x="$(resolve_lane ...)"` would run the function in a SUBSHELL, so
# every assignment it makes would be discarded and notify_one would read stale
# (or empty) values — a resolver that looks correct and resolves nothing.
#   RESOLVED_UUID  the uuid to notify (the input, or its lane)
#   RESOLVED_FROM  the trailer uuid when the address was REWRITTEN, else empty
#   RESOLVED_KIND  `lane` / `child` / `unknown` — what the store said, so the
#                  caller can journal a fact it did not have to re-derive
#   RESOLVE_SKIP   a reason token when the address cannot be a lane at all; the
#                  caller must NOT send, because the send is a known no-op
#
# THE FOUR ANSWERS, and why each is what it is:
#   lane                 -> itself. The normal case, no journal noise.
#   child <lane>         -> the LANE. This is the whole fix: the work is
#                           attributed to the session that owns it.
#   child -  (no parent) -> SKIP, reason `no-parent`. A pre-ship row: the column
#                           exists but was never backfilled (240 such rows on the
#                           live box, and #192's own measurement predates the
#                           column entirely). Waking the CHILD is a guaranteed
#                           no-op — that IS the bug — so the honest move is to
#                           say so in the journal and in the tally rather than
#                           send a wake we know lands nowhere.
#                           `tools/state/oc-session-backfill` repairs the rows
#                           that carry a recoverable parent.
#   unknown              -> ITSELF, unchanged, and NOT a skip. The transport
#                           answers rc 2 `no_route` for a dead uuid (#623) and
#                           journals `skip reason=dead`, which is a statement
#                           about the LANE. Pre-empting it here would re-label a
#                           real transport verdict as a store verdict, and a uuid
#                           belonging to another profile's store is a live lane on
#                           this box. The store's silence is reported as its own
#                           journal line (`step:unresolved`), not as a refusal.
#   store unreadable     -> ITSELF, unchanged, plus ONE stderr warning per run. A
#                           fact about THIS BOX, never about the lane (#932
#                           discipline). The library being MISSING is the same
#                           class, named separately in the warning.
resolve_lane() { # $1=uuid -> sets RESOLVED_UUID / RESOLVED_FROM / RESOLVE_SKIP
  local uuid="${1:-}" kind lane
  RESOLVED_UUID="$uuid"; RESOLVED_FROM=""; RESOLVE_SKIP=""; RESOLVED_KIND=""
  if [ "${_OC_SESSIONS_MISSING:-0}" = 1 ] || ! command -v oc_sessions_lane >/dev/null 2>&1; then
    # Degrade to EXACTLY today's behaviour, and say so ONCE per run. Silent here
    # would be the #932 shape: a missing library reading as a clean result.
    if [ "${_OC_SESSIONS_WARNED:-0}" != 1 ]; then
      printf 'fanout: WARNING — %s missing or does not define oc_sessions_lane, so child->lane resolution (#192) did NOT run; trailers are notified VERBATIM and a sub-agent trailer will reach no lane (restore tools/lib/oc-sessions.sh)\n' \
        "${_OC_SESSIONS_LIB:-lib/oc-sessions.sh}" >&2
      _OC_SESSIONS_WARNED=1
    fi
    return 0
  fi
  # ONE full read for the whole run: the fan-out walks every contributing session
  # of a ship, and a per-uuid query would be one process per session (1.9k rows on
  # the live box; the whole table is one read, ~0.5 s, paid at most once).
  if [ "${OC_SESSIONS_LOADED:-0}" != 1 ]; then
    if ! oc_sessions_load 2>/dev/null; then
      if [ "${_OC_SESSIONS_WARNED:-0}" != 1 ]; then
        printf 'fanout: WARNING — session store not readable (%s), so child->lane resolution (#192) did NOT run; trailers are notified VERBATIM (OC_SESSIONS_DB overrides the path)\n' \
          "$(oc_sessions_db 2>/dev/null || printf '?')" >&2
        _OC_SESSIONS_WARNED=1
      fi
      return 0
    fi
  fi
  kind="$(oc_sessions_kind "$uuid" 2>/dev/null)"
  case "$kind" in
    'child '*)
      RESOLVED_KIND="child"
      lane="${kind#child }"
      if [ "$lane" = - ]; then
        RESOLVE_SKIP="no-parent"
      else
        RESOLVED_UUID="$lane"; RESOLVED_FROM="$uuid"
      fi ;;
    lane)    RESOLVED_KIND="lane" ;;
    *)       RESOLVED_KIND="unknown" ;;
  esac
  return 0
}

notify_one() { # $1=uuid $2=role $3=title $4=text $5=run -> journals notified|skip|unresolved
  local nrc RETRIES=0 uuid="${1:-}" extra=""
  # (#192) resolve FIRST — before the dry-run branch, so a dry run reports what a
  # real run would do rather than the untranslated trailer.
  resolve_lane "${1:-}"
  uuid="$RESOLVED_UUID"
  if [ -n "$RESOLVE_SKIP" ]; then
    # The address cannot be a lane and there is no lane to walk to. Sending is a
    # guaranteed no-op, so it is NOT sent; the journal and the tally carry the
    # fact instead of a `notified` line that would be a lie (#192).
    jline unresolved 0 "{\"uuid\":\"${1:-}\",\"run\":\"$5\",\"role\":\"$2\",\"reason\":\"$RESOLVE_SKIP\",\"notified\":false}"
    UNRESOLVED=$((${UNRESOLVED:-0}+1))
    return 0
  fi
  # A rewritten address is recorded on the delivery line, so "the LANE was woken
  # on behalf of a child" is auditable from the journal alone rather than
  # inferred from a uuid that appears in no commit of the range.
  [ -n "$RESOLVED_FROM" ] && extra=",\"resolved_from\":\"$RESOLVED_FROM\""
  # The store answered `unknown`: the trailer names no session on this box. It is
  # NOT a skip — the transport owns that verdict (#623 rc 2 `no_route`) — but it
  # IS counted, because a phantom trailer is a defect in the commit, not in the
  # wake, and the tally is where a ship reports it (#192).
  if [ "${RESOLVED_KIND:-}" = unknown ]; then
    jline unresolved 0 "{\"uuid\":\"${1:-}\",\"run\":\"$5\",\"role\":\"$2\",\"reason\":\"not-in-store\",\"notified\":true}"
    UNRESOLVED=$((${UNRESOLVED:-0}+1))
  fi
  if [ "${DRYRUN:-0}" = 1 ]; then
    jline notified 0 "{\"uuid\":\"$uuid\",\"run\":\"$5\",\"role\":\"$2\",\"dry_run\":true$extra}"
    NOTIFIED=$((NOTIFIED+1)); return 0
  fi
  notify_session "$uuid" "$3" "$4"; nrc=$?
  # (#623) Bounded re-send, TRANSIENT codes only. A recovered wake journals the
  # attempt count so a recovery is VISIBLE rather than inferred from silence.
  # (#932 criterion 3) A MISSING LIBRARY is not a transient transport condition: the
  # re-send loop would spend the entire budget (180 s default) re-attempting a file
  # that cannot appear mid-run. Retry only a wake that was actually ATTEMPTED.
  if [ "$nrc" != 0 ] && [ "${_OC_NOTIFY_MISSING:-0}" != 1 ] && _notify_retryable "$nrc" && [ "${NOTIFY_RETRY_BUDGET:-0}" -gt 0 ] 2>/dev/null; then
    local _dl; _dl=$(( $(date +%s) + NOTIFY_RETRY_BUDGET ))
    while [ "$(date +%s)" -lt "$_dl" ]; do
      sleep "${NOTIFY_RETRY_INTERVAL:-15}"
      RETRIES=$((RETRIES+1))
      notify_session "$uuid" "$3" "$4"; nrc=$?
      [ "$nrc" = 0 ] && break
      _notify_retryable "$nrc" || break
    done
    # Distinguish "still failing after every retry the budget allowed" from
    # "failed once". The first is RECOVERABLE (the gateway may bind later; a
    # sweep can re-drive), the second says the destination is unreachable.
    [ "$nrc" != 0 ] && [ "$(date +%s)" -ge "$_dl" ] && BUDGET_EXHAUSTED=1
  fi
  if [ "$nrc" = 0 ]; then
    if [ "$RETRIES" -gt 0 ]; then
      jline notified 0 "{\"uuid\":\"$uuid\",\"run\":\"$5\",\"role\":\"$2\",\"retried\":$RETRIES$extra}"
    else
      jline notified 0 "{\"uuid\":\"$uuid\",\"run\":\"$5\",\"role\":\"$2\"$extra}"
    fi
    NOTIFIED=$((NOTIFIED+1))
  else
    if [ "${BUDGET_EXHAUSTED:-0}" = 1 ]; then
      jline skip 0 "{\"uuid\":\"$uuid\",\"reason\":\"$(_notify_reason "$nrc")\",\"verb_rc\":$nrc,\"retries\":$RETRIES,\"budget_exhausted\":true,\"budget_secs\":$NOTIFY_RETRY_BUDGET$extra}"
      BUDGET_EXHAUSTED=0
    else
      jline skip 0 "{\"uuid\":\"$uuid\",\"reason\":\"$(_notify_reason "$nrc")\",\"verb_rc\":$nrc,\"retries\":$RETRIES$extra}"
    fi
    SKIPPED=$((SKIPPED+1))
  fi
}

attrib_at() { # $1=repo $2=sha $3=file $4=line -> culprit sha (empty if unowned)
  local out
  out="$(git -C "$1" blame -L "$4,$4" --porcelain "$2" -- "$3" 2>/dev/null | head -1 | cut -d' ' -f1)" || return 0
  case "$out" in
    *[!0-9a-f]*|"") return 0 ;;
    *) printf '%s' "$out" ;;
  esac
}

green_leg() { # $1=run id $2=built sha — one notify per contributing session
  local run="$1" bsha="$2" prev feat range rows sessions uuid title text nrc
  prev="$(jq -r '.prev_sha // empty' "$DEPLOYED_META" 2>/dev/null)"
  feat="$(jq -r '.features // "-"' "$DEPLOYED_META" 2>/dev/null)"
  range="${prev:-?}..${bsha}"
  local ATTRIB_RC=0 ATTRIB_OUT="" ATTRIB_ERR ATTRIB_SUM
  # E-F3 (v0.4.96, lens E): single projection shape — call oc-attrib --contributors directly,
  # no private awk copy of the TSV projection (column drift in oc-attrib used to re-break fanout).
  # Duty-4 P-01 (v0.4.133): pass --first-parent so upstream merge ancestry is NOT traversed into
  # historical foreign trailers (prevents falsely waking completed lanes on merge syncs).
  # #407: oc-attrib's stderr carries the novelty-filter accounting (raw/replayed/empty/
  # contributing); it is captured rather than discarded so the journal records WHY a range
  # produced no rows. oc-attrib never exits 0 with rows on stdout when it failed.
  ATTRIB_ERR="$(mktemp)" || die 3 "fanout: cannot create stderr capture for oc-attrib"
  ATTRIB_OUT="$("$ATTRIB" --repo "$REPO_DIR" --deployed --ledger "$LEDGER" --contributors --first-parent 2>"$ATTRIB_ERR")" || ATTRIB_RC=$?
  rows="$ATTRIB_OUT"
  ATTRIB_SUM="$(tr '\n' ' ' < "$ATTRIB_ERR" 2>/dev/null | sed 's/[[:space:]]*$//')"
  rm -f "$ATTRIB_ERR"
  if [ "$ATTRIB_RC" -ne 0 ]; then
    jline contributors 3 "{\"range\":\"$range\",\"rc\":$ATTRIB_RC,\"stderr\":$(printf '%s' "$ATTRIB_SUM" | jq -Rs .)}"
    die 3 "fanout: oc-attrib failed (rc=$ATTRIB_RC) for deployed range $range"
  fi
  # #407: rc 0 with ZERO rows is a legitimate green outcome, not a failure — after the
  # novelty filter an all-replayed / all-empty ship leaves nothing to attribute. The
  # filter summary goes to the journal so "no rows" is auditable as "nothing novel"
  # rather than indistinguishable from a silent attrib breakdown.
  if [ -z "$rows" ]; then
    jline contributors 0 "{\"range\":\"$range\",\"novel\":0,\"stderr\":$(printf '%s' "$ATTRIB_SUM" | jq -Rs .)}"
    echo "fanout green: no novel commits in range $range — nothing to notify"
    return 0
  fi
  sessions="$(printf '%s\n' "$rows" | awk -F'\t' '$1 ~ /^[0-9a-fA-F]{8}-[0-9a-fA-F-]{27}$/ {print $1}' | LC_ALL=C sort -u)"
  jline contributors 0 "{\"range\":\"$range\",\"sessions\":[$(printf '%s\n' "$sessions" | sed '/^$/d' | sed 's/.*/"&"/' | paste -sd, -)]}"
  if [ -z "$sessions" ]; then
    echo "fanout green: no session-attributed commits in $range — nothing to notify"
    return 0
  fi
  title="post-swap: ${bsha:0:8} live"
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    text="oc-fanout: run $run built ${bsha:0:8} is DEPLOYED (features=$feat, range $range). Your commits landed in this ship — please smoke-test your part on the live box. (issue #24 mechanical notify)"
    notify_one "$uuid" contributor "$title" "$text" "$run"
  done <<< "$sessions"
}

red_leg() { # $1=run id $2=run json — RED blame attribution + suspect cc (issue #24)
  local run="$1" runjson="$2"
  local head sha range sites site f l cs culprit cu uuid s title text
  local blamed_json suspect_json suspects cap tot
  head="$(printf '%s' "$runjson" | jq -r '.head_sha // empty')"
  echo "$head" | grep -Eq '^[0-9a-f]{40}$' || die 3 "fanout red: no usable head_sha for run $run"
  git -C "$REPO_DIR" fetch -q "$REMOTE" main 2>/dev/null || true
  git -C "$REPO_DIR" fetch -q "$REMOTE" "$head" 2>/dev/null || true   # PR head shas live off-main
  range="$(git -C "$REPO_DIR" rev-list --first-parent -n 21 "$head" 2>/dev/null | tail -1)" || true
  [ -n "$range" ] || die 3 "fanout red: cannot resolve commit range for $head"
  range="${range}..${head}"
  # sites from check-run annotations (file:line pairs)
  sites="$("$GH" api "repos/$FORK/actions/runs/$run/jobs" 2>/dev/null \
    | jq -r '.jobs[] | select(.conclusion=="failure") | .check_run_url' \
    | while IFS= read -r u; do
        [ -n "$u" ] || continue
        "$GH" api "${u#https://api.github.com/}/annotations" 2>/dev/null || printf '[]'
      done \
    | jq -r '.[]? | "\(.path):\(.start_line)"' 2>/dev/null | LC_ALL=C sort -u)" || true
  if [ -z "$sites" ]; then
    # zero-site fallback: every session in the run range + HUMAN-FLAG
    jline attributed 0 "{\"run\":\"$run\",\"owner\":\"-\",\"blamed\":[],\"suspect\":[],\"fallback\":\"no-sites\"}"
    title="CI RED: run $run — human review needed"
    text="oc-fanout: run $run FAILED with no parseable file:line annotations (HUMAN-FLAG). Sessions active in range ${range:0:19}…: $(git -C "$REPO_DIR" log --format='%b' "$range" 2>/dev/null | grep -Eo '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | LC_ALL=C sort -u | paste -sd' ' -). Blame attribution impossible from annotations — inspect the run manually. (issue #24 mechanical notify)"
    while IFS= read -r uuid; do
      [ -n "$uuid" ] || continue
      notify_one "$uuid" contributor "$title" "$text" "$run"
    done <<< "$(git -C "$REPO_DIR" log --format='%H' "$range" 2>/dev/null | while IFS= read -r cs; do oc_session_trailer "$(git -C "$REPO_DIR" log -1 --format='%B' "$cs" 2>/dev/null)"; done | sed '/^$/d' | LC_ALL=C sort -u)"
    return 0
  fi
  # blame each site at head_sha -> culprit sha -> Session-Id trailer
  blamed_json="{}"; UNOWNED_JSON="[]"
  while IFS= read -r site; do
    [ -n "$site" ] || continue
    f="${site%:*}"; l="${site##*:}"
    culprit="$(attrib_at "$REPO_DIR" "$head" "$f" "$l")"
    if [ -z "$culprit" ]; then
      jline unowned 0 "{\"site\":\"$site\",\"run\":\"$run\"}"
      UNOWNED=$((UNOWNED+1)); continue
    fi
    cu="$(oc_session_trailer "$(git -C "$REPO_DIR" log -1 --format='%B' "$culprit" 2>/dev/null)")"
    if [ -z "$cu" ]; then
      jline unowned 0 "{\"site\":\"$site\",\"run\":\"$run\",\"commit\":\"$culprit\"}"
      UNOWNED=$((UNOWNED+1)); continue
    fi
    blamed_json="$(jq -c --arg u "$cu" --arg s "$site" --arg c "${culprit:0:8}" \
      '.[$u] = ((.[$u] // {sites:[],commits:[]}) | .sites += [$s] | .commits += [$c])' <<< "$blamed_json")"
  done <<< "$sites"
  # suspect cc ON: sessions with OTHER commits touching any blamed file in the run range
  suspect_json="{}"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    suspects="$(git -C "$REPO_DIR" log --format='%H' "$range" -- "$f" 2>/dev/null | while IFS= read -r cs; do
      oc_session_trailer "$(git -C "$REPO_DIR" log -1 --format='%B' "$cs" 2>/dev/null)"
    done | sed '/^$/d' | LC_ALL=C sort -u)"
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      suspect_json="$(jq -c --arg u "$s" --arg f "$f" '.[$u] = ((.[$u] // []) + [$f])' <<< "$suspect_json")"
    done <<< "$suspects"
  done <<< "$(jq -r 'keys[] as $k | (.[$k].sites[] | split(":")[0])' <<< "$blamed_json" 2>/dev/null | LC_ALL=C sort -u)"
  suspect_json="$(jq -c --argjson b "$blamed_json" 'with_entries(.key as $k | select($b | has($k) | not))' <<< "$suspect_json")"
  jline attributed 0 "{\"run\":\"$run\",\"owner\":\"-\",\"blamed\":[$(jq -r 'keys[]' <<< "$blamed_json" | sed 's/.*/"&"/' | paste -sd, -)],\"suspect\":[$(jq -r 'keys[]' <<< "$suspect_json" | sed 's/.*/"&"/' | paste -sd, -)],\"detail\":$blamed_json,\"suspect_files\":$suspect_json}"
  # notify culprits (sites capped at 10 in the message; full list is in the journal)
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    cap="$(jq -r --arg u "$uuid" '.[$u].sites[:10] | join(", ")' <<< "$blamed_json")"
    tot="$(jq -r --arg u "$uuid" '.[$u].sites | length' <<< "$blamed_json")"
    if [ "${tot:-0}" -gt 10 ] 2>/dev/null; then cap="$cap (+$((tot-10)) more — full list in journal)"; fi
    cs="$(jq -r --arg u "$uuid" '.[$u].commits | unique | join(", ")' <<< "$blamed_json")"
    title="CI RED: run $run — your commits are blamed"
    text="oc-fanout: run $run FAILED. git blame at head points at your commit(s) $cs for: $cap. Fix-forward or respond in your lane. (issue #24 mechanical notify)"
    notify_one "$uuid" blamed "$title" "$text" "$run"
  done <<< "$(jq -r 'keys[]' <<< "$blamed_json")"
  while IFS= read -r uuid; do
    [ -n "$uuid" ] || continue
    fs="$(jq -r --arg u "$uuid" '.[$u] | unique | join(", ")' <<< "$suspect_json")"
    title="CI RED: run $run — suspect cc"
    text="oc-fanout: run $run FAILED. Blame points elsewhere, but your commits touched the blamed file(s): $fs. cc only — no action needed unless the culprit is unreachable. (issue #24 mechanical notify)"
    notify_one "$uuid" suspect "$title" "$text" "$run"
  done <<< "$(jq -r 'keys[]' <<< "$suspect_json")"
  return 0
}

fanout_run() { # $1=run id $2=dry-run(0/1)
  local run="${1:-}" runjson status conclusion bsha dep suffix=""
  DRYRUN="${2:-0}"
  [ -n "$run" ] || die 2 "fanout: needs --run <id>"
  echo "$run" | grep -Eq '^[0-9]+$' || die 2 "fanout: run id not numeric: $run"
  fanout_journal_init "$run"
  # issue #42: single-flight flock per run. Advisory lock acquired BEFORE the
  # idempotence guard so guard+deliver+mark are atomic vs. other sweep
  # invocations — a mid-sweep re-run used to pass the guard and re-notify
  # everyone (13:21Z TOCTOU, 12 sessions double-carded). Held on fd 9 through
  # fanout_mark_done; released on process exit on every path (crash-safe,
  # no stale marker, no reaper). exec 9<> = no-truncate open so the holder
  # record survives; flock -n -E 4 = non-blocking, EWOULDBLOCK -> rc 4.
  # Name ENDS in .lock so the state repo's `*.lock` ignore rule matches it.
  # `fanout.lock.$run` ended in the run id and was UN-IGNORABLE by
  # construction: 12 such locks ended up tracked. Every other lock here
  # (LEDGER.lock, host-swap.lock, run/wave-*.lock) ends in .lock.
  local lockfile="$STATE_DIR/fanout.$run.lock"
  # stale-lock reaper (lens D 2026-08-31): holder records pid=; a dead pid +
  # existing file = leftover from a finished fan-out (exit releases flock but
  # intentionally never unlinks — unlink-after-release would let a second
  # process flock a fresh inode and break single-flight). Reap on entry only.
  if [ -f "$lockfile" ]; then
    local stale_pid
    stale_pid="$(grep -o 'pid=[0-9]*' "$lockfile" 2>/dev/null | head -1 | cut -d= -f2)"
    if [ -n "$stale_pid" ] && ! kill -0 "$stale_pid" 2>/dev/null; then
      rm -f "$lockfile"
      jline lock-reaped 0 "{\"run\":\"$run\",\"stale-pid\":\"$stale_pid\"}"
    fi
  fi
  exec 9<>"$lockfile" || die 3 "fanout: cannot open lock $lockfile"
  if ! flock -n -E 4 9; then
    local holder
    holder="$(cat "$lockfile" 2>/dev/null || echo unknown)"
    jline lock-busy 0 "{\"run\":\"$run\",\"holder\":\"$holder\"}"
    echo "fanout-skip run=$run reason=inflight (lock held by $holder)"
    exit 0
  fi
  printf 'pid=%s ts=%s run=%s\n' "$$" "$(date -u +%FT%TZ)" "$run" > "$lockfile"
  jline lock-acquired 0 "{\"run\":\"$run\",\"pid\":$$}"
  # idempotence: a completed fan-out for this run is a no-op
  FANOUT_STATE="$(fanout_state_file)"
  if [ -f "$FANOUT_STATE" ] && jq -e --arg id "$run" '.runs[$id]' "$FANOUT_STATE" >/dev/null 2>&1; then
    jline skip 0 "{\"run\":\"$run\",\"reason\":\"done\"}"
    echo "fanout-skip run=$run reason=done (idempotent)"
    exit 0
  fi
  # (#932) THE CHECKOUT GUARD, AT THE ENTRY — before the network call, because a
  # missing decoder library makes EVERY job name of EVERY run unevaluable, and no
  # retry can fix it. Placed after the idempotence skip (a finished run stays a
  # no-op even on a broken tree) and before `gh api`, so a network blip can never
  # be reported as the cause while the real fault — a broken LOCAL TOOL TREE —
  # goes unnamed. The `success)`-arm backstop below stays as defence in depth.
  if [ "${_OC_EMBED_MISSING:-0}" = 1 ] || ! command -v oc_decode_job_sha_any >/dev/null 2>&1; then
    # (#932) LOUD at entry, FATAL on the success arm. Both halves matter.
    # Loud here: the broken checkout is named on every invocation, before any
    # network call, so a gh blip can never be read as the cause.
    # NOT fatal here: red_leg needs no decoder at all (it reads the jobs list and
    # git blame), so dying at entry would refuse a path that works -- a fix for
    # one arm must not narrow another. The fatal refusal is the success arm below,
    # which is the first point that genuinely needs oc_decode_job_sha_any.
    jline fanout-start 2 "{\"run\":\"$run\",\"warning\":\"built-sha-no-embed-lib\"}"
    printf '%s\n' "$OC_DEPLOY_PROG: WARNING — the embed decoder library is MISSING from this checkout (restore tools/lib/oc-embed.sh). A SUCCESS run will be REFUSED with rc 2 before any job name is evaluated; a RED run still attributes normally (#932)" >&2
  fi
  runjson="$("$GH" api "repos/$FORK/actions/runs/$run" 2>/dev/null)" \
    || { jline fanout-start 3 "{\"run\":\"$run\",\"error\":\"gh-api-fail\"}"; die 3 "fanout: gh api run fetch failed for $run"; }
  status="$(printf '%s' "$runjson" | jq -r '.status // empty')"
  conclusion="$(printf '%s' "$runjson" | jq -r '.conclusion // empty')"
  [ "$status" = completed ] || { jline fanout-start 4 "{\"run\":\"$run\",\"status\":\"$status\"}"; die 4 "fanout: run $run not terminal (status=$status)"; }
  jline fanout-start 0 "{\"run\":\"$run\",\"conclusion\":\"$conclusion\"}"
  NOTIFIED=0; SKIPPED=0; UNOWNED=0
  # (#192) its own counter, never folded into skipped: a SKIP is a transport
  # verdict about a lane (rc 2 no_route, rc 4 transport), an UNRESOLVED is a
  # fact about the ADDRESS — no lane exists to be notified. Collapsing them
  # would hide the defect class this issue is about behind a number that also
  # counts gateway hiccups.
  UNRESOLVED=0
  case "$conclusion" in
    success)
      bsha="$(decode_built_sha "$run")"; dec_rc=$?
      if [ -z "$bsha" ] && [ "$dec_rc" = 2 ]; then
        # (#932) A BROKEN CHECKOUT, not a run fact: the decoder library is not on
        # this tree, so NO job name could be evaluated at all. rc 2 is the
        # "this invocation cannot proceed — fix your side" code, and the run is NOT
        # marked done, so restoring the library and re-running attributes the range.
        # Contrast the two arms below, which are both genuine statements about the
        # run's attribution: rc 5 = the jobs list could not be READ (transient,
        # unmarked, #84) and rc 3 = read and genuinely carries no sha (permanent,
        # marked, #63).
        jline fanout-end 2 "{\"run\":\"$run\",\"error\":\"built-sha-no-embed-lib\"}"
        die 2 "fanout: cannot evaluate ANY job name for run $run — the embed decoder library is missing from this checkout (restore tools/lib/oc-embed.sh; OC_DEPLOY_ENV=missing-embed-lib). This is a broken LOCAL TOOL TREE, not a fact about the run — NOT marked done (#932)"
      fi
      if [ -z "$bsha" ] && [ "$dec_rc" = 5 ]; then
        # (#84) TRANSIENT: the jobs list could not be READ. Marking this done
        # would convert a gh blip into a permanent, silent loss of attribution —
        # the state row satisfies the idempotence guard forever, so the range is
        # never notified and every later RED scan reads it as complete. NOT
        # marked: the next scan retries. Contrast the rc-3 arm below, which IS
        # marked, because "the jobs list was read and carries no sha" is a fact
        # about the run and must not be re-struck forever (#63).
        jline fanout-end 3 "{\"run\":\"$run\",\"error\":\"built-sha-unreadable\"}"
        die 3 "fanout: cannot READ the jobs list for run $run — NOT marked done, the next scan retries (#84)"
      fi
      [ -n "$bsha" ] || { jline fanout-end 3 "{\"run\":\"$run\",\"error\":\"built-sha-decode-fail\",\"cause\":\"undecodable\"}"; fanout_mark_done "$run" "decode-error" 0 0 0; die 3 "fanout: no job name decodes a built sha for run $run (marked decode-error — the run itself carries no sha)"; }   # #63 family (v0.4.79): mark, don't re-strike forever
      dep="$(head -1 "$DEPLOYED" 2>/dev/null || echo none)"
      if [ "$bsha" != "$dep" ]; then
        jline fanout-end 0 "{\"run\":\"$run\",\"reason\":\"not-deployed-yet\",\"built\":\"$bsha\",\"deployed\":\"$dep\"}"
        echo "fanout noop: run $run built ${bsha:0:8} not deployed yet (deployed=${dep:0:8}) — re-run after swap (not marked done)"
        exit 0
      fi
      green_leg "$run" "$bsha"
      ;;
    failure) red_leg "$run" "$runjson" ;;
    *)
      jline fanout-end 0 "{\"run\":\"$run\",\"conclusion\":\"$conclusion\",\"reason\":\"non-build-conclusion\"}"
      echo "fanout noop: run $run conclusion=$conclusion (not success/failure)"
      exit 0
      ;;
  esac
  jline fanout-end 0 "{\"run\":\"$run\",\"notified\":$NOTIFIED,\"skipped\":$SKIPPED,\"unowned\":$UNOWNED,\"unresolved\":$UNRESOLVED}"
  [ "$DRYRUN" = 1 ] || fanout_mark_done "$run" "$conclusion" "$NOTIFIED" "$SKIPPED" "$UNOWNED" "$UNRESOLVED"
  [ "$DRYRUN" = 1 ] && suffix=" (dry-run: not marked done)"
  echo "fanout-end run=$run verdict=$conclusion notified=$NOTIFIED skipped=$SKIPPED unowned=$UNOWNED unresolved=$UNRESOLVED$suffix"
}

# ============================================================================
# main — everything ABOVE defined functions; everything BELOW runs.
# ============================================================================
# SOURCE-SAFE HOOK (the split's one structural addition, and it is one line):
# `OC_DEPLOY_FUNCS_ONLY=1 . oc-fanout` defines the functions above and RETURNS
# here. That is how `oc-build --selftest` gets all four tools' functions into
# ONE shell without re-running a prologue: no second tools-log row, no second
# mirror copy (oc-snap), no second EXIT trap, and no verb executed. A normal
# invocation never sets the variable, so the test is false and `return` never
# runs — this line is inert at runtime.
[ "${OC_DEPLOY_FUNCS_ONLY:-0}" = 1 ] && return 0

set -uo pipefail
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-fanout" "$@"; else oc_log_finish() { :; }; fi
# The shared deploy body: the config surface (state dir, ledger, markers, kill
# files, swap targets) plus every helper more than one stage uses. ONE copy, so
# the four tools cannot drift apart (see the file's own header).
_OC_DEPLOY_LIB="$OC_TOOLS_DIR/lib/oc-deploy-lib.sh"
if [ -f "$_OC_DEPLOY_LIB" ]; then
  . "$_OC_DEPLOY_LIB"
else
  printf 'oc-fanout: %s missing (broken LOCAL TOOL TREE, not a test result)\n' "$_OC_DEPLOY_LIB" >&2
  exit 2   # (#932 discipline) a box fault, never a silent 0 or a bare 127
fi
trap 'oc_log_finish $?' EXIT


# The selftest is ONE suite (tests/deploy-selftest.sh) covering all four stages,
# and it is reachable from every arm: selftest() loads the other tools' functions
# through the hook above. `oc-build --selftest` is the documented spelling.

usage() {
  cat <<'USAGE'
usage: oc-fanout fanout --run R [--dry-run] [--priority low|normal]
                        [--resolve-priority]
       oc-fanout --selftest
       oc-fanout --help

Notify leg of the four-way oc-deploy split (issue #24): mechanical post-CI
notifications, zero LLM. GREEN leg = one notify per contributing session after
a swap; RED leg = blame attribution + suspect cc. Idempotent via fanout.state
(re-run = no-op), single-flight per run (#42), bounded re-send for a TRANSIENT
notify failure (#623). Never resurrects and never reaps a dead uuid (#17).

Exit codes: 0 done/noop | 1 usage | 2 missing decoder library / usage | 3 gh or
attrib fetch fail | 4 run not terminal | 5 jobs list unreadable (transient).
Full contract: tools/docs/RC-CONTRACT.md
USAGE
}

MODE="fanout"
case "${1:-}" in
  fanout)     shift ;;
  --selftest) selftest; exit $? ;;   # #168 cut 5: BARE — the suite takes no argv (a flag here reached `$1`)
  -h|--help)  usage; exit 0 ;;
  '')         : ;;   # no flags: the arm's own validation answers (rc 2)
  -*)         : ;;   # flag-first spelling: `oc-fanout --run R`
  *)          die 1 "unknown arg: $1" ;;
esac
oc_deploy_parse_args "$@"
oc_priority_apply "$PRIORITY"
oc_priority_report
# THE KILL BRAKE MUST PRECEDE CARRIER RESOLUTION (see oc-status's note, #143-bis):
# a carrier read that fails dies 2, masking the documented rc 9 the brake owns.
case "$MODE" in fanout) kill_brake ;; esac
oc_features_resolve

case "$MODE" in
  # ---------------------------------------------------------------- fanout --
  fanout)
    kill_brake
    fanout_run "$RUN_ID" "${DRYRUN:-0}"
    ;;
esac
