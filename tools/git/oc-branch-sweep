#!/usr/bin/env bash
# =============================================================================
# oc-branch-sweep — branch-death proof + archive-then-delete (v0.4.58, Duty-6
# lens C #1: standing HQ duty, zero judgment).
#
# Usage: oc-branch-sweep --repo <path> [--base <branch>] [--dry-run] [--keep RE] [--check-absorbed]
#   Classifies every local branch AND every origin remote head against <base>
#   (default: repo HEAD branch):
#     MERGED   — tip reachable from base  -> DELETE class (history preserved in
#                base; the 21:56Z owner deletion condition is satisfied by
#                reachability). Deletion records tip sha in the TSV (archive).
#     UNSTARTED— the reflog holds nothing but the branch's own creation, i.e.
#                it never received a commit of its own -> report only, NEVER
#                deleted (issue #303). Such a branch is in the merged set only
#                because an ancestor test cannot tell "never committed" from
#                "already landed"; it is a lane that has not started yet.
#     ABSORBED — cherry-detects as already in base (patch-id) -> report only
#                (evaluated only when --check-absorbed is passed to avoid slow O(N) cherry scans).
#     STALE    — no commit in 14+ days, not merged  -> report only.
#     ACTIVE   — everything else                    -> report only.
#   Protected (never delete): base, HEAD branch, anything matching --keep regex
#   (default: 'main|master|carrier|keep|port/').
#
#   REMOTE LEG (Design C Phase 1, #415 step 8): the sweep reads refs/heads/ AND
#   refs/remotes/origin/, so a remote-only head — one that exists on the fork but
#   not in this clone — produces a row instead of being invisible. It is READ AND
#   CLASSIFY ONLY, ALWAYS: no remote row is ever a deletion candidate (every one
#   carries action=report-only, or keep when PROTECTED) and the leg cannot raise
#   the rc. Phase 2 (remote-head disposal) is WITHDRAWN under the ponytail rung-1
#   cut — the tool carries no archive path, and disposing would mean
#   `git push origin --delete` against a SHARED remote. Remote rows are named by
#   their full short ref (origin/<name>), so the TSV schema is unchanged and each
#   row's scope is self-evident. Measured before this leg: 478 origin heads vs
#   378 local branches, 191 (40.0%) invisible — including two of the three #119
#   residue branches the T4 patrol exists to surface.
#
# Exit: 0 nothing deleted/would-delete · 1 deletions performed or pending ·
#       2 usage · 3 git failure.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_DIR="$OC_TOOLS_DIR"
_OC_LIB="$_OC_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-branch-sweep" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

die() { echo "oc-branch-sweep: $2" >&2; exit "$1"; }

cmd_sweep() {
  local repo="" base="" dry=0 check_absorbed=0 keep='main|master|carrier|keep|port/'
  while [ $# -gt 0 ]; do case "$1" in
    --repo) [ $# -ge 2 ] || { echo "oc-branch-sweep: --repo needs a value" >&2; exit 2; }; repo=""$2""; shift 2 ;;
    --base) [ $# -ge 2 ] || { echo "oc-branch-sweep: --base needs a value" >&2; exit 2; }; base=""$2""; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --check-absorbed) check_absorbed=1; shift ;;
    --keep) [ $# -ge 2 ] || { echo "oc-branch-sweep: --keep needs a value" >&2; exit 2; }; keep=""$2""; shift 2 ;;
    -h|--help) echo "usage: oc-branch-sweep --repo <path> [--base b] [--dry-run] [--keep RE] [--check-absorbed]"; echo "Exit: 0 nothing-deleted / 1 deletions / 2 usage / 3 git-fail"; exit 0 ;;  # C-#3: help=0
    --*) die 2 "unknown flag '$1'" ;;
    *) die 2 "unexpected arg '$1'" ;;
  esac; done
  [ -n "$repo" ] || die 2 "usage: oc-branch-sweep --repo <path> [--base b] [--dry-run] [--keep RE] [--check-absorbed]"
  # Duty-6 lens F task 8: fail-open fix — an invalid --keep regex used to fall
  # through to `branch -D` (grep -E dying mid-loop left NOTHING protected).
  # Validate up front; every protect check below then runs on a known-good RE.
  printf '%s' "$keep" | grep -Eq "$keep" 2>/dev/null
  case $? in 0|1) : ;; *) die 2 "invalid --keep regex: '$keep'" ;; esac
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die 2 "not a git repo: $repo"
  [ -n "$base" ] || base="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null)" || base="main"
  git -C "$repo" rev-parse --verify "$base" >/dev/null 2>&1 || die 3 "base branch '$base' not resolvable in $repo"
  local deleted=0
  local head_branch=""
  head_branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || true)"
  local now_ts
  now_ts="$(date +%s)"

  declare -A wt_branches=()
  while IFS= read -r line; do
    case "$line" in
      branch\ refs/heads/*)
        ref="${line#branch refs/heads/}"
        wt_branches["$ref"]=1
        ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain 2>/dev/null)

  # Pre-compute merged branches set in a single fast git query
  declare -A merged_set=()
  while IFS= read -r mb; do
    [ -n "$mb" ] && merged_set["$mb"]=1
  done < <(git -C "$repo" for-each-ref --merged="$base" refs/heads/ --format='%(refname:short)' 2>/dev/null)

  printf 'branch\tclass\ttip\taction\n'
  while IFS=$'\t' read -r b tip committer_ts; do
    [ -n "$b" ] || continue
    local cls action=""
    if [ "$b" = "$base" ] || [ "$b" = "$head_branch" ] || printf '%s' "$b" | grep -Eq "$keep"; then
      cls="PROTECTED"; action="keep"
    elif [ -n "${merged_set[$b]:-}" ]; then
      # UNSTARTED guard (issue #303): a branch whose reflog holds nothing but its
      # own creation never received a commit of its own — it is a lane that has
      # not started yet, and it sits in the merged set only because an ancestor
      # test cannot tell "never committed" from "already landed".
      # Report-only, NEVER archive-deleted.
      #
      # Tip equality is deliberately NOT part of this predicate. A branch is
      # created from the base tip, and the base then moves on as other lanes
      # land work — so by the time a sweep runs, an unstarted branch's tip is
      # usually strictly BEHIND the base tip, not equal to it. Gating on tip
      # equality misses exactly the branches this guard exists to protect
      # (observed live: fix/299 was tip-equal and read UNSTARTED, then main
      # advanced and the same untouched branch flipped back to MERGED).
      #
      # Fallback direction is deliberate: an EMPTY reflog means reflog expiry,
      # which means an old branch, which means no lane is mid-start on it — that
      # case keeps today's MERGED path. A freshly created branch always has a
      # readable reflog, so the hazard cannot hide in the fallback.
      local rl=""
      rl="$(git -C "$repo" reflog show --format='%gs' "refs/heads/$b" 2>/dev/null)"
      if [ -n "$rl" ] && ! grep -qvE '^branch: Created from ' <<< "$rl" ; then
        printf '%s\t%s\t%s\t%s\n' "$b" "UNSTARTED" "$tip" "report-only"
        continue
      fi
      cls="MERGED"
      if [ -n "${wt_branches[$b]:-}" ]; then
        action="held-by-worktree"
      elif [ "$dry" = "1" ]; then
        action="would-delete"
      else
        local err_out
        if err_out="$(git -C "$repo" branch -D "$b" 2>&1)"; then
          action="deleted(tip=$tip archived)"
          # F10 (lens F, v0.4.72): tip sha must survive in the journal, not only in stdout TSV
          oc_log_extra branch-delete "$b@$tip"
        else
          if grep -qiE "used by worktree|checked out at" <<< "$err_out"; then
            action="held-by-worktree"
          else
            action="delete-failed"
          fi
        fi
      fi
      printf '%s\t%s\t%s\t%s\n' "$b" "$cls" "$tip" "$action"
      case "$action" in deleted*|would-delete*) deleted=$((deleted+1)) ;; esac
      continue
    elif [ "$check_absorbed" -eq 1 ] && git -C "$repo" cherry "$base" "$b" >/dev/null 2>&1 && ! git -C "$repo" cherry "$base" "$b" 2>/dev/null | grep -q '^+'; then
      cls="ABSORBED"; action="report-only"
    else
      local last="$committer_ts"
      if [ -n "$last" ] && [ "$last" -gt 0 ] && [ $(( now_ts - last )) -gt $((14*86400)) ]; then cls="STALE"; else cls="ACTIVE"; fi
      action="report-only"
    fi
    printf '%s\t%s\t%s\t%s\n' "$b" "$cls" "$tip" "$action"
  done < <(git -C "$repo" for-each-ref refs/heads/ --format='%(refname:short)%09%(objectname:short)%09%(committerdate:unix)' 2>/dev/null)

  # ---------------------------------------------------------------------------
  # REMOTE LEG (Design C Phase 1, #415 step 8) — READ AND CLASSIFY ONLY.
  #
  # The sweep classified refs/heads/ only, so a remote-only head could never
  # produce a row: measured 478 origin heads vs 378 local branches, 191 (40.0%)
  # invisible, and two of the three #119 residue branches the T4 patrol exists to
  # surface were remote-only. This leg enumerates refs/remotes/origin/ and applies
  # the SAME classification rules, so every remote head gets a row.
  #
  # It performs NO writes and can NEVER raise the rc: Phase 2 (remote-head
  # disposal) is WITHDRAWN under the ponytail rung-1 cut — the tool carries no
  # archive path, and a delete would run `git push origin --delete` against a
  # SHARED remote. Every remote row therefore carries action=report-only (keep
  # when PROTECTED), and `deleted` is not touched here, so the rc stays a
  # statement about LOCAL deletions alone.
  #
  # Rows are named by their full short ref (origin/<name>): the TSV schema is
  # unchanged, and a reader can see at a glance which rows came from the remote.
  # ---------------------------------------------------------------------------
  declare -A rmerged_set=()
  while IFS= read -r mb; do
    [ -n "$mb" ] && rmerged_set["$mb"]=1
  done < <(git -C "$repo" for-each-ref --merged="$base" refs/remotes/origin/ --format='%(refname:short)' 2>/dev/null)

  while IFS=$'\t' read -r rb rtip rcommitter_ts; do
    [ -n "$rb" ] || continue
    # origin/HEAD is a symbolic alias, not a head: reporting it would duplicate
    # whichever branch it points at, and it is not a branch a sweep can act on.
    case "$rb" in */HEAD) continue ;; esac
    local rbare="${rb#origin/}" rcls raction="report-only"
    if [ "$rbare" = "$base" ] || printf '%s' "$rbare" | grep -Eq "$keep"; then
      rcls="PROTECTED"; raction="keep"
    elif [ -n "${rmerged_set[$rb]:-}" ]; then
      # Same UNSTARTED guard as the local leg, read on the remote-tracking
      # reflog. Its fallback direction is the local one's: an unreadable reflog
      # means an old ref, which stays MERGED.
      local rrl=""
      rrl="$(git -C "$repo" reflog show --format='%gs' "refs/remotes/$rb" 2>/dev/null)"
      if [ -n "$rrl" ] && ! grep -qvE '^branch: Created from ' <<< "$rrl" ; then
        rcls="UNSTARTED"
      else
        rcls="MERGED"
      fi
    elif [ "$check_absorbed" -eq 1 ] && git -C "$repo" cherry "$base" "$rb" >/dev/null 2>&1 && ! git -C "$repo" cherry "$base" "$rb" 2>/dev/null | grep -q '^+'; then
      rcls="ABSORBED"
    else
      if [ -n "$rcommitter_ts" ] && [ "$rcommitter_ts" -gt 0 ] && [ $(( now_ts - rcommitter_ts )) -gt $((14*86400)) ]; then rcls="STALE"; else rcls="ACTIVE"; fi
    fi
    printf '%s\t%s\t%s\t%s\n' "$rb" "$rcls" "$rtip" "$raction"
  done < <(git -C "$repo" for-each-ref refs/remotes/origin/ --format='%(refname:short)%09%(objectname:short)%09%(committerdate:unix)' 2>/dev/null)

  oc_log_extra deleted "$deleted"
  [ "$deleted" -eq 0 ] && return 0 || return 1
}

cmd_selftest() {
  export OC_TOOLS_NOLOG=1
  local T P=0 F=0
  T="$(mktemp -d)"
  ok() { P=$((P+1)); }; bad() { F=$((F+1)); echo "  FAIL selftest - $*" >&2; }
  chk() { [ "$2" = "$3" ] && ok || bad "$1 (want $2 got $3)"; }
  git init -q "$T/r" 2>/dev/null
  git -C "$T/r" config user.email t@t; git -C "$T/r" config user.name t
  echo a > "$T/r/f"; git -C "$T/r" add f; git -C "$T/r" commit -q -m "base"
  git -C "$T/r" checkout -qb merged
  echo b > "$T/r/f"; git -C "$T/r" add f; git -C "$T/r" commit -q -m "m1"
  git -C "$T/r" checkout -q master 2>/dev/null || git -C "$T/r" checkout -q main
  git -C "$T/r" merge -q --no-ff -m "merge" merged
  # stale branch: one commit backdated 30 days via env dates
  git -C "$T/r" checkout -qb stale
  GIT_AUTHOR_DATE="$(date -u -d '-30 days' +%Y-%m-%dT%H:%M:%S)" GIT_COMMITTER_DATE="$(date -u -d '-30 days' +%Y-%m-%dT%H:%M:%S)" \
    git -C "$T/r" commit -q --allow-empty -m "old"
  git -C "$T/r" checkout -q master 2>/dev/null || git -C "$T/r" checkout -q main
  local ME="$0"
  bash "$ME" --repo "$T/r" --dry-run > "$T/out.tsv" 2>/dev/null; chk "dry-rc1-would-delete" 1 $?
  grep -q "^merged	MERGED" "$T/out.tsv" && ok || bad "merged-classified"
  grep -q "would-delete" "$T/out.tsv" && ok || bad "dry-no-delete"
  [ "$(git -C "$T/r" branch --list merged | wc -l)" = "1" ]; chk "dry-branch-survives" 0 $?
  grep -q "^stale	STALE" "$T/out.tsv" && ok || bad "stale-classified"
  bash "$ME" --repo "$T/r" > "$T/out2.tsv" 2>/dev/null; chk "real-rc1" 1 $?
  [ -z "$(git -C "$T/r" branch --list merged)" ]; chk "real-branch-deleted" 0 $?
  [ -n "$(git -C "$T/r" branch --list main master)" ]; chk "base-protected" 0 $?
  # clean sweep (nothing left to delete) -> rc 0
  bash "$ME" --repo "$T/r" >/dev/null 2>&1; chk "clean-rc0" 0 $?
  # absorbed branch test with --check-absorbed
  git -C "$T/r" checkout -qb absorbed-feat
  echo absorbed > "$T/r/abs"; git -C "$T/r" add abs; git -C "$T/r" commit -q -m "absorbed commit"
  git -C "$T/r" checkout -q master 2>/dev/null || git -C "$T/r" checkout -q main
  git -C "$T/r" cherry-pick --no-commit absorbed-feat
  git -C "$T/r" commit -q -m "re-applied commit"
  bash "$ME" --repo "$T/r" --check-absorbed > "$T/out-absorbed.tsv" 2>/dev/null
  grep -q "^absorbed-feat	ABSORBED" "$T/out-absorbed.tsv" && ok || bad "absorbed-classified"
  # worktree-held merged branch -> held-by-worktree in both dry-run and real sweep
  git -C "$T/r" checkout -qb wt-merged
  echo c > "$T/r/f"; git -C "$T/r" add f; git -C "$T/r" commit -q -m "m2"
  git -C "$T/r" checkout -q master 2>/dev/null || git -C "$T/r" checkout -q main
  git -C "$T/r" merge -q --no-ff -m "merge wt" wt-merged
  git -C "$T/r" worktree add -q "$T/wt" wt-merged
  bash "$ME" --repo "$T/r" --dry-run > "$T/out-wt-dry.tsv" 2>/dev/null; chk "wt-dry-rc0" 0 $?
  grep -q "^wt-merged	MERGED.*held-by-worktree" "$T/out-wt-dry.tsv" && ok || bad "wt-dry-held-by-worktree"
  bash "$ME" --repo "$T/r" > "$T/out-wt-real.tsv" 2>/dev/null; chk "wt-real-rc0" 0 $?
  grep -q "^wt-merged	MERGED.*held-by-worktree" "$T/out-wt-real.tsv" && ok || bad "wt-real-held-by-worktree"
  ! grep -q "delete-failed" "$T/out-wt-real.tsv" && ok || bad "wt-no-delete-failed"
  [ -n "$(git -C "$T/r" branch --list wt-merged)" ]; chk "wt-branch-survives" 0 $?
  git -C "$T/r" worktree remove -f "$T/wt" 2>/dev/null
  # issue #303: UNSTARTED — a branch whose reflog holds nothing but its own
  # creation never received a commit of its own. It must be report-only and must
  # SURVIVE a real sweep. The reflog is the discriminator, NOT tip equality: an
  # unstarted branch is created from the base tip and the base then moves on, so
  # its tip is usually strictly behind the base by sweep time.
  local BR; BR="$(git -C "$T/r" rev-parse --abbrev-ref HEAD)"
  # a branch whose own commit IS in the base (ff-merged) -> MERGED, not UNSTARTED
  git -C "$T/r" checkout -qb tip-equal-merged
  echo d > "$T/r/g"; git -C "$T/r" add g; git -C "$T/r" commit -q -m "ff commit"
  git -C "$T/r" checkout -q "$BR"
  git -C "$T/r" merge -q --ff-only tip-equal-merged
  local OLDSHA; OLDSHA="$(git -C "$T/r" rev-parse "$BR~1")"
  git -C "$T/r" branch fresh-unstarted "$BR"      # tip == base tip, bare reflog
  git -C "$T/r" branch behind-unstarted "$OLDSHA" # tip BEHIND base tip, bare reflog
  bash "$ME" --repo "$T/r" --dry-run > "$T/out-unstarted.tsv" 2>/dev/null
  grep -q "^fresh-unstarted	UNSTARTED.*report-only" "$T/out-unstarted.tsv" && ok || bad "unstarted-classified"
  ! grep -q "^fresh-unstarted	MERGED" "$T/out-unstarted.tsv" && ok || bad "unstarted-not-MERGED"
  # the load-bearing leg: a bare reflog with a tip BEHIND the base must still be
  # UNSTARTED — gating on tip equality here is the bug this guard exists to fix
  grep -q "^behind-unstarted	UNSTARTED.*report-only" "$T/out-unstarted.tsv" && ok || bad "behind-tip-unstarted-classified"
  ! grep -q "^behind-unstarted	MERGED" "$T/out-unstarted.tsv" && ok || bad "behind-tip-unstarted-not-MERGED"
  grep -q "^tip-equal-merged	MERGED" "$T/out-unstarted.tsv" && ok || bad "tip-equal-with-commits-stays-MERGED"
  # real sweep: the unstarted branches must SURVIVE (the whole point of the guard)
  bash "$ME" --repo "$T/r" > "$T/out-unstarted-real.tsv" 2>/dev/null
  [ -n "$(git -C "$T/r" branch --list fresh-unstarted)" ]; chk "unstarted-survives-real-sweep" 0 $?
  [ -n "$(git -C "$T/r" branch --list behind-unstarted)" ]; chk "behind-tip-unstarted-survives-real-sweep" 0 $?
  grep -q "^fresh-unstarted	UNSTARTED.*report-only" "$T/out-unstarted-real.tsv" && ok || bad "unstarted-real-report-only"
  grep -q "^behind-unstarted	UNSTARTED.*report-only" "$T/out-unstarted-real.tsv" && ok || bad "behind-tip-unstarted-real-report-only"
  # Duty-6 lens F task 8: invalid --keep regex -> rc 2 up front, NOTHING deleted
  git -C "$T/r" checkout -qb doomed
  bash "$ME" --repo "$T/r" --keep '[' >/dev/null 2>&1; chk "bad-keep-rc2" 2 $?
  [ -n "$(git -C "$T/r" branch --list doomed)" ]; chk "bad-keep-no-delete" 0 $?
  # ---------------------------------------------------------------------------
  # #415 Design C step 8: the REMOTE LEG. A head that exists on origin but not in
  # this clone produced no row at all — measured 191 remote-only heads (40.0%)
  # invisible, two of the three #119 residue branches among them. The leg must
  # emit one row per remote head, classify a remote-only branch, and write
  # NOTHING (Phase 2 disposal is withdrawn).
  #
  # The zero-writes assertion is a byte comparison of the REMOTE's own ref list
  # before and after the run — the strongest available form, and taken from the
  # remote rather than from the clone that might have written.
  # ---------------------------------------------------------------------------
  local RR="$T/rr" RREMOTE="$T/remote.git"
  git init -q "$RR" 2>/dev/null
  git -C "$RR" config user.email t@t; git -C "$RR" config user.name t
  echo base > "$RR/f"; git -C "$RR" add f; git -C "$RR" commit -q -m "base"
  local RBASE; RBASE="$(git -C "$RR" symbolic-ref --short HEAD)"
  git init -q --bare "$RREMOTE" 2>/dev/null
  git -C "$RR" remote add origin "$RREMOTE"
  git -C "$RR" push -q origin "HEAD:refs/heads/$RBASE" 2>/dev/null
  # a remote-only head: pushed, then its local branch removed, so origin/romerged
  # exists with no local counterpart. Merged into base first, because the class
  # the T4 patrol needs to see is disposable residue.
  git -C "$RR" checkout -qb romerged
  echo x > "$RR/g"; git -C "$RR" add g; git -C "$RR" commit -q -m "romerged commit"
  git -C "$RR" checkout -q "$RBASE"
  git -C "$RR" merge -q --no-ff -m "merge romerged" romerged
  git -C "$RR" push -q origin "romerged:refs/heads/romerged" 2>/dev/null
  git -C "$RR" branch -qD romerged
  git -C "$RREMOTE" for-each-ref --format='%(refname) %(objectname)' > "$T/rref.before"
  git -C "$RR" for-each-ref refs/heads/ --format='%(refname) %(objectname)' > "$T/lref.before"
  bash "$ME" --repo "$RR" --dry-run > "$T/out-remote.tsv" 2>/dev/null; chk "remote-dry-rc0" 0 $?
  git -C "$RREMOTE" for-each-ref --format='%(refname) %(objectname)' > "$T/rref.after"
  git -C "$RR" for-each-ref refs/heads/ --format='%(refname) %(objectname)' > "$T/lref.after"
  cmp -s "$T/rref.before" "$T/rref.after"; chk "remote-leg-writes-nothing-to-remote" 0 $?
  cmp -s "$T/lref.before" "$T/lref.after"; chk "remote-leg-writes-nothing-to-local" 0 $?
  local RH RN
  RH="$(git -C "$RR" for-each-ref refs/remotes/origin/ --format='%(refname:short)' 2>/dev/null | awk '!/\/HEAD$/{n++} END{print n+0}')"
  RN="$(awk -F'\t' '$1 ~ /^origin\//{n++} END{print n+0}' "$T/out-remote.tsv")"
  chk "remote-one-row-per-head" "$RH" "$RN"
  awk -F'\t' '$1=="origin/romerged" && $2=="MERGED"{f=1} END{exit (f?0:1)}' "$T/out-remote.tsv" && ok || bad "remote-only-classified-MERGED"
  [ -z "$(git -C "$RR" branch --list romerged)" ]; chk "remote-only-has-no-local-branch" 0 $?
  awk -F'\t' '$1 ~ /^origin\// && ($4=="would-delete" || $4=="deleted"){f=1} END{exit (f?1:0)}' "$T/out-remote.tsv" && ok || bad "remote-rows-never-deletion-candidates"
  rm -rf "$T"
  echo "oc-branch-sweep selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]
}

case "${1:-}" in
  --selftest) cmd_selftest; exit $? ;;
esac
cmd_sweep "$@"
