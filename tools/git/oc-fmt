#!/bin/sh
# oc-fmt — format only the Rust files a lane actually touched (host infra)
#
# WHY SCOPED: the repo has 589 formatting diffs across 215 files under the
# edition Cargo.toml declares. A repo-wide sweep would collide with every live
# branch, so lanes format THEIR OWN work and nothing else.
#
# The formatter is /usr/local/bin/rustfmt, pinned to the exact release CI
# installs (Rust 1.100.0 / commit 0ef1bc3860) and verified on every call.
#
# Usage:
#   oc-fmt                  format files changed vs the merge-base with origin/main
#   oc-fmt --check          report diffs only, change nothing (exit 1 if any)
#   oc-fmt --base <ref>     use <ref> instead of origin/main
#   oc-fmt --all            every tracked .rs in the repo (the sweep, not per-lane)
#   oc-fmt <file...>        explicit files (implies explicit scope)
#
# Flags may appear in any position.
#
# REPO COPY (#88, adopted 2026-11-19). The law corpus is versioned; a tool that
# exists only in /usr/local/bin is backed by no repo, so a rebuilt box loses it
# while the law still prescribes it. This file is the source of record and the
# installed copy is the operational one -- restore it with:
#     install -m 0755 tools/git/oc-fmt /usr/local/bin/oc-fmt
# Kept below the usage block on purpose: --help prints lines 2-18 of this file.

set -u

MODE="write"
BASE="origin/main"
SCOPE="changed"
EXPLICIT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE="check"; shift ;;
    --base)  [ $# -ge 2 ] || { echo "oc-fmt: --base needs a value (try --help)" >&2; exit 2; }; BASE="$2"; shift 2 ;;
    --all)   SCOPE="all"; shift ;;
    --selftest) MODE="selftest"; shift ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)      shift; while [ $# -gt 0 ]; do EXPLICIT="$EXPLICIT $1"; SCOPE="explicit"; shift; done ;;
    -*)      echo "oc-fmt: unknown option '$1' (try --help)" >&2; exit 2 ;;
    *)       EXPLICIT="$EXPLICIT $1"; SCOPE="explicit"; shift ;;
  esac
done

# --selftest (#T-8): prove the two base-resolution legs can actually REDDEN.
# The defect this guards was a false clean -- a bogus --base selected nothing and
# exited 0 -- so an arm that only checks "rc 0 on a good base" would have passed
# throughout. Each leg below fails for its own reason, and oc-mutate can mutate
# either one and watch it go red.
if [ "$MODE" = "selftest" ]; then
  _st_fail=0
  _st_ok()  { printf 'selftest: %s OK\n' "$1"; }
  _st_bad() { printf 'selftest: %s FAIL\n' "$1"; _st_fail=$((_st_fail + 1)); }
  _st_repo=$(mktemp -d) || { echo "oc-fmt: selftest cannot mktemp" >&2; exit 2; }
  (
    cd "$_st_repo" || exit 2
    git init -q .
    printf 'fn main() {}\n' > a.rs
    git add a.rs
    git -c user.email=st@t -c user.name=st commit -qm base
  ) >/dev/null 2>&1
  # $0 is RELATIVE when the tool is invoked as ./oc-fmt, and the legs below cd
  # into the fixture repo before re-invoking it -- so a bare $0 resolves to
  # nothing there and EVERY leg fails with rc 127 (measured: exactly this).
  # Resolve to an absolute path first.
  _st_self=$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")
  # LEG 1: an UNRESOLVABLE base is rc 2, never a clean exit. This is the defect.
  ( cd "$_st_repo" && "$_st_self" --base no-such-ref --check >/dev/null 2>&1 )
  [ $? -eq 2 ] && _st_ok "an unresolvable --base exits 2" || _st_bad "an unresolvable --base exits 2"
  # LEG 2: a base that RESOLVES with an empty diff is rc 0 and NAMES the base,
  # so "nothing to do" can never be printed for a ref that was never read.
  _st_out=$( cd "$_st_repo" && "$_st_self" --base HEAD --check 2>&1 )
  _st_rc=$?
  # POSIX sh (dash): no herestrings -- a `case` glob is the portable form.
  case "$_st_out" in *base=HEAD*) _st_named=0 ;; *) _st_named=1 ;; esac
  if [ "$_st_rc" -eq 0 ] && [ "$_st_named" -eq 0 ]; then
    _st_ok "a resolved base with an empty diff exits 0 and names it"
  else
    _st_bad "a resolved base with an empty diff exits 0 and names it"
  fi
  # LEG 3: a real change is still FOUND -- the positive control. Without this a
  # tool that refused everything would pass legs 1 and 2.
  printf 'fn  main( ) {}\n' > "$_st_repo/a.rs"
  ( cd "$_st_repo" && "$_st_self" --base HEAD --check >/dev/null 2>&1 )
  [ $? -eq 1 ] && _st_ok "a changed file is still detected (rc 1)" || _st_bad "a changed file is still detected (rc 1)"
  rm -rf "$_st_repo"
  if [ "$_st_fail" -eq 0 ]; then printf 'selftest OK\n'; exit 0; fi
  printf 'selftest: %s arm(s) failed\n' "$_st_fail" >&2
  exit 1
fi

# rustfmt needs the edition the crate declares, or it cannot parse let-chains.
EDITION=$(grep -m1 '^edition' Cargo.toml 2>/dev/null | sed 's/.*"\(.*\)".*/\1/')
# A wrong edition SKIPS files and reports zero diffs — a false clean — so an
# undetectable edition is a warning, never a silent default.
if [ -z "$EDITION" ]; then
  EDITION=2024
  echo "oc-fmt: WARNING — no 'edition' in ./Cargo.toml; assuming 2024." >&2
  echo "oc-fmt:          a wrong edition SKIPS files and reports zero diffs (false clean)." >&2
fi

case "$SCOPE" in
  all)
    FILES=$(git ls-files '*.rs')
    ;;
  explicit)
    FILES=$(printf '%s\n' $EXPLICIT)
    ;;
  changed)
    # A base that does not RESOLVE is an ERROR, never an empty diff (#T-8).
    # The old form was `MB=$(git merge-base "$BASE" HEAD 2>/dev/null || echo "$BASE")`:
    # a bogus ref made merge-base die rc 128, the fallback substituted that bogus
    # string as if it were a sha, every `git diff` below then failed into
    # `2>/dev/null`, FILES came out empty, and the tool exited 0 "nothing to do".
    # A typo in --base therefore produced a CONFIDENT CLEAN -- the one verdict a
    # formatter must never fabricate.
    #
    # The fallback itself is KEPT and is still correct for the case it was
    # written for: a base that resolves but shares no history with HEAD has no
    # merge-base, and `git diff <that-ref>` is a meaningful tree comparison.
    # Only an UNRESOLVABLE ref is refused, because only that one fabricates a
    # clean from a typo.
    if ! git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null 2>&1; then
      echo "oc-fmt: --base '$BASE' does not resolve to a commit — refusing to report a clean run." >&2
      echo "oc-fmt:   (a bogus base silently selected nothing and exited 0 before #T-8)" >&2
      exit 2
    fi
    MB=$(git merge-base "$BASE" HEAD 2>/dev/null || echo "$BASE")
    FILES=$(
      {
        git diff --name-only --diff-filter=ACMR "$MB" -- '*.rs' 2>/dev/null
        git diff --name-only --diff-filter=ACMR -- '*.rs' 2>/dev/null
        git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 2>/dev/null
        git ls-files --others --exclude-standard -- '*.rs' 2>/dev/null
      } | sort -u
    )
    ;;
esac

FILES=$(printf '%s\n' "${FILES:-}" | grep '\.rs$' || true)

if [ -z "$FILES" ]; then
  echo "oc-fmt: no Rust files in scope (base=$BASE, scope=$SCOPE) — nothing to do"
  exit 0
fi

COUNT=$(printf '%s\n' "$FILES" | wc -l | tr -d ' ')
echo "oc-fmt: $COUNT file(s), edition $EDITION, mode $MODE, scope $SCOPE"

RC=0
FAILED=0
OUT=""

while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ ! -f "$f" ]; then
    echo "oc-fmt: missing file '$f'" >&2
    FAILED=$((FAILED + 1))
    continue
  fi
  if [ "$MODE" = "check" ]; then
    _o=$(rustfmt --check --edition "$EDITION" --config skip_children=true "$f" 2>&1)
    _rc=$?
    [ -n "$_o" ] && OUT="$OUT$_o
"
    [ "$_rc" -ne 0 ] && RC=1
  else
    if ! rustfmt --edition "$EDITION" --config skip_children=true "$f" 2>&1; then
      echo "oc-fmt: FAILED on $f" >&2
      FAILED=$((FAILED + 1))
      RC=1
    fi
  fi
done <<EOF
$FILES
EOF

if [ "$MODE" = "check" ]; then
  if [ -n "$OUT" ]; then
    printf '%s' "$OUT"
    echo "oc-fmt: FORMATTING DIFFS in scope — run 'oc-fmt' to apply" >&2
    RC=1
  else
    echo "oc-fmt: clean — matches the CI formatter in scope"
  fi
else
  if [ "$FAILED" -eq 0 ]; then
    echo "oc-fmt: formatted $COUNT file(s) — review with 'git diff'"
  else
    echo "oc-fmt: $FAILED of $COUNT file(s) FAILED to format" >&2
  fi
fi

exit $RC
