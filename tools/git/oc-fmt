#!/bin/sh
# oc-fmt — format only the Rust files a lane actually touched (host infra)
#
# WHY SCOPED: the repo has 589 formatting diffs across 215 files under the
# edition Cargo.toml declares. A repo-wide sweep would collide with every live
# branch, so lanes format THEIR OWN work and nothing else.
#
# The formatter is /usr/local/bin/rustfmt, pinned to the exact release CI
# installs (Rust 1.100.0 / commit 0ef1bc3860) and verified on every call.
#
# Usage:
#   oc-fmt                  format files changed vs the merge-base with origin/main
#   oc-fmt --check          report diffs only, change nothing (exit 1 if any)
#   oc-fmt --base <ref>     use <ref> instead of origin/main
#   oc-fmt --all            every tracked .rs in the repo (the sweep, not per-lane)
#   oc-fmt <file...>        explicit files (implies explicit scope)
#
# Flags may appear in any position.
#
# REPO COPY (#88, adopted 2026-11-19). The law corpus is versioned; a tool that
# exists only in /usr/local/bin is backed by no repo, so a rebuilt box loses it
# while the law still prescribes it. This file is the source of record and the
# installed copy is the operational one -- restore it with:
#     install -m 0755 tools/git/oc-fmt /usr/local/bin/oc-fmt
# Kept below the usage block on purpose: --help prints lines 2-18 of this file.

set -u

MODE="write"
BASE="origin/main"
SCOPE="changed"
EXPLICIT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE="check"; shift ;;
    --base)  [ $# -ge 2 ] || { echo "oc-fmt: --base needs a value (try --help)" >&2; exit 2; }; BASE="$2"; shift 2 ;;
    --all)   SCOPE="all"; shift ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --)      shift; while [ $# -gt 0 ]; do EXPLICIT="$EXPLICIT $1"; SCOPE="explicit"; shift; done ;;
    -*)      echo "oc-fmt: unknown option '$1' (try --help)" >&2; exit 2 ;;
    *)       EXPLICIT="$EXPLICIT $1"; SCOPE="explicit"; shift ;;
  esac
done

# rustfmt needs the edition the crate declares, or it cannot parse let-chains.
EDITION=$(grep -m1 '^edition' Cargo.toml 2>/dev/null | sed 's/.*"\(.*\)".*/\1/')
# A wrong edition SKIPS files and reports zero diffs — a false clean — so an
# undetectable edition is a warning, never a silent default.
if [ -z "$EDITION" ]; then
  EDITION=2024
  echo "oc-fmt: WARNING — no 'edition' in ./Cargo.toml; assuming 2024." >&2
  echo "oc-fmt:          a wrong edition SKIPS files and reports zero diffs (false clean)." >&2
fi

case "$SCOPE" in
  all)
    FILES=$(git ls-files '*.rs')
    ;;
  explicit)
    FILES=$(printf '%s\n' $EXPLICIT)
    ;;
  changed)
    MB=$(git merge-base "$BASE" HEAD 2>/dev/null || echo "$BASE")
    FILES=$(
      {
        git diff --name-only --diff-filter=ACMR "$MB" -- '*.rs' 2>/dev/null
        git diff --name-only --diff-filter=ACMR -- '*.rs' 2>/dev/null
        git diff --cached --name-only --diff-filter=ACMR -- '*.rs' 2>/dev/null
        git ls-files --others --exclude-standard -- '*.rs' 2>/dev/null
      } | sort -u
    )
    ;;
esac

FILES=$(printf '%s\n' "${FILES:-}" | grep '\.rs$' || true)

if [ -z "$FILES" ]; then
  echo "oc-fmt: no Rust files in scope (base=$BASE, scope=$SCOPE) — nothing to do"
  exit 0
fi

COUNT=$(printf '%s\n' "$FILES" | wc -l | tr -d ' ')
echo "oc-fmt: $COUNT file(s), edition $EDITION, mode $MODE, scope $SCOPE"

RC=0
FAILED=0
OUT=""

while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ ! -f "$f" ]; then
    echo "oc-fmt: missing file '$f'" >&2
    FAILED=$((FAILED + 1))
    continue
  fi
  if [ "$MODE" = "check" ]; then
    _o=$(rustfmt --check --edition "$EDITION" --config skip_children=true "$f" 2>&1)
    _rc=$?
    [ -n "$_o" ] && OUT="$OUT$_o
"
    [ "$_rc" -ne 0 ] && RC=1
  else
    if ! rustfmt --edition "$EDITION" --config skip_children=true "$f" 2>&1; then
      echo "oc-fmt: FAILED on $f" >&2
      FAILED=$((FAILED + 1))
      RC=1
    fi
  fi
done <<EOF
$FILES
EOF

if [ "$MODE" = "check" ]; then
  if [ -n "$OUT" ]; then
    printf '%s' "$OUT"
    echo "oc-fmt: FORMATTING DIFFS in scope — run 'oc-fmt' to apply" >&2
    RC=1
  else
    echo "oc-fmt: clean — matches the CI formatter in scope"
  fi
else
  if [ "$FAILED" -eq 0 ]; then
    echo "oc-fmt: formatted $COUNT file(s) — review with 'git diff'"
  else
    echo "oc-fmt: $FAILED of $COUNT file(s) FAILED to format" >&2
  fi
fi

exit $RC
