#!/usr/bin/env bash
# =============================================================================
# oc-rebase-safety — re-gate split rule tooling (owner GO 14:55Z, ledger n=2259).
#
# LAW (fleet-directives, v0.4.125): a rebase/merge onto a shifted main may skip
# the full re-gate ONLY when (a) ZERO file overlap between the main shift
# (old-main..new-main) and the merge-changed set, AND (b) a clean rebase-diff
# audit. This tool computes both halves. READ-ONLY: git plumbing only — never
# merges, rebases, or writes anything. Exit 1 is a VERDICT, not an error.
#
# Subcommands:
#   oc-rebase-safety overlap --old-main X --new-main Y [--tree PATH]
#       Intersection of `git diff --name-only X Y` (the MAIN SHIFT) with the
#       branch-side changed set. Branch-side set (with --tree): a 2-parent merge
#       => HEAD^2..HEAD; a single-parent HEAD already REBASED onto Y => Y..HEAD
#       (the rebase case, #590); otherwise conservative: the full X..Y set is
#       treated as overlapping. Without --tree the branch-side set is unknown
#       => conservative: any X..Y change = overlap.
#       Exit 0 = zero overlap (gate-skip permitted) / 1 = gate-required.
#   oc-rebase-safety audit --old-tip A --new-tip B [--base C]
#       Per-file patch-id compare of the branch's own changes (C..A) against
#       the rebased result (C..B). C defaults to merge-base(A,B). Patch-ids are
#       computed PER FILE (single diff per file — lesson n=1543: never
#       range-concatenate, the delimiter lines garbage every match).
#       SAME = survived intact (patch-id insensitive to position shifts).
#       CHANGED = patch-id differs (main interleaved, or loss).
#       DROPPED = file changed in C..A but has no change in C..B.
#       Exit 0 = clean (no DROPPED, no CHANGED among A-side files) / 1 = losses.
#
# Output: TSV lines on stdout; human summary on stderr.
# Exit: 0 clean / 1 verdict (overlap or losses) / 2 usage / 3 git failure
# =============================================================================
set -u
set -o pipefail
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-rebase-safety" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

PROG="$(basename "$0")"
die() { echo "$PROG: $2" >&2; exit "$1"; }
usage() { [ $# -gt 0 ] && echo "$PROG: $1" >&2; sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

git_ok() { git -C "$1" rev-parse --verify --quiet "$2^{commit}" >/dev/null 2>&1; }

# --- overlap -----------------------------------------------------------------
cmd_overlap() {
  local old_main="" new_main="" tree=""
  while [ $# -gt 0 ]; do case "$1" in
    --old-main) [ $# -ge 2 ] || { echo "oc-rebase-safety: --old-main needs a value" >&2; usage; exit 2; }; old_main=""$2""; shift 2;;
    --new-main) [ $# -ge 2 ] || { echo "oc-rebase-safety: --new-main needs a value" >&2; usage; exit 2; }; new_main=""$2""; shift 2;;
    --tree) [ $# -ge 2 ] || { echo "oc-rebase-safety: --tree needs a value" >&2; usage; exit 2; };     tree=""$2""; shift 2;;
    *) usage "overlap: unknown arg $1";;
  esac; done
  [ -n "$old_main" ] && [ -n "$new_main" ] || usage "overlap: --old-main and --new-main required"
  local repo="${tree:-.}"
  [ -d "$repo/.git" ] || [ -f "$repo/.git" ] || die 3 "not a git repo: $repo"
  git_ok "$repo" "$old_main" || die 3 "bad --old-main: $old_main"
  git_ok "$repo" "$new_main" || die 3 "bad --new-main: $new_main"

  local tmp_main tmp_merge
  tmp_main="$(mktemp -t ors.main.XXXXXX)" || die 3 "mktemp failed"
  tmp_merge="$(mktemp -t ors.merge.XXXXXX)" || { rm -f "$tmp_main"; die 3 "mktemp failed"; }
  cleanup_tmp() { rm -f "$tmp_main" "$tmp_merge"; }
  trap cleanup_tmp EXIT INT TERM

  # Main-shift changed set: what moved between the two mains.
  git -C "$repo" diff --name-only "$old_main" "$new_main" | sort -u > "$tmp_main" || die 3 "git diff failed"

  # Merge-changed set.
  if [ -z "$tree" ]; then
    # No tree given: merge-changed set unknown -> conservative (any shift in main requires gate).
    cp "$tmp_main" "$tmp_merge"
    local conservative=1
  else
    local nparents tip
    tip="$(git -C "$repo" rev-parse HEAD)" || die 3 "cannot resolve HEAD in $tree"
    nparents="$(git -C "$repo" rev-list --parents -n 1 "$tip" | awk '{print NF-1}')"
    if [ "$nparents" -ge 2 ]; then
      # Second-parent diff = what the BRANCH side contributes over main
      # (verified live: HEAD^1..HEAD is main-side ingress, HEAD^2..HEAD is
      # the branch's own changed set — the one the re-gate law means).
      git -C "$repo" diff --name-only "$tip^2" "$tip" | sort -u > "$tmp_merge" || die 3 "git diff failed"
      conservative=0
    else
      # Single-parent tip. #590 (2026-10-05, toolsmith lane): a REBASED head is
      # single-parent by construction, so it could never take the 2-parent arm
      # and always fell to conservative — where the main-shift set is COPIED and
      # every main-shift file is reported as colliding. `overlap` therefore
      # answered gate-required at ZERO real overlap, and the law's condition (a)
      # was unsatisfiable through this verb in the very case the NON-FF path
      # prescribes (rebase onto a shifted main).
      #
      # For a tip already rebased onto --new-main the branch-side set IS
      # well-defined: new_main..HEAD is exactly what the branch contributes on
      # top of the new main. It is NOT old_main..HEAD — new_main descends from
      # old_main, so that range re-includes the whole main shift and can never
      # read zero (the shape the issue proposed; measured false).
      #
      # Two guards keep this from becoming a false skip, per "a zero is a verdict
      # only from a working instrument":
      #   - new_main must be an ANCESTOR of the tip (the rebase signature). A tree
      #     not rebased onto it does not get the derived read.
      #   - the derived set must be NON-EMPTY. An empty branch-side set means the
      #     instrument cannot speak, so the conservative read stands.
      if git -C "$repo" merge-base --is-ancestor "$new_main" "$tip" 2>/dev/null \
         && git -C "$repo" diff --name-only "$new_main" "$tip" | sort -u > "$tmp_merge" \
         && [ -s "$tmp_merge" ]; then
        conservative=0
      else
        # Not rebased onto --new-main, or nothing to read: conservative (all main changes require gate).
        cp "$tmp_main" "$tmp_merge"
        conservative=1
      fi
    fi
  fi

  local inter
  inter="$(comm -12 "$tmp_main" "$tmp_merge" | grep -v '^$' || true)"
  cleanup_tmp
  trap - EXIT INT TERM
  trap 'oc_log_finish $?' EXIT
  if [ -n "$inter" ]; then
    # #22 (2026-09-12, editor lane 462181e9 report; found first-hand by two
    # lanes): on the conservative path tmp_merge is a COPY of tmp_main, so
    # comm -12 returns the ENTIRE main-shift set — not an intersection. Printing
    # that bare list under a heading that reads as an overlap verdict has now
    # misled two lanes (6630dc9a flagged it; 462181e9 nearly filed a false
    # collision) on a real overlap of ZERO. The logic is correct and stays; the
    # LABEL was the defect. Name the list for what it is and say outright that
    # it is not an intersection. Nothing parses this stdout (the one consumer,
    # oc-deploy, calls `audit`), so the shape is free to change.
    if [ "$conservative" = "1" ]; then
      echo "MAIN-SHIFT (not an overlap — merge-changed set unknown for a single-parent HEAD):"
      echo "$inter" | sed 's/^/  /'
      echo "OVERLAP: gate-required (conservative=1 — the list above is NOT an intersection: every main-shift file is listed because the branch-side set could not be derived)" >&2
    else
      echo "OVERLAP (real intersection of main-shift and branch-side):"
      echo "$inter" | sed 's/^/  /'
      echo "OVERLAP: gate-required (conservative=0 — real intersection)" >&2
    fi
    exit 1
  fi
  echo "OVERLAP: zero — gate-skip permitted (conservative=$conservative)" >&2
  exit 0
}

# --- audit --------------------------------------------------------------------
cmd_audit() {
  local old_tip="" new_tip="" base="" repo=""
  while [ $# -gt 0 ]; do case "$1" in
    --old-tip) [ $# -ge 2 ] || { echo "oc-rebase-safety: --old-tip needs a value" >&2; usage; exit 2; }; old_tip=""$2""; shift 2;;
    --new-tip) [ $# -ge 2 ] || { echo "oc-rebase-safety: --new-tip needs a value" >&2; usage; exit 2; }; new_tip=""$2""; shift 2;;
    --base) [ $# -ge 2 ] || { echo "oc-rebase-safety: --base needs a value" >&2; usage; exit 2; };    base=""$2""; shift 2;;
    --repo) [ $# -ge 2 ] || { echo "oc-rebase-safety: --repo needs a value" >&2; usage; exit 2; };    repo=""$2""; shift 2;;
    *) usage "audit: unknown arg $1";;
  esac; done
  [ -n "$old_tip" ] && [ -n "$new_tip" ] || usage "audit: --old-tip and --new-tip required"
  local repo="${repo:-${OC_REBASE_SAFETY_REPO:-.}}"
  git_ok "$repo" "$old_tip" || die 3 "bad --old-tip: $old_tip"
  git_ok "$repo" "$new_tip" || die 3 "bad --new-tip: $new_tip"
  if [ -z "$base" ]; then
    base="$(git -C "$repo" merge-base "$old_tip" "$new_tip")" || die 3 "merge-base failed"
  else
    git_ok "$repo" "$base" || die 3 "bad --base: $base"
  fi

  # Files the branch touched (C..A).
  git -C "$repo" diff --name-only "$base" "$old_tip" | sort -u > /tmp/ora.a.$$ || die 3 "git diff failed"
  # Files changed in the rebased result (C..B).
  git -C "$repo" diff --name-only "$base" "$new_tip" | sort -u > /tmp/ora.b.$$ || die 3 "git diff failed"

  local rc=0 f pa pb status
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    pa="$(git -C "$repo" diff "$base" "$old_tip" -- "$f" 2>/dev/null | git patch-id --stable | cut -d' ' -f1)"
    if grep -qxF "$f" /tmp/ora.b.$$; then
      pb="$(git -C "$repo" diff "$base" "$new_tip" -- "$f" 2>/dev/null | git patch-id --stable | cut -d' ' -f1)"
      if [ -z "$pa" ] || [ -z "$pb" ]; then
        echo -e "FILE\t$f\tERROR\tpatch-id uncomputable"; rc=1
      elif [ "$pa" = "$pb" ]; then
        echo -e "FILE\t$f\tSAME"
      else
        echo -e "FILE\t$f\tCHANGED\tpatch-id old=$pa new=$pb (main interleaved or loss)"; rc=1
      fi
    else
      echo -e "FILE\t$f\tDROPPED\tchange absent from new tip"; rc=1
    fi
  done < /tmp/ora.a.$$
  rm -f /tmp/ora.a.$$ /tmp/ora.b.$$

  if [ "$rc" -eq 0 ]; then
    echo "AUDIT: clean — no dropped or changed hunks" >&2
  else
    echo "AUDIT: LOSSES FOUND — full re-gate required" >&2
  fi
  exit "$rc"
}

# --- selftest -----------------------------------------------------------------
cmd_selftest() {
  local T; T="$(mktemp -d)"
  trap 'rm -rf "$T"' EXIT
  git -C "$T" init -q -b main repo && cd "$T/repo" || exit 3
  git config user.email t@t; git config user.name t
  echo base > f1.txt; echo base > f2.txt; git add .; git commit -qm base
  local BASE; BASE="$(git rev-parse HEAD)"
  # Branch changes f1 only.
  git checkout -qb feat
  echo feat >> f1.txt; git commit -qam feat1
  local OLD_TIP; OLD_TIP="$(git rev-parse HEAD)"
  # Main changes f2 (disjoint from branch -> zero overlap).
  git checkout -q main
  echo main >> f2.txt; git commit -qam main1
  # Merge preserving topology (like n=2258 b0470589).
  git checkout -q feat
  git merge --no-edit -m merge main >/dev/null 2>&1
  local MERGE_TIP; MERGE_TIP="$(git rev-parse HEAD)"

  local rc=0 t
  # 1. overlap disjoint -> 0
  "$SELF" overlap --old-main "$BASE" --new-main main --tree "$T/repo" >/dev/null 2>&1
  [ $? -eq 0 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-disjoint: $t"
  # 2. main also touches f1 -> overlap -> 1
  git checkout -q main; echo clash >> f1.txt; git commit -q -a -m main2
  git checkout -q feat; git merge --no-edit -m merge2 main >/dev/null 2>&1 || { echo -e "clash\nfeat" > f1.txt; git add f1.txt; git commit -q --no-edit -m merge2-resolved; }
  "$SELF" overlap --old-main "$BASE" --new-main main --tree "$T/repo" >"$T/ov2.out" 2>"$T/ov2.err"
  [ $? -eq 1 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-clash: $t"
  # 2b. the REAL-intersection path must say so and must NOT borrow the
  #     conservative label (#22).
  grep -q '^OVERLAP (real intersection' "$T/ov2.out" && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-real-labelled: $t"
  grep -q 'real intersection' "$T/ov2.err" && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-real-stderr: $t"
  grep -q 'MAIN-SHIFT' "$T/ov2.out" && { t=FAIL; rc=1; } || t=OK; echo "selftest overlap-real-not-main-shift: $t"
  # 3. audit clean: old tip changes survive the CLEAN merge intact
  "$SELF" audit --old-tip "$OLD_TIP" --new-tip "$MERGE_TIP" --base "$BASE" >/dev/null 2>&1
  [ $? -eq 0 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest audit-clean: $t"
  # 4. audit catches a drop: rebuild new tip WITHOUT the branch change
  git checkout -q -B losser "$BASE"
  echo main >> f2.txt; git commit -q -a -m main1b
  "$SELF" audit --old-tip "$OLD_TIP" --new-tip "$(git rev-parse HEAD)" --base "$BASE" >/dev/null 2>&1
  [ $? -eq 1 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest audit-dropped: $t"
  # 5. usage rc 2
  "$SELF" >/dev/null 2>&1
  [ $? -eq 2 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest no-args-usage: $t"
  # 6. CONSERVATIVE path (no --tree => merge-changed set unknown): the printed
  #    list is the MAIN-SHIFT set, NOT an intersection. This is the shape that
  #    misled two lanes on a real overlap of ZERO — the list must be labelled,
  #    and the verdict must say it is not an intersection (#22).
  git checkout -q main
  "$SELF" overlap --old-main "$BASE" --new-main main >"$T/ov6.out" 2>"$T/ov6.err"
  [ $? -eq 1 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-conservative-rc: $t"
  grep -q '^MAIN-SHIFT' "$T/ov6.out" && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-conservative-labelled: $t"
  grep -qi 'NOT an intersection' "$T/ov6.err" && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-conservative-stderr-honest: $t"
  grep -q '^OVERLAP (real' "$T/ov6.out" && { t=FAIL; rc=1; } || t=OK; echo "selftest overlap-conservative-not-called-real: $t"
  # 7. #590: a REBASED single-parent head. Main shift touches f1 only, the branch
  #    f2 only => ZERO real overlap, and the verb MUST read 0. Before the fix this
  #    returned 1 via the conservative copy (the discriminating leg).
  git checkout -q -B rmain "$BASE"; echo rm >> f1.txt; git commit -qam rmain1
  git checkout -q -B reb "$BASE";  echo rb >> f2.txt; git commit -qam reb1
  git rebase -q rmain >/dev/null 2>&1
  "$SELF" overlap --old-main "$BASE" --new-main rmain --tree "$T/repo" >"$T/ov7.out" 2>"$T/ov7.err"
  [ $? -eq 0 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-rebased-disjoint-rc: $t"
  grep -q '^MAIN-SHIFT' "$T/ov7.out" && { t=FAIL; rc=1; } || t=OK; echo "selftest overlap-rebased-not-main-shift: $t"
  # 8. same rebase shape, but the branch ALSO touches f1 => real intersection, rc 1.
  git checkout -q -B rmain2 "$BASE"; echo rm2 >> f1.txt; git commit -qam rmain2a
  git checkout -q -B reb2 "$BASE";   echo rb2 >> f1.txt; git commit -qam reb2a
  git rebase -q rmain2 >/dev/null 2>&1 || { echo resolved >> f1.txt; git add f1.txt; GIT_EDITOR=true git rebase --continue >/dev/null 2>&1; }
  "$SELF" overlap --old-main "$BASE" --new-main rmain2 --tree "$T/repo" >"$T/ov8.out" 2>"$T/ov8.err"
  [ $? -eq 1 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-rebased-clash-rc: $t"
  grep -q '^OVERLAP (real intersection' "$T/ov8.out" && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-rebased-real-labelled: $t"
  # 9. FALSE-SKIP GUARD: a single-parent tip NOT rebased onto --new-main must NOT
  #    get the derived read (HEAD does not contain rmain), so it stays conservative.
  git checkout -q -B plain "$BASE"; echo p >> f2.txt; git commit -qam plain1
  "$SELF" overlap --old-main "$BASE" --new-main rmain --tree "$T/repo" >"$T/ov9.out" 2>/dev/null
  [ $? -eq 1 ] && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-unrebased-conservative-rc: $t"
  grep -q '^MAIN-SHIFT' "$T/ov9.out" && t=OK || { t=FAIL; rc=1; }; echo "selftest overlap-unrebased-labelled: $t"

  [ "$rc" -eq 0 ] && echo "selftest: 18/18 OK" >&2 || echo "selftest: FAILURES" >&2
  exit "$rc"
}

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
case "${1:-}" in
  overlap)  shift; cmd_overlap "$@";;
  audit)    shift; cmd_audit "$@";;
  --help|-h|help) sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
  --selftest) cmd_selftest;;
  *) usage;;
esac
