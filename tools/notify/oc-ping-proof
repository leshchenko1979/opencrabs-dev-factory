#!/usr/bin/env bash
# =============================================================================
# oc-ping-proof — B25: report-only roster-ping verification against
# workers-ledger.json. UNREACHABLE if the uuid is not on the roster; else
# WOKEN when the worker's last_acked.at or any event at >= ping-ts, SILENT
# otherwise. Bare HH:MMZ stamps are normalized to today (UTC) before compare
# (the ledger mixes ISO and bare-HH:MM formats). Zero side effects.
#
# Usage:
#   oc-ping-proof <uuid> <ping-ts> [--ledger <file>] | --selftest
#
# Exit codes: 0 WOKEN · 1 SILENT · 2 usage · 3 UNREACHABLE · 4 parse failure
# Env: OC_TOOLS_LOG
# Output: verdict line on stdout ("WOKEN|SILENT|UNREACHABLE <uuid>");
#         evidence (matched stamp) on stderr.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-ping-proof" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

usage() { echo "usage: $0 <uuid> <ping-ts> [--ledger <file>] | --selftest" >&2; exit 2; }

# to_epoch <stamp> -> epoch seconds on stdout (rc 0), rc 1 unparseable.
to_epoch() {
  local s="$1" d e
  case "$s" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) d="$s" ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]Z)        d="$s" ;;
    [0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) d="$(date -u +%Y-%m-%d) ${s%Z}" ;;
    [0-9][0-9]:[0-9][0-9]Z)            d="$(date -u +%Y-%m-%d) ${s%Z}" ;;
    *) return 1 ;;
  esac
  e="$(date -u -d "$d" +%s 2>/dev/null)"
  [ -n "$e" ] || return 1
  printf '%s' "$e"
}

[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { echo "usage: oc-ping-proof <uuid> <ping-ts> [--ledger <file>]"; echo "Exit: 0 WOKEN / 1 SILENT / 2 usage / 3 UNREACHABLE / 4 parse failure"; exit 0; }  # C-#3: help=0
if [ "${1:-}" = "--selftest" ]; then
  d="$(mktemp -d)" || exit 3
  trap '_rc=$?; rm -rf "$d"; oc_log_finish "$_rc"' EXIT
  cat > "$d/wl.json" <<'JSON'
{"workers":[
  {"uuid":"u-woke","role":"editor","last_acked":{"version":"0.4.15","at":"21:05Z"},"events":[{"at":"2026-08-28T10:00Z"}]},
  {"uuid":"u-silent","role":"editor","last_acked":{"version":"0.4.15","at":"2026-08-20T10:00Z"},"events":[{"at":"2026-08-20T10:00Z"}]},
  {"uuid":"u-event","role":"editor","events":[{"at":"2026-08-28T12:00Z"}]}
],"events":[]}
JSON
  "$0" u-woke 2026-08-28T11:00Z --ledger "$d/wl.json" >/dev/null 2>&1; [ $? -eq 0 ] || { echo "selftest: u-woke not WOKEN" >&2; exit 1; }
  "$0" u-silent 2026-08-21T00:00Z --ledger "$d/wl.json" >/dev/null 2>&1; [ $? -eq 1 ] || { echo "selftest: u-silent not SILENT" >&2; exit 1; }
  "$0" u-event 2026-08-28T11:00Z --ledger "$d/wl.json" >/dev/null 2>&1; [ $? -eq 0 ] || { echo "selftest: u-event (event-only) not WOKEN" >&2; exit 1; }
  "$0" u-nope 2026-08-28T11:00Z --ledger "$d/wl.json" >/dev/null 2>&1; [ $? -eq 3 ] || { echo "selftest: u-nope not UNREACHABLE" >&2; exit 1; }
  "$0" u-silent not-a-ts --ledger "$d/wl.json" >/dev/null 2>&1; [ $? -eq 4 ] || { echo "selftest: bad ping-ts != 4" >&2; exit 1; }
  "$0" >/dev/null 2>&1; [ $? -eq 2 ] || { echo "selftest: no args != 2" >&2; exit 1; }
  echo "selftest OK"; exit 0
fi

[ $# -ge 2 ] || usage
UUID="$1"; TS="$2"; shift 2
LEDGER="$(oc_ledger_path)"   # canonical default; --ledger below still overrides
while [ $# -gt 0 ]; do
  case "$1" in
    --ledger) LEDGER="${2:-}"; shift ;;
    *) usage ;;
  esac
  shift
done
echo "$UUID" | grep -Eq '^[^[:space:]]+$' || usage
PING="$(to_epoch "$TS")" || { echo "unparseable ping-ts: $TS" >&2; exit 4; }
jq -e --arg u "$UUID" '.workers[] | select(.uuid==$u)' "$LEDGER" >/dev/null 2>&1 \
  || { echo "UNREACHABLE $UUID"; exit 3; }

STAMPS="$(jq -r --arg u "$UUID" '.workers[] | select(.uuid==$u) | [.last_acked.at // empty, (.events[]? | select(type=="object") | .at // empty)] | .[]' "$LEDGER" 2>/dev/null)"
[ -n "$STAMPS" ] || { echo "SILENT $UUID (no timestamps on roster entry)"; exit 1; }

WOKEN=0; EVID=""
while IFS= read -r st; do
  [ -n "$st" ] || continue
  EP="$(to_epoch "$st")" || { echo "oc-ping-proof: skipping unparseable worker stamp: $st" >&2; continue; }   # lens F MED (v0.4.79): one bad stamp must not kill the probe
  if [ "$EP" -ge "$PING" ]; then WOKEN=1; EVID="$st"; break; fi
done <<EOF
$STAMPS
EOF

if [ "$WOKEN" -eq 1 ]; then
  echo "WOKEN $UUID"
  echo "evidence: stamp $EVID >= ping $TS" >&2
  exit 0
fi
echo "SILENT $UUID"
exit 1