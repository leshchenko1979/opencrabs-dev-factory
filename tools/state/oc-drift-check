#!/usr/bin/env bash
# =============================================================================
# oc-drift-check — editor skill-drift ritual, mechanical (v0.4.58, Duty-6 lens C
# #4: highest-frequency editor ritual was in HQ's head + prose).
#
# Usage: oc-drift-check <uuid> [<claimed-version>] [--ack] [--skill-dir <path>]
#   Compares the version a lane claimed at task-claim time against the LIVE
#   SKILL.md (editor.md §Mid-cycle skill drift step 1-2). --ack delegates the
#   oc-ledger ack so the re-read is mechanically recorded — on BOTH verdicts,
#   including the no-drift one every compliant reload actually hits (fixed
#   2026-09-11; it previously fired only on DRIFT, so a lane that ran the
#   prescribed ritual on a clean tree recorded nothing and its roster
#   last_acked went stale).
#
# Skill-dir resolution (v0.4.130, ruling n=2369): --skill-dir flag >
# OC_SKILL_DIR env > CANONICAL profile copy
# ($HOME/.opencrabs/profiles/ops/skills/opencrabs-dev). The invoking script's
# own location is NEVER resolved — worktree copies of the skill repo must not
# self-resolve (produced contradicting drift verdicts same-day, 2026-09-10).
#
# Omit-arg mode (D-5, HQ d72bd52d, 2026-09-13): with NO claimed-version the
#   comparison is made against the lane's RECORDED last_acked (roster, written
#   by `oc-ledger ack`) instead of argv. Passing the LIVE version as `claimed`
#   — which is what every RELOAD brief did — makes the verdict an ARGV ECHO:
#   argv == live BY CONSTRUCTION, so it always prints NO-DRIFT and the sensor
#   can never fire on the invocation the brief prescribes. Omit-arg makes the
#   verdict a pure function of state on disk (Reviewer J lens). A lane with NO
#   last_acked recorded gets NO-HISTORY (rc 1, same required action as DRIFT),
#   NEVER NO-DRIFT — a lane with no history must not read as compliant.
#
# Source naming (F, fork #447): every verdict names the SOURCE of both sides.
#   The live side is the ON-DISK skill file (its path is printed); the claimed
#   side is argv (legacy form) or the ledger roster's last_acked (omit-arg). The
#   on-disk read is correct by design — an author's frontmatter edit is
#   fleet-visible before any commit or sync — but the verdict never SAID so, so
#   "acked version > ledger version" read as lane misbehaviour when it is an
#   AUTHOR-WINDOW artifact (v0.4.217: acks n=9474/9475/9477/9478 named 0.4.217
#   while the last skill-bump event was n=9462 at 0.4.216; lane d18ce16a was
#   exonerated retroactively). When the on-disk version has NO matching
#   skill-bump ledger event the verdict carries an explicit note saying so —
#   advisory only: it never changes the verdict or the rc, and a ledger that
#   cannot be read leaves the note silent rather than inventing one.
#
# Exit: 0 no-drift (proceed under current rules) · 1 DRIFT (re-read required;
#       ack stamped when --ack) · 2 usage · 3 ledger/skill-dir failure.
# Env:  OC_ACTOR, OC_LEDGER, OC_SKILL_DIR (overrides canonical default).
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_DIR="$OC_TOOLS_DIR"
_OC_LIB="$_OC_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-drift-check" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

SKILL_DIR=""   # resolved in cmd_drift (v0.4.130 canonical-resolve, below)
LEDGER="$(oc_ledger_path)"
# v0.4.130 (ruling n=2369): canonical skill dir. Worktree copies of the skill
# repo (oc-wt checkouts) self-resolving from their own tree produced
# contradicting drift verdicts same-day (2026-09-10) — the default is now the
# CANONICAL profile copy, never the invoking script's location. Explicit
# override wins: --skill-dir flag / OC_SKILL_DIR env (selftests, sandboxes).
CANONICAL_SKILL="$HOME/.opencrabs/profiles/ops/skills/opencrabs-dev"

die() { echo "oc-drift-check: $2" >&2; exit "$1"; }

cmd_drift() {
  local uuid="" claimed="" ack=0 skill_dir_flag=""
  while [ $# -gt 0 ]; do case "$1" in
    --ack) ack=1; shift ;;
    --skill-dir) [ $# -ge 2 ] || { echo "oc-drift-check: --skill-dir needs a value" >&2; exit 2; }; skill_dir_flag=""$2""; shift 2 ;;
    -h|--help) echo "usage: oc-drift-check <uuid> [<claimed-version>] [--ack] [--skill-dir <path>]"; echo "Omit <claimed-version> to compare the lane's RECORDED last_acked (roster) instead of argv — no argv echo."; echo "Exit: 0 no-drift / 1 DRIFT or NO-HISTORY / 2 usage / 3 ledger-or-skilldir-fail"; exit 0 ;;  # C-#3: help=0
    --*) die 2 "unknown flag '$1'" ;;
    *) if [ -z "$uuid" ]; then uuid="$1"; elif [ -z "$claimed" ]; then claimed="$1"; fi; shift ;;
  esac; done
  [ -n "$uuid" ] || die 2 "usage: oc-drift-check <uuid> [<claimed-version>] [--ack] [--skill-dir <path>]"
  if [ -n "$claimed" ]; then
    printf '%s' "$claimed" | grep -Eq '^v?0\.[0-9]+\.[0-9]+$' || die 2 "claimed-version must be [v]0.N.N, got '$claimed'"
  fi
  # v0.4.130 canonical-resolve (ruling n=2369): precedence = --skill-dir flag >
  # OC_SKILL_DIR env > CANONICAL profile copy. The invoking script's own location
  # is NEVER used — a worktree copy must not self-resolve (contradicting
  # same-day drift verdicts, 2026-09-10).
  if [ -n "$skill_dir_flag" ]; then
    SKILL_DIR="$skill_dir_flag"
  elif [ -n "${OC_SKILL_DIR:-}" ]; then
    SKILL_DIR="$OC_SKILL_DIR"
  else
    SKILL_DIR="$CANONICAL_SKILL"
  fi
  local cur live_src
  cur="$(grep -E '^version:' "$SKILL_DIR/SKILL.md" 2>/dev/null | head -1 | awk '{print $2}')"
  [ -n "$cur" ] || die 3 "cannot read version from $SKILL_DIR/SKILL.md"
  # F (fork #447): NAME THE SOURCE OF EACH SIDE. The live side is read from the
  # ON-DISK skill file and never from the ledger — correct by design (an author's
  # frontmatter edit is fleet-visible before any commit or sync), but the verdict
  # never said so, so "acked version > ledger version" read as lane misbehaviour
  # when it is an author-window artifact. Path is printed, not just named: the
  # skill dir is overridable (--skill-dir / OC_SKILL_DIR), so "on-disk" alone
  # would not say WHICH file was read.
  live_src="on-disk skill file $SKILL_DIR/SKILL.md"
  # Omit-arg mode (D-5, HQ d72bd52d, 2026-09-13): no argv version means there
  # is nothing to echo — read the lane's RECORDED last_acked from the roster
  # and compare THAT to live. Reviewer J: the verdict must be a pure function
  # of state on disk, never of the caller's own argument. Emitting the live
  # version (what every RELOAD brief did) made it vacuous BY CONSTRUCTION:
  # argv == live always, so NO-DRIFT always, and the sensor could not fire on
  # the exact invocation the brief prescribes. The roster read goes through
  # oc-ledger (the schema owner) rather than re-implementing the ledger shape.
  local claimed_bare="" claimed_src="argv" no_history=0
  if [ -n "$claimed" ]; then
    claimed_bare="${claimed#v}"
  else
    local rj rrc acked
    claimed_src="ledger roster last_acked"
    rj="$(OC_LEDGER="$LEDGER" "$_OC_DIR/state/oc-ledger" roster --json 2>/dev/null)"; rrc=$?
    [ "$rrc" -eq 0 ] || die 3 "omit-arg mode: cannot read the roster (oc-ledger roster rc=$rrc, ledger=$LEDGER)"
    acked="$(printf '%s' "$rj" | jq -r --arg u "$uuid" \
      '.[] | select(.uuid==$u) | (.last_acked | if type=="object" then (.version // "") else (. // "") end)' 2>/dev/null | head -1)"
    # The roster's --json projection renders an ABSENT last_acked as the sentinel
    # "-" (its own display convention for empty), NOT as null — verified live
    # 2026-09-13. Reading that as a version prints a confusing
    # "DRIFT: claimed - != live <cur>" for a lane that never claimed anything, so
    # "-" and empty BOTH mean no record. (A version is always 0.N.N, so the
    # sentinel is unambiguous.)
    case "$acked" in
      ""|-)
        # NO-HISTORY is its OWN verdict, never folded into NO-DRIFT: a lane with
        # no record currently gets NO-DRIFT (the defect HQ reproduced on a
        # synthetic uuid), which reads as compliance evidence it never earned.
        no_history=1 ;;
      *)
        claimed_bare="${acked#v}" ;;
    esac
  fi
  # F (fork #447): ADVISORY bump-state lookup — does the ledger carry a
  # skill-bump event for the version read off disk? It does NOT when an author
  # has written a new version into frontmatter and not yet synced, and in that
  # window every lane's ack naming that version reads as "ahead of the ledger"
  # i.e. as lane misbehaviour (the v0.4.217 misattribution). Lookup shape is
  # chosen so the THREE rc meanings stay distinguishable — the tool's own rc
  # contract, read live 2026-09-20:
  #   rc 0 -> JSON array on stdout (match present or absent, both authoritative)
  #   rc 1 -> NO-MATCH verdict, empty stdout: no skill-bump events exist at all,
  #           so the on-disk version provably has none -> absent
  #   rc 3 -> ledger missing/unparseable -> UNKNOWN, and the note stays SILENT
  #           (absence of evidence must not be rendered as evidence)
  # The lookup never touches rc or the verdict; it only decides whether a NOTE
  # line is printed. `what` is written by oc-ledger sync as "v<version> — <text>"
  # (tools/state/oc-ledger cmd_sync), so the version is matched as a "v<ver> " PREFIX
  # rather than a substring — a substring test would let v0.4.2 match v0.4.20.
  local bump_state="unknown"
  if [ "$no_history" = "0" ]; then
    local bj brc
    bj="$(OC_LEDGER="$LEDGER" "$_OC_DIR/state/oc-ledger" events --kind skill-bump --n 20 --json 2>/dev/null)"; brc=$?
    case "$brc" in
      0) if printf '%s' "$bj" | jq -e --arg p "v$cur " 'any(.[]; (.what // "") | startswith($p))' >/dev/null 2>&1; then
           bump_state="present"
         else
           bump_state="absent"
         fi ;;
      1) bump_state="absent" ;;
      *) bump_state="unknown" ;;
    esac
  fi
  local bump_note=""
  if [ "$bump_state" = "absent" ]; then
    bump_note="NOTE: no skill-bump ledger event for $cur — the on-disk version is ahead of the last sync (author window); advisory only, verdict unchanged"
  fi
  # --ack stamps on BOTH paths (defect fix 2026-09-11, lanes d18ce16a + a5b34466).
  # This block used to sit AFTER the no-drift early return, so --ack fired ONLY on
  # DRIFT — the inverse of the promise in the header and of every RELOAD brief,
  # which prescribes `oc-drift-check <uuid> <live-version> --ack`. A lane that
  # complied on a clean tree (the COMMON case) recorded NOTHING: roster last_acked
  # went stale (two lanes independently observed theirs ~a day behind across
  # several reloads) and version-compliance reads were unreliable. Mechanical
  # recording has to cover the invocation the brief actually prescribes.
  if [ "$ack" = "1" ]; then
    OC_LEDGER="$LEDGER" OC_SKILL_DIR="$SKILL_DIR" "$_OC_DIR/state/oc-ledger" ack "$uuid" "$cur" || die 3 "ack failed (oc-ledger rc=$?)"
    echo "ack stamped for $uuid at $cur"
    # #560: the verdict below must describe the state this command LEAVES, not
    # the one it found. claimed_bare was read from the roster BEFORE the ack, so
    # printing it afterwards produced "ack stamped ... at <cur>" immediately
    # followed by "DRIFT: claimed <old> != live <cur>" in the same run -- a
    # durable drift claim that the ack had just cleared, and one a lane quoting
    # its own output would record as fact. Both the stale version AND the
    # no-history flag are superseded by the ack that just landed.
    claimed_bare="$cur"
    claimed_src="ack stamped this run"
    no_history=0
  fi
  if [ "$no_history" = "1" ]; then
    echo "NO-HISTORY: no last_acked recorded for $uuid (claimed side: $claimed_src) — treat as DRIFT, re-read SKILL.md + editor.md IN FULL before next phase boundary"
    echo "  live side: $cur from $live_src"
    if [ -n "$bump_note" ]; then echo "$bump_note"; fi
    oc_log_extra verdict NO-HISTORY
    return 1
  fi
  if [ "$claimed_bare" = "$cur" ]; then
    echo "NO-DRIFT: claimed $claimed_bare (claimed side: $claimed_src) == live $cur (live side: $live_src)"
    if [ -n "$bump_note" ]; then echo "$bump_note"; fi
    oc_log_extra verdict NO-DRIFT; return 0
  fi
  echo "DRIFT: claimed $claimed_bare (claimed side: $claimed_src) != live $cur (live side: $live_src) — re-read SKILL.md + editor.md IN FULL before next phase boundary"
  if [ -n "$bump_note" ]; then echo "$bump_note"; fi
  oc_log_extra verdict DRIFT
  return 1
}

cmd_selftest() {
  export OC_TOOLS_NOLOG=1
  local T P=0 F=0
  T="$(mktemp -d)"
  ok() { P=$((P+1)); }; bad() { F=$((F+1)); echo "  FAIL selftest - $*" >&2; }
  chk() { [ "$2" = "$3" ] && ok || bad "$1 (want $2 got $3)"; }
  mkdir -p "$T/skill/tools/tests"
  cat > "$T/state-ledger.json" <<EOF
{"current_skill_version":"0.4.58","updated_at":"2026-01-01T00:00:00Z","workers":[
 {"uuid":"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee","role":"tester","topic_id":1,"feature":"-","confirmed":true,"last_acked":null,"notes":[],"events":[]}],"events":[]}
EOF
  printf 'name: fixture\nversion: 0.4.58\n---\n' > "$T/skill/SKILL.md"
  git -C "$T" init -q 2>/dev/null
  local ME="$0"
  bash "$ME" u1 0.4.58 --skill-dir "$T/skill" >/dev/null 2>&1; chk "no-drift-rc0" 0 $?
  bash "$ME" u1 v0.4.58 --skill-dir "$T/skill" >/dev/null 2>&1; chk "v-prefix-rc0" 0 $?
  bash "$ME" u1 0.4.57 --skill-dir "$T/skill" >/dev/null 2>&1; chk "drift-rc1" 1 $?
  bash "$ME" u1 0.4 --skill-dir "$T/skill" >/dev/null 2>&1; chk "bad-shape-rc2" 2 $?
  # D-5: a call with NO uuid is still a usage error. (This assertion used to be
  # `bash "$ME" u1 --skill-dir ...` — it encoded "no claimed-version == usage
  # error", which IS the behaviour D-5 changes: a uuid with no version is now
  # a legitimate read-only check against the lane's RECORDED last_acked. The
  # expectation is unchanged (rc 2); the PREMISE that made it true was the bug.)
  bash "$ME" --skill-dir "$T/skill" >/dev/null 2>&1; chk "usage-rc2" 2 $?
  # v0.4.130 canonical-resolve (ruling n=2369): explicit overrides still win.
  chk "env-override-respected" 0 "$(OC_SKILL_DIR="$T/skill" bash "$ME" u1 0.4.58 >/dev/null 2>&1; echo $?)"
  chk "env-override-drift-rc1" 1 "$(OC_SKILL_DIR="$T/skill" bash "$ME" u1 0.4.57 >/dev/null 2>&1; echo $?)"
  # canonical default (NO --skill-dir, NO env): resolves the CANONICAL profile
  # copy, never the invoking script's location. Invoking the FIXTURE copy with
  # no overrides must read the canonical SKILL.md version, not the fixture's.
  CANON_VER="$(grep -E '^version:' "$HOME/.opencrabs/profiles/ops/skills/opencrabs-dev/SKILL.md" 2>/dev/null | head -1 | awk '{print $2}')"
  if [ -n "$CANON_VER" ]; then
    # fixture claims 0.4.57 — vs canonical (0.4.129+) that is DRIFT rc1;
    # canonical-resolve proven by the verdict depending on $CANON_VER, not the
    # fixture's own 0.4.58 (self-resolve would return rc0 here).
    chk "canonical-default-not-self-resolved" 1 "$(bash "$ME" u1 0.4.57 >/dev/null 2>&1; echo $?)"
  else
    bad "canonical-default: cannot read canonical SKILL.md (skipped live check)"
  fi
  # --ack: drift case delegates to oc-ledger ack against fixture ledger
  OC_LEDGER="$T/state-ledger.json" OC_DEPLOY_STATE_DIR="$T" bash "$ME" aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee 0.4.57 --ack --skill-dir "$T/skill" >/dev/null 2>&1
  chk "drift-ack-stamped" "0.4.58" "$(jq -r '.workers[] | select(.uuid=="aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee") | .last_acked.version // "none"' "$T/state-ledger.json")"
  # --ack must ALSO stamp on the NO-DRIFT path (defect fix 2026-09-11, lanes
  # d18ce16a + a5b34466). The ack block sat AFTER the no-drift early return, so
  # the exact invocation every RELOAD brief prescribes — run on a clean tree,
  # which is the common case — recorded nothing and roster last_acked went
  # stale. Reset last_acked, run no-drift WITH --ack, assert it landed AND the
  # verdict is still rc 0 (the fix must not turn a clean tree into a failure).
  jq '.workers[0].last_acked = null' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  chk "no-drift-ack-precondition" "none" "$(jq -r '.workers[0].last_acked.version // "none"' "$T/state-ledger.json")"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" OC_DEPLOY_STATE_DIR="$T" bash "$ME" aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee 0.4.58 --ack --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "no-drift-ack-rc0" 0 "$RC"
  case "$OUT" in *"NO-DRIFT"*) ND=yes ;; *) ND=no ;; esac
  chk "no-drift-ack-verdict" "yes" "$ND"
  case "$OUT" in *"ack stamped for aaaaaaaa"*) AS=yes ;; *) AS=no ;; esac
  chk "no-drift-ack-message" "yes" "$AS"
  chk "no-drift-ack-stamped" "0.4.58" "$(jq -r '.workers[] | select(.uuid=="aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee") | .last_acked.version // "none"' "$T/state-ledger.json")"
  # and WITHOUT --ack the no-drift path must stay a pure read (no ledger write)
  jq '.workers[0].last_acked = null' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OC_LEDGER="$T/state-ledger.json" OC_DEPLOY_STATE_DIR="$T" bash "$ME" aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee 0.4.58 --skill-dir "$T/skill" >/dev/null 2>&1 || RC=$?
  chk "no-drift-without-ack-rc0" 0 "$RC"
  chk "no-drift-without-ack-no-write" "none" "$(jq -r '.workers[0].last_acked.version // "none"' "$T/state-ledger.json")"
  # ---- D-5 omit-arg mode (HQ d72bd52d, 2026-09-13) --------------------------
  # The verdict must be a function of state on disk, never of argv. With no
  # claimed-version the tool reads the lane's RECORDED last_acked and compares
  # THAT to live (fixture live = 0.4.58). The killer arm is the first one:
  # last_acked=0.4.57 vs live 0.4.58 must be DRIFT — an implementation that
  # echoed argv, or compared live-to-live, could ONLY ever answer NO-DRIFT here.
  AU=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
  jq '.workers[0].last_acked = {version:"0.4.57", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "omit-arg-uses-last-acked-not-argv" 1 "$RC"
  case "$OUT" in *"DRIFT: claimed 0.4.57"*) OA=yes ;; *) OA=no ;; esac
  chk "omit-arg-names-the-recorded-version" "yes" "$OA"
  # a lane with NO history gets its OWN verdict — never NO-DRIFT (the defect)
  jq '.workers[0].last_acked = null' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "omit-arg-no-history-rc1" 1 "$RC"
  case "$OUT" in *"NO-HISTORY"*) NH=yes ;; *) NH=no ;; esac
  chk "omit-arg-no-history-verdict" "yes" "$NH"
  case "$OUT" in *"NO-DRIFT"*) ND2=yes ;; *) ND2=no ;; esac
  chk "omit-arg-no-history-is-not-no-drift" "no" "$ND2"
  case "$OUT" in *"claimed -"*) BN=yes ;; *) BN=no ;; esac
  chk "omit-arg-no-history-no-bogus-claim" "no" "$BN"
  # an UNKNOWN uuid (never acked, not even enrolled) is NO-HISTORY too — the
  # exact reproduction HQ ran on a synthetic uuid
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" deadbeef-0000-1111-2222-333344445555 --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "omit-arg-unknown-uuid-rc1" 1 "$RC"
  case "$OUT" in *"NO-HISTORY"*) UH=yes ;; *) UH=no ;; esac
  chk "omit-arg-unknown-uuid-no-history" "yes" "$UH"
  # recorded == live -> clean
  jq '.workers[0].last_acked = {version:"0.4.58", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "omit-arg-match-rc0" 0 "$RC"
  # --ack keeps stamping the LIVE version on the omit-arg path too
  jq '.workers[0].last_acked = {version:"0.4.57", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT_ACK="$(OC_LEDGER="$T/state-ledger.json" OC_DEPLOY_STATE_DIR="$T" bash "$ME" "$AU" --ack --skill-dir "$T/skill" 2>&1)" || RC=$?
  # #560: the verdict describes the state the command LEAVES. Before the fix the
  # SAME run printed "ack stamped ... at 0.4.58" and then "DRIFT: claimed 0.4.57
  # != live 0.4.58" -- a durable drift claim written straight after the ack that
  # cleared it, and one a lane quoting its own output records as fact.
  chk "omit-arg-ack-rc0" 0 "$RC"
  case "$OUT_ACK" in *"NO-DRIFT"*) AN=yes ;; *) AN=no ;; esac
  chk "omit-arg-ack-verdict-is-no-drift" "yes" "$AN"
  # NOTE: a substring test for "DRIFT:" also matches the CLEAN line, because
  # "NO-DRIFT: claimed ..." CONTAINS "DRIFT:". Anchored at line start instead --
  # a pattern that cannot separate a verdict from its negation is not a test.
  AD="$(printf '%s' "$OUT_ACK" | grep -c '^DRIFT:')"
  chk "omit-arg-ack-prints-no-drift-line" "0" "$AD"
  case "$OUT_ACK" in *"claimed side: ack stamped this run"*) AS=yes ;; *) AS=no ;; esac
  chk "omit-arg-ack-names-the-ack-as-the-source" "yes" "$AS"
  chk "omit-arg-ack-stamps-live" "0.4.58" "$(jq -r '.workers[] | select(.uuid=="aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee") | .last_acked.version // "none"' "$T/state-ledger.json")"
  # THE CONTROL ARM: without --ack the same drifted record must still FIRE, so
  # the fix cannot be satisfied by making the sensor blind.
  jq '.workers[0].last_acked = {version:"0.4.57", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT_NA="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "omit-arg-no-ack-still-drifts-rc1" 1 "$RC"
  case "$OUT_NA" in *"DRIFT: claimed 0.4.57"*) ND=yes ;; *) ND=no ;; esac
  chk "omit-arg-no-ack-still-names-the-drift" "yes" "$ND"
  # ---- F (fork #447): source naming + advisory author-window note -----------
  # Every verdict must name the SOURCE of each side. The claimed-side paths
  # (argv vs recorded) must be DISTINGUISHABLE in the text: before this fix a
  # live DRIFT line was byte-identical whichever path produced it, so an
  # "acked version ahead of the ledger" read as lane misbehaviour.
  jq '.workers[0].last_acked = {version:"0.4.57", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT_ARGV="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" 0.4.57 --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "src-argv-rc1" 1 "$RC"
  case "$OUT_ARGV" in *"claimed side: argv"*) S1=yes ;; *) S1=no ;; esac
  chk "src-argv-names-argv" "yes" "$S1"
  case "$OUT_ARGV" in *"live side: on-disk skill file $T/skill/SKILL.md"*) S2=yes ;; *) S2=no ;; esac
  chk "src-argv-names-the-live-file" "yes" "$S2"
  RC=0; OUT_REC="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "src-recorded-rc1" 1 "$RC"
  case "$OUT_REC" in *"claimed side: ledger roster last_acked"*) S3=yes ;; *) S3=no ;; esac
  chk "src-recorded-names-the-roster" "yes" "$S3"
  # the killer arm: same claimed version, same live version, DIFFERENT text.
  # An implementation that prints a constant source label fails here.
  if [ "$OUT_ARGV" = "$OUT_REC" ]; then bad "src-argv-vs-recorded-differ (both outputs identical)"; else ok; fi
  # NO-DRIFT names both sides
  jq '.workers[0].last_acked = {version:"0.4.58", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "src-no-drift-rc0" 0 "$RC"
  case "$OUT" in *"claimed 0.4.58 (claimed side: ledger roster last_acked) == live 0.4.58 (live side: on-disk skill file"*) S4=yes ;; *) S4=no ;; esac
  chk "src-no-drift-names-both" "yes" "$S4"
  # NO-HISTORY names the claimed-side source too (it is a claim ABOUT that source)
  jq '.workers[0].last_acked = null' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" --skill-dir "$T/skill" 2>&1)" || RC=$?
  case "$OUT" in *"NO-HISTORY: no last_acked recorded for $AU (claimed side: ledger roster last_acked)"*) S5=yes ;; *) S5=no ;; esac
  chk "src-no-history-names-claimed" "yes" "$S5"
  # ADVISORY author-window note. Fixture ledger carries NO skill-bump event, so
  # the on-disk 0.4.58 is provably ahead of the last sync -> note appears.
  jq '.workers[0].last_acked = {version:"0.4.58", at:"2026-01-01T00:00:00Z"}' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" 0.4.58 --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "bump-absent-rc-unchanged" 0 "$RC"
  case "$OUT" in *"NOTE: no skill-bump ledger event for 0.4.58"*) B1=yes ;; *) B1=no ;; esac
  chk "bump-absent-note" "yes" "$B1"
  # ... and with a matching skill-bump event present, the note DISAPPEARS.
  jq '.events = [{"n":1,"t":"2026-01-01T00:00:00Z","by":"oc-ledger sync","kind":"skill-bump","what":"v0.4.58 — fixture"}]' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" 0.4.58 --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "bump-present-rc-unchanged" 0 "$RC"
  case "$OUT" in *"NOTE: no skill-bump ledger event"*) B2=yes ;; *) B2=no ;; esac
  chk "bump-present-no-note" "no" "$B2"
  # PREFIX, not substring: the pattern carries a TRAILING SPACE so an event for
  # v0.4.580 cannot satisfy cur=0.4.58. Dropping that space is exactly the mutant
  # this arm kills (pattern "v0.4.58" prefix-matches "v0.4.580 — fixture").
  # NOTE: contains() would NOT be caught here — with the space it is equivalent
  # for this fixture — so this arm is scoped to the space, not to the operator.
  jq '.events = [{"n":1,"t":"2026-01-01T00:00:00Z","by":"oc-ledger sync","kind":"skill-bump","what":"v0.4.580 — fixture"}]' "$T/state-ledger.json" > "$T/l.tmp" && mv "$T/l.tmp" "$T/state-ledger.json"
  RC=0; OUT="$(OC_LEDGER="$T/state-ledger.json" bash "$ME" "$AU" 0.4.58 --skill-dir "$T/skill" 2>&1)" || RC=$?
  case "$OUT" in *"NOTE: no skill-bump ledger event for 0.4.58"*) B3=yes ;; *) B3=no ;; esac
  chk "bump-near-miss-version-is-absent" "yes" "$B3"
  # an UNREADABLE ledger leaves the note SILENT (absence of evidence is not
  # evidence) and still never changes the verdict
  RC=0; OUT="$(OC_LEDGER="$T/missing-ledger.json" bash "$ME" "$AU" 0.4.58 --skill-dir "$T/skill" 2>&1)" || RC=$?
  chk "bump-unknown-rc-unchanged" 0 "$RC"
  case "$OUT" in *"NOTE: no skill-bump ledger event"*) B4=yes ;; *) B4=no ;; esac
  chk "bump-unknown-no-note" "no" "$B4"
  rm -rf "$T"
  echo "oc-drift-check selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]
}

case "${1:-}" in
  --selftest) cmd_selftest; exit $? ;;
esac
cmd_drift "$@"
