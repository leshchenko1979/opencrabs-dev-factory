#!/usr/bin/env bash
# =============================================================================
# oc-shadow-rotate — second-copy rotation for the oc-deploy shadow journal
# (v0.4.43, Duty-6 run-2 D12 + owner item 6, 2026-08-29)
#
# The live shadow log ($STATE_DIR/oc-deploy-shadow.log) is gitignored —
# a SINGLE copy on disk. Rotation APPENDS the live content to the git-tracked
# archive copy, then truncates the live file. Run at bump cadence
# (hq.md bump steps). oc-deploy itself only ever appends to the live
# file, so truncate-after-archive loses nothing.
#
# CHAINED as the tail step of `oc-ledger sync` since v0.4.48 (merge A): the
# bump cadence IS the rotation cadence now — mechanical, not prose. Standalone
# invocation remains the manual fallback (and what sync execs under the hood).
#
# Exit codes: 0 ok/noop | 2 usage-or-io-fail (C-#3: usage 1->2; rc 1 retired)
# =============================================================================
set -uo pipefail
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-shadow-rotate" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

STATE_DIR="${OC_DEPLOY_STATE_DIR:-${OC_DEV_STATE:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}}"   # v0.4.60: state dir (owner 06:03Z migration)
LIVE="$STATE_DIR/oc-deploy-shadow.log"
ARCHIVE="$STATE_DIR/oc-deploy-shadow.archive.log"

case "${1:-}" in
  --help|-h) echo "usage: oc-shadow-rotate [--dry-run]"; echo "Exit: 0 ok/noop | 2 usage-or-io-fail"; exit 0 ;;  # C-#3: help=0
  ""|--dry-run) : ;;
  *) echo "oc-shadow-rotate: unknown arg: $1 (usage: oc-shadow-rotate [--dry-run])" >&2; exit 2 ;;  # F8 lens-F (v0.4.72) fail loud; C-#3 usage=2
esac

[ -f "$LIVE" ] || { echo "oc-shadow-rotate: no live shadow log ($LIVE) — noop"; exit 0; }
[ -s "$LIVE" ] || { echo "oc-shadow-rotate: live shadow log empty — noop"; exit 0; }

lines=$(wc -l < "$LIVE")
if [ "${1:-}" = "--dry-run" ]; then
  echo "PLAN: append $lines lines to $ARCHIVE, then truncate $LIVE"
  exit 0
fi

cat "$LIVE" >> "$ARCHIVE" || { echo "oc-shadow-rotate: archive append failed" >&2; exit 2; }
: > "$LIVE" || { echo "oc-shadow-rotate: live truncate failed" >&2; exit 2; }
echo "oc-shadow-rotate: appended $lines lines to $(basename "$ARCHIVE"), live truncated"
exit 0
