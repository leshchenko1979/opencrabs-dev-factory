#!/usr/bin/env bash
# =============================================================================
# oc-closure-sweep — close issues whose class (d) receipt pair ALREADY exists
# =============================================================================
# WHY THIS EXISTS (T-10, 2026-11-20; triage.md §Autonomous closure class (d))
# -----------------------------------------------------------------------------
# Class (d) closure is "a working behavioural smoke is confirmed -> the issue is
# closed on the receipt". `oc-smoke --close` does that at the moment of the PASS.
# It can only do it if the close feature existed, was reachable, and the gh call
# succeeded — so every PASS that landed before any of those became an issue that
# is landed, has BOTH receipts on the record, and is still OPEN. A `done` row
# alone closes the CLAIM, so the dispatch predicate reads the issue as landed and
# nothing ever looks at it again. The evidence for the class: #279 got a
# PASS-LATE-ENTRY verdict and its done row and stayed open until a human noticed.
#
# This tool is the catch-up path. It joins the two receipt surfaces and closes
# what the live path missed — through the SAME function `oc-smoke --close` uses
# (tools/lib/oc-gh-close.sh), so the guards cannot drift between them.
#
# THE JOIN (three-way, both receipts required)
#   1. smoke-verdicts.log — the issue's NEWEST verdict-bearing row must carry a
#      SANCTIONED PASS token. A later FAIL / UNPROVEN / RETRACTION disqualifies.
#   2. workers-ledger.json — a `done` row naming the issue. No done row, no
#      pair, no close: that is acceptance criterion 3, and it is why the ledger
#      half is a REQUIREMENT rather than corroboration.
#   3. the live tracker — `gh issue view --json state`. OPEN is the only state
#      that is eligible; CLOSED means the live path already did it.
#
# WHAT COUNTS AS A PASS — the sanctioned taxonomy only
#   Eligible: PASS · PASS-LATE-ENTRY · PASS-OWNER-EYE · PASS-CALLBACK-LIVE
#   (upstream-merge-runbook.md §Verdict taxonomy). Off-taxonomy tokens that read
#   like PASSes — PASS-ADDENDUM, OWNER-EYE-CONFIRM, ADDENDUM — are reported on
#   their own line and are NEVER closable: a public close is not the place to
#   promote a token the taxonomy does not sanction. They are a defect to fix at
#   the source, not a licence to close.
#
# ROW SHAPES the parser must survive (all four measured in the live log)
#   (1) a full verdict row:  ts \t PASS \t run= \t sha= \t actor= \t issue= \t target= \t evidence=
#   (2) a late entry:        ts \t PASS-LATE-ENTRY \t sha= \t actor= \t issue= \t target=   (no run=)
#   (3) an identity block:   /usr/local/bin/opencrabs \t PASS \t ... — field 2 IS a
#       verdict token, field 1 is NOT a timestamp. 1805 lines of that log hold
#       hundreds of these; a parser that trusts field 2 alone closes on a
#       sha block. The timestamp in field 1 is the discriminator.
#   (4) a minimal row:       ts \t PASS \t issue=            (no sha, no run, no target)
#
# Usage: oc-closure-sweep [--repo <owner/repo>] [--log <path>] [--ledger <path>]
#                         [--battery <path>] [--tree <dir>]
#                         [--apply] [--json] [--selftest]
#   DRY RUN IS THE DEFAULT. Without --apply this tool writes NOTHING to any
#   tracker; it prints what it would close and exits 0.
#   --repo      WHERE a close may be applied (default: BOTH live trackers). It
#               narrows the close SCOPE only — never what is checked for
#               ambiguity.
#   --board     a tracker to CHECK for number collisions (repeatable; default
#               BOTH live trackers). A number held by more than one board is
#               AMBIGUOUS-TRACKER and is never closed, whatever `--repo` says.
#   --log       smoke-verdicts.log (default $STATE_DIR/smoke-verdicts.log)
#   --e-repo    the tracker a tools/** fix belongs to (default the factory)
#   --ledger    workers-ledger.json (default $STATE_DIR/workers-ledger.json)
#   --battery   tools/tests/battery-last.json — the class (e) receipt
#               (default $SCRIPT_DIR/tests/battery-last.json)
#   --tree      the git work tree the receipt and the fix commits live in
#               (default: the toplevel of this tool's own repo)
#   CLASS (e) — a `tools/**` fix writes no smoke verdict; the harness BATTERY is
#   its receipt (triage.md §Autonomous closure, HQ ruling 2026-11-20, factory#127).
#   Such an issue is a candidate when it has a `done` row and no smoke verdict, and
#   it is closable ONLY when all three legs hold:
#     (i)   the COMMITTED battery-last.json reads verdict=PASS, fail=0,
#           tree_changed=false (the committed blob, never the working copy: the
#           battery rewrites that file on every run, so the working copy is a
#           receipt only once it is on the record);
#     (ii)  the fix commit is an ANCESTOR of the receipt's commit — read with
#           `git merge-base --is-ancestor`, never from a report's word;
#     (iii) the fix commit's OWN SUBJECT names the issue. A trailer is a CLAIM:
#           #112's `Issue-Ref:` sat on a commit about a different fix, so a
#           trailer-keyed sweep closes issues on collateral references.
#   With either input unusable the class is DISABLED and says so on stderr — an
#   absent receipt is never a silent zero.
#
# THE CLAIMS RECONCILIATION LEG (#132, factory issue 2026-11-21)
# -----------------------------------------------------------------------------
# The class (d)/(e) legs above join the TRACKER to the RECEIPTS. This leg joins
# the TRACKER to the OPEN CLAIMS — the other half of the same gap: 18 claims on
# 15 CLOSED fork issues across 9 lanes, every one of them still holding a
# reservation for work that shipped. Nothing retired them, because `done` rows
# close claims only for the lane that wrote them and a claim abandoned mid-flight
# has no such row at all.
#
# WHY HERE AND NOT IN THE PREDICATE: `claim_is_closed()` is deliberately offline
# and pure — the dispatch path calls it in tight loops and it may never make a
# network call. This sweep runs on purpose and is allowed to be slow.
#
# THE JOIN IS FREE: TRACKER_OF is already filled by the list calls above, so the
# leg costs ZERO additional gh reads.
#
# THREE CLASSIFICATIONS, and only one of them releases:
#   CLAIM-LIVE       OPEN on a board where the number exists — reservation earned.
#   CLAIM-AMBIGUOUS  CLOSED on one board and OPEN on the other. A claim row
#                    carries NO repo field and the two trackers collide on
#                    numbers constantly, so retiring here releases on a guess.
#                    Reported and LEFT ALONE.
#   CLAIM-STALE      CLOSED on every board that has the number, with no ledger
#                    close row. `--apply` releases it.
# A release row is written AS THE CLAIMING LANE, never as the sweeper:
# `claim_is_closed()`'s addressed arm retires on a row from ANY actor, so a
# sweeper writing as itself could clear another lane's reservation — exactly the
# actor confusion `actor_match` exists to prevent. It is also marked
# SWEPT, NOT ATTESTED: the sweep observed tracker state, it did not verify work.
#
# Exit codes:
#   0 sweep ran; every eligible issue closed or already CLOSED (dry run: ran clean)
#   1 under --apply, at least one close FAILED, one claim RELEASE failed, or a
#     state read failed — a write this run owed did not happen
#   2 usage error
#   3 an input file is missing or unreadable (log / ledger)
# =============================================================================
# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
# The git tree is resolved HERE, before the snap guard, and passed through the
# environment. `oc_snap_guard` EXECs this script from an immutable MIRROR of
# tools/ — no .git — so a tree resolved after it is always empty and class (e)
# silently disables itself on the live box while every selftest (which runs the
# tool from the real tree, guard and all, but with --tree) stays green.
OC_CLOSURE_TREE="${OC_CLOSURE_TREE:-$(git -C "$_oc_d" rev-parse --show-toplevel 2>/dev/null || true)}"
# Same reason for the receipt: the mirror's copy is a WORKING-COPY path with no
# commit behind it, and leg (i) reads the COMMITTED blob — a receipt the tree
# cannot address is not a receipt.
OC_CLOSURE_BATTERY="${OC_CLOSURE_BATTERY:-$_oc_d/tests/battery-last.json}"
export OC_CLOSURE_TREE OC_CLOSURE_BATTERY
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -u
set -o pipefail
set -e

SCRIPT_DIR="$OC_TOOLS_DIR"
PROG="oc-closure-sweep"
STATE_DIR="${OC_DEPLOY_STATE_DIR:-${OC_DEV_STATE:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}}"

# The selftest must not journal rows into the fleet log. This is set BEFORE
# oc_log_init, not after: init is what enables the writer, so exporting later is
# a no-op and the selftest quietly pollutes the very log it is testing against.
for _a in "$@"; do [ "$_a" = "--selftest" ] && export OC_TOOLS_NOLOG=1; done

. "$SCRIPT_DIR/lib/oc-log.sh" 2>/dev/null || true
. "$SCRIPT_DIR/lib/oc-gh-close.sh" 2>/dev/null || true
oc_log_init "$PROG" "$@"

GH_BIN="${OC_GH_BIN:-gh}"
# BOTH live trackers by default, and the reason is measured, not tidy: the
# smoke log is a SINGLE log for the whole fleet, so its verdict rows name binary
# issues (fork) and tooling issues (factory) in one number space. A one-repo
# sweep reported 200+ binary issues as "state read FAILED" on a live dry run
# (2026-11-20) — noise that looks like a broken tracker and hides the real debt.
# A `--repo` given on the command line REPLACES the default list.
REPOS=("leshchenko1979/opencrabs-dev-factory" "leshchenko1979/opencrabs")
REPO_GIVEN=0
# THE BOARD SET — what is CHECKED for a number collision, ALWAYS, whatever
# `--repo` narrows the close scope to (#140 face 1). The two lists are the same
# by default and MUST NOT be conflated: `--repo factory` decides where a close is
# written, and the fact that makes a receipt unattributable is that the number is
# held ELSEWHERE — a fact that does not stop being true because the operator
# narrowed where to write. Measured 2026-11-22: 121 numbers are held by both
# boards, and 4 factory issues (#134, #135, #136, #140) are shadowed by a CLOSED
# fork number, which is the exact shape a narrowed sweep could not see.
BOARDS=("leshchenko1979/opencrabs-dev-factory" "leshchenko1979/opencrabs")
BOARDS_GIVEN=0
LOG="$STATE_DIR/smoke-verdicts.log"
LEDGER="$STATE_DIR/workers-ledger.json"
# Class (e) inputs. The battery receipt and the git tree it is judged in — both
# overridable so the selftest can prove each leg against a fixture it owns, and
# so a sweep can be pointed at another checkout without editing the tool.
BATTERY="${OC_CLOSURE_BATTERY:-$SCRIPT_DIR/tests/battery-last.json}"
# The ONE tracker whose number space the skill repo's commit subjects speak.
# A `tools/**` fix is a FACTORY issue, so class (e) may never close a number that
# only the binary fork holds — the two spaces collide constantly.
E_REPO="${OC_CLOSURE_E_REPO:-leshchenko1979/opencrabs-dev-factory}"
TREE="${OC_CLOSURE_TREE:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)}"
APPLY=0
JSON=0
MODE=sweep

die() { local rc="$1"; shift; printf '%s: %s\n' "$PROG" "$*" >&2; exit "$rc"; }

usage() {
  sed -n '/^# Usage: oc-closure-sweep/,/^#   3 an input file/p' "$0" | sed 's/^# \{0,1\}//'
}

for a in "$@"; do
  case "$a" in
    --selftest) MODE=selftest ;;
  esac
done

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      [ $# -ge 2 ] || die 2 "--repo needs <owner/repo>"
      [ "$REPO_GIVEN" -eq 1 ] || { REPOS=(); REPO_GIVEN=1; }
      REPOS+=("$2"); shift 2 ;;
    --board)
      [ $# -ge 2 ] || die 2 "--board needs <owner/repo>"
      [ "$BOARDS_GIVEN" -eq 1 ] || { BOARDS=(); BOARDS_GIVEN=1; }
      BOARDS+=("$2"); shift 2 ;;
    --log)    [ $# -ge 2 ] || die 2 "--log needs a path"; LOG="$2"; shift 2 ;;
    --ledger) [ $# -ge 2 ] || die 2 "--ledger needs a path"; LEDGER="$2"; shift 2 ;;
    --battery) [ $# -ge 2 ] || die 2 "--battery needs a path"; BATTERY="$2"; shift 2 ;;
    --tree)   [ $# -ge 2 ] || die 2 "--tree needs a directory"; TREE="$2"; shift 2 ;;
    --e-repo) [ $# -ge 2 ] || die 2 "--e-repo needs owner/name"; E_REPO="$2"; shift 2 ;;
    --apply)  APPLY=1; shift ;;
    --json)   JSON=1; shift ;;
    --selftest) MODE=selftest; shift ;;
    -h|--help) usage; exit 0 ;;
    *) die 2 "unknown argument '$1' (see --help)" ;;
  esac
done

[ "${#REPOS[@]}" -gt 0 ] || die 2 "--repo given with no value"
[ "${#BOARDS[@]}" -gt 0 ] || die 2 "--board given with no value"
for _r in "${REPOS[@]}" "${BOARDS[@]}"; do
  case "$_r" in
    */*) ;;
    *) die 2 "--repo/--board must be owner/repo, got '$_r'" ;;
  esac
done

# ---------------------------------------------------------------------------
# selftest lives at the tail of this file (appended below) and exits before
# any real input is touched.
# ---------------------------------------------------------------------------
run_selftest() {
  export OC_TOOLS_NOLOG=1
  # GLOBAL, not local: an EXIT trap runs after the function frame is gone, so a
  # `local D` referenced by that trap is UNBOUND under `set -u` — and the trap
  # error then masks the leg that actually failed (measured in this file's own
  # mutation run: the abort looked like a tool bug for two rounds).
  _ST_D="$(mktemp -d)" || die 3 "mktemp failed"
  trap 'rm -rf "$_ST_D"' EXIT
  D="$_ST_D"
  local SELF="$OC_TOOLS_DIR/state/oc-closure-sweep" T; T="$(printf '\t')"
  local pass=0 fail=0 rc=0 out="" err=""

  t_ok()  { pass=$((pass + 1)); printf 'selftest: %s  OK\n' "$*"; }
  t_bad() { fail=$((fail + 1)); printf 'selftest: %s  FAIL\n' "$*" >&2; }

  # ---- fixtures -----------------------------------------------------------
  # The four MEASURED row shapes, plus the two disqualifiers, plus the case
  # acceptance criterion 3 names (a done row with no smoke PASS at all).
  {
    # (1) a full verdict row
    printf '%s\n' "2026-11-01T10:00:00Z${T}PASS${T}run=111${T}sha=aaaa${T}actor=lane${T}issue=260${T}target=live-ops${T}evidence=behavioural probe green"
    # (2) a late entry — NO run= (the #279 shape, and the regression case)
    printf '%s\n' "2026-09-19T08:00:00Z${T}PASS-LATE-ENTRY${T}sha=bbbb${T}actor=lane${T}issue=279${T}target=live-ops${T}evidence=recorded late, receipts cited"
    # (3) an IDENTITY BLOCK line: field 2 IS a verdict token, field 1 is not a
    #     timestamp. A parser trusting field 2 alone reads this as a PASS for
    #     #260 carrying sha=9999/run=999 — leg 4 is the discriminator.
    printf '%s\n' "/usr/local/bin/opencrabs${T}PASS${T}pid=1${T}exe_sha256=dead${T}run_id=999${T}VERDICT=PASS${T}sha=9999${T}issue=260${T}target=live-ops${T}evidence="
    # (4) a minimal row: no sha, no run, no target
    printf '%s\n' "2026-11-02T09:00:00Z${T}PASS${T}issue=300"
    # off-taxonomy PASS look-alike: reported, never closable
    printf '%s\n' "2026-11-04T09:00:00Z${T}PASS-ADDENDUM${T}issue=302${T}target=live-ops"
    # #303 carries a PASS and then a RETRACTION below. The PASS-then-RETRACTION
    # pair is the ONLY thing that makes the kill testable: #303 also has a done
    # row, so without the kill it becomes a candidate and the tool would close
    # an issue whose verdict was withdrawn. (Measured: the first version of this
    # fixture retracted an issue that had no PASS at all, so mutation M6 —
    # `if tok in KILL` neutered — survived with all 14 legs green.)
    printf '%s\n' "2026-11-03T09:00:00Z${T}PASS${T}run=333${T}sha=cccc${T}actor=lane${T}issue=#303${T}target=live-ops${T}evidence=probe green, later withdrawn"
    # a retraction kills an earlier PASS. The LIVE shape carries issue=#N WITH
    # the hash (measured: `issue=#94`), and this fixture's evidence= names an
    # UNRELATED issue on purpose: a line-wide hash scan would revoke #260's
    # PASS on a row that is about #303, so leg 1's expected join set is the
    # witness that the kill stayed scoped.
    printf '%s\n' "2026-11-05T09:00:00Z${T}RETRACTION${T}sha=dddd${T}issue=#303${T}evidence=withdrawn; supersedes the note about #260"
    # a FAIL is not a PASS
    printf '%s\n' "2026-11-06T09:00:00Z${T}FAIL${T}run=444${T}sha=eeee${T}issue=304${T}target=live-ops"
    # a PASS that no done row backs
    printf '%s\n' "2026-11-07T09:00:00Z${T}PASS${T}run=555${T}sha=ffff${T}issue=306${T}target=live-ops"
    # the SAME NUMBER exists OPEN on BOTH trackers: never closable on a guess
    printf '%s\n' "2026-11-08T09:00:00Z${T}PASS${T}run=666${T}sha=gggg${T}issue=310${T}target=live-ops"
    # --- the T-7 park mirrors, one per guard so neither can hide the other --
    # #320: PARKED-OWNER-EYE with NO behavioral= token at all (the #398 shape).
    #   Only matcher (a) can catch this row.
    printf '%s\n' "2026-11-09T09:00:00Z${T}PASS${T}run=888${T}sha=hhhh${T}issue=320${T}target=live-ops${T}evidence=4-leg smoke pass: lineage=verified identity=MATCH LEG4 PARKED-OWNER-EYE, the lever is owner-gated"
    # #321: behavioral=absent and NO park literal (the #515 shape).
    #   Only matcher (b) can catch this row.
    printf '%s\n' "2026-11-09T09:10:00Z${T}PASS${T}run=889${T}sha=iiii${T}issue=321${T}target=live-ops${T}evidence=3-leg smoke pass: lineage=verified behavioral=absent identity=MATCH leg 4 ABSENT, not passed"
    # #322: behavioral=na is a DECLARED structural N/A and must stay CLOSABLE
    #   (the live path's T-7 positive control). Without this row, a guard that
    #   refuses every `behavioral=` token would pass every park leg.
    printf '%s\n' "2026-11-09T09:20:00Z${T}PASS${T}run=890${T}sha=jjjj${T}issue=322${T}target=live-ops${T}evidence=4-leg smoke pass: lineage=verified identity=MATCH behavioral=na, no behavioural leg is applicable to a doc change"
    # #323: the BARE WORD `parked` in a sound close. Matching the word instead
    #   of the literals refuses this row — a false debt, and the reason the
    #   matcher is two literals rather than a substring.
    printf '%s\n' "2026-11-09T09:30:00Z${T}PASS${T}run=891${T}sha=kkkk${T}issue=323${T}target=live-ops${T}evidence=4-leg smoke pass: lineage=verified identity=MATCH no leg claimed or parked, all four ran"
    # --- #140 fixtures -----------------------------------------------------
    # FACE 2 — #350 carries a PASS row, a done row AND a CORRECTION row naming
    # it. The PASS+done pair is load-bearing: a kill fixture whose number has NO
    # PASS cannot observe `if tok in KILL` at all (measured in this file's own
    # mutation run — a mutant that neutered that branch SURVIVED because the
    # fixture retracted a number that was never a close candidate). So #350 must
    # be a close candidate BEFORE the correction, or this arm proves nothing.
    printf '%s\n' "2026-11-11T09:00:00Z${T}PASS${T}run=1010${T}sha=mmmm${T}actor=lane${T}issue=#350${T}target=live-ops${T}evidence=probe green, corrected the next day"
    # FACE 1 — the #138 SHAPE: a number held by BOTH boards, one CLOSED and one
    # OPEN. A PASS + done row would otherwise close it, and with `--repo` narrowed
    # to one board there is no collision to see at all.
    printf '%s\n' "2026-11-13T09:00:00Z${T}PASS${T}run=1020${T}sha=oooo${T}actor=lane${T}issue=340${T}target=live-ops${T}evidence=behavioural probe green"
    # FACE 1 — the same collision, but the row's OWN evidence names its board.
    # The URL is the positive discriminator: it must attribute #341 to o/one and
    # close THERE, never on the o/two copy that is CLOSED.
    printf '%s\n' "2026-11-14T09:00:00Z${T}PASS${T}run=1030${T}sha=pppp${T}actor=lane${T}issue=341${T}target=live-ops${T}evidence=probe green (tracked at https://github.com/o/one/issues/341)"
    # FACE 3 — #351 has a done row and NO verdict of its own, so it IS a class
    # (e) shape; a row for the same number on the OTHER board bars it. The row's
    # evidence names that board, so the exclusion must be reported BY NAME.
    printf '%s\n' "2026-11-15T09:00:00Z${T}FAIL${T}run=1040${T}sha=qqqq${T}actor=lane${T}issue=351${T}target=live-ops${T}evidence=probe red (see https://github.com/o/two/issues/351)"
    # the CORRECTION last, so it retracts an EARLIER PASS (the live #138 shape:
    # the correction follows the row it disavows).
    printf '%s\n' "2026-11-12T09:00:00Z${T}CORRECTION${T}sha=nnnn${T}issue=#350${T}evidence=CORRECTION of my row of 2026-11-11T09:00:00Z: that probe ran against the wrong build"
  } > "$D/log"

  cat > "$D/ledger" <<'LEDGER'
{"events":[
 {"n":1,"t":"2026-11-01T10:05:00Z","kind":"done","what":"#260 — feature landed"},
 {"n":2,"t":"2026-09-19T09:00:00Z","kind":"done","what":"#279 — landed late"},
 {"n":3,"t":"2026-11-02T09:05:00Z","kind":"done","what":"#300 done"},
 {"n":4,"t":"2026-11-04T09:05:00Z","kind":"done","what":"#302 addendum row"},
 {"n":5,"t":"2026-11-05T09:05:00Z","kind":"done","what":"#303 done"},
 {"n":6,"t":"2026-11-06T09:05:00Z","kind":"done","what":"#304 done"},
 {"n":7,"t":"2026-11-07T09:05:00Z","kind":"done","what":"#305 done, no smoke at all"},
 {"n":8,"t":"2026-11-08T09:05:00Z","kind":"progress","what":"#260 not a done row"},
 {"n":9,"t":"2026-11-08T09:06:00Z","kind":"done","what":"#310 collides across trackers"},
 {"n":10,"t":"2026-11-09T09:05:00Z","kind":"done","what":"#320 landed, leg 4 PARKED-OWNER-EYE"},
 {"n":11,"t":"2026-11-09T09:15:00Z","kind":"done","what":"#321 landed, leg 4 ABSENT"},
 {"n":12,"t":"2026-11-09T09:25:00Z","kind":"done","what":"#322 doc change landed"},
 {"n":13,"t":"2026-11-09T09:35:00Z","kind":"done","what":"#323 landed, all four legs ran"},
 {"n":14,"t":"2026-11-21T04:20:00Z","kind":"done","what":"#330 landed, named only by a trailer"},
 {"n":15,"t":"2026-11-21T04:21:00Z","kind":"done","what":"#331 landed after the receipt"},
 {"n":16,"t":"2026-11-21T04:22:00Z","kind":"done","what":"#332 landed \u2014 detail: \"quoted\" and\na second line"},
 {"n":17,"t":"2026-11-21T04:23:00Z","kind":"done","what":"#333 a factory-shaped fix, but the number lives on the OTHER tracker"},
 {"n":18,"t":"2026-11-13T09:05:00Z","kind":"done","what":"#340 landed, number also held by the other board"},
 {"n":19,"t":"2026-11-14T09:05:00Z","kind":"done","what":"#341 landed, evidence names its own board"},
 {"n":20,"t":"2026-11-11T09:05:00Z","kind":"done","what":"#350 landed, then the verdict was corrected away"},
 {"n":21,"t":"2026-11-15T09:05:00Z","kind":"done","what":"#351 landed as a tools/** fix, but a foreign smoke row speaks the number"}
]}
LEDGER

  # The stub serves `issue list` (the tracker-resolution call) for TWO repos, so
  # the ambiguity leg below is a real collision rather than a simulated one:
  #   o/one  holds 260 OPEN, 279 OPEN, 300 CLOSED, 302 OPEN, 303 OPEN, 304 OPEN
  #          plus 340/341 OPEN and 350 OPEN (#140 fixtures)
  #   o/two  holds 260 OPEN as well  -> #260 is AMBIGUOUS, and must not close
  #          and 340/341 CLOSED     -> the #138 SHAPE: held by both boards, one
  #                                    CLOSED one OPEN, so it is AMBIGUOUS too
  #   (305 and 306 and 351 live nowhere -> ABSENT / never joined)
  cat > "$D/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_CALLS"
case "$1 $2" in
  "issue list")
    case "$4" in
      o/one) echo '[{"number":260,"state":"OPEN"},{"number":279,"state":"OPEN"},{"number":300,"state":"CLOSED"},{"number":302,"state":"OPEN"},{"number":303,"state":"OPEN"},{"number":304,"state":"OPEN"},{"number":305,"state":"OPEN"},{"number":310,"state":"OPEN"},{"number":320,"state":"OPEN"},{"number":321,"state":"OPEN"},{"number":322,"state":"OPEN"},{"number":323,"state":"OPEN"},{"number":330,"state":"OPEN"},{"number":331,"state":"OPEN"},{"number":332,"state":"OPEN"},{"number":340,"state":"OPEN"},{"number":341,"state":"OPEN"},{"number":350,"state":"OPEN"}]' ;;
      o/two) echo '[{"number":310,"state":"OPEN"},{"number":333,"state":"OPEN"},{"number":340,"state":"CLOSED"},{"number":341,"state":"CLOSED"},{"number":777,"state":"CLOSED"}]' ;;
      *) echo '[]' ;;
    esac ;;
  "issue view") case "$3" in 300) echo CLOSED ;; *) echo OPEN ;; esac ;;
  "issue close") echo "closed #$3" ;;
esac
exit 0
STUB
  chmod +x "$D/gh"

  # ---- class (e) fixture: a REAL git tree, because legs (ii) and (iii) are
  # git reads and a stub would let them pass without being able to fail. The
  # history is deliberately hostile in the three measured ways:
  #   * the receipt commit's OWN SUBJECT names #305 — so a leg (iii) that scans
  #     the receipt's ancestry INCLUSIVE would cite the receipt as its own fix
  #     (self-consistency, proves nothing; the live shape is
  #     `chore(tests): battery receipt PASS 445/0 with the #80 log bound in the
  #     tree`).
  #   * #330 is named ONLY by an `Issue-Ref:` trailer on a commit about another
  #     change — the #112 trap, which must close NOTHING.
  #   * #331's fix commit comes AFTER the receipt — leg (ii) must red.
  G() { git -C "$D/tree" -c user.email=st@example.invalid -c user.name=st \
        -c commit.gpgsign=false "$@"; }
  mkdir -p "$D/tree/tools/tests"
  G init -q
  printf 'x\n' > "$D/tree/tools/x.sh"
  G add -A
  G commit -q -m 'fix(tools): bound the fetch timeout (#305)'
  FIX305="$(G rev-parse HEAD)"
  printf 'y\n' > "$D/tree/tools/y.sh"
  G add -A
  G commit -q -m 'fix(tools): a change about something else entirely

Issue-Ref: leshchenko1979/opencrabs-dev-factory#330'
  G checkout -q -b side
  printf 'z\n' > "$D/tree/tools/z.sh"
  G add -A
  G commit -q -m 'fix(tools): late fix (#331)'
  G checkout -q -
  # the RECEIPT — committed, PASS/fail 0/tree_changed false, and its subject
  # names #305 on purpose (see above).
  printf '{"verdict":"PASS","fail":0,"tree_changed":false,"pass":445,"ts":"2026-11-21T04:23:13Z"}\n' \
    > "$D/tree/tools/tests/battery-last.json"
  G add -A
  G commit -q -m 'chore(tests): battery receipt PASS 445/0 with the #305 bound in the tree'
  RECEIPT="$(G rev-parse HEAD)"
  # a SECOND receipt path that fails leg (i), so the disabled arm has a cause
  # that is leg (i) specifically and not a missing file.
  printf '{"verdict":"PASS","fail":3,"tree_changed":false,"pass":442,"ts":"2026-11-21T05:00:00Z"}\n' \
    > "$D/tree/tools/tests/bad.json"
  G add -A
  G commit -q -m 'chore(tests): a receipt with three failures'

  # `|| rc=$?` is NOT decoration: under `set -e`, a bare `out="$(cmd)"` whose
  # cmd fails EXITS the whole selftest at that line, so the leg that would have
  # named the failure never runs and the run prints NOTHING — an abort that
  # reads exactly like a crashed tool (measured here: the done-row mutant went
  # rc 3 with zero output until this was fixed).
  # The class (e) inputs are ALWAYS passed: the tool's own defaults point at the
  # LIVE repo, so a selftest that omitted them would assert against whatever the
  # working tree happens to contain — a fixture that changes with the tree it is
  # testing is not a fixture.
  sweep() { # extra args...
    rc=0
    out="$(OC_GH_BIN="$D/gh" GH_CALLS="$D/calls" "$SELF" --log "$D/log" --ledger "$D/ledger" \
      --repo o/one --repo o/two --board o/one --board o/two --e-repo o/one --tree "$D/tree" --battery "$D/tree/tools/tests/battery-last.json" \
      "$@" 2>"$D/err")" || rc=$?
  }
  # the DISABLED arm: an explicit --battery that fails leg (i). Same tree, so the
  # only thing that changed is the receipt.
  sweep_badbattery() { # extra args...
    rc=0
    out="$(OC_GH_BIN="$D/gh" GH_CALLS="$D/calls" "$SELF" --log "$D/log" --ledger "$D/ledger" \
      --repo o/one --repo o/two --board o/one --board o/two --e-repo o/one --tree "$D/tree" --battery "$D/tree/tools/tests/bad.json" \
      "$@" 2>"$D/err")" || rc=$?
  }
  # the #140 REPRO SHAPE: ONE close scope (`--repo`), BOTH boards checked
  # (`--board`). `--repo` must decide WHERE a close is written and never WHAT is
  # checked for a collision, so this run must still refuse a doubly-held number.
  sweep_narrow() { # extra args...
    rc=0
    out="$(OC_GH_BIN="$D/gh" GH_CALLS="$D/calls" "$SELF" --log "$D/log" --ledger "$D/ledger" \
      --repo o/one --board o/one --board o/two --e-repo o/one --tree "$D/tree" --battery "$D/tree/tools/tests/battery-last.json" \
      "$@" 2>"$D/err")" || rc=$?
  }
  # Tolerant on purpose: a leg that PARSES the JSON must never be the thing that
  # aborts the run. Without the fallback, a mutant that corrupts stdout kills the
  # script at the first json.load and the later legs never get to name their own
  # failure — one red masking four.
  rows() { python3 -c '
import json,sys
try:
    d=json.load(sys.stdin)
    print(json.dumps({r["issue"]:r for r in d["rows"]}, sort_keys=True))
except Exception:
    print("{}")
' ; }

  # ---- leg 1: the join is exactly the three pairs that have BOTH receipts ---
  : > "$D/calls"
  sweep --json
  GOT="$(printf '%s' "$out" | python3 -c 'import json,sys;print(",".join(str(r["issue"]) for r in sorted(json.load(sys.stdin)["rows"], key=lambda r: r["issue"])))' 2>/dev/null || echo PARSE-FAIL)"
  if [ "$rc" -eq 0 ] && [ "$GOT" = "260,279,300,305,310,320,321,322,323,330,331,332,333,340,341" ]; then
    t_ok "the join yields the class (d) pairs AND the class (e) done-only rows (rc=$rc)"
  else
    t_bad "join set (rc=$rc got=$GOT want=260,279,300,305,310,320,321,322,323,330,331,332,333,340,341 err=$(tr '\n' '|' < "$D/err"))"
  fi

  # ---- leg 2: PASS-LATE-ENTRY is eligible (#279 is the regression case) -----
  J="$(printf '%s' "$out" | rows)"
  V279="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("279",{}).get("verdict",""))')"
  if [ "$V279" = "PASS-LATE-ENTRY" ]; then
    t_ok "a PASS-LATE-ENTRY row is ELIGIBLE — the #279 miss cannot recur (verdict=$V279)"
  else
    t_bad "PASS-LATE-ENTRY eligibility (got='$V279' want=PASS-LATE-ENTRY)"
  fi

  # ---- leg 3: shape (4), the minimal row, parsed with optionals omitted ------
  V300="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("300",{}).get("verdict",""))')"
  A300="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("300",{}).get("action",""))')"
  if [ "$V300" = "PASS" ] && [ "$A300" = "skip-already-closed" ]; then
    t_ok "the minimal row (ts/PASS/issue=) parses, and a CLOSED issue is skipped not re-closed"
  else
    t_bad "minimal row / already-closed (verdict='$V300' action='$A300')"
  fi

  # ---- leg 4: shape (3), the identity block, must NOT be read as a verdict ---
  # The block appears AFTER #260's real row in the fixture and carries
  # issue=260, so with the timestamp discriminator removed it OVERWRITES that
  # row (append-only log, last wins) and #260's smoke_ts becomes the block's
  # field 1 — "/usr/local/bin/opencrabs". Assert the discriminator's own
  # observable, not a sha: grepping $out for "9999" was VACUOUS because $out is
  # --json and no row carries a sha field at all (mutation M1 proved it: the
  # leg stayed green while the join was corrupted, and only leg 9 noticed).
  T260="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("260",{}).get("smoke_ts",""))')"
  if [ "$T260" = "2026-11-01T10:00:00Z" ]; then
    t_ok "an identity-block line whose field 2 is 'PASS' is NOT read as a verdict row (260 keeps its own ts)"
  else
    t_bad "identity block leaked into the join (260 smoke_ts='$T260' want=2026-11-01T10:00:00Z)"
  fi

  # ---- leg 5: acceptance 3 — a done row with no smoke PASS is not eligible ---
  # #660: `<<<` not `printf | grep -q` — under pipefail an early-exiting grep
  # SIGPIPEs the writer, so the pipeline reports failure on a SUCCESSFUL match.
  # #305 is a done row with NO smoke verdict: under class (e) it IS a candidate
  # (the battery is its receipt), so the old assertion inverted. What must still
  # hold is that it carries the class (e) stream and claims no smoke at all — a
  # row that invented a verdict to look closable is the defect.
  V305="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("305",{}).get("verdict","MISSING"))')"
  if [ "$V305" = "" ]; then
    t_ok "a done row with NO smoke PASS is a class (e) candidate and claims no smoke verdict"
  else
    t_bad "issue 305 (done, no smoke) verdict='$V305' want='' (class e must not invent one)"
  fi

  # ---- leg 6: disqualifiers — off-taxonomy, retraction, FAIL, no-done-row ---
  bad=""
  for n in 302 303 304 306; do
    grep -q "\"$n\"" <<< "$J" && bad="$bad $n"
  done
  if [ -z "$bad" ]; then
    t_ok "off-taxonomy / RETRACTED / FAIL / no-done-row issues are all excluded"
  else
    t_bad "these must not be candidates:$bad"
  fi
  if grep -q 'OFF-TAXONOMY #302 PASS-ADDENDUM' "$D/err" && grep -q 'NO-DONE-ROW #306' "$D/err"; then
    t_ok "the excluded rows are REPORTED on stderr, not silently dropped"
  else
    t_bad "exclusion reasons missing from stderr ($(tr '\n' '|' < "$D/err"))"
  fi

  # ---- leg 6a (#140 face 2): a CORRECTION retracts an earlier PASS ---------
  # #350 carries a PASS row, a done row AND a CORRECTION row that names it, so on
  # the receipt PAIR alone it would close. That PASS+done pair is what makes this
  # NON-VACUOUS: a kill fixture whose number has no PASS cannot observe
  # `if tok in KILL` at all, and a mutant that neutered that branch once SURVIVED
  # against exactly such a fixture (recorded in this file's own comment above).
  # The live shape is smoke-verdicts.log:146 (PASS-LATE-ENTRY for #138) followed
  # by CORRECTION rows at :1206 and :1213.
  if ! grep -q '"350":' <<< "$J" && grep -q 'RETRACTED  #350 — a CORRECTION row names it' "$D/err"; then
    t_ok "a CORRECTION row RETRACTS an earlier PASS — #350 is not joined, and stderr names the token that killed it"
  else
    t_bad "CORRECTION retraction (350 in join=$(grep -c '"350":' <<< "$J") stderr=$(tr '\n' '|' < "$D/err"))"
  fi

  # ---- leg 5b: a done row whose `what` spans a NEWLINE or carries a quote ----
  # The join stream is read line-by-line with \x1f separators, so a raw newline
  # in a ledger detail shifts every field after it: the continuation line's text
  # lands in the ISSUE column and the row is emitted as prose. Measured live
  # 2026-11-21 — the real --json was UNPARSEABLE at char 56804, where a real
  # #401 detail had wrapped, and no fixture row had ever contained a newline.
  _shape="$(printf '%s' "$J" | python3 -c '
import json,sys
rows=json.load(sys.stdin)
bad=[k for k in rows if not k.isdigit()]
r=rows.get("332") or {}
print("%d|%d|%s" % (len(bad), 1 if r else 0, r.get("ledger_n","-")))
' 2>/dev/null || echo PARSE-FAIL)"
  if [ "$_shape" = "0|1|16" ]; then
    t_ok "a multi-line / quoted ledger detail keeps the stream aligned and the JSON parseable"
  else
    t_bad "ledger detail with a newline corrupted the join (non-int rows|332 rows|ledger_n = $_shape, want 0|1|16)"
  fi

  # ---- leg 5c: a class (e) number held by the WRONG tracker ----------------
  # #333 has a done row and no verdict, exactly like #305 — but its number lives
  # on o/two, not on the factory-shaped repo the skill repo's commits speak. A
  # commit subject carries NO repo, so closing it would assert that another
  # tracker's #333 was fixed here. Measured live 2026-11-21: fork#471 was one
  # dry run from exactly that close.
  A333="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("333",{}).get("action",""))')"
  if [ "$A333" = "skip-e-wrong-tracker" ] && grep -q 'CLASS-E-SKIPPED #333' "$D/err"; then
    t_ok "a class (e) number held by a NON-factory tracker is refused, and says why"
  else
    t_bad "wrong-tracker class (e) (action='$A333' want=skip-e-wrong-tracker)"
  fi

  # ---- leg 5d (#140 face 3): a `spoke` exclusion is NAMED -------------------
  # #351 is a class (e) shape — a done row and no verdict of its own — barred
  # because SOME row for that number exists (here: a FAIL on o/two). Before this
  # the bar was silent, which is indistinguishable from "no done row": factory
  # #138 qualifies for class (e) on its own receipts and was barred by fork
  # #138's September row with nothing on stderr. #305 is the POSITIVE CONTROL — a
  # done row nothing ever spoke about must NOT be reported as skipped, or a
  # message printed for every class (e) candidate would pass this leg.
  if grep -q 'CLASS-E-SKIPPED #351 — a row from o/two speaks the number (FAIL)' "$D/err" \
     && ! grep -q 'CLASS-E-SKIPPED #305' "$D/err" \
     && ! grep -q '"351":' <<< "$J"; then
    t_ok "a class (e) exclusion caused by a smoke row is NAMED with its board — and a done row nothing spoke about is not"
  else
    t_bad "class (e) exclusion naming (stderr=$(tr '\n' '|' < "$D/err"))"
  fi

  # ---- leg 6b: the SAME NUMBER on two OPEN trackers is reported, never closed
  A310="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("310",{}).get("action",""))')"
  if [ "$A310" = "skip-ambiguous" ] && grep -q 'AMBIGUOUS-TRACKER #310' "$D/err"; then
    t_ok "a number OPEN on BOTH trackers is AMBIGUOUS — reported on stderr, never closed on a guess"
  else
    t_bad "cross-tracker collision handling (action='$A310' want=skip-ambiguous)"
  fi

  # ---- leg 6c (#140 face 1): the #138 SHAPE is AMBIGUOUS -------------------
  # #340 is held by BOTH boards — o/one OPEN, o/two CLOSED. That is the live
  # shape of #134/#135/#136/#140 (measured 2026-11-22: 121 numbers held by both
  # boards, 4 of them a CLOSED fork copy shadowing an OPEN factory one). The
  # guard must fire on ANY open copy, not only when BOTH are OPEN, or those four
  # live cases are structurally unreachable.
  A340="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("340",{}).get("action",""))')"
  if [ "$A340" = "skip-ambiguous" ] && grep -q 'AMBIGUOUS-TRACKER #340' "$D/err"; then
    t_ok "a number held by BOTH boards in a CLOSED+OPEN mix is AMBIGUOUS — the #138 shape is refused, not closed"
  else
    t_bad "the #138 shape (340 action='$A340' want=skip-ambiguous; stderr=$(tr '\n' '|' < "$D/err"))"
  fi

  # ---- leg 6d (#140 face 1): a NAMED board resolves the collision ----------
  # #341 is held by both boards as well, but its own evidence carries a URL for
  # its OWN number, naming o/one. The row is then ATTRIBUTABLE: it must close on
  # o/one and never on the o/two copy (which is CLOSED — attributing there would
  # silently read as skip-already-closed and lose a real close).
  A341="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("341",{}).get("action",""))')"
  R341="$(printf '%s' "$J" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("341",{}).get("repo",""))')"
  if [ "$A341" = "would-close" ] && [ "$R341" = "o/one" ]; then
    t_ok "an evidence URL naming its OWN number resolves the collision — #341 closes on o/one, not on the other copy"
  else
    t_bad "evidence-URL attribution (341 action='$A341' repo='$R341' want=would-close/o/one)"
  fi

  # ---- leg 6e (#140 face 1): --repo narrows WHERE, never WHAT --------------
  # THE REPORTED REPRO, verbatim in shape: ONE close scope, BOTH boards checked.
  # Before the fix, `--repo` REPLACED the checked list, so #340 had one holder,
  # no collision was visible, and the sweep offered to close it. This leg is the
  # one that reddens when the board set is collapsed back onto the close scope —
  # legs 6c/6d cannot see that mutation, because there the two lists are equal.
  sweep_narrow --json
  NJ="$(printf '%s' "$out" | rows)"
  nact() { printf '%s' "$NJ" | python3 -c 'import json,sys;print(json.load(sys.stdin).get(sys.argv[1],{}).get("action",""))' "$1"; }
  if [ "$(nact 340)" = "skip-ambiguous" ] && [ "$(nact 341)" = "would-close" ] \
     && grep -q 'AMBIGUOUS-TRACKER #340' "$D/err"; then
    t_ok "--repo narrows WHERE a close is written, never WHAT is checked: the one-board scope still refuses #340"
  else
    t_bad "the #140 repro survives (narrow 340 action='$(nact 340)' want=skip-ambiguous; 341='$(nact 341)' want=would-close)"
  fi

  # ---- leg 7: dry run writes nothing to the tracker ------------------------
  if ! grep -q 'issue close' "$D/calls"; then
    t_ok "the default is a DRY RUN — no close call without --apply"
  else
    t_bad "dry run issued a close: $(tr '\n' '|' < "$D/calls")"
  fi

  # ---- leg 8/9: --apply closes through the shared path, citing both receipts
  : > "$D/calls"
  sweep --apply --json
  closed="$(grep -o 'issue close [0-9]*' "$D/calls" | awk '{print $3}' | sort -n | tr '\n' ' ')"
  if [ "$closed" = "260 279 305 322 323 341 " ]; then
    t_ok "--apply closes exactly the OPEN pairs (class (d) and (e)), leaves CLOSED #300 alone, and refuses AMBIGUOUS #340 (closed: $closed)"
  else
    t_bad "--apply close set (got='$closed' want='260 279 305 322 323 341 ')"
  fi
  if grep -q 'smoke verdict: PASS 2026-11-01T10:00:00Z sha=aaaa run=111' "$D/calls" \
     && grep -q 'ledger: done #260 n=1' "$D/calls"; then
    t_ok "the close comment cites BOTH receipts — the smoke verdict AND the ledger row"
  else
    t_bad "close comment is missing a receipt"
  fi
  if grep -q 'class (d) behavioural-smoke-landed' "$D/calls"; then
    t_ok "the comment carries the class (d) framing the live path writes"
  else
    t_bad "class (d) framing absent from the close comment"
  fi

  # ---- leg 9b: an ABSENT optional stays absent — no field shifting ----------
  # A PASS-LATE-ENTRY row has no run=. If the join used a TAB delimiter, the
  # empty run field would collapse and `evidence` would land in `run`, printing
  # `run=recorded late, receipts cited` and an EMPTY ledger excerpt. That is a
  # fabricated receipt on a public tracker, so it gets its own leg.
  if grep -q 'smoke verdict: PASS-LATE-ENTRY 2026-09-19T08:00:00Z sha=bbbb — recorded late, receipts cited' "$D/calls" \
     && grep -q 'ledger: done #279 n=2 — #279 — landed late' "$D/calls"; then
    t_ok "an ABSENT optional field stays absent — the late-entry receipt has no run= and no field shift"
  else
    t_bad "late-entry receipt shifted a field (calls=$(grep -c . "$D/calls") lines; look for run= on the #279 close)"
  fi

  # ---- legs 9c-9f: class (e) — a tools/** fix closes on the BATTERY ---------
  # The discriminator is the cited FIX SHA. The fixture's receipt commit names
  # #305 in its own subject, so a leg (iii) that scanned the receipt's ancestry
  # INCLUSIVE would cite the receipt as its own fix — a marker one act records
  # and re-reads, which is self-consistency and proves nothing. The live shape is
  # `chore(tests): battery receipt PASS 445/0 with the #80 log bound in the tree`.
  C305="$(grep -A3 'issue close 305' "$D/calls" | tr '\n' ' ' || true)"
  if [ -n "$C305" ] && [[ "$C305" == *"fix=$FIX305"* ]] && [[ "$C305" != *"fix=$RECEIPT"* ]]; then
    t_ok "class (e) cites the FIX commit, never the receipt that names the issue in its own subject"
  else
    t_bad "class (e) fix attribution (cited='${C305:0:200}' want fix=$FIX305)"
  fi
  if [[ "$C305" == *"receipt=$RECEIPT"* ]] && [[ "$C305" == *"class (e) battery-verified-landed"* ]]; then
    t_ok "class (e) cites the committed receipt sha and claims class (e), not class (d)"
  else
    t_bad "class (e) receipt/class framing (cited='${C305:0:200}')"
  fi
  # A `tools/**` fix runs NO behavioural smoke. A close comment asserting one is a
  # fabricated receipt on a public tracker — the exact reason the class label is a
  # PARAMETER of oc_close_on_receipt rather than a constant.
  if [[ "$C305" != *"class (d)"* ]] && [[ "$C305" != *"smoke verdict"* ]] && [[ "$C305" != *"behavioural"* ]]; then
    t_ok "a class (e) close claims NO behavioural smoke — the label is the caller's, not a constant"
  else
    t_bad "class (e) close carries class (d) / behavioural framing (cited='${C305:0:200}')"
  fi

  # The two negative arms, from a DRY RUN: a trailer is a claim, and a fix that
  # postdates the receipt is not in its ancestry.
  : > "$D/calls"
  sweep --json
  EJ="$(printf '%s' "$out" | rows)"
  eact() { printf '%s' "$EJ" | python3 -c 'import json,sys;print(json.load(sys.stdin).get(sys.argv[1],{}).get("action",""))' "$1"; }
  A330="$(eact 330)"; A331="$(eact 331)"
  if [ "$A330" = "skip-no-subject" ] && [ "$A331" = "skip-not-ancestor" ]; then
    t_ok "a trailer-only reference closes nothing, and a fix AFTER the receipt fails the ancestry leg"
  else
    t_bad "class (e) negative arms (330 action='$A330' want=skip-no-subject; 331 action='$A331' want=skip-not-ancestor)"
  fi

  # An unusable receipt must be a NAMED refusal, never a silent zero: with a
  # receipt carrying fail=3 every class (e) candidate reports the leg (i) reason.
  sweep_badbattery --json
  BJ="$(printf '%s' "$out" | rows)"
  B305="$(printf '%s' "$BJ" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("305",{}).get("action",""))')"
  if [ "$B305" = "skip-no-battery" ] && grep -q 'leg (i) failed' "$D/err"; then
    t_ok "a receipt that fails leg (i) DISABLES class (e) and names the reason on stderr"
  else
    t_bad "class (e) disabled arm (305 action='$B305' want=skip-no-battery; stderr=$(tr '\n' '|' < "$D/err"))"
  fi

  # ---- leg 10: missing input is rc 3, never an empty clean sweep ------------
  rc=0
  OC_GH_BIN="$D/gh" GH_CALLS="$D/calls" "$SELF" --log "$D/nope.log" --ledger "$D/ledger" --repo o/one >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 3 ]; then
    t_ok "a missing smoke log is rc 3 — an absent input is never a clean zero"
  else
    t_bad "missing log must be rc 3 (got $rc)"
  fi

  # ---- legs 11-13: the T-7 park mirrors — a catch-up path no WEAKER than live
  # The entire eligible set of the fork sweep was five reopened parks, so these
  # rows are the exact production shape. Each park is named by ONE matcher only
  # (#320 by PARKED-OWNER-EYE, #321 by behavioral=absent), which is why removing
  # either matcher reddens exactly one of these legs rather than both.
  #
  # These legs re-derive their OWN dry run rather than reusing $J: $J was
  # captured at leg 2, and $out was overwritten by the --apply run at leg 8, so
  # reading either one here compares a dry-run action against an apply outcome
  # (measured: 322/323 read 'would-close' and were reported as over-refused).
  : > "$D/calls"
  sweep --json
  PJ="$(printf '%s' "$out" | rows)"
  act() { printf '%s' "$PJ" | python3 -c 'import json,sys;print(json.load(sys.stdin).get(sys.argv[1],{}).get("action",""))' "$1"; }

  A320="$(act 320)"; A321="$(act 321)"
  if [ "$A320" = "skip-parked" ] && [ "$A321" = "skip-parked" ]; then
    t_ok "a PASS whose evidence names a PARKED leg is NOT closable (PARKED-OWNER-EYE and behavioral=absent both caught)"
  else
    t_bad "park guards (320 action='$A320' want=skip-parked; 321 action='$A321' want=skip-parked)"
  fi

  # A catch-up path that quietly declines to close is indistinguishable from one
  # that found nothing. The count and the stderr lines are the difference.
  PCOUNT="$(printf '%s' "$out" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("parked","MISSING"))' 2>/dev/null || echo PARSE-FAIL)"
  if [ "$PCOUNT" = "2" ] && grep -q 'PARKED-OWNER-EYE #320' "$D/err" && grep -q 'PARKED-OWNER-EYE #321' "$D/err"; then
    t_ok "parked rows are a NAMED bucket (count=$PCOUNT) and each is reported on stderr, never silently dropped"
  else
    t_bad "parked bucket (count='$PCOUNT' want=2; stderr=$(tr '\n' '|' < "$D/err"))"
  fi

  # POSITIVE CONTROL — the guard must not refuse sound closes. Without this, a
  # guard matching every `behavioral=` token, or the bare word `parked`, passes
  # both legs above while refusing real work. Leg 8 already proves these two
  # actually CLOSE on --apply; this leg proves the guard is why they survive.
  A322="$(act 322)"; A323="$(act 323)"
  if [ "$A322" = "would-close" ] && [ "$A323" = "would-close" ]; then
    t_ok "behavioral=na stays closable, and the BARE WORD 'parked' in a sound close is not refused"
  else
    t_bad "park guard over-refused (322 action='$A322' want=would-close; 323 action='$A323' want=would-close)"
  fi

  # ---- #132: CLAIMS RECONCILIATION (tracker state joined to OPEN claims) ----
  # DEDICATED fixtures — their own ledger, gh stub and release writer — so these
  # legs cannot perturb the tracker fixtures the class (d)/(e) legs above depend
  # on. The smoke log is EMPTY on purpose: an empty join leaves the claims leg as
  # the only thing running, which is what makes each assertion below unambiguous.
  cat > "$D/cl-ledger" <<'CLLEDGER'
{"events":[
 {"n":100,"t":"2026-11-10T09:00:00Z","kind":"claim","by":"11111111-1111-1111-1111-111111111111","what":"#777 CLAIM — stale: CLOSED on the tracker, no ledger close row"},
 {"n":101,"t":"2026-11-10T09:01:00Z","kind":"claim","by":"22222222-2222-2222-2222-222222222222","what":"#310 CLAIM — live: OPEN on both boards"},
 {"n":102,"t":"2026-11-10T09:02:00Z","kind":"claim","by":"33333333-3333-3333-3333-333333333333","what":"#888 CLAIM — ambiguous: CLOSED on o/one, OPEN on o/two"}
]}
CLLEDGER

  # 777 is CLOSED on o/two and ABSENT from o/one  -> STALE (release it)
  # 310 is OPEN on both                           -> LIVE
  # 888 is CLOSED on o/one and OPEN on o/two      -> AMBIGUOUS (never release)
  cat > "$D/cl-gh" <<'CLSTUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$CL_GH_CALLS"
case "$1 $2" in
  "issue list")
    case "$4" in
      o/one) echo '[{"number":310,"state":"OPEN"},{"number":888,"state":"CLOSED"}]' ;;
      o/two) echo '[{"number":310,"state":"OPEN"},{"number":888,"state":"OPEN"},{"number":777,"state":"CLOSED"}]' ;;
      *) echo '[]' ;;
    esac ;;
  "issue view") echo OPEN ;;
  "issue close") echo "closed #$3" ;;
esac
exit 0
CLSTUB
  chmod +x "$D/cl-gh"

  # The release writer is stubbed so a leg can prove WHAT was written (and to
  # WHOM) without a real ledger write, and so another leg can force a failure.
  cat > "$D/cl-ledger-bin" <<'CLLEDGERBIN'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$CL_REL_CALLS"
if [ "${CL_REL_RC:-0}" = "0" ]; then echo "stamped"; exit 0; fi
echo "ledger: boom" >&2
exit "${CL_REL_RC}"
CLLEDGERBIN
  chmod +x "$D/cl-ledger-bin"

  : > "$D/cl-log"        # empty smoke log: the claims leg runs alone
  : > "$D/cl-rel-calls"
  : > "$D/cl-gh-calls"

  cl_run() { # runs the sweep against the claims fixture; extra args pass through
    : > "$D/cl-rel-calls"
    rc=0
    CL_GH_CALLS="$D/cl-gh-calls" CL_REL_CALLS="$D/cl-rel-calls" \
      OC_GH_BIN="$D/cl-gh" OC_CLOSURE_LEDGER_BIN="$D/cl-ledger-bin" \
      "$SELF" --json --log "$D/cl-log" --ledger "$D/cl-ledger" --repo o/one --repo o/two --board o/one --board o/two "$@" \
      >"$D/cl-out" 2>"$D/cl-err" || rc=$?
  }
  cl_f() { python3 -c 'import json,sys;print(json.load(open(sys.argv[2])).get(sys.argv[1],"MISSING"))' "$1" "$D/cl-out" 2>/dev/null || echo PARSE-FAIL; }

  # ---- leg A: DRY RUN classifies all three and writes NOTHING --------------
  cl_run
  if [ "$(cl_f claim_stale)" = "1" ] && [ "$(cl_f claim_live)" = "2" ] \
     && [ "$(cl_f claim_ambiguous)" = "1" ] && [ "$(cl_f claim_released)" = "0" ] \
     && [ ! -s "$D/cl-rel-calls" ]; then
    t_ok "claims: a dry run names the stale claim, leaves the live and ambiguous ones, and writes nothing"
  else
    t_bad "claims dry run (stale=$(cl_f claim_stale) live=$(cl_f claim_live) ambig=$(cl_f claim_ambiguous) released=$(cl_f claim_released) writes=$(wc -l < "$D/cl-rel-calls"))"
  fi

  # ---- leg B: the dry run SAYS SO, it does not merely count ---------------
  # A counters-only stream cannot be read by the operator who has to decide
  # whether to trust the release, so this leg drives the HUMAN path (no --json)
  # and requires the rows in words.
  : > "$D/cl-rel-calls"
  rc=0
  CL_GH_CALLS="$D/cl-gh-calls" CL_REL_CALLS="$D/cl-rel-calls" \
    OC_GH_BIN="$D/cl-gh" OC_CLOSURE_LEDGER_BIN="$D/cl-ledger-bin" \
    "$SELF" --log "$D/cl-log" --ledger "$D/cl-ledger" --repo o/one --repo o/two --board o/one --board o/two \
    >"$D/cl-out" 2>"$D/cl-err" || rc=$?
  if grep -q 'CLAIM-STALE' "$D/cl-out" && grep -q 'CLAIM-AMBIGUOUS' "$D/cl-out" \
     && grep -q '#777' "$D/cl-out" && grep -q '#888' "$D/cl-out"; then
    t_ok "claims: the dry run reports the stale and the ambiguous rows in words, not just as counters"
  else
    t_bad "claims dry-run rows (out=$(tr '\n' '|' < "$D/cl-out"))"
  fi

  # ---- leg C: --apply releases EXACTLY the stale claim, AS THE CLAIMING LANE --
  # The attribution arm is the point: claim_is_closed()'s addressed arm retires
  # on a row from ANY actor, so a sweeper writing as ITSELF could clear another
  # lane's reservation. `--by` must be the claim's own uuid.
  cl_run --apply
  if [ "$(cl_f claim_released)" = "1" ] && [ "$(wc -l < "$D/cl-rel-calls")" = "1" ]; then
    t_ok "claims: --apply releases exactly one claim (the stale one), not the live or the ambiguous"
  else
    t_bad "claims apply (released=$(cl_f claim_released) calls=$(wc -l < "$D/cl-rel-calls"))"
  fi
  if grep -q '#777' "$D/cl-rel-calls" \
     && grep -q -- '--by 11111111-1111-1111-1111-111111111111' "$D/cl-rel-calls" \
     && ! grep -q '#888' "$D/cl-rel-calls" && ! grep -q '#310' "$D/cl-rel-calls"; then
    t_ok "claims: the release row is written AS THE CLAIMING LANE and names only the stale issue"
  else
    t_bad "claims attribution (calls=$(tr '\n' '|' < "$D/cl-rel-calls"))"
  fi

  # ---- leg D: the release row is SWEPT, NOT ATTESTED ----------------------
  # A sweeper reporting "verified closed" when all it did was read a tracker
  # state has written a false attestation into the ledger.
  if grep -q 'SWEPT, NOT ATTESTED' "$D/cl-rel-calls"; then
    t_ok "claims: the release row states it SWEPT the tracker state and did not attest the work"
  else
    t_bad "claims release row must be marked SWEPT, NOT ATTESTED (calls=$(tr '\n' '|' < "$D/cl-rel-calls"))"
  fi

  # ---- leg E: a failed release is COUNTED, not swallowed ------------------
  rc=0
  CL_REL_RC=3 CL_GH_CALLS="$D/cl-gh-calls" CL_REL_CALLS="$D/cl-rel-calls" \
    OC_GH_BIN="$D/cl-gh" OC_CLOSURE_LEDGER_BIN="$D/cl-ledger-bin" \
    "$SELF" --json --apply --log "$D/cl-log" --ledger "$D/cl-ledger" --repo o/one --repo o/two --board o/one --board o/two \
    >"$D/cl-out" 2>"$D/cl-err" || rc=$?
  if [ "$(cl_f claim_release_failed)" = "1" ] && [ "$(cl_f claim_released)" = "0" ] && [ "$rc" -eq 1 ]; then
    t_ok "claims: a release that fails is counted as failed, not reported as released — and rc is 1, not a silent 0"
  else
    t_bad "claims release failure (failed=$(cl_f claim_release_failed) released=$(cl_f claim_released) rc=$rc want=1)"
  fi

  # ---- leg F: POSITIVE CONTROL — no claims means every counter is 0 -------
  # Without this, a leg that hard-codes stale=1, or that reads a fixture instead
  # of the ledger, passes every assertion above.
  printf '{"events":[]}\n' > "$D/cl-empty"
  : > "$D/cl-rel-calls"
  rc=0
  CL_GH_CALLS="$D/cl-gh-calls" CL_REL_CALLS="$D/cl-rel-calls" \
    OC_GH_BIN="$D/cl-gh" OC_CLOSURE_LEDGER_BIN="$D/cl-ledger-bin" \
    "$SELF" --json --log "$D/cl-log" --ledger "$D/cl-empty" --repo o/one --repo o/two --board o/one --board o/two \
    >"$D/cl-out" 2>"$D/cl-err" || rc=$?
  if [ "$(cl_f claim_stale)" = "0" ] && [ "$(cl_f claim_live)" = "0" ] \
     && [ "$(cl_f claim_ambiguous)" = "0" ] && [ "$(cl_f claim_released)" = "0" ] \
     && [ ! -s "$D/cl-rel-calls" ]; then
    t_ok "claims: an empty ledger yields zeros across the board and writes nothing (positive control)"
  else
    t_bad "claims positive control (stale=$(cl_f claim_stale) live=$(cl_f claim_live) writes=$(wc -l < "$D/cl-rel-calls"))"
  fi

  printf 'oc-closure-sweep selftest: %s passed, %s failed\n' "$pass" "$fail"
  [ "$fail" -eq 0 ] || exit 1
  exit 0
}

if [ "$MODE" = selftest ]; then
  run_selftest
fi

[ -f "$LOG" ]    || die 3 "smoke log not found: $LOG"
[ -r "$LOG" ]    || die 3 "smoke log not readable: $LOG"
[ -f "$LEDGER" ] || die 3 "ledger not found: $LEDGER"
[ -r "$LEDGER" ] || die 3 "ledger not readable: $LEDGER"

command -v oc_close_on_receipt >/dev/null 2>&1 \
  || die 3 "lib/oc-gh-close.sh missing — refusing to close through a second code path"

# ---------------------------------------------------------------------------
# THE JOIN. Python does the two file parses (a 1805-line log with mixed row
# shapes and a JSON ledger); bash does the tracker reads and the closes, because
# the gh stub in the selftest must be observable.
#
# Output: one US-delimited line per CANDIDATE:
#   issue \x1f ledger_n \x1f ledger_ts \x1f verdict \x1f smoke_ts \x1f sha \x1f run \x1f evidence \x1f what \x1f class \x1f e_tracker
#
# `e_tracker` is the board the row's own `evidence` names, IFF it names THIS
# number (#140 face 1); empty otherwise, which is the measured norm (4 of 363).
# The class (e) stream always leaves it empty: it claims nothing about a smoke.
#
# TWO candidate streams, one line shape:
#   class `smoke`  — a smoke PASS and a `done` row (class (d), the T-10 join).
#   class `e`      — a `done` row and NO smoke verdict: a `tools/**` fix writes
#                    no behavioural smoke, the harness battery IS its receipt
#                    (triage.md §Autonomous closure class (e), HQ 2026-11-20).
#                    The three legs are proved in BASH, against git, because the
#                    selftest must be able to observe them; here the row is only
#                    declared, with an EMPTY verdict payload.
# A done-only issue that a RETRACTION names is in neither stream: the retraction
# is a kill for the whole number, not just for its smoke half.
#
# The separator is the ASCII UNIT SEPARATOR, never a TAB. TAB is IFS WHITESPACE,
# so `IFS=$'\t' read` COLLAPSES a run of tabs into one delimiter and an EMPTY
# field silently shifts every field after it — measured in this file's own
# selftest: a PASS-LATE-ENTRY row carries no run=, so #279's receipt read
# `run=recorded late, receipts cited` and its ledger excerpt came out empty.
# A non-whitespace separator makes an empty field representable, which is the
# whole requirement (optionals are OMITTED, never emitted as empty values).
# stderr: diagnostics (off-taxonomy rows, retraction kills, unparsable lines)
# ---------------------------------------------------------------------------
JOIN="$(python3 - "$LOG" "$LEDGER" <<'PY'
import json, re, sys

# Sanctioned PASS family only (upstream-merge-runbook.md §Verdict taxonomy).
PASS = {"PASS", "PASS-LATE-ENTRY", "PASS-OWNER-EYE", "PASS-CALLBACK-LIVE"}
# Look like PASSes, are not in the taxonomy: reported, never closable.
OFF  = {"PASS-ADDENDUM", "OWNER-EYE-CONFIRM", "ADDENDUM"}
# Tokens that WITHDRAW a PASS. CORRECTION belongs here because a correction row
# is the author disavowing the verdict it names — leaving it out means a row its
# own author withdrew still closes the issue (#140 face 2; measured live on #138,
# whose PASS-LATE-ENTRY at smoke-verdicts.log:146 is followed by CORRECTION rows
# at :1206 and :1213). KILL is consulted before PASS, so a CORRECTION row wins
# over an earlier PASS for the same number.
KILL = {"RETRACTION", "CORRECTION"}
TS   = re.compile(r"^\d{4}-\d{2}-\d{2}T")
HASH = re.compile(r"#(\d+)\b")
# An issue URL in a row's `evidence` (#140 face 1). This is the ONE place a row
# can NAME its own tracker, and it is rare: measured 2026-11-22, 4 of 363 PASS
# rows carry any issue URL, and 3 of those 4 name their own number. So it is a
# POSITIVE discriminator only — when it is present and names THIS number the row
# is attributed to that board; when it is absent nothing is inferred, because
# refusing every row without a URL would refuse 360 of 363 class (d) closes and
# turn a false close into a permanent false debt.
URL = re.compile(r"https?://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+)/issues/(\d+)")


def evidence_tracker(ev, iss):
    """The board a row's own evidence names, IFF it names THIS number."""
    for m in URL.finditer(ev or ""):
        if m.group(3) == iss:
            return "%s/%s" % (m.group(1), m.group(2))
    return ""

log_path, ledger_path = sys.argv[1], sys.argv[2]

verdict_of = {}   # issue -> newest eligible PASS record
off_of     = {}   # issue -> newest off-taxonomy record
killed     = set()
killed_by  = {}     # issue -> the token that withdrew its PASS (#140 face 2)
spoke      = set()  # issues ANY timestamped row speaks about (any token, PASS or not)
spoke_by   = {}     # issue -> (token, board-or-"") of the row that spoke it (#140 face 3)
unparsed   = 0

for raw in open(log_path, encoding="utf-8", errors="replace"):
    line = raw.rstrip("\n")
    if not line.strip():
        continue
    f = line.split("\t")
    if len(f) < 2:
        unparsed += 1
        continue
    # Shape (3): an identity block line carries key=value pairs whose SECOND
    # field can be a verdict token. Field 1 is the discriminator: every real
    # verdict row begins with an ISO timestamp.
    if not TS.match(f[0]):
        continue
    tok = f[1].strip()
    kv = {}
    for field in f[2:]:
        if "=" in field:
            k, _, v = field.partition("=")
            kv.setdefault(k, v)          # first occurrence wins
    # Record that the SMOKE SURFACE spoke about this issue at all, before any
    # token filtering. Class (e) is for a fix that writes no smoke verdict, so an
    # issue with a FAIL (or any other token) row is NOT class (e): the smoke
    # surface has answered, and its answer is not a PASS.
    for t in (kv.get("issue") or "").split(","):
        t = t.strip().lstrip("#")
        if t.isdigit():
            spoke.add(t)
            # ... and remember WHICH row spoke it, and which board that row's
            # evidence names (usually none), so the class (e) exclusion can be
            # REPORTED instead of silently applied (#140 face 3).
            spoke_by[t] = (tok, evidence_tracker(kv.get("evidence", ""), t))
    if tok in KILL:
        # SCOPE THE KILL to the row's own issue= field when it carries one.
        # A hash scan of the whole LINE also harvests every #N quoted inside
        # evidence=, so a retraction OF #94 whose rationale merely MENTIONS
        # #260 would silently kill #260 as well — a PASS revoked by an
        # unrelated row. Measured shapes: live retraction rows carry
        # `issue=#94`, and CORRECTION rows carry `issue=#236,#246,...`, so the
        # field is comma-separated and each token keeps its `#`.
        # Fall back to the line scan ONLY when the field is absent: a
        # retraction that names no issue must still kill something (failing to
        # kill is the dangerous direction — it would let a revoked PASS close).
        _named = [t.strip().lstrip("#") for t in (kv.get("issue") or "").split(",")]
        _named = [t for t in _named if t.isdigit()]
        if _named:
            killed.update(_named)
            for _n in _named:
                killed_by.setdefault(_n, tok)
        else:
            for m in HASH.finditer(line):
                killed.add(m.group(1))
                killed_by.setdefault(m.group(1), tok)
        continue
    if tok not in PASS and tok not in OFF:
        continue
    iss = kv.get("issue", "").strip().lstrip("#")
    if not iss.isdigit():
        continue                         # unattributable row: cannot be joined
    rec = {
        "verdict": tok, "ts": f[0], "sha": kv.get("sha", ""),
        "run": kv.get("run", ""), "target": kv.get("target", ""),
        "evidence": kv.get("evidence", ""),
    }
    if tok in OFF:
        off_of[iss] = rec                # last wins; still never closable
    else:
        verdict_of[iss] = rec            # append-only log: last wins = newest

done_of = {}   # issue -> (n, t, what) newest done row naming it
try:
    doc = json.load(open(ledger_path, encoding="utf-8"))
except Exception as exc:                  # noqa: BLE001 - report, never guess
    sys.stderr.write("ledger unreadable: %s\n" % exc)
    sys.exit(3)

for e in doc.get("events", []):
    if not isinstance(e, dict) or e.get("kind") != "done":
        continue
    what = e.get("what") or ""
    n = e.get("n") or 0
    t = e.get("t") or ""
    for m in HASH.finditer(what):
        iss = m.group(1)
        prev = done_of.get(iss)
        if prev is None or n >= prev[0]:
            done_of[iss] = (n, t, what)

for iss in sorted(off_of, key=lambda x: int(x)):
    sys.stderr.write("OFF-TAXONOMY #%s %s — not closable (taxonomy does not sanction the token)\n"
                     % (iss, off_of[iss]["verdict"]))
for iss in sorted(killed, key=lambda x: int(x)):
    if iss in verdict_of:
        sys.stderr.write("RETRACTED  #%s — a %s row names it; the earlier PASS does not close\n"
                         % (iss, killed_by.get(iss, "KILL")))
for iss in sorted(verdict_of, key=lambda x: int(x)):
    if iss in killed:
        continue
    if iss not in done_of:
        sys.stderr.write("NO-DONE-ROW #%s has a %s but no ledger done row — no receipt PAIR\n"
                         % (iss, verdict_of[iss]["verdict"]))
        continue
    v = verdict_of[iss]
    n, t, what = done_of[iss]
    # One-line, separator-free: the stream is read with `read -r` per LINE, so a
    # raw \n does not merely look ugly, it moves every later field one row down
    # and the continuation text is emitted as an issue number.
    what = " ".join(what.split())
    if len(what) > 200:
        what = what[:197] + "..."
    ev = " ".join(v["evidence"].split())
    print("\x1f".join([iss, str(n), t, v["verdict"], v["ts"],
                       v["sha"], v["run"], ev, what, "smoke",
                       evidence_tracker(v["evidence"], iss)]))

# CLASS (e) stream — a `done` row and NO smoke verdict at all. The empty verdict
# fields are DELIBERATE: this stream claims nothing about a smoke, and the three
# battery legs are proved in bash so the selftest can watch each one fail on its
# own. A retracted number is excluded here too — the kill is scoped to the
# NUMBER, so a done-only issue whose verdict was withdrawn must not slip back in
# through the class (e) door.
#
# FACE 3 (#140) — SAY WHY. `spoke` is filled by ANY timestamped row, and a
# foreign row silently barring a legitimate tools/** fix is indistinguishable
# from "no done row at all": factory #138 qualifies for class (e) on its own
# receipts and was barred by fork #138's September row, with nothing on stderr.
# So every exclusion CAUSED by `spoke` is named, with the token and — when that
# row's own evidence names its board — the board. The kill case is not named
# here: RETRACTED above already explains it.
for iss in sorted(done_of, key=lambda x: int(x)):
    if iss in spoke or iss in killed:
        if iss not in killed and iss not in verdict_of:
            _tok, _trk = spoke_by.get(iss, ("?", ""))
            sys.stderr.write(
                "CLASS-E-SKIPPED #%s — a row from %s speaks the number (%s); class (e) "
                "needs a fix that writes NO smoke verdict\n" % (iss, _trk or "a row", _tok))
        continue
    n, t, what = done_of[iss]
    what = " ".join(what.split())
    if len(what) > 200:
        what = what[:197] + "..."
    print("\x1f".join([iss, str(n), t, "", "", "", "", "", what, "e", ""]))
PY
)" || die 3 "join FAILED (python3 rc=$?)"

# ---------------------------------------------------------------------------
# Tracker resolution. ONE list call per BOARD, then the join is local.
#
# WHY NOT `gh issue view` PER CANDIDATE: the candidate set is ~300, and a live
# dry run of the per-issue form spent minutes on reads that mostly FAILED
# because the number lives on the OTHER tracker. Two list calls answer the same
# question for every candidate at once, and — the point — they answer the
# question a per-issue read cannot: does this number exist on MORE THAN ONE
# tracker? Closing on a guess there would close a different issue's number.
#
# THE LIST IS THE BOARD SET, NEVER `--repo` (#140 face 1). A sweep narrowed to
# one board must still know what the other board holds, or the ambiguity it
# exists to refuse is invisible — that is exactly how fork#138's PASS came to
# close factory#138. A board that cannot be read therefore fails the run even
# when it is outside the close scope: "cannot check" is not "clean".
# ---------------------------------------------------------------------------
declare -A TRACKER_OF=()   # "repo|number" -> STATE
CAND=0; ELIGIBLE=0; ALREADY=0; APPLIED=0; FAILED=0; ABSENT=0; AMBIG=0; PARKED=0
CE_NOT=0     # class (e) candidates that failed a battery leg (a named debt, never a silent skip)
CE_OK=0      # class (e) candidates whose three legs held
JSON_ROWS=""

add_json() { # issue state verdict smoke_ts ledger_n action [repo] [class]
  # A `[ ... ] && x=...` tail returns 1 when the test fails, and under `set -e`
  # that KILLS the caller mid-loop — the run then printed the first row and
  # aborted, which read as a truncated tracker call rather than a shell fault.
  local _cls="${8:-}" _rts=""
  if [ "$_cls" = "e" ]; then _rts="$CE_TS"; fi
  JSON_ROWS="${JSON_ROWS}${JSON_ROWS:+,}{\"issue\":$1,\"state\":\"$2\",\"verdict\":\"$3\",\"smoke_ts\":\"$4\",\"ledger_n\":$5,\"action\":\"$6\",\"repo\":\"${7:-}\",\"class\":\"$_cls\",\"receipt_ts\":\"$_rts\"}"
  return 0
}

# The CLOSE SCOPE as a lookup (`--repo`), kept distinct from the BOARD SET
# (`--board`) that is checked for collisions. See the holder block in the loop.
declare -A REPO_SCOPE=()
for _r in "${REPOS[@]}"; do REPO_SCOPE["$_r"]=1; done

for _r in "${BOARDS[@]}"; do
  _lst="$("$GH_BIN" issue list --repo "$_r" --state all --limit 1000 --json number,state 2>&1)" || {
    die 3 "cannot list issues on $_r — a board that cannot be READ is not a clean sweep (${_lst//$'\n'/ })"
  }
  while IFS=$'\x1f' read -r _num _st; do
    [ -n "${_num:-}" ] || continue
    TRACKER_OF["$_r|$_num"]="$_st"
  done < <(printf '%s' "$_lst" | python3 -c '
import json,sys
try:
    for r in json.load(sys.stdin):
        print("%s\x1f%s" % (r["number"], r["state"]))
except Exception:
    pass
')
done

[ "$JSON" -eq 1 ] || {
  printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' ISSUE REPO STATE VERDICT SMOKE-TS LEDGER ACTION
  printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' ------- -------- ----------- ------------------ --------------------- ------ ------
}

short_repo() { case "$1" in leshchenko1979/opencrabs-dev-factory) echo factory ;; *) echo "${1##*/}" ;; esac; }

# ---------------------------------------------------------------------------
# CLASS (e) — the battery receipt, resolved ONCE, and the three legs as three
# separate functions so the selftest can red exactly one at a time.
#
# WHY THE COMMITTED BLOB, NOT THE WORKING COPY: the battery rewrites
# battery-last.json on every run, so the file on disk is a receipt for a run
# that may be five minutes old and uncommitted. The record is the blob at the
# commit that touched it — that is what a later reader can re-derive. Reading
# the working copy would let an uncommitted green run close a public issue.
#
# WHY STRICTLY BEFORE THE RECEIPT COMMIT: `git merge-base --is-ancestor` is TRUE
# for equal shas, and the receipt commit's own subject routinely NAMES the issue
# it closes ("chore(tests): battery receipt PASS 445/0 with the #80 log bound in
# the tree"). Without the exclusion, legs (ii) and (iii) would both be satisfied
# by the receipt citing itself — a marker one act records and re-reads, which is
# self-consistency and proves nothing.
# ---------------------------------------------------------------------------
CE_ON=0; CE_WHY=""; CE_SHA=""; CE_TS=""; CE_REL=""; CE_LOG=""
ce_disable() { CE_ON=0; CE_WHY="$1"; }

if [ -z "${TREE:-}" ] || ! git -C "$TREE" rev-parse --git-dir >/dev/null 2>&1; then
  ce_disable "no git tree ('${TREE:-<empty>}') — cannot judge an ancestry leg"
elif [ ! -f "$BATTERY" ]; then
  ce_disable "no battery receipt at $BATTERY"
else
  CE_REL="$(python3 -c '
import os, sys
rel = os.path.relpath(sys.argv[1], sys.argv[2])
if rel.startswith(".."):
    sys.exit(3)
print(rel)
' "$BATTERY" "$TREE" 2>/dev/null)" || CE_REL=""
  if [ -z "$CE_REL" ]; then
    ce_disable "$BATTERY is outside the tree $TREE"
  else
    CE_SHA="$(git -C "$TREE" log -1 --format=%H -- "$CE_REL" 2>/dev/null)" || CE_SHA=""
    if [ -z "$CE_SHA" ]; then
      ce_disable "$CE_REL has no commit in $TREE — the receipt is not on the record"
    else
      # leg (i) — read the COMMITTED blob. One python call, three assertions, and
      # it PRINTS the ts so the close comment can cite the run it rests on.
      _ce="$(git -C "$TREE" show "$CE_SHA:$CE_REL" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception as exc:
    sys.stderr.write("unparsable: %s\n" % exc); sys.exit(1)
bad = []
if d.get("verdict") != "PASS":      bad.append("verdict=%r" % d.get("verdict"))
if d.get("fail") != 0:              bad.append("fail=%r" % d.get("fail"))
if d.get("tree_changed") is not False: bad.append("tree_changed=%r" % d.get("tree_changed"))
if bad:
    sys.stderr.write("leg (i) failed: %s\n" % ", ".join(bad)); sys.exit(1)
print(d.get("ts") or "")
' 2>&1)" || { ce_disable "committed receipt $CE_SHA:$CE_REL fails leg (i): ${_ce//$'\n'/ }"; }
      if [ "$CE_ON" -ne 0 ] || [ -z "$CE_WHY" ]; then CE_TS="$_ce"; fi
      if [ -z "$CE_WHY" ]; then
        CE_LOG="$(git -C "$TREE" log --all --format='%H%x1f%s' 2>/dev/null)" || CE_LOG=""
        if [ -z "$CE_LOG" ]; then
          ce_disable "receipt commit $CE_SHA has no history before it"
        else
          CE_ON=1
        fi
      fi
    fi
  fi
fi

# leg (iii) — the fix commit's OWN SUBJECT names the issue. A trailer is a
# CLAIM: #112's `Issue-Ref:` sat on a commit about the verdict-rc alarm while its
# real fix was 2d66803e, so a trailer-keyed sweep closes issues on collateral
# references. Newest-first scan, and the match must be `#N` as a whole number
# (#105 must not be satisfied by #1055).
#
# TWO scans, because the two legs must be separately observable: `ce_named_any`
# proves the subject leg has a candidate at all, `ce_fix_sha` keeps only the ones
# the receipt can actually descend from. A single scan over the ancestry makes
# leg (ii) structurally unreachable — a guard that cannot be seen firing proves
# nothing — and it is the unmerged-branch case (fix pushed, receipt predates the
# merge) that leg (ii) exists to refuse.
ce_named_any() {
  local n="$1" sha subj
  while IFS=$'\x1f' read -r sha subj; do
    [ -n "${sha:-}" ] || continue
    if [[ "$subj" =~ (^|[^0-9])#$n([^0-9]|$) ]]; then printf '%s' "$sha"; return 0; fi
  done <<< "$CE_LOG"
  return 1
}
ce_fix_sha() {
  local n="$1" sha subj
  while IFS=$'\x1f' read -r sha subj; do
    [ -n "${sha:-}" ] || continue
    # `merge-base --is-ancestor A B` is true when A == B, so without the
    # inequality a receipt whose own subject names the issue cites ITSELF as the
    # fix — the exact self-consistency this pair of scans exists to break.
    if [[ "$subj" =~ (^|[^0-9])#$n([^0-9]|$) ]] \
       && [ "$sha" != "$CE_SHA" ] \
       && git -C "$TREE" merge-base --is-ancestor "$sha" "$CE_SHA" 2>/dev/null; then
      printf '%s' "$sha"; return 0
    fi
  done <<< "$CE_LOG"
  return 1
}

[ "$CE_ON" -eq 1 ] || printf '%s: NOTE class (e) DISABLED — %s; a tools/** fix cannot close on the battery this run\n' \
  "$PROG" "${CE_WHY:-unknown}" >&2

while IFS=$'\x1f' read -r ISSUE LN LT VTKN VTS VSHA VRUN VEV LWHAT CLS ETRK; do
  [ -n "${ISSUE:-}" ] || continue
  CAND=$((CAND + 1))

  # Which boards hold this number, and in what state? TWO SETS, and the
  # difference between them IS #140 face 1:
  #
  #   HOLDERS / OPEN_HOLDERS  — the CLOSE SCOPE (`--repo`). Where a close may be
  #                             WRITTEN. May legitimately be one board.
  #   BHOLDERS / BOPEN        — the BOARD SET (`--board`; both live trackers by
  #                             default). What is CHECKED for a collision. Always.
  #
  # `--repo` must decide WHERE, never WHAT. The measured repro was a
  # `--repo leshchenko1979/opencrabs-dev-factory` sweep in which fork#138's
  # PASS-LATE-ENTRY closed factory#138: with one board in the list there is no
  # collision to see, so the guard was never ASKED — it was not wrong, it was
  # never consulted. Measured 2026-11-22: 121 numbers are held by both boards,
  # and 4 factory issues (#134, #135, #136, #140) sit in exactly this shape — a
  # CLOSED fork number shadowing an OPEN factory one, which the old both-OPEN
  # narrowing of a one-board list could not report.
  HOLDERS=(); OPEN_HOLDERS=()
  BHOLDERS=(); BOPEN=()
  for _r in "${BOARDS[@]}"; do
    _st="${TRACKER_OF["$_r|$ISSUE"]:-}"
    [ -n "$_st" ] || continue
    BHOLDERS+=("$_r:$_st")
    [ "$_st" = "OPEN" ] && BOPEN+=("$_r")
    if [ -n "${REPO_SCOPE["$_r"]:-}" ]; then
      HOLDERS+=("$_r:$_st")
      [ "$_st" = "OPEN" ] && OPEN_HOLDERS+=("$_r")
    fi
  done

  # POSITIVE attribution, before any refusal: a row whose own `evidence` carries
  # an issue URL for ITS OWN number names its board, and that settles the
  # question without a guess. Measured: 4 of 363 PASS rows carry any issue URL,
  # so this can never be a REQUIREMENT (refusing the other 359 would convert a
  # false close into a permanent false debt) — but where it is present it is
  # exact, so it outranks the refusal below.
  RESOLVED=""
  if [ -n "${ETRK:-}" ]; then
    for _h in "${BHOLDERS[@]}"; do
      [ "${_h%:*}" = "$ETRK" ] && RESOLVED="${_h%:*}"
    done
  fi
  if [ -n "$RESOLVED" ]; then
    # Attribute to that board ONLY. The other copy of the number must never be
    # the close target — that is precisely the wrong close this face exists to
    # stop, so the scope is REPLACED, not merely reordered.
    HOLDERS=(); OPEN_HOLDERS=()
    _rst="${TRACKER_OF["$RESOLVED|$ISSUE"]:-}"
    if [ -n "${REPO_SCOPE["$RESOLVED"]:-}" ] && [ -n "$_rst" ]; then
      HOLDERS+=("$RESOLVED:$_rst")
      [ "$_rst" = "OPEN" ] && OPEN_HOLDERS+=("$RESOLVED")
    fi
  fi

  if [ "${#BHOLDERS[@]}" -eq 0 ]; then
    ABSENT=$((ABSENT + 1))
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" - ABSENT "$VTKN" "$VTS" "$LN" "not on any checked tracker — no issue to close"
    add_json "$ISSUE" "ABSENT" "$VTKN" "$VTS" "$LN" "skip-absent" ""
    continue
  fi

  if [ "${#BHOLDERS[@]}" -gt 1 ] && [ -z "$RESOLVED" ]; then
    # The SAME NUMBER on two boards. If every copy is CLOSED nothing is owed and
    # the ambiguity costs nothing; if ANY copy is OPEN, closing it is a guess
    # about WHICH issue the receipt belongs to — and a wrong close on a public
    # tracker is worse than a reported debt. Never guess: report. Note the
    # condition is BOPEN, not "both OPEN": the measured live shape is one CLOSED
    # + one OPEN (#138), and requiring both OPEN is why this guard read 0/121.
    if [ "${#BOPEN[@]}" -eq 0 ]; then
      ALREADY=$((ALREADY + 1))
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" both CLOSED "$VTKN" "$VTS" "$LN" "closed on every tracker holding the number"
      add_json "$ISSUE" "CLOSED" "$VTKN" "$VTS" "$LN" "skip-already-closed" "both"
    else
      AMBIG=$((AMBIG + 1))
      printf '%s: AMBIGUOUS-TRACKER #%s exists on %s — NOT closing, the receipt does not say which\n' \
        "$PROG" "$ISSUE" "$(printf '%s ' "${BHOLDERS[@]}" | sed 's/ $//')" >&2
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" both AMBIGUOUS "$VTKN" "$VTS" "$LN" "AMBIGUOUS — reported, never closed"
      add_json "$ISSUE" "AMBIGUOUS" "$VTKN" "$VTS" "$LN" "skip-ambiguous" "both"
    fi
    continue
  fi

  if [ "${#HOLDERS[@]}" -eq 0 ]; then
    # The number exists, but only OUTSIDE the close scope (`--repo`). That is not
    # "absent": calling it absent would hide a real issue from a narrowed sweep,
    # which is the silent-exclusion defect of face 3 one class over. Name it.
    ABSENT=$((ABSENT + 1))
    _why="held by $(printf '%s ' "${BHOLDERS[@]}" | sed 's/ $//'), outside the close scope (--repo) — no close"
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" - ABSENT "$VTKN" "$VTS" "$LN" "$_why"
    add_json "$ISSUE" "ABSENT" "$VTKN" "$VTS" "$LN" "skip-absent" ""
    continue
  fi

  TARGET_REPO="${HOLDERS[0]%:*}"; STATE="${HOLDERS[0]##*:}"

  if [ "$STATE" = "CLOSED" ]; then
    ALREADY=$((ALREADY + 1))
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" CLOSED "$VTKN" "$VTS" "$LN" "already closed — nothing owed"
    add_json "$ISSUE" "CLOSED" "$VTKN" "$VTS" "$LN" "skip-already-closed" "$TARGET_REPO"
    continue
  fi

  # ---- class (e): the battery is the receipt -------------------------------
  # A `tools/**` fix writes NO behavioural smoke, so the class (d) join can never
  # see it — that is the gap factory#127 measured (eligible 0 across 225). The
  # three legs are checked here, in order, and EVERY failure is named on stderr:
  # a catch-up path that quietly declines to close is indistinguishable from one
  # that found nothing, which is the same defect one class over.
  if [ "${CLS:-smoke}" = "e" ]; then
    # Scope before anything else: a `tools/**` fix lands in the SKILL repo, whose
    # commit subjects speak the FACTORY number space. Measured live 2026-11-21 —
    # fork#471 ("bash tool result carried ANOTHER session's spilled output") was
    # one dry run away from closing on `ee4b1180`, whose subject says `(#471)`
    # and whose own body says `Fixes #23`: a DIFFERENT tracker's 471. The join
    # already refuses that ambiguity for issue STATE (AMBIGUOUS-TRACKER); the
    # commit subjects need the same refusal, because a subject carries no repo.
    if [ "$TARGET_REPO" != "$E_REPO" ]; then
      CE_NOT=$((CE_NOT + 1))
      printf '%s: CLASS-E-SKIPPED #%s — a tools/** fix speaks the FACTORY number space (%s); #%s is held by %s\n' \
        "$PROG" "$ISSUE" "$E_REPO" "$ISSUE" "$TARGET_REPO" >&2
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "-" "-" "$LN" "wrong tracker for a tools/** fix — NOT closable"
      add_json "$ISSUE" "OPEN" "" "" "$LN" "skip-e-wrong-tracker" "$TARGET_REPO"
      continue
    fi
    if [ "$CE_ON" -ne 1 ]; then
      CE_NOT=$((CE_NOT + 1))
      printf '%s: CLASS-E-SKIPPED #%s — %s\n' "$PROG" "$ISSUE" "${CE_WHY:-battery receipt unusable}" >&2
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "-" "-" "$LN" "battery receipt unusable — NOT closable"
      add_json "$ISSUE" "OPEN" "" "" "$LN" "skip-no-battery" "$TARGET_REPO"
      continue
    fi
    CE_FIX="$(ce_fix_sha "$ISSUE")" || CE_FIX=""
    if [ -z "$CE_FIX" ]; then
      CE_NOT=$((CE_NOT + 1))
      if CE_NAMED="$(ce_named_any "$ISSUE")"; then
        # leg (ii) — named, but not in the receipt's ancestry: the receipt cannot
        # vouch for a commit it does not descend from (an unmerged branch).
        printf '%s: CLASS-E-SKIPPED #%s — leg (ii): %s names it but is not an ancestor of receipt %s\n' \
          "$PROG" "$ISSUE" "$CE_NAMED" "$CE_SHA" >&2
        [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "-" "-" "$LN" "fix not in the receipt's ancestry — NOT closable"
        add_json "$ISSUE" "OPEN" "" "" "$LN" "skip-not-ancestor" "$TARGET_REPO"
      else
        # leg (iii) — nothing in any ref names it in its own SUBJECT.
        printf '%s: CLASS-E-SKIPPED #%s — leg (iii): no commit names it in its OWN SUBJECT (a trailer is a claim, never a receipt; this issue closes BY HAND on written-out evidence)\n' \
          "$PROG" "$ISSUE" >&2
        [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "-" "-" "$LN" "no commit subject names it — close BY HAND"
        add_json "$ISSUE" "OPEN" "" "" "$LN" "skip-no-subject" "$TARGET_REPO"
      fi
      continue
    fi
    CE_OK=$((CE_OK + 1))
    ELIGIBLE=$((ELIGIBLE + 1))
    R1="battery verdict: PASS fail=0 tree_changed=false ts=${CE_TS:-unknown} receipt=$CE_SHA fix=$CE_FIX"
    R2="ledger: done #$ISSUE n=$LN — $LWHAT"
    if [ "$APPLY" -eq 0 ]; then
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "BATTERY" "$CE_TS" "$LN" "WOULD CLOSE (dry run — pass --apply)"
      add_json "$ISSUE" "OPEN" "" "" "$LN" "would-close" "$TARGET_REPO" "e"
      continue
    fi
    if oc_close_on_receipt "$PROG" "$GH_BIN" "$TARGET_REPO" "$ISSUE" "$R1" "$R2" \
         "class (e) battery-verified-landed"; then
      APPLIED=$((APPLIED + 1))
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "BATTERY" "$CE_TS" "$LN" "CLOSED on both receipts"
      add_json "$ISSUE" "OPEN" "" "" "$LN" "closed" "$TARGET_REPO" "e"
    else
      FAILED=$((FAILED + 1))
      [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "BATTERY" "$CE_TS" "$LN" "CLOSE FAILED (see stderr)"
      add_json "$ISSUE" "OPEN" "" "" "$LN" "close-failed" "$TARGET_REPO" "e"
    fi
    continue
  fi

  # T-7 MIRROR — the catch-up path must be no WEAKER than the live one it
  # mirrors. `oc-smoke` gates its close on `BEHAVIORAL != absent`; this path
  # keyed on the verdict token ALONE, so a row that PASSED legs 1-3 while leg 4
  # was PARKED read as closable. Measured on the fork 2026-11-20: the entire
  # eligible set of a 221-candidate sweep was the five reopened parks, i.e.
  # `--apply` would have performed 5 wrong closes and 0 right ones.
  #
  # BOTH literals are load-bearing, and neither is redundant:
  #   #398 is named ONLY by PARKED-OWNER-EYE (a 4-leg probe pass whose evidence
  #        carries no `behavioral=` token at all);
  #   #515 is named ONLY by behavioral=absent (3-leg; its park is named in a
  #        later ADDENDUM row, which never enters the verdict map).
  # Dropping either matcher closes a real park — that is the mutation design.
  #
  # The park text lives INSIDE the evidence blob; there is no field for it.
  # Match the LITERALS, never the bare word `parked`: sound closes read
  # "no leg claimed or parked", and refusing those would be a false debt.
  # `behavioral=na` is a DECLARED structural N/A, not an absence, and stays
  # closable (the live path's T-7 positive control).
  _park=""
  case "$VEV" in *PARKED-OWNER-EYE*) _park="PARKED-OWNER-EYE" ;; esac
  case "$VEV" in *behavioral=absent*) _park="${_park:+$_park+}behavioral=absent" ;; esac
  if [ -n "$_park" ]; then
    PARKED=$((PARKED + 1))
    printf '%s: PARKED-OWNER-EYE #%s on %s — NOT closable: the smoke evidence names a parked leg (%s)\n' \
      "$PROG" "$ISSUE" "$(short_repo "$TARGET_REPO")" "$_park" >&2
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "$VTKN" "$VTS" "$LN" "PARKED — not closable (owner-eye park / behavioral=absent)"
    add_json "$ISSUE" "OPEN" "$VTKN" "$VTS" "$LN" "skip-parked" "$TARGET_REPO"
    continue
  fi

  ELIGIBLE=$((ELIGIBLE + 1))

  # Receipt 1 — the smoke verdict, optionals OMITTED when empty rather than
  # emitted as `run=` (an empty value reads as a value).
  R1="smoke verdict: $VTKN $VTS"
  [ -n "$VSHA" ] && R1="$R1 sha=$VSHA"
  [ -n "$VRUN" ] && R1="$R1 run=$VRUN"
  [ -n "$VEV" ]  && R1="$R1 — $VEV"
  # Receipt 2 — the ledger row by POINTER (n) and by EXCERPT (what): the pointer
  # alone does not survive a re-mint, and the excerpt alone is unverifiable.
  R2="ledger: done #$ISSUE n=$LN — $LWHAT"

  if [ "$APPLY" -eq 0 ]; then
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "$VTKN" "$VTS" "$LN" "WOULD CLOSE (dry run — pass --apply)"
    add_json "$ISSUE" "OPEN" "$VTKN" "$VTS" "$LN" "would-close" "$TARGET_REPO"
    continue
  fi

  if oc_close_on_receipt "$PROG" "$GH_BIN" "$TARGET_REPO" "$ISSUE" "$R1" "$R2"; then
    APPLIED=$((APPLIED + 1))
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "$VTKN" "$VTS" "$LN" "CLOSED on both receipts"
    add_json "$ISSUE" "OPEN" "$VTKN" "$VTS" "$LN" "closed" "$TARGET_REPO"
  else
    FAILED=$((FAILED + 1))
    [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$ISSUE" "$(short_repo "$TARGET_REPO")" OPEN "$VTKN" "$VTS" "$LN" "CLOSE FAILED (see stderr)"
    add_json "$ISSUE" "OPEN" "$VTKN" "$VTS" "$LN" "close-failed" "$TARGET_REPO"
  fi
done <<< "$JOIN"

# ---------------------------------------------------------------------------
# CLAIMS RECONCILIATION (#132) — tracker state joined to OPEN CLAIMS.
#
# NOTHING in the fleet performed this join. `claim_is_closed()` reads only LATER
# LEDGER ROWS, so an issue closed by any path that stamped no ledger row — the
# GitHub UI, a bare `gh issue close`, a hand-close with no sweep behind it —
# leaves its reservation open FOREVER, and the dispatch predicate then reads
# finished work as live. Measured 2026-11-21T06:05Z: 18 open claim rows on 15
# CLOSED fork issues across 9 lanes.
#
# WHY HERE AND NOT IN THE PREDICATE: `claim_is_closed()` is deliberately offline
# and pure — the dispatch path calls it in tight loops and it may never make a
# network call. The reconciliation belongs in a sweep that runs on purpose and
# is allowed to be slow. The predicate stays exactly as it is.
#
# THE JOIN IS FREE: TRACKER_OF was filled by the two list calls above, so this
# leg costs ZERO additional gh reads.
#
# WHY THE RELEASE ROW IS ATTRIBUTED TO THE CLAIMING LANE, NEVER THE SWEEPER:
# `claim_is_closed()`'s addressed arm retires on a row from ANY actor, so a
# sweeper writing as itself COULD clear another lane's reservation — which is
# precisely the actor-confusion `actor_match` exists to prevent. Writing the row
# as the owner keeps the record honest about WHO attested the closure.
#
# WHY AN OPEN-ON-ONE-BOARD CASE IS NEVER RELEASED: a claim row carries NO repo
# field, and the two trackers collide on numbers constantly. If the number is
# CLOSED on one board and OPEN on the other, retiring would release on a guess.
# It is reported as CLAIM-AMBIGUOUS and left alone.
#
# The release writer, overridable so the selftest can prove the legs against a
# fixture it owns without a real ledger write (same seam shape as BATTERY/TREE).
CLAIM_LEDGER_BIN="${OC_CLOSURE_LEDGER_BIN:-$SCRIPT_DIR/state/oc-ledger}"
# Initialised OUTSIDE the guard below: `set -u` turns an unset counter into a
# fatal error at the emit block, and a tool that dies AFTER doing its work is
# worse than one that never ran — the caller reads rc 1 and no JSON.
CLAIM_STALE=0; CLAIM_RELEASED=0; CLAIM_AMBIG=0; CLAIM_LIVE=0; CLAIM_FAILED=0
if [ -f "$LEDGER" ]; then
  # US separator, never TAB: TAB is IFS WHITESPACE, so `read` COLLAPSES a run of
  # tabs and an empty field silently shifts every field after it (measured in
  # this file's own JOIN, see the note above it).
  CLAIM_ROWS="$(python3 - "$LEDGER" "$SCRIPT_DIR/lib" <<'PY'
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[2])
try:
    import oc_claims
except Exception:
    sys.exit(0)
for c in oc_claims.get_active_claims(sys.argv[1]):
    what = (c.get("what") or "").replace("\x1f", " ").replace("\n", " ")
    print("%s\x1f%s\x1f%s" % (c.get("uuid", ""), c.get("issue", ""), what))
PY
)" || CLAIM_ROWS=""

  if [ -n "$CLAIM_ROWS" ]; then
    while IFS=$'\x1f' read -r _cuuid _ciss _cwhat; do
      [ -n "${_cuuid:-}" ] && [ -n "${_ciss:-}" ] || continue
      _closed_on=""; _open_on=""
      for _r in "${REPOS[@]}"; do
        case "${TRACKER_OF["$_r|$_ciss"]:-}" in
          CLOSED) _closed_on="${_closed_on}${_closed_on:+,}$_r" ;;
          OPEN)   _open_on="$_r" ;;
        esac
      done
      # OPEN on any board where the number exists => the reservation is still earned.
      if [ -n "$_open_on" ]; then
        CLAIM_LIVE=$((CLAIM_LIVE + 1))
        if [ -n "$_closed_on" ]; then
          CLAIM_AMBIG=$((CLAIM_AMBIG + 1))
          [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$_ciss" "$(short_repo "$_open_on")" OPEN - - - "CLAIM-AMBIGUOUS (CLOSED on $(short_repo "$_closed_on"); no repo field on the claim — not releasing on a guess)"
        fi
        continue
      fi
      # Absent from every board: nothing to join against.
      [ -n "$_closed_on" ] || continue
      CLAIM_STALE=$((CLAIM_STALE + 1))
      if [ "$APPLY" -ne 1 ]; then
        [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$_ciss" "$(short_repo "${_closed_on%%,*}")" CLOSED - - - "CLAIM-STALE (dry run — --apply releases)"
        continue
      fi
      _cr="$("$CLAIM_LEDGER_BIN" stamp close "#$_ciss close — claim released on TRACKER state (#132): issue is CLOSED on ${_closed_on} and the claim row (lane ${_cuuid}) had no ledger close row, which is why the reservation outlived the issue. SWEPT, NOT ATTESTED: the sweep observed the tracker state, it did not verify the work. Original claim: ${_cwhat}" --by "$_cuuid" 2>&1)" && _crc=0 || _crc=$?
      if [ "$_crc" -eq 0 ]; then
        CLAIM_RELEASED=$((CLAIM_RELEASED + 1))
        [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$_ciss" "$(short_repo "${_closed_on%%,*}")" CLOSED - - - "CLAIM-RELEASED"
      else
        CLAIM_FAILED=$((CLAIM_FAILED + 1))
        [ "$JSON" -eq 1 ] || printf '%-7s %-8s %-11s %-18s %-21s %-7s %s\n' "#$_ciss" "$(short_repo "${_closed_on%%,*}")" CLOSED - - - "CLAIM-RELEASE FAILED (${_cr//$'\n'/ })"
      fi
    done <<< "$CLAIM_ROWS"
  fi
fi

if [ "$JSON" -eq 1 ]; then
  # `${REPOS[*]}` joins with the FIRST character of IFS only, so an
  # `IFS='","'` trick produces `"o/one"o/two"` — invalid JSON that every
  # consumer then has to tolerate (measured: it made this tool's own legs read
  # PARSE-FAIL). Build the array literally instead.
  _repos_json=""
  for _r in "${REPOS[@]}"; do _repos_json="${_repos_json}${_repos_json:+,}\"$_r\""; done
  # The BOARD SET is reported beside the close scope so a reader can see that a
  # narrowed sweep was still checked against every board (#140 face 1).
  _boards_json=""
  for _r in "${BOARDS[@]}"; do _boards_json="${_boards_json}${_boards_json:+,}\"$_r\""; done
  printf '{"repos":[%s],"boards":[%s],"apply":%s,"candidates":%d,"eligible":%d,"already_closed":%d,"closed":%d,"failed":%d,"absent":%d,"ambiguous":%d,"parked":%d,"class_e_disabled":%s,"class_e_skipped":%d,"battery_verified":%d,"claim_stale":%d,"claim_released":%d,"claim_ambiguous":%d,"claim_live":%d,"claim_release_failed":%d,"rows":[%s]}\n' \
    "$_repos_json" "$_boards_json" "$([ "$APPLY" -eq 1 ] && echo true || echo false)" \
    "$CAND" "$ELIGIBLE" "$ALREADY" "$APPLIED" "$FAILED" "$ABSENT" "$AMBIG" "$PARKED" \
    "$([ "$CE_ON" -eq 1 ] && echo false || echo true)" "$CE_NOT" "$CE_OK" \
    "$CLAIM_STALE" "$CLAIM_RELEASED" "$CLAIM_AMBIG" "$CLAIM_LIVE" "$CLAIM_FAILED" \
    "$JSON_ROWS"
fi

oc_log_extra "candidates" "$CAND"
oc_log_extra "eligible" "$ELIGIBLE"
oc_log_extra "closed" "$APPLIED"
oc_log_extra "parked" "$PARKED"
oc_log_extra "battery_verified" "$CE_OK"
oc_log_extra "class_e_skipped" "$CE_NOT"
oc_log_extra "apply" "$APPLY"
oc_log_extra "claim_stale" "$CLAIM_STALE"
oc_log_extra "claim_released" "$CLAIM_RELEASED"
oc_log_extra "claim_ambiguous" "$CLAIM_AMBIG"
oc_log_extra "claim_live" "$CLAIM_LIVE"
oc_log_extra "claim_release_failed" "$CLAIM_FAILED"

# A release that failed is a WRITE that failed, the same class as a close that
# failed — and rc 0 here would tell a caller the reconciliation happened while
# the ledger still holds the stale claim. Same rc 1, no new code: the contract's
# "a close FAILED" clause already means "a write this run owed did not happen".
if [ "$FAILED" -ne 0 ] || [ "$CLAIM_FAILED" -ne 0 ]; then exit 1; fi
exit 0
