#!/usr/bin/env bash
# =============================================================================
# oc-ledger — dispatch shim (factory #204, P3 flip, 2026-11-28)
#
# THIS FILE IS THE LIVE WRITE PATH. Two implementations sit beside it:
#
#   oc-ledger.py     the Python port — every verb EXCEPT selftest
#   oc-ledger.bash   the pre-flip bash tool, archived — selftest only
#
# WHY A SHIM AND NOT A BARE SHEBANG SWAP.
#   tools/tests/run.sh:2510 runs `run_selftest oc-ledger`, i.e. it invokes
#   `<tool> --selftest`, and run.sh contains NO pytest integration at all. A
#   bare Python file here would therefore leave the battery with zero coverage
#   of the live write path. `--selftest` execs the archived bash, whose 475
#   `chk` assertions ARE that coverage — so run.sh stays byte-identical and the
#   battery keeps testing the write path it has always tested.
#
# WHY BASH AND NOT A PYTHON POLYGLOT.
#   Two live call sites invoke the tool THROUGH bash explicitly:
#     tools/tests/run.sh:3092      bash <path> roster --live --role toolsmith
#     tools/notify/oc-notify-fanout:1577   bash <path> stamp notify-fanout ...
#   A Python file at this path is a syntax error for both. A bash shim keeps
#   `bash <path>` and `<path>` working identically.
#
# `exec` throughout: this shim adds one process and NO change to argv, stdin,
# stdout, stderr, signal disposition or exit code. It decides WHICH
# implementation runs and then gets out of the way.
#
# Parity evidence for the flip: tools/tests/pytest/test_ledger_write_parity.py
# (45 legs, rc + stdout + stderr + full ledger snapshot), plus a shadow-mode
# diff over a copy of the live ledger. See
# ~/.opencrabs/profiles/ops/research/oc-ledger-port-plan.md.
# =============================================================================

set -u

# Resolve this script's own directory, following symlinks, so a linked or
# PATH-resolved invocation still finds its siblings.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  _target="$(readlink -- "$self")"
  case "$_target" in
    /*) self="$_target" ;;
    *)  self="$(dirname -- "$self")/$_target" ;;
  esac
done
here="$(cd -- "$(dirname -- "$self")" && pwd -P)"

py="$here/oc-ledger.py"
bash_tool="$here/oc-ledger.bash"

# The dispatch decision reads the SAME global-flag prefix oc-ledger.py's
# parse_global reads: `--ledger <path>` may precede `selftest`, so a shim that
# only looked at $1 would send `--ledger X --selftest` to the Python port.
# The walk stops at the first token that is not a global flag — exactly where
# parse_global stops.
selftest=0
i=0
while [ "$i" -lt "$#" ]; do
  _arg="${!i}"
  i=$((i + 1))
  case "$_arg" in
    --ledger) i=$((i + 1)) ;;   # consume the path; arity is the tool's job
    selftest|--selftest) selftest=1; break ;;
    *) break ;;
  esac
done

if [ "$selftest" = "1" ]; then
  if [ ! -f "$bash_tool" ]; then
    echo "oc-ledger: selftest arm is missing $bash_tool" >&2
    exit 2
  fi
  exec bash "$bash_tool" "$@"
fi

if [ ! -f "$py" ]; then
  echo "oc-ledger: missing $py" >&2
  exit 2
fi
exec python3 "$py" "$@"
