parse_global() { # fills LEDGER, strips global flags, leaves subcommand args
  while [ $# -gt 0 ]; do
    case "$1" in
      --ledger) LEDGER="${2:-}"; [ -n "$LEDGER" ] || die 2 "--ledger needs a path"; shift 2 ;;
      selftest|--selftest) SELFTEST=1; shift ;;
