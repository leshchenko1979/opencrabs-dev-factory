#!/usr/bin/env bash
# =============================================================================
# oc-poll — one poll, three verbs: open / answer / status  (plan 2fae1230 §3)
#
# A poll is three frozen files in ONE directory, and nothing else:
#   targets.txt   the frozen target list, copied once by `open`
#   census.json   predicate + instant + target count + target sha256, written once
#   index.log     one receipt row per answer write:  ts|uuid|sha256|bytes
#
# `status` JOINS those with the fanout wave manifests ALREADY ON DISK
# (`wave-*.targets` = targeted, `wave-*.sent` = delivered, `index.log` =
# answered) and NEVER re-runs a predicate. A denominator that is re-derived is a
# denominator that drifts: round 2 re-derived its predicate three ways in one
# round (10,093 / 10,538 / 12,093), so the response rate could not fall.
#
# There is deliberately NO `closes_at`, no deadline and no `close` verb: nothing
# in the design refuses on them, so they would be a flag with no predicate. A
# poll is finished when the poller stops reading it.
#
# usage: oc-poll open <dir> --targets <file> [--since <ts>] [--force]
#   Copies <file> to <dir>/targets.txt and writes <dir>/census.json (predicate,
#   instant, target count, target sha256). --since is RECORDED into census.json
#   as the predicate window — a record of what was claimed, never a filter the
#   tool re-applies later. Refuses to overwrite an existing poll without
#   --force (the diagnostic names the flag).
#
# usage: oc-poll answer <dir> <uuid> <body-file> [--replace]
#   Writes <dir>/<uuid>.md ATOMICALLY: temp file in the SAME directory, sha256
#   verified BEFORE the rename, then mv. Never writes in place, so a short write
#   can never leave a half answer under the answer's name. Re-reads the written
#   file and verifies its sha256 again before reporting success. Appends ONE row
#   to <dir>/index.log (ts|uuid|sha256|bytes) and prints the receipt.
#   An existing answer is refused without --replace; --replace APPENDS a second
#   index row and NEVER erases the first — the history is the audit trail.
#
# usage: oc-poll status <dir>
#   Read-only over frozen files. Prints the three counts and the set
#   differences, naming each uuid:
#     targeted-but-undelivered    in targets.txt / wave-*.targets, never sent
#     delivered-but-unanswered    in wave-*.sent, no index.log row
#     answered-but-not-targeted   an index.log row for a uuid that is NOT a
#                                 frozen target — NAMED, never counted
#     answered-but-not-delivered  a targeted uuid answered without ever being
#                                 sent — NAMED, never counted
#   CONTAINMENT IS ENFORCED, not promised: answered ⊆ delivered ⊆ targeted, so
#   answered/targeted can never rise without a target answering and can never
#   exceed 100%. An ABSENT target (named, never delivered) is therefore
#   targeted-but-undelivered and is NEVER counted as answered. A file in the
#   answer dir with no index row is NOT an answer: index.log is the answered
#   set. Every uuid the containment EXCLUDES is named in its own always-printed
#   section, with the count printed even at zero — nothing is dropped silently.
#   A wave-*.sent uuid absent from the frozen target list is not this poll's
#   delivery (it belongs to some other poll) and is not counted in `delivered`.
#   Scans <dir> and <dir>/run (the oc-notify-fanout default RUN_DIR).
#
# Exit codes:
#   0  success (help, open, answer written + re-read verified, status printed)
#   2  usage/argument error — the diagnostic NAMES the offending flag or
#      argument. Also `open` refusing an existing poll without --force: that
#      refusal is argument-level (the missing --force), not an IO fault.
#   3  `answer` refusing to overwrite an existing answer without --replace
#   4  write/IO failure (copy, temp write, sha verify, rename, index append)
#
# --selftest runs the offline fixture suite in a mktemp -d: PASS=n FAIL=m,
# exit non-zero on any FAIL. OC_POLL_FAULT=truncate|rename injects a write-stage
# fault so the truncation arm can prove no partial file survives.
# =============================================================================
set -u
set -o pipefail

PROG="oc-poll"
die() { echo "$PROG: $2" >&2; exit "$1"; }
sha() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }
json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

usage() {
  cat <<'USAGE'
usage: oc-poll open <dir> --targets <file> [--since <ts>] [--force]
       oc-poll answer <dir> <uuid> <body-file> [--replace]
       oc-poll status <dir>
       oc-poll --selftest
  open    freeze a target list into <dir>/targets.txt + <dir>/census.json
  answer  write <dir>/<uuid>.md atomically, receipt it in <dir>/index.log
  status  join targets/delivered/answered from disk; never re-runs a predicate
          answered ⊆ delivered ⊆ targeted is ENFORCED: an answer for a non-target
          uuid is named under `answered-but-not-targeted` and never counted
Exit: 0 ok · 2 usage/argument error · 3 answer exists without --replace · 4 write/IO failure
USAGE
}

# ---- open ---------------------------------------------------------------------
cmd_open() {
  local dir="" targets="" since="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --targets)   [ $# -ge 2 ] || die 2 "open: --targets needs a value"; targets="$2"; shift 2 ;;
      --targets=*) targets="${1#*=}"; shift ;;
      --since)     [ $# -ge 2 ] || die 2 "open: --since needs a value";   since="$2";   shift 2 ;;
      --since=*)   since="${1#*=}";   shift ;;
      --force)     force=1; shift ;;
      -*) die 2 "open: unknown flag '$1' (usage: oc-poll open <dir> --targets <file> [--since <ts>] [--force])" ;;
      *)  [ -z "$dir" ] || die 2 "open: exactly one <dir> expected, got extra argument '$1'"; dir="$1"; shift ;;
    esac
  done
  [ -n "$dir" ] || die 2 "open: missing <dir> (usage: oc-poll open <dir> --targets <file> [--since <ts>] [--force])"
  [ -n "$targets" ] || die 2 "open: --targets <file> is required — a poll with no frozen target list has no denominator"
  [ -f "$targets" ] || die 2 "open: --targets file not found: $targets"
  # Refuse to clobber a live poll. targets.txt is the denominator; silently
  # replacing it re-derives the very set this tool exists to freeze.
  if [ "$force" = 0 ] && { [ -e "$dir/targets.txt" ] || [ -e "$dir/census.json" ]; }; then
    die 2 "open: a poll already exists at $dir (targets.txt/census.json present) — refusing to overwrite; pass --force to re-open"
  fi
  mkdir -p "$dir" || die 4 "open: cannot create poll dir: $dir"
  cp "$targets" "$dir/targets.txt" || die 4 "open: cannot copy $targets -> $dir/targets.txt"
  local n tsha ts since_json
  n="$(grep -c '[^[:space:]]' "$dir/targets.txt" 2>/dev/null)" || n=0
  [ -n "$n" ] || n=0
  tsha="$(sha "$dir/targets.txt")"; [ -n "$tsha" ] || die 4 "open: cannot hash $dir/targets.txt"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ -n "$since" ]; then since_json="\"$(json_esc "$since")\""; else since_json="null"; fi
  # census.json is written ONCE and never rewritten: a reader that finds it
  # unchanged has proof that nothing re-derived the predicate underneath it.
  {
    printf '{\n'
    printf '  "tool": "oc-poll",\n'
    printf '  "opened_at": "%s",\n' "$ts"
    printf '  "predicate": {\n'
    printf '    "kind": "frozen-target-list",\n'
    printf '    "source": "%s",\n' "$(json_esc "$targets")"
    printf '    "since": %s\n' "$since_json"
    printf '  },\n'
    printf '  "targets_file": "targets.txt",\n'
    printf '  "targets_count": %s,\n' "$n"
    printf '  "targets_sha256": "%s"\n' "$tsha"
    printf '}\n'
  } > "$dir/census.json" || die 4 "open: cannot write $dir/census.json"
  echo "opened: dir=$dir targets=$n since=${since:-none} targets_sha256=${tsha:0:16}…"
}

# ---- answer -------------------------------------------------------------------
cmd_answer() {
  local dir="" uuid="" body="" replace=0 npos=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --replace) replace=1; shift ;;
      -*) die 2 "answer: unknown flag '$1' (usage: oc-poll answer <dir> <uuid> <body-file> [--replace])" ;;
      *) npos=$((npos+1))
         case "$npos" in
           1) dir="$1" ;; 2) uuid="$1" ;; 3) body="$1" ;;
           *) die 2 "answer: unexpected extra argument '$1'" ;;
         esac
         shift ;;
    esac
  done
  [ -n "$dir" ]  || die 2 "answer: missing <dir> (usage: oc-poll answer <dir> <uuid> <body-file> [--replace])"
  [ -n "$uuid" ] || die 2 "answer: missing <uuid>"
  [ -n "$body" ] || die 2 "answer: missing <body-file>"
  [ -d "$dir" ]  || die 2 "answer: poll dir not found: $dir (run 'oc-poll open' first)"
  case "$uuid" in */*|.|..) die 2 "answer: invalid uuid '$uuid' — a uuid names exactly one file, no path separators" ;; esac
  [ -f "$body" ] || die 2 "answer: body file not found: $body"
  [ -s "$body" ] || die 2 "answer: body file is empty: $body"

  local dest="$dir/$uuid.md" src_sha src_bytes tmp rsum ts note=""
  if [ -e "$dest" ] && [ "$replace" = 0 ]; then
    die 3 "answer: $dest already exists — refusing to overwrite; pass --replace (it APPENDS a new index.log row instead of erasing the old one)"
  fi
  src_sha="$(sha "$body")"; [ -n "$src_sha" ] || die 4 "answer: cannot hash body file: $body"
  src_bytes="$(wc -c < "$body" | tr -d ' ')"

  # temp file in the SAME directory: rename is atomic only within one filesystem
  tmp="$(mktemp "$dir/.oc-poll-tmp.XXXXXX")" || die 4 "answer: cannot create temp file in $dir"
  case "${OC_POLL_FAULT:-}" in
    truncate) head -c "$(( src_bytes / 2 ))" "$body" > "$tmp" || { rm -f "$tmp"; die 4 "answer: temp write failed (truncated write)"; } ;;
    *)        cat "$body" > "$tmp" || { rm -f "$tmp"; die 4 "answer: temp write failed: $tmp"; } ;;
  esac
  # verification BEFORE the rename — a short write must never reach the answer name
  rsum="$(sha "$tmp")"
  if [ "$rsum" != "$src_sha" ]; then
    rm -f "$tmp"
    die 4 "answer: write verification failed ($src_sha vs ${rsum:-unreadable}) — $dest untouched, no partial file left"
  fi
  if [ "${OC_POLL_FAULT:-}" = "rename" ]; then
    rm -f "$tmp"; die 4 "answer: rename stage failed (injected fault) — $dest untouched, no temp file left"
  fi
  mv -f "$tmp" "$dest" || { rm -f "$tmp"; die 4 "answer: rename failed: $tmp -> $dest"; }
  # re-read AFTER the rename: storage is not trusted until the bytes round-trip
  rsum="$(sha "$dest")"
  [ "$rsum" = "$src_sha" ] || die 4 "answer: re-read sha256 mismatch ($src_sha vs ${rsum:-unreadable}) — storage NOT trusted, treat the answer as unwritten"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  [ "$replace" = 1 ] && note=" (replace)"
  printf '%s|%s|%s|%s\n' "$ts" "$uuid" "$src_sha" "$src_bytes" >> "$dir/index.log" \
    || die 4 "answer: index append failed: $dir/index.log"
  # #163: an answer for a uuid that is NOT a frozen target is still WRITTEN (the
  # write happened, and the receipt below says so), but it is WARNED on stderr,
  # because `status` will name it under answered-but-not-targeted and will NOT
  # count it. rc is deliberately unchanged: the write succeeded, and a caller
  # keyed on rc must not read a completed write as a failure.
  if [ -f "$dir/targets.txt" ] \
     && ! awk -v u="$uuid" '{ sub(/[[:space:]]+$/, "") } $0 == u { found = 1 } END { exit !found }' \
            "$dir/targets.txt"; then
    echo "$PROG: warning: answer: uuid $uuid is NOT in $dir/targets.txt — status names it under answered-but-not-targeted and does NOT count it as answered" >&2
  fi
  echo "answered: uuid=$uuid path=$dest bytes=$src_bytes sha256=$src_sha$note"
  echo "receipt: $ts|$uuid|$src_sha|$src_bytes"
}

# ---- status -------------------------------------------------------------------
# A pure READ over frozen files. No predicate is re-derived here — that is the
# whole point: the denominator is targets.txt + wave-*.targets, written by
# whoever dispatched, and this verb only joins it to what was delivered and what
# was answered.
cmd_status() {
  [ $# -eq 1 ] || die 2 "status: exactly one <dir> expected (usage: oc-poll status <dir>)"
  local dir="$1"
  [ -n "$dir" ] || die 2 "status: missing <dir> (usage: oc-poll status <dir>)"
  [ -d "$dir" ] || die 2 "status: poll dir not found: $dir"

  # W is GLOBAL on purpose: the EXIT trap fires after this function returns, and
  # a `local` would be unbound by then (set -u aborts the cleanup, leaving the
  # scratch dir behind).
  local nt nd na ntu nun nnt nnd f
  W="$(mktemp -d)" || die 4 "status: cannot create scratch dir"
  trap 'rm -rf "${W:-}"; W=""' EXIT
  : > "$W/targeted"; : > "$W/sent"; : > "$W/answered_raw"

  for f in "$dir/targets.txt" "$dir"/wave-*.targets "$dir"/run/wave-*.targets; do
    [ -f "$f" ] && sed -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$f" >> "$W/targeted"
  done
  for f in "$dir"/wave-*.sent "$dir"/run/wave-*.sent; do
    [ -f "$f" ] && sed -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$f" >> "$W/sent"
  done
  # answered comes from index.log ONLY. An answer-shaped file with no receipt is
  # not an answer — reading the directory would make the rate 100% by construction.
  if [ -f "$dir/index.log" ]; then
    awk -F'|' 'NF >= 2 && $2 != "" { print $2 }' "$dir/index.log" >> "$W/answered_raw"
  fi

  sort -u "$W/targeted"     -o "$W/targeted"
  sort -u "$W/sent"         -o "$W/sent"
  sort -u "$W/answered_raw" -o "$W/answered_raw"
  # #163: the containment answered ⊆ delivered ⊆ targeted is ENFORCED here, not
  # merely promised in the header. Before this, `answered` was the raw index.log
  # count, so an answer for a NON-target uuid raised answered/targeted (measured:
  # 3 targets, index rows {A,Z} read 66.67% where one target answered = 33.33%),
  # and a never-delivered target could be reported undelivered AND counted as
  # answered in the same block.
  #   delivered := sent ∩ targeted   — a sent uuid outside the frozen list is
  #                                    another poll's delivery, not this one's
  comm -12 "$W/sent" "$W/targeted" > "$W/delivered"
  #   answered_targeted := index ∩ targeted — the answers to questions THIS poll
  #                                    asked (the rest are named, never counted)
  comm -12 "$W/answered_raw" "$W/targeted" > "$W/answered_targeted"
  #   answered := answered_targeted ∩ delivered — an answer for a target that was
  #                                    never sent is NAMED, never counted
  comm -12 "$W/answered_targeted" "$W/delivered" > "$W/answered"
  comm -23 "$W/targeted"         "$W/delivered"  > "$W/undelivered"
  comm -23 "$W/delivered"        "$W/answered"   > "$W/unanswered"
  comm -23 "$W/answered_raw"     "$W/targeted"   > "$W/not_targeted"
  comm -23 "$W/answered_targeted" "$W/delivered" > "$W/not_delivered"

  nt="$(wc -l < "$W/targeted"  | tr -d ' ')"
  nd="$(wc -l < "$W/delivered" | tr -d ' ')"
  na="$(wc -l < "$W/answered"  | tr -d ' ')"
  ntu="$(wc -l < "$W/undelivered" | tr -d ' ')"
  nun="$(wc -l < "$W/unanswered"  | tr -d ' ')"
  nnt="$(wc -l < "$W/not_targeted" | tr -d ' ')"
  nnd="$(wc -l < "$W/not_delivered" | tr -d ' ')"

  echo "targeted=$nt delivered=$nd answered=$na"
  # The difference sections print a count ALWAYS and a uuid only when there is
  # one: an empty difference must read as empty, not as "all fine, trust me".
  echo "targeted-but-undelivered ($ntu):"
  if [ "$ntu" -gt 0 ]; then sed 's/^/  /' "$W/undelivered"; fi
  echo "delivered-but-unanswered ($nun):"
  if [ "$nun" -gt 0 ]; then sed 's/^/  /' "$W/unanswered"; fi
  # The two containment sections are ALWAYS printed, including at zero: an
  # exclusion the output does not name is an exclusion the reader cannot see.
  echo "answered-but-not-targeted ($nnt):"
  if [ "$nnt" -gt 0 ]; then sed 's/^/  /' "$W/not_targeted"; fi
  echo "answered-but-not-delivered ($nnd):"
  if [ "$nnd" -gt 0 ]; then sed 's/^/  /' "$W/not_delivered"; fi
}

# ---- selftest -----------------------------------------------------------------
cmd_selftest() {
  T="$(mktemp -d)"; P=0; F=0
  A=11111111-1111-4111-8111-111111111111
  B=22222222-2222-4222-8222-222222222222
  C=33333333-3333-4333-8333-333333333333
  D=44444444-4444-4444-8444-444444444444
  ME="$0"
  chk() { if [ "$2" = "$3" ]; then P=$((P+1)); else F=$((F+1)); echo "  FAIL oc-poll - $1 (want rc=$2 got rc=$3)" >&2; fi; }
  eqv() { if [ "$2" = "$3" ]; then P=$((P+1)); else F=$((F+1)); echo "  FAIL oc-poll - $1 (want '$2' got '$3')" >&2; fi; }
  # `<<<`, not `printf | grep -q`: under `set -o pipefail` an early-exiting
  # grep SIGPIPEs the writer and the arm reads a failure that never happened.
  has()  { if grep -qF -- "$2" <<< "$1"; then P=$((P+1)); else F=$((F+1)); echo "  FAIL oc-poll - $3 (output lacks '$2')" >&2; fi; }
  hasnt(){ if grep -qF -- "$2" <<< "$1"; then F=$((F+1)); echo "  FAIL oc-poll - $3 (output unexpectedly has '$2')" >&2; else P=$((P+1)); fi; }
  sha1() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }
  # uuids named under one difference header, and nothing else
  diffuuids() { printf '%s\n' "$1" | sed -n "/^$2 (/,/^[a-z-]* (/{/^$2 (/d;/^[a-z-]* (/d;p;}" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tr '\n' ' ' | sed 's/ *$//'; }

  # --- arm 1: open without --targets refuses rc 2, naming the flag ------------
  printf '%s\n' "$A" > "$T/t1.txt"
  o="$(bash "$ME" open "$T/p1" 2>&1)"; chk "1-open-no-targets-rc" 2 $?
  has "$o" "--targets" "1-open-no-targets-names-flag"

  # --- arm 2: open twice without --force refuses, targets.txt bytes unchanged -
  bash "$ME" open "$T/p1" --targets "$T/t1.txt" --since "2026-11-01T00:00:00Z" >/dev/null 2>&1
  chk "2-open-happy" 0 $?
  b2="$(sha1 "$T/p1/targets.txt")"
  printf '%s\n' "$A" "$B" "$C" > "$T/t2.txt"   # a silent overwrite WOULD change these bytes
  bash "$ME" open "$T/p1" --targets "$T/t2.txt" >/dev/null 2>&1; chk "2-open-twice-rc" 2 $?
  eqv "2-open-twice-targets-unchanged" "$b2" "$(sha1 "$T/p1/targets.txt")"

  # --- arm 3: census.json byte-identical on two reads (sha, not "it parses") --
  c1="$(sha1 "$T/p1/census.json")"
  c2="$(sha1 "$T/p1/census.json")"
  eqv "3-census-byte-identical" "$c1" "$c2"
  bash "$ME" status "$T/p1" >/dev/null 2>&1
  eqv "3-census-untouched-by-status" "$c1" "$(sha1 "$T/p1/census.json")"
  has "$(cat "$T/p1/census.json")" '"since": "2026-11-01T00:00:00Z"' "3-census-records-since"
  has "$(cat "$T/p1/census.json")" '"targets_count": 1' "3-census-records-count"

  # --- arm 4: one index row, row sha == sha256sum of the answer on disk -------
  printf 'answer body A\n' > "$T/bodyA.md"
  bash "$ME" answer "$T/p1" "$A" "$T/bodyA.md" >"$T/out4" 2>&1; chk "4-answer-rc" 0 $?
  eqv "4-answer-one-row" "1" "$(wc -l < "$T/p1/index.log" | tr -d ' ')"
  eqv "4-answer-row-sha-matches-file" "$(sha1 "$T/p1/$A.md")" "$(sed -n '1p' "$T/p1/index.log" | cut -d'|' -f3)"
  eqv "4-answer-row-uuid" "$A" "$(sed -n '1p' "$T/p1/index.log" | cut -d'|' -f2)"
  eqv "4-answer-row-bytes" "$(wc -c < "$T/p1/$A.md" | tr -d ' ')" "$(sed -n '1p' "$T/p1/index.log" | cut -d'|' -f4)"
  has "$(cat "$T/out4")" "sha256=$(sha1 "$T/p1/$A.md")" "4-answer-prints-receipt"
  # an answer-SHAPED file with no receipt is NOT an answer: the answered set is
  # index.log, not the directory listing (this is what reddens the `ls` mutation)
  printf '%s\n' "$A" > "$T/p1/wave-001.sent"   # #163: delivered, so A can count
  printf 'orphan, never receipted\n' > "$T/p1/$B.md"
  o="$(bash "$ME" status "$T/p1" 2>&1)"
  has "$o" "answered=1" "4-orphan-file-not-counted"
  hasnt "$o" "$B" "4-orphan-file-not-named"
  rm -f "$T/p1/$B.md" "$T/p1/wave-001.sent"

  # --- arm 5: second answer without --replace refuses rc 3, bytes unchanged ---
  b5="$(sha1 "$T/p1/$A.md")"
  printf 'different body A v2\n' > "$T/bodyA2.md"
  bash "$ME" answer "$T/p1" "$A" "$T/bodyA2.md" >/dev/null 2>&1; chk "5-answer-refuse-rc" 3 $?
  eqv "5-answer-refuse-bytes-unchanged" "$b5" "$(sha1 "$T/p1/$A.md")"
  eqv "5-answer-refuse-no-new-row" "1" "$(wc -l < "$T/p1/index.log" | tr -d ' ')"

  # --- arm 6: --replace APPENDS; the first row's sha survives -----------------
  bash "$ME" answer "$T/p1" "$A" "$T/bodyA2.md" --replace >/dev/null 2>&1; chk "6-replace-rc" 0 $?
  eqv "6-replace-two-rows" "2" "$(wc -l < "$T/p1/index.log" | tr -d ' ')"
  eqv "6-replace-first-row-survives" "$b5" "$(sed -n '1p' "$T/p1/index.log" | cut -d'|' -f3)"
  eqv "6-replace-second-row-is-new" "$(sha1 "$T/p1/$A.md")" "$(sed -n '2p' "$T/p1/index.log" | cut -d'|' -f3)"

  # --- arm 7: a truncated write leaves NO partial file ------------------------
  b7="$(sha1 "$T/p1/$A.md")"; r7="$(wc -l < "$T/p1/index.log" | tr -d ' ')"
  OC_POLL_FAULT=truncate bash "$ME" answer "$T/p1" "$A" "$T/bodyA.md" --replace >/dev/null 2>&1
  chk "7-truncated-write-rc" 4 $?
  eqv "7-truncated-write-bytes-unchanged" "$b7" "$(sha1 "$T/p1/$A.md")"
  eqv "7-truncated-write-no-index-row" "$r7" "$(wc -l < "$T/p1/index.log" | tr -d ' ')"
  if ls -A "$T/p1" | grep -q '^\.oc-poll-tmp\.'; then F=$((F+1)); echo "  FAIL oc-poll - 7-truncated-write-no-stray-temp" >&2; else P=$((P+1)); fi
  # same guarantee for a failure BETWEEN write and rename
  OC_POLL_FAULT=rename bash "$ME" answer "$T/p1" "$A" "$T/bodyA.md" --replace >/dev/null 2>&1
  chk "7-rename-fault-rc" 4 $?
  eqv "7-rename-fault-bytes-unchanged" "$b7" "$(sha1 "$T/p1/$A.md")"
  if ls -A "$T/p1" | grep -q '^\.oc-poll-tmp\.'; then F=$((F+1)); echo "  FAIL oc-poll - 7-rename-fault-no-stray-temp" >&2; else P=$((P+1)); fi

  # --- arm 8: 3 targeted / 2 delivered / 1 answered, uuids named --------------
  D8="$T/p8"; printf '%s\n' "$A" "$B" "$C" > "$T/t8.txt"
  bash "$ME" open "$D8" --targets "$T/t8.txt" >/dev/null 2>&1; chk "8-open" 0 $?
  printf '%s\n' "$A" "$B" "$C" > "$D8/wave-001.targets"
  printf '%s\n' "$A" "$B"       > "$D8/wave-001.sent"
  bash "$ME" answer "$D8" "$A" "$T/bodyA.md" >/dev/null 2>&1
  o="$(bash "$ME" status "$D8" 2>&1)"; chk "8-status-rc" 0 $?
  has "$o" "targeted=3 delivered=2 answered=1" "8-counts"
  eqv "8-names-undelivered" "$C" "$(diffuuids "$o" 'targeted-but-undelivered')"
  eqv "8-names-unanswered"  "$B" "$(diffuuids "$o" 'delivered-but-unanswered')"

  # --- arm 9: an ABSENT target is undelivered, never answered -----------------
  D9="$T/p9"; printf '%s\n' "$A" "$B" "$C" "$D" > "$T/t9.txt"
  bash "$ME" open "$D9" --targets "$T/t9.txt" >/dev/null 2>&1; chk "9-open" 0 $?
  printf '%s\n' "$A" "$B" "$C" "$D" > "$D9/wave-001.targets"
  printf '%s\n' "$A" "$B" "$C"    > "$D9/wave-001.sent"
  bash "$ME" answer "$D9" "$A" "$T/bodyA.md" >/dev/null 2>&1
  o="$(bash "$ME" status "$D9" 2>&1)"; chk "9-status-rc" 0 $?
  has "$o" "targeted=4 delivered=3 answered=1" "9-counts"
  eqv "9-absent-is-undelivered" "$D" "$(diffuuids "$o" 'targeted-but-undelivered')"
  # "never answered" means: no receipt row for it (the answered set is index.log),
  # and it is not in the delivered-but-unanswered list either — it was never sent.
  if grep -qF "|$D|" "$D9/index.log" 2>/dev/null; then F=$((F+1)); echo "  FAIL oc-poll - 9-absent-never-answered (index.log carries a row for $D)" >&2; else P=$((P+1)); fi
  eqv "9-absent-not-in-unanswered" "$B $C" "$(diffuuids "$o" 'delivered-but-unanswered')"

  # --- arm 10: POSITIVE CONTROL — 3/3/3 with an EMPTY difference -------------
  # Without this arm, arms 8/9 pass on a tool that names uuids unconditionally.
  D10="$T/p10"; printf '%s\n' "$A" "$B" "$C" > "$T/t10.txt"
  bash "$ME" open "$D10" --targets "$T/t10.txt" >/dev/null 2>&1; chk "10-open" 0 $?
  printf '%s\n' "$A" "$B" "$C" > "$D10/wave-001.targets"
  printf '%s\n' "$A" "$B" "$C" > "$D10/wave-001.sent"
  printf 'b\n' > "$T/bodyB.md"; printf 'c\n' > "$T/bodyC.md"
  bash "$ME" answer "$D10" "$A" "$T/bodyA.md" >/dev/null 2>&1
  bash "$ME" answer "$D10" "$B" "$T/bodyB.md" >/dev/null 2>&1
  bash "$ME" answer "$D10" "$C" "$T/bodyC.md" >/dev/null 2>&1
  o="$(bash "$ME" status "$D10" 2>&1)"; chk "10-status-rc" 0 $?
  has "$o" "targeted=3 delivered=3 answered=3" "10-counts"
  has "$o" "targeted-but-undelivered (0):" "10-undelivered-header-zero"
  has "$o" "delivered-but-unanswered (0):" "10-unanswered-header-zero"
  has "$o" "answered-but-not-targeted (0):" "10-not-targeted-header-zero"
  has "$o" "answered-but-not-delivered (0):" "10-not-delivered-header-zero"
  hasnt "$o" "$A" "10-empty-difference-names-no-uuid"
  eqv "10-undelivered-empty" "" "$(diffuuids "$o" 'targeted-but-undelivered')"
  eqv "10-unanswered-empty"  "" "$(diffuuids "$o" 'delivered-but-unanswered')"
  eqv "10-not-targeted-empty" "" "$(diffuuids "$o" 'answered-but-not-targeted')"
  eqv "10-not-delivered-empty" "" "$(diffuuids "$o" 'answered-but-not-delivered')"

  # --- arm 11 (#163 AC1): an answer for a NON-TARGET uuid is NOT counted ------
  # The #163 reproducer: targets {A,B,C}, sent {A,B,C}, index rows {A,Z} with Z
  # NOT a target. The pre-fix tool read answered=2 (66.67 %) for a poll where
  # exactly ONE target answered (33.33 %) — a 2x overstatement — and named Z
  # nowhere. This arm is the one `tools/tests/negctl-163-mutation-guard.sh`
  # reddens when the containment is reverted.
  Z=99999999-9999-4999-8999-999999999999
  D11="$T/p11"; printf '%s\n' "$A" "$B" "$C" > "$T/t11.txt"
  bash "$ME" open "$D11" --targets "$T/t11.txt" >/dev/null 2>&1; chk "11-open" 0 $?
  printf '%s\n' "$A" "$B" "$C" > "$D11/wave-001.targets"
  printf '%s\n' "$A" "$B" "$C" > "$D11/wave-001.sent"
  printf 'z\n' > "$T/bodyZ.md"
  bash "$ME" answer "$D11" "$A" "$T/bodyA.md" >/dev/null 2>&1
  bash "$ME" answer "$D11" "$Z" "$T/bodyZ.md" >/dev/null 2>&1
  o="$(bash "$ME" status "$D11" 2>&1)"; chk "11-status-rc" 0 $?
  has "$o" "targeted=3 delivered=3 answered=1" "11-non-target-not-counted"
  has "$o" "answered-but-not-targeted (1):" "11-not-targeted-header-count"
  eqv "11-names-the-non-target" "$Z" "$(diffuuids "$o" 'answered-but-not-targeted')"
  eqv "11-unanswered-is-B-and-C" "$B $C" "$(diffuuids "$o" 'delivered-but-unanswered')"
  # the ANSWER itself warns on stderr and STILL exits 0: #163 must not change
  # `answer`'s exit code, so a caller keyed on rc cannot read a completed write
  # as a failure.
  bash "$ME" answer "$D11" "$Z" "$T/bodyZ.md" --replace >"$T/o11" 2>"$T/e11"
  chk "11-answer-non-target-rc" 0 $?
  has "$(cat "$T/e11")" "$Z" "11-answer-non-target-warns-on-stderr"
  has "$(cat "$T/e11")" "answered-but-not-targeted" "11-answer-non-target-says-why"
  # ...and a TARGET answer emits NO such warning (the control: the warning is
  # aimed at non-targets, not printed unconditionally)
  bash "$ME" answer "$D11" "$B" "$T/bodyB.md" >"$T/o11b" 2>"$T/e11b"
  chk "11-answer-target-rc" 0 $?
  if grep -qF "answered-but-not-targeted" "$T/e11b"; then F=$((F+1)); echo "  FAIL oc-poll - 11-target-answer-does-not-warn (stderr warns on a real target)" >&2; else P=$((P+1)); fi

  # --- arm 12 (#163 AC2): answered-but-NEVER-DELIVERED is named, not counted --
  # targets {A,B,C,D}, sent {A,B,C}, index rows {A,B,C,D}. D was never sent, so
  # it is NOT an answer this poll can count — but it must be NAMED, or the reader
  # sees a row vanish. The pre-fix tool read answered=4 on 3 delivered (133 %)
  # and reported D undelivered AND answered in the same block.
  D12="$T/p12"; printf '%s\n' "$A" "$B" "$C" "$D" > "$T/t12.txt"
  bash "$ME" open "$D12" --targets "$T/t12.txt" >/dev/null 2>&1; chk "12-open" 0 $?
  printf '%s\n' "$A" "$B" "$C" "$D" > "$D12/wave-001.targets"
  printf '%s\n' "$A" "$B" "$C"    > "$D12/wave-001.sent"
  for u in "$A" "$B" "$C" "$D"; do bash "$ME" answer "$D12" "$u" "$T/bodyA.md" >/dev/null 2>&1; done
  o="$(bash "$ME" status "$D12" 2>&1)"; chk "12-status-rc" 0 $?
  has "$o" "targeted=4 delivered=3 answered=3" "12-never-delivered-not-counted"
  has "$o" "answered-but-not-delivered (1):" "12-not-delivered-header-count"
  eqv "12-names-the-never-delivered" "$D" "$(diffuuids "$o" 'answered-but-not-delivered')"
  eqv "12-not-targeted-is-empty" "" "$(diffuuids "$o" 'answered-but-not-targeted')"
  # D is still an UNDELIVERED target too: the two sections are independent reads
  eqv "12-D-also-undelivered" "$D" "$(diffuuids "$o" 'targeted-but-undelivered')"

  # --- arm 13 (#163 AC4): a SENT uuid outside the target list is not delivery -
  # The symmetric arm on `delivered`: wave-001.sent carrying a uuid absent from
  # targets.txt must not raise `delivered`, and must not surface under
  # delivered-but-unanswered as if it were a target that went unanswered.
  Q=77777777-7777-4777-8777-777777777777
  D13="$T/p13"; printf '%s\n' "$A" "$B" "$C" > "$T/t13.txt"
  bash "$ME" open "$D13" --targets "$T/t13.txt" >/dev/null 2>&1; chk "13-open" 0 $?
  printf '%s\n' "$A" "$B" "$C" > "$D13/wave-001.targets"
  printf '%s\n' "$A" "$B" "$C" "$Q" > "$D13/wave-001.sent"
  bash "$ME" answer "$D13" "$A" "$T/bodyA.md" >/dev/null 2>&1
  o="$(bash "$ME" status "$D13" 2>&1)"; chk "13-status-rc" 0 $?
  has "$o" "targeted=3 delivered=3 answered=1" "13-non-target-sent-not-delivered"
  eqv "13-Q-absent-from-unanswered" "$B $C" "$(diffuuids "$o" 'delivered-but-unanswered')"

  # --- rc contract: --help is 0 ----------------------------------------------
  bash "$ME" --help >/dev/null 2>&1; chk "help-rc" 0 $?
  bash "$ME" bogus >/dev/null 2>&1;  chk "unknown-verb-rc" 2 $?

  rm -rf "$T"
  echo "oc-poll selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]; exit $?
}

# ---- dispatch ------------------------------------------------------------------
case "${1:-}" in
  -h|--help)            usage; exit 0 ;;
  --selftest|selftest)  cmd_selftest ;;
  open)                 shift; cmd_open "$@" ;;
  answer)               shift; cmd_answer "$@" ;;
  status)               shift; cmd_status "$@" ;;
  "")                   die 2 "missing verb (usage: oc-poll open|answer|status <dir> ...)";;
  *)                    die 2 "unknown verb '$1' (usage: oc-poll open|answer|status <dir> ...)";;
esac
exit 0
