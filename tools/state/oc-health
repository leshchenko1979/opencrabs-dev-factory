if is_class_active "git_vcs"; then
  # 2. Orphaned / unregistered worktrees
  if [ -d "$FORK/.git" ]; then
    reg="$( { git -C "$FORK" worktree list 2>/dev/null | tail -n +2 | awk '{print $1}'; \
              [ -d "$SKILL_CHECK/.git" ] && git -C "$SKILL_CHECK" worktree list 2>/dev/null | tail -n +2 | awk '{print $1}'; } | sort -u )"
    n_reg="$(printf '%s\n' "$reg" | grep -c . || true)"
    ondisk_list=()
    for p in $WT_PATTERNS; do
      [ -d "$p" ] || continue
      [ -e "$p/.git" ] || continue
      ondisk_list+=("$p")
    done
    ondisk="$(printf '%s\n' "${ondisk_list[@]}" | sort -u)"
    n_disk="$(printf '%s\n' "$ondisk" | grep -c . || true)"
    orphan="$(comm -13 <(printf '%s\n' "$reg") <(printf '%s\n' "$ondisk") | grep -c . || true)"
    if [ "${orphan:-0}" -gt 0 ]; then
      add_finding 2 QUIRK orphan-worktrees "$orphan dir(s) on disk are NOT registered worktrees ($n_disk on disk vs $n_reg registered) — remove via tools/git/oc-wt, never rm -rf"
    else
      clean_line "worktrees: $n_reg registered, $n_disk on disk, 0 orphans"
    fi
  else
    FAILED=$((FAILED + 1))
  fi

  # 18. Worktree tracked-file DELETIONS (#380) — report only.
  #
  # 195 of 206 registered worktrees lost the tracked file `.cargo/config.toml`
  # and NOTHING reported it, for weeks. Check 2 above compares registration
  # against the directories on disk, and check 6 below inspects the SHARED
  # checkout only — so no check ever ran `git status` INSIDE a registered
  # worktree. Both concepts existed; they were never joined.
  #
  # The predicate is deliberately narrow: porcelain ` D` is a tracked file
  # deleted in the worktree and NOT staged. That is never a legitimate mid-work
  # state, because a deliberate removal is staged by `git rm` and then reads
  # `D ` in the INDEX column — so a lane mid-work cannot trip this. Measured on
  # the live fleet 2026-09-19 after remediation: ` D` 0, `D ` 1, ` M`/`M ` 163,
  # `??` 7 — zero false positives across 163 legitimate modified paths. The
  # staged form (`D `) is a DIFFERENT condition and is deliberately NOT flagged.
  #
  # `-uno` skips the untracked walk (the expensive half on a large tree) and
  # cannot change this predicate, which only ever matches a tracked deletion:
  # measured 23s -> 6s across the fleet's 211 trees.
  _wrepos="$FORK"
  [ "$SKILL_CHECK" = "$FORK" ] || _wrepos="$FORK $SKILL_CHECK"
  wt_scanned=0; wt_del_trees=0; wt_del_files=0; wt_del_sample=""
  for _wrepo in $_wrepos; do
    [ -d "$_wrepo/.git" ] || continue
    while IFS= read -r _wt; do
      [ -n "$_wt" ] || continue
      [ -d "$_wt" ] || continue
      wt_scanned=$((wt_scanned + 1))
      _wtdel="$(git -C "$_wt" status --porcelain -uno 2>/dev/null | grep '^ D' || true)"
      [ -n "$_wtdel" ] || continue
      wt_del_trees=$((wt_del_trees + 1))
      wt_del_files=$((wt_del_files + $(printf '%s\n' "$_wtdel" | grep -c .)))
      if [ -z "$wt_del_sample" ]; then
        wt_del_sample="$(printf '%s\n' "$_wtdel" | awk '{print $2}' | head -3 | tr '\n' ' ')"
      fi
    done <<EOF_WT
$(git -C "$_wrepo" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
EOF_WT
  done
  if [ "$wt_del_trees" -gt 0 ]; then
    add_finding 18 QUIRK worktree-tracked-deleted "$wt_del_trees of $wt_scanned registered worktree(s) carry an UNSTAGED tracked-file deletion ($wt_del_files file(s), e.g. $wt_del_sample) — never a legitimate mid-work state (a deliberate removal is staged as 'D '); restore the file or stage the removal"
  else
    clean_line "worktree tracked files: $wt_scanned registered tree(s), 0 unstaged deletions"
  fi

  # 6. Shared checkout cleanliness & divergence
  if [ -d "$SKILL_CHECK/.git" ]; then
    dirty="$(git -C "$SKILL_CHECK" status --porcelain 2>/dev/null | wc -l)"
    if [ "$dirty" -gt 0 ]; then
      files="$(git -C "$SKILL_CHECK" status --porcelain 2>/dev/null | head -5 | awk '{print $2}' | tr '\n' ' ')"
      add_finding 6 QUIRK checkout-dirty "$dirty uncommitted path(s) in SHARED skill checkout: $files"
    else
      clean_line "checkout: clean"
    fi
    head_sha="$(git -C "$SKILL_CHECK" rev-parse --short HEAD 2>/dev/null)"
    for r in origin; do
      rsha="$(git -C "$SKILL_CHECK" rev-parse --short "$r/main" 2>/dev/null || echo none)"
      [ "$rsha" = "$head_sha" ] || add_finding 6 QUIRK checkout-diverged "HEAD=$head_sha but $r/main=$rsha"
    done
  else
    FAILED=$((FAILED + 1))
  fi

  # 7. Version / ledger consistency
  if [ "${OC_HEALTH_SKIP_VERSION:-0}" = "1" ]; then
    clean_line "version: skipped (selftest)"
  else
    cv_out="$(cd "$TOOLS_DIR" && ./state/oc-ledger check-version 2>&1)"; cv_rc=$?
    case "$cv_out" in
      # #359: the mismatch NAMES its cause (FLEET-LEVEL = a skipped sync, no
      # worker behind; LANE-LEVEL = real lane drift). The CAUSE line already
      # carries the cause-appropriate remedy, so print IT rather than the
      # unconditional "fix is oc-ledger sync" — which is the wrong heal for a
      # lane-level lag.
      *CAUSE*) add_finding 7 QUIRK version-mismatch "$(printf '%s' "$cv_out" | grep -m1 'CAUSE ')" ;;
      *MISMATCH*) add_finding 7 QUIRK version-mismatch "$(printf '%s' "$cv_out" | head -1) — fix is oc-ledger sync" ;;
      *) [ "$cv_rc" = "0" ] && clean_line "version: consistent" || add_finding 7 QUIRK version-unreadable "check-version rc=$cv_rc: $(printf '%s' "$cv_out" | head -1)" ;;
    esac
  fi
fi

