if is_class_active "issue_portfolio"; then
  # Audit issue claims. DELEGATED to tools/lib/oc_claims.py, the ONE claim-closure
  # predicate. The copy this replaces keyed on keys absent from all 9025 live events.
  if [ -f "$STATE/workers-ledger.json" ]; then
    claims_check="$(python3 -c '
import json, sys, os
sys.path.insert(0, os.path.join(sys.argv[1], "lib"))
import oc_claims as oc
open_c = oc.open_claims(json.load(sys.stdin).get("events", []))
unassigned = [c for c in open_c if not c["by"]]
if unassigned:
    print("%d unassigned claim(s) of %d open" % (len(unassigned), len(open_c)))
' "$TOOLS_DIR" < "$STATE/workers-ledger.json" 2>&1)"
    claims_rc=$?
    if [ "$claims_rc" -ne 0 ]; then
      add_finding 17 REPORT issue-claims "claim scan FAILED (rc=$claims_rc): $(printf '%s' "$claims_check" | head -1)"
    elif [ -n "$claims_check" ]; then
      add_finding 17 REPORT issue-claims "$claims_check"
    else
      clean_line "issue portfolio: ledger claim structure valid"
    fi
  fi
fi

# =============================================================================
# Record Rotation State
# =============================================================================
if [ "$DO_ALL" = "0" ] && [ "$TARGET_CLASS" != "all" ] && [ -n "$CURRENT_ROTATION_CLASS" ]; then
  python3 -c "
import json, os, datetime
path = '$ROTATION_FILE'
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except:
        data = {}

data['version'] = 1
data['current_class'] = '$CURRENT_ROTATION_CLASS'
data['next_class'] = '$NEXT_ROTATION_CLASS'
data['last_rotated_at'] = now
data['cycle_count'] = $CYCLE_COUNT
hist = data.setdefault('history', {})
hist['$CURRENT_ROTATION_CLASS'] = {
    'last_run': now,
    'findings': $FINDINGS,
    'reaped': $REAPED
}
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
" 2>/dev/null || true
fi

# =============================================================================
# Output
# =============================================================================
classes_str="$(IFS=,; echo "${ACTIVE_CLASSES[*]}")"
if [ "$JSON" = "1" ]; then
  printf '{"findings":[%s],"reaped":%d,"measure_failures":%d,"notes":%d,"notes_detail":[%s],"state_dir":"%s","rotation":{"current_class":"%s","next_class":"%s","classes_run":[%s],"cycle_count":%d}}\n' \
    "$F_JSON" "$REAPED" "$FAILED" "$NOTES" "$N_JSON" "$STATE" \
    "$CURRENT_ROTATION_CLASS" "$NEXT_ROTATION_CLASS" \
    "$(printf '"%s",' "${ACTIVE_CLASSES[@]}" | sed 's/,$//')" "$CYCLE_COUNT"
else
  printf 'oc-health [%s]: %d finding(s), %d remediation(s), %d measurement failure(s), %d note(s)\n' \
    "$classes_str" "$FINDINGS" "$REAPED" "$FAILED" "$NOTES"
  [ -n "$N_TEXT" ] && printf '%s' "$N_TEXT"
  [ -n "$F_TEXT" ] && printf '%s' "$F_TEXT"
fi

[ "$FAILED" -gt 0 ] && exit 3
[ "$FINDINGS" -gt 0 ] && exit 1
exit 0
