if is_class_active "schedulers"; then
  # 8. Cron liveness & DM leak detection
  if [ -f "$DB" ]; then
    # The reader is tools/lib/oc_sqlite, NOT the `sqlite3` CLI (#371). The old
    # `command -v sqlite3` guard made an ABSENT BINARY and a CLEAN RESULT the
    # same output: the whole check was skipped, the class reported no finding,
    # and the only trace was a measurement failure nobody read. Read through the
    # lib, and treat a DB that will not answer as the measurement failure it is
    # -- never as "clean".
    # Law-carrying dev crons. This check has TWO jobs and which one is live
    # depends on the OWNER ORDER of 2026-09-18 20:53Z ("turn off all of your
    # pacemakers"), which switched every ops pacemaker off and is STILL STANDING
    # (tools/docs/HEALTH-CLASSES.md class 5). While it stands, a disabled law-carrying cron
    # is the owner's own order and flagging it only reports his decision back to
    # him; what is worth failing on is then one ENABLED AGAINST the order.
    # Absent marker = the direction is UNSET — NOT "the order was lifted" (#426).
    # Those two states are byte-identical to this check, and resolving toward the
    # old direction reports the owner's own order back to him as a defect
    # (measured 2026-09-19: an 8 QUIRK cron-disabled finding with the marker absent
    # — reproduced against an empty state dir, the shape every profile but ops is
    # in). So with the marker absent a disabled patrol is OBSERVED —
    # a note naming the marker path and the unset direction — never asserted as a
    # finding. The failing direction is live ONLY while the marker is present and
    # one of these patrols is ENABLED against the standing order.
    # The marker is state-dir scoped, so it is hermetic in the selftest.
    #
    # The name list is deliberately NOT a hardcoded `name IN (...)`: a liveness
    # check pinned to a name cannot watch its own subject, because the
    # 2026-09-18 namespacing law RENAMES these jobs. `harvest-watch-4h` ->
    # `oc-harvest-dispatch-4h` was exactly that rename, and the stale spelling
    # left the check blind to the harvest patrol for its whole life. Matching on
    # the stable STEM survives the next rename; `oc-upstream-delta-watch` was
    # missing from the list outright and is covered now.
    _LAWCARRY="(name LIKE 'oc-harvest-dispatch%' OR name LIKE 'oc-roster-detached-sweep%' OR name LIKE 'oc-health-hourly%' OR name LIKE 'oc-upstream-delta-watch%')"
    if [ -f "$STATE/pacemakers-off" ]; then
      cron_bad="$("$TOOLS_DIR/lib/oc_sqlite" "$DB" "SELECT name FROM cron_jobs WHERE enabled=1 AND $_LAWCARRY;" 2>/dev/null)"; cron_rc=$?
    else
      cron_bad="$("$TOOLS_DIR/lib/oc_sqlite" "$DB" "SELECT name FROM cron_jobs WHERE enabled=0 AND $_LAWCARRY;" 2>/dev/null)"; cron_rc=$?
    fi
    leak_bad="$("$TOOLS_DIR/lib/oc_sqlite" "$DB" "SELECT name FROM cron_jobs WHERE enabled=1 AND name LIKE 'oc-%' AND ((deliver_to LIKE 'telegram:%' AND deliver_to NOT LIKE 'telegram:-%') OR prompt LIKE '%133526395%');" 2>/dev/null)"; leak_rc=$?
    if [ "$cron_rc" -ne 0 ] || [ "$leak_rc" -ne 0 ]; then
      FAILED=$((FAILED + 1))
    else
      if [ -n "$cron_bad" ]; then
        if [ -f "$STATE/pacemakers-off" ]; then
          add_finding 8 QUIRK cron-enabled-against-order "law-carrying cron(s) ENABLED while the 2026-09-18 pacemakers-off order stands: $(printf '%s' "$cron_bad" | tr '\n' ' ')"
        else
          add_note scheduler-direction-unset "direction UNSET — the marker $STATE/pacemakers-off is absent, so the 2026-09-18 pacemakers-off order reads as neither standing nor lifted, and a disabled law-carrying cron is observed here rather than reported as a defect. Write the marker to assert the order still stands, or leave it absent deliberately if the order was lifted. Disabled: $(printf '%s' "$cron_bad" | tr '\n' ' ')"
        fi
      fi
      [ -n "$leak_bad" ] && add_finding 8 QUIRK cron-leak "dev cron(s) delivering outside forum (DM-routed): $(printf '%s' "$leak_bad" | tr '\n' ' ')"
      if [ -z "$cron_bad$leak_bad" ]; then
        if [ -f "$STATE/pacemakers-off" ]; then
          clean_line "crons: pacemakers-off order honoured, zero DM leaks"
