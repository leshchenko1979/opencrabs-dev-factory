#!/usr/bin/env bash
# =============================================================================
# oc-skew-scan — C4: worker version skew vs the current skill version.
# Compares every worker's last_acked version against --current (default:
# SKILL.md frontmatter `version:`). behind = patch distance (all versions are
# 0.4.N). Buckets: behind>3 CHASE · else OK. Report-only — the human decides.
#
# The notify leg is RETIRED (Design D, #415 step 10). It compared
# last_notified against the current version, but the JIT pull-absorption law
# (v0.4.172, owner order 2026-09-14) abolished proactive notify waves, so
# last_notified can never advance on that path again: the leg emitted CHASE for
# every worker (33 of 33 measured) and carried no signal. Measuring a repealed
# mechanism has no consumer. If a wave-based check is ever wanted it belongs in
# a separate check keyed on real dispatch records, not on a field the law says
# will never advance.
#
# The >3 boundary is the codified one — hq.md:107, "Worker >3 versions behind,
# acting substantively | targeted notify". The former GRACE band (1<behind<=3)
# contradicted it: 22 of 33 workers sat 2-3 versions behind, which under JIT is
# the normal steady state, so the scan marked the fleet's healthy baseline as
# skew and drowned the three rows it exists to surface.
#
# Usage:
#   oc-skew-scan [--ledger <canonical path>] [--current <v>] | --selftest
#
# Exit codes: 0 clean · 1 skew (any CHASE row) · 2 usage · 3 parse failure
# Env: OC_TOOLS_LOG
# Output (stdout, pure TSV): uuid <TAB> role <TAB> field <TAB> version
#       <TAB> behind <TAB> bucket     (summary counts -> stderr)
#       field is always "ack" now the notify leg is retired; the column is kept
#       so the TSV shape is unchanged for existing readers.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-skew-scan" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

usage() { echo "usage: $0 [--ledger <file>] [--current <v>] | --selftest" >&2; exit 2; }
die() { echo "oc-skew-scan: $2" >&2; exit "$1"; }

LEDGER=""; CURRENT=""; SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ledger) LEDGER="${2:-}"; shift ;;
    --current) CURRENT="${2:-}"; shift ;;
    --selftest) SELFTEST=1 ;;
    -h|--help) (usage); exit 0 ;;   # F-L1 (v0.4.77): --help = 0 (subshell absorbs usage's exit 2)
    *) usage ;;
  esac
  shift
done

if [ "$SELFTEST" -eq 1 ]; then
  d="$(mktemp -d)" || exit 3
  trap '_rc=$?; rm -rf "$d"; oc_log_finish "$_rc"' EXIT
  cat > "$d/wl.json" <<'JSON'
{"workers":[
  {"uuid":"u-ok","role":"editor","last_acked":{"version":"0.4.35"},"last_notified":{"version":"0.4.35"}},
  {"uuid":"u-edge-ok","role":"editor","last_acked":{"version":"0.4.32"},"last_notified":{"version":"0.4.32"}},
  {"uuid":"u-edge-chase","role":"editor","last_acked":{"version":"0.4.31"},"last_notified":{"version":"0.4.31"}},
  {"uuid":"u-notify-noop","role":"editor","last_acked":{"version":"0.4.35"},"last_notified":{"version":"0.4.10"}},
  {"uuid":"u-new","role":"hq"}
],"events":[]}
JSON
  OUT="$("$0" --ledger "$d/wl.json" --current 0.4.35 2>/dev/null)"; rc=$?
  [ $rc -eq 1 ] || { echo "selftest: skew rc=$rc want=1" >&2; exit 1; }
  row() { printf '%s\n' "$OUT" | awk -F'\t' -v u="$1" -v v="$2" -v b="$3" -v k="$4" \
            '$1==u && $3=="ack" && $4==v && $5==b && $6==k{f=1} END{exit (f?0:1)}'; }
  row u-ok 0.4.35 0 OK            || { echo "selftest: u-ok row wrong" >&2; exit 1; }
  # The codified boundary (hq.md:107): >3 is the chase trigger, so 3 behind is
  # OK and 4 behind is CHASE. A band marking 2-3 behind as skew contradicts it.
  row u-edge-ok 0.4.32 3 OK       || { echo "selftest: 3-behind row not OK" >&2; exit 1; }
  row u-edge-chase 0.4.31 4 CHASE || { echo "selftest: 4-behind row not CHASE" >&2; exit 1; }
  # Design D: the notify leg is RETIRED. A worker whose last_notified is 25
  # versions behind must still yield exactly one OK ack row and no notify row —
  # this is the assertion that fails if the leg is ever re-added.
  row u-notify-noop 0.4.35 0 OK   || { echo "selftest: stale last_notified leaked into the verdict" >&2; exit 1; }
  n_notify="$(printf '%s\n' "$OUT" | awk -F'\t' '$3=="notify"{n++} END{print n+0}')"
  [ "$n_notify" -eq 0 ] || { echo "selftest: notify rows still emitted (n=$n_notify)" >&2; exit 1; }
  n_grace="$(printf '%s\n' "$OUT" | awk -F'\t' '$6=="GRACE"{n++} END{print n+0}')"
  [ "$n_grace" -eq 0 ] || { echo "selftest: GRACE bucket still emitted (n=$n_grace)" >&2; exit 1; }
  n_chase="$(printf '%s\n' "$OUT" | awk -F'\t' '$6=="CHASE"{n++} END{print n+0}')"
  [ "$n_chase" -eq 2 ] || { echo "selftest: CHASE count=$n_chase want=2 (u-edge-chase + u-new)" >&2; exit 1; }
  n_ok="$(printf '%s\n' "$OUT" | awk -F'\t' '$6=="OK"{n++} END{print n+0}')"
  [ "$n_ok" -eq 3 ] || { echo "selftest: OK count=$n_ok want=3" >&2; exit 1; }
  n_rows="$(printf '%s\n' "$OUT" | awk 'END{print NR}')"
  [ "$n_rows" -eq 5 ] || { echo "selftest: row count=$n_rows want=5 (one per worker)" >&2; exit 1; }
  cat > "$d/clean.json" <<'JSON'
{"workers":[
  {"uuid":"u-ok","role":"editor","last_acked":{"version":"0.4.36"},"last_notified":{"version":"0.4.36"}},
  {"uuid":"u-grace","role":"editor","last_acked":{"version":"0.4.36"},"last_notified":{"version":"0.4.36"}},
  {"uuid":"u-chase","role":"editor","last_acked":{"version":"0.4.36"},"last_notified":{"version":"0.4.36"}},
  {"uuid":"u-new","role":"hq","last_acked":{"version":"0.4.36"},"last_notified":{"version":"0.4.36"}}
],"events":[]}
JSON
  "$0" --ledger "$d/clean.json" --current 0.4.36 >/dev/null 2>&1; rc=$?
  [ $rc -eq 0 ] || { echo "selftest: clean rc=$rc want=0" >&2; exit 1; }
  # the malformed value must sit in a field the tool READS (last_acked) — the
  # old target lived in last_notified, which is no longer scanned at all.
  sed 's/0\.4\.32/0.4.x/' "$d/wl.json" > "$d/bad.json"
  "$0" --ledger "$d/bad.json" --current 0.4.35 >/dev/null 2>&1; [ $? -eq 3 ] || { echo "selftest: malformed version != 3" >&2; exit 1; }
  "$0" --ledger "$d/nonexistent.json" >/dev/null 2>&1; [ $? -eq 3 ] || { echo "selftest: missing ledger != 3" >&2; exit 1; }
  "$0" --bogus >/dev/null 2>&1; [ $? -eq 2 ] || { echo "selftest: unknown arg != 2" >&2; exit 1; }
  echo "selftest OK"; exit 0
fi

_SELF_DIR="$OC_TOOLS_DIR"
: "${LEDGER:=$(oc_ledger_path)}"   # ONE literal + ONE precedence: tools/lib/oc-log.sh
if [ -z "$CURRENT" ]; then
  SKILL="$_SELF_DIR/../SKILL.md"
  if [ ! -f "$SKILL" ]; then
    SKILL="${HOME:-/root}/.opencrabs/profiles/ops/skills/opencrabs-dev/SKILL.md"
  fi
  CURRENT="$(sed -n 's/^version:[[:space:]]*//p' "$SKILL" 2>/dev/null | head -1)"
  [ -n "$CURRENT" ] || die 3 "cannot parse version: from $SKILL frontmatter"
fi
printf '%s' "$CURRENT" | grep -Eq '^[0-9]+(\.[0-9]+)*$' || die 3 "bad --current: $CURRENT"
CUR_N="$(printf '%s' "$CURRENT" | awk -F. '{print $NF}')"

jq -e '.workers' "$LEDGER" >/dev/null 2>&1 || die 3 "no readable .workers in: $LEDGER"
TMP="$(mktemp)" || exit 3
trap '_rc=$?; rm -f "$TMP"; oc_log_finish "$_rc"' EXIT
# Design D (#415 step 10): last_notified is deliberately NOT projected. The
# notify leg is retired, and a field the tool never reads cannot grow a leg
# back — the only version evidence scanned is last_acked.
jq -r '.workers[] | [.uuid,.role,((.last_acked.version//"-")|tostring)] | @tsv' "$LEDGER" > "$TMP" \
  || die 3 "ledger worker rows unreadable: $LEDGER"

SKEW=0; C=0; O=0
while IFS=$'\t' read -r U ROL ACK; do
  field="ack"; ver="$ACK"
  if [ -z "$ver" ] || [ "$ver" = "-" ]; then
    printf '%s\t%s\t%s\t-\t-\tCHASE\n' "$U" "$ROL" "$field"; C=$((C+1)); SKEW=1
    continue
  fi
  printf '%s' "$ver" | grep -Eq '^[0-9]+(\.[0-9]+)*$' || die 3 "malformed version '$ver' (worker $U $field)"
  VN="$(printf '%s' "$ver" | awk -F. '{print $NF}')"
  BEHIND=$((CUR_N - VN))
  # >3 is the codified chase boundary (hq.md:107). Nothing else is skew: under
  # JIT a 2-3 version lag is the normal steady state, not a finding.
  if [ "$BEHIND" -gt 3 ]; then BUCKET="CHASE"; C=$((C+1)); SKEW=1
  else BUCKET="OK"; O=$((O+1)); fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$U" "$ROL" "$field" "$ver" "$BEHIND" "$BUCKET"
done < "$TMP"

echo "skew-scan summary: CHASE=$C OK=$O total=$((C+O))" >&2
exit $([ "$SKEW" -eq 1 ] && echo 1 || echo 0)