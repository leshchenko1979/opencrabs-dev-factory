  local rc=0
  "$SELF" --fixture "$D/f.json" --json > "$D/out.json" 2>"$D/err"; rc=$?

  # ---- rc contract --------------------------------------------------------
  ck "findings present -> rc 1" [ "$rc" -eq 1 ]
  "$SELF" --fixture "$D/clean.json" >/dev/null 2>&1
  ck "no findings -> rc 0" [ "$?" -eq 0 ]
  "$SELF" --boundary leg=z:2026-01-01T00:00:00Z >/dev/null 2>&1
  ck "bad leg name -> rc 2" [ "$?" -eq 2 ]
  "$SELF" --boundary leg=a:not-a-date >/dev/null 2>&1
  ck "non-RFC3339 boundary -> rc 2" [ "$?" -eq 2 ]
  "$SELF" --fixture "$D/nope.json" >/dev/null 2>&1
  ck "unreadable fixture -> rc 3" [ "$?" -eq 3 ]
  # A missing gh must be rc 3 with a named remedy, never a Python traceback: a
  # traceback reads as "the sweep crashed" and sends the next reader hunting a
  # defect in the tool instead of installing gh (measured on this file).
  OC_GH_BIN=/nonexistent/gh "$SELF" --repo o/r > "$D/nogh.out" 2>"$D/nogh.err"
  ck "missing gh -> rc 3" [ "$?" -eq 3 ]
  grep -qi 'Traceback' "$D/nogh.err"
  ck "missing gh reports a remedy, not a traceback" [ "$?" -ne 0 ]

  # ---- ACCEPTANCE 1: every row names the boundary it applied --------------
  chk "every leg row carries a boundary and its source" '
g=[r for r in rows if r["leg"] in ("a","b","c","i","ii")]
sys.exit(0 if len(g)==5 and all(r["boundary"] and r["boundary_source"]=="default" for r in g) else 1)'
  chk "legs a/c use the origin gate, leg b its own, i/ii the design gate" '
m={r["leg"]:r["boundary"] for r in rows}
sys.exit(0 if m=={"a":"2026-09-25T22:33:06Z","b":"2026-10-05T10:19:00Z","c":"2026-09-25T22:33:06Z",
                  "i":"2026-09-26T22:00:00Z","ii":"2026-09-26T22:00:00Z"} else 1)'

  # ---- ACCEPTANCE 2: --boundary overrides AND the override is visible -----
  "$SELF" --fixture "$D/f.json" --json --leg a --boundary leg=a:2026-10-09T00:00:00Z > "$D/ovr.json" 2>/dev/null
  python3 -c "
import json,sys
r=[json.loads(l) for l in open('$D/ovr.json') if l.strip()][0]
sys.exit(0 if r['leg']=='a' and r['boundary']=='2026-10-09T00:00:00Z' and r['boundary_source']=='override' and r['population']==8 else 1)" 2>/dev/null
  ck "override is applied and named in the row (population follows it)" [ "$?" -eq 0 ]
  # Capture THEN grep: the tool exits 1 on findings and `set -o pipefail` makes
  # the pipeline inherit that rc, so `tool | grep -q` reports a MATCH as a miss.
  "$SELF" --fixture "$D/f.json" --leg a --boundary leg=a:2026-10-09T00:00:00Z > "$D/txt" 2>/dev/null
  grep -q '2026-10-09T00:00:00Z (override)' "$D/txt"
  ck "override printed as '(override)' in the text row" [ "$?" -eq 0 ]
  grep -q 'c created>=2026-09-25T22:33:06Z' "$D/txt"
  ck "an a-only override does not leak into leg c's boundary line" [ "$?" -eq 0 ]

  # ---- leg a: the declaration channels, and the one that flags -----------
  chk "leg a: parent, any-comment and body all count as DECLARED" '
g=[r for r in rows if r["leg"]=="a"][0]
sys.exit(0 if not ({1,2,3} & set(g["flagged"])) else 1)'
  chk "leg a: a declaration in the SECOND comment still counts (all-comments read)" '
g=[r for r in rows if r["leg"]=="a"][0]
sys.exit(0 if 2 not in g["flagged"] else 1)'
  chk "leg a: neither parent nor marker -> flagged" '
g=[r for r in rows if r["leg"]=="a"][0]
sys.exit(0 if g["flagged"]==[4,8] else 1)'
  chk "leg a: a pre-gate issue (#7) is OUT of the population" '
g=[r for r in rows if r["leg"]=="a"][0]
sys.exit(0 if g["population"]==9 and 7 not in g["flagged"] else 1)'

  # ---- leg b --------------------------------------------------------------
  chk "leg b: empty assignees flagged, populated ones not" '
g=[r for r in rows if r["leg"]=="b"][0]
sys.exit(0 if g["flagged"]==[2,3,8] else 1)'

  # ---- leg c: the link leg, plus the VACUOUS case ------------------------
  chk "leg c: same-tracker root without a native parent is flagged" '
g=[r for r in rows if r["leg"]=="c"][0]
sys.exit(0 if g["flagged"]==[5] and g["with_same_tracker_root"]==2 else 1)'
  chk "leg c: a parented issue with a root: comment is NOT flagged" '
g=[r for r in rows if r["leg"]=="c"][0]
sys.exit(0 if 6 not in g["flagged"] else 1)'
  "$SELF" --fixture "$D/noroot.json" --json --leg c > "$D/nr.json" 2>/dev/null
  python3 -c "
import json,sys
r=[json.loads(l) for l in open('$D/nr.json') if l.strip()][0]
sys.exit(0 if r['leg']=='c' and r['flagged']==[] and r['vacuous'] and r['vacuous']['count']==2 else 1)" 2>/dev/null
  ck "leg c: no same-tracker root -> VACUOUS, never a clean 0" [ "$?" -eq 0 ]
  "$SELF" --fixture "$D/noroot.json" --leg c > "$D/vac" 2>/dev/null
  grep -q 'VACUOUS' "$D/vac"
  ck "leg c: VACUOUS is printed in the text row" [ "$?" -eq 0 ]

  # ---- leg i: the per-ISSUE record, three channels ----------------------
  chk "leg i: a claim-row validation note counts (#1)" '
g=[r for r in rows if r["leg"]=="i"][0]
sys.exit(0 if 1 not in g["flagged"] else 1)'
