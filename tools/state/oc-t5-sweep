  # ---- the tool reports; it never writes -------------------------------
  grep -qE '^[[:space:]]*--apply\)' "$SELF"
  ck "no --apply arm: the sweep reports and never writes to a tracker" [ "$?" -ne 0 ]

  printf '\nselftest: %d passed, %d failed\n' "$pass" "$fail" >&2
  [ "$fail" -eq 0 ] || exit 1
  exit 0
