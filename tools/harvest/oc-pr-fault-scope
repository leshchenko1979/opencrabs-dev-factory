#!/usr/bin/env bash
# =============================================================================
# oc-pr-fault-scope — failing-files ∩ PR-files = IN-SCOPE / BASE-FAULT
# (v0.4.58, Duty-6 lens C #2: automates the 2026-08-26 clippy-wall
# misattribution lesson — a RED gate is NOT automatically the PR's fault).
#
# Usage: oc-pr-fault-scope <pr#> --run <run-id> [--repo <slug>] [--gh-repo <slug>] [--gh <cmd>]
#        oc-pr-fault-scope --ref <branch-or-sha> --run <run-id> [--repo <path>] [--gh-repo <slug>] [--base <ref>]
#   Pulls the changed files (the PR diff, or — for fork lanes with no PR —
#   `git diff --name-only <base>...<ref>` when --ref is given) and the failed
#   run's failing files (parsed from `gh run view --log-failed` rust-style
#   `--> path` markers and generic error lines), intersects, and verdicts:
#     IN-SCOPE   — at least one failing file is touched by the PR (the lane owns it)
#     BASE-FAULT — zero intersection (pre-existing/base problem; do NOT chase)
#
# Exit: 0 IN-SCOPE · 1 BASE-FAULT · 2 usage · 3 gh failure.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_DIR="$OC_TOOLS_DIR"
_OC_LIB="$_OC_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-pr-fault-scope" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

die() { echo "oc-pr-fault-scope: $2" >&2; exit "$1"; }

cmd_scope() {
  local pr="" ref="" base="" run="" repo="${OC_REPO:-leshchenko1979/opencrabs}" gh_repo="" _gh_url="" gh="${GH_BIN:-gh}"
  while [ $# -gt 0 ]; do case "$1" in
    --run) [ $# -ge 2 ] || { echo "oc-pr-fault-scope: --run needs a value" >&2; exit 2; }; run=""$2""; shift 2 ;;
    --repo) [ $# -ge 2 ] || { echo "oc-pr-fault-scope: --repo needs a value" >&2; exit 2; }; repo=""$2""; shift 2 ;;
    --gh-repo) [ $# -ge 2 ] || { echo "oc-pr-fault-scope: --gh-repo needs a value" >&2; exit 2; }; gh_repo=""$2""; shift 2 ;;
    --gh) [ $# -ge 2 ] || { echo "oc-pr-fault-scope: --gh needs a value" >&2; exit 2; }; gh=""$2""; shift 2 ;;
    --ref)  [ $# -ge 2 ] || { echo "oc-pr-fault-scope: --ref needs a value" >&2; exit 2; }; ref="$2"; shift 2 ;;
    --base) [ $# -ge 2 ] || { echo "oc-pr-fault-scope: --base needs a value" >&2; exit 2; }; base="$2"; shift 2 ;;
    -h|--help) echo "usage: oc-pr-fault-scope <pr#> --run <run-id> [--repo slug] [--gh-repo slug] [--gh cmd]"; echo "       oc-pr-fault-scope --ref <branch-or-sha> --run <run-id> [--repo path] [--gh-repo slug] [--base <ref>]"; echo "Exit: 0 IN-SCOPE / 1 BASE-FAULT / 2 usage / 3 gh failure"; exit 0 ;;  # C-#3: help=0
    --*) die 2 "unknown flag '$1'" ;;
    *) if [ -z "$pr" ]; then pr="$1"; fi; shift ;;
  esac; done
  [ -n "$pr" ] || [ -n "$ref" ] || die 2 "usage: oc-pr-fault-scope <pr#> --run <run-id> [--repo slug] [--gh cmd] | --ref <branch-or-sha> --run <run-id> [--base <ref>]"
  [ -n "$run" ] || die 2 "oc-pr-fault-scope: --run <run-id> is required"
  { [ -z "$pr" ] || [ -z "$ref" ]; } || die 2 "oc-pr-fault-scope: give EITHER <pr#> OR --ref, not both"
  # touched files — PR diff, or a local branch/HEAD range for fork lanes (no PR)
  local pr_files label
  if [ -n "$ref" ]; then
    # Defect 1 (#308): fork lanes have NO PR (the no-fork-PRs law routes all dev
    # through worktree branches that are ff-merged, never opened as PRs), so the
    # PR-only input made this tool unreachable on the very flow it was built for.
    # --ref derives the changed files with `git diff` instead; --repo must be a
    # local PATH here (a slug cannot be diffed).
    # Defect 2 (#25): a git WORKTREE's .git is a FILE, so `-d` rejected the
    # exact checkout fork lanes work in (tools/git/oc-wt). Ask git itself.
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 \
      || die 2 "--ref needs --repo <local-path> (got '$repo')"
    base="${base:-origin/main}"
    pr_files="$(git -C "$repo" diff --name-only "${base}...${ref}" 2>/dev/null)" \
      || die 3 "git diff ${base}...${ref} failed in $repo (unresolvable base/ref?)"
    [ -n "$pr_files" ] || die 3 "no changed files for ${base}...${ref} (wrong base, or empty diff?)"
    label="${base}...${ref}"
  else
    pr_files="$("$gh" pr diff "$pr" --repo "$repo" --name-only 2>/dev/null)" || die 3 "gh pr diff failed for #$pr"
    [ -n "$pr_files" ] || die 3 "no changed files for PR #$pr (is it merged/closed?)"
    label="PR #$pr"
  fi
  # Defect 1 (#25): gh needs a SLUG. In --ref mode --repo is the LOCAL PATH used
  # for `git diff`, so it can never be handed to gh. Derive the slug from the
  # checkout's own origin; --gh-repo wins; OC_REPO is the last resort. PR mode's
  # --repo IS a slug, so it is used as-is.
  if [ -z "$gh_repo" ]; then
    if [ -n "$ref" ]; then
      _gh_url="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
      case "$_gh_url" in
        *github.com[:/]*) gh_repo="${_gh_url#*github.com}"; gh_repo="${gh_repo#[:/]}"; gh_repo="${gh_repo%.git}" ;;
      esac
      gh_repo="${gh_repo:-${OC_REPO:-leshchenko1979/opencrabs}}"
    else
      gh_repo="$repo"
    fi
  fi
  # failing files from the run's failed-step log
  local run_log fail_files
  run_log="$("$gh" run view "$run" --repo "$gh_repo" --log-failed 2>/dev/null)" || die 3 "gh run view --log-failed failed for run $run"
  # Defect 2 (#308): the naive regex over-matched. It captured cargo registry
  # checkouts (`src/index.crates.io-…`, `src/github.com-…`) and the bare crate
  # roots `src/lib.rs` / `src/main.rs`, which appear in generic error context.
  # Empirically 4 of 5 matches in the reported run were false, and a false
  # IN-SCOPE tells the lane its change caused a base fault — the exact
  # misdiagnosis this tool exists to prevent. Drop registry/vendor checkouts and
  # the crate-root entry points from the failing-file set.
  # #26: the failed-JOB log spans EVERY step of the job, so a step that did NOT
  # fail can still contribute file paths. `Check formatting` is
  # `continue-on-error: true` (its conclusion reads `success`), yet its
  # `Diff in <path>:<line>:` lines name the branch's OWN touched files -- so a
  # genuine BASE-FAULT flipped to a false IN-SCOPE (run 37527739374:
  # governor.rs / rich/api.rs / governor_internals_test.rs, every one in the PR's
  # file list, against a break that was upstream main's own). Drop those lines --
  # but ONLY when no formatting step is among the run's FAILED steps, so a real
  # fmt failure (which IS the branch's fault) still reads IN-SCOPE. The failed
  # step names come from `--json jobs` because `--log-failed`'s own step column
  # reads `UNKNOWN STEP` on this runner and cannot be sliced.
  _failed_steps="$("$gh" run view "$run" --repo "$gh_repo" --json jobs \
    --jq '[.jobs[] | select(.conclusion=="failure") | .steps[]
           | select(.conclusion=="failure") | .name] | join("\n")' 2>/dev/null)"
  case "$_failed_steps" in
    *[Ff]ormat*) _strip_fmt=0 ;;   # the fmt step itself failed: its diff claims the surface
    *)           _strip_fmt=1 ;;   # fmt is soft-fail here: its diff lines are not failures
  esac
  _log_for_files="$run_log"
  if [ "$_strip_fmt" = 1 ]; then
    _log_for_files="$(printf '%s\n' "$run_log" | grep -vE 'Diff in [^ ]+:[0-9]+:' || true)"
  fi
  fail_files="$(printf '%s\n' "$_log_for_files" \
    | grep -oE '(src|crates|tests)/[A-Za-z0-9_/.-]+\.[A-Za-z0-9]+' \
    | grep -vE '(^|/)(index\.crates\.io|github\.com-)|/\.cargo/|/registry/|/vendor/|/node_modules/|^src/(lib|main)\.rs$' \
    | sort -u)"
  [ -n "$fail_files" ] || die 3 "no file paths parsed from failed log (non-code failure? check manually)"
  # intersection
  local inter
  inter="$(printf '%s\n' "$fail_files" | sort > /tmp/.ocpfs.$$; printf '%s\n' "$pr_files" | sort | comm -12 - /tmp/.ocpfs.$$; rm -f /tmp/.ocpfs.$$)"
  oc_log_extra failing_files "$(printf '%s' "$fail_files" | wc -l)"
  if [ -n "$inter" ]; then
    printf 'IN-SCOPE: %s owns the failure (run %s)\nfailing files:\n%s\nintersection:\n%s\n' "$label" "$run" "$fail_files" "$inter"
    oc_log_extra verdict IN-SCOPE
    return 0
  fi
  # #630: PERSIST the decision. Until now it was only PRINTED, so no later run
  # could read it -- which is how oc-harvest-census certified #458/#513 "clean to
  # branch and gate" while the base under them failed the gate on content their
  # own diffs never touched. The key is the base the unit would be CUT FROM, from
  # the SAME resolver the reader uses (lib/oc-base-red), so the key cannot drift
  # between the two ends. Best-effort by design: a writer failure must never
  # change this tool's verdict or its rc.
  _br_sha="$("${OC_TOOLS_DIR:-.}/lib/oc-base-red" resolve \
              --repo "${OC_BASE_REPO:-$HOME/opencrabs}" 2>/dev/null || true)"
  if [ -n "$_br_sha" ]; then
    "${OC_TOOLS_DIR:-.}/lib/oc-base-red" record --sha "$_br_sha" --run "$run" --pr "${pr:-$ref}" \
      --failing-files "$(printf '%s' "$fail_files" | tr '\n' ',' | sed 's/,$//')" \
      --repo "${OC_BASE_REPO:-$HOME/opencrabs}" >/dev/null 2>&1 || true
    printf 'BASE-RED recorded for base %s (run %s) — oc-harvest-census will refuse a unit cut from it\n' \
      "$(printf '%s' "$_br_sha" | cut -c1-12)" "$run"
  else
    printf 'BASE-RED NOT recorded: no cut-base resolvable in %s (set OC_BASE_REPO to the fork checkout)\n' \
      "${OC_BASE_REPO:-$HOME/opencrabs}"
  fi
  printf 'BASE-FAULT: %s clean — run %s fails outside the changed files, do NOT chase\nfailing files:\n%s\n' "$label" "$run" "$fail_files"
  oc_log_extra verdict BASE-FAULT
  return 1
}

cmd_selftest() {
  export OC_TOOLS_NOLOG=1
  local T P=0 F=0
  T="$(mktemp -d)"
  ok() { P=$((P+1)); }; bad() { F=$((F+1)); echo "  FAIL selftest - $*" >&2; }
  chk() { [ "$2" = "$3" ] && ok || bad "$1 (want $2 got $3)"; }
  # #630: a HERMETIC store and base. The BASE-RED writer must never touch the
  # live state dir from a test: a fixture marker keyed on the real fork main
  # would refuse every unit cut from it, which is exactly the false-refusal the
  # exact-sha rule exists to bound. OC_DEV_STATE redirects the store (the same
  # variable oc-ledger uses) and OC_BASE_REPO names a throwaway checkout, so the
  # recorded base sha is a real one from a repo this test owns.
  export OC_DEV_STATE="$T/state"
  mkdir -p "$T/repo"
  git -C "$T/repo" init -q -b main 2>/dev/null \
    || { git -C "$T/repo" init -q; git -C "$T/repo" symbolic-ref HEAD refs/heads/main; }
  git -C "$T/repo" config user.email t@t
  git -C "$T/repo" config user.name t
  echo base > "$T/repo/base.txt"
  git -C "$T/repo" add -A
  git -C "$T/repo" commit -qm base
  BASE_FIXTURE="$(git -C "$T/repo" rev-parse HEAD)"
  export OC_BASE_REPO="$T/repo"
  # gh shims: canned pr diff + run log
  printf '#!/bin/sh\ncase " $* " in *" pr diff "*) printf "src/brain/tools/pr_file.rs\nREADME.md\n" ;; *" run view "*) printf "error[E0308]: mismatched types\\n --> src/brain/tools/pr_file.rs:120:5\\n" ;; *) exit 1 ;; esac\n' > "$T/gh-inscope.sh"
  printf '#!/bin/sh\ncase " $* " in *" pr diff "*) printf "docs/plan.md\n" ;; *" run view "*) printf "error[E0308]: mismatched types\\n --> src/delivery/flow.rs:120:5\\n" ;; *) exit 1 ;; esac\n' > "$T/gh-basefault.sh"
  printf '#!/bin/sh\nexit 1\n' > "$T/gh-dead.sh"
  chmod +x "$T"/*.sh
  local ME="$0"
  bash "$ME" 42 --run 1000 --gh "$T/gh-inscope.sh" >/dev/null 2>&1; chk "in-scope-rc0" 0 $?
  bash "$ME" 42 --run 1000 --gh "$T/gh-basefault.sh" >/dev/null 2>&1; chk "base-fault-rc1" 1 $?
  # #630: the BASE-FAULT decision is PERSISTED, keyed on the cut-base sha, with
  # its provenance (run + the failing file). Before #630 it was only printed, so
  # the census could certify a unit "clean to branch and gate" off a base that
  # fails the gate.
  if [ -f "$T/state/base-red.json" ] \
     && grep -q "$BASE_FIXTURE" "$T/state/base-red.json" \
     && grep -q '"run": "1000"' "$T/state/base-red.json" \
     && grep -q 'src/delivery/flow.rs' "$T/state/base-red.json"; then
    ok "base-fault persisted, keyed on the base sha with run + failing file"
  else
    bad "base-fault not persisted (store: $(cat "$T/state/base-red.json" 2>/dev/null || echo ABSENT))"
  fi
  # The IN-SCOPE arm must record NOTHING: that failure is the PR's own, and a
  # marker there would refuse an unrelated, clean unit.
  rm -f "$T/state/base-red.json"
  bash "$ME" 42 --run 1000 --gh "$T/gh-inscope.sh" >/dev/null 2>&1
  [ -f "$T/state/base-red.json" ] && bad "in-scope arm recorded a base-red marker" \
    || ok "in-scope arm records nothing"
  # ---- #308 Defect 2: a cargo-registry path must NOT yield IN-SCOPE --------
  # The naive regex captured `src/index.crates.io-…` from a registry checkout;
  # a run whose only diff-side "file" is such a path would read IN-SCOPE off a
  # base fault. The registry candidate is dropped, so the one surviving failing
  # file is the real fork file, which the diff does not touch -> BASE-FAULT.
  printf '#!/bin/sh\ncase " $* " in *" pr diff "*) printf "src/index.crates.io-6f17d22bba15001f/libc-0.2.155/src/lib.rs\\n" ;; *" run view "*) printf "error[E0308]: mismatched types\\n --> /root/.cargo/registry/src/index.crates.io-6f17d22bba15001f/libc-0.2.155/src/lib.rs:9:5\\n --> src/real_fork_file.rs:1:1\\n" ;; *) exit 1 ;; esac\n' > "$T/gh-registry.sh"
  chmod +x "$T/gh-registry.sh"
  OUT_REG="$(bash "$ME" 42 --run 1000 --gh "$T/gh-registry.sh" 2>&1)"; RC_REG=$?
  [ "$RC_REG" -eq 1 ] && ok "#308 registry path does not yield IN-SCOPE (rc 1 BASE-FAULT)" \
    || bad "#308 registry path yielded rc=$RC_REG (want 1)"
  case "$OUT_REG" in *"index.crates.io"*) bad "#308 registry path survived the parser" ;;
    *"src/real_fork_file.rs"*) ok "#308 real fork file survives; registry path dropped" ;;
    *) bad "#308 unexpected output: $OUT_REG" ;; esac
  # ---- #308 Defect 1: --ref derives the changed files with no PR present ---
  # Fork lanes have no PR; a worktree branch must still be analysable.
  git -C "$T/repo" checkout -q -b feature 2>/dev/null
  mkdir -p "$T/repo/src"; echo x > "$T/repo/src/a.rs"
  git -C "$T/repo" add -A; git -C "$T/repo" commit -qm "feat: a.rs"
  printf '#!/bin/sh\ncase " $* " in *" run view "*) printf "error\\n --> src/a.rs:1:1\\n" ;; *) exit 1 ;; esac\n' > "$T/gh-ref.sh"
  chmod +x "$T/gh-ref.sh"
  bash "$ME" --ref feature --base main --run 1000 --repo "$T/repo" --gh "$T/gh-ref.sh" >/dev/null 2>&1
  chk "#308 --ref mode: IN-SCOPE on a branch with no PR" 0 $?
  # --ref with a slug --repo must refuse (a slug cannot be diffed)
  bash "$ME" --ref feature --base main --run 1000 --repo leshchenko1979/opencrabs --gh "$T/gh-ref.sh" >/dev/null 2>&1
  chk "#308 --ref with a slug --repo -> 2 (usage)" 2 $?
  # ---- #25 Defect 1: --ref must hand gh a SLUG, not the local path ---------
  # The #308 shims ignored --repo entirely, so a local path reaching gh was
  # invisible. This shim RECORDS the --repo it receives; the legs assert it is a
  # slug. Before the fix, --ref passed the checkout path and the real gh rc 3'd.
  git -C "$T/repo" remote add origin https://github.com/leshchenko1979/opencrabs.git
  printf '#!/bin/sh\nprev=""; for a in "$@"; do if [ "$prev" = "--repo" ]; then echo "$a" > "%s/gh-repo-seen"; fi; prev="$a"; done\ncase " $* " in *" run view "*) printf "error\\n --> src/a.rs:1:1\\n" ;; *) exit 1 ;; esac\n' "$T" > "$T/gh-slug.sh"
  chmod +x "$T/gh-slug.sh"
  rm -f "$T/gh-repo-seen"
  bash "$ME" --ref feature --base main --run 1000 --repo "$T/repo" --gh "$T/gh-slug.sh" >/dev/null 2>&1
  chk "#25 --ref still IN-SCOPE with a slug-aware gh" 0 $?
  SEEN="$(cat "$T/gh-repo-seen" 2>/dev/null || echo ABSENT)"
  [ "$SEEN" = "leshchenko1979/opencrabs" ] \
    && ok "#25 --ref hands gh the SLUG derived from origin" \
    || bad "#25 --ref handed gh '$SEEN' (want leshchenko1979/opencrabs)"
  rm -f "$T/gh-repo-seen"
  bash "$ME" --ref feature --base main --run 1000 --repo "$T/repo" --gh-repo acme/widget --gh "$T/gh-slug.sh" >/dev/null 2>&1
  [ "$(cat "$T/gh-repo-seen" 2>/dev/null)" = "acme/widget" ] \
    && ok "#25 --gh-repo overrides the derived slug" \
    || bad "#25 --gh-repo ignored (got '$(cat "$T/gh-repo-seen" 2>/dev/null)')"
  # ---- #25 Defect 2: a git WORKTREE's .git is a FILE, and must be accepted --
  # tools/git/oc-wt hands lanes exactly this shape; the old [ -d ] guard refused
  # it (rc 2) and sent the lane to a non-worktree checkout, where Defect 1 bit.
  git -C "$T/repo" worktree add -q "$T/wt" -b wtbranch >/dev/null 2>&1
  [ -f "$T/wt/.git" ] && ok "#25 worktree fixture has a .git FILE" \
    || bad "#25 worktree fixture .git is not a file (leg would be vacuous)"
  bash "$ME" --ref wtbranch --base main --run 1000 --repo "$T/wt" --gh "$T/gh-ref.sh" >/dev/null 2>&1
  chk "#25 --ref accepts a git worktree (.git is a file)" 0 $?
  # ---- #26: a soft-fail fmt step's `Diff in` lines are NOT failures --------
  # The failed-JOB log spans EVERY step, so `Check formatting` -- continue-on-error,
  # conclusion `success` -- still contributes `Diff in <path>:` lines naming the
  # branch's OWN touched files. On run 37527739374 those flipped a genuine
  # BASE-FAULT (real failing test outside the PR) into a false IN-SCOPE. Two shims:
  # (a) fmt did NOT fail -> its diff is dropped -> the real failing file survives
  #     alone -> BASE-FAULT; (b) fmt DID fail -> its diff IS the branch's fault ->
  #     IN-SCOPE. The failed-step names come from `--json jobs`, because
  #     `--log-failed`'s own step column reads `UNKNOWN STEP` and cannot be sliced.
  printf '#!/bin/sh\ncase " $* " in *" --json jobs "*) printf "Run tests\\n" ;; *" --log-failed "*) printf "Diff in /home/runner/work/opencrabs/opencrabs/src/brain/tools/pr_file.rs:120:\\nerror[E0308]: mismatched types\\n --> src/delivery/flow.rs:120:5\\n" ;; *" pr diff "*) printf "src/brain/tools/pr_file.rs\\n" ;; *) exit 1 ;; esac\n' > "$T/gh-fmtsoft.sh"
  printf '#!/bin/sh\ncase " $* " in *" --json jobs "*) printf "Check formatting\\nRun tests\\n" ;; *" --log-failed "*) printf "Diff in /home/runner/work/opencrabs/opencrabs/src/brain/tools/pr_file.rs:120:\\nerror[E0308]: mismatched types\\n --> src/delivery/flow.rs:120:5\\n" ;; *" pr diff "*) printf "src/brain/tools/pr_file.rs\\n" ;; *) exit 1 ;; esac\n' > "$T/gh-fmthard.sh"
  chmod +x "$T/gh-fmtsoft.sh" "$T/gh-fmthard.sh"
  OUT_FS="$(bash "$ME" 42 --run 1000 --gh "$T/gh-fmtsoft.sh" 2>&1)"; RC_FS=$?
  [ "$RC_FS" -eq 1 ] \
    && ok "#26 soft-fail fmt step: its Diff lines are dropped -> BASE-FAULT (rc 1)" \
    || bad "#26 soft-fail fmt step yielded rc=$RC_FS (want 1 BASE-FAULT)"
  case "$OUT_FS" in *"src/brain/tools/pr_file.rs"*) bad "#26 soft-fail fmt file survived into the failing set" ;;
    *"src/delivery/flow.rs"*) ok "#26 real failing file survives; soft-fail fmt file dropped" ;;
    *) bad "#26 unexpected output: $OUT_FS" ;; esac
  OUT_FH="$(bash "$ME" 42 --run 1000 --gh "$T/gh-fmthard.sh" 2>&1)"; RC_FH=$?
  [ "$RC_FH" -eq 0 ] \
    && ok "#26 fmt step DID fail: its Diff lines claim the surface -> IN-SCOPE (rc 0)" \
    || bad "#26 fmt-step failure yielded rc=$RC_FH (want 0 IN-SCOPE)"
  case "$OUT_FH" in *"src/brain/tools/pr_file.rs"*) ok "#26 fmt-failed diff file kept in the failing set" ;;
    *) bad "#26 fmt-failed diff file dropped (leg vacuous): $OUT_FH" ;; esac
  # A BASE-FAULT with no resolvable base must DISCLOSE that it was not recorded
  # rather than fail silently.
  rm -rf "$T/state" "$T/repo"
  OUT_NB="$(bash "$ME" 42 --run 1000 --gh "$T/gh-basefault.sh" 2>&1)"; RC_NB=$?
  [ "$RC_NB" -eq 1 ] && case "$OUT_NB" in *"BASE-RED NOT recorded"*) ok "unresolvable base is disclosed" ;;
    *) bad "unresolvable base not disclosed: $OUT_NB" ;; esac
  bash "$ME" 42 --gh "$T/gh-inscope.sh" >/dev/null 2>&1; chk "missing-run-rc2" 2 $?
  bash "$ME" 42 --run 1000 --gh "$T/gh-dead.sh" >/dev/null 2>&1; chk "gh-dead-rc3" 3 $?
  rm -rf "$T"
  echo "oc-pr-fault-scope selftest: PASS=$P FAIL=$F"
  [ "$F" -eq 0 ]
}

case "${1:-}" in
  --selftest) cmd_selftest; exit $? ;;
esac
cmd_scope "$@"
