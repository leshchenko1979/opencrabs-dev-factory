#!/usr/bin/env bash
# =============================================================================
# oc-harvest-sweep — pre-gate harvest verification (mechanical legs)
# =============================================================================
# Duty-6 lens C4 (2026-08-31, incident-backed: 4 lanes converged, 3 gate
# rounds burned overnight proving the gap). Runs the DETERMINISTIC legs of
# the editor.md §Phase 7 HARVEST VERIFICATION SWEEP on a harvested PR
# branch BEFORE the first gate dispatch. Leg (c) (behavioral judgment)
# stays human.
#
# Usage: oc-harvest-sweep <pr-branch> [--base <upstream-ref>] [--repo <path>] [--port-of sha1,sha2]
#                          [--refresh-refs] [--refs-cache <path>] | --selftest
# Exit:  0 clean / 1 findings / 2 usage / 3 git-fail
# Legs:  (T) trailer sweep — every commit in base..branch carries Session-Id
#        (P) patch-id — each --port-of sha has a patch-id match on the branch
#        (E) empty-diff — branch vs base diff must be non-empty
#        (U) upstream-void — every modified/deleted path exists in base
#        (S) source-union (#343) — every line the --port-of source set ADDED
#            (and did not REMOVE) is present in the branch's result tree. This
#            is the ONLY leg that reads the source commits, so it is the only
#            one that can see a squash/rebase that silently dropped a hunk.
#            With no --port-of there is nothing to compare against, and the
#            sweep refuses to certify clean (pre-#343 it printed CLEAN anyway).
#        (R) fork-ref (#40) — a ported line, commit subject or Issue-Ref
#            trailer that carries a BARE `#N` for a FORK-only issue. Upstream's
#            number space is a different space: the same `#N` either resolves
#            to nothing (dead ref) or to an unrelated upstream issue (silent
#            collision, the worse arm). Measured 2026-10-17 before this leg
#            existed: 43 bare fork-only refs already in upstream's own src
#            tree, and 98 of 125 distinct Issue-Ref trailers on landed commits
#            bare. The fork-only set comes from the tracker pair and is CACHED
#            with its own as-of instant (--refresh-refs re-derives it); with no
#            cache the leg REFUSES TO CERTIFY rather than pass silently.
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-harvest-sweep" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

usage() { # C-#3: --help/-h answers 0 on STDOUT; a usage error answers 2 on STDERR
  local rc="${1:-2}" fd=2
  [ "$rc" = 0 ] && fd=1
  echo "usage: $0 <pr-branch> [--base adolfousier/main] [--repo <path>] [--port-of sha1,sha2] [--refresh-refs] [--refs-cache <path>] | --selftest" >&$fd
  exit "$rc"
}
die() { echo "oc-harvest-sweep: $2" >&2; exit "$1"; }
selftest() {
  # #747: the old --selftest was inline in the arg loop and asserted ONLY the
  # all-green path (leg-P MATCH + rc 0). Legs T, E, U and both leg-P failure
  # arms were uncontrolled, so a regression in any of them still read green.
  local passed=0 total=0 rc d b h h2 hm mainbr out perr self sd p td
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  sd="$(mktemp -d)"
  # this selftest runs many deliberately-failing invocations; the fleet
  # flood guard would otherwise answer rc 8 instead of the gate's code
  export OC_TOOLS_NOLOG=1 OC_NO_FLOODGUARD=1 OC_DEPLOY_STATE_DIR="$sd"

  # ---- Leg R fixture: a ref set with a KNOWN shape ------------------------
  # 86/116/350/352/396 are fork-only (absent upstream), 490/548 exist on BOTH
  # trackers (the collision class). Without this file Leg R fail-closes and the
  # all-green legs go red -- which is the leg working, but it must be fed here.
  printf '# as-of: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$sd/refs.tsv"
  printf '# source: selftest fixture\n# format: <number>\t<fork-only|both>\n' >> "$sd/refs.tsv"
  printf '86\tfork-only\n116\tfork-only\n350\tfork-only\n352\tfork-only\n396\tfork-only\n490\tboth\n548\tboth\n' >> "$sd/refs.tsv"
  export OC_SWEEP_FORK_ONLY_CACHE="$sd/refs.tsv"

  # ---- usage / arg shape (rc 2) ------------------------------------------
  total=$((total+1)); "$self" >/dev/null 2>&1; rc=$?
  [ "$rc" = 2 ] && passed=$((passed+1)) || echo "  FAIL no-args rc=$rc (want 2)" >&2

  # #750: a value-taking flag as the LAST argument must be a usage error, not a hang.
  # #753: and the DRIVE is bounded. If that guard ever regresses this leg loops
  # forever instead of failing -- pinning a core until someone notices. Measured
  # 2026-10-01: six detached --selftest runs, ~5 h, load ~11 on 4 cores, nothing
  # reaping them. A guard inside the tool cannot help a process that started
  # before the guard existed; a bound can.
  total=$((total+1)); perr="$(timeout 20 "$self" --base 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && grep -qF -- '--base needs a value' <<< "$perr"; } \
    && passed=$((passed+1)) || echo "  FAIL --base-as-last-arg rc=$rc (124 = it HUNG) msg='$perr'" >&2

  total=$((total+1)); perr="$(timeout 20 "$self" --port-of 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" = 2 ] && grep -qF -- '--port-of needs a value' <<< "$perr"; } \
    && passed=$((passed+1)) || echo "  FAIL --port-of-as-last-arg rc=$rc (124 = it HUNG) msg='$perr'" >&2

  # ---- fixture repo -------------------------------------------------------
  d="$(mktemp -d)"
  git -C "$d" init -q
  git -C "$d" -c user.email=t@t -c user.name=t commit -q --allow-empty -m base
  b="$(git -C "$d" rev-parse HEAD)"
  echo m > "$d/m"; git -C "$d" add m
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m m --trailer "Session-Id: um"
  hm="$(git -C "$d" rev-parse HEAD)"   # master-only: never ported -> leg-P NO-MATCH
  echo x > "$d/x"; git -C "$d" add x
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m x --trailer "Session-Id: u1"
  h="$(git -C "$d" rev-parse HEAD)"
  echo y > "$d/y"; git -C "$d" add y
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m y --trailer "Session-Id: u2"
  h2="$(git -C "$d" rev-parse HEAD)"
  mainbr="$(git -C "$d" rev-parse --abbrev-ref HEAD)"

  # ---- branch / base resolution (rc 3) -----------------------------------
  # TWO distinct rc-3 arms, and each must pass a valid value for the OTHER
  # input. The first draft of this leg passed only --repo, so the DEFAULT base
  # (adolfousier/main, absent from the fixture) tripped the base-ref guard and
  # answered with 3 -- the branch-not-found arm was never exercised, and
  # disabling it left the leg green. Both arms share rc 3, so each asserts its
  # OWN message.
  total=$((total+1))
  perr="$("$self" nosuchbranch --repo "$d" --base "$mainbr" 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" = 3 ] && grep -qF 'branch not found' <<< "$perr"; } \
    && passed=$((passed+1)) || echo "  FAIL branch-not-found rc=$rc msg='$perr'" >&2

  total=$((total+1))
  perr="$("$self" "$mainbr" --repo "$d" --base nosuchbase 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" = 3 ] && grep -qF 'base ref not found' <<< "$perr"; } \
    && passed=$((passed+1)) || echo "  FAIL base-ref-not-found rc=$rc msg='$perr'" >&2

  # ---- oc-attrib unavailable (the THIRD rc-3 arm) -------------------------
  # The bootstrap re-derives OC_TOOLS_DIR from $0, so an env override cannot
  # reach this arm. Relocate the tool into a private tools/ tree carrying lib/
  # but no state/oc-attrib: the trailer sweep then cannot run at all, and the
  # tool must say so rather than report a clean sweep.
  td="$(mktemp -d)"; mkdir -p "$td/tools/harvest" "$td/tools/lib"
  cp "$OC_TOOLS_DIR/lib/oc-root.sh" "$OC_TOOLS_DIR/lib/oc-log.sh" "$td/tools/lib/" 2>/dev/null
  cp "$self" "$td/tools/harvest/oc-harvest-sweep"
  total=$((total+1))
  perr="$("$td/tools/harvest/oc-harvest-sweep" "$mainbr" --repo "$d" --base "$mainbr" 2>&1 1>/dev/null)"; rc=$?
  { [ "$rc" = 3 ] && grep -qF 'oc-attrib trailers-only failed' <<< "$perr"; } \
    && passed=$((passed+1)) || echo "  FAIL oc-attrib-missing rc=$rc msg='$perr'" >&2

  git -C "$d" checkout -q -b pr "$b" 2>/dev/null
  # the empty-trailer probe: a commit with no trailer must report NOTHING
  p="$(git -C "$d" log -1 --format='%H%x09%(trailers:key=Session-Id,valueonly)' pr | cut -f2)"
  total=$((total+1))
  [ -z "$p" ] && passed=$((passed+1)) || echo "  FAIL empty-trailer probe returned '$p'" >&2

  git -C "$d" -c user.email=t@t -c user.name=t cherry-pick "$h" "$h2" >/dev/null 2>&1 \
    || { echo "selftest: fixture cherry-pick failed" >&2; return 1; }

  # ---- all-green + leg P MATCH (lesson n=1543 multi-commit regression) ----
  total=$((total+1))
  out="$("$self" pr --repo "$d" --base "$mainbr" --port-of "$h,$h2" 2>/dev/null)"; rc=$?
  { [ "$rc" = 0 ] && [ "$(grep -c 'MATCH' <<< "$out")" -eq 2 ] && grep -qF 'SWEEP: CLEAN' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL all-green rc=$rc out='$out'" >&2

  # ---- leg P NO-MATCH (a commit that was never ported) --------------------
  total=$((total+1))
  out="$("$self" pr --repo "$d" --base "$mainbr" --port-of "$hm" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF 'NO-MATCH' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-P-no-match rc=$rc out='$out'" >&2

  # ---- leg P ERROR (unresolvable sha) -------------------------------------
  total=$((total+1))
  out="$("$self" pr --repo "$d" --base "$mainbr" --port-of "0000000000000000000000000000000000000000" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF 'cannot compute patch-id' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-P-error rc=$rc out='$out'" >&2

  # ---- leg T (a commit carrying no Session-Id) ----------------------------
  git -C "$d" checkout -q -b prt pr
  git -C "$d" -c user.email=t@t -c user.name=t commit -q --allow-empty -m "no trailer"
  total=$((total+1))
  out="$("$self" prt --repo "$d" --base "$mainbr" --port-of "$h,$h2" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF 'MISSING Session-Id' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-T rc=$rc out='$out'" >&2

  # ---- leg E (branch identical to base: no diff) --------------------------
  git -C "$d" branch same "$mainbr"
  total=$((total+1))
  out="$("$self" same --repo "$d" --base "$mainbr" 2>/dev/null)"; rc=$?
  # Bind the row: a bare 'FINDING' grep also matches the summary line
  # "SWEEP: FINDINGS ...", so this leg read green with the guard disabled.
  { [ "$rc" = 1 ] && grep -qF "$(printf 'empty-diff\tFINDING')" <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-E rc=$rc out='$out'" >&2

  # ---- leg U (a modified path absent from base) ---------------------------
  # Only a GITLINK reaches this: a `D` row means base HAS the path (so the D
  # arm can never fire for regular blobs), and an `M` row means base has it
  # too -- unless the base entry is a submodule pointer whose target object is
  # missing from the object DB, which is the case built here.
  git -C "$d" checkout -q "$mainbr"
  git -C "$d" update-index --add --cacheinfo 160000,1111111111111111111111111111111111111111,sub
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "gitlink" --trailer "Session-Id: ug"
  git -C "$d" checkout -q -b prv "$mainbr"
  git -C "$d" update-index --cacheinfo 160000,2222222222222222222222222222222222222222,sub
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "gitlink2" --trailer "Session-Id: ug2"
  total=$((total+1))
  out="$("$self" prv --repo "$d" --base "$mainbr" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF 'upstream-void' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-U rc=$rc out='$out'" >&2

  # ---- Leg S / #343: source-union containment ------------------------------
  # The incident (2026-09-18, editor lane 2fbfb2f8): a #233 bundle SQUASHED
  # from four commits silently dropped a hunk, and this tool answered
  # SWEEP: CLEAN both before and after the hunk was restored. Every pre-#343
  # leg read only the branch's own state, so none of them could see the loss.
  # These legs pin BOTH halves: an INTACT squash must stay clean (the union leg
  # must not cry wolf on the branch shape it exists to serve), and a squash
  # that dropped a line must be a FINDING that NAMES the line.
  git -C "$d" checkout -q -b src "$b"
  printf 'alpha\nbeta\n' > "$d/s.txt"; git -C "$d" add s.txt
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m s1
  s1="$(git -C "$d" rev-parse HEAD)"
  printf 'gamma\n' > "$d/t.txt"; git -C "$d" add t.txt
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m s2
  s2="$(git -C "$d" rev-parse HEAD)"

  git -C "$d" checkout -q -b sqok "$b"
  git -C "$d" -c user.email=t@t -c user.name=t cherry-pick "$s1" "$s2" >/dev/null 2>&1
  git -C "$d" reset -q --soft "$b"
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "squash intact" --trailer "Session-Id: sqok"
  total=$((total+1))
  out="$("$self" sqok --repo "$d" --base "$b" --port-of "$s1,$s2" 2>/dev/null)"; rc=$?
  { [ "$rc" = 0 ] && grep -qF "$(printf 'source-union\tOK')" <<< "$out" && grep -qF 'MATCH (union' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL #343 intact-squash rc=$rc out='$out'" >&2

  git -C "$d" checkout -q -b sqbad "$b"
  git -C "$d" -c user.email=t@t -c user.name=t cherry-pick "$s1" "$s2" >/dev/null 2>&1
  printf 'alpha\n' > "$d/s.txt"; git -C "$d" add s.txt
  git -C "$d" reset -q --soft "$b"
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "squash dropped a line" --trailer "Session-Id: sqbad"
  total=$((total+1))
  out="$("$self" sqbad --repo "$d" --base "$b" --port-of "$s1,$s2" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF "$(printf 'source-union\tFINDING')" <<< "$out" && grep -qF 'beta' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL #343 dropped-hunk rc=$rc out='$out'" >&2

  # a source path the result does not carry AT ALL (the whole hunk lost)
  git -C "$d" checkout -q -b sqgone "$b"
  git -C "$d" -c user.email=t@t -c user.name=t cherry-pick "$s1" >/dev/null 2>&1
  git -C "$d" reset -q --soft "$b"
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "squash lost a file" --trailer "Session-Id: sqgone"
  total=$((total+1))
  out="$("$self" sqgone --repo "$d" --base "$b" --port-of "$s1,$s2" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF "$(printf 'source-union\tFINDING')" <<< "$out" && grep -qF 'ABSENT' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL #343 lost-file rc=$rc out='$out'" >&2

  # the EXACT incident shape: a squash branch swept with no --port-of. Pre-#343
  # this printed "SWEEP: CLEAN" rc=0 having compared the branch against nothing.
  total=$((total+1))
  out="$("$self" sqbad --repo "$d" --base "$b" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF 'no --port-of' <<< "$out" && ! grep -qF 'SWEEP: CLEAN' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL #343 no-port-of rc=$rc out='$out'" >&2

  # ---- Leg R: fork-ref enforcement (#40) ----------------------------------
  # A ported bare `#N` is a lie upstream: DEAD when N is absent there (#86 x10,
  # #116 x13, #350 x3, #352 x7, #396 x10 already shipped in upstream src), and
  # COLLISION when N belongs to an unrelated upstream issue (fork #490
  # notify-tail-loss vs upstream #490 narration-leak), which autolinks silently
  # and is the worse of the two. Each arm gets its OWN commit, and the hex
  # control its OWN branch, so a mutant can redden exactly one leg: the phantom
  # it guards (a colour literal read as a ref) would otherwise inflate the
  # finding count and mask a dead arm.
  git -C "$d" checkout -q -b fr "$b"
  printf 'let a = 1; // see #116 for context\n' > "$d/fr1.txt"; git -C "$d" add fr1.txt
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "fr1 bare line ref" \
    --trailer "Session-Id: ufr1" --trailer "Issue-Ref: leshchenko1979/opencrabs#116"
  c1="$(git -C "$d" rev-parse HEAD)"
  git -C "$d" -c user.email=t@t -c user.name=t commit -q --allow-empty -m "fr2 fix thing (#350)" \
    --trailer "Session-Id: ufr2" --trailer "Issue-Ref: leshchenko1979/opencrabs#350"
  c2="$(git -C "$d" rev-parse HEAD)"
  git -C "$d" -c user.email=t@t -c user.name=t commit -q --allow-empty -m "fr3 bare trailer" \
    --trailer "Session-Id: ufr3" --trailer "Issue-Ref: #86"
  c3="$(git -C "$d" rev-parse HEAD)"
  printf 'x = 1; // upstream #490\n' > "$d/fr5.txt"; git -C "$d" add fr5.txt
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "fr5 collision" \
    --trailer "Session-Id: ufr5" --trailer "Issue-Ref: leshchenko1979/opencrabs#490"
  c5="$(git -C "$d" rev-parse HEAD)"

  # the three FAIL arms (DIFF line, SUBJ, bare trailer) plus the collision WARN
  total=$((total+1))
  out="$("$self" fr --repo "$d" --base "$b" --port-of "$c1,$c2,$c3,$c5" 2>/dev/null)"; rc=$?
  fr_find="$(grep -cF "$(printf 'fork-refs\tFINDING')" <<< "$out" || true)"
  { [ "$rc" = 1 ] && [ "$fr_find" = 3 ] \
    && grep -qF 'fr1.txt:1' <<< "$out" \
    && grep -qF 'subject carries bare fork-only #350' <<< "$out" \
    && grep -qF "bare Issue-Ref '#86'" <<< "$out" \
    && grep -qF "$(printf 'fork-refs\tWARN')" <<< "$out" && grep -qF '#490' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-R arms rc=$rc find=$fr_find out='$out'" >&2

  # THE MEASURED TREE IS PART OF THE RESULT (#40 correction, 2026-10-17). A
  # count taken on the fork and published as upstream's is the exact error that
  # cost a public correction: same predicate, same 19 files, 44 vs 43. The SCOPE
  # row must name the branch AND the resolved commit, so a wrong-tree reading is
  # visible in the output rather than in the prose wrapped around it.
  total=$((total+1))
  frtip="$(git -C "$d" rev-parse --short fr)"
  out="$("$self" fr --repo "$d" --base "$b" --port-of "$c1,$c2,$c3,$c5" 2>/dev/null)"; rc=$?
  { grep -qF "$(printf 'fork-refs\tSCOPE: measured fr @ %s in %s' "$frtip" "$d")" <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-R scope (want fr@$frtip) rc=$rc out='$out'" >&2

  # THE TRAP (measured 2026-10-17): a naive #N matcher reads the theme pack's
  # colour literal #86e1fc as a reference to #86 and reports 4 phantom
  # violations. A matcher that cries wolf on a colour table gets switched off,
  # which is how the leak survived. This branch is clean and must stay clean.
  git -C "$d" checkout -q -b frhex "$b"
  printf 'accent_teal = "#86e1fc"\n' > "$d/fr4.toml"; git -C "$d" add fr4.toml
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "fr4 hex literal" \
    --trailer "Session-Id: ufr4" --trailer "Issue-Ref: leshchenko1979/opencrabs#352"
  c4="$(git -C "$d" rev-parse HEAD)"
  total=$((total+1))
  out="$("$self" frhex --repo "$d" --base "$b" --port-of "$c4" 2>/dev/null)"; rc=$?
  { [ "$rc" = 0 ] && grep -qF "$(printf 'fork-refs\tOK')" <<< "$out" && ! grep -qF 'fr4.toml' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-R hex-control rc=$rc out='$out'" >&2

  # no set at all: the leg must REFUSE to certify, never read as a pass (#343)
  total=$((total+1))
  out="$("$self" fr --repo "$d" --base "$b" --port-of "$c1,$c2,$c3,$c5" --refs-cache "$sd/nope.tsv" 2>/dev/null)"; rc=$?
  { [ "$rc" = 1 ] && grep -qF 'CANNOT CERTIFY' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-R no-cache rc=$rc out='$out'" >&2

  # a stale set is a partial instrument: it must WARN (naming its age) without
  # inventing a failure, so the arm runs on a CLEAN branch and stays rc 0. It
  # must NOT ride the hex branch: a phantom there would redden this leg too and
  # couple two independent properties into one (measured: ARM A of negctl-40
  # dropped 2 legs instead of 1 for exactly that reason).
  git -C "$d" checkout -q -b frc "$b"
  printf 'let z = 1;\n' > "$d/frc.txt"; git -C "$d" add frc.txt
  git -C "$d" -c user.email=t@t -c user.name=t commit -q -m "frc clean" \
    --trailer "Session-Id: ufrc" --trailer "Issue-Ref: leshchenko1979/opencrabs#116"
  c6="$(git -C "$d" rev-parse HEAD)"
  total=$((total+1))
  sed 's/^# as-of: .*/# as-of: 2020-01-01T00:00:00Z/' "$sd/refs.tsv" > "$sd/stale.tsv"
  out="$("$self" frc --repo "$d" --base "$b" --port-of "$c6" --refs-cache "$sd/stale.tsv" 2>/dev/null)"; rc=$?
  { [ "$rc" = 0 ] && grep -qF 're-derive with --refresh-refs' <<< "$out"; } \
    && passed=$((passed+1)) || echo "  FAIL leg-R stale-set rc=$rc out='$out'" >&2

  rm -rf "$d" "$sd" "$td" 2>/dev/null
  echo "selftest OK: $passed/$total legs"
  [ "$passed" = "$total" ]
}

BASE="adolfousier/main"; REPO="$HOME/opencrabs"; PORT=""; BRANCH=""; REFRESH_REFS=0; REFS_CACHE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base) [ $# -ge 2 ] || { echo "oc-harvest-sweep: --base needs a value" >&2; usage; exit 2; }; BASE=""$2""; shift 2 ;;
    --repo) [ $# -ge 2 ] || { echo "oc-harvest-sweep: --repo needs a value" >&2; usage; exit 2; }; REPO=""$2""; shift 2 ;;
    --port-of) [ $# -ge 2 ] || { echo "oc-harvest-sweep: --port-of needs a value" >&2; usage; exit 2; }; PORT=""$2""; shift 2 ;;
    --refs-cache) [ $# -ge 2 ] || { echo "oc-harvest-sweep: --refs-cache needs a value" >&2; usage; exit 2; }; REFS_CACHE="$2"; shift 2 ;;
    --refresh-refs) REFRESH_REFS=1; shift ;;
    --selftest) selftest; exit $? ;;
    -h|--help) usage 0 ;;   # C-#3: help = 0 on STDOUT (usage takes the rc)
    *) if [ -z "$BRANCH" ]; then BRANCH="$1"; else usage; fi; shift ;;
  esac
done
[ -n "$BRANCH" ] || usage
git -C "$REPO" rev-parse --verify -q "$BRANCH" >/dev/null || die 3 "branch not found in $REPO: $BRANCH"
git -C "$REPO" rev-parse --verify -q "$BASE"   >/dev/null || die 3 "base ref not found in $REPO: $BASE (fetch first)"

rc=0
# Leg T — trailer sweep (delegates to oc-attrib --trailers-only, E2 finding 5:
# ONE Session-Id extraction implementation; the old inline %(trailers:) here
# and the sed in oc-attrib had drifted)
MISSING=0
ATTRIB="$OC_TOOLS_DIR/state/oc-attrib"
T_OUT="$("$ATTRIB" --repo "$REPO" --trailers-only --range "$BASE..$BRANCH" 2>/dev/null)" \
  || die 3 "oc-attrib trailers-only failed on $BASE..$BRANCH"
# A here-string built from an EMPTY variable still supplies ONE empty line,
# so an unguarded loop runs its body once with c="" and s="", emitting a
# phantom "trailer-missing" row for a commit that does not exist and turning
# a zero-commit range into a FINDING (#751). Guard the same way Leg U does.
if [ -n "$T_OUT" ]; then
  while IFS=$'\t' read -r c s; do
    [ -n "$c" ] || continue
    if [ -z "$s" ] || [ "$s" = "(unsigned)" ]; then echo -e "trailer-missing\t$c\t$(git -C "$REPO" log -1 --format=%s "$c")"; MISSING=$((MISSING+1)); fi
  done <<< "$T_OUT"
fi
[ "$MISSING" -eq 0 ] && echo -e "trailers\tOK (all $BRANCH commits carry Session-Id)" || { echo -e "trailers\t$MISSING commit(s) MISSING Session-Id"; rc=1; }

# Leg E — empty diff
if [ -z "$(git -C "$REPO" diff "$BASE..$BRANCH")" ]; then
  echo -e "empty-diff\tFINDING: branch has no diff vs $BASE — nothing ported"; rc=1
else
  echo -e "empty-diff\tOK (branch carries a diff vs $BASE)"
fi

# Leg U — upstream path existence & provenance sweep
# For every path modified or deleted on the branch vs base, verify it exists in $BASE
BRANCH_DIFF_FILES="$(git -C "$REPO" diff --name-status "$BASE..$BRANCH" 2>/dev/null || true)"
if [ -n "$BRANCH_DIFF_FILES" ]; then
  while IFS=$'\t' read -r status fpath extra; do
    [ -n "$fpath" ] || continue
    act="${status:0:1}"
    if [ "$act" = "D" ] || [ "$act" = "M" ]; then
      if ! git -C "$REPO" cat-file -e "$BASE:$fpath" 2>/dev/null; then
        echo -e "upstream-void\tFINDING: path $fpath is modified/deleted by $BRANCH but does not exist in $BASE"
        rc=1
      fi
    fi
  done <<< "$BRANCH_DIFF_FILES"
fi

# Leg R — fork-ref enforcement (#40)
# The fork and upstream are DIFFERENT number spaces, so a bare `#N` in ported
# code is not a shorthand, it is a lie: upstream autolinks it to whatever issue
# happens to hold N there. Two arms, and the silent one is worse:
#   DEAD      — N does not exist upstream at all; the ref resolves to nothing.
#   COLLISION — N is a real upstream issue about something else entirely
#               (fork #490 notify-tail-loss vs upstream #490 narration-leak).
# Measured 2026-10-17, before this leg existed: 43 bare fork-only refs already
# in upstream's own src tree (#86 x10, #116 x13, #350 x3, #352 x7, #396 x10),
# and 98 of 125 distinct Issue-Ref trailers on landed commits bare — of which
# 68 collided and 23 were dead.
#
# The fork-only set comes from the TRACKER PAIR, never from a guess, and it is
# cached WITH its own as-of instant: a cache that cannot say when it was taken
# is a claim of absence from an instrument of unknown vintage. With no cache
# the leg REFUSES TO CERTIFY (rc 1) — the #343 precedent: a leg that cannot run
# must never read as a leg that passed.
REFS_CACHE="${REFS_CACHE:-${OC_SWEEP_FORK_ONLY_CACHE:-${OC_DEPLOY_STATE_DIR:-${OC_DEV_STATE:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}}/fork-only-refs.tsv}}"
if [ "$REFRESH_REFS" = 1 ]; then
  _fr_fork="$(gh issue list -R leshchenko1979/opencrabs --state all --limit 2000 --json number --jq '.[].number' 2>/dev/null)"
  _fr_up="$(gh issue list -R opencrabs/opencrabs --state all --limit 4000 --json number --jq '.[].number' 2>/dev/null)"
  if [ -z "$_fr_fork" ] || [ -z "$_fr_up" ]; then
    echo -e "fork-refs\tFINDING: --refresh-refs could not read BOTH trackers (fork $(printf '%s\n' "$_fr_fork" | grep -c . ) number(s), upstream $(printf '%s\n' "$_fr_up" | grep -c .) number(s)) — cache NOT touched; a half-read pair would misclassify every number in the gap"
    rc=1
  else
    _fr_tmp="$(mktemp)"
    {
      printf '# as-of: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '# source: leshchenko1979/opencrabs (fork) minus opencrabs/opencrabs (upstream)\n'
      printf '# format: <number>\\t<fork-only|both>\n'
      comm -23 <(printf '%s\n' "$_fr_fork" | sed '/^$/d' | sort -u) <(printf '%s\n' "$_fr_up" | sed '/^$/d' | sort -u) | sed 's/$/\tfork-only/'
      comm -12 <(printf '%s\n' "$_fr_fork" | sed '/^$/d' | sort -u) <(printf '%s\n' "$_fr_up" | sed '/^$/d' | sort -u) | sed 's/$/\tboth/'
    } > "$_fr_tmp"
    mkdir -p "$(dirname "$REFS_CACHE")" 2>/dev/null
    mv "$_fr_tmp" "$REFS_CACHE" 2>/dev/null \
      || { echo -e "fork-refs\tFINDING: cannot write refs cache $REFS_CACHE"; rc=1; }
  fi
fi

FR_ASOF=""; FR_N=0
if [ -f "$REFS_CACHE" ]; then
  FR_ASOF="$(sed -n 's/^# as-of: //p' "$REFS_CACHE" | head -1)"
  FR_N="$(grep -cvE '^#|^[[:space:]]*$' "$REFS_CACHE" 2>/dev/null || true)"
  [ -n "$FR_N" ] || FR_N=0
fi

FR_FIND=0
# THE MEASURED TREE IS PART OF THE RESULT — printed BEFORE the findings, because
# a count taken on one tree and labelled another is the failure this leg exists
# to prevent and it happened: 2026-10-17 a fork-tree count (44) was published on
# #40 as upstream's figure when upstream's was 43 — same predicate, same 19
# files, different number space, and the corpus is NOT monotone, so neither tree
# substitutes for the other in either direction. Naming the repo and the exact
# commit read puts a wrong-tree measurement in the output instead of in the
# prose wrapped around it.
if [ "$FR_N" -gt 0 ]; then
  echo -e "fork-refs\tSCOPE: measured $BRANCH @ $(git -C "$REPO" rev-parse --short "$BRANCH" 2>/dev/null || echo UNRESOLVED) in $REPO"
fi
# R1 — trailer FORM. Needs no number set: a bare `Issue-Ref: #N` is unattributable
# upstream whichever space N came from, so this arm runs even with no cache.
while IFS=$'\t' read -r _fc _fs; do
  [ -n "$_fc" ] || continue
  while IFS= read -r _ft; do
    [ -n "$_ft" ] || continue
    if [[ "$_ft" =~ ^#[0-9]+$ ]]; then
      echo -e "fork-refs\tFINDING: ${_fc:0:12} bare Issue-Ref '$_ft' — unattributable upstream; write 'Issue-Ref: leshchenko1979/opencrabs${_ft}'"
      rc=1; FR_FIND=$((FR_FIND+1))
    fi
  done <<< "$(git -C "$REPO" log -1 --format='%(trailers:key=Issue-Ref,valueonly)' "$_fc" 2>/dev/null)"
done <<< "$(git -C "$REPO" log --format='%H%x09%s' "$BASE..$BRANCH" 2>/dev/null)"

if [ "$FR_N" -gt 0 ]; then
  # R2/R3 — subject and added-line scan, both keyed on the fork-only set.
  # A line scan reads ADDED lines only (`+` with the +++ header excluded); the
  # `@@ +c,d @@` header supplies the new-file line number so a finding is
  # actionable without a second pass.
  # HEX EXCLUSION (do not remove): the char AFTER the digits is rejected when it
  # is a hex letter, because the TUI theme packs carry colour literals such as
  # #86e1fc, which a naive #N matcher reads as a reference to #86. Measured
  # 2026-10-17: 4 such literals in upstream src (3 in tokyonight.toml, 1 in the
  # json fixture) produce exactly 4 phantom findings, and a matcher that cries
  # wolf on a colour table gets switched off — which is how the leak survived.
  FR_ROWS="$(
    { git -C "$REPO" log --format='SUBJ%x09%H%x09%s' "$BASE..$BRANCH" 2>/dev/null
      git -C "$REPO" diff --no-color -U0 "$BASE..$BRANCH" 2>/dev/null
    } | awk -v setf="$REFS_CACHE" '
      BEGIN { while ((getline l < setf) > 0) { if (l ~ /^#/ || l ~ /^[[:space:]]*$/) continue; split(l, f, "\t"); if (f[2]=="fork-only") fo[f[1]]=1; else if (f[2]=="both") bo[f[1]]=1 } }
      /^SUBJ\t/ { split($0, a, "\t"); c=a[2]; s=a[3]
        while (match(s, /#[0-9]+/)) {
          pre=(RSTART>1)?substr(s,RSTART-1,1):""; num=substr(s,RSTART+1,RLENGTH-1); post=substr(s,RSTART+RLENGTH,1)
          if (post !~ /^[0-9a-fA-F]$/ && pre !~ /[A-Za-z0-9_&#\/]/ && (num in fo)) printf "SUBJ\t%s\t%s\t%s\n", c, num, a[3]
          s=substr(s,RSTART+RLENGTH)
        }
        next }
      /^diff --git / { path=""; nl=0; next }
      /^\+\+\+ / { path=$0; sub(/^\+\+\+ (b\/)?/,"",path); next }
      /^@@ / { if (match($0, /\+[0-9]+/)) nl=substr($0,RSTART+1,RLENGTH-1)+0; next }
      /^\+/ { s=$0
        while (match(s, /#[0-9]+/)) {
          pre=(RSTART>1)?substr(s,RSTART-1,1):""; num=substr(s,RSTART+1,RLENGTH-1); post=substr(s,RSTART+RLENGTH,1)
          if (post !~ /^[0-9a-fA-F]$/ && pre !~ /[A-Za-z0-9_&#\/]/) {
            if (num in fo) printf "DIFF\t%s:%d\t%s\t%s\n", path, nl, num, substr($0,2)
            else if (num in bo) printf "BOTH\t%s:%d\t%s\t%s\n", path, nl, num, substr($0,2)
          }
          s=substr(s,RSTART+RLENGTH)
        }
        nl++; next }
      /^ / { nl++ }
    '
  )"
  # the port's own Issue-Ref numbers: the ONLY disambiguator for a BOTH hit
  FR_CLAIM_NUMS="$(git -C "$REPO" log --format='%(trailers:key=Issue-Ref,valueonly)' "$BASE..$BRANCH" 2>/dev/null | grep -oE '#[0-9]+' | tr -d '#' | sort -u)"
  while IFS=$'\t' read -r _fcls _floc _fnum _ftxt; do
    [ -n "$_fcls" ] || continue
    case "$_fcls" in
      DIFF) echo -e "fork-refs\tFINDING: $_floc bare #$_fnum is FORK-ONLY (dead upstream) — $_ftxt"; rc=1; FR_FIND=$((FR_FIND+1)) ;;
      SUBJ) echo -e "fork-refs\tFINDING: commit ${_floc:0:12} subject carries bare fork-only #$_fnum — $_ftxt"; rc=1; FR_FIND=$((FR_FIND+1)) ;;
      BOTH) if oc_has "$FR_CLAIM_NUMS" "$_fnum"; then
              echo -e "fork-refs\tWARN: $_floc bare #$_fnum exists on BOTH trackers and this port's Issue-Ref names it — upstream autolinks the OTHER issue; qualify it — $_ftxt"
            fi ;;
    esac
  done <<< "$FR_ROWS"
  if [ "$FR_FIND" -eq 0 ]; then
    echo -e "fork-refs\tOK (no bare fork-only refs in subject, added lines or trailers; set as-of ${FR_ASOF:-unknown}, $FR_N numbers)"
  fi
  # a stale set is a partial instrument: it cannot see a fork issue opened since
  # it was taken, so say so rather than let the OK row imply a full sweep
  if [ -n "$FR_ASOF" ]; then
    _fr_a="$(date -u -d "$FR_ASOF" +%s 2>/dev/null || true)"
    if [ -n "$_fr_a" ]; then
      _fr_age=$(( ( $(date -u +%s) - _fr_a ) / 3600 ))
      [ "$_fr_age" -gt 24 ] && echo -e "fork-refs\tWARN: ref set as-of $FR_ASOF is ${_fr_age}h old — a fork issue opened since then is NOT in the set (re-derive with --refresh-refs)"
    fi
  fi
else
  echo -e "fork-refs\tFINDING: no fork-only ref set at $REFS_CACHE — CANNOT CERTIFY (run with --refresh-refs, or pass --refs-cache <path>)"
  rc=1
fi

# Leg S — source-union containment (#343)
# Every other leg reads the BRANCH's own state, so a squash/rebase that
# silently DROPPED a hunk produced the same verdict as an intact port
# (measured 2026-09-18, editor lane 2fbfb2f8: a #233 bundle squashed from four
# commits lost its adaptation of an upstream test, and this tool answered
# SWEEP: CLEAN both BEFORE and AFTER the hunk was restored). This is the only
# leg that reads the SOURCE commits.
#
# Predicate: for every path the source set touches, every line the source set
# ADDED and never REMOVED must be present in the branch's result tree. A line
# the source added and a LATER source commit removed is not owed by the result
# (that is why the union is `added - removed`, not `added`).
#
# One-directional failure: a reformat (whitespace) of a ported line reports a
# FINDING, which costs a look. A dropped line that no other leg can see costs
# a corrupted upstream PR. Refusing to certify is the safe direction.
UNION_OK=0
if [ -z "$PORT" ]; then
  echo -e "source-union\tFINDING: no --port-of — the branch content was never compared against its source commits (pass --port-of sha1,sha2)"
  rc=1
else
  S_ROWS="$(mktemp)"; S_REQ="$(mktemp)"; S_PATHS="$(mktemp)"
  S_UNRESOLVED=0
  IFS=',' read -ra PCS_S <<< "$PORT"
  for psha in "${PCS_S[@]}"; do
    [ -n "$psha" ] || continue
    git -C "$REPO" rev-parse --verify -q "$psha^{commit}" >/dev/null 2>&1 || { S_UNRESOLVED=$((S_UNRESOLVED+1)); continue; }
    # Parse per-commit diffs. `h` gates on the first @@ so the ---/+++ FILE
    # headers (which precede any hunk) are never mistaken for content, and a
    # source line that itself begins with -- or ++ cannot be either.
    git -C "$REPO" show "$psha" --format= -p 2>/dev/null | awk '
      /^diff --git / { p=$NF; sub(/^b\//,"",p); h=0; next }
      /^@@/         { h=1; next }
      !h            { next }
      /^\+/         { printf "A\037%s\037%s\n", p, substr($0,2); next }
      /^-/          { printf "R\037%s\037%s\n", p, substr($0,2); next }
    ' >> "$S_ROWS"
  done
  awk -F'\037' '
    $1=="A" { a[$2 "\037" $3]=1; next }
    $1=="R" { r[$2 "\037" $3]=1; next }
    END { for (k in a) if (!(k in r)) print k }
  ' "$S_ROWS" > "$S_REQ"
  awk -F'\037' '{print $1}' "$S_REQ" | sort -u > "$S_PATHS"
  S_MISS=0; S_PATHS_N=0
  while IFS= read -r fpath; do
    [ -n "$fpath" ] || continue
    S_PATHS_N=$((S_PATHS_N+1))
    if ! git -C "$REPO" cat-file -e "$BRANCH:$fpath" 2>/dev/null; then
      n_req="$(awk -F'\037' -v p="$fpath" '$1==p' "$S_REQ" | wc -l)"
      echo -e "source-union\tFINDING: $fpath is carried by the source set but ABSENT from $BRANCH ($n_req source line(s) unverifiable)"
      rc=1; S_MISS=$((S_MISS+1)); continue
    fi
    content="$(git -C "$REPO" show "$BRANCH:$fpath" 2>/dev/null)"
    n_req=0; n_missing=0; first=""
    while IFS=$'\037' read -r rp rl; do
      [ "$rp" = "$fpath" ] || continue
      n_req=$((n_req+1))
      if ! grep -qxF -- "$rl" <<< "$content"; then
        n_missing=$((n_missing+1)); [ -n "$first" ] || first="$rl"
      fi
    done < "$S_REQ"
    if [ "$n_missing" -gt 0 ]; then
      echo -e "source-union\tFINDING: $fpath — $n_missing of $n_req source line(s) absent from $BRANCH (first: $(printf '%.100s' "$first"))"
      rc=1; S_MISS=$((S_MISS+1))
    fi
  done < "$S_PATHS"
  if [ "$S_UNRESOLVED" -gt 0 ]; then
    echo -e "source-union\tFINDING: $S_UNRESOLVED source sha(s) unresolvable — content NOT compared"
    rc=1
  elif [ "$S_MISS" -eq 0 ] && [ "$S_PATHS_N" -gt 0 ]; then
    echo -e "source-union\tOK ($S_PATHS_N path(s) of the source set fully present in $BRANCH)"
    UNION_OK=1
  elif [ "$S_MISS" -eq 0 ]; then
    echo -e "source-union\tOK (source set carries no added line to verify)"
  fi
  rm -f "$S_ROWS" "$S_REQ" "$S_PATHS" 2>/dev/null
fi

# Leg P — patch-id verification of ported shas
if [ -n "$PORT" ]; then
  # Per-commit patch-ids (lesson n=1543, template tools/harvest/oc-upstream-delta
  # ABSORBED-CANDIDATE block): `git log -p --format=` strips the commit
  # delimiter lines git patch-id uses to split patches, so a multi-commit
  # range concatenates into ONE garbage patch-id and every port check on it
  # silently NO-MATCHes. Computing ONE patch-id per commit survives
  # multi-commit cherry chains.
  BRANCH_PIDS="$(git -C "$REPO" rev-list "$BASE..$BRANCH" | while read -r c; do
    git -C "$REPO" show "$c" --format= -p 2>/dev/null | git patch-id --stable | cut -d' ' -f1
  done)"
  IFS=',' read -ra PCS <<< "$PORT"
  for psha in "${PCS[@]}"; do
    pid="$(git -C "$REPO" show "$psha" --format= -p 2>/dev/null | git patch-id --stable | cut -d' ' -f1)"
    if [ -z "$pid" ]; then echo -e "patch-id:$psha\tERROR: cannot compute patch-id (bad sha?)"; rc=1
    elif oc_has "$BRANCH_PIDS" "$pid"; then echo -e "patch-id:$psha\tMATCH on $BRANCH"
    elif [ "$UNION_OK" = 1 ]; then
      # #343: a SQUASH (or a rebase that resolved a conflict) rewrites the
      # patch, so NO per-commit patch-id can survive it -- pre-#343 every
      # squashed harvest read NO-MATCH and the tool was unusable on the very
      # branches it was built for. Leg S proved the source set's content IS
      # fully present, so the port is accounted for.
      echo -e "patch-id:$psha\tMATCH (union: content present in $BRANCH via Leg S)"
    else echo -e "patch-id:$psha\tNO-MATCH on $BRANCH (not ported yet, or content drifted)"; rc=1; fi
  done
fi

if [ "$rc" -eq 0 ]; then echo "SWEEP: CLEAN — mechanical legs pass, gate dispatch may proceed"; else echo "SWEEP: FINDINGS — resolve rows above BEFORE the first gate dispatch"; fi
exit "$rc"
