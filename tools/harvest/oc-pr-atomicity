#!/usr/bin/env bash
# =============================================================================
# oc-pr-atomicity — verify a PR is ATOMIC before the issue is closed.
#
#   Atomicity contract (owner directive 2026-08-26, v0.4.15):
#     - one problem per issue, one logical change per commit, ONE issue per PR
#     - every commit in the PR carries an Issue-Ref: #N trailer matching
#       EXACTLY the single issue the PR body claims (Closes #N / Refs #N)
#     - a PR whose diff mixes fixed and unfixed concerns forces a binary
#       status on a mixed bag and mislabels both
#
# Checks (all LIVE against the API at call time — relay-predication):
#   1. ARG SHAPE   — PR number is a positive integer         (else exit 1)
#   2. PR EXISTS   — gh api pulls/{n} state != 404           (else exit 4)
#   3. BODY CLAIM  — extract issue refs from the PR body
#                    (Closes/Fixes/Refs #N)                  (else exit 2
#                    if ZERO claims — a PR must claim one issue)
#   4. ONE ISSUE   — more than one distinct claimed issue    (else exit 2
#                    MIXED)
#   5. PER-COMMIT  — every commit in the PR carries an
#                    Issue-Ref (or Closes/Refs/Fixes) trailer naming
#                    the claimed issue; commits without one or with a
#                    mismatched ref fail                     (else exit 2)
#
# Exit codes: 0 ATOMIC | 1 invocation | 2 NON-ATOMIC (detail on stderr + JSON)
#             4 PR not found / API error
#
# Deps: gh (authenticated), jq. CLI output paging handled via --paginate
# (SKILL.md §Upstream relations item 5 — never conclude from the first page).
# =============================================================================
set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"   # unified tools log (D0, 2026-08-28)
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-pr-atomicity" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

REPO="${OC_REPO:-adolfousier/opencrabs}"
VERBOSE=0

fail() { echo "oc-pr-atomicity: $2" >&2; exit "$1"; }
say()  { [ "$VERBOSE" = 1 ] && echo "$*" >&2 || true; }

usage() { # C-#3: --help/-h answers 0 on STDOUT; a usage error answers 2 on STDERR
  # Deliberately does NOT exit: the callers choose their own rc (the register's
  # invocation code is 1, not 2), so only the STREAM is selected here.
  local fd=2
  [ "${1:-2}" = 0 ] && fd=1
  echo "Usage: oc-pr-atomicity <pr-number> [--repo R] [--verbose] [--selftest]" >&$fd
  echo "Exit: 0 ATOMIC | 1 invocation | 2 NON-ATOMIC | 4 PR not found" >&$fd
}

selftest() {
  local passed=0 total=10 rc d perr jout
  d="$(mktemp -d)"
  # gh is stubbed on PATH and dispatches on the API PATH it is asked for, so
  # every gate below runs with no network and no repo.
  mkdir -p "$d/bin"
  printf '%s\n' '#!/bin/sh' \
    '[ "${STUB_API_FAIL:-0}" = "1" ] && exit 1' \
    'case "$2" in' \
    '  *pulls/*/commits*) printf "%s\n" "$STUB_SHAS" ;;' \
    '  *pulls/*)          printf "%s\n" "$STUB_PR" ;;' \
    '  *commits/*)        printf "%s\n" "$STUB_MSG" ;;' \
    'esac' \
    'exit 0' > "$d/bin/gh"
  python3 -c 'import os,sys; os.chmod(sys.argv[1],0o755)' "$d/bin/gh" 2>/dev/null \
    || chmod +x "$d/bin/gh"
  local sha="aaaaaaaabbbbbbbbccccccccddddddddeeeeeeee"
  local pr="5"

  # (1-4) ARG SHAPE — plus the --repo value guard added for #744.
  "$0" >/dev/null 2>&1;              rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))
  "$0" abc >/dev/null 2>&1;          rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))
  "$0" -1 >/dev/null 2>&1;           rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))
  "$0" "$pr" --repo >/dev/null 2>&1; rc=$?; [ "$rc" = 1 ] && passed=$((passed+1))

  # (5) PR EXISTS — the API call fails -> rc 4
  perr="$(PATH="$d/bin:$PATH" STUB_API_FAIL=1 "$0" "$pr" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 4 ] && grep -qF 'not found on' <<< "$perr" && passed=$((passed+1))

  # (6-9) four rc-2 arms. All four return 2, so each asserts its OWN message.
  # (6) BODY CLAIM — the body names no issue at all
  perr="$(PATH="$d/bin:$PATH" STUB_PR='{"state":"open","title":"t","body":"no reference here"}' \
    STUB_SHAS="$sha" STUB_MSG="Issue-Ref: #42" "$0" "$pr" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 2 ] && grep -qF 'claims NO issue' <<< "$perr" && passed=$((passed+1))
  # (7) ONE ISSUE — the body claims two distinct issues
  perr="$(PATH="$d/bin:$PATH" STUB_PR='{"state":"open","title":"t","body":"Closes #42\nRefs #43"}' \
    STUB_SHAS="$sha" STUB_MSG="Issue-Ref: #42" "$0" "$pr" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 2 ] && grep -qF 'MIXED' <<< "$perr" && passed=$((passed+1))
  # (8) PER-COMMIT — the commit carries no Issue-Ref trailer
  perr="$(PATH="$d/bin:$PATH" STUB_PR='{"state":"open","title":"t","body":"Closes #42"}' \
    STUB_SHAS="$sha" STUB_MSG="just a subject" "$0" "$pr" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 2 ] && grep -qF 'no Issue-Ref trailer' <<< "$perr" && passed=$((passed+1))
  # (9) PER-COMMIT — the trailer names a DIFFERENT issue than the body claims
  perr="$(PATH="$d/bin:$PATH" STUB_PR='{"state":"open","title":"t","body":"Closes #42"}' \
    STUB_SHAS="$sha" STUB_MSG="Issue-Ref: #99" "$0" "$pr" 2>&1 1>/dev/null)"
  rc=$?
  [ "$rc" = 2 ] && grep -qF '!= claimed' <<< "$perr" && passed=$((passed+1))

  # (10) ATOMIC — one claim, and the commit's trailer names it -> rc 0
  jout="$(PATH="$d/bin:$PATH" STUB_PR='{"state":"open","title":"t","body":"Closes #42"}' \
    STUB_SHAS="$sha" STUB_MSG="fix: something

Issue-Ref: #42" "$0" "$pr" 2>/dev/null)"
  rc=$?
  [ "$rc" = 0 ] && grep -qF '"atomic": true' <<< "$jout" && passed=$((passed+1))

  rm -rf "$d"
  if [ "$passed" = "$total" ]; then
    echo "selftest OK: $passed/$total cases (no network)"
  else
    echo "selftest FAIL: $passed/$total cases (no network)" >&2
  fi
  [ "$passed" = "$total" ]
}

PR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)     [ $# -ge 2 ] || { echo "oc-pr-atomicity: --repo needs a value" >&2; usage; exit 1; }; REPO="$2"; shift 2 ;;
    --verbose)  VERBOSE=1; shift ;;
    --selftest) selftest; exit $? ;;
    -h|--help)  usage 0; exit 0 ;;
    *)
      if [ -z "$PR" ]; then PR="$1"; else usage; exit 1; fi
      shift ;;
  esac
done

[ -n "$PR" ] || fail 1 "missing <pr-number> argument"
printf '%s' "$PR" | grep -Eq '^[1-9][0-9]*$' \
  || fail 1 "pr-number must be a positive integer, got '$PR'"

# ---- 2. PR EXISTS ----------------------------------------------------------
PR_JSON="$(gh api "repos/$REPO/pulls/$PR" --jq '{state,title,body}' 2>/dev/null)" \
  || fail 4 "PR #$PR not found on $REPO (or API error)"
STATE="$(printf '%s' "$PR_JSON" | jq -r .state)"
BODY="$(printf '%s' "$PR_JSON" | jq -r .body)"
say "PR #$PR state=$STATE on $REPO"

# ---- 3. BODY CLAIM ---------------------------------------------------------
CLAIMS="$(printf '%s\n' "$BODY" | grep -oE '(Closes|Fixes|Refs)[[:space:]]*#?[0-9]+|issues/[0-9]+' | grep -oE '[0-9]+' | sort -u)"
[ -n "$CLAIMS" ] \
  || fail 2 "PR body claims NO issue (no Closes/Fixes/Refs #N, no .../issues/N URL) — a PR must claim exactly one"

# ---- 4. ONE ISSUE ----------------------------------------------------------
NCLAIMS="$(printf '%s\n' "$CLAIMS" | wc -l | tr -d ' ')"
{ [ "$NCLAIMS" = 1 ] || fail 2 "MIXED: PR body claims $NCLAIMS distinct issues ($(printf '%s' "$CLAIMS" | tr '\n' ' ')) — one PR = one issue (atomicity)"; }

# ---- 5. PER-COMMIT ---------------------------------------------------------
COMMITS="$(gh api "repos/$REPO/pulls/$PR/commits?per_page=100" --paginate --jq '.[] | .sha')" \
  || fail 4 "cannot list commits for PR #$PR"
[ -n "$COMMITS" ] || fail 4 "PR #$PR has no commits"

N_BAD=0
BAD_CMTS=""
while read -r sha; do
  [ -n "$sha" ] || continue
  CMT="$(gh api "repos/$REPO/commits/$sha" --jq .commit.message 2>/dev/null)" || continue
  # check-5 trailer extraction: accepts bare (#99), digits-only (99), AND the
  # qualified cross-repo form mandated by fork #54 (leshchenko1979/opencrabs#102).
  # Qualified refs were previously invisible here (regex extracted bare digits
  # only) — patched 2026-09-06 per HQ ruling (wave #1414-#1418, ledger n=162x).
  REF="$(printf '%s\n' "$CMT" | sed -n 's/^\(Issue-Ref\|Closes\|Refs\|Fixes\):[[:space:]]*//p' | head -1 | sed 's|^[A-Za-z0-9._/-]*#||; s|^#||' | sed -n 's/^\([0-9]\+\).*/\1/p')"
  if [ -z "$REF" ]; then
    N_BAD=$((N_BAD+1)); BAD_CMTS="${BAD_CMTS}  ${sha}  (no Issue-Ref trailer)\n"
  elif [ "$REF" != "$CLAIMS" ]; then
    N_BAD=$((N_BAD+1)); BAD_CMTS="${BAD_CMTS}  ${sha}  (Issue-Ref #${REF} != claimed #${CLAIMS})\n"
  fi
done <<EOF
$COMMITS
EOF

if [ "$N_BAD" -gt 0 ]; then
  printf 'oc-pr-atomicity: NON-ATOMIC — %d commit(s) fail the Issue-Ref check (claimed issue #%s):\n%b' \
    "$N_BAD" "$CLAIMS" "$BAD_CMTS" >&2
  exit 2
fi

N_CMTS="$(printf '%s\n' "$COMMITS" | grep -c .)"
jq -n --arg repo "$REPO" --arg pr "$PR" --arg state "$STATE" --arg issue "$CLAIMS" --argjson n "$N_CMTS" \
  '{atomic:true, repo:$repo, pr:($pr|tonumber), state:$state, claimed_issue:($issue|tonumber), commits_checked:$n}'
exit 0