# --- Gate-4 subject-predicate fixture (#365) ---------------------------------
# Builds a REAL git repo whose upstream ref (`adolfousier/main`) and fork range
# (`adolfousier/main..origin/main`) exercise gate 4 end to end. The offline
# selftest's synthetic commit dicts cannot: gate 4 derives symbols from real
# diffs, so a fixture that only fakes commit metadata would test nothing.
#
# Shape (target #901, orphan path src/orphan.rs introduced by #900):
#   A  base commit            src/base.rs  -> upstream copy (adolfousier/main)
#   B  add src/orphan.rs      Issue-Ref #900   (the orphan's provenance)
#   C  parent #900's work     mode=harvested   -> inside fn base_fn  (upstream-present symbol)
#                             mode=unharvested -> inside fn orphan_fn (fork-only symbol)
#   D  target #901's fix      inside fn base_fn AND src/orphan.rs (M) -> gate 4's file loop
#
# `nosym` mode (#365 declared-subject fallback) is a DIFFERENT shape: the target's
# diff yields NO symbol at all, so the derivation is inconclusive rather than a
# fork-only verdict, and the class-3 refusal must consult a declared subject.
#   A  base commit            src/base.rs + README.md  -> upstream copy
#   D  target #902's fix      README.md (M) only -- a hunk with no enclosing fn,
#                             so derive_symbols partitions NOTHING (both the
#                             present and absent lists come back empty).
#
# `$1` = repo dir, `$2` = harvested|unharvested|nosym, `$3` = Subject: trailer
# value for the target commit (optional; empty = no trailer).
build_gate4_fixture() {
  _fx_dir="$1"
  _fx_mode="$2"
  _fx_subject="${3:-}"
  mkdir -p "$_fx_dir/src"
  git -C "$_fx_dir" init -q
  git -C "$_fx_dir" config user.name fixture
  git -C "$_fx_dir" config user.email fixture@example.invalid
  git -C "$_fx_dir" config commit.gpgsign false

  printf 'pub fn base_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/base.rs"
  printf '# fixture\n' > "$_fx_dir/README.md"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "base"
  _fx_a="$(git -C "$_fx_dir" rev-parse HEAD)"
  git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$_fx_a"

  if [ "$_fx_mode" = "nosym" ]; then
    # Target #902: a README-only change. No fn decl in the hunk header and no
    # enclosing fn to back-scan to, so no symbol is derived from the diff.
    printf '# fixture\n\nnote\n' > "$_fx_dir/README.md"
    git -C "$_fx_dir" add -A
    if [ -n "$_fx_subject" ]; then
      git -C "$_fx_dir" commit -q -m "target fix" \
        --trailer "Issue-Ref: leshchenko1979/opencrabs#902" \
        --trailer "Subject: $_fx_subject"
    else
      git -C "$_fx_dir" commit -q -m "target fix" \
        --trailer "Issue-Ref: leshchenko1979/opencrabs#902"
    fi
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "subject_absent" ]; then
    # #253 shape: every touched FILE exists upstream, but the fix's subject
    # SYMBOL does not. The fork added the fn in an earlier commit, so the
    # back-scan over the old file names a symbol upstream has never carried.
    # Class 2 finds no orphan path (the file is upstream) and class 3 refuses on
    # POSITIVE evidence -- case (a), where the declared-subject fallback must
    # stay out of the way.
    printf 'pub fn keep_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/keep.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "add keep.rs" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    # Re-point upstream AFTER keep.rs exists: the file must be present upstream
    # while the fork-only symbol is not, which is the whole shape.
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    printf 'pub fn keep_fn() -> u8 {\n    1\n}\n\npub fn fork_only_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/keep.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#903"

    # Target #904: a line INSIDE fork_only_fn, so the derived symbol is the
    # fork-only one and every touched file is upstream-present.
    printf 'pub fn keep_fn() -> u8 {\n    1\n}\n\npub fn fork_only_fn() -> u8 {\n    3\n}\n' > "$_fx_dir/src/keep.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#904"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "orphan_subject" ]; then
    # #341 shape (the live instance): the fix touches an ORPHAN path AND a
    # symbol that IS upstream. The orphan is added with NO Issue-Ref, so the
    # provenance lookup finds no introducing issue and the path can only be
    # reported as an ADVISORY -- class 2 cannot refuse, and class 3 passes on the
    # upstream-present subject. Non-blocking is the point of this shape.
    printf 'pub fn orphan_test_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/orphan_test.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "add orphan test helper"

    printf 'pub fn base_fn() -> u8 {\n    7\n}\n' > "$_fx_dir/src/base.rs"
    printf 'pub fn orphan_test_fn() -> u8 {\n    8\n}\n' > "$_fx_dir/src/orphan_test.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#905"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  printf 'pub fn orphan_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/orphan.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "add fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

  if [ "$_fx_mode" = "harvested" ]; then
    # Parent work lands in an upstream-present symbol -> parent HARVESTED.
    printf 'pub fn base_fn() -> u8 {\n    3\n}\n' > "$_fx_dir/src/base.rs"
  else
    # Parent work lands only in the fork-only symbol -> parent UNHARVESTED.
    printf 'pub fn orphan_fn() -> u8 {\n    4\n}\n' > "$_fx_dir/src/orphan.rs"
  fi
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "parent work" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

  # Target's own fix: one upstream-present symbol (so class 3 passes) plus a
  # modification to the orphan path (so gate 4's file loop reaches class 2).
  printf 'pub fn base_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/base.rs"
  printf 'pub fn orphan_fn() -> u8 {\n    6\n}\n' > "$_fx_dir/src/orphan.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#901"

  git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
}

