  fi
  rc=0
  out="$(bash "$0" record --unit "bogus-unit" --status bogus --issue "999993" --state-file "$cu_reg" 2>&1)" || rc=$?
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$cu_reg" "bogus-unit" 2>&1)" || rc=$?
