cmd_record() {
  local unit="" pr="" issue="" issues_str="" status="" reason=""
  local branches="" revert="" verified_at=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --unit) [ $# -ge 2 ] || { echo "oc-harvest-census: --unit needs a value" >&2; usage; }; unit="$2"; shift 2 ;;
      --state-file) [ $# -ge 2 ] || { echo "oc-harvest-census: --state-file needs a value" >&2; usage; }; REGISTRY_FILE="$2"; shift 2 ;;
      --pr) [ $# -ge 2 ] || { echo "oc-harvest-census: --pr needs a value" >&2; usage; }; pr="$2"; shift 2 ;;
      --issue) [ $# -ge 2 ] || { echo "oc-harvest-census: --issue needs a value" >&2; usage; }; issue="$2"; shift 2 ;;
      --issues) [ $# -ge 2 ] || { echo "oc-harvest-census: --issues needs a value" >&2; usage; }; issues_str="$2"; shift 2 ;;
      --status) [ $# -ge 2 ] || { echo "oc-harvest-census: --status needs a value" >&2; usage; }; status="$2"; shift 2 ;;
      --reason) [ $# -ge 2 ] || { echo "oc-harvest-census: --reason needs a value" >&2; usage; }; reason="$2"; shift 2 ;;
      --branches) [ $# -ge 2 ] || { echo "oc-harvest-census: --branches needs a value" >&2; usage; }; branches="$2"; shift 2 ;;
      --revert) [ $# -ge 2 ] || { echo "oc-harvest-census: --revert needs a value" >&2; usage; }; revert="$2"; shift 2 ;;
      --verified-at) [ $# -ge 2 ] || { echo "oc-harvest-census: --verified-at needs a value" >&2; usage; }; verified_at="$2"; shift 2 ;;
      --repo) [ $# -ge 2 ] || { echo "oc-harvest-census: --repo needs a value" >&2; usage; }; REPO="$2"; shift 2 ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  if [ -z "$unit" ]; then
    usage
  fi
  # #564: a NOT-UPSTREAMABLE record has no PR to name -- demanding one is what
  # forced the upstream-issue number into the pr field in the first place. Only
  # the `filed` arm requires a PR number.
  if [ -z "$status" ]; then
    status="filed"
  fi
  if [ "$status" = "filed" ] && [ -z "$pr" ]; then
    usage
  fi
  if [ -z "$pr" ]; then
    pr=0
  fi
  if [ -f "$REGISTRY_FILE" ]; then
    python3 -c '
import sys, json, os, datetime, re
reg_file, unit, pr, issue, issues_str = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
status, reason, branches, revert, verified_at = sys.argv[6], sys.argv[7], sys.argv[8], sys.argv[9], sys.argv[10]
with open(reg_file) as f:
    data = json.load(f)
records = data.setdefault("manual_records", [])
all_issues = set()
if issue:
    all_issues.add(int(issue))
if issues_str:
    for m in re.finditer(r"\d+", issues_str):
        all_issues.add(int(m.group(0)))

record_entry = {
    "unit": unit,
    "pr": int(pr),
    "issue": int(issue) if issue else (sorted(list(all_issues))[0] if all_issues else None),
    "issues": sorted(list(all_issues)),
    "recorded_at": datetime.datetime.now(datetime.timezone.utc).isoformat()
}
# #564: the status vocabulary is written ONLY when it carries information, so a
# plain `filed` row keeps the pre-schema shape exactly and nothing downstream
# has to know the field exists.
if status and status != "filed":
    record_entry["status"] = status
if reason:
    record_entry["reason"] = reason
# #761: three OPTIONAL fields for a not-upstreamable row -- absent unless
# supplied, so the 61 pre-existing rows keep their exact shape and meaning.
# `branches` = the branch/commit set carrying the unit; `revert` = the revert
# recipe; `verified_at` = when the sync leg last re-checked the premise.
# They join the carry-forward set below so a re-record never drops them.
if branches:
    record_entry["branches"] = [b.strip() for b in branches.split(",") if b.strip()]
if revert:
    record_entry["revert"] = revert
if verified_at:
    record_entry["verified_at"] = verified_at
# #761/#733: the row IDENTITY is the UNIT -- never (unit, pr, issue).
# oc_claims.manual_record_matches() matches a target on unit OR issue, so
# `unit` is the only identity anything downstream consumes; the old
# (unit, pr, issue) key invented a SECOND identity the consumer never had.
# A re-record that omitted --issue therefore landed on a different key and
# APPENDED a duplicate instead of updating, and purge refuses by design
# (harvest.md:418), so the duplicate was permanent. Live corpse when this
# landed: unit 725 carried two rows.
key = str(record_entry["unit"])
replaced = 0
for i, existing in enumerate(records):
    if str(existing.get("unit")) == key:
        # #564/#761: the upsert REPLACES the whole row, so a re-record that
        # omits a field would silently DROP what a prior lane set -- the same
        # shape as the old "write-only, dumps a two-key dict, erases
        # manual_records" defect. Carry the prior values forward for EVERY
        # field this call did not supply, uniformly.
        for _fld in ("status", "reason", "issue", "issues", "branches", "revert", "verified_at"):
            if record_entry.get(_fld) in (None, "", [], {}) and existing.get(_fld) not in (None, "", [], {}):
                record_entry[_fld] = existing[_fld]
        if not int(record_entry.get("pr") or 0) and existing.get("pr"):
            record_entry["pr"] = existing["pr"]
        records[i] = record_entry
        replaced = 1
        break
if not replaced:
    records.append(record_entry)
with open(reg_file, "w") as f:
    json.dump(data, f, indent=2)
verb = "Updated" if replaced else "Recorded"
_what = ("NOT UPSTREAMABLE" if record_entry.get("status") == "not-upstreamable"
         else ("CONDITIONALLY UPSTREAMABLE" if record_entry.get("status") == "conditionally-upstreamable"
               else ("PR #%s" % record_entry["pr"] if int(record_entry.get("pr") or 0) else "NO PR recorded")))
_final_issues = record_entry.get("issues", [])
print(f"{verb} Unit {unit} -> {_what} (issues: {_final_issues}) in {reg_file}")
' "$REGISTRY_FILE" "$unit" "$pr" "$issue" "$issues_str" "$status" "$reason" "$branches" "$revert" "$verified_at"
  else
    echo "Recorded Unit $unit -> PR #$pr (registry uninitialized)"
  fi
  exit 0
}

