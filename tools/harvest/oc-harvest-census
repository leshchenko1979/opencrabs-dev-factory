  fi

  # 9f. #761: the three OPTIONAL not-upstreamable annotations round-trip. They
  #     are written ONLY when supplied (so the 61 pre-existing rows keep their
  #     exact shape), but a later re-record that omits them must not silently
  #     DROP them -- the #564 carry-forward rule, extended to the #761 fields.
  bash "$0" record --unit "ann-unit" --status not-upstreamable \
