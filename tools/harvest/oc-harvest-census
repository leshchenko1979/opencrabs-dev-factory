def filter_substantive_overlap(overlap_set):
    return {f for f in overlap_set if f not in SHARED_DECLARATION_REGISTRIES}

def get_affected_files_for_commits(commits_list, repo_path):
    files = set()
    for c in commits_list:
        if isinstance(c, dict):
            if 'files' in c and isinstance(c['files'], list):
                for f in c['files']:
                    if f.strip(): files.add(f.strip())
                continue
            sha = c.get('sha', '')
        else:
            sha = str(c)
        if sha and os.path.isdir(repo_path):
            res = subprocess.run(['git', '-C', repo_path, 'diff-tree', '--no-commit-id', '--name-only', '-r', sha], capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.strip():
                for f in res.stdout.strip().split('\n'):
                    if f.strip(): files.add(f.strip())
    return sorted(list(files))

def get_affected_file_actions_for_commits(commits_list, repo_path):
    file_actions = {}
    for c in commits_list:
        sha = c.get('sha', '') if isinstance(c, dict) else str(c)
        if sha and os.path.isdir(repo_path):
            res = subprocess.run(['git', '-C', repo_path, 'diff-tree', '--no-commit-id', '--name-status', '-r', sha], capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.strip():
                for line in res.stdout.strip().split('\n'):
                    if not line.strip(): continue
                    parts = line.split('\t')
                    action = parts[0][0] if parts[0] else 'M'
                    f_path = parts[-1].strip()
                    if f_path:
                        file_actions.setdefault(f_path, set()).add(action)
    return file_actions

def check_upstream_file_existence(path, base_ref, repo_path):
    res = subprocess.run(['git', '-C', repo_path, 'cat-file', '-e', f'{base_ref}:{path}'], capture_output=True, text=True)
    return res.returncode == 0

def ref_exists(base_ref, repo_path):
    # Gate-4 RUNNABILITY, not a verdict. The upstream comparison is only
    # meaningful against a resolvable base ref in a real git repo; the offline
    # selftest drives the engine against a plain temp dir with synthetic commit
    # dicts, where every git call fails and "no subject derived" would be a
    # FALSE refusal (#365 — caught by the selftest itself on the unharvested
    # case). Absent a base ref the gate is not exercisable, so it is skipped
    # exactly as the file test skipped it before; a real repo always has the ref.
    if not repo_path or not os.path.isdir(repo_path):
        return False
    return subprocess.run(['git', '-C', repo_path, 'rev-parse', '--verify', '--quiet', base_ref],
                          capture_output=True).returncode == 0

def commits_present(commits_list, repo_path):
    # The fix's own commits must be IN the repo for its diff to be derivable.
    # Synthetic/mocked commit dicts (selftest) name shas that do not exist, so
    # nothing is derivable and the subject test cannot speak — skip, don't refuse.
    for c in commits_list or []:
        sha = c.get('sha', '') if isinstance(c, dict) else str(c)
        if not sha or not repo_path:
            continue
        if subprocess.run(['git', '-C', repo_path, 'cat-file', '-e', sha + '^{commit}'],
                          capture_output=True).returncode == 0:
            return True
    return False

def check_fork_path_provenance(path, repo_path):
    range_arg = 'adolfousier/main..origin/main'
    rc_rev = subprocess.run(['git', '-C', repo_path, 'rev-parse', '--verify', 'origin/main'], capture_output=True).returncode
    if rc_rev != 0:
        range_arg = 'adolfousier/main..HEAD'
    res = subprocess.run([
        'git', '-C', repo_path, 'log', '--diff-filter=A',
        '--format=%H%x09%s%x09%(trailers:key=Issue-Ref,valueonly)',
        '-1', range_arg, '--', path
    ], capture_output=True, text=True)
    if res.returncode == 0 and res.stdout.strip():
        parts = res.stdout.strip().split('\t')
        intro_sha = parts[0]
        intro_subj = parts[1] if len(parts) > 1 else ''
        intro_tr = parts[2] if len(parts) > 2 else ''
        # #369: canonical trailer parse (fork space only) with the
        # explicit-`#N` subject fallback — never a bare digit run.
        _refs = oc_claims.commit_issue_refs(intro_tr, intro_subj)
        intro_iss = _refs[0] if _refs else None
        return intro_sha, intro_iss, intro_subj
    return None, None, None

# --- #365: SUBJECT derivation (symbol-level gate-4 predicate) ----------------
# Gate 4 historically decided on the FILE test: any touched path absent from
# `adolfousier/main` -> UPSTREAM_VOID. The codified law (HQ ruling 2026-09-18,
# v0.4.201, triage.md "Closure predicate for fork-only base-fault fixes") makes
# the operative question the fix's SUBJECT, and names the file test as the wrong
# one. The derivation below reads the subject out of the fix's OWN diff, so it
# needs no declared metadata and cannot be gamed by naming an unrelated symbol.
#
# The derivation is heuristic and its limits are MEASURED, not assumed. On the
# #341 fix (commits 6a83afd4e + 1ddf5f7d1): 25 hunks at -U0, 12 resolved from
# the hunk header, 12 by backward-scan, 1 unresolved (a module-level `use`).
# Two known hazards, both tolerated because the gate's job is to stop
# UNHARVESTABLE units, never to certify that a diff ports cleanly:
#   * a hunk header may name a NEARBY item rather than the edited one (git
#     headed a CONFIG_TYPO_WARNINGS doc-comment hunk `FIRST_LOAD_STATUS`);
#   * a bare `impl` header forces a backward scan that can land on a
#     function-local `static` (a naive scan returned `CHECKED`), so the scan
#     prefers the nearest `fn` and falls back to a static name only if none.
# Anything unresolved falls through to the declared-subject path (fail-closed).

_HUNK_RE = re.compile(r'^@@ -(\d+)(?:,\d+)? \+\d+(?:,\d+)? @@(.*)$')
_FN_DECL_RE = re.compile(r'^\s*(?:pub(?:\([^)]*\))?\s+)?(?:const\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+([A-Za-z_][A-Za-z0-9_]*)')
_STATIC_DECL_RE = re.compile(r'^\s*(?:pub(?:\([^)]*\))?\s+)?static\s+([A-Za-z_][A-Za-z0-9_]*)')

def _show_at_rev(sha, path, repo_path, rev=None):
    spec = ('%s:%s' % (rev, path)) if rev else ('%s^:%s' % (sha, path))
    res = subprocess.run(['git', '-C', repo_path, 'show', spec], capture_output=True, text=True)
    return res.stdout if res.returncode == 0 else ''

def _nearest_enclosing_fn(lines, start_idx):
    fallback_static = None
    for i in range(min(start_idx, len(lines) - 1), -1, -1):
        m = _FN_DECL_RE.match(lines[i])
        if m:
            return m.group(1)
        s = _STATIC_DECL_RE.match(lines[i])
        if s and fallback_static is None:
            fallback_static = s.group(1)
    return fallback_static

def derive_symbols(commits_list, repo_path):
    # Symbols touched by the fix, read from the fix's own diff.
    # Takes the same commits_list shape as get_affected_files_for_commits (the
    # sibling helper in this file) rather than a raw range string: the callers
    # hold matching_commits already, and re-deriving a range would duplicate the
    # #323 target-resolution logic that built it.
    pairs = []
    stats = {'hunks': 0, 'header': 0, 'backscan': 0, 'unresolved': 0}
    for c in commits_list:
        sha = c.get('sha', '') if isinstance(c, dict) else str(c)
        if not sha or not os.path.isdir(repo_path):
            continue
        res = subprocess.run(['git', '-C', repo_path, 'show', '--format=', '--unified=0', sha],
                             capture_output=True, text=True)
        if res.returncode != 0 or not res.stdout:
            continue
        cur_file = None
        old_lines = None
        for line in res.stdout.split('\n'):
            if line.startswith('+++ b/'):
                cur_file = line[6:].strip()
                old_lines = None
                continue
            if not line.startswith('@@'):
                continue
            m = _HUNK_RE.match(line)
            if not m:
                continue
            stats['hunks'] += 1
            fm = _FN_DECL_RE.search(m.group(2).strip())
            if fm:
                stats['header'] += 1
                pairs.append((cur_file, fm.group(1)))
                continue
            if old_lines is None and cur_file:
                old_lines = _show_at_rev(sha, cur_file, repo_path).split('\n')
            sym = _nearest_enclosing_fn(old_lines or [], int(m.group(1)) - 1)
            if sym:
                stats['backscan'] += 1
            else:
                stats['unresolved'] += 1
            pairs.append((cur_file, sym))
    return pairs, stats

def subject_present_upstream(pairs, repo_path, base_ref='adolfousier/main'):
    # FILE-SCOPED subject test: a symbol counts only when it resolves in the
    # UPSTREAM copy of the SAME file. A global `git grep -c S <base_ref> -- src/`
    # is satisfied by generic names (initialize, create_job, update_job and the
    # function-local CHECKED all match upstream trivially), so a fix whose real
    # subject is fork-only could ride one of them into eligibility. Scoping to
    # the same file removes every cross-file match; a generic name that also
    # exists in the same upstream file remains the residual risk, which is why
    # the orphan paths are still reported as ADVISORY for the harvester to read.
    cache = {}
    present, absent = [], []
    for f_path, sym in pairs:
        if not sym or not f_path:
            continue
        if f_path not in cache:
            res = subprocess.run(['git', '-C', repo_path, 'show', '%s:%s' % (base_ref, f_path)],
                                 capture_output=True, text=True)
            cache[f_path] = res.stdout if res.returncode == 0 else None
        body = cache[f_path]
        if body is not None and re.search(r'(?<![A-Za-z0-9_])' + re.escape(sym) + r'(?![A-Za-z0-9_])', body):
            present.append((f_path, sym))
        else:
            absent.append((f_path, sym))
    return present, absent

def issue_subject_upstream(iss, repo_path, base_ref='adolfousier/main'):
    # Class-2 SUB-RULE (#365): the provenance lookup answers "which fork issue
    # introduced this path?" — never "is that issue's work upstream yet?".
    #
    # #341 is the live instance. Its one orphan path carries an introducing
    # issue (#148), and #148's subsystem IS upstream: the validator was deleted
    # there deliberately (5a1cedb2e, Issue-Ref: #148) and the replacement landed
    # upstream via PR #1497 (merged 2026-09-10). A path left behind by an
    # ALREADY-HARVESTED parent is not a held child. Refusing it as
    # HELD_PARENT_UNHARVESTED blocks a standalone fix outright AND owes an
    # --add-blocked-by link to a parent that has already landed — the link the
    # issue-linking law would then demand for no reason.
    #
    # Reuses the fix's own derivation on the introducing issue's commits, so
    # both classes share ONE definition of "subject present" (DRY): the
    # mechanism that decides the fix's own subject decides the parent's.
    #
    # True = parent harvested (fall through to the class-3 subject test)
    # False = parent still fork-only (refuse HELD_PARENT_UNHARVESTED)
    # None = undeterminable, no anchored commits (callers read as unharvested:
    #        the gate never loosens on missing evidence)
    try:
        shas = oc_claims.resolve_issue_commits(repo_path, iss)
    except Exception:
        return None
    if not shas:
        return None
    pairs, _stats = derive_symbols(shas, repo_path)
    present, _absent = subject_present_upstream(pairs, repo_path, base_ref)
    return bool([1 for _f, sym in present if sym])

def declared_subject_from_commits(commits_list, repo_path):
    # #365 FALLBACK source: a `Subject:` trailer on the fix's OWN commits.
    #
    # git-native by construction -- the value travels with the commit, so it
    # needs no external metadata store and cannot be edited without rewriting
    # history. Read only from the commits that matched the target, so a
    # declaration can only ever describe the unit actually under test.
    #
    # Comma-separated (separator=%x2c) for the same reason Issue-Ref is: two
    # Subject: lines must not concatenate into one garbage value.
    for c in commits_list or []:
        sha = c.get('sha', '') if isinstance(c, dict) else str(c)
        if not sha or not repo_path:
            continue
        res = subprocess.run(['git', '-C', repo_path, 'log', '-1',
                              '--format=%(trailers:key=Subject,valueonly,separator=%x2c)', sha],
                             capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    return ''

def declared_subject_present(declared, repo_path, base_ref='adolfousier/main'):
    # Is the DECLARED subject present upstream? FAIL-CLOSED on everything else.
    #
    # The declared value is free text, not a derived symbol, so it is tested by a
    # literal fixed-string grep over the upstream tree rather than the
    # file-scoped symbol predicate. Every other outcome -- an empty declaration,
    # an unresolvable base ref, a grep error -- returns False: the fallback may
    # only LOOSEN a refusal when presence is positively established, never by
    # default.
    if not declared or not repo_path or not os.path.isdir(repo_path):
        return False
    if not ref_exists(base_ref, repo_path):
        return False
    res = subprocess.run(['git', '-C', repo_path, 'grep', '-q', '-F', '-e', declared, base_ref],
                         capture_output=True)
    return res.returncode == 0


# ---- clusters: the CLUSTER SURFACER -----------------------------------------
# The soak gate holds a CLUSTER while OPEN FIX-TYPE issues are linked to its
# population, so clusters have to be DERIVED. Hand-building them in a chat turn
# is what produced three different published numbers (46 -> 41 -> 35) for the
# same tree, through three separate manual errors: a commit-prefix classifier
# used where the owner said fix-type ISSUES, an OPEN/open case bug, and a
# silent head truncation. This verb removes all three by construction.

# Trap (a): the owner's unit is fix-type ISSUES, so the filter is the ISSUE
# TITLE. A commit-prefix classifier is a different population -- measured at 90
# clusters against the title filter's 41, the largest single error source.
FIX_TITLE_RE = re.compile(r'^\s*fix\b', re.I)
FEAT_SUBJECT_RE = re.compile(r'^\s*feat\b', re.I)


def get_fork_issues(fork_repo='leshchenko1979/opencrabs', mock_file=None):
    """ONE call for every fork issue: number -> {title, state}.

    Batched deliberately -- a per-issue `gh issue view` is ~110 calls for a
    cluster run. Trap (b): gh returns `state` LOWERCASE ('open'), so every
    comparison against 'OPEN' returns zero silently. Lowercasing happens here,
    once, so no caller can reintroduce it.
    """
    if mock_file and os.path.exists(mock_file):
        try:
            with open(mock_file) as f:
                loaded = json.load(f)
        except Exception:
            return None
        recs = loaded if isinstance(loaded, list) else loaded.get('issues', [])
        out = {}
        for rec in recs:
            try:
                out[int(rec['number'])] = {
                    'title': rec.get('title', ''),
                    'state': str(rec.get('state', '')).lower(),
                }
            except (KeyError, TypeError, ValueError):
                continue
        return out
    res = subprocess.run(
        ['gh', 'issue', 'list', '--repo', fork_repo, '--state', 'all',
         '--limit', '1000', '--json', 'number,title,state'],
        capture_output=True, text=True)
    if res.returncode != 0:
        return None
    try:
        recs = json.loads(res.stdout)
    except Exception:
        return None
    out = {}
    for rec in recs:
        try:
            out[int(rec['number'])] = {
                'title': rec.get('title', ''),
                'state': str(rec.get('state', '')).lower(),
            }
        except (KeyError, TypeError, ValueError):
            continue
    return out


def cluster_ahead_commits(commits):
    """Group fork-only commits by their canonical issue ref.

    Predicate is `oc_claims.commit_issue_refs` -- the SAME canonical parse
    `scan` already uses: the machine-readable Issue-Ref TRAILER first, the
    subject's explicit `#N` only as a fallback. Clustering on the subject's
    first `#NNN` alone would file a prose mention ("law: name the four #547
    commits bundled in v0.4.249") as that issue's work -- the false-credit the
    C8 gate was corrected for (#565).
    """
    clusters = {}
    unclustered = []
    for c in commits:
        refs = oc_claims.commit_issue_refs(c.get('trailer', ''), c.get('subject', ''))
        if not refs:
            unclustered.append(c)
            continue
        iss = min(refs)
        entry = clusters.setdefault(iss, {'issue': iss, 'commits': []})
        entry['commits'].append(c)
    return clusters, unclustered


def cluster_is_mixed(commits):
    """Trap (d): a fix-TITLED cluster can still carry feat(...) commits.

    Flagged, never counted as pure -- a cluster whose issue reads fix but whose
    history adds a feature is not a fix cluster, and the soak gate keys on the
    cluster's population.
    """
    return any(FEAT_SUBJECT_RE.match(c.get('subject', '') or '') for c in commits)


def cluster_files(commits, repo_path):
    return set(get_affected_files_for_commits(commits, repo_path))


def cluster_links(files_by_cluster):
    """The dependency leg, from the COMMIT/FILE graph.

    Deliberately NOT the gh blockedBy link: a live dependent (#218) passed the
    vet CLEAN with no link at all and only flipped to REJECTED after the lane
    declared it by hand. A link nobody wrote cannot be the gate's input, so the
    graph is the input and the link is at best a corroboration.
    """
    links = {}
    for iss, files in files_by_cluster.items():
        linked = set()
        for other, other_files in files_by_cluster.items():
            if other == iss:
                continue
            if filter_substantive_overlap(files & other_files):
                linked.add(other)
        links[iss] = sorted(linked)
    return links

# --- Cluster-set readiness (#607) ------------------------------------------
# The owner's rule (2026-09-26): a cluster's set is READY only when every
# member is swapped+smoked+CLOSED and the NEWEST member's swap is >24h old.
# Two graph legs feed it, and neither alone works:
#   * the FILE leg (cluster_links, 1-hop) is degenerate as a set former --
#     weakly-connected closure puts 55 of 58 open fix clusters in one knot;
#   * the GH leg is the "relationship graph" the runbook already names
#     (upstream-merge-runbook.md:294): the issue itself, its parent, its
#     sub-issues, its blocker/blocked dependencies -- DIRECT only. Transitive
#     closure of either graph collapses the delta into 3 mega-components.
# So the base unit stays the ISSUE CLUSTER and the union is of the HOLD
# VERDICTS, never of the edge sets.

_REL_CACHE = {}

def get_issue_relations(issue_num, fork_repo, mock_file=None):
    """DIRECT gh relatives of an issue: parent, sub-issues, blockedBy, blocking.

    Returns a set of ints (never includes the issue itself). Returns None when
    the relations cannot be read -- absence of evidence is not "no relatives",
    and a hold predicate that treats an unreadable graph as empty would report
    a held cluster as free. The caller must disclose a None.
    """
    key = int(issue_num)
    if key in _REL_CACHE:
        return _REL_CACHE[key]
    rels = None
    if mock_file and os.path.exists(mock_file):
        try:
            with open(mock_file) as f:
                loaded = json.load(f)
            rec = loaded.get(str(key), loaded.get(key))
            if isinstance(rec, dict):
                rels = set()
                par = rec.get('parent')
                if isinstance(par, int):
                    rels.add(par)
                for k in ('subIssues', 'blockedBy', 'blocking'):
                    for n in (rec.get(k) or []):
                        if isinstance(n, int):
                            rels.add(n)
            elif isinstance(rec, list):
                rels = {int(n) for n in rec if str(n).isdigit()}
        except Exception:
            rels = None
    else:
        res = subprocess.run(
            ['gh', 'issue', 'view', str(key), '--repo', fork_repo, '--json',
             'parent,subIssues,blockedBy,blocking'],
            capture_output=True, text=True)
        if res.returncode == 0:
            try:
                d = json.loads(res.stdout)
                rels = set()
                par = d.get('parent')
                if isinstance(par, dict) and isinstance(par.get('number'), int):
                    rels.add(par['number'])
                for k in ('subIssues', 'blockedBy', 'blocking'):
                    for n in ((d.get(k) or {}).get('nodes') or []):
                        if isinstance(n.get('number'), int):
                            rels.add(n['number'])
            except Exception:
                rels = None
        # rc != 0 -> rels stays None (unreadable, NOT empty)
    rels = None if rels is None else {n for n in rels if n != key}
    _REL_CACHE[key] = rels
    return rels


def cluster_set(iss, fork_repo, mock_file=None):
    """The cluster's set: its own issue UNION its DIRECT gh relatives.

    Includes the issue ITSELF. The previous view subtracted it
    (`- {r['cluster']}`), which contradicted the owner's rule: readiness needs
    every member CLOSED, so an open own-issue is an unready member of its own
    set. Returns (members, relations_readable).
    """
    rels = get_issue_relations(iss, fork_repo, mock_file)
    if rels is None:
        return ({int(iss)}, False)
    return ({int(iss)} | rels, True)


def build_commits_by_issue(commits):
    """issue number -> [commit dicts], by the canonical ref parse."""
    out = {}
    for c in commits:
        for n in oc_claims.commit_issue_refs(c.get('trailer', ''), c.get('subject', '')):
            out.setdefault(int(n), []).append(c)
    return out


def set_soak_clock(member_issues, commits_by_issue, repo_path, swaps, now_ts,
                   mock_deployed_ts=None, state_dir=None):
    """The set's soak anchor: the YOUNGEST member swap (max deploy ts).

    Clock direction is deliberate and stated because the sources disagree: the
    original spec's formula read `min over members of swap_ts` (= the OLDEST
    swap) while its own prose and the owner's rule both say the anchor is the
    NEWEST member's swap. max() matches the prose and the owner's wording.

    Returns (anchor_ts, age_hours, scanned_commits, anchor_sha). anchor_ts == 0
    with age_hours None means the clock is UNRESOLVABLE -- the caller must print
    a NOTE, never read it as fresh and never as clean. anchor_sha is the commit
    the anchor came from, so the refusal can name it rather than print a blank
    anchor_commit= field.
    """
    anchor = 0
    anchor_sha = ''
    scanned = 0
    for iss in sorted(member_issues):
        # #625: a harvested member's commits are not in the fork-only delta, so
        # the clock must read the widened index too or it silently ignores the
        # very members the readiness predicate now accepts.
        _mcs, _ = member_commits(iss, commits_by_issue, repo_path)
        for c in _mcs:
            scanned += 1
            sha = c.get('sha', '')
            # The commit's OWN deployed_ts is the first source, exactly as the
            # per-unit soak legs read it. Without this the fixture/mock path is
            # invisible here and every set reads UNRESOLVABLE.
            d_ts = c.get('deployed_ts') or get_commit_deploy_ts(
                sha, repo_path, swaps, mock_deployed_ts, state_dir)
            if not d_ts and not swaps and not os.environ.get('OC_HARVEST_MOCK_DEPLOYED_TS'):
                d_ts = c.get('commit_ts', 0)
            if d_ts and d_ts > anchor:
                anchor = d_ts
                anchor_sha = sha
    if not anchor:
        return (0, None, scanned, '')
    return (anchor, (now_ts - anchor) / 3600.0, scanned, anchor_sha)

action = sys.argv[1]
