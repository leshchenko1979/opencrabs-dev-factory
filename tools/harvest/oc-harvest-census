# --- Gate-4 subject-predicate fixture (#365) ---------------------------------
# Builds a REAL git repo whose upstream ref (`adolfousier/main`) and fork range
# (`adolfousier/main..origin/main`) exercise gate 4 end to end. The offline
# selftest's synthetic commit dicts cannot: gate 4 derives symbols from real
# diffs, so a fixture that only fakes commit metadata would test nothing.
#
# Shape (target #901, orphan path src/orphan.rs introduced by #900):
#   A  base commit            src/base.rs  -> upstream copy (adolfousier/main)
#   B  add src/orphan.rs      Issue-Ref #900   (the orphan's provenance)
#   C  parent #900's work     mode=harvested   -> inside fn base_fn  (upstream-present symbol)
#                             mode=unharvested -> inside fn orphan_fn (fork-only symbol)
#   D  target #901's fix      inside fn base_fn AND src/orphan.rs (M) -> gate 4's file loop
#
# `nosym` mode (#365 declared-subject fallback) is a DIFFERENT shape: the target's
# diff yields NO symbol at all, so the derivation is inconclusive rather than a
# fork-only verdict, and the class-3 refusal must consult a declared subject.
#   A  base commit            src/base.rs + README.md  -> upstream copy
#   D  target #902's fix      README.md (M) only -- a hunk with no enclosing fn,
#                             so derive_symbols partitions NOTHING (both the
#                             present and absent lists come back empty).
#
# `$1` = repo dir, `$2` = harvested|unharvested|nosym, `$3` = Subject: trailer
# value for the target commit (optional; empty = no trailer).
build_gate4_fixture() {
  _fx_dir="$1"
  _fx_mode="$2"
  _fx_subject="${3:-}"
  mkdir -p "$_fx_dir/src"
  git -C "$_fx_dir" init -q
  git -C "$_fx_dir" config user.name fixture
  git -C "$_fx_dir" config user.email fixture@example.invalid
  git -C "$_fx_dir" config commit.gpgsign false

  printf 'pub fn base_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/base.rs"
  printf '# fixture\n' > "$_fx_dir/README.md"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "base"
  _fx_a="$(git -C "$_fx_dir" rev-parse HEAD)"
  git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$_fx_a"

  if [ "$_fx_mode" = "nosym" ]; then
    # Target #902: a README-only change. No fn decl in the hunk header and no
    # enclosing fn to back-scan to, so no symbol is derived from the diff.
    printf '# fixture\n\nnote\n' > "$_fx_dir/README.md"
    git -C "$_fx_dir" add -A
    if [ -n "$_fx_subject" ]; then
      git -C "$_fx_dir" commit -q -m "target fix" \
        --trailer "Issue-Ref: leshchenko1979/opencrabs#902" \
        --trailer "Subject: $_fx_subject"
    else
      git -C "$_fx_dir" commit -q -m "target fix" \
        --trailer "Issue-Ref: leshchenko1979/opencrabs#902"
    fi
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "subject_absent" ]; then
    # #253 shape: every touched FILE exists upstream, but the fix's subject
    # SYMBOL does not. The fork added the fn in an earlier commit, so the
    # back-scan over the old file names a symbol upstream has never carried.
    # Class 2 finds no orphan path (the file is upstream) and class 3 refuses on
    # POSITIVE evidence -- case (a), where the declared-subject fallback must
    # stay out of the way.
    printf 'pub fn keep_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/keep.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "add keep.rs" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    # Re-point upstream AFTER keep.rs exists: the file must be present upstream
    # while the fork-only symbol is not, which is the whole shape.
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    printf 'pub fn keep_fn() -> u8 {\n    1\n}\n\npub fn fork_only_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/keep.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#903"

    # Target #904: a line INSIDE fork_only_fn, so the derived symbol is the
    # fork-only one and every touched file is upstream-present.
    printf 'pub fn keep_fn() -> u8 {\n    1\n}\n\npub fn fork_only_fn() -> u8 {\n    3\n}\n' > "$_fx_dir/src/keep.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#904"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "orphan_subject" ]; then
    # #341 shape (the live instance): the fix touches an ORPHAN path AND a
    # symbol that IS upstream. The orphan is added with NO Issue-Ref, so the
    # provenance lookup finds no introducing issue and the path can only be
    # reported as an ADVISORY -- class 2 cannot refuse, and class 3 passes on the
    # upstream-present subject. Non-blocking is the point of this shape.
    printf 'pub fn orphan_test_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/orphan_test.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "add orphan test helper"

    printf 'pub fn base_fn() -> u8 {\n    7\n}\n' > "$_fx_dir/src/base.rs"
    printf 'pub fn orphan_test_fn() -> u8 {\n    8\n}\n' > "$_fx_dir/src/orphan_test.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#905"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "container_hunk" ]; then
    # #7 shape: a fork-only `fn` sits ABOVE an upstream-present struct, and one
    # of the target's hunks is a line INSIDE the struct. At -U0 git's hunk
    # header names the STRUCT (`@@ ... @@ pub(crate) struct StreamingState {`),
    # so pre-#7 the header test (fn-only) matched nothing and the backward scan
    # (fn/static-only) skipped the struct and landed on the fork-only fn above:
    # every derived symbol read absent upstream -> a false UPSTREAM_VOID refusal
    # plus a false "dropped at packaging" advisory.
    #
    # The target drives BOTH hunks in one unit: one inside the struct
    # (upstream-present -> StreamingState) and one inside the fork-only fn
    # (absent -> still flagged). So the fixed engine must read ELIGIBLE, must
    # name clean_tool_entry in the advisory, and must NOT name StreamingState.
    printf 'pub(crate) struct StreamingState {\n    pub chat: u8,\n}\n' > "$_fx_dir/src/flow.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "upstream struct" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    # Upstream carries the struct and NOT the fork-only helper added next.
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    # The fork adds a helper ABOVE the struct -- the wrong back-scan target.
    printf 'pub fn clean_tool_entry() -> u8 {\n    1\n}\n\npub(crate) struct StreamingState {\n    pub chat: u8,\n}\n' > "$_fx_dir/src/flow.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#903"

    # Target #907: a line inside the struct AND a line inside the fork-only fn.
    printf 'pub fn clean_tool_entry() -> u8 {\n    2\n}\n\npub(crate) struct StreamingState {\n    // fork-only doc line\n    pub chat: u8,\n}\n' > "$_fx_dir/src/flow.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#907"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "doc_hunk" ]; then
    # #10 shape: a DOC-COMMENT-ONLY hunk sits BETWEEN a fork-only `fn` above it
    # and its real owner -- an upstream-present `fn` -- below. At -U0 git's hunk
    # header names the PRECEDING fn (its context runs backward), so pre-#10 the
    # rewritten `///` line was scored against the fork-only fn and read as a
    # FALSE "dropped at packaging" advisory (#674). Post-#10 the doc-only hunk
    # resolves FORWARD, in the post-commit file, to the fn it documents, which
    # IS upstream -> ELIGIBLE.
    #
    # The target drives BOTH hunks in one unit, so the pair is its own control:
    # hunk A is the doc-comment line (must resolve to base_fn, upstream-present),
    # hunk B a CODE line inside the fork-only fn (must still resolve BACKWARD to
    # fork_only_fn and stay flagged). A predicate that forward-resolved every
    # hunk, or that stopped attributing, reddens this leg.
    printf 'pub fn base_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/flow.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "upstream base_fn" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    # Upstream carries base_fn and NOT the fork-only helper added next.
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    # The fork adds a helper ABOVE base_fn -- the wrong back-scan target -- with
    # the `///` doc line and an `#[...]` attribute (both skipped by the forward
    # scan) between them.
    printf 'pub fn fork_only_fn() -> u8 {\n    1\n}\n\n/// old doc for base_fn\n#[allow(dead_code)]\npub fn base_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/flow.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "fork-only helper above base_fn" --trailer "Issue-Ref: leshchenko1979/opencrabs#903"

    # Target #907: a doc-only change to the `///` line AND a code change inside
    # the fork-only fn. The doc hunk's header names fork_only_fn; its TRUE owner
    # is base_fn.
    printf 'pub fn fork_only_fn() -> u8 {\n    2\n}\n\n/// new doc for base_fn\n#[allow(dead_code)]\npub fn base_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/flow.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target doc-only fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#907"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "symbol_diverged" ] || [ "$_fx_mode" = "symbol_same_sig" ]; then
    # #758 shape: the hunk's enclosing symbol EXISTS upstream by NAME, so the
    # fork-only advisory never fires for it -- but its fork definition may have
    # DIVERGED (signature or return type), and then the port cannot resolve:
    # `git apply --check` fails on the hunk while `check` still reads ELIGIBLE.
    # `symbol_diverged` rewrites the SIGNATURE; `symbol_same_sig` is the
    # NEGATIVE CONTROL -- identical signature, body-only difference -- and must
    # NOT raise the NOTE. Without that control the new signal could fire on
    # every upstream-present symbol and still pass every leg.
    if [ "$_fx_mode" = "symbol_diverged" ]; then
      _fx_sig='pub fn base_fn(extra: u8) -> u8'
    else
      _fx_sig='pub fn base_fn() -> u8'
    fi
    printf '%s {\n    9\n}\n' "$_fx_sig" > "$_fx_dir/src/base.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "fork change to base_fn" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

    # Target #906: a line INSIDE base_fn. The symbol is upstream-present by NAME
    # in BOTH modes, so gate 4 passes and the unit reads ELIGIBLE either way --
    # which is precisely the false green #758 reports for the diverged shape.
    printf '%s {\n    2\n}\n' "$_fx_sig" > "$_fx_dir/src/base.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#906"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "symbol_diverged_long" ]; then
    # #765: the SAME shape as `symbol_diverged`, but the two headers agree for
    # MORE than the 140 chars the NOTE used to print, so the divergence sits
    # entirely INSIDE the truncated region -- both sides rendered identically and
    # the NOTE read as a tool artifact. The leg asserts the differing TAIL is
    # named; it reddens on the pre-#765 code, which is what makes it a control.
    _fx_up='pub fn base_fn(aaaaaaaaaaaa: u8, bbbbbbbbbbbb: u8, cccccccccccc: u8, dddddddddddd: u8, eeeeeeeeeeee: u8, ffffffffffff: u8, gggggggggggg: u8, hhhhhhhhhhhh: u8, iiiiiiiiiiii: u8) -> u8'
    _fx_fork='pub fn base_fn(aaaaaaaaaaaa: u8, bbbbbbbbbbbb: u8, cccccccccccc: u8, dddddddddddd: u8, eeeeeeeeeeee: u8, ffffffffffff: u8, gggggggggggg: u8, hhhhhhhhhhhh: u8, iiiiiiiiiiii: u8, jjjjjjjjjjjj: u32) -> u8'
    printf '%s {\n    9\n}\n' "$_fx_up" > "$_fx_dir/src/base.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "upstream long signature" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    # Re-point upstream AT the long header: the divergence must lie past the old
    # 140-char prefix or this leg tests nothing.
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    printf '%s {\n    2\n}\n' "$_fx_fork" > "$_fx_dir/src/base.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#906"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "parent_added_absent" ] || [ "$_fx_mode" = "parent_added_present" ]; then
    # #633 shape: the parent's hunks sit INSIDE an upstream-present symbol, so
    # the enclosing-symbol derivation read "parent already harvested" -- while
    # the declaration the parent actually ADDED is fork-only. `parent_added_absent`
    # is the defect; `parent_added_present` is the POSITIVE CONTROL (the parent's
    # added declaration IS upstream), so a predicate that simply returned False
    # for every parent could not pass both.
    printf 'pub fn shared_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/shared.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "shared base"
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    if [ "$_fx_mode" = "parent_added_absent" ]; then
      # Parent #900 adds a FORK-ONLY declaration inside the upstream-present file.
      printf 'pub fn shared_fn() -> u8 {\n    1\n}\n\npub fn fork_feature() -> u8 {\n    3\n}\n' > "$_fx_dir/src/shared.rs"
      printf 'pub fn orphan_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/orphan.rs"
      git -C "$_fx_dir" add -A
      git -C "$_fx_dir" commit -q -m "parent work" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    else
      # POSITIVE CONTROL: the parent's added declaration IS upstream (its own
      # commit is the upstream ref), and a LATER commit under the same issue
      # adds the orphan path that did not travel.
      printf 'pub fn shared_fn() -> u8 {\n    1\n}\n\npub fn base_fn() -> u8 {\n    3\n}\n' > "$_fx_dir/src/shared.rs"
      git -C "$_fx_dir" add -A
      git -C "$_fx_dir" commit -q -m "parent work (harvested)" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
      git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"
      printf 'pub fn orphan_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/orphan.rs"
      git -C "$_fx_dir" add -A
      git -C "$_fx_dir" commit -q -m "parent post-harvest work" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    fi

    # Target #901: an upstream-present symbol (class 3 passes) plus the orphan
    # path (so gate 4's file loop reaches class 2).
    printf 'pub fn shared_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/shared.rs"
    printf 'pub fn orphan_fn() -> u8 {\n    6\n}\n' > "$_fx_dir/src/orphan.rs"
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#901"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  if [ "$_fx_mode" = "fork_only_dep" ] || [ "$_fx_mode" = "fork_only_dep_ok" ] \
     || [ "$_fx_mode" = "fork_only_dep_doc" ]; then
    # #758 / #761 step 2b shape: the hunk's enclosing symbol IS upstream by NAME
    # (so neither the fork-only advisory nor UPSTREAM_VOID fires) and its
    # signature is IDENTICAL -- yet the hunk's body references a declaration
    # upstream does not carry, so the port cannot resolve. `fork_only_dep` is the
    # defect (#757: `pace_rich` upstream, `spacing_floor_ms` fork-only);
    # `fork_only_dep_ok` is the POSITIVE CONTROL -- the referenced declaration IS
    # upstream -- so a predicate that simply refused every unit could not pass
    # both legs. Signature is deliberately NOT diverged in either mode: the
    # refusal must key on the DEPENDENCY, not on the divergence NOTE.
    #
    # #764 adds `fork_only_dep_doc`: the SAME fork-only dependency, named ONLY in
    # PROSE -- a `//!` module doc, a `///` doc line and a string literal. It must
    # stay ELIGIBLE, and that is what makes the pair discriminating: a predicate
    # that reads PROSE passes `fork_only_dep` and fails this leg, while a
    # predicate that simply stopped refusing passes this leg and fails
    # `fork_only_dep`. Neither leg alone can tell those two apart.
    printf 'pub fn base_fn() -> u8 {\n    1\n}\n' > "$_fx_dir/src/dep.rs"
    if [ "$_fx_mode" = "fork_only_dep_ok" ]; then
      printf 'pub fn base_fn() -> u8 {\n    1\n}\n\npub fn shared_helper() -> u8 {\n    2\n}\n' > "$_fx_dir/src/dep.rs"
    fi
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "dep base"
    git -C "$_fx_dir" update-ref refs/remotes/adolfousier/main "$(git -C "$_fx_dir" rev-parse HEAD)"

    if [ "$_fx_mode" = "fork_only_dep" ] || [ "$_fx_mode" = "fork_only_dep_doc" ]; then
      # Parent #900 adds the fork-only declaration the target will depend on.
      printf 'pub fn base_fn() -> u8 {\n    1\n}\n\npub fn fork_helper() -> u8 {\n    2\n}\n' > "$_fx_dir/src/dep.rs"
      git -C "$_fx_dir" add -A
      git -C "$_fx_dir" commit -q -m "parent adds fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"
    fi

    # Target #901: the enclosing symbol `base_fn` is upstream-present with an
    # IDENTICAL signature; only the hunk's BODY differs, and it references the
    # (fork-only, resp. upstream) helper.
    if [ "$_fx_mode" = "fork_only_dep" ]; then
      printf 'pub fn base_fn() -> u8 {\n    fork_helper()\n}\n\npub fn fork_helper() -> u8 {\n    2\n}\n' > "$_fx_dir/src/dep.rs"
    elif [ "$_fx_mode" = "fork_only_dep_doc" ]; then
      # #764: `fork_helper` appears ONLY in prose -- inner `//!` doc, an outer
      # `///` doc, and a string literal. None of these is a code reference, so
      # this port DOES resolve and must stay ELIGIBLE.
      printf '//! [`fork_helper`] is the fork-only dependency this port must resolve.\n/// See `fork_helper()` -- and "fork_helper" appears in this literal.\npub fn base_fn() -> u8 {\n    7\n}\n\npub fn fork_helper() -> u8 {\n    2\n}\n' > "$_fx_dir/src/dep.rs"
    else
      printf 'pub fn base_fn() -> u8 {\n    shared_helper()\n}\n\npub fn shared_helper() -> u8 {\n    2\n}\n' > "$_fx_dir/src/dep.rs"
    fi
    git -C "$_fx_dir" add -A
    git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#901"
    git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
    return 0
  fi

  printf 'pub fn orphan_fn() -> u8 {\n    2\n}\n' > "$_fx_dir/src/orphan.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "add fork-only helper" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

  if [ "$_fx_mode" = "harvested" ]; then
    # Parent work lands in an upstream-present symbol -> parent HARVESTED.
    printf 'pub fn base_fn() -> u8 {\n    3\n}\n' > "$_fx_dir/src/base.rs"
  else
    # Parent work lands only in the fork-only symbol -> parent UNHARVESTED.
    printf 'pub fn orphan_fn() -> u8 {\n    4\n}\n' > "$_fx_dir/src/orphan.rs"
  fi
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "parent work" --trailer "Issue-Ref: leshchenko1979/opencrabs#900"

  # Target's own fix: one upstream-present symbol (so class 3 passes) plus a
  # modification to the orphan path (so gate 4's file loop reaches class 2).
  printf 'pub fn base_fn() -> u8 {\n    5\n}\n' > "$_fx_dir/src/base.rs"
  printf 'pub fn orphan_fn() -> u8 {\n    6\n}\n' > "$_fx_dir/src/orphan.rs"
  git -C "$_fx_dir" add -A
  git -C "$_fx_dir" commit -q -m "target fix" --trailer "Issue-Ref: leshchenko1979/opencrabs#901"

  git -C "$_fx_dir" update-ref refs/remotes/origin/main "$(git -C "$_fx_dir" rev-parse HEAD)"
}

# --- #761 step 3 walk fixture -------------------------------------------------
# The walk's premise (a) reads DECLARATIONS off real diffs, so a mock-only
# fixture would test nothing -- this builds a real repo whose upstream ref and
# fork range exercise all three premises end to end.
#
# Shape (five rows, one per premise class):
#   A  base                      src/base.rs -> upstream copy
#                                src/rl.rs   -> `struct RateLimiterConfig`, so a
#                                fork row can add an `impl` for a type upstream
#                                ALREADY CARRIES (#6)
#   B1 fork #981                 src/ok.rs     :: ok_fn     (upstream LACKS it)
#   B2 fork #982                 src/stale.rs  :: stale_fn  (upstream WILL carry it)
#   B3 fork #983                 src/nb.rs     :: nb_fn     (upstream LACKS it)
#   branch feat/walk-ok          -> premise (b) checkable for the `walk-ok` row
#   B4 fork #984                 src/gone.rs   :: gone_fn   (upstream LACKS it)
#   (no branch feat/never-existed) -> the `walk-branchgone` row's premise (b)
#                                MOVES: a recorded branch the fork no longer has
#   B5 fork #985                 src/rl.rs     :: `impl RateLimiterConfig` whose
#                                target name EQUALS the upstream struct's (#6).
#                                The impl declares no symbol of its own; its
#                                member `spacing_floor` is the fork-only surface.
#                                A derivation that reads the impl line as an added
#                                declaration matches the struct BY NAME, compares
#                                two equal normalised headers, and reads premise
#                                (a) as a false CHANGED.
#   branch feat/walk-impl        -> premise (b) checkable for the `walk-impl` row
#   A2 upstream (post-sync)      src/stale.rs carrying stale_fn with the SAME
#                                normalised header -> the SYNC event that makes
#                                the `walk-stale` row's premise (a) MOVE.
# `$1` = repo dir. Echoes nothing; leaves refs/remotes/{adolfousier,origin}/main
# and branches feat/walk-ok / feat/walk-impl in place, and prints the five fork
# shas on stdout as `B1 B2 B3 B4 B5` for the caller to build a registry whose
# reason cites them.
build_walk_fixture() {
  _wd="$1"
  mkdir -p "$_wd/src"
  git -C "$_wd" init -q
  git -C "$_wd" config user.name fixture
  git -C "$_wd" config user.email fixture@example.invalid
  git -C "$_wd" config commit.gpgsign false

  printf 'pub fn base_fn() -> u8 {\n    1\n}\n' > "$_wd/src/base.rs"
  # #6: a TYPE upstream already carries, so a later fork row can add an `impl`
  # for a name that already exists upstream under a DIFFERENT declaration kind.
  printf 'pub struct RateLimiterConfig {\n    pub cap: u8,\n}\n' > "$_wd/src/rl.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "base"
  _wA="$(git -C "$_wd" rev-parse HEAD)"
  git -C "$_wd" update-ref refs/remotes/adolfousier/main "$_wA"

  printf 'pub fn ok_fn() -> u8 {\n    2\n}\n' > "$_wd/src/ok.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "walk ok" --trailer "Issue-Ref: leshchenko1979/opencrabs#981"
  _wB1="$(git -C "$_wd" rev-parse HEAD)"

  printf 'pub fn stale_fn() -> u8 {\n    3\n}\n' > "$_wd/src/stale.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "walk stale" --trailer "Issue-Ref: leshchenko1979/opencrabs#982"
  _wB2="$(git -C "$_wd" rev-parse HEAD)"

  printf 'pub fn nb_fn() -> u8 {\n    4\n}\n' > "$_wd/src/nb.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "walk nobranch" --trailer "Issue-Ref: leshchenko1979/opencrabs#983"
  _wB3="$(git -C "$_wd" rev-parse HEAD)"

  printf 'pub fn gone_fn() -> u8 {\n    5\n}\n' > "$_wd/src/gone.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "walk branchgone" --trailer "Issue-Ref: leshchenko1979/opencrabs#984"
  _wB4="$(git -C "$_wd" rev-parse HEAD)"

  # B5 (#6): the fork adds an `impl` for a type UPSTREAM ALREADY CARRIES as a
  # struct. The impl's members are the fork-only surface; its TARGET NAME is not
  # an added declaration at all. Reading the impl line as one scores
  # `RateLimiterConfig` against the upstream struct, the normalised headers
  # compare equal, and premise (a) reads a false CHANGED.
  printf 'impl RateLimiterConfig {\n    pub fn spacing_floor() -> u8 {\n        9\n    }\n}\n' >> "$_wd/src/rl.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "walk impl" --trailer "Issue-Ref: leshchenko1979/opencrabs#985"
  _wB5="$(git -C "$_wd" rev-parse HEAD)"

  git -C "$_wd" update-ref refs/remotes/origin/main "$_wB5"
  git -C "$_wd" branch feat/walk-ok "$_wB1"
  git -C "$_wd" branch feat/walk-impl "$_wB5"

  # A2: the sync event -- upstream NOW carries stale_fn under the SAME
  # normalised declaration header, so the walk's declaration-level test reads it
  # as ARRIVED (a by-name match alone could not tell this from a divergence).
  git -C "$_wd" checkout -q -b upstream-sim "$_wA"
  printf 'pub fn stale_fn() -> u8 {\n    3\n}\n' > "$_wd/src/stale.rs"
  git -C "$_wd" add -A
  git -C "$_wd" commit -q -m "upstream gains stale_fn"
  _wA2="$(git -C "$_wd" rev-parse HEAD)"
  git -C "$_wd" checkout -q -
  git -C "$_wd" update-ref refs/remotes/adolfousier/main "$_wA2"

  printf '%s %s %s %s %s\n' "$_wB1" "$_wB2" "$_wB3" "$_wB4" "$_wB5"
}

cmd_selftest() {
  selftest_tmp="$(mktemp -d)"
  trap cleanup_selftest EXIT
  # Computed, never hand-maintained: the suite returns 1 on the first failure,
  # so the number of passes at the end IS the total. A literal here drifted
  # twice (16 tests reported as 15/15, then 21 as 20/20).
  ok_n=0
  ok() { ok_n=$((ok_n + 1)); printf '  ok   - %s\n' "$1"; }

  local mock_prs="$selftest_tmp/mock_prs.json"
  local mock_commits="$selftest_tmp/mock_commits.json"
  local mock_reg="$selftest_tmp/mock_reg.json"
  # Sandbox registry for the record/check cases. cmd_record writes only when the
  # target file EXISTS (it is guarded by `[ -f "$REGISTRY_FILE" ]`), so without
  # this the record case silently no-ops.
  printf '{"manual_records": []}\n' > "$mock_reg"
