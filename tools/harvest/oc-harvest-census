  # the destruction ("purge removes matching manual_records row" -> "purged row
  # no longer refuses the target"), i.e. the selftest certified the exact path the
  # law forbids. It now asserts BOTH halves of the refusal: the non-zero rc AND
  # that the row survives.
  rc=0
  out="$(bash "$0" purge --unit "test-unit" --state-file "$mock_reg" 2>&1)" || rc=$?
  if [ "$rc" -eq 2 ] && oc_has "$out" "REFUSED"; then
    ok "purge refuses (rc=2) instead of deleting (#707)"
  else
    echo "  bad  - purge expected rc=2 REFUSED, got rc=$rc ($out)"
    return 1
  fi
  if grep -q '"test-unit"' "$mock_reg"; then
    ok "purge left the manual_records row intact (control: the refusal is not vacuous)"
  else
    echo "  bad  - purge removed the row despite refusing"
    return 1
  fi
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "test-unit" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    ok "the manual-records gate STILL refuses after a purge attempt (inverted from the pre-#707 leg)"
  else
