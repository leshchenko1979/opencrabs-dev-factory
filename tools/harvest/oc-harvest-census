            # as a fresh commit with age 0.0h -- that asserted a false age and
            # carried no schedule (#415's triple). Shared predicate, one home
            # in tools/lib/oc_claims.py, so this tool and oc-harvest-dispatch
            # (the #563 fix) cannot drift.
            _state, _age, _fields = oc_claims.classify_soak_anchor(
                c_sha, mc.get('commit_ts', 0),
                lambda sha, ts: get_commit_deploy_ts(sha, repo_path, swaps, mc.get('deployed_ts')),
                swaps, now_ts)
            if _state == 'unresolved':
                refuse('REFUSED: Target %s is within the 24h feature soak window [SOAK_ANCHOR_UNRESOLVED] (commit %s: %s) %s; %s' % (target, mc.get('short_sha', '')[:7], subj[:50], _fields, oc_claims.soak_unresolved_note(mc.get('commit_ts', 0), now_ts)))
                break
            if _state == 'fresh':
                refuse('REFUSED: Target %s is within 24h feature soak window (age: %.1fh < 24h, commit %s: %s) %s' % (target, _age, mc.get('short_sha', '')[:7], subj[:50], _fields))
                break

    # 2. SUBSYSTEM COHESION & DEPENDENT SOAK CHECK (HELD_DEPENDENT_SOAK)
    # Check if target touches files of an unharvested feat/* currently in soak window
    target_files = set(get_affected_files_for_commits(matching_commits, repo_path))
    if target_files:
        for oc in other_commits:
            oc_subj = oc.get('subject', '')
            oc_sha = oc.get('sha', '')
            if oc_subj.startswith('feat'):
                # Check if this other feat is in soak window
                # #413: same three-state predicate as site 1 (shared home).
                _ostate, _oage, _ofields = oc_claims.classify_soak_anchor(
                    oc_sha, oc.get('commit_ts', 0),
                    lambda sha, ts: get_commit_deploy_ts(sha, repo_path, swaps, oc.get('deployed_ts')),
                    swaps, now_ts)
                if _ostate != 'soaked':
                    # Check file overlap
                    oc_files = set(get_affected_files_for_commits([oc], repo_path))
                    overlap = target_files.intersection(oc_files)
                    substantive_overlap = filter_substantive_overlap(overlap)
                    if substantive_overlap:
                        overlap_sample = ', '.join(sorted(list(substantive_overlap))[:3])
                        if _ostate == 'unresolved':
                            refuse('REFUSED: Target %s touches files of soaking feature %s [HELD_DEPENDENT_SOAK: %s] [DEPENDENT_SOAK_ANCHOR_UNRESOLVED] %s; %s' % (target, oc.get('short_sha', '')[:7], overlap_sample, _ofields, oc_claims.soak_unresolved_note(oc.get('commit_ts', 0), now_ts)))
                        else:
                            refuse('REFUSED: Target %s touches files of soaking feature %s (age: %.1fh < 24h) [HELD_DEPENDENT_SOAK: %s] %s' % (target, oc.get('short_sha', '')[:7], _oage, overlap_sample, _ofields))
                        # Keep evaluating every overlapping feature; refuse() aggregates
                        # this leg and the caller retains rc=1.


    # 3. IN-FLIGHT LANE FENCING (HELD_IN_FLIGHT_LANE) -- REMOVED.
    #
    # Owner ruling 2026-10-02 (open question q51 -> option B). The q46 ruling
    # that dropped the DISPATCH fence named that enforcement point only; q51
    # put the census point in front of the owner and he extended the ruling to
    # it. The fence held a unit while an active editor lane worked the
    # subsystem, releasing only on COMPLETION, and the busy set it read was
    # EVERY still-OPEN claim (tools/lib/oc_claims.py) -- so a quiet or dead
    # lane's unclosed claim held a harvest INDEFINITELY. That is the defect q46
    # was raised on.
    #
    # Disclosed residual -- the portability predicate and this fence guard
    # DIFFERENT AXES: the predicate asks whether upstream carries the surface
    # this repairs; the fence asked whether a lane is still moving this
    # subsystem. A harvest may now run against a subsystem an active lane is
    # still changing. The owner accepted that trade; his answer named the
    # portability predicate as the replacement. Re-introduction requires a
    # FRESH owner ruling, never a lane's judgment. Canon: harvest.md Phase 7c;
    # upstream-merge-runbook.md, Upstream-merge cadence, HARVEST LAW, NO-HOLD.
    #
    # CAPABILITIES THAT DIE WITH THIS GATE -- named, not silently dropped:
    #   - holder liveness / dormancy disclosure (#534): holder_age + DORMANT
    #   - phantom-holder skip (#404 / #653): a claim author the session DB has
    #     never seen was skipped with a remedy note instead of fencing forever
    #   - blocker re-validation advisory (leg v, #536): the fencing claim's own
    #     recorded blocker was re-read and printed beside the fence
    #   - fence row dedup (#459 / #653): the fence unit was (lane, issue), not
    #     the ledger ROW, so one lane fenced once per issue, not once per row
    # Each is a property OF the fence. None has a surviving vehicle, so each
    # went with it rather than being re-vehicled onto a leg it does not fit.
    #
    # NOT retired with this gate: the SHARED resolver get_active_claims /
    # resolve_issue_commits in tools/lib/oc_claims.py, which stays LIVE for
    # oc-ledger, oc-health, oc-roster and oc-issue-dispatch; and
    # filter_substantive_overlap, which serves the sibling soak gate (2),
    # cycle_note and cluster_links. The #307 anchored-footprint fix and its
    # mutation guard stay LIVE.
    #
    # cycle_note (leg iv, below) SURVIVES. It is a DIFFERENT guard -- a MUTUAL
    # cycle between the target's OWN claim and a foreign claim, with a
    # deterministic precedence rule -- and this ruling did not name it.
    #
    # The ledger is still read here because cycle_note consumes it.
    ledger_path = mock_ledger or os.path.join(st_dir, 'workers-ledger.json')
    active_claims = oc_claims.get_active_claims(ledger_path, repo_path)

    for cycle in cycle_note(active_claims, target_iss):
        refuse(cycle)

    # 4. UPSTREAM SUBJECT EXISTENCE & FORK PROVENANCE
    #
    # The operative question is whether the fix's SUBJECT exists upstream, not
    # whether every touched FILE does (#365; HQ ruling 2026-09-18, v0.4.201,
    # triage.md "Closure predicate for fork-only base-fault fixes"). The old
    # file test refused any unit touching a path absent from adolfousier/main,
    # which hard-stopped #341 — a standalone fix whose one absent file is a test
    # it merely extends — and could never be cleared, because the provenance
    # lookup reads the path's ADD commit and the fork-main synthesis commit
    # carries no issue reference.
    #
    # The FILE test survives only as the provenance lookup that separates a
    # genuine fork-only child (HELD_PARENT_UNHARVESTED) from an orphan path
    # (ADVISORY, non-blocking). Fail-closed: nothing loosens unless the subject
    # is positively established from the fix's own diff.
    if matching_commits and repo_path and os.path.isdir(repo_path) and ref_exists('adolfousier/main', repo_path) and commits_present(matching_commits, repo_path):
        base_ref = 'adolfousier/main'
        subject_pairs, subject_stats = derive_symbols(matching_commits, repo_path)
        present_pairs, absent_pairs = subject_present_upstream(subject_pairs, repo_path, base_ref)
        present_syms = sorted({s for _, s in present_pairs if s})
        absent_syms = sorted({s for _, s in absent_pairs if s})

        if not present_syms:
            # No subject symbol resolves upstream. Two DIFFERENT cases:
            #
            #   (a) symbols WERE derived and every one is absent upstream -- the
            #       fix's substance is fork-only. Positive evidence: refuse, and
            #       do NOT consult the declared-subject fallback.
            #   (b) NOTHING was derivable -- the derivation is inconclusive, not a
            #       verdict, so a DECLARED subject may resolve the unit:
            #       --subject, else a `Subject:` trailer on the fix's own
            #       commits. It must still grep present upstream.
            #
            # (b) is tested by absent_syms, NOT by subject_pairs: derive_symbols
            # appends a pair for every hunk even when the symbol resolved to
            # None, so subject_pairs is non-empty in precisely the case this
            # branch exists for. Nothing partitioned (both lists empty) IS
            # "nothing derivable".
            #
            # Fail-closed either way: an absent or unverifiable declaration
            # refuses exactly as it did before the fallback existed.
            tested = ', '.join(absent_syms[:6]) or 'none derived'
            derivation_empty = not absent_syms
            declared = ''
            resolved = False
            if derivation_empty:
                declared = declared_subject or declared_subject_from_commits(matching_commits, repo_path)
                resolved = bool(declared) and declared_subject_present(declared, repo_path, base_ref)
            if resolved:
                print('ADVISORY: no symbol derivable from the fix diff; DECLARED subject %r is present in %s' % (declared, base_ref))
            else:
                why = ''
                if derivation_empty:
                    why = '; no declared subject' if not declared else ('; declared subject %r not present in %s' % (declared, base_ref))
                refuse('REFUSED: Target %s has no subject symbol present in %s [UPSTREAM_VOID: tested %s%s]' % (target, base_ref, tested, why))

        # Per-hunk packaging advisory: a hunk whose symbol does not resolve
        # upstream has no target there and is dropped at packaging — an
        # informational outcome, never a gate failure.
        for f_path, sym in sorted(set(absent_pairs)):
            print('ADVISORY: hunk inside fork-only symbol — dropped at packaging (%s :: %s)' % (f_path, sym))

        # #758: NAME presence is not DEFINITION presence. The advisory above
        # fires only for symbols ABSENT upstream by name, so a hunk inside a
        # symbol upstream DOES carry -- under a diverged definition -- is never
        # flagged at all, and the unit reads ELIGIBLE while the port cannot
        # resolve (#757: `pace_rich` upstream `(chat, thread_id)`, fork
        # `(chat, thread_id, class) -> RichAdmission`; `git apply --check`
        # against the upstream tip failed on BOTH files). Disclose the
        # divergence as a NOTE: a signature change is NOT necessarily a port
        # blocker -- a fix can legitimately apply to a diverged-but-compatible
        # symbol -- so this must never refuse.
        diverged_cache = {}
        for f_path, sym in sorted(set(present_pairs)):
            diverged = symbol_header_diverged(f_path, sym, repo_path, base_ref, diverged_cache)
            if diverged:
                fork_hdr, upstream_hdr = diverged
                _at, _head, _ft, _ut = _divergence_pair(fork_hdr, upstream_hdr)
                print('NOTE(HUNK_SYMBOL_DIVERGED): %s :: %s resolves in %s by NAME but its definition has DIVERGED -- shared prefix %r (%d chars); fork continues %r vs upstream %r; the hunk may not apply, verify before packaging' % (f_path, sym, base_ref, _head, _at, _ft, _ut))

        # #761 step 2b (#758): the DECLARATION-LEVEL dependency test.
        #
        # The two legs above ask about the hunk's enclosing SYMBOL -- is it
        # present by name, has its definition diverged -- and neither catches a
        # hunk whose enclosing symbol is upstream-present AND identically signed
        # while its BODY depends on a declaration upstream does not carry. That
        # is #757 exactly: `pace_rich` exists upstream under a compatible
        # signature, while the hunk's body reaches `spacing_floor_ms` /
        # `spacing_wait` / `spacing_ok` / `RichAdmission`, all introduced by the
        # landed-but-unharvested #676 and carrying 0 occurrences upstream. The
        # unit read ELIGIBLE while `git apply --check` of its patch against the
        # upstream tip failed on BOTH files.
        #
        # This REFUSES, and it refuses on the DEPENDENCY -- not on the signature
        # divergence the NOTE above discloses. #758's own landed half stands
        # untouched: a diverged-but-compatible symbol is not a port blocker and
        # must never refuse; a dependency on declarations upstream does not
        # carry IS one, because the lane would branch, port, and eat a RED
        # build. Refusal is the fail-closed direction -- holding a harvest costs
        # nothing.
        #
        # Fail-closed in the other direction too: an empty derivation ({}) raises
        # nothing. Absence of evidence is not evidence, and this leg refuses only
        # on a positively-identified fork-only declaration.
        dep_refs = fork_only_surface_references(matching_commits, repo_path, base_ref)
        if dep_refs:
            _dep_shown = '; '.join('%s :: %s' % (f, ', '.join(ns[:4])) for f, ns in sorted(dep_refs.items()))
            refuse('REFUSED: Target %s depends on declarations absent from %s [FORK_ONLY_SURFACE: %s]' % (target, base_ref, _dep_shown))

        file_actions = get_affected_file_actions_for_commits(matching_commits, repo_path)
        for f_path, actions in file_actions.items():
            if any(a in ('D', 'M') for a in actions):
                exists_upstream = check_upstream_file_existence(f_path, base_ref, repo_path)
                if not exists_upstream:
                    intro_sha, intro_iss, intro_subj = check_fork_path_provenance(f_path, repo_path)
                    if intro_iss and target_iss is not None and intro_iss != target_iss:
                        # Class-2 SUB-RULE (#365): the refusal needs the
                        # introducing issue to be STILL unharvested. A path left
                        # behind by an already-harvested parent is not a held
                        # child — it falls through to the class-3 subject test
                        # (which already passed for this unit, or we would not
                        # be here) and reports as an advisory instead.
                        parent_harvested = issue_subject_upstream(intro_iss, repo_path, base_ref)
                        if parent_harvested is not True:
                            refuse('REFUSED: Target %s path %s was introduced by unharvested fork issue #%s (%s) and does not exist in %s [HELD_PARENT_UNHARVESTED]' % (target, f_path, intro_iss, intro_sha[:8] if intro_sha else '?', base_ref))
                            continue
                        print('ADVISORY: orphan path %s (absent upstream) — parent #%s already harvested; port decision required' % (f_path, intro_iss))
                        continue
                    print('ADVISORY: orphan path %s (absent upstream) — port decision required' % f_path)

    # 5. CLUSTER-SET READINESS (#607) -- HELD_SET / HELD_SET_SOAK
    #
    # The owner's rule (2026-09-26, verbatim): "the set must be decided in its
    # entirety -- either ready to harvest or not", where ready means every
    # member is swapped+smoked+CLOSED and the NEWEST member's swap is >24h old.
    #
    # Before this leg the rule was a VIEW: `held` was computed only in the
    # `clusters` arm, so a lane could harvest a cluster the tool itself flagged
    # held=true and nothing refused it. The per-unit legs (soak, in-flight lane,
    # unharvested parent) are each about ONE unit and none of them reads a
    # cluster's membership.
    #
    # The set is the issue UNION its DIRECT gh relatives (parent, sub-issues,
    # blockedBy, blocking) -- the "relationship graph" the runbook already names.
    # It is NOT a transitive closure: closure over either graph collapses the
    # delta into 3 mega-components (159+1+1), which is a set former that freezes
    # everything and admits nothing.
    #
    # rc is unchanged: a refusal here collects like every other leg and the
    # shared block below still exits 1.
    if target_iss is not None:
        _set_members, _rel_ok = cluster_set(
            target_iss, 'leshchenko1979/opencrabs',
            os.environ.get('OC_HARVEST_MOCK_RELATIONS'))
        if not _rel_ok:
            # Absence of evidence is not a free set: an unreadable graph means
            # the leg DID NOT RUN, and saying so is the only honest output.
            print('NOTE(HELD_SET): the gh relationship graph for #%d is UNREADABLE '
                  '-- the set could not be enumerated, so this leg did NOT run. '
                  'A set verdict is NOT claimed.' % target_iss)
        else:
            _by_iss = build_commits_by_issue(commits)
            _unready, _unreadable, _harvest_notes = [], [], []
            for _m in sorted(_set_members):
                if _m == target_iss:
                    # HQ ruling 2026-09-26 (n=11674): THE TARGET IS EXCLUDED FROM
                    # ITS OWN READINESS SET. It is the unit being harvested and the
                    # per-unit legs above gate it; a set verdict is about the SET.
                    continue
                _st = get_issue_live_state(_m, mock_file=mock_issue_state)
                if _st is None:
                    _unreadable.append(_m)
                    continue
                _rdy, _why = member_ready(_m, _by_iss, repo_path, swaps, st_dir)
                if not _rdy:
                    _unready.append((_m, (_st.get('state') or '?').lower(), _why))
                elif _why and 'harvested:' in _why:
                    # #654: DISCLOSE, never a bare verdict. This member's
                    # smoke leg was satisfied by its HARVEST, not by a fork
                    # smoke row -- and a ready member prints no `_why`
                    # anywhere else, so without this line the disclosure
                    # would be unreachable dead code.
                    _harvest_notes.append('#%d (%s)' % (_m, _why))
            if _unready:
                _detail = ', '.join('#%d(%s, %s)' % (m, st, why) for m, st, why in _unready)
                refuse('REFUSED: Target %s cluster set {%s} has %d UNREADY member(s) '
                       '[HELD_SET: %s] -- a member is ready when it is swapped+smoked; '
                       'CLOSED is NOT required because closure is this harvest\'s '
                       'OUTPUT, so requiring it made the set unharvestable by '
                       'construction' % (
                           target, ', '.join('#%d' % m for m in sorted(_set_members)),
                           len(_unready), _detail))
            if _unreadable:
                print('NOTE(HELD_SET): %d set member(s) could not be read (%s) -- the '
                      'set verdict above is INCOMPLETE, never a clean one.'
                      % (len(_unreadable), ', '.join('#%d' % m for m in _unreadable)))
            if _harvest_notes:
                print('NOTE(HELD_SET): %d member(s) are ready VIA THEIR HARVEST, not '
                      'via a fork smoke row: %s. The harvest is the acceptance '
                      'evidence for such a member (#654).'
                      % (len(_harvest_notes), ', '.join(_harvest_notes)))
            # The clock walks the SET, not the target: the target's own 24h
            # soak is leg 1 above, and including it here would make a fresh
            # target block the very set it is the subject of. A RELATIVE
            # deployed 2h ago still resets the clock -- that is the owner's
            # stated intent ("a fix deployed 2h ago resets its parent's clock").
            _set_for_clock = [m for m in _set_members if m != target_iss]
            _anchor, _age, _scanned, _anchor_sha = set_soak_clock(
                _set_for_clock, _by_iss, repo_path, swaps, now_ts, state_dir=st_dir)
            if _age is None:
                # #634: an EMPTY set and an UNRESOLVABLE one are DIFFERENT states
                # and must not share one output. With no members besides the
                # target, nothing CAN reset the clock -- the leg is vacuously
                # clear -- yet the hold-flavoured wording made a clean unit read
                # as held (measured: #348/#155/#459/#526 all ELIGIBLE rc=0 with
                # every gh relationship empty). Still disclosed, never silent
                # (#563 discipline), but no longer a hold.
                if not _set_for_clock:
                    print('NOTE(HELD_SET_SOAK): the set has no members besides the '
                          'target -- nothing can reset the set clock. VACUOUSLY '
                          'CLEAR, not a hold; the target soak is leg 1 above.')
                else:
                    print('NOTE(HELD_SET_SOAK): set soak clock UNRESOLVABLE -- no member '
                          'commit of the set carries a deploy anchor (%d commit(s) '
                          'scanned), so the 24h window cannot be shown to have started. '
                          'This is NOT "fresh" and NOT clearance.' % _scanned)
            elif _age < oc_claims.SOAK_HOURS:
                refuse('REFUSED: Target %s cluster set {%s} youngest member swap is '
                       '%.1fh old (< 24h) [HELD_SET_SOAK: anchor %s] -- a member '
                       'deployed recently resets the whole set\'s clock' % (
                           target, ', '.join('#%d' % m for m in sorted(_set_members)),
                           max(0.0, _age), oc_claims.soak_anchor_fields(_anchor_sha, _anchor)))
            else:
                print('NOTE(HELD_SET_SOAK): set soak clock clear -- youngest member '
                      'swap is %.1fh old (>= 24h).' % _age)
    else:
        print('NOTE(HELD_SET): the target is not an issue (sha/slug), so no cluster '
              'set exists to evaluate -- this leg did NOT run.')

    # #630: BASE-RED -- read the CONTEXT the unit is cut from, not only the unit.
    # Every leg above reads the UNIT; none reads the base tip's lint state, so a
    # unit could be certified "clean to branch and gate" while the base under it
    # fails the gate on content the unit does not touch. Measured by Triage
    # 2026-09-27 on #458/#513: upstream #1726 added a macOS-only symbol whose
    # dead-code lint is a hard error under the Linux fork gate, so two lanes were
    # told "clean to branch and gate" and two ~30 min gates were avoided BY HAND.
    # `oc-pr-fault-scope` already decides that case (BASE-FAULT); #630 gives the
    # decision a store and this leg answers from it.
    #
    # EXACT sha match, never ancestor-or-equal: a marker recorded for a base the
    # fork has since advanced past says nothing about the CURRENT base, and
    # refusing on it would block a clean unit (acceptance criterion 4). An
    # advanced base is therefore a MISS -- deliberately fail-open, because the
    # cost of a miss is a re-run while the cost of a false refusal is a blocked,
    # clean harvest. Placed ABOVE the `if refusals:` block below, which is the
    # ONLY exit that enforces a collected refusal (#493).
    # ONE resolver (tools/lib/oc_base_red.resolve_base). A private copy of this
    # ladder here would be the drift defect the store exists to keep out: if the
    # two ends disagree on WHICH sha a unit is cut from, the reader silently
    # never matches the writer.
    _cr_base = oc_base_red.resolve_base(
        repo_path, (base_pin or '').strip() or os.environ.get('OC_CENSUS_BASE', '').strip())
    _cr_rec = oc_base_red.lookup(st_dir, _cr_base) if _cr_base else None
    if _cr_rec:
        refuse('REFUSED: Target %s is cut from base %s, which carries a BASE-RED marker '
               '[HELD_BASE_RED: %s] -- the gate fails there on content OUTSIDE this '
               "unit's own diff, so branching and gating it would spend a gate run on "
               'a base fault. Wait for the base to advance (or for the base fault to '
               'be fixed) and re-check.' % (target, _cr_base[:12], oc_base_red.describe(_cr_rec)))
    elif not _cr_base:
        # Disclosed, never silent (#563 discipline): a leg that did NOT run must
        # say so, or a reader cannot tell a clean base from an unread one.
        print('NOTE(HELD_BASE_RED): cut-base UNRESOLVED (no --base pin, and no '
              'origin/main or main in %s), so the base lint state was NOT read.'
              % (repo_path or 'the repo path'))
    else:
        print('NOTE(HELD_BASE_RED): cut-base %s carries no BASE-RED marker.' % _cr_base[:12])

    # 6. DECLARED BLOCKER NOT UPSTREAM (#675) -- HELD_DEPENDENCY_NOT_UPSTREAM
    #
    # HELD_SET above asks the WRONG QUESTION of a relative: member_ready tests
    # swapped+smoked, i.e. "has it LANDED on fork origin/main?". It never asks
    # whether the relative's SUBSTANCE exists UPSTREAM. A relative that landed
    # fork-only therefore reads READY, HELD_SET passes, and ELIGIBLE is a false
    # green on PORTABILITY -- measured live: #458 reads ELIGIBLE while its
    # dependency #226 introduced DEFAULT_MAX_INLINE_TOOL_BYTES and
    # resolve_skill_path, neither of which exists on adolfousier/main, so the
    # port went RED on clippy (run 36401057836); #513 needs #295 and #645 needs
    # #487, the same shape.
    #
    # ELIGIBLE is an UNHARVESTED claim, never a portability claim. This leg
    # narrows the gap for the ONE edge that decides portability without a build
    # -- a DECLARED blocker. The universal case ("does this fix compile
    # upstream") stays the CI gate's job, because the census must not build.
    #
    # The upstream ref is named literally: `base_ref` is bound ONLY inside the
    # gate-4 block above, so reaching for it here would be the NameError this
    # file has already been bitten by (see the `clusters --clock` note).
    _dep_branch = 'adolfousier/main'
    if target_iss is not None:
        _blockers = get_blocked_by(target_iss, 'leshchenko1979/opencrabs',
                                   os.environ.get('OC_HARVEST_MOCK_RELATIONS'))
        _up_mock = os.environ.get('OC_HARVEST_MOCK_UPSTREAM_ISSUES')
        _up_set = None
        if _up_mock is not None:
            try:
                _up_set = {int(x) for x in json.loads(_up_mock)}
            except Exception:
                _up_set = None
        if _blockers is None:
            print('NOTE(HELD_DEPENDENCY_NOT_UPSTREAM): the declared-blocker graph for '
                  '#%d is UNREADABLE -- this leg did NOT run, and no portability '
                  'verdict is claimed beyond the UNHARVESTED one.' % target_iss)
        elif _up_set is None and not ref_exists(_dep_branch, repo_path):
            # Fail-open, disclosed: without the upstream ref the leg cannot
            # decide, and an undecidable leg must never refuse (the cost of a
            # false refusal is a blocked clean harvest).
            print('NOTE(HELD_DEPENDENCY_NOT_UPSTREAM): upstream ref %s is ABSENT from '
                  '%s, so each declared blocker\'s upstream presence could NOT be '
                  'read -- this leg did NOT run.' % (_dep_branch, repo_path or 'the repo path'))
        elif _blockers:
            _by_iss_dep = build_commits_by_issue(commits)
            _dep_unup, _dep_unreadable = [], []
            for _b in _blockers:
                _bst = get_issue_live_state(_b, mock_file=mock_issue_state)
                if _bst is None:
                    _dep_unreadable.append(_b)
                    continue
                _brdy, _bwhy = member_ready(_b, _by_iss_dep, repo_path, swaps, st_dir)
                if not _brdy:
                    # Not landed at all -- HELD_SET and the per-unit legs own that.
                    continue
                if _up_set is not None:
                    _b_up = _b in _up_set
                else:
                    _bcs, _ = member_commits(_b, _by_iss_dep, repo_path)
                    _b_up = any(check_ancestor(c.get('sha', ''), _dep_branch, repo_path)
                                for c in _bcs if c.get('sha')) if _bcs else False
                if not _b_up:
                    _dep_unup.append(_b)
            if _dep_unup:
                refuse('REFUSED: Target %s declares blocker(s) %s that have LANDED '
                       'fork-only and are NOT present in %s [HELD_DEPENDENCY_NOT_UPSTREAM] '
                       '-- the unit is UNHARVESTED but NOT PORTABLE: its fix depends on '
                       'substance upstream does not carry, so the port cannot resolve '
                       'there. This verdict is about PORTABILITY; the UNHARVESTED claim '
                       'is separate and unchanged.' % (
                           target, ', '.join('#%d' % b for b in _dep_unup), _dep_branch))
            if _dep_unreadable:
                print('NOTE(HELD_DEPENDENCY_NOT_UPSTREAM): %d declared blocker(s) could '
                      'not be read (%s) -- the verdict above is INCOMPLETE, never a '
                      'clean one.' % (len(_dep_unreadable),
                                      ', '.join('#%d' % b for b in _dep_unreadable)))


    # #493: EVERY leg has now been evaluated, so the full applying set is printed
    # above rather than the first one to fire. rc is unchanged (1 on any
    # refusal), and the ELIGIBLE arms below stay unreachable when a refusal
    # fired — which is the precedence the pre-#493 code got by exiting early.
    if refusals:
        if len(refusals) > 1:
            soak_legs = [r for r in refusals if 'soak' in r.lower()]
            print('NOTE: %d refusal legs apply (all listed above).' % len(refusals))
            if soak_legs:
                print('NOTE: eligible_at, where printed, binds the SOAK leg ONLY (anchor + 24h) — it is NOT total clearance. %d other leg(s) are also refusing and carry no eligible_at clock, so returning at that instant will be refused again.' % (len(refusals) - len(soak_legs)))
            else:
                print('NOTE: no soak leg applies, so no eligible_at is printed — none of the refusals above carries a clearance clock.')
        sys.exit(1)

    if closed_match:
        num = closed_match['pr']
        ti = closed_match['title']
        print(f'ELIGIBLE_REWORK: Target {target} had PR #{num} CLOSED without merge: {ti}')
        sys.exit(0)

    print(f'ELIGIBLE: Target {target} is confirmed UNHARVESTED (clean to branch and gate)')
    sys.exit(0)

elif action == 'clusters':
    # Trap (c): NEVER page silently. Every cluster is emitted; if a bound is
    # ever added it must print what it withheld. A `head -80` on this output is
    # how a tail group vanished from a published count with no warning.
    as_json = '--json' in sys.argv
    open_fix_only = '--open-fix' in sys.argv
    # The set soak clock walks git ancestry per member commit, so it is OPT-IN
    # and its absence is DISCLOSED rather than rendered as a clean set.
    clock_on = '--clock' in sys.argv
    # The same three names the `check` arm loads, with the SAME derivation.
    # They were MISSING from this arm entirely, so `clusters --clock` died with
    # `NameError: name 'swaps' is not defined` on every invocation -- and the
    # readiness leg below needs them unconditionally, not only under --clock.
    # No leg covered it: the #607 legs exercised `check` and the non-clock
    # `clusters` path, so the flag was broken from the day it shipped.
    now_ts = int(os.environ.get('OC_HARVEST_NOW_TS') or time.time())
    st_dir = os.path.dirname(registry_file) if registry_file else os.environ.get('STATE_DIR', '')
    swaps = load_swap_history(st_dir)

    commits = get_ahead_commits(repo_path, mock_commits)
    clusters, unclustered = cluster_ahead_commits(commits)
    issues = get_fork_issues(mock_file=os.environ.get('OC_HARVEST_MOCK_ISSUES'))
    if issues is None:
        sys.stderr.write('oc-harvest-census clusters: cannot read the fork issue list '
                         '(gh failed) -- refusing to classify against an empty map\n')
        sys.exit(3)

    files_by_cluster = {}
    for iss, entry in clusters.items():
        files_by_cluster[iss] = cluster_files(entry['commits'], repo_path)
    links = cluster_links(files_by_cluster)

    rows = []
    for iss, entry in sorted(clusters.items()):
        meta = issues.get(iss) or {}
        title = meta.get('title', '')
        state = meta.get('state', '')
        mixed = cluster_is_mixed(entry['commits'])
        rows.append({
            'cluster': iss,
            'title': title,
            'state': state,
            'fix_titled': bool(FIX_TITLE_RE.match(title or '')),
            'kind': 'MIXED' if mixed else 'PURE',
            'commits': len(entry['commits']),
            'files': len(files_by_cluster.get(iss, ())),
            'linked': links.get(iss, []),
            'shas': [c.get('short_sha', '') for c in entry['commits']],
        })

    # The gate's view (owner rule 2026-09-26): the set is the issue UNION its
    # DIRECT gh relatives, and the file leg stays 1-hop.
    #
    # CORRECTION to the report that prompted this: the old `- {r['cluster']}`
    # removed NOTHING -- `cluster_links` skips self, and 0 of 167 rows carried
    # the cluster in its own `linked`. The real gap was that `held` never
    # consulted the OWN issue's state, so an open own-issue with no open
    # file-linked sibling read as FREE (measured: #458, #513, #593).
    # BOTH legs key on READINESS (owner order 2026-09-26). Measured: fixing
    # only the gh leg leaves 56 of 58 held, because the FILE leg is the dominant
    # hold (55 of 58) -- so a one-leg change would have looked like a fix while
    # the deadlock stood.
    open_fix = {r['cluster'] for r in rows if r['state'] == 'open' and r['fix_titled']}
    _mock_rel = os.environ.get('OC_HARVEST_MOCK_RELATIONS')
    _by_iss = build_commits_by_issue(commits)
    for r in rows:
        r['linked_open_fix'] = sorted(set(r['linked']) & open_fix)
        r['linked_unready'] = sorted(
            m for m in r['linked_open_fix']
            if not member_ready(m, _by_iss, repo_path, swaps, st_dir)[0])
        r['own_open'] = (r['state'] == 'open')
        r['own_ready'] = member_ready(r['cluster'], _by_iss, repo_path, swaps, st_dir)[0]
        r['set_members'] = None
        r['set_open_relatives'] = []
        r['set_unreadable'] = False
        r['set_clock_age_h'] = None
        r['set_clock_state'] = 'not computed (--clock not passed)' if not clock_on else None
        r['held'] = bool(r['linked_unready'])

    # The gh leg of the union -- evaluated for the CANDIDATES only, so the cost
    # is bounded by the open fix-titled population rather than every cluster.
    # A relative whose state is not in the batched fork map is UNREADABLE, never
    # assumed open: on a hold predicate an unknown silently inflates the count.
    for r in rows:
        if r['cluster'] not in open_fix:
            continue
        _members, _ok = cluster_set(r['cluster'], 'leshchenko1979/opencrabs', _mock_rel)
        r['set_members'] = sorted(_members)
        if not _ok:
            r['set_unreadable'] = True
            continue
        _unreadyrel = []
        for _m in sorted(_members):
            if _m == r['cluster']:
                continue  # the target never gates its own set (HQ n=11674)
            _meta = issues.get(_m)
            if _meta is None:
                r['set_unreadable'] = True
                continue
            _rdy, _why = member_ready(_m, _by_iss, repo_path, swaps, st_dir)
            if not _rdy:
                _unreadyrel.append({'issue': _m, 'state': _meta.get('state') or '?',
                                    'why': _why})
        r['set_open_relatives'] = [d['issue'] for d in _unreadyrel]
        r['set_unready_relatives'] = _unreadyrel
        if _unreadyrel:
            r['held'] = True

    if clock_on:
        for r in rows:
            if r['set_members'] is None:
                r['set_clock_state'] = 'not evaluated (not an open fix-titled candidate)'
                continue
            _anchor, _age, _scanned, _asha = set_soak_clock(
                [m for m in r['set_members'] if m != r['cluster']],
                _by_iss, repo_path, swaps, now_ts, state_dir=st_dir)
            if _age is None:
                r['set_clock_state'] = ('UNRESOLVABLE (%d commit(s) scanned, no deploy '
                                        'anchor) -- not "fresh", not clearance' % _scanned)
            else:
                r['set_clock_age_h'] = round(_age, 1)
                r['set_clock_state'] = ('ready (youngest swap %.1fh >= 24h)' % _age
                                        if _age >= oc_claims.SOAK_HOURS
                                        else 'HELD_SET_SOAK (youngest swap %.1fh < 24h, anchor %s)'
                                             % (_age, _asha[:9]))

    summary = {
        'clusters': len(rows),
        'open_fix_titled': sum(1 for r in rows if r['state'] == 'open' and r['fix_titled']),
        'pure': sum(1 for r in rows if r['kind'] == 'PURE'),
        'mixed': sum(1 for r in rows if r['kind'] == 'MIXED'),
        'unclustered_commits': len(unclustered),
        'ahead_commits': len(commits),
        'issues_unresolved': sum(1 for r in rows if not r['title']),
        'held': sum(1 for r in rows if r['held']),
        # The number the GATE acts on: held among the open fix-titled candidates.
        'held_open_fix_titled': sum(1 for r in rows
                                    if r['held'] and r['state'] == 'open' and r['fix_titled']),
        'held_by_own_issue': sum(1 for r in rows if r['own_open'] and not r['linked_unready']),
        'own_ready': sum(1 for r in rows if r.get('own_ready')),
        'linked_unready_total': sum(1 for r in rows if r['linked_unready']),
        'held_by_gh_relative': sum(1 for r in rows if r['set_open_relatives']),
        'set_relations_unreadable': sum(1 for r in rows if r['set_unreadable']),
        'set_clock': ('computed' if clock_on else 'NOT computed (--clock not passed)'),
    }

    shown = [r for r in rows if r['state'] == 'open' and r['fix_titled']] if open_fix_only else rows

    if as_json:
        print(json.dumps({
            'summary': summary,
            'clusters': shown,
            'unclustered': [c.get('short_sha', '') for c in unclustered],
        }, indent=2))
    else:
        print('=== Issue Clusters ===')
        print('  ahead commits: %d   clusters: %d   unclustered commits: %d'
              % (summary['ahead_commits'], summary['clusters'], summary['unclustered_commits']))
        print('  open fix-titled: %d   PURE: %d   MIXED: %d   issue lookup missed: %d'
              % (summary['open_fix_titled'], summary['pure'], summary['mixed'],
                 summary['issues_unresolved']))
        print('  HELD: %d of %d open fix-titled  (file-linked unready: %d, unready gh relative: %d)   set clock: %s'
              % (summary['held_open_fix_titled'], summary['open_fix_titled'],
                 summary['linked_unready_total'],
                 summary['held_by_gh_relative'], summary['set_clock']))
        if open_fix_only:
            print('  (--open-fix: showing only open fix-titled clusters)')
        print('')
        for r in shown:
            mark = ' [open fix]' if (r['state'] == 'open' and r['fix_titled']) else ''
            print('CLUSTER #%-4d%s %s  commits=%d files=%d' % (
                r['cluster'], mark, r['kind'], r['commits'], r['files']))
            print('  %s' % (r['title'] or '(issue not resolvable on the fork)'))
            if r['held']:
                _why = []
                if r['own_open']:
                    _why.append('own issue OPEN')
                if r['linked_open_fix']:
                    _why.append('file-linked open fix: %s'
                                % ', '.join('#%d' % n for n in r['linked_open_fix']))
                if r['set_open_relatives']:
                    _why.append('open gh relative: %s'
                                % ', '.join('#%d' % n for n in r['set_open_relatives']))
                print('  HELD: %s' % '; '.join(_why))
            if r['set_unreadable']:
                print('  set relations UNREADABLE for a member -- the set verdict is '
                      'INCOMPLETE, never a clean one')
            if r['set_clock_state']:
                print('  set soak clock: %s' % r['set_clock_state'])
            if r['linked_open_fix']:
                print('  linked open fix-type (file graph): %s'
                      % ', '.join('#%d' % n for n in r['linked_open_fix']))
            elif r['linked']:
                print('  linked (file graph, not open fix-type): %s'
                      % ', '.join('#%d' % n for n in r['linked']))
    sys.exit(0)

elif action == 'walk':
    # #761 step 3 (law: upstream-merge-runbook.md, sync step 12) -- the
    # fork-only SYNC RE-VERIFICATION LEG.
    #
    # A force-push rewrites `origin/main`, so the one fact a fork-only
    # declaration asserts -- upstream lacks the surface this repairs -- is
    # exactly the fact a sync can change. A declaration never re-read is a
    # note, not a control.
    #
    # Per OPEN `not-upstreamable` row, three premises:
    #   (a) SURFACE    -- does upstream still lack the surface the row names?
    #                     DECLARATION-LEVEL (#633/#758): the declarations the
    #                     row's own unit ADDED are derived from the `+` side of
    #                     its commits and tested against upstream; a name
    #                     carried upstream under an EQUAL normalised declaration
    #                     header is the signal. NEVER a by-name symbol match --
    #                     a name present upstream under a DIVERGED signature is
    #                     the fork's own substance and is reported as such.
    #                     TEST-path declarations are excluded from the signal:
    #                     a test the unit added is not the PRODUCT surface the
    #                     row names (the sibling `fork_only_surface_references`
    #                     drops them for the same reason). The count excluded is
    #                     disclosed, never silent.
    #   (b) BRANCH SET -- does the row's `branches` set still resolve on the fork?
    #                     A row carrying NO `branches` cannot have this premise
    #                     verified at all -- reported UNCOVERED (a
    #                     declaration-completeness gap, disclosed once per run),
    #                     NEVER as a premise that moved. Measured 2026-10-02:
    #                     all 9 live rows carry none, so a naive walk would
    #                     report 9/9 moved on its first run -- noise
    #                     indistinguishable from a real finding.
    #   (c) REASON     -- do the fork commits the recorded `reason`/`revert`
    #                     cite still resolve? A FULL 40-hex sha that no longer
    #                     resolves is unambiguous and CHANGED. A SHORTER token
    #                     that does not resolve is ambiguous -- a short
    #                     abbreviation, or the 8-hex display form of a LANE
    #                     SESSION ID (the live 725 rows cite `lane 42a44908`
    #                     and two peers) -- so it is reported UNVERIFIED, never
    #                     as a moved premise.
    #
    # REMOVAL IS FORBIDDEN (harvest.md Phase 7c): this arm REPORTS a stale row,
    # it never deletes one. SILENCE IS NOT RETENTION: a premise that no longer
    # holds is a FINDING printed by the row's `unit` (the register's upsert key;
    # rows carry no separate id), never a quiet skip -- and a premise the
    # register does not let us check is printed as UNVERIFIED, because an
    # unverifiable check that reports clean is the #485 defect in a new costume.
    #
    # Dry-run by default: the ONLY write is `verified_at` on rows whose premises
    # ALL held AND were all checkable -- an UNCOVERED row is never stamped, that
    # would assert a check that never happened. `--no-write` suppresses even
    # that. Exit 1 when a premise moved, 0 otherwise -- an UNVERIFIED or
    # UNCOVERED premise is reported, never silent, but neither is a change:
    # there is nothing to dispose of until the register carries it.
    as_json = '--json' in sys.argv
    no_write = '--no-write' in sys.argv
    walk_base = 'adolfousier/main'
    now_ts = int(os.environ.get('OC_HARVEST_NOW_TS') or time.time())
    walk_stamp = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(now_ts))

    if not registry_file or not os.path.exists(registry_file):
        sys.stderr.write('oc-harvest-census walk: registry not found (%s)\n' % registry_file)
        sys.exit(3)
    with open(registry_file) as f:
        wdata = json.load(f)
    wrecords = wdata.get('manual_records', []) or []
    open_rows = [r for r in wrecords
                 if isinstance(r, dict)
                 and oc_claims.manual_record_status(r) == oc_claims.MANUAL_STATUS_NOT_UPSTREAMABLE]

    wcommits = get_ahead_commits(repo_path, mock_commits)
    wby_issue = build_commits_by_issue(wcommits)
    # #761 step 3: a unit's declarations are read from ITS OWN commits, resolved
    # by the #307-anchored `Issue-Ref` index over ALL refs -- NOT from the
    # `adolfousier/main..origin/main` delta. The delta is the right set for the
    # harvest gates, but the walk re-reads declarations of rows whose work may
    # already have been synced, so an ahead-only source would silently drop the
    # very units it is meant to re-verify (measured 2026-10-02: 7 of 9 live rows
    # derived no declaration from the ahead set).
    try:
        widx = oc_claims.issue_ref_index(repo_path, '--all')
    except Exception:
        widx = None

    def _walk_row_issues(r):
        # The row's own issue set. A NUMERIC `unit` is a fallback, used only
        # when the row carries no issue at all -- the live duplicate 725 row
        # has `issue: null` while its unit names the issue.
        s = set()
        for _v in ([r.get('issue')] + list(r.get('issues') or [])):
            try:
                if _v is not None and str(_v).strip():
                    s.add(int(_v))
            except (TypeError, ValueError):
                pass
        if not s and str(r.get('unit') or '').strip().isdigit():
            s.add(int(str(r['unit']).strip()))
        return s

    def _walk_sha_tokens(text):
        return sorted(set(re.findall(r'(?<![0-9a-fA-F])[0-9a-f]{7,40}(?![0-9a-fA-F])', text or '')))

    changed, unverified, uncov, verified = [], [], [], []
    for r in open_rows:
        issues = _walk_row_issues(r)
        prem = {}

        # ---- (a) SURFACE ----------------------------------------------------
        unit_commits = []
        for _iss in sorted(issues):
            try:
                _shas = oc_claims.resolve_issue_commits(repo_path, _iss, index=widx)
            except Exception:
                _shas = []
            for _sha in _shas:
                unit_commits.append({'sha': _sha})
        if not unit_commits:
            # No anchored commit at all: fall back to the ahead delta so a
            # trailer-less unit still has a chance to derive (and if it cannot,
            # the UNVERIFIED arm below says so by name).
            for _iss in sorted(issues):
                unit_commits.extend(wby_issue.get(_iss, []))
        added = derive_added_declarations(unit_commits, repo_path)
        if not added:
            prem['a'] = ('UNVERIFIED',
                         'no added declaration derivable from the unit (%d anchored commit(s) for issue(s) %s)'
                         % (len(unit_commits), sorted(issues) or 'none'))
        else:
            # Test-path declarations are not the PRODUCT surface the row names
            # (the sibling `fork_only_surface_references` drops them too). A
            # unit whose only added declarations are tests has no product
            # surface derivable -> UNVERIFIED, not a silent pass.
            _prod = [(f, s) for (f, s) in added if not _is_test_path(f)]
            _test_only = len(added) - len(_prod)
            if not _prod:
                prem['a'] = ('UNVERIFIED',
                             'only %d test-path declaration(s) added -- no product surface derivable' % _test_only)
            else:
                present, _absent = subject_present_upstream(_prod, repo_path, walk_base)
                arrived, diverged, weak = [], [], []
                _bodies = {}
                for f_path, sym in present:
                    for _tag, _spec in (('up', '%s:%s' % (walk_base, f_path)),
                                        ('fork', 'origin/main:%s' % f_path)):
                        _k = (_tag, f_path)
                        if _k not in _bodies:
                            _rr = subprocess.run(['git', '-C', repo_path, 'show', _spec],
                                                 capture_output=True, text=True)
                            _bodies[_k] = _rr.stdout if _rr.returncode == 0 else ''
                    _uh = _decl_header_for_symbol(_bodies[('up', f_path)], sym)
                    _fh = _decl_header_for_symbol(_bodies[('fork', f_path)], sym)
                    _lbl = '%s::%s' % (f_path, sym)
                    if _fh and _uh:
                        (arrived if _fh == _uh else diverged).append(_lbl)
                    else:
                        weak.append(_lbl)
                _detail = 'upstream carries %d of %d product declaration(s): %s' % (
                    len(arrived), len(_prod), ', '.join(arrived) if arrived else '(none)')
                if _test_only:
                    _detail += ' | %d test-path declaration(s) excluded from the SURFACE signal' % _test_only
                if diverged:
                    _detail += ' | %d present by name under a DIVERGED declaration (fork-only substance survives): %s' % (
                        len(diverged), ', '.join(diverged))
                if weak:
                    _detail += ' | %d present by name with no readable declaration header on one side -- disclosed, not judged: %s' % (
                        len(weak), ', '.join(weak))
                prem['a'] = ('CHANGED' if arrived else 'HOLDS', _detail)

        # ---- (b) BRANCH SET -------------------------------------------------
        # A row carrying no `branches` has nothing recorded that a rewrite
        # could have dropped, so the premise is UNCOVERED -- a
        # declaration-completeness gap, NOT a moved premise (measured
        # 2026-10-02: all 9 live rows carry none).
        branches = [str(b).strip() for b in (r.get('branches') or []) if str(b).strip()]
        if not branches:
            prem['b'] = ('UNCOVERED',
                         'row carries no `branches` set -- premise (b) cannot be verified at all '
                         '(declaration-completeness gap, not a change)')
        else:
            _gone = [b for b in branches
                     if not any(ref_exists(_cand, repo_path) for _cand in
                                ('refs/heads/%s' % b, 'refs/remotes/origin/%s' % b,
                                 'origin/%s' % b, b))]
            prem['b'] = ('CHANGED' if _gone else 'HOLDS',
                         ('branch(es) no longer on the fork: %s' % ', '.join(_gone)) if _gone
                         else ('all %d recorded branch(es) resolve' % len(branches)))

        # ---- (c) REASON -----------------------------------------------------
        _cites = sorted(set(_walk_sha_tokens(r.get('reason')) + _walk_sha_tokens(r.get('revert'))))
        if not _cites:
            prem['c'] = ('UNCOVERED',
                         'the recorded reason/revert cites no commit sha (prose judgment stays a lane decision, not mechanized here)')
        else:
            _dead, _ambig = [], []
            for s in _cites:
                if subprocess.run(['git', '-C', repo_path, 'cat-file', '-e', s + '^{commit}'],
                                  capture_output=True).returncode == 0:
                    continue
                # A FULL 40-hex sha that no longer resolves is unambiguous: the
                # commit the reason cites is gone from the fork. A SHORTER token
                # is ambiguous -- a short abbreviation that may have been
                # rewritten away, or the 8-hex display form of a LANE SESSION ID
                # (the live 725 rows cite `lane 42a44908` and two peers, none of
                # which is a commit). The ambiguous class is UNVERIFIED, so a
                # lane id is never reported as a moved premise.
                (_dead if len(s) == 40 else _ambig).append(s)
            _parts = []
            if _dead:
                _parts.append('cited commit sha(s) no longer resolve in the fork: %s' % ', '.join(_dead))
            if _ambig:
                _parts.append('%d short token(s) do not resolve as commits -- ambiguous (a short abbreviation, or a lane session id), not judged: %s'
                              % (len(_ambig), ', '.join(_ambig)))
            if not _parts:
                _parts.append('all %d cited commit sha(s) resolve' % len(_cites))
            prem['c'] = ('CHANGED' if _dead else ('UNVERIFIED' if _ambig else 'HOLDS'),
                         ' | '.join(_parts))

        entry = {'unit': str(r.get('unit')), 'issue': r.get('issue'), 'pr': r.get('pr'),
                 'reason': str(r.get('reason') or ''),
                 'premises': {k: {'verdict': v[0], 'detail': v[1]} for k, v in sorted(prem.items())}}
        moved = [k for k, v in sorted(prem.items()) if v[0] == 'CHANGED']
        unsolved = [k for k, v in sorted(prem.items()) if v[0] == 'UNVERIFIED']
        missing = [k for k, v in sorted(prem.items()) if v[0] == 'UNCOVERED']
        if moved:
            entry['moved'] = moved
            changed.append(entry)
        elif unsolved or missing:
            # An UNCOVERED premise is a declaration-completeness gap, NOT a
            # change -- but the row is also NOT attested: verified_at asserts a
            # check that never happened, so it is withheld. Disclosed here.
            if unsolved:
                entry['unverified'] = unsolved
            if missing:
                entry['uncovered'] = missing
            uncov.append(entry)
        else:
            verified.append(entry)
            r['verified_at'] = walk_stamp

    if not no_write and verified:
        with open(registry_file, 'w') as f:
            json.dump(wdata, f, indent=2)

    wsummary = {'open_rows': len(open_rows), 'changed': len(changed),
                'unverified_or_uncovered': len(uncov), 'verified': len(verified),
                'stamp': walk_stamp, 'wrote': bool(not no_write and verified)}

    if as_json:
        print(json.dumps({'registry': registry_file, 'base': walk_base,
                          'changed': changed, 'unverified_or_uncovered': uncov,
                          'verified': verified, 'summary': wsummary}, indent=2))
    else:
        print('=== #761 step-3 walk: fork-only sync re-verification (%s) ==='
              % ('dry run; verified_at stamped' if not no_write else 'READ-ONLY (--no-write)'))
        print('registry: %s' % registry_file)
        print('base: %s   OPEN `not-upstreamable` rows: %d' % (walk_base, len(open_rows)))
        print('')
        print('CHANGED -- premise moved (%d)' % len(changed))
        for e in changed:
            print('  - unit=%s issue=%s pr=%s  premise(s) moved: %s'
                  % (e['unit'], e['issue'], e['pr'], ', '.join(e['moved'])))
            for _k in sorted(e['premises']):
                if e['premises'][_k]['verdict'] == 'CHANGED':
                    print('      (%s) %s' % (_k, e['premises'][_k]['detail']))
            if e['reason']:
                print('      reason on file: %s' % e['reason'][:200])
            print('      -> disposition (re-declare / re-scope / close) is a LANE decision; this leg never deletes.')
        print('')
        print('UNVERIFIED / UNCOVERED -- not derivable, NOT attested (%d)' % len(uncov))
        for e in uncov:
            print('  - unit=%s issue=%s  unverified: %s'
                  % (e['unit'], e['issue'],
                     ', '.join(e.get('unverified') or e.get('uncovered') or [])))
            for _k in sorted(e['premises']):
                _v = e['premises'][_k]['verdict']
                if _v in ('UNVERIFIED', 'UNCOVERED'):
                    print('      (%s) %s' % (_k, e['premises'][_k]['detail']))
        print('')
        print('VERIFIED -- all premises held (%d)%s'
              % (len(verified), '' if no_write else ' -- verified_at=%s' % walk_stamp))
        for e in verified:
            print('  - unit=%s issue=%s' % (e['unit'], e['issue']))
            for _k in sorted(e['premises']):
                print('      (%s) %s' % (_k, e['premises'][_k]['detail']))
        print('')
        print('summary: %d OPEN row(s) -- %d CHANGED, %d UNVERIFIED/UNCOVERED, %d VERIFIED%s'
              % (len(open_rows), len(changed), len(uncov), len(verified),
                 '' if no_write else ' (stamped %s)' % walk_stamp))
        print('         no row deleted: REMOVAL IS FORBIDDEN (harvest.md Phase 7c) -- a reported row is a FINDING, not a deletion.')

    sys.exit(1 if changed else 0)

elif action in ('scan', 'sync'):
    as_json = '--json' in sys.argv
    commits = get_ahead_commits(repo_path, mock_commits)
    
    unharvested = []
    covered = []
    for c in commits:
        # #369: canonical parse (fork space only, comma multi-refs, explicit
        # `#N` subject fallback). The PR map is keyed by ONE issue, so the
        # pick is deterministic: the lowest number the commit anchors to.
        _refs = oc_claims.commit_issue_refs(c.get('trailer', ''), c.get('subject', ''))
        iss = min(_refs) if _refs else None
        
        pr_info = issue_map.get(iss) if iss else None
        if pr_info:
            c['upstream_pr'] = pr_info['pr']
            c['upstream_state'] = pr_info['state']
            covered.append(c)
        else:
            unharvested.append(c)
            
    summary = {
        'upstream_open_prs': [p for p in pr_entries if p['state'] == 'OPEN'],
        'upstream_merged_prs': [p for p in pr_entries if p['state'] == 'MERGED'],
        'unharvested_commits': unharvested,
        'covered_commits': covered,
        'mapped_issues': len(issue_map)
    }

    if action == 'sync' or (action == 'scan' and registry_file):
        os.makedirs(os.path.dirname(os.path.abspath(registry_file)), exist_ok=True)
        merged = {}
        if os.path.exists(registry_file):
            try:
                with open(registry_file) as f:
                    loaded = json.load(f)
                if isinstance(loaded, dict):
                    merged = loaded
            except Exception:
                merged = {}
        merged['prs'] = prs
        merged['summary'] = summary
        with open(registry_file, 'w') as f:
            json.dump(merged, f, indent=2)

    if as_json:
        print(json.dumps(summary, indent=2))
    else:
        open_prs = summary['upstream_open_prs']
        print(f'=== Upstream In-Flight PRs ({len(open_prs)} open) ===')
        for p in open_prs:
            iss_first = p['issues'][0] if p['issues'] else None
            issues_str = f' [#{iss_first}]' if iss_first is not None else ''
            pr_num = p['pr']
            head_ref = p['head']
            title_part = p['title'][:50]
            print(f'  PR #{pr_num:<4d} {head_ref:<40s}{issues_str} - {title_part}')
        
        print(f'\n=== Ahead Commits Classification ===')
        print(f'  Total Ahead: {len(commits)} commits')
        print(f'  Covered by PRs: {len(covered)} commits')
        print(f'  Unharvested: {len(unharvested)} commits')
        
        if unharvested:
            print('\n=== Unharvested Ahead Candidates (sample) ===')
            for c in unharvested[:10]:
                c_sha = c['short_sha']
                c_sub = c['subject'][:65]
                print(f'  {c_sha} {c_sub}')
    sys.exit(0)
OCPY
}

