    return 1
  fi
  ok "#13 a conditional row emits NO 'filed in PR' claim"

  # 9i. MUTATION CONTROL / class discrimination (#13). The three statuses must be
  #     DISTINGUISHABLE, not merely present: if a later edit collapsed the branches
  #     (e.g. returned the conditional constant for every non-filed row), the two
  #     positive legs above would still pass while the register silently lost the
  #     distinction. So assert the CROSS arms are NEGATIVE: a not-upstreamable row
  #     must NOT read as conditional, and a conditional row must NOT read as
  #     not-upstreamable. This fails the moment the classes are merged.
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$nu_reg" "not-up-unit" 2>&1)" || rc=$?
  if oc_has "$out" "CONDITIONALLY UPSTREAMABLE"; then
