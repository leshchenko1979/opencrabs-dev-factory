_MAIN_COMMITS_CACHE = {}


def get_main_resident_commits(repo_path):
    """Every commit resident on origin/main, as commit dicts -- the FULL history,
    not the fork-only delta.

    #625. A HARVESTED member's commits leave the fork-only range
    (`adolfousier/main..origin/main`) because harvesting moves them into
    `adolfousier/main`. member_ready() derived `swapped_ts` only from that range,
    so once a member was harvested its anchor became unreachable and the swapped
    leg refused it PERMANENTLY -- unresolvable by any legitimate action, since
    the very act of harvesting is what broke it. Measured on #119: upstream PR
    adolfousier/opencrabs#1481 MERGED, fork merge a0f581752 an ancestor of main,
    and `git log adolfousier/main..origin/main` carries 0 commits for it while
    full history carries 5.

    The swap-journal path cannot substitute: measured at the same instant, 293
    distinct auto-swap shas exist and only 44 intersect origin/main, and #119's
    own journal sha (64bca902) is NOT on main -- it was squashed by the very
    harvest that deployed it.

    Walked once per repo and memoised, and consulted ONLY when the fork-only
    index holds nothing for the member, so the common path is unchanged. Cost
    measured: one full walk is 2455 commits.

    Keyed on the Issue-Ref TRAILER via the same oc_claims.parse the delta walk
    uses -- never `--grep`, which matches prose mentions (measured: `--grep=#119`
    returns 0e74d6bf, a commit that only names #119 in text).
    """
    mock = os.environ.get("OC_HARVEST_MOCK_MAIN_COMMITS", "")
    if mock and os.path.exists(mock):
        with open(mock) as f:
            return json.load(f)
    key = os.path.abspath(repo_path or "")
    if key in _MAIN_COMMITS_CACHE:
        return _MAIN_COMMITS_CACHE[key]
    commits = []
    if repo_path and os.path.isdir(repo_path):
        cmd = [
            "git", "-C", repo_path, "log", "origin/main",
            "--format=%H%x1f%h%x1f%s%x1f%(trailers:key=Issue-Ref,valueonly,separator=%x2c)%x1f%ct",
        ]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True)
        except Exception:
            res = None
        if res is not None and res.returncode == 0:
            for line in res.stdout.strip().split("\n"):
                if not line:
                    continue
                parts = line.split("\x1f")
                if len(parts) < 5:
                    continue
                try:
                    cts = int(parts[4]) if parts[4].strip().isdigit() else 0
                except Exception:
                    cts = 0
                commits.append({
                    "sha": parts[0], "short_sha": parts[1],
                    "subject": parts[2], "trailer": parts[3].strip(),
                    "commit_ts": cts,
                })
    _MAIN_COMMITS_CACHE[key] = commits
    return commits


def member_commits(iss, commits_by_issue, repo_path):
    """A member's commits, and whether the FULL-history widening decided.

    Returns (commits, widened). `widened` is True only when the fork-only delta
    held nothing and the main-resident index supplied the commits -- so a caller
    can disclose WHICH evidence made the member ready. The two are not the same
    claim: a swap-journal anchor says the content shipped in a deployed binary;
    main residency says the content landed on main. For a harvested member the
    second is the reachable one, and a reader must be able to tell them apart.
    """
    try:
        n = int(iss)
    except Exception:
        return [], False
    cs = commits_by_issue.get(n, [])
    if cs:
        return cs, False
    idx = build_commits_by_issue(get_main_resident_commits(repo_path))
    got = idx.get(n, [])
    return (got, True) if got else ([], False)


def member_ready(iss, commits_by_issue, repo_path, swaps, st_dir,
                 mock_deployed_ts=None):
    """Is this set member READY? ready = swapped AND smoked.

    `closed` is deliberately NOT required (owner order 2026-09-26, verbatim:
    "the closed+swapped+smoked rule should exclude closed"). Under the closure
    law a standalone src/** issue closes only AFTER its own upstream PR files,
    and the PR files only through the harvest lane whose pre-flight gate IS this
    census -- so requiring `closed` made closure a precondition of the act that
    produces it. Measured at the ruling instant: HELD 58 of 58 open fix-titled,
    zero harvestable.

    BOTH halves are required and neither is redundant -- measured on the live
    set (89 members): 10 are swapped-but-unsmoked and 2 are
    smoked-but-unswapped, so neither implies the other. `swapped` is also the
    only source of the soak clock's anchor, so it cannot be dropped for that
    reason alone.

    Returns (ready: bool, why: str); `why` names the MISSING half so a refusal
    can say which condition failed rather than print a bare GH state.
    """
    swapped_ts = 0
    _cs, _widened = member_commits(iss, commits_by_issue, repo_path)
    for c in _cs:
        t = c.get('deployed_ts') or get_commit_deploy_ts(
            c.get('sha', ''), repo_path, swaps, mock_deployed_ts, st_dir)
        if not t and _widened:
            # The widened path supplies main residency, not a swap anchor: the
            # member's own commits are on origin/main, so the content landed.
            # Anchor on the newest such commit, matching the max() the delta
            # path already uses for the soak clock.
            t = c.get('commit_ts') or 0
        if t and t > swapped_ts:
            swapped_ts = t
    smoke_ts = get_issue_smoke_pass_ts(int(iss), st_dir)
    # #654: a HARVESTED member can never satisfy the smoke leg. Its fork smoke
    # row was never owed -- the harvest IS the completion -- so demanding one
    # held the whole cluster forever, and no legitimate action could clear it.
    # Measured: #119 CLOSED, upstream PR adolfousier/opencrabs#1481 MERGED, fork
    # merge a0f581752 an ancestor of main, and ZERO rows carry `issue=#119` in
    # smoke-verdicts.log (read by the structured field, not a substring -- the
    # prose form false-positives on cross-references, per #415). The harvest is
    # the acceptance evidence for such a member, and the verdict SAYS so rather
    # than dropping the member from the set, which would hide it.
    _harvest_pr = None
    try:
        _hit = issue_map.get(int(iss)) if issue_map else None
        if _hit and _hit.get('state') == 'MERGED':
            _harvest_pr = _hit.get('pr')
    except (TypeError, ValueError, NameError):
        _harvest_pr = None
    missing = []
    if not swapped_ts:
        missing.append('not swapped')
    if not smoke_ts and not _harvest_pr:
        missing.append('not smoked')
    if not missing and _harvest_pr:
        # Disclosure, not a bare verdict: the reader can see that the smoke leg
        # was satisfied by the HARVEST, not by a fork smoke row.
        return True, 'swapped+smoked(harvested:PR #%s)' % _harvest_pr
    if not missing and _widened:
        # Disclosure, not a bare verdict: the reader can see WHICH evidence made
        # this member ready, so a main-resident anchor is never mistaken for a
        # deployed-binary one.
        return True, 'swapped+smoked(main-resident)'
    return (not missing), ('+'.join(missing) if missing else 'swapped+smoked')


def cycle_note(active_claims, target_iss):
    """Name mutual substantive overlaps; older filed claim keeps precedence."""
    own = [c for c in active_claims if c.get('issue') == target_iss]
    if not own:
        return []
    notes = []
    for claim in active_claims:
        if claim.get('issue') == target_iss:
            continue
        overlap = set().union(*(set(c.get('files', [])) for c in own)).intersection(claim.get('files', []))
        overlap = filter_substantive_overlap(overlap)
        if overlap:
            older = min(own + [claim], key=lambda c: c.get('filed_ts', 0) or 0)
            notes.append('NOTE: mutual in-flight cycle #%s <-> #%s on %s; precedence: older claim #%s keeps, newer yields' % (target_iss, claim.get('issue') or '?', ', '.join(sorted(overlap)[:3]), older.get('issue') or '?'))
    return notes

# ---- Leg (v): re-validate the claim's OWN recorded blocker (#536) ------------
# Legs (i)-(iv) bound WHEN a claim was filed (liveness/age) and how cycles
# resolve, but NOT ONE of them reads the claim's own reason — so a claim whose
# blocker has already expired still fences exactly as though live. Measured
# case: lane aaa8d8ae's #443 claim was recorded DESIGN-GATED with "no code in
# flight", yet all four of its commits were ancestors of origin/main and
# origin/main == deployed.sha BEFORE the release ruling. The claim had outlived
# its own stated blocker and nothing re-validated it.
#
# CLOSED SET of blocker TYPES only, never a semantic read of free text:
#   design-gate    the claim names a session plan; is approved_at still null?
#   code-in-flight the claim's ANCHORED footprint; do those paths now carry a
#                  commit on origin/main since the claim was filed?
# The note is ADVISORY and printed BESIDE the fence — it never becomes a gate
# verdict and never changes rc. When neither type parses (no plan reference, no
# anchored footprint, unreadable plan), the SKIP DISCLOSURE is printed instead
# of nothing: an unverifiable check that reports clean is the #485 defect in a
# new costume, and a silent skip is indistinguishable from "blocker still
# holds". Same posture as the oc-ledger C8 anchor guard.
BLOCKER_DESIGN = re.compile(r'design[\s-]*gated', re.I)
BLOCKER_FLIGHT = re.compile(r'in[\s-]*flight|fix queued|code in flight', re.I)
# The uuid must be DECLARED as a plan reference. A bare 8-hex token is not one:
# claim prose routinely carries card/message/thread ids, and matching one of
# those to a plan filename would yield a confident verdict about the wrong plan.
BLOCKER_PLAN_REF = re.compile(
    r'\b(?:session\s+)?plan[\s:#]*([0-9a-f]{8}(?:-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?)\b',
    re.I)


def _plan_dirs(st_dir):
    """Directories the session-plan files live in, most specific first.

    Both are live in this fleet: the engine writes under
    <profile>/agents/session/ while <profile>/session/ carries the older set, so
    searching either alone silently misses plans — and a miss reads as
    "the plan is not on disk", which is a DIFFERENT verdict from "approved".
    OC_PLAN_DIRS (colon-separated) overrides the search for fixtures.
    """
    override = os.environ.get('OC_PLAN_DIRS')
    if override:
        return [d for d in override.split(':') if d]
    base = os.path.dirname(st_dir.rstrip('/')) if st_dir else ''
    return [os.path.join(base, 'agents/session'), os.path.join(base, 'session'),
            os.path.join(st_dir, 'agents/session'), os.path.join(st_dir, 'session')]


def _plan_approved_at(plan_dirs, prefix):
    """(found, approved_at) for the session plan whose uuid starts `prefix`.

    Returns (False, None) when no plan matches, which the caller reports as a
    SKIP rather than as a held blocker: "no plan on disk" must never be rendered
    as a verdict about the blocker.
    """
    for d in plan_dirs:
        if not d or not os.path.isdir(d):
            continue
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            if not (name.startswith('.opencrabs_plan_') and name.endswith('.json')):
                continue
            if prefix[:8] not in name:
                continue
            try:
                with open(os.path.join(d, name)) as f:
                    return True, json.load(f).get('approved_at')
            except Exception:
                return True, None
    return False, None


def blocker_note(claim, repo_path, st_dir, now_ts=None):
    """One ADVISORY line re-validating the claim's own recorded blocker (#536).

    Never raises and never returns a gate verdict: an unresolvable input yields
    the skip disclosure, so the caller can print a note whose absence is always
    explained. Returns None when the claim records no blocker from the closed
    set at all — that is "not a blocker-bearing claim", which is a different
    answer from "a blocker-bearing claim whose blocker cannot be resolved".
    """
    what = claim.get('what') or ''
    if BLOCKER_DESIGN.search(what):
        m = BLOCKER_PLAN_REF.search(what)
        if not m:
            return ('NOTE(blocker): claim #%s says design-gated but names no session plan '
                    '— blocker NOT re-validated (skip)' % (claim.get('issue') or '?'))
        found, approved_at = _plan_approved_at(_plan_dirs(st_dir), m.group(1))
        if not found:
            return ('NOTE(blocker): claim #%s design-gated on plan %s, which is not on disk '
                    '— blocker NOT re-validated (skip)' % (claim.get('issue') or '?', m.group(1)[:8]))
        if approved_at:
            return ('NOTE(blocker): claim #%s says design-gated but its plan %s now carries '
                    'approved_at=%s — the recorded blocker has EXPIRED; review the fence'
                    % (claim.get('issue') or '?', m.group(1)[:8], approved_at))
        return ('NOTE(blocker): claim #%s says design-gated and plan %s still has '
                'approved_at=null — blocker holds' % (claim.get('issue') or '?', m.group(1)[:8]))

    if BLOCKER_FLIGHT.search(what):
        files = [f for f in (claim.get('files') or []) if f]
        if not files:
            return ('NOTE(blocker): claim #%s says in-flight but carries no anchored footprint '
                    '— blocker NOT re-validated (skip)' % (claim.get('issue') or '?'))
        if not repo_path or not os.path.isdir(repo_path):
            return ('NOTE(blocker): claim #%s says in-flight but no repo is readable '
                    '— blocker NOT re-validated (skip)' % (claim.get('issue') or '?'))
        rv = subprocess.run(['git', '-C', repo_path, 'rev-parse', '--verify', 'origin/main'],
                            capture_output=True, text=True)
        if rv.returncode != 0:
            return ('NOTE(blocker): claim #%s says in-flight but origin/main does not resolve '
                    '— blocker NOT re-validated (skip)' % (claim.get('issue') or '?'))
        since = claim.get('filed_ts')
        if not since:
            return ('NOTE(blocker): claim #%s says in-flight but records no filing time '
                    '— blocker NOT re-validated (skip); an unbounded window would read '
                    'every path as touched' % (claim.get('issue') or '?'))
        touched, commits = [], 0
        for path in files:
            r = subprocess.run(['git', '-C', repo_path, 'log', 'origin/main',
                                '--since=%s' % since, '--format=%H', '--', path],
                               capture_output=True, text=True)
            n = len([ln for ln in r.stdout.split() if ln])
            if n:
                touched.append(path)
                commits += n
        if touched:
            sample = ', '.join(sorted(touched)[:2])
            return ('NOTE(blocker): claim #%s says in-flight but %d/%d named path(s) now carry '
                    '%d commit(s) on origin/main since the claim (%s) — the recorded blocker may '
                    'have EXPIRED' % (claim.get('issue') or '?', len(touched), len(files),
                                      commits, sample))
        return ('NOTE(blocker): claim #%s says in-flight and none of its %d named path(s) moved '
                'on origin/main since the claim — blocker holds'
                % (claim.get('issue') or '?', len(files)))

    return None


if action == 'check':
    m_iss = re.fullmatch(r'#?(\d+)', target) or re.fullmatch(r'issue-?(\d+)', target, re.IGNORECASE)
    target_iss = int(m_iss.group(1)) if m_iss else None

    # #493: every refusal leg is EVALUATED and its refusal COLLECTED, instead of
    # the first hit calling sys.exit(1). The legs are independent read-only
    # predicates over the same three inputs (matching_commits, target_files,
    # active_claims), so exiting at the first one merely hides the rest — and
    # hides them permanently, since `check` exposes no --explain/--verbose/--all
    # route. The damage is the eligible_at field: it is emitted by the SOAK legs
    # only, so a lane that comes back at the printed instant is refused again by
    # a masked leg carrying no clock at all (the #344 <-> #318 circular fence is
    # exactly that shape). One refusal per leg, every leg reported, rc unchanged.
    refusals = []

    def refuse(msg):
        """Record + print ONE refusal leg. Never exits (see #493 note above)."""
        print(msg)
        refusals.append(msg)

    match = None
    if target_iss and target_iss in issue_map:
        match = issue_map[target_iss]
    elif not target_iss:
        for p in pr_entries:
            if target.lower() in p['head'].lower() or target.lower() in p['title'].lower():
                match = p
                break

    closed_match = None
    if match:
        st = match['state']
        num = match['pr']
        ti = match['title']
        # #415: a merge inference is drawn from upstream PRs and branch names;
        # neither is the fork issue's OWN state. When the issue reads REOPENED,
        # the inference is stale -- the merged PR did not actually land it -- so
        # the refusal is overridden and the remaining gates decide.
        reopened = False
        if target_iss is not None and st == 'MERGED':
            live = get_issue_live_state(target_iss, mock_file=mock_issue_state)
            reopened = bool(live) and str(live.get('stateReason') or '').upper() == 'REOPENED'
            if reopened:
                print(f'NOTE: Target {target} infers MERGED upstream in PR #{num}, but fork issue {target_iss} reads REOPENED -- merge refusal overridden')
        if st == 'MERGED' and not reopened:
            refuse(f'REFUSED: Target {target} is already MERGED upstream in PR #{num}: {ti}')
        elif st == 'OPEN':
            refuse(f'REFUSED: Target {target} is currently IN_FLIGHT upstream in PR #{num}: {ti}')
        elif st == 'CLOSED':
            closed_match = match
    
    manual = []
    if os.path.exists(registry_file):
        try:
            with open(registry_file) as f:
                manual = json.load(f).get('manual_records', []) or []
        except Exception:
            manual = []
    # #564: the match predicate AND the wording now live in tools/lib/oc_claims.py,
    # because oc-harvest-dispatch needs the SAME predicate (it had none, so a unit
    # a prior lane settled was re-proposed every wave) and the wording has to agree
    # with the dispatcher's. Three arms now: filed / not-upstreamable / no PR
    # recorded -- the last because a `pr` field cannot be trusted to hold a PR
    # number (four live rows carry one that names nothing: 1510 is an upstream
    # ISSUE, three carry 0, and the old emission rendered those as fact).
    for r in manual:
        if oc_claims.manual_record_matches(r, target, target_iss):
            refuse('REFUSED: ' + oc_claims.manual_record_claim(r, target))

    commits = get_ahead_commits(repo_path, mock_commits)
    matching_commits = []
    other_commits = []
    # #323 (defect report): an issue number is NOT a commit identity. A bare
    # 3-digit target like 262 was read as a SHA PREFIX, so commit 262193f67 — a
    # real issue-249 commit — matched a query for issue 262 and produced a bogus
    # HELD_DEPENDENT_SOAK refusal. The discriminator is LENGTH, not "is this a
    # number": a digits-only target is ambiguous (a 7-char all-hex string is
    # both a legal issue number and a legal git abbreviation — the sha-lookup
    # fixtures below are exactly that shape), so the sha path now requires at
    # least 7 hex chars, git's own minimum abbreviation. Below that the target
    # cannot be a sha, so the two spaces stop colliding. False matches here
    # refuse rather than approve, so the residual ambiguity is the safe side.
    sha_target = bool(re.fullmatch(r'[0-9a-fA-F]{7,40}', target))
    for c in commits:
        # #369: the commit's issues are a SET, not a scalar. The previous
        # `re.search(r'#?(\d+)', tr)` made the `#` OPTIONAL, so a slug-form
        # trailer read as 1979 (the owner handle) and the real issue number was
        # never seen: matching_commits came out EMPTY, and every gate keyed off
        # it — gate 4 included — was skipped in silence, straight to ELIGIBLE.
        #
        # The subject is consulted only when the trailer yields nothing, and
        # then only for an EXPLICIT #<n>: the previous subject pattern took the
        # FIRST number anywhere, so the repo's own swap-marker convention (a
        # subject carrying an 8-hex fragment) attributed that commit to a
        # two-digit issue, and a date stamp like sync/upstream-20260917-2 to
        # issue 20260917 — both feeding matches_iss, the path behind the
        # manual-records gate and the 24h soak gate.
        iss_set = set(oc_claims.commit_issue_refs(c.get('trailer', ''), c.get('subject', '')))
        c_sha = c.get('sha', '')
        c_short = c.get('short_sha', '')
        matches_sha = bool(sha_target and (c_sha.lower().startswith(target.lower()) or c_short.lower().startswith(target.lower())))
        matches_iss = bool(target_iss is not None and target_iss in iss_set)
        # Subject matching: an issue-number query requires an explicit #<n>
        # citation, never an unanchored substring — the repo's swap-marker
        # convention puts an 8-hex fragment into every lane's subject, so a bare
        # substring test fires on sha fragments (target 192 matching a subject
        # that embeds 24c192a5), on date stamps (20260917 matching 202/609/917)
        # and on prose numerals (target 429 matching a global cooldown note).
        # Measured by the reporter over 210 commits: 15 false positives across
        # 9 commits for 3-digit targets, ~4.3% of the window. Non-issue targets
        # (branch/slug) keep the substring test, which is their lookup.
        if target_iss is not None:
            matches_subj = bool(re.search(r'#' + str(target_iss) + r'(?!\d)', c.get('subject', '')))
        else:
            matches_subj = bool(target.lower() in c.get('subject', '').lower())
        if matches_iss or matches_subj or matches_sha:
            matching_commits.append(c)
        else:
            other_commits.append(c)

    now_ts = int(os.environ.get('OC_HARVEST_NOW_TS') or time.time())
    st_dir = os.path.dirname(registry_file) if registry_file else os.environ.get('STATE_DIR', '')
    swaps = load_swap_history(st_dir)
    
    # 1. 24H FEATURE SOAK GATE FOR TARGET ITSELF
    for mc in matching_commits:
        subj = mc.get('subject', '')
        c_sha = mc.get('sha', '')
        is_feat = subj.startswith('feat') or 'feat/' in target.lower()
        if is_feat:
            # #413: THREE states, not two. 'unresolved' must never be reported
            # as a fresh commit with age 0.0h -- that asserted a false age and
            # carried no schedule (#415's triple). Shared predicate, one home
            # in tools/lib/oc_claims.py, so this tool and oc-harvest-dispatch
            # (the #563 fix) cannot drift.
            _state, _age, _fields = oc_claims.classify_soak_anchor(
                c_sha, mc.get('commit_ts', 0),
                lambda sha, ts: get_commit_deploy_ts(sha, repo_path, swaps, mc.get('deployed_ts')),
                swaps, now_ts)
            if _state == 'unresolved':
                refuse('REFUSED: Target %s is within the 24h feature soak window [SOAK_ANCHOR_UNRESOLVED] (commit %s: %s) %s; %s' % (target, mc.get('short_sha', '')[:7], subj[:50], _fields, oc_claims.soak_unresolved_note(mc.get('commit_ts', 0), now_ts)))
                break
            if _state == 'fresh':
                refuse('REFUSED: Target %s is within 24h feature soak window (age: %.1fh < 24h, commit %s: %s) %s' % (target, _age, mc.get('short_sha', '')[:7], subj[:50], _fields))
                break

    # 2. SUBSYSTEM COHESION & DEPENDENT SOAK CHECK (HELD_DEPENDENT_SOAK)
    # Check if target touches files of an unharvested feat/* currently in soak window
    target_files = set(get_affected_files_for_commits(matching_commits, repo_path))
    if target_files:
        for oc in other_commits:
            oc_subj = oc.get('subject', '')
            oc_sha = oc.get('sha', '')
            if oc_subj.startswith('feat'):
                # Check if this other feat is in soak window
                # #413: same three-state predicate as site 1 (shared home).
                _ostate, _oage, _ofields = oc_claims.classify_soak_anchor(
                    oc_sha, oc.get('commit_ts', 0),
                    lambda sha, ts: get_commit_deploy_ts(sha, repo_path, swaps, oc.get('deployed_ts')),
                    swaps, now_ts)
                if _ostate != 'soaked':
                    # Check file overlap
                    oc_files = set(get_affected_files_for_commits([oc], repo_path))
                    overlap = target_files.intersection(oc_files)
                    substantive_overlap = filter_substantive_overlap(overlap)
                    if substantive_overlap:
                        overlap_sample = ', '.join(sorted(list(substantive_overlap))[:3])
                        if _ostate == 'unresolved':
                            refuse('REFUSED: Target %s touches files of soaking feature %s [HELD_DEPENDENT_SOAK: %s] [DEPENDENT_SOAK_ANCHOR_UNRESOLVED] %s; %s' % (target, oc.get('short_sha', '')[:7], overlap_sample, _ofields, oc_claims.soak_unresolved_note(oc.get('commit_ts', 0), now_ts)))
                        else:
                            refuse('REFUSED: Target %s touches files of soaking feature %s (age: %.1fh < 24h) [HELD_DEPENDENT_SOAK: %s] %s' % (target, oc.get('short_sha', '')[:7], _oage, overlap_sample, _ofields))
                        # Keep evaluating every overlapping feature; refuse() aggregates
                        # this leg and the caller retains rc=1.


    # 3. IN-FLIGHT LANE FENCING (HELD_IN_FLIGHT_LANE)
    # Check if target touches files belonging to an active lane with an open claim
    ledger_path = mock_ledger or os.path.join(st_dir, 'workers-ledger.json')
    active_claims = oc_claims.get_active_claims(ledger_path, repo_path)
    if target_files and active_claims:
        _seen_fences = set()
        for claim in active_claims:
            c_iss = claim.get('issue')
            if target_iss is not None and c_iss == target_iss:
                continue # own claim is not a foreign conflict
            c_files = set(claim.get('files', []))
            # Files arrive ANCHORED from get_active_claims (#307). An empty set
            # is a real answer — "no commit anchors to this claim's issue" — and
            # is never a gap to refill by grepping commit prose for `#N`.
            overlap = target_files.intersection(c_files)
            # Registry-only overlap is NOT a substantive conflict (#375). Every
            # test-bearing change registers its module in src/tests/mod.rs, so a
            # raw intersection fences ANY test-bearing harvest against ANY lane
            # holding a test claim. §2 (HELD_DEPENDENT_SOAK) already filters via
            # filter_substantive_overlap; this gate did not. The filter was
            # introduced scoped to the soak gate by name (6d9735da) with no
            # rationale, and the HQ amendment that created both gates names them
            # as parallel cases of one predicate — the asymmetry was an omission,
            # not a design.
            substantive_overlap = filter_substantive_overlap(overlap)
            if substantive_overlap:
                # A lane may hold MORE THAN ONE claim row on the same issue (the
                # ledger permits a re-claim, and #459 carries two). The fence's
                # unit is (lane, issue), not the row: without this, one lane
                # fences once per row, printing an identical REFUSED line twice
                # and inflating the "N refusal legs apply" count by phantom legs.
                _fkey = (claim.get('uuid', ''), c_iss)
                if _fkey in _seen_fences:
                    continue
                _seen_fences.add(_fkey)
                overlap_sample = ', '.join(sorted(list(substantive_overlap))[:3])
                c_uuid = claim.get('uuid', '')[:8]
                claim_age, claim_dormant, claim_phantom = claim_activity(claim, st_dir, now_ts)
                if claim_phantom:
                    # #653 / #404: the holder is a uuid the session DB has never
                    # seen. It can never finish or release this claim, so fencing
                    # on it is a permanent hold no legitimate action clears - and
                    # #404 forbids a phantom from entering a freeze list at all.
                    # Disclosed, not silent: the reader must see WHY the fence was
                    # skipped, and the remedy is a ledger release, not a wait.
                    print('NOTE(HELD_IN_FLIGHT_LANE): skipped - claim #%s is held by %s..., '
                          'a claim author the session DB has never seen (#404 phantom). '
                          'No lane can finish or release it; the fence is not applied. '
                          'Remedy: oc-ledger unclaim %s (or re-enroll the lane).'
                          % (c_iss or '?', c_uuid, c_uuid))
                    continue
                age_note = ' holder_age=unknown' if claim_age is None else ' holder_age=%.1fh%s' % (claim_age, ' DORMANT' if claim_dormant else '')
                advisory = ' ADVISORY: review/release dormant holder claim' if claim_dormant else ''
                refuse('REFUSED: Target %s touches files of active lane %s claim #%s [HELD_IN_FLIGHT_LANE: %s]%s%s' % (target, c_uuid, c_iss or '?', overlap_sample, age_note, advisory))
                # Leg (v), #536: re-validate the claim's OWN recorded blocker
                # beside the fence. Printed DIRECTLY, not through refuse(): a
                # blocker note is advisory evidence about the claim, never a
                # refusal leg of its own, and routing it through refuse() would
                # both inflate the "N refusal legs apply" count and imply the
                # note carries a clearance clock of its own. rc is untouched.
                _bn = blocker_note(claim, repo_path, st_dir, now_ts)
                if _bn:
                    print(_bn)

    for cycle in cycle_note(active_claims, target_iss):
        refuse(cycle)

    # 4. UPSTREAM SUBJECT EXISTENCE & FORK PROVENANCE
    #
    # The operative question is whether the fix's SUBJECT exists upstream, not
    # whether every touched FILE does (#365; HQ ruling 2026-09-18, v0.4.201,
    # triage.md "Closure predicate for fork-only base-fault fixes"). The old
    # file test refused any unit touching a path absent from adolfousier/main,
    # which hard-stopped #341 — a standalone fix whose one absent file is a test
    # it merely extends — and could never be cleared, because the provenance
    # lookup reads the path's ADD commit and the fork-main synthesis commit
    # carries no issue reference.
    #
    # The FILE test survives only as the provenance lookup that separates a
    # genuine fork-only child (HELD_PARENT_UNHARVESTED) from an orphan path
    # (ADVISORY, non-blocking). Fail-closed: nothing loosens unless the subject
    # is positively established from the fix's own diff.
    if matching_commits and repo_path and os.path.isdir(repo_path) and ref_exists('adolfousier/main', repo_path) and commits_present(matching_commits, repo_path):
        base_ref = 'adolfousier/main'
        subject_pairs, subject_stats = derive_symbols(matching_commits, repo_path)
        present_pairs, absent_pairs = subject_present_upstream(subject_pairs, repo_path, base_ref)
        present_syms = sorted({s for _, s in present_pairs if s})
        absent_syms = sorted({s for _, s in absent_pairs if s})

        if not present_syms:
            # No subject symbol resolves upstream. Two DIFFERENT cases:
            #
            #   (a) symbols WERE derived and every one is absent upstream -- the
            #       fix's substance is fork-only. Positive evidence: refuse, and
            #       do NOT consult the declared-subject fallback.
            #   (b) NOTHING was derivable -- the derivation is inconclusive, not a
            #       verdict, so a DECLARED subject may resolve the unit:
            #       --subject, else a `Subject:` trailer on the fix's own
            #       commits. It must still grep present upstream.
            #
            # (b) is tested by absent_syms, NOT by subject_pairs: derive_symbols
            # appends a pair for every hunk even when the symbol resolved to
            # None, so subject_pairs is non-empty in precisely the case this
            # branch exists for. Nothing partitioned (both lists empty) IS
            # "nothing derivable".
            #
            # Fail-closed either way: an absent or unverifiable declaration
            # refuses exactly as it did before the fallback existed.
            tested = ', '.join(absent_syms[:6]) or 'none derived'
            derivation_empty = not absent_syms
            declared = ''
            resolved = False
            if derivation_empty:
                declared = declared_subject or declared_subject_from_commits(matching_commits, repo_path)
                resolved = bool(declared) and declared_subject_present(declared, repo_path, base_ref)
            if resolved:
                print('ADVISORY: no symbol derivable from the fix diff; DECLARED subject %r is present in %s' % (declared, base_ref))
            else:
                why = ''
                if derivation_empty:
                    why = '; no declared subject' if not declared else ('; declared subject %r not present in %s' % (declared, base_ref))
                refuse('REFUSED: Target %s has no subject symbol present in %s [UPSTREAM_VOID: tested %s%s]' % (target, base_ref, tested, why))

        # Per-hunk packaging advisory: a hunk whose symbol does not resolve
        # upstream has no target there and is dropped at packaging — an
        # informational outcome, never a gate failure.
        for f_path, sym in sorted(set(absent_pairs)):
            print('ADVISORY: hunk inside fork-only symbol — dropped at packaging (%s :: %s)' % (f_path, sym))

        file_actions = get_affected_file_actions_for_commits(matching_commits, repo_path)
        for f_path, actions in file_actions.items():
            if any(a in ('D', 'M') for a in actions):
                exists_upstream = check_upstream_file_existence(f_path, base_ref, repo_path)
                if not exists_upstream:
                    intro_sha, intro_iss, intro_subj = check_fork_path_provenance(f_path, repo_path)
                    if intro_iss and target_iss is not None and intro_iss != target_iss:
                        # Class-2 SUB-RULE (#365): the refusal needs the
                        # introducing issue to be STILL unharvested. A path left
                        # behind by an already-harvested parent is not a held
                        # child — it falls through to the class-3 subject test
                        # (which already passed for this unit, or we would not
                        # be here) and reports as an advisory instead.
                        parent_harvested = issue_subject_upstream(intro_iss, repo_path, base_ref)
                        if parent_harvested is not True:
                            refuse('REFUSED: Target %s path %s was introduced by unharvested fork issue #%s (%s) and does not exist in %s [HELD_PARENT_UNHARVESTED]' % (target, f_path, intro_iss, intro_sha[:8] if intro_sha else '?', base_ref))
                            continue
                        print('ADVISORY: orphan path %s (absent upstream) — parent #%s already harvested; port decision required' % (f_path, intro_iss))
                        continue
                    print('ADVISORY: orphan path %s (absent upstream) — port decision required' % f_path)

    # 5. CLUSTER-SET READINESS (#607) -- HELD_SET / HELD_SET_SOAK
    #
    # The owner's rule (2026-09-26, verbatim): "the set must be decided in its
    # entirety -- either ready to harvest or not", where ready means every
    # member is swapped+smoked+CLOSED and the NEWEST member's swap is >24h old.
    #
    # Before this leg the rule was a VIEW: `held` was computed only in the
    # `clusters` arm, so a lane could harvest a cluster the tool itself flagged
    # held=true and nothing refused it. The per-unit legs (soak, in-flight lane,
    # unharvested parent) are each about ONE unit and none of them reads a
    # cluster's membership.
    #
    # The set is the issue UNION its DIRECT gh relatives (parent, sub-issues,
    # blockedBy, blocking) -- the "relationship graph" the runbook already names.
    # It is NOT a transitive closure: closure over either graph collapses the
    # delta into 3 mega-components (159+1+1), which is a set former that freezes
    # everything and admits nothing.
    #
    # rc is unchanged: a refusal here collects like every other leg and the
    # shared block below still exits 1.
    if target_iss is not None:
        _set_members, _rel_ok = cluster_set(
            target_iss, 'leshchenko1979/opencrabs',
            os.environ.get('OC_HARVEST_MOCK_RELATIONS'))
        if not _rel_ok:
            # Absence of evidence is not a free set: an unreadable graph means
            # the leg DID NOT RUN, and saying so is the only honest output.
            print('NOTE(HELD_SET): the gh relationship graph for #%d is UNREADABLE '
                  '-- the set could not be enumerated, so this leg did NOT run. '
                  'A set verdict is NOT claimed.' % target_iss)
        else:
            _by_iss = build_commits_by_issue(commits)
            _unready, _unreadable, _harvest_notes = [], [], []
            for _m in sorted(_set_members):
                if _m == target_iss:
                    # HQ ruling 2026-09-26 (n=11674): THE TARGET IS EXCLUDED FROM
                    # ITS OWN READINESS SET. It is the unit being harvested and the
                    # per-unit legs above gate it; a set verdict is about the SET.
                    continue
                _st = get_issue_live_state(_m, mock_file=mock_issue_state)
                if _st is None:
                    _unreadable.append(_m)
                    continue
                _rdy, _why = member_ready(_m, _by_iss, repo_path, swaps, st_dir)
                if not _rdy:
                    _unready.append((_m, (_st.get('state') or '?').lower(), _why))
                elif _why and 'harvested:' in _why:
                    # #654: DISCLOSE, never a bare verdict. This member's
                    # smoke leg was satisfied by its HARVEST, not by a fork
                    # smoke row -- and a ready member prints no `_why`
                    # anywhere else, so without this line the disclosure
                    # would be unreachable dead code.
                    _harvest_notes.append('#%d (%s)' % (_m, _why))
            if _unready:
                _detail = ', '.join('#%d(%s, %s)' % (m, st, why) for m, st, why in _unready)
                refuse('REFUSED: Target %s cluster set {%s} has %d UNREADY member(s) '
                       '[HELD_SET: %s] -- a member is ready when it is swapped+smoked; '
                       'CLOSED is NOT required because closure is this harvest\'s '
                       'OUTPUT, so requiring it made the set unharvestable by '
                       'construction' % (
                           target, ', '.join('#%d' % m for m in sorted(_set_members)),
                           len(_unready), _detail))
            if _unreadable:
                print('NOTE(HELD_SET): %d set member(s) could not be read (%s) -- the '
                      'set verdict above is INCOMPLETE, never a clean one.'
                      % (len(_unreadable), ', '.join('#%d' % m for m in _unreadable)))
            if _harvest_notes:
                print('NOTE(HELD_SET): %d member(s) are ready VIA THEIR HARVEST, not '
                      'via a fork smoke row: %s. The harvest is the acceptance '
                      'evidence for such a member (#654).'
                      % (len(_harvest_notes), ', '.join(_harvest_notes)))
            # The clock walks the SET, not the target: the target's own 24h
            # soak is leg 1 above, and including it here would make a fresh
            # target block the very set it is the subject of. A RELATIVE
            # deployed 2h ago still resets the clock -- that is the owner's
            # stated intent ("a fix deployed 2h ago resets its parent's clock").
            _set_for_clock = [m for m in _set_members if m != target_iss]
            _anchor, _age, _scanned, _anchor_sha = set_soak_clock(
                _set_for_clock, _by_iss, repo_path, swaps, now_ts, state_dir=st_dir)
            if _age is None:
                # #634: an EMPTY set and an UNRESOLVABLE one are DIFFERENT states
                # and must not share one output. With no members besides the
                # target, nothing CAN reset the clock -- the leg is vacuously
                # clear -- yet the hold-flavoured wording made a clean unit read
                # as held (measured: #348/#155/#459/#526 all ELIGIBLE rc=0 with
                # every gh relationship empty). Still disclosed, never silent
                # (#563 discipline), but no longer a hold.
                if not _set_for_clock:
                    print('NOTE(HELD_SET_SOAK): the set has no members besides the '
                          'target -- nothing can reset the set clock. VACUOUSLY '
                          'CLEAR, not a hold; the target soak is leg 1 above.')
                else:
                    print('NOTE(HELD_SET_SOAK): set soak clock UNRESOLVABLE -- no member '
                          'commit of the set carries a deploy anchor (%d commit(s) '
                          'scanned), so the 24h window cannot be shown to have started. '
                          'This is NOT "fresh" and NOT clearance.' % _scanned)
            elif _age < oc_claims.SOAK_HOURS:
                refuse('REFUSED: Target %s cluster set {%s} youngest member swap is '
                       '%.1fh old (< 24h) [HELD_SET_SOAK: anchor %s] -- a member '
                       'deployed recently resets the whole set\'s clock' % (
                           target, ', '.join('#%d' % m for m in sorted(_set_members)),
                           max(0.0, _age), oc_claims.soak_anchor_fields(_anchor_sha, _anchor)))
            else:
                print('NOTE(HELD_SET_SOAK): set soak clock clear -- youngest member '
                      'swap is %.1fh old (>= 24h).' % _age)
    else:
        print('NOTE(HELD_SET): the target is not an issue (sha/slug), so no cluster '
              'set exists to evaluate -- this leg did NOT run.')

    # #493: EVERY leg has now been evaluated, so the full applying set is printed
    # above rather than the first one to fire. rc is unchanged (1 on any
    # refusal), and the ELIGIBLE arms below stay unreachable when a refusal
    # fired — which is the precedence the pre-#493 code got by exiting early.
    if refusals:
        if len(refusals) > 1:
            soak_legs = [r for r in refusals if 'soak' in r.lower()]
            print('NOTE: %d refusal legs apply (all listed above).' % len(refusals))
            if soak_legs:
                print('NOTE: eligible_at, where printed, binds the SOAK leg ONLY (anchor + 24h) — it is NOT total clearance. %d other leg(s) are also refusing and carry no eligible_at clock, so returning at that instant will be refused again.' % (len(refusals) - len(soak_legs)))
            else:
                print('NOTE: no soak leg applies, so no eligible_at is printed — none of the refusals above carries a clearance clock.')
        sys.exit(1)

    if closed_match:
        num = closed_match['pr']
        ti = closed_match['title']
        print(f'ELIGIBLE_REWORK: Target {target} had PR #{num} CLOSED without merge: {ti}')
        sys.exit(0)

    print(f'ELIGIBLE: Target {target} is confirmed UNHARVESTED (clean to branch and gate)')
    sys.exit(0)

elif action == 'clusters':
    # Trap (c): NEVER page silently. Every cluster is emitted; if a bound is
    # ever added it must print what it withheld. A `head -80` on this output is
    # how a tail group vanished from a published count with no warning.
    as_json = '--json' in sys.argv
    open_fix_only = '--open-fix' in sys.argv
    # The set soak clock walks git ancestry per member commit, so it is OPT-IN
    # and its absence is DISCLOSED rather than rendered as a clean set.
    clock_on = '--clock' in sys.argv
    # The same three names the `check` arm loads, with the SAME derivation.
    # They were MISSING from this arm entirely, so `clusters --clock` died with
    # `NameError: name 'swaps' is not defined` on every invocation -- and the
    # readiness leg below needs them unconditionally, not only under --clock.
    # No leg covered it: the #607 legs exercised `check` and the non-clock
    # `clusters` path, so the flag was broken from the day it shipped.
    now_ts = int(os.environ.get('OC_HARVEST_NOW_TS') or time.time())
    st_dir = os.path.dirname(registry_file) if registry_file else os.environ.get('STATE_DIR', '')
    swaps = load_swap_history(st_dir)

    commits = get_ahead_commits(repo_path, mock_commits)
    clusters, unclustered = cluster_ahead_commits(commits)
    issues = get_fork_issues(mock_file=os.environ.get('OC_HARVEST_MOCK_ISSUES'))
    if issues is None:
        sys.stderr.write('oc-harvest-census clusters: cannot read the fork issue list '
                         '(gh failed) -- refusing to classify against an empty map\n')
        sys.exit(3)

    files_by_cluster = {}
    for iss, entry in clusters.items():
        files_by_cluster[iss] = cluster_files(entry['commits'], repo_path)
    links = cluster_links(files_by_cluster)

    rows = []
    for iss, entry in sorted(clusters.items()):
        meta = issues.get(iss) or {}
        title = meta.get('title', '')
        state = meta.get('state', '')
        mixed = cluster_is_mixed(entry['commits'])
        rows.append({
            'cluster': iss,
            'title': title,
            'state': state,
            'fix_titled': bool(FIX_TITLE_RE.match(title or '')),
            'kind': 'MIXED' if mixed else 'PURE',
            'commits': len(entry['commits']),
            'files': len(files_by_cluster.get(iss, ())),
            'linked': links.get(iss, []),
            'shas': [c.get('short_sha', '') for c in entry['commits']],
        })

    # The gate's view (owner rule 2026-09-26): the set is the issue UNION its
    # DIRECT gh relatives, and the file leg stays 1-hop.
    #
    # CORRECTION to the report that prompted this: the old `- {r['cluster']}`
    # removed NOTHING -- `cluster_links` skips self, and 0 of 167 rows carried
    # the cluster in its own `linked`. The real gap was that `held` never
    # consulted the OWN issue's state, so an open own-issue with no open
    # file-linked sibling read as FREE (measured: #458, #513, #593).
    # BOTH legs key on READINESS (owner order 2026-09-26). Measured: fixing
    # only the gh leg leaves 56 of 58 held, because the FILE leg is the dominant
    # hold (55 of 58) -- so a one-leg change would have looked like a fix while
    # the deadlock stood.
    open_fix = {r['cluster'] for r in rows if r['state'] == 'open' and r['fix_titled']}
    _mock_rel = os.environ.get('OC_HARVEST_MOCK_RELATIONS')
    _by_iss = build_commits_by_issue(commits)
    for r in rows:
        r['linked_open_fix'] = sorted(set(r['linked']) & open_fix)
        r['linked_unready'] = sorted(
            m for m in r['linked_open_fix']
            if not member_ready(m, _by_iss, repo_path, swaps, st_dir)[0])
        r['own_open'] = (r['state'] == 'open')
        r['own_ready'] = member_ready(r['cluster'], _by_iss, repo_path, swaps, st_dir)[0]
        r['set_members'] = None
        r['set_open_relatives'] = []
        r['set_unreadable'] = False
        r['set_clock_age_h'] = None
        r['set_clock_state'] = 'not computed (--clock not passed)' if not clock_on else None
        r['held'] = bool(r['linked_unready'])

    # The gh leg of the union -- evaluated for the CANDIDATES only, so the cost
    # is bounded by the open fix-titled population rather than every cluster.
    # A relative whose state is not in the batched fork map is UNREADABLE, never
    # assumed open: on a hold predicate an unknown silently inflates the count.
    for r in rows:
        if r['cluster'] not in open_fix:
            continue
        _members, _ok = cluster_set(r['cluster'], 'leshchenko1979/opencrabs', _mock_rel)
        r['set_members'] = sorted(_members)
        if not _ok:
            r['set_unreadable'] = True
            continue
        _unreadyrel = []
        for _m in sorted(_members):
            if _m == r['cluster']:
                continue  # the target never gates its own set (HQ n=11674)
            _meta = issues.get(_m)
            if _meta is None:
                r['set_unreadable'] = True
                continue
            _rdy, _why = member_ready(_m, _by_iss, repo_path, swaps, st_dir)
            if not _rdy:
                _unreadyrel.append({'issue': _m, 'state': _meta.get('state') or '?',
                                    'why': _why})
        r['set_open_relatives'] = [d['issue'] for d in _unreadyrel]
        r['set_unready_relatives'] = _unreadyrel
        if _unreadyrel:
            r['held'] = True

    if clock_on:
        for r in rows:
            if r['set_members'] is None:
                r['set_clock_state'] = 'not evaluated (not an open fix-titled candidate)'
                continue
            _anchor, _age, _scanned, _asha = set_soak_clock(
                [m for m in r['set_members'] if m != r['cluster']],
                _by_iss, repo_path, swaps, now_ts, state_dir=st_dir)
            if _age is None:
                r['set_clock_state'] = ('UNRESOLVABLE (%d commit(s) scanned, no deploy '
                                        'anchor) -- not "fresh", not clearance' % _scanned)
            else:
                r['set_clock_age_h'] = round(_age, 1)
                r['set_clock_state'] = ('ready (youngest swap %.1fh >= 24h)' % _age
                                        if _age >= oc_claims.SOAK_HOURS
                                        else 'HELD_SET_SOAK (youngest swap %.1fh < 24h, anchor %s)'
                                             % (_age, _asha[:9]))

    summary = {
        'clusters': len(rows),
        'open_fix_titled': sum(1 for r in rows if r['state'] == 'open' and r['fix_titled']),
        'pure': sum(1 for r in rows if r['kind'] == 'PURE'),
        'mixed': sum(1 for r in rows if r['kind'] == 'MIXED'),
        'unclustered_commits': len(unclustered),
        'ahead_commits': len(commits),
        'issues_unresolved': sum(1 for r in rows if not r['title']),
        'held': sum(1 for r in rows if r['held']),
        # The number the GATE acts on: held among the open fix-titled candidates.
        'held_open_fix_titled': sum(1 for r in rows
                                    if r['held'] and r['state'] == 'open' and r['fix_titled']),
        'held_by_own_issue': sum(1 for r in rows if r['own_open'] and not r['linked_unready']),
        'own_ready': sum(1 for r in rows if r.get('own_ready')),
        'linked_unready_total': sum(1 for r in rows if r['linked_unready']),
        'held_by_gh_relative': sum(1 for r in rows if r['set_open_relatives']),
        'set_relations_unreadable': sum(1 for r in rows if r['set_unreadable']),
        'set_clock': ('computed' if clock_on else 'NOT computed (--clock not passed)'),
    }

    shown = [r for r in rows if r['state'] == 'open' and r['fix_titled']] if open_fix_only else rows

    if as_json:
        print(json.dumps({
            'summary': summary,
            'clusters': shown,
            'unclustered': [c.get('short_sha', '') for c in unclustered],
        }, indent=2))
    else:
        print('=== Issue Clusters ===')
        print('  ahead commits: %d   clusters: %d   unclustered commits: %d'
              % (summary['ahead_commits'], summary['clusters'], summary['unclustered_commits']))
        print('  open fix-titled: %d   PURE: %d   MIXED: %d   issue lookup missed: %d'
              % (summary['open_fix_titled'], summary['pure'], summary['mixed'],
                 summary['issues_unresolved']))
        print('  HELD: %d of %d open fix-titled  (file-linked unready: %d, unready gh relative: %d)   set clock: %s'
              % (summary['held_open_fix_titled'], summary['open_fix_titled'],
                 summary['linked_unready_total'],
                 summary['held_by_gh_relative'], summary['set_clock']))
        if open_fix_only:
            print('  (--open-fix: showing only open fix-titled clusters)')
        print('')
        for r in shown:
            mark = ' [open fix]' if (r['state'] == 'open' and r['fix_titled']) else ''
            print('CLUSTER #%-4d%s %s  commits=%d files=%d' % (
                r['cluster'], mark, r['kind'], r['commits'], r['files']))
            print('  %s' % (r['title'] or '(issue not resolvable on the fork)'))
            if r['held']:
                _why = []
                if r['own_open']:
                    _why.append('own issue OPEN')
                if r['linked_open_fix']:
                    _why.append('file-linked open fix: %s'
                                % ', '.join('#%d' % n for n in r['linked_open_fix']))
                if r['set_open_relatives']:
                    _why.append('open gh relative: %s'
                                % ', '.join('#%d' % n for n in r['set_open_relatives']))
                print('  HELD: %s' % '; '.join(_why))
            if r['set_unreadable']:
                print('  set relations UNREADABLE for a member -- the set verdict is '
                      'INCOMPLETE, never a clean one')
            if r['set_clock_state']:
                print('  set soak clock: %s' % r['set_clock_state'])
            if r['linked_open_fix']:
                print('  linked open fix-type (file graph): %s'
                      % ', '.join('#%d' % n for n in r['linked_open_fix']))
            elif r['linked']:
                print('  linked (file graph, not open fix-type): %s'
                      % ', '.join('#%d' % n for n in r['linked']))
    sys.exit(0)

elif action in ('scan', 'sync'):
    as_json = '--json' in sys.argv
    commits = get_ahead_commits(repo_path, mock_commits)
    
    unharvested = []
    covered = []
    for c in commits:
        # #369: canonical parse (fork space only, comma multi-refs, explicit
        # `#N` subject fallback). The PR map is keyed by ONE issue, so the
        # pick is deterministic: the lowest number the commit anchors to.
        _refs = oc_claims.commit_issue_refs(c.get('trailer', ''), c.get('subject', ''))
        iss = min(_refs) if _refs else None
        
        pr_info = issue_map.get(iss) if iss else None
        if pr_info:
            c['upstream_pr'] = pr_info['pr']
            c['upstream_state'] = pr_info['state']
            covered.append(c)
        else:
            unharvested.append(c)
            
    summary = {
        'upstream_open_prs': [p for p in pr_entries if p['state'] == 'OPEN'],
        'upstream_merged_prs': [p for p in pr_entries if p['state'] == 'MERGED'],
        'unharvested_commits': unharvested,
        'covered_commits': covered,
        'mapped_issues': len(issue_map)
    }

    if action == 'sync' or (action == 'scan' and registry_file):
        os.makedirs(os.path.dirname(os.path.abspath(registry_file)), exist_ok=True)
        merged = {}
        if os.path.exists(registry_file):
            try:
                with open(registry_file) as f:
                    loaded = json.load(f)
                if isinstance(loaded, dict):
                    merged = loaded
            except Exception:
                merged = {}
        merged['prs'] = prs
        merged['summary'] = summary
        with open(registry_file, 'w') as f:
            json.dump(merged, f, indent=2)

    if as_json:
        print(json.dumps(summary, indent=2))
    else:
        open_prs = summary['upstream_open_prs']
        print(f'=== Upstream In-Flight PRs ({len(open_prs)} open) ===')
        for p in open_prs:
            iss_first = p['issues'][0] if p['issues'] else None
            issues_str = f' [#{iss_first}]' if iss_first is not None else ''
            pr_num = p['pr']
            head_ref = p['head']
            title_part = p['title'][:50]
            print(f'  PR #{pr_num:<4d} {head_ref:<40s}{issues_str} - {title_part}')
        
        print(f'\n=== Ahead Commits Classification ===')
        print(f'  Total Ahead: {len(commits)} commits')
        print(f'  Covered by PRs: {len(covered)} commits')
        print(f'  Unharvested: {len(unharvested)} commits')
        
        if unharvested:
            print('\n=== Unharvested Ahead Candidates (sample) ===')
            for c in unharvested[:10]:
                c_sha = c['short_sha']
                c_sub = c['subject'][:65]
                print(f'  {c_sha} {c_sub}')
    sys.exit(0)
OCPY
}

# --- Subcommand Handlers ---

cmd_scan() {
  local json_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --upstream) UPSTREAM_REPO="$2"; shift 2 ;;
      --json) json_flag="--json"; shift ;;
      *) usage ;;
    esac
  done
  run_engine "scan" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" "" $json_flag
}

cmd_check() {
  local target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --subject) DECLARED_SUBJECT="$2"; shift 2 ;;
      -h|--help) usage 0 ;;
      -*) usage ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
          shift
        else
          usage
        fi
        ;;
    esac
  done
  if [ -z "$target" ]; then
    usage
  fi
  run_engine "check" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" "$target" "$DECLARED_SUBJECT"
}

cmd_record() {
  local unit="" pr="" issue="" issues_str="" status="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --unit) unit="$2"; shift 2 ;;
      --state-file) REGISTRY_FILE="$2"; shift 2 ;;
      --pr) pr="$2"; shift 2 ;;
      --issue) issue="$2"; shift 2 ;;
      --issues) issues_str="$2"; shift 2 ;;
      --status) status="$2"; shift 2 ;;
      --reason) reason="$2"; shift 2 ;;
      --repo) REPO="$2"; shift 2 ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  if [ -z "$unit" ]; then
    usage
  fi
  # #564: a NOT-UPSTREAMABLE record has no PR to name -- demanding one is what
  # forced the upstream-issue number into the pr field in the first place. Only
  # the `filed` arm requires a PR number.
  if [ -z "$status" ]; then
    status="filed"
  fi
  if [ "$status" = "filed" ] && [ -z "$pr" ]; then
    usage
  fi
  if [ -z "$pr" ]; then
    pr=0
  fi
  if [ -f "$REGISTRY_FILE" ]; then
    python3 -c '
import sys, json, os, datetime, re
reg_file, unit, pr, issue, issues_str = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
status, reason = sys.argv[6], sys.argv[7]
with open(reg_file) as f:
    data = json.load(f)
records = data.setdefault("manual_records", [])
all_issues = set()
if issue:
    all_issues.add(int(issue))
if issues_str:
    for m in re.finditer(r"\d+", issues_str):
        all_issues.add(int(m.group(0)))

record_entry = {
    "unit": unit,
    "pr": int(pr),
    "issue": int(issue) if issue else (sorted(list(all_issues))[0] if all_issues else None),
    "issues": sorted(list(all_issues)),
    "recorded_at": datetime.datetime.now(datetime.timezone.utc).isoformat()
}
# #564: the status vocabulary is written ONLY when it carries information, so a
# plain `filed` row keeps the pre-schema shape exactly and nothing downstream
# has to know the field exists.
if status and status != "filed":
    record_entry["status"] = status
if reason:
    record_entry["reason"] = reason
# Idempotent upsert keyed on (unit, pr, issue): re-recording the same unit
# updates the existing entry instead of appending a duplicate (#325).
key = (record_entry["unit"], record_entry["pr"], record_entry["issue"])
replaced = 0
for i, existing in enumerate(records):
    if (existing.get("unit"), existing.get("pr"), existing.get("issue")) == key:
        # #564: the upsert REPLACES the whole row, so a re-record without --status
        # would silently DROP a status a prior lane set -- the same shape as the
        # old "write-only, dumps a two-key dict, erases manual_records" defect.
        # Carry the prior values forward when this call does not supply them.
        if "status" not in record_entry and existing.get("status"):
            record_entry["status"] = existing["status"]
        if "reason" not in record_entry and existing.get("reason"):
            record_entry["reason"] = existing["reason"]
        records[i] = record_entry
        replaced = 1
        break
if not replaced:
    records.append(record_entry)
with open(reg_file, "w") as f:
    json.dump(data, f, indent=2)
verb = "Updated" if replaced else "Recorded"
_what = ("NOT UPSTREAMABLE" if status == "not-upstreamable"
         else ("PR #%s" % pr if int(pr) else "NO PR recorded"))
print(f"{verb} Unit {unit} -> {_what} (issues: {sorted(list(all_issues))}) in {reg_file}")
' "$REGISTRY_FILE" "$unit" "$pr" "$issue" "$issues_str" "$status" "$reason"
  else
    echo "Recorded Unit $unit -> PR #$pr (registry uninitialized)"
  fi
  exit 0
}

cmd_sync() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --upstream) UPSTREAM_REPO="$2"; shift 2 ;;
      --state-file) REGISTRY_FILE="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  run_engine "sync" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" ""
}

cmd_purge() {
  local unit="" pr="" issue="" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --unit) unit="$2"; shift 2 ;;
      --pr) pr="$2"; shift 2 ;;
      --issue) issue="$2"; shift 2 ;;
      --state-file) REGISTRY_FILE="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  if [ -z "$unit" ]; then
    usage
  fi
  if [ ! -f "$REGISTRY_FILE" ]; then
    echo "Purge: registry uninitialized ($REGISTRY_FILE) - nothing to purge"
    exit 0
  fi
  python3 - "$REGISTRY_FILE" "$unit" "$pr" "$issue" "$dry_run" <<'OCPY'
import sys, json
reg_file, unit, pr_s, issue_s, dry_s = sys.argv[1:6]
with open(reg_file) as f:
    data = json.load(f)
records = data.get("manual_records", [])
pr = int(pr_s) if pr_s else None
issue = int(issue_s) if issue_s else None

def matches(r):
    if r.get("unit") != unit:
        return False
    if pr is not None and r.get("pr") != pr:
        return False
    if issue is not None and r.get("issue") != issue and issue not in (r.get("issues") or []):
        return False
    return True

kept, removed = [], []
for r in records:
    (removed if matches(r) else kept).append(r)

for r in removed:
    print("  - unit=%s pr=%s issue=%s recorded_at=%s" % (r.get("unit"), r.get("pr"), r.get("issue"), r.get("recorded_at")))
if dry_s == "1":
    print("DRY-RUN: %d of %d manual_records would be purged (unit=%s)" % (len(removed), len(records), unit))
    sys.exit(0)
data["manual_records"] = kept
with open(reg_file, "w") as f:
    json.dump(data, f, indent=2)
print("Purged %d of %d manual_records (unit=%s) in %s" % (len(removed), len(records), unit, reg_file))
OCPY
  exit 0
}

