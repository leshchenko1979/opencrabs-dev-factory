    echo "  bad  - multi-leg NOTE control: $_nref REFUSED line(s), qualifier '$_nnote', got rc=$rc"
    return 1
  fi

  # 3d5. HOLDER LIVENESS NOTE (#534): the fence remains rc=1 for both a live
  #     and dormant holder; a fixture DB controls updated_at and the dormant
  #     arm must expose age plus DORMANT rather than silently clearing.
  local mock_live_db="$selftest_tmp/mock_sessions_live.db"
  local mock_dormant_db="$selftest_tmp/mock_sessions_dormant.db"
  python3 -c 'import sqlite3,sys; db=sys.argv[1]; now=int(sys.argv[2]); con=sqlite3.connect(db); con.execute("create table sessions (id text, updated_at integer)"); con.execute("insert into sessions values (?,?)", (sys.argv[3], now-int(sys.argv[4]))); con.commit(); con.close()' "$mock_live_db" "$OC_HARVEST_NOW_TS" "11111111-2222-3333-4444-555555555555" 3600
  python3 -c 'import sqlite3,sys; db=sys.argv[1]; now=int(sys.argv[2]); con=sqlite3.connect(db); con.execute("create table sessions (id text, updated_at integer)"); con.execute("insert into sessions values (?,?)", (sys.argv[3], now-int(sys.argv[4]))); con.commit(); con.close()' "$mock_dormant_db" "$OC_HARVEST_NOW_TS" "11111111-2222-3333-4444-555555555555" $((3*24*3600))
  export OC_LEDGER_DB="$mock_live_db"
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && grep -q 'holder_age=1.0h' <<< "$out" \
     && ! oc_has "$out" 'DORMANT'; then
    ok "live holder fence reports age without DORMANT"
  else
    echo "  bad  - live holder expected rc=1 with age and no DORMANT, got rc=$rc ($out)"
    return 1
  fi
  export OC_LEDGER_DB="$mock_dormant_db"
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'DORMANT' \
     && oc_has "$out" 'review/release dormant holder claim'; then
    ok "dormant holder fence remains refusal with advisory"
  else
    echo "  bad  - dormant holder expected rc=1 with DORMANT advisory, got rc=$rc ($out)"
    return 1
  fi

  unset OC_LEDGER_DB
  # 3d6. MUTUAL CYCLE NOTE + PRECEDENCE (#535): when the target's OWN claim
  #     overlaps a foreign claim on the same substantive file, the refusal set
  #     must name the cycle and state the deterministic precedence rule.
  #     CONTROL: a target with no own claim (#400, soak-only) prints no cycle NOTE.
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] \
     && oc_has "$out" 'mutual in-flight cycle #500 <-> #600' \
     && oc_has "$out" 'older claim #500 keeps, newer yields'; then
    ok "mutual cycle named with deterministic precedence (#535)"
  else
    echo "  bad  - cycle note expected rc=1 with cycle + precedence, got rc=$rc ($out)"
    return 1
  fi
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "400" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && ! oc_has "$out" 'mutual in-flight cycle'; then
    ok "no cycle note without an own claim (control for #535)"
  else
    echo "  bad  - control expected rc=1 and no cycle note, got rc=$rc ($out)"
    return 1
  fi

  # 3d7. LEG (v): RE-VALIDATE THE CLAIM'S OWN RECORDED BLOCKER (#536).
  #      Legs (i)-(iv) bound WHEN a claim was filed and HOW cycles resolve, but
  #      none reads the claim's OWN reason, so a claim whose blocker expired
  #      still fences exactly as though live (#443: all four commits were
  #      ancestors of origin/main and origin/main == deployed.sha BEFORE the
  #      release ruling). CLOSED SET of blocker TYPES only, reported as a NOTE
  #      beside the fence; an unresolvable input prints the SKIP DISCLOSURE
  #      rather than a clean result.
  #
  #      Own ledger so the #533 full-fence-set leg keeps its exact claim count.
  local mock_ledger_blocker="$selftest_tmp/mock_ledger_blocker.json"
  local plan_dir="$selftest_tmp/plans"
  mkdir -p "$plan_dir"
  # A real git repo: the flight arm asks whether the named paths moved on
  # origin/main, which no synthetic commit dict can answer.
  local blocker_repo="$selftest_tmp/blocker_repo"
  mkdir -p "$blocker_repo/src/active"
  git -C "$blocker_repo" init -q
  git -C "$blocker_repo" config user.name fixture
  git -C "$blocker_repo" config user.email fixture@example.invalid
  git -C "$blocker_repo" config commit.gpgsign false
  printf 'pub fn lane_fn() -> u8 {\n    1\n}\n' > "$blocker_repo/src/active/lane.rs"
  git -C "$blocker_repo" add -A
  git -C "$blocker_repo" commit -q -m "base"
  git -C "$blocker_repo" update-ref refs/remotes/origin/main "$(git -C "$blocker_repo" rev-parse HEAD)"

  # --- design-gate arm: plan still approved_at=null -> blocker HOLDS ---
  printf '{"status":"Editing","approved_at":null,"tasks":[]}\n' \
    > "$plan_dir/.opencrabs_plan_aaaa1111-bbbb-4ccc-8ddd-eeeeeeeeeeee.json"
  cat << 'BLKEOF' > "$mock_ledger_blocker"
{"events":[
 {"n":200,"kind":"claim","by":"editor 77777777-8888-9999-aaaa-bbbbbbbbbbbb",
  "what":"CLAIM #610 — DESIGN-GATED: parked on owner approval, design published in session plan aaaa1111",
  "t":"2026-09-01T00:00:00Z","files":["src/active/lane.rs"]}
]}
BLKEOF
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_blocker" OC_PLAN_DIRS="$plan_dir" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'blocker holds'; then
    ok "leg (v) design-gate: plan approved_at=null -> blocker holds NOTE (#536)"
  else
    echo "  bad  - leg (v) design-gate hold expected rc=1 + 'blocker holds', got rc=$rc ($out)"
    return 1
  fi

  # --- design-gate arm: plan now APPROVED -> recorded blocker EXPIRED ---
  printf '{"status":"Active","approved_at":"2026-09-23T00:00:00Z","tasks":[]}\n' \
    > "$plan_dir/.opencrabs_plan_aaaa1111-bbbb-4ccc-8ddd-eeeeeeeeeeee.json"
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_blocker" OC_PLAN_DIRS="$plan_dir" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'recorded blocker has EXPIRED'; then
    ok "leg (v) design-gate: plan approved -> blocker EXPIRED note, rc STILL 1 (#536)"
  else
    echo "  bad  - leg (v) expired design gate expected rc=1 + EXPIRED, got rc=$rc ($out)"
    return 1
  fi

  # --- code-in-flight arm: named paths DID move on origin/main since the claim ---
  local mock_ledger_flight="$selftest_tmp/mock_ledger_flight.json"
  cat << 'FLTEOF' > "$mock_ledger_flight"
{"events":[
 {"n":210,"kind":"claim","by":"editor 77777777-8888-9999-aaaa-bbbbbbbbbbbb",
  "what":"CLAIM #611 — fix in flight: the fix lands next cycle",
  "t":"2020-01-01T00:00:00Z","files":["src/active/lane.rs"]}
]}
FLTEOF
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_flight" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'blocker may have EXPIRED'; then
    ok "leg (v) code-in-flight: paths moved on origin/main -> may-EXPIRED note (#536)"
  else
    echo "  bad  - leg (v) flight-touched expected rc=1 + may-EXPIRED, got rc=$rc ($out)"
    return 1
  fi

  # --- code-in-flight CONTROL: paths did NOT move since the claim -> holds ---
  local mock_ledger_flight2="$selftest_tmp/mock_ledger_flight2.json"
  cat << 'FLT2EOF' > "$mock_ledger_flight2"
{"events":[
 {"n":211,"kind":"claim","by":"editor 77777777-8888-9999-aaaa-bbbbbbbbbbbb",
  "what":"CLAIM #611 — fix in flight: the fix lands next cycle",
  "t":"2099-01-01T00:00:00Z","files":["src/active/lane.rs"]}
]}
FLT2EOF
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_flight2" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'blocker holds'; then
    ok "leg (v) code-in-flight control: no movement -> blocker holds (#536)"
  else
    echo "  bad  - leg (v) flight-untouched expected rc=1 + holds, got rc=$rc ($out)"
    return 1
  fi

  # --- SKIP DISCLOSURE: design-gated with no plan reference ---
  local mock_ledger_skip="$selftest_tmp/mock_ledger_skip.json"
  cat << 'SKPEOF' > "$mock_ledger_skip"
{"events":[
 {"n":220,"kind":"claim","by":"editor 77777777-8888-9999-aaaa-bbbbbbbbbbbb",
  "what":"CLAIM #612 — DESIGN-GATED per owner order; shape depends on his call",
  "t":"2026-09-01T00:00:00Z","files":["src/active/lane.rs"]}
]}
SKPEOF
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_skip" OC_PLAN_DIRS="$plan_dir" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'blocker NOT re-validated (skip)'; then
    ok "leg (v) unparseable blocker prints the SKIP DISCLOSURE, not a clean result (#536)"
  else
    echo "  bad  - leg (v) skip disclosure expected rc=1 + skip text, got rc=$rc ($out)"
    return 1
  fi

  # --- SKIP DISCLOSURE: in-flight with NO filing time (unbounded window) ---
  local mock_ledger_noflux="$selftest_tmp/mock_ledger_noflux.json"
  cat << 'NOTEOF' > "$mock_ledger_noflux"
{"events":[
 {"n":221,"kind":"claim","by":"editor 77777777-8888-9999-aaaa-bbbbbbbbbbbb",
  "what":"CLAIM #613 — fix in flight, no timestamp recorded",
  "files":["src/active/lane.rs"]}
]}
NOTEOF
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_noflux" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "500" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" 'records no filing time'; then
    ok "leg (v) in-flight without a filing time -> skip, never an unbounded window (#536)"
  else
    echo "  bad  - leg (v) no-filing-time expected rc=1 + skip text, got rc=$rc ($out)"
    return 1
  fi

  # --- AC3: a blocker-bearing claim that is NOT fencing prints NO note at all ---
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_blocker" OC_PLAN_DIRS="$plan_dir" \
        run_engine "check" "mock/repo" "$blocker_repo" "$mock_reg" "400" 2>&1)" || rc=$?
  if ! oc_has "$out" 'NOTE(blocker)'; then
    ok "leg (v) note appears ONLY beside its own fence (no fence -> no note) (#536)"
  else
    echo "  bad  - leg (v) blocker note printed without a fence ($out)"
    return 1
  fi

  # 3e. PROSE-ONLY NEGATIVE CONTROL (#307) -> must NOT fence, exits 0 ELIGIBLE.
  #     prose mention of #700 exists. The anchored resolver returns an EMPTY
  #     footprint — a real answer, not a gap — so the fence cannot fire.
  #     MUTATION GUARD: regress the footprint to the old unanchored
  #     `git log -n 10 --grep=#N` and this case turns HELD_IN_FLIGHT_LANE and
  #     fails the selftest. That is what makes it a control, not a smoke.
  #     ARGV ORDER IS LOAD-BEARING: run_engine is `python3 - "$@"`, so argv[2]
  #     is the UPSTREAM repo and argv[3] is the repo whose history the claim
  #     footprint resolves against. This leg originally passed $prose_repo into
  #     argv[2] and $selftest_tmp into argv[3] — a non-git directory — so the
  #     resolver answered [] for BOTH the anchored and the unanchored matcher
  #     and the case passed vacuously. The mutation guard caught it: census
  #     stayed green under a reverted matcher while dispatch went red.
  local prose_repo="$selftest_tmp/prose_repo"
  local mock_ledger_prose="$selftest_tmp/mock_ledger_prose.json"
  local mock_commits_prose="$selftest_tmp/mock_commits_prose.json"
  mkdir -p "$prose_repo/src/prose"
  printf 'x\n' > "$prose_repo/src/prose/target.rs"
  git -C "$prose_repo" init -q 2>/dev/null
  git -C "$prose_repo" config user.email selftest@local
  git -C "$prose_repo" config user.name selftest
  git -C "$prose_repo" add -A 2>/dev/null
  git -C "$prose_repo" commit -q -m "fix(unrelated): reword the note (#700)" 2>/dev/null
  cat << 'PROSEEOF' > "$mock_ledger_prose"
{"events":[{"n":1,"kind":"claim","by":"editor 99999999-8888-7777-6666-555555555555","what":"CLAIM #700 active lane work"}]}
PROSEEOF
  cat << 'PROSEEOF' > "$mock_commits_prose"
[{"sha":"aaaaaaa700000000000000000000000000000000","short_sha":"aaaaaaa","subject":"fix(prose-control): candidate touching the prose file (#701)","trailer":"leshchenko1979/opencrabs#701","commit_ts":100000,"files":["src/prose/target.rs"]}]
PROSEEOF
  rc=0
  out="$(OC_HARVEST_MOCK_LEDGER="$mock_ledger_prose" OC_HARVEST_MOCK_COMMITS="$mock_commits_prose" run_engine "check" "mock/repo" "$prose_repo" "$mock_reg" "701" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "prose-only mention does NOT fence a no-files claim (#307 negative control)"
  else
    echo "  bad  - prose-only mention must NOT fence, got rc=$rc ($out)"
    return 1
  fi

  # 4. Check on CLOSED issue (#111) -> exits 0 ELIGIBLE_REWORK
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "111" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE_REWORK"; then
    ok "check closed unit -> ELIGIBLE_REWORK exit 0"
  else
    echo "  bad  - check closed unit expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 5. Usage error on missing target -> exits 2
  rc=0
  bash "$0" check >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ]; then
    ok "check without args -> usage exit 2"
  else
    echo "  bad  - check without args expected rc=2, got rc=$rc"
    return 1
  fi

  # 6. Scan outputs clean summary
  rc=0
  out="$(run_engine "scan" "mock/repo" "$selftest_tmp" "$mock_reg" "" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "Upstream In-Flight PRs (1 open)"; then
    ok "scan classified output clean"
  else
    echo "  bad  - scan expected rc=0 with classified output, got rc=$rc ($out)"
    return 1
  fi

  # 7. Record + Sync preservation. Hermetic: the record case MUST target the
  # sandbox registry. It previously ran the CLI wrapper with no --state-file, so
  # it wrote a fixture row into the LIVE production registry on every battery run
  # (#325): 189 of 239 manual_records were this fixture. The fixture also now uses
  # a non-existent sentinel PR/issue — the old values (PR 1500 MERGED, fork issue
  # 199) collided with real artifacts, so a leak would shadow them.
  rc=0
  bash "$0" record --unit "test-unit" --pr "999999" --issue "999999" --state-file "$mock_reg" >/dev/null 2>&1 || rc=$?
  if [ -f "$mock_reg" ] && grep -q "test-unit" "$mock_reg"; then
    ok "registry write preserves manual_records (no clobber)"
  else
    echo "  bad  - registry write did not record test-unit"
    return 1
  fi

  # 8. Check consults manual records
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "test-unit" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "manually recorded as filed in PR #999999"; then
    ok "check consults manual records -> REFUSED exit 1"
  else
    echo "  bad  - check manual records expected rc=1, got rc=$rc ($out)"
    return 1
  fi

  # 9. Unrelated target still ELIGIBLE with manual records
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "200" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "unrelated target still ELIGIBLE with manual records present"
  else
    echo "  bad  - unrelated target expected rc=0 ELIGIBLE, got rc=$rc ($out)"
    return 1
  fi

  # 9b. #564: a row marked NOT UPSTREAMABLE says so and carries its reason --
  #     instead of the old emission, which rendered the record's `pr` field as a
  #     filing. Live instance: unit restore-append-at-end-mig carries pr=1510,
  #     which is an upstream ISSUE (pulls/1510 -> 404), and the census reported
  #     "filed in PR #1510" while ledger n=6231 records the OPPOSITE decision
  #     ("not upstreamable"). The row is written through the CLI on purpose, so
  #     the new --status/--reason flags are exercised by the same leg.
  local nu_reg="$selftest_tmp/mock_reg_notup.json"
  printf '{"manual_records": []}\n' > "$nu_reg"
  rc=0
  bash "$0" record --unit "not-up-unit" --status not-upstreamable \
      --reason "already carried upstream in issue 1510" --issue "999998" \
      --state-file "$nu_reg" >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    ok "#564 record accepts --status not-upstreamable WITHOUT --pr"
  else
    echo "  bad  - #564 not-upstreamable record expected rc=0 without --pr, got rc=$rc"
    return 1
  fi
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$nu_reg" "not-up-unit" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "manually recorded as NOT UPSTREAMABLE" && oc_has "$out" "already carried upstream in issue 1510"; then
    ok "#564 a not-upstreamable record refuses AS not-upstreamable, carrying its reason"
  else
    echo "  bad  - #564 expected rc=1 NOT UPSTREAMABLE + reason, got rc=$rc ($out)"
    return 1
  fi
  if oc_has "$out" "filed in PR"; then
    echo "  bad  - #564 still emits a false 'filed in PR' claim for a not-upstreamable row: $out"
    return 1
  fi
  ok "#564 a not-upstreamable row emits NO 'filed in PR' claim"

  # 9c. #564: a row whose pr is falsy must not be reported as a filing either.
  #     Three live rows carry pr:0 and the old emission rendered them as
  #     "manually recorded as filed in PR #0" -- a statement about the world
  #     that is false. The honest arm names the gap instead.
  bash "$0" record --unit "no-pr-unit" --pr 0 --status filed --issue "999997" \
      --state-file "$nu_reg" >/dev/null 2>&1
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$nu_reg" "no-pr-unit" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "manually recorded with NO PR number recorded"; then
    ok "#564 a row with no PR number refuses honestly instead of claiming PR #0"
  else
    echo "  bad  - #564 expected rc=1 'NO PR number recorded', got rc=$rc ($out)"
    return 1
  fi
  if oc_has "$out" "filed in PR #0"; then
    echo "  bad  - #564 emitted the false 'filed in PR #0' claim: $out"
    return 1
  fi
  ok "#564 no false 'filed in PR #0' claim"

  # 9d. #564: `filed` still REQUIRES a PR number -- relaxing that would let a
  #     filing record exist with nothing to look up, which is how the pr field
  #     came to hold an issue number in the first place.
  rc=0
  bash "$0" record --unit "filed-no-pr" --issue "999996" --state-file "$nu_reg" >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 2 ]; then
    ok "#564 status=filed still requires --pr (usage rc 2)"
  else
    echo "  bad  - #564 filed-without-pr expected rc=2 usage, got rc=$rc"
    return 1
  fi

  # 9e. #564: the upsert REPLACES the whole row, so a re-record without --status
  #     would silently DROP a status a prior lane set -- the same shape as the
  #     old "write-only, dumps a two-key dict, erases manual_records" defect.
  bash "$0" record --unit "not-up-unit" --pr 0 --issue "999998" --state-file "$nu_reg" >/dev/null 2>&1
  if python3 -c '
import json, sys
recs = json.load(open(sys.argv[1]))["manual_records"]
row = [r for r in recs if r.get("unit") == "not-up-unit"]
sys.exit(0 if row and row[0].get("status") == "not-upstreamable" else 1)
' "$nu_reg"; then
    ok "#564 a re-record without --status PRESERVES the prior status"
  else
    echo "  bad  - #564 re-record dropped the not-upstreamable status"
    return 1
  fi

  # 10. SHA prefix lookup tests
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "8888888" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "within 24h feature soak window"; then
    ok "sha lookup for fresh feature -> REFUSED 24h soak exit 1"
  else
    echo "  bad  - sha lookup for fresh feature expected rc=1 soak, got rc=$rc ($out)"
    return 1
  fi

  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "9999999" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "sha lookup for mature feature -> ELIGIBLE exit 0"
  else
    echo "  bad  - sha lookup for mature feature expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 11. Closed PR rework for fresh feature
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "112" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "within 24h feature soak window"; then
    ok "closed PR fresh feature -> REFUSED 24h soak exit 1"
  else
    echo "  bad  - closed PR fresh feature expected rc=1 soak, got rc=$rc ($out)"
    return 1
  fi

  # 12. Closed PR that was squash-merged into upstream main (#133 / PR #1556) -> REFUSED MERGED exit 1
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "133" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "REFUSED: Target 133 is already MERGED upstream in PR #1556"; then
    ok "closed PR squash-merged upstream -> REFUSED MERGED exit 1"
  else
    echo "  bad  - closed PR squash-merged upstream expected rc=1 REFUSED MERGED, got rc=$rc ($out)"
    return 1
  fi

  # 13. #323: an issue number is NOT a sha prefix. Commit 262193f carries a
  # real issue-249 trailer; a query for issue 262 must not adopt it (the
  # reported defect: a bogus HELD_DEPENDENT_SOAK for a 3-digit target).
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "262" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "#323 issue number is not a sha prefix -> ELIGIBLE exit 0"
  else
    echo "  bad  - #323 sha-prefix collision expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 14. #323: an issue number is NOT a subject substring. The repo's own
  # swap-marker convention embeds an 8-hex fragment into the subject, so a bare
  # substring test answered a query for issue 192 with a marker for 24c192a5.
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "192" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "#323 issue number is not a subject substring -> ELIGIBLE exit 0"
  else
    echo "  bad  - #323 swap-marker subject collision expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 15. #323: a date stamp in the subject is not an issue reference.
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "202" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "#323 date stamp is not an issue reference -> ELIGIBLE exit 0"
  else
    echo "  bad  - #323 date-stamp subject collision expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 16. #323: a bare number in a trailer-less subject is not the commit's issue.
  # The trailer-less branch previously adopted the FIRST number anywhere in the
  # subject as that commit's issue, feeding matches_iss — the path behind BOTH
  # the manual-records gate and the 24h soak gate, so its blast radius exceeds
  # the sha and subject paths. A subject that merely mentions a number in prose
  # must not attribute the commit to that issue.
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "429" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "#323 prose numeral is not an issue reference -> ELIGIBLE exit 0"
  else
    echo "  bad  - #323 prose-numeral fallback collision expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 17. POSITIVE CONTROL for 13-16: an EXPLICIT #<n> citation must still match,
  # including the trailer-less fallback that adopted an arbitrary number before.
  # Without this control the cases above would pass equally if the matcher
  # had simply been disabled.
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "271" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "HELD_DEPENDENT_SOAK"; then
    ok "#323 explicit #n citation still matches -> HELD_DEPENDENT_SOAK exit 1"
  else
    echo "  bad  - positive control expected rc=1 HELD_DEPENDENT_SOAK, got rc=$rc ($out)"
    return 1
  fi

  # 22. purge --dry-run lists the fixture row but leaves the registry intact
  rc=0
  out="$(bash "$0" purge --unit "test-unit" --state-file "$mock_reg" --dry-run 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "DRY-RUN: 1 of 1" && grep -q "test-unit" "$mock_reg"; then
    ok "purge --dry-run reports without removing"
  else
    echo "  bad  - purge --dry-run expected rc=0 + intact registry, got rc=$rc ($out)"
    return 1
  fi

  # 23. purge removes the row; the manual-records gate stops refusing
  rc=0
  out="$(bash "$0" purge --unit "test-unit" --state-file "$mock_reg" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "Purged 1 of 1"; then
    ok "purge removes matching manual_records row"
  else
    echo "  bad  - purge expected rc=0 with 1 removed, got rc=$rc ($out)"
    return 1
  fi
  rc=0
  out="$(run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "test-unit" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    ok "purged row no longer refuses the target"
  else
    echo "  bad  - after purge expected rc=0, got rc=$rc ($out)"
    return 1
  fi

  # 24. record is idempotent: re-recording the same triple does not duplicate
  bash "$0" record --unit "dup-unit" --pr "424242" --issue "424242" --state-file "$mock_reg" >/dev/null 2>&1 || true
  bash "$0" record --unit "dup-unit" --pr "424242" --issue "424242" --state-file "$mock_reg" >/dev/null 2>&1 || true
  n="$(python3 -c 'import json,sys; print(sum(1 for r in json.load(open(sys.argv[1])).get("manual_records",[]) if r.get("unit")=="dup-unit"))' "$mock_reg" 2>/dev/null || echo 0)"
  if [ "$n" = "1" ]; then
    ok "record is idempotent (re-record updates, no duplicate)"
  else
    echo "  bad  - record idempotency expected 1 dup-unit row, got $n"
    return 1
  fi

  # 25. #365 class-2 sub-rule: a path introduced by an ALREADY-HARVESTED parent
  #     must NOT refuse HELD_PARENT_UNHARVESTED — the parent's subsystem is
  #     upstream, so the path falls through to the class-3 subject test (#341's
  #     live shape: validator deleted upstream by #148, its subsystem shipped).
  fx_harvested="$selftest_tmp/fx_harvested"
  build_gate4_fixture "$fx_harvested" harvested
  printf '{"manual_records": []}\n' > "$selftest_tmp/mock_reg_fx.json"
  rc=0
  # ENV LEAKAGE GUARD: this suite EXPORTS OC_HARVEST_MOCK_COMMITS and
  # _SQUASHED (see the export block above), and an exported mock COMMIT LIST
  # wins over the fixture repo inside get_ahead_commits. This case therefore
  # read the suite's synthetic commit list, found no #901 in it, and left
  # matching_commits EMPTY — so gate 4 was skipped outright: case 25 passed
  # VACUOUSLY and case 26 could never fail for the right reason. Blanking both
  # makes the engine read the fixture repo, which is what the case is about.
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_harvested" "$selftest_tmp/mock_reg_fx.json" "901" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE"; then
    ok "class-2 sub-rule: harvested parent falls through -> ELIGIBLE"
  else
    echo "  bad  - harvested-parent fixture expected rc=0 ELIGIBLE, got rc=$rc ($out)"
    return 1
  fi

  # 26. NEGATIVE CONTROL for 25: the same fixture with the parent's work landing
  #     ONLY in the fork-only symbol must still refuse — the sub-rule loosens
  #     nothing when the parent is genuinely unharvested.
  fx_unharvested="$selftest_tmp/fx_unharvested"
  build_gate4_fixture "$fx_unharvested" unharvested
  rc=0
  # ENV LEAKAGE GUARD: this suite EXPORTS OC_HARVEST_MOCK_COMMITS and
  # _SQUASHED (see the export block above), and an exported mock COMMIT LIST
  # wins over the fixture repo inside get_ahead_commits. This case therefore
  # read the suite's synthetic commit list, found no #901 in it, and left
  # matching_commits EMPTY — so gate 4 was skipped outright: case 25 passed
  # VACUOUSLY and case 26 could never fail for the right reason. Blanking both
  # makes the engine read the fixture repo, which is what the case is about.
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_unharvested" "$selftest_tmp/mock_reg_fx.json" "901" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "HELD_PARENT_UNHARVESTED"; then
    ok "class-2 sub-rule negative control: unharvested parent still REFUSED"
  else
    echo "  bad  - unharvested-parent fixture expected rc=1 HELD_PARENT_UNHARVESTED, got rc=$rc ($out)"
    return 1
  fi

  # --- #365 declared-subject fallback (cases 27-30) ---------------------------
  # The `nosym` shape derives NO symbol, so the class-3 refusal must decide from
  # a DECLARED subject instead of refusing outright. Four shapes: no declaration
  # (refuse), a Subject: TRAILER that greps upstream (fall through), the --subject
  # ARGUMENT doing the same, and a declaration that is NOT upstream (refuse --
  # the fallback may only ever loosen a refusal, never by default).
  #
  # ENV LEAKAGE GUARD (same reason as cases 25/26): the suite EXPORTS
  # OC_HARVEST_MOCK_COMMITS/_SQUASHED and an exported mock commit list wins over
  # the fixture repo, which would leave matching_commits EMPTY and skip gate 4
  # entirely -- the case would pass vacuously. Every leg blanks them.
  fx_nosym="$selftest_tmp/fx_nosym"
  build_gate4_fixture "$fx_nosym" nosym
  fx_nosym_subj="$selftest_tmp/fx_nosym_subj"
  build_gate4_fixture "$fx_nosym_subj" nosym "base_fn"

  # 27. AC1: no derivable symbol AND no declared subject -> still refuse.
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_nosym" "$selftest_tmp/mock_reg_fx.json" "902" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "UPSTREAM_VOID" && oc_has "$out" "no declared subject"; then
    ok "declared-subject fallback: no symbol + no declaration -> REFUSED"
  else
    echo "  bad  - nosym no-declaration expected rc=1 UPSTREAM_VOID, got rc=$rc ($out)"
    return 1
  fi

  # 28. AC2: a Subject: TRAILER on the target commit that greps upstream -> rc 0.
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_nosym_subj" "$selftest_tmp/mock_reg_fx.json" "902" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE" && oc_has "$out" "DECLARED subject"; then
    ok "declared-subject fallback: Subject: trailer present upstream -> ELIGIBLE"
  else
    echo "  bad  - nosym Subject-trailer expected rc=0 ELIGIBLE, got rc=$rc ($out)"
    return 1
  fi

  # 29. AC3: the same decision reached from the --subject ARGUMENT (argv[6]).
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_nosym" "$selftest_tmp/mock_reg_fx.json" "902" "base_fn" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE" && oc_has "$out" "DECLARED subject"; then
    ok "declared-subject fallback: --subject argument present upstream -> ELIGIBLE"
  else
    echo "  bad  - nosym --subject expected rc=0 ELIGIBLE, got rc=$rc ($out)"
    return 1
  fi

  # 30. NEGATIVE CONTROL for 28/29: a declaration that is NOT upstream must not
  #     loosen anything -- the fallback is fail-closed by construction.
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_nosym" "$selftest_tmp/mock_reg_fx.json" "902" "no_such_symbol_9f2a" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "not present in adolfousier/main"; then
    ok "declared-subject fallback negative control: absent declaration still REFUSED"
  else
    echo "  bad  - nosym absent-declaration expected rc=1, got rc=$rc ($out)"
    return 1
  fi

  # --- #365 shape regression (cases 31-32) ------------------------------------
  # Task 7's four shapes: the two below, plus the parent-harvested shape (case
  # 25) and the inconclusive shape (cases 27-30). Together they pin every branch
  # of gate 4: refuse on a fork-only subject, refuse on a held parent, fall
  # through on a harvested parent, fall through on an orphan path, and fall
  # through on a declared subject.

  # 31. #253 SHAPE: every touched FILE exists upstream, the subject SYMBOL does
  #     not -> refuse on POSITIVE evidence (case (a)).
  #     The negative leg asserts the message reads "tested fork_only_fn" and NOT
  #     "none derived". That is what separates case (a) (symbols were derived and
  #     every one is absent upstream -> refuse, fallback never consulted) from
  #     case (b) (nothing derivable -> the declared-subject fallback, cases
  #     27-30). A regression that stopped derive_symbols resolving the fork-only
  #     fn would slide this fixture into (b) and turn this leg RED while case 27
  #     stayed green.
  #     NOTE: an "orphan path" assertion would be VACUOUS here -- the class-3
  #     refusal exits at the subject test, before the file loop runs at all.
  fx_subj_absent="$selftest_tmp/fx_subj_absent"
  build_gate4_fixture "$fx_subj_absent" subject_absent
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_subj_absent" "$selftest_tmp/mock_reg_fx.json" "904" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "UPSTREAM_VOID: tested fork_only_fn" \
     && ! oc_has "$out" "none derived"; then
    ok "#253 shape: files upstream + subject absent -> REFUSED UPSTREAM_VOID (case (a))"
  else
    echo "  bad  - subject-absent fixture expected rc=1 UPSTREAM_VOID: tested fork_only_fn and NOT 'none derived', got rc=$rc ($out)"
    return 1
  fi

  # 32. #341 SHAPE: an orphan path AND an upstream-present subject -> the orphan
  #     is a non-blocking ADVISORY and the unit is ELIGIBLE. The negative leg
  #     pins that class 2 did NOT refuse a path whose add commit carries no
  #     Issue-Ref.
  fx_orphan_subj="$selftest_tmp/fx_orphan_subj"
  build_gate4_fixture "$fx_orphan_subj" orphan_subject
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_orphan_subj" "$selftest_tmp/mock_reg_fx.json" "905" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE" \
     && grep -q "ADVISORY: orphan path src/orphan_test.rs" <<< "$out" \
     && ! oc_has "$out" "HELD_PARENT_UNHARVESTED"; then
    ok "#341 shape: orphan path + subject upstream -> ELIGIBLE with orphan ADVISORY"
  else
    echo "  bad  - orphan-subject fixture expected rc=0 ELIGIBLE + orphan ADVISORY + no HELD_PARENT_UNHARVESTED, got rc=$rc ($out)"
    return 1
  fi

  # --- #365 four-shape signature pins (cases 33-34) ---------------------------
  # Cases 25 and 27 already RUN the parent-harvested and inconclusive shapes, but
  # they assert only the OUTCOME (rc + ELIGIBLE/UPSTREAM_VOID). An outcome can be
  # reached for the wrong reason, so these two legs pin the DISCRIMINATING TEXT:
  # the class-2 advisory naming the harvested parent, and the class-3 "tested
  # none derived" proving the derivation was EMPTY (the derivation_empty branch)
  # rather than "symbols derived but all absent" (case (a), case 31).
  #
  # ENV LEAKAGE GUARD: same reason as cases 25-32 -- the suite EXPORTS
  # OC_HARVEST_MOCK_COMMITS/_SQUASHED and an exported mock commit list wins over
  # the fixture repo, leaving matching_commits EMPTY and skipping gate 4, which
  # makes any leg pass VACUOUSLY.
  printf '{"manual_records": []}\n' > "$selftest_tmp/mock_reg_fx.json"

  # 33. PARENT-HARVESTED shape: the orphan path's introducing issue IS harvested,
  #     so class 2 must not refuse -- and it must SAY SO by naming the parent.
  fx_harv33="$selftest_tmp/fx_harv33"
  build_gate4_fixture "$fx_harv33" harvested
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_harv33" "$selftest_tmp/mock_reg_fx.json" "901" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "ELIGIBLE" \
     && oc_has "$out" "parent #900 already harvested" \
     && ! oc_has "$out" "HELD_PARENT_UNHARVESTED"; then
    ok "parent-harvested shape: sub-rule fires and NAMES the harvested parent #900"
  else
    echo "  bad  - harvested-parent fixture expected rc=0 ELIGIBLE + 'parent #900 already harvested' + no HELD_PARENT_UNHARVESTED, got rc=$rc ($out)"
    return 1
  fi

  # 34. INCONCLUSIVE shape: nothing was derivable, so the refusal must report the
  #     derivation as EMPTY. That is the only text separating this branch from
  #     case (a)'s "tested <symbols>" -- without it, case 27 would stay green if
  #     a regression slid the fixture from (b) into (a).
  fx_nosym34="$selftest_tmp/fx_nosym34"
  build_gate4_fixture "$fx_nosym34" nosym
  rc=0
  out="$(OC_HARVEST_MOCK_PRS='[]' OC_HARVEST_MOCK_COMMITS='' OC_HARVEST_MOCK_SQUASHED='' \
        OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
        run_engine "check" "mock/repo" "$fx_nosym34" "$selftest_tmp/mock_reg_fx.json" "902" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "tested none derived" \
     && oc_has "$out" "no declared subject"; then
    ok "inconclusive shape: derivation reported EMPTY ('tested none derived') + no declared subject"
  else
    echo "  bad  - inconclusive fixture expected rc=1 'tested none derived' + 'no declared subject', got rc=$rc ($out)"
    return 1
  fi

  # 35. #415 Design B defect 1 (CENSUS twin of dispatch leg 4f): the #292 smoke
  #     fallback is a WEAKER anchor than a resolved swap and may fire ONLY when
  #     the swap path yielded nothing. It can only ever move the anchor EARLIER,
  #     so letting it override a correct swap value can only ever SHORTEN a
  #     soak -- a one-directional failure toward a false APPROVE. The candidate
  #     here IS an ancestor of the swap that carried it (anchor
  #     2026-09-17T08:10:00Z), so the swap path resolves age 0.3h; a FOREIGN
  #     7-day-old PASS row for the same issue must NOT re-anchor it. Both the
  #     refusal TEXT and the reported AGE are asserted, so a fixture whose swap
  #     lookup silently returns 0 (which refuses too, at age 0.0h) fails
  #     instead of passing vacuously. Issue 9904 is synthetic by design: a
  #     foreign anchor with zero chance of colliding with a real log row.
  local fx_anchor="$selftest_tmp/fx_anchor"
  local fx_anchor_state="$selftest_tmp/fx_anchor_state"
  # BOTH dirs: the fixture repo must EXIST before `git -C "$fx_anchor" init`,
  # or every git call fails silently and $anchor_sha comes back empty -- the
  # mock commit then carries sha="" and the swap journal row is dropped by
  # load_swap_history's `data.get('sha')` guard, leaving swaps=0. The leg then
  # refuses via the commit_ts fallback instead of the swap anchor, and passes
  # against BOTH the fixed and the mutated code (measured 2026-09-20).
  mkdir -p "$fx_anchor" "$fx_anchor_state/oc-deploy/journal"
  git -C "$fx_anchor" init -q -b main
  git -C "$fx_anchor" config user.name fixture
  git -C "$fx_anchor" config user.email fixture@example.invalid
  git -C "$fx_anchor" config commit.gpgsign false
  printf 'anchor base\n' > "$fx_anchor/base.txt"
  git -C "$fx_anchor" add -A
  git -C "$fx_anchor" commit -q -m "base"
  git -C "$fx_anchor" update-ref refs/remotes/adolfousier/main "$(git -C "$fx_anchor" rev-parse HEAD)"
  printf 'anchor feature\n' > "$fx_anchor/anchor.txt"
  git -C "$fx_anchor" add -A
  git -C "$fx_anchor" commit -q -m "feat(anchor): fresh feature (#9904)" \
    --trailer "Issue-Ref: leshchenko1979/opencrabs#9904"
  local anchor_sha anchor_short anchor_swap_sha
  anchor_sha="$(git -C "$fx_anchor" rev-parse HEAD)"
  anchor_short="$(git -C "$fx_anchor" rev-parse --short=7 HEAD)"
  printf 'swap marker\n' > "$fx_anchor/swap-marker.txt"
  git -C "$fx_anchor" add -A
  git -C "$fx_anchor" commit -q -m "release: swap marker for anchor tree"
  anchor_swap_sha="$(git -C "$fx_anchor" rev-parse HEAD)"
  git -C "$fx_anchor" update-ref refs/remotes/origin/main "$anchor_swap_sha"
  printf '{"step":"auto-swap","sha":"%s","ts":"2026-09-17T08:10:00Z"}\n' "$anchor_swap_sha" > "$fx_anchor_state/oc-deploy/journal/swap-300.jsonl"
  printf '2026-09-10T00:00:00Z\tPASS\tissue=#9904\tsha=oldsha123\trun=12345\ttarget=live-ops\tevidence="smoke pass"\n' > "$fx_anchor_state/smoke-verdicts.log"
  printf '{"manual_records": []}\n' > "$fx_anchor_state/mock_reg_anchor.json"
  # deployed_ts is DELIBERATELY absent: a positive value short-circuits
  # get_commit_deploy_ts before the swap walk and the leg would prove nothing.
  # commit_ts is DELIBERATELY far from the swap ts (2026-09-10 vs 2026-09-17):
  # it feeds the soak gate's fallback arm `if not d_ts and not swaps ...`, so if
  # the swap history ever fails to load the leg refuses at 176.5h -- NOT at 0.3h
  # -- and fails loudly instead of counterfeiting the expected age. An earlier
  # fixture set commit_ts to the SAME epoch as the swap ts (1789632600), which
  # made the broken and the working paths numerically identical (measured
  # 2026-09-20; this collision is why the leg survived its own mutation).
  printf '[{"sha":"%s","short_sha":"%s","subject":"feat(anchor): fresh feature (#9904)","trailer":"leshchenko1979/opencrabs#9904","commit_ts":1788998400,"files":["anchor.txt"]}]\n' \
    "$anchor_sha" "$anchor_short" > "$fx_anchor_state/mock_commits_anchor.json"

  # The registry lives INSIDE the fixture state dir: the soak gate takes `swaps`
  # from dirname(registry_file) while get_commit_deploy_ts resolves its smoke log
  # from STATE_DIR, and both must point at the FIXTURE -- otherwise the smoke
  # lookup silently reads the LIVE smoke-verdicts.log.
  rc=0
  out="$(STATE_DIR="$fx_anchor_state" OC_HARVEST_NOW_TS=1789633800 \
        OC_HARVEST_MOCK_COMMITS="$fx_anchor_state/mock_commits_anchor.json" \
        run_engine "check" "mock/repo" "$fx_anchor" "$fx_anchor_state/mock_reg_anchor.json" "9904" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "within 24h feature soak window" \
     && grep -q "age: 0.3h" <<< "$out"; then
    ok "soak anchor: a resolved swap anchor survives a foreign earlier smoke row (smoke fallback only at ts==0, #415)"
  else
    echo "  bad  - anchor fixture expected rc=1 'within 24h feature soak window' 'age: 0.3h', got rc=$rc ($out)"
    return 1
  fi

  # 35b. #415 Design B defect 3 (step 7): the refusal is a SCHEDULE. Every
  #      24h-soak refusal must name the anchor it measured from AND the instant
  #      the target becomes eligible -- otherwise a refused lane has to
  #      reverse-engineer the anchor by hand-walking the swap journals (which
  #      this lane did, 2026-09-19). Reuses leg 35's run: same refusal, no
  #      extra fixture.
  #
  #      The expiry is checked as ARITHMETIC (eligible_at - anchor_deployed_ts
  #      == 86400) and never against a literal ISO string: a literal I typed
  #      measures MY arithmetic, not the tool's, and passes on any anchor.
  _ac="$(echo "$out" | sed -n 's/.*anchor_commit=\([^ ]*\).*/\1/p')"
  _ad="$(echo "$out" | sed -n 's/.*anchor_deployed_ts=\([^ ]*\).*/\1/p')"
  _el="$(echo "$out" | sed -n 's/.*eligible_at=\([^ ]*\).*/\1/p')"
  _delta="$(python3 -c 'import datetime,sys;f=lambda s:int(datetime.datetime.fromisoformat(s).timestamp());print(f(sys.argv[2])-f(sys.argv[1]))' "$_ad" "$_el" 2>/dev/null)"
  if [ -n "$_ac" ] && [ -n "$_ad" ] && [ -n "$_el" ] && [ "$_delta" = "86400" ]; then
    ok "soak refusal carries anchor_commit/anchor_deployed_ts/eligible_at, expiry = anchor + 24h (#415)"
  else
    echo "  bad  - soak anchor triple expected 3 non-empty fields and eligible_at-anchor_deployed_ts=86400, got anchor_commit='$_ac' anchor_deployed_ts='$_ad' eligible_at='$_el' delta='$_delta' ($out)"
    return 1
  fi

  # 36. #415 Design B defect 2 (step 6): on a TAB row the structured issue=
  #     field is AUTHORITATIVE; the prose regex is a LEGACY FALLBACK only,
  #     because it cannot tell a verdict's own issue from one its evidence
  #     merely CROSS-REFERENCES -- measured over the live 1358-row log, 92 of
  #     the 254 field-carrying rows name a second issue in prose ('the SAME leg
  #     already parked under issue #155', 'that is F3, tracked under #138').
  #     Row A below carries field issue=#402 while its prose cites #341 at an
  #     EARLIER ts, so under the old if/elif it anchors 341 and drags the
  #     anchor back to 216.0h -- past the 24h soak, i.e. a false APPROVE.
  #     Row B is the POSITIVE CONTROL and carries a COMMA SET
  #     (issue=#341,#902), so a scalar-equality regression -- which would
  #     silently drop all 15 live multi-issue rows -- also goes red.
  #     Both the refusal TEXT and the reported AGE are asserted: a fixture whose
  #     smoke path dies refuses too, but at age 0.0h, and fails loudly instead
  #     of passing vacuously.
  local fx_sm="$selftest_tmp/fx_smoke"
  local fx_sm_state="$selftest_tmp/fx_smoke_state"
  mkdir -p "$fx_sm" "$fx_sm_state/oc-deploy/journal"
  git -C "$fx_sm" init -q -b main
  git -C "$fx_sm" config user.name fixture
  git -C "$fx_sm" config user.email fixture@example.invalid
  git -C "$fx_sm" config commit.gpgsign false
  printf 'smoke base\n' > "$fx_sm/base.txt"
  git -C "$fx_sm" add -A
  git -C "$fx_sm" commit -q -m "base"
  printf 'smoke feature\n' > "$fx_sm/feat.txt"
  git -C "$fx_sm" add -A
  git -C "$fx_sm" commit -q -m "feat(smoke): fresh feature (#341)" \
    --trailer "Issue-Ref: leshchenko1979/opencrabs#341"
  local sm_sha sm_short sm_swap_sha
  sm_sha="$(git -C "$fx_sm" rev-parse HEAD)"
  sm_short="$(git -C "$fx_sm" rev-parse --short=7 HEAD)"
  # The swap marker is a SIBLING of the candidate, not an ancestor: the sha walk
  # then leaves ts==0 and the smoke fallback is the ONLY possible anchor source.
  # (One swap row also makes _swap_suffix_start return 0, skipping the twin arm.)
  git -C "$fx_sm" checkout -q -b swapbranch HEAD~1
  printf 'swap marker\n' > "$fx_sm/swap-marker.txt"
  git -C "$fx_sm" add -A
  git -C "$fx_sm" commit -q -m "release: swap marker for smoke tree"
  sm_swap_sha="$(git -C "$fx_sm" rev-parse HEAD)"
  printf '{"step":"auto-swap","sha":"%s","ts":"2026-09-01T00:00:00Z"}\n' "$sm_swap_sha" > "$fx_sm_state/oc-deploy/journal/swap-301.jsonl"
  {
    printf '2026-09-01T03:13:20Z\tPASS\tissue=#402\tsha=oldsha123\trun=12345\ttarget=live-ops\tevidence="supersedes #341"\n'
    printf '2026-09-10T00:00:00Z\tPASS\tissue=#341,#902\tsha=oldsha456\trun=12346\ttarget=live-ops\tevidence="smoke pass"\n'
  } > "$fx_sm_state/smoke-verdicts.log"
  printf '{"manual_records": []}\n' > "$fx_sm_state/mock_reg_smoke.json"
  printf '[{"sha":"%s","short_sha":"%s","subject":"feat(smoke): fresh feature (#341)","trailer":"leshchenko1979/opencrabs#341","commit_ts":1788232400,"files":["feat.txt"]}]\n' \
    "$sm_sha" "$sm_short" > "$fx_sm_state/mock_commits_smoke.json"

  rc=0
  out="$(STATE_DIR="$fx_sm_state" OC_HARVEST_NOW_TS=1789010000 \
        OC_HARVEST_MOCK_COMMITS="$fx_sm_state/mock_commits_smoke.json" \
        run_engine "check" "mock/repo" "$fx_sm" "$fx_sm_state/mock_reg_smoke.json" "341" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "within 24h feature soak window" \
     && grep -q "age: 3.2h" <<< "$out"; then
    ok "smoke field precedence: a field reading issue=#402 does not anchor 341 from its prose (#415)"
  else
    echo "  bad  - smoke precedence fixture expected rc=1 'within 24h feature soak window' 'age: 3.2h', got rc=$rc ($out)"
    return 1
  fi


  # ---- clusters: the cluster surfacer -------------------------------------
  # Every trap in the build order gets a leg, because each one cost a published
  # number when it was hit by hand: 46 -> 41 -> 35 for one tree.
  local mock_cl_c="$selftest_tmp/mock_cl_commits.json"
  local mock_cl_i="$selftest_tmp/mock_cl_issues.json"

  # `files` rides the mock commit dicts, which get_affected_files_for_commits
  # honours directly -- so the dependency leg is exercised without a git fixture.
  cat << 'EOF' > "$mock_cl_c"
[
 {"sha":"a1","short_sha":"a1","subject":"fix(tools): real work (#701)","trailer":"leshchenko1979/opencrabs#700","commit_ts":1,"files":["src/shared.rs","src/a.rs"]},
 {"sha":"a2","short_sha":"a2","subject":"fix(tools): a COMMIT that reads like a fix (#800)","trailer":"leshchenko1979/opencrabs#800","commit_ts":2,"files":["src/shared.rs","src/b.rs"]},
 {"sha":"a3","short_sha":"a3","subject":"feat(tools): a FEATURE landed inside a fix-titled cluster (#801)","trailer":"leshchenko1979/opencrabs#801","commit_ts":3,"files":["src/c.rs"]},
 {"sha":"a4","short_sha":"a4","subject":"chore: untrailered and unreferenced","trailer":"","commit_ts":4,"files":["src/d.rs"]}
]
EOF
  # #700's state is UPPERCASE on purpose -- trap (b). gh returns lowercase in
  # production, and a naive OPEN comparison returns zero silently.
  # The two directions are deliberate: #800's COMMIT prefix is fix(...) while
  # its ISSUE title is feat(...) -- the title must win (trap a). #801's COMMIT
  # is feat(...) while its ISSUE title is fix(...) -- fix-titled AND MIXED
  # (trap d). One fixture, both directions, so a prefix-keyed classifier
  # cannot pass both.
  cat << 'EOF' > "$mock_cl_i"
[
 {"number":700,"title":"fix(tools): the trailer must win","state":"OPEN"},
 {"number":800,"title":"feat(tools): a feature, not a fix","state":"open"},
 {"number":801,"title":"fix(tools): a fix-titled issue holding a feat commit","state":"open"}
]
EOF

  rc=0
  cl_out="$(STATE_DIR="$selftest_tmp" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_COMMITS="$mock_cl_c" OC_HARVEST_MOCK_ISSUES="$mock_cl_i" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "clusters" "adolfousier/opencrabs" "$selftest_tmp" "$mock_reg" "" "" "--json" 2>&1)" || rc=$?
  cl_verdicts="$(printf '%s' "$cl_out" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("PARSE_FAIL"); sys.exit(0)
by={c["cluster"]:c for c in d["clusters"]}
# (1) the TRAILER wins over the subject ref
print("trailer_wins", "PASS" if (700 in by and 701 not in by) else "FAIL")
# (2) fix-type is the ISSUE TITLE, never the commit prefix (trap a)
print("title_not_prefix", "PASS" if (800 in by and not by[800]["fix_titled"] and by[801]["fix_titled"]) else "FAIL")
# (3) MIXED is flagged for a fix-titled cluster carrying a feat commit (trap d)
print("mixed_flag", "PASS" if by[801]["kind"]=="MIXED" else "FAIL")
# (4) the dependency leg comes from the FILE GRAPH, not the gh blockedBy link
print("graph_link", "PASS" if (800 in by[700]["linked"] and 700 in by[800]["linked"]) else "FAIL")
# (5) unclustered commits are REPORTED, never silently dropped
print("unclustered", "PASS" if d["summary"]["unclustered_commits"]==1 else "FAIL")
')"
  if [ "$rc" -eq 0 ] && ! oc_has "$cl_verdicts" "FAIL" && ! oc_has "$cl_verdicts" "PARSE_FAIL"; then
    ok "clusters: trailer wins, title-not-prefix, MIXED flagged, file-graph link, unclustered reported"
  else
    echo "  bad  - clusters fixture expected all PASS, got rc=$rc ($cl_verdicts)"
    return 1
  fi

  # Trap (b) discrimination on the COUNT: with #700's state UPPERCASE, a
  # case-sensitive comparison yields 1 open fix-titled instead of 2 -- and a
  # zero would look exactly like an empty tree.
  if printf '%s' "$cl_out" | python3 -c '
import json,sys
sys.exit(0 if json.load(sys.stdin)["summary"]["open_fix_titled"]==2 else 1)
'; then
    ok "clusters: uppercase state counts as open (trap b -- OPEN vs open)"
  else
    echo "  bad  - clusters expected open_fix_titled=2 with UPPERCASE state"
    return 1
  fi

  # Trap (c): NEVER pages silently. Every cluster the JSON reports must appear
  # as a row in the table.
  rc=0
  cl_tbl="$(STATE_DIR="$selftest_tmp" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_COMMITS="$mock_cl_c" OC_HARVEST_MOCK_ISSUES="$mock_cl_i" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "clusters" "adolfousier/opencrabs" "$selftest_tmp" "$mock_reg" "" "" 2>&1)" || rc=$?
  cl_rows="$(printf '%s\n' "$cl_tbl" | grep -c '^CLUSTER #')"
  cl_json_n="$(printf '%s' "$cl_out" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["clusters"]))' 2>/dev/null || echo -1)"
  if [ "$rc" -eq 0 ] && [ "$cl_rows" = "$cl_json_n" ] && [ "$cl_rows" = "3" ]; then
    ok "clusters: table emits every cluster the JSON reports (no silent paging)"
  else
    echo "  bad  - clusters table rows=$cl_rows json=$cl_json_n (want 3 and equal)"
    return 1
  fi

  # --open-fix narrows to open fix-titled only, and DISCLOSES the narrowing.
  rc=0
  cl_of="$(STATE_DIR="$selftest_tmp" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_COMMITS="$mock_cl_c" OC_HARVEST_MOCK_ISSUES="$mock_cl_i" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "clusters" "adolfousier/opencrabs" "$selftest_tmp" "$mock_reg" "" "" "--open-fix" 2>&1)" || rc=$?
  # #801 must be IN the narrowed view: it is fix-titled by ISSUE TITLE while its
  # commit is feat(...), so a commit-prefix classifier drops it and the row
  # count alone would still read 2 (it would swap in #800 instead).
  if [ "$rc" -eq 0 ] && [ "$(printf '%s\n' "$cl_of" | grep -c '^CLUSTER #')" = "2" ] \
     && oc_has "$cl_of" "CLUSTER #801" && ! oc_has "$cl_of" "CLUSTER #800" \
     && oc_has "$cl_of" "--open-fix: showing only open fix-titled clusters"; then
    ok "clusters --open-fix narrows to open fix-titled and discloses the narrowing"
  else
    echo "  bad  - clusters --open-fix expected 2 rows + disclosure, got rc=$rc"
    return 1
  fi

  # rc=3 when the fork issue list cannot be read. A stub gh on PATH is the
  # injection; mock PRs stay supplied so ONLY the issue call fails.
  local cl_stub="$selftest_tmp/cl_bin"
  mkdir -p "$cl_stub"
  printf '#!/bin/sh\nexit 1\n' > "$cl_stub/gh"
  chmod +x "$cl_stub/gh"
  rc=0
  cl_bad="$(PATH="$cl_stub:$PATH" STATE_DIR="$selftest_tmp" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_COMMITS="$mock_cl_c" OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "clusters" "adolfousier/opencrabs" "$selftest_tmp" "$mock_reg" "" "" 2>&1)" || rc=$?
  if [ "$rc" -eq 3 ] && oc_has "$cl_bad" "cannot read the fork issue list"; then
    ok "clusters: unreadable issue list exits 3 and says why (never classifies against an empty map)"
  else
    echo "  bad  - clusters expected rc=3 with a clear message, got rc=$rc ($cl_bad)"
    return 1
  fi

  # ---- 27. CLUSTER-SET READINESS (#607) --------------------------------
  # The owner's rule: the set is ready only when EVERY member is
  # swapped+smoked+CLOSED and the NEWEST member's swap is >24h old. Before
  # #607 that rule was a VIEW (`held` computed only in the clusters arm) and
  # no refusal leg read a cluster's membership at all.
  local setdir="$selftest_tmp/set607"
  mkdir -p "$setdir"
  local rel_empty="$setdir/rel_empty.json" rel_one="$setdir/rel_one.json" \
        rel_chain="$setdir/rel_chain.json" st_open="$setdir/st_open.json" \
        st_mixed="$setdir/st_mixed.json" st_chain="$setdir/st_chain.json"
  # #625 fixtures: a member reached only through the main-resident index.
  local rel_602="$setdir/rel_602.json" st_602="$setdir/st_602.json"
  printf '{"600": []}\n'                                  > "$rel_empty"
  printf '{"600": [601]}\n'                               > "$rel_one"
  printf '{"600": [602]}\n'                               > "$rel_602"
  printf '{"600": [601], "601": [602]}\n'                 > "$rel_chain"
  printf '{"600": {"state": "open"}}\n'                   > "$st_open"
  printf '{"600": {"state": "closed"}, "602": {"state": "open"}}\n' > "$st_602"
  printf '{"600": {"state": "closed"}, "601": {"state": "open"}}\n'  > "$st_mixed"
  printf '{"600": {"state": "closed"}, "601": {"state": "closed"}, "602": {"state": "open"}}\n' > "$st_chain"

  # a commit anchored to #600 so the unit is a real cluster member
  local c600="$setdir/c600.json"
  cat << 'C600EOF' > "$c600"
[{"sha": "6000000cb0000000000000000000000000000000",
  "short_sha": "6000000",
  "subject": "fix(set): a set member (#600)",
  "trailer": "leshchenko1979/opencrabs#600",
  "commit_ts": 100000,
  "files": ["src/set607/mod.rs"]}]
C600EOF

  # HERMETIC SMOKE FIXTURE. member_ready() reads $st_dir/smoke-verdicts.log and
  # with no file there falls back to the LIVE log -- so a missing fixture would
  # silently make every leg read the real fleet's smoke history.
  printf '2026-09-10T00:00:00Z\tPASS\tissue=#601\tsha=set601\trun=1\ttarget=t\tevidence="smoked"\n' \
    > "$selftest_tmp/smoke-verdicts.log"
  # A commit for #601, so `swapped` can be TRUE for it. `swaps` is empty here,
  # so get_commit_deploy_ts falls back to commit_ts; an OLD ts keeps the set
  # soak clock clear, which is what these legs want.
  local c601="$setdir/c601.json"
  cat << 'C601EOF' > "$c601"
[{"sha": "6010000cb0000000000000000000000000000000",
  "short_sha": "6010000",
  "subject": "fix(set): a relative (#601)",
  "trailer": "leshchenko1979/opencrabs#601",
  "commit_ts": 100000,
  "deployed_ts": 100000,
  "files": ["src/set607/rel.rs"]}]
C601EOF

  # (a) THE TARGET IS EXCLUDED FROM ITS OWN SET (HQ ruling 2026-09-26, n=11674).
  #     The own issue is OPEN with no relatives, so the set is EMPTY and nothing
  #     holds it. Before the ruling this refused "#600 (own)" -- the circular
  #     hold that made closure a precondition of the act that produces it.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_empty" OC_HARVEST_MOCK_ISSUE_STATE="$st_open" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if ! oc_has "$out" "[HELD_SET:"; then
    ok "HELD_SET: the TARGET is excluded from its own set (open own issue, no relatives -> not held)"
  else
    echo "  bad  - HELD_SET must not gate a cluster on its own issue; got rc=$rc ($out)"
  fi

  # (b) A READY RELATIVE DOES NOT HOLD. #601 is swapped (has a commit) AND smoked
  #     (the PASS row above), so it is a READY member.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_one" OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" \
    OC_HARVEST_MOCK_COMMITS="$c601" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if ! oc_has "$out" "[HELD_SET:"; then
    ok "HELD_SET: a READY relative (swapped+smoked) does NOT hold the set"
  else
    echo "  bad  - HELD_SET held a set whose only relative is READY; got rc=$rc ($out)"
  fi

  # (b2) AN UNREADY RELATIVE HOLDS, and the refusal names the MISSING HALF rather
  #      than a bare GH state. #601 has no commit here, so `swapped` is FALSE.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_one" OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "[HELD_SET:" && oc_has "$out" "#601" \
     && oc_has "$out" "not swapped"; then
    ok "HELD_SET: an UNREADY relative holds the set and the refusal names the missing half"
  else
    echo "  bad  - HELD_SET unready-relative leg expected rc=1 naming #601 + 'not swapped', got rc=$rc ($out)"
  fi

  # (c) 1-HOP ONLY -- the leg that stops a degenerate closure. #601 is READY;
  #     #602 is only a GRAND-relative and is unready. At 1-hop the set is free;
  #     under closure it would refuse.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_chain" OC_HARVEST_MOCK_ISSUE_STATE="$st_chain" \
    OC_HARVEST_MOCK_COMMITS="$c601" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  # NB: anchored on "[HELD_SET:" -- the bare token is a SUBSTRING of
  # HELD_SET_SOAK, so an unanchored test cannot tell the two legs apart.
  if ! oc_has "$out" "[HELD_SET:"; then
    ok "HELD_SET: 1-hop only -- an unready GRAND-relative does NOT hold (no transitive closure)"
  else
    echo "  bad  - HELD_SET must not close transitively; grand-relative #602 refused ($out)"
  fi

  # (d) SET SOAK CLOCK -- the youngest member's swap under 24h holds the set.
  # The anchor must be a RELATIVE's swap: the target is excluded from the set
  # clock (its own 24h soak is leg 1), so a recent TARGET commit alone no
  # longer holds the set -- that is the corrected contract, and this fixture
  # plants the recent deploy on #601 to reach the clock at all.
  local c601_recent="$setdir/c601_recent.json"
  cat << 'C601REOF' > "$c601_recent"
[{"sha": "6010000cb0000000000000000000000000000000",
  "short_sha": "6010000",
  "subject": "fix(set): a relative (#601)",
  "trailer": "leshchenko1979/opencrabs#601",
  "commit_ts": 100000,
  "deployed_ts": 1790000000,
  "files": ["src/set607/rel.rs"]}]
C601REOF
  rc=0
  out="$(OC_HARVEST_NOW_TS=1790003600 OC_HARVEST_MOCK_RELATIONS="$rel_one" \
    OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" OC_HARVEST_MOCK_COMMITS="$c601_recent" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "HELD_SET_SOAK" && oc_has "$out" "1.0h"; then
    ok "HELD_SET_SOAK: a RELATIVE's 1.0h swap holds the set (rc=1, target excluded from the clock)"
  else
    echo "  bad  - HELD_SET_SOAK expected rc=1 naming a 1.0h relative swap, got rc=$rc ($out)"
  fi

  # (e) UNRESOLVABLE CLOCK MUST DISCLOSE. No member commit carries a deploy
  #     anchor, so the 24h window cannot be shown to have started. It must print
  #     a NOTE -- never "fresh", never a silent clean (#563 discipline).
  #     A NON-EMPTY swap history is REQUIRED here. With no swap journals the
  #     clock falls back to commit_ts (the same conservative arm the per-unit
  #     soak legs use), so an empty-swap fixture reads a huge age and reports
  #     "clear" -- UNRESOLVABLE is unreachable that way. Planting a journal
  #     whose shas match no member commit is what actually reaches it.
  local fx_ur="$setdir/ur_state"
  mkdir -p "$fx_ur/oc-deploy/journal"
  printf '{"step":"auto-swap","sha":"deadbeef0000000000000000000000000000000","ts":"2026-09-01T00:00:00Z"}\n' \
    > "$fx_ur/oc-deploy/journal/swap-600.jsonl"
  printf '{"manual_records": []}\n' > "$fx_ur/mock_reg_ur.json"
  rc=0
  out="$(OC_HARVEST_NOW_TS=1790003600 OC_HARVEST_MOCK_RELATIONS="$rel_empty" \
    OC_HARVEST_MOCK_ISSUE_STATE="$st_open" OC_HARVEST_MOCK_COMMITS="$c600" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$fx_ur" "$fx_ur/mock_reg_ur.json" "600" "" 2>&1)" || rc=$?
  if oc_has "$out" "no members besides the target" \
     && oc_has "$out" "VACUOUSLY" \
     && ! oc_has "$out" "UNRESOLVABLE" \
     && ! oc_has "$out" "[HELD_SET_SOAK:"; then
    ok "#634: an EMPTY set (no members besides the target) is disclosed as VACUOUSLY CLEAR, never as a hold"
  else
    echo "  bad  - an empty set must print the vacuous-clear note, not the unresolvable one ($out)"
  fi

  # (e2) #634: the GENUINE unresolvable case -- members EXIST but no anchor is
  #      reachable. This is the DISCRIMINATING PAIR against (e): if both print
  #      the same string, neither leg measures anything.
  printf '{"600": [601]}\n' > "$setdir/rel_ur2.json"
  local c601_noanchor="$setdir/c601_noanchor.json"
  cat << 'C601NEOF' > "$c601_noanchor"
[{"sha": "6010000cb0000000000000000000000000000001",
  "short_sha": "6010001",
  "subject": "fix(set): a relative with no reachable anchor (#601)",
  "trailer": "leshchenko1979/opencrabs#601",
  "commit_ts": 100000,
  "files": ["src/set607/rel2.rs"]}]
C601NEOF
  rc=0
  out_e2="$(OC_HARVEST_NOW_TS=1790003600 OC_HARVEST_MOCK_RELATIONS="$setdir/rel_ur2.json" \
    OC_HARVEST_MOCK_ISSUE_STATE="$st_chain" OC_HARVEST_MOCK_COMMITS="$c601_noanchor" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$fx_ur" "$fx_ur/mock_reg_ur.json" "600" "" 2>&1)" || rc=$?
  if oc_has "$out_e2" "set soak clock UNRESOLVABLE" \
     && oc_has "$out_e2" "NOT \"fresh\"" \
     && ! oc_has "$out_e2" "[HELD_SET_SOAK:"; then
    ok "#634: a NON-empty set with no reachable anchor keeps the UNRESOLVABLE wording verbatim"
  else
    echo "  bad  - a non-empty set with no reachable anchor must keep the UNRESOLVABLE note ($out_e2)"
  fi
  if [ "$out" != "$out_e2" ]; then
    ok "#634: the empty and unresolvable states are DIFFERENT outputs (the discriminating pair)"
  else
    echo "  bad  - empty and unresolvable must not share one output"
  fi

  # (f) UNREADABLE RELATIONS ARE NOT A FREE SET. An unreadable graph means the
  #     leg DID NOT RUN, and the output must say so rather than imply clean.
  # A mock path that does not exist falls through to `gh`, so the fixture must
  # make the reader FAIL rather than silently return nothing: an unreadable
  # graph has to be disclosed, and a silent empty set would read as free.
  printf '{"600": null}\n' > "$setdir/rel_unreadable.json"
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$setdir/rel_unreadable.json" \
    OC_HARVEST_MOCK_ISSUE_STATE="$st_open" OC_HARVEST_MOCK_COMMITS="$c601" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if oc_has "$out" "UNREADABLE" || oc_has "$out" "did NOT run"; then
    ok "HELD_SET: an unreadable graph is DISCLOSED (leg did not run), never read as a free set"
  else
    echo "  bad  - unreadable relations must disclose the un-run leg ($out)"
  fi

  # (g) THE VIEW AGREES WITH THE GATE. `held` must include an open OWN issue --
  #     before #607 it consulted only file-linked siblings, so an open
  #     own-issue with no open sibling read as FREE (live: #458, #513, #593).
  local cv_out cv_rc
  cv_rc=0
  cv_out="$(OC_HARVEST_MOCK_RELATIONS="$rel_empty" OC_HARVEST_MOCK_ISSUE_STATE="$st_open" \
    OC_HARVEST_MOCK_COMMITS="$c601" OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "clusters" "adolfousier/opencrabs" "$selftest_tmp" "$mock_reg" "" "" "--open-fix" 2>&1)" || cv_rc=$?
  if [ "$cv_rc" -eq 0 ] && oc_has "$cv_out" "HELD: 0 of 1 open fix-titled"; then
    ok "clusters view: an OPEN own issue does NOT hold its own set (target excluded)"
  else
    echo "  bad  - clusters view must exclude the target from its own set, got rc=$cv_rc"
  fi

  # (h) ABSENT CLOCK IS DISCLOSED. The set soak clock is opt-in (it walks git
  #     ancestry per member commit), so its absence must be stated rather than
  #     rendered as a clean set -- the #563 discipline.
  if oc_has "$cv_out" "set clock: NOT computed (--clock not passed)"; then
    ok "clusters view: an uncomputed set clock is DISCLOSED, never rendered as clean"
  else
    echo "  bad  - clusters view must disclose the uncomputed clock"
  fi


  # ---- 27b. HARVESTED-MEMBER ANCHOR RESOLUTION (#625) --------------------
  # A harvested member's commits LEAVE the fork-only delta, because harvesting
  # moves them into adolfousier/main. member_ready() derived swapped_ts only
  # from that delta, so the member's anchor became unreachable BY THE VERY ACT
  # OF HARVESTING IT and the set refused forever.
  #
  # Live specimen, measured 2026-09-27: #119 -- upstream PR adolfousier/
  # opencrabs#1481 MERGED, fork merge a0f581752 an ancestor of main, and
  #   git log adolfousier/main..origin/main  (Issue-Ref #119) -> 0 commits
  #   git log origin/main                    (full history)   -> 5 commits
  # `check 396` therefore refused [HELD_SET: #119(closed, not swapped+not
  # smoked)] with the set clock printing "0 commit(s) scanned", and stamping a
  # smoke row could not clear it: the swapped half was unresolvable by any
  # legitimate action. The swap-journal path cannot substitute either -- 293
  # distinct auto-swap shas exist, only 44 intersect origin/main, and #119's own
  # journal sha (64bca902) is NOT on main (squashed by the harvest that
  # deployed it).
  #
  # Fixture shape: #601 is SMOKED (the PASS row above) but has NO commit in the
  # delta index, only in the main-resident one. So `swapped` is reachable ONLY
  # through the widening, which is what makes leg (b) a real control.
  local c601_main="$setdir/c601_main.json" c602_main="$setdir/c602_main.json"
  cat << 'C601MEOF' > "$c601_main"
[{"sha": "6010000mb000000000000000000000000000000",
  "short_sha": "6010000",
  "subject": "fix(set): a relative, harvested upstream (#601)",
  "trailer": "leshchenko1979/opencrabs#601",
  "commit_ts": 100000,
  "files": ["src/set607/rel.rs"]}]
C601MEOF
  cat << 'C602MEOF' > "$c602_main"
[{"sha": "6020000mb000000000000000000000000000000",
  "short_sha": "6020000",
  "subject": "fix(set): a relative, harvested, NOT smoked (#602)",
  "trailer": "leshchenko1979/opencrabs#602",
  "commit_ts": 100000,
  "files": ["src/set607/rel2.rs"]}]
C602MEOF

  # (a) THE WIDENING CARRIES THE MEMBER. Delta holds only #600; the main-resident
  #     index holds #601; #601 is smoked -> READY, so nothing holds the set.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_one" OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_MAIN_COMMITS="$c601_main" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if ! oc_has "$out" "[HELD_SET:"; then
    ok "#625: a harvested member resolves its anchor via the main-resident index and no longer holds the set"
  else
    echo "  bad  - #625 a harvested+smoked member still held the set; got rc=$rc ($out)"
  fi

  # (b) THE CONTROL, and the leg that gives (a) meaning. Same fixture WITHOUT
  #     the main-resident index: the member must read "not swapped". If (b)
  #     also passed, nothing above was decided by the widening -- that is the
  #     vacuous-green shape this session has paid for repeatedly.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_one" OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" \
    OC_HARVEST_MOCK_COMMITS="$c600" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "not swapped"; then
    ok "#625 control: without the main-resident index the same member reads 'not swapped' (so (a) was decided by the widening)"
  else
    echo "  bad  - #625 control expected rc=1 + 'not swapped', got rc=$rc ($out)"
  fi

  # (c) THE REFUSAL STILL NAMES THE MISSING HALF. #602 is main-resident but has
  #     NO smoke row, so `swapped` resolves through the widening and only
  #     `not smoked` remains -- a bare GH state would hide which condition
  #     failed, and the reporter could not act on it.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_602" OC_HARVEST_MOCK_ISSUE_STATE="$st_602" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_MAIN_COMMITS="$c602_main" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if oc_has "$out" "#602" && oc_has "$out" "not smoked" && ! oc_has "$out" "not swapped"; then
    ok "#625: a main-resident but unsmoked member names ONLY the missing half (swapped resolved, not a bare GH state)"
  else
    echo "  bad  - #625 disclosure leg expected '#602' + 'not smoked' and NOT 'not swapped'; got rc=$rc ($out)"
  fi

  # ---- #653: THE PHANTOM-HOLDER FENCE (#404 predicate) --------------------
  # A claim whose holder has NO sessions row can never finish or release it, so
  # fencing on it is a permanent hold no legitimate action clears -- and #404
  # forbids a phantom from entering a freeze list at all. Measured live on
  # #396: claim #583 held by b53581f4 (0 sessions rows; control 42a44908 = 1),
  # holder_age=unknown, no advisory, no clearance clock.
  #
  # Fixture: target #500's fences are #600 (holder 11111111, REAL) and #704
  # (holder 33333333). Two session DBs decide which is which, so the pair below
  # is decided by the phantom predicate ALONE and not by the fixture.
  local mock_653_one="$setdir/mock_653_one.db" mock_653_both="$setdir/mock_653_both.db"
  _mksess() { # $1 = db path, $2.. = uuids to enrol
    _db="$1"; shift
    python3 -c 'import sqlite3,sys; db=sys.argv[1]; now=int(sys.argv[2]); con=sqlite3.connect(db); con.execute("create table sessions (id text, updated_at integer)"); [con.execute("insert into sessions values (?,?)", (u, now-3600)) for u in sys.argv[3:]]; con.commit(); con.close()' "$_db" "$OC_HARVEST_NOW_TS" "$@"
  }
  _mksess "$mock_653_one"  "11111111-2222-3333-4444-555555555555"
  _mksess "$mock_653_both" "11111111-2222-3333-4444-555555555555" "33333333-4444-5555-6666-777777777777"

  # (a) THE PHANTOM FENCE IS SKIPPED, AND SAYS WHY. Only 11111111 is known, so
  #     #704's holder is a phantom: its fence must not apply, and the reader
  #     must be told why rather than meeting a bare silence.
  rc=0
  out="$(OC_LEDGER_DB="$mock_653_one" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "500" 2>&1)" || rc=$?
  _fc="$(printf '%s\n' "$out" | grep -c '^REFUSED.*HELD_IN_FLIGHT_LANE' || true)"
  if [ "$rc" -eq 1 ] && [ "$_fc" -eq 1 ] && oc_has "$out" "claim #600" \
     && oc_has "$out" "#404 phantom" && oc_has "$out" "oc-ledger unclaim"; then
    ok "#653: a phantom holder's fence is SKIPPED with the #404 note and the remedy; the real holder still fences"
  else
    echo "  bad  - #653 expected rc=1, exactly 1 fence (#600), the '#404 phantom' note and the remedy; got rc=$rc count=$_fc ($out)"
    return 1
  fi

  # (b) CONTROL, and the leg that gives (a) meaning: with BOTH holders known,
  #     nothing is skipped and both fences apply. If (b) also passed, nothing
  #     above was decided by the phantom predicate.
  rc=0
  out="$(OC_LEDGER_DB="$mock_653_both" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "500" 2>&1)" || rc=$?
  _fc="$(printf '%s\n' "$out" | grep -c '^REFUSED.*HELD_IN_FLIGHT_LANE' || true)"
  if [ "$rc" -eq 1 ] && [ "$_fc" -eq 2 ] && ! oc_has "$out" "#404 phantom"; then
    ok "#653 control: with both holders known, both fences apply and no phantom note appears"
  else
    echo "  bad  - #653 control expected rc=1, 2 fences, no phantom note; got rc=$rc count=$_fc ($out)"
    return 1
  fi

  # ---- #654: A HARVESTED MEMBER SATISFIES THE SMOKE LEG -------------------
  # A harvested member's fork smoke row was never owed -- the harvest IS the
  # completion -- so demanding one held the whole cluster forever. Measured:
  # #119 CLOSED, upstream PR adolfousier/opencrabs#1481 MERGED, fork merge
  # a0f581752 an ancestor of main, and ZERO rows carry `issue=#119`.
  local mock_prs_harv="$setdir/mock_prs_harv.json"
  printf '%s\n' '[{"number": 1481, "title": "fix(set): a harvested member", "state": "MERGED", "headRefName": "leshchenko1979/fix/set-602", "mergedAt": "2026-09-10T00:00:00Z", "body": "Fixes leshchenko1979/opencrabs#602"}]' > "$mock_prs_harv"

  # (a) THE SET IS READY, AND THE REASON IS DISCLOSED. #602 is swapped through
  #     the main-resident index and has NO smoke row, so pre-#654 the set was
  #     held forever. The disclosure must NAME the harvest: a bare "ready"
  #     would hide that the acceptance evidence is the harvest, not a smoke row.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_602" OC_HARVEST_MOCK_ISSUE_STATE="$st_602" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_MAIN_COMMITS="$c602_main" \
    OC_HARVEST_MOCK_PRS="$mock_prs_harv" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if ! oc_has "$out" "[HELD_SET:" && oc_has "$out" "ready VIA THEIR HARVEST" \
     && oc_has "$out" "harvested:PR #1481"; then
    ok "#654: a swapped+harvested member satisfies the smoke leg, disclosed as harvested:PR #1481"
  else
    echo "  bad  - #654 expected the set READY with the 'harvested:PR #1481' disclosure; got rc=$rc ($out)"
    return 1
  fi

  # (b) CONTROL: the SAME member with NO merged upstream PR still refuses
  #     'not smoked'. This is what proves (a) was decided by the harvest and
  #     not by the smoke leg being dropped.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_602" OC_HARVEST_MOCK_ISSUE_STATE="$st_602" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_MAIN_COMMITS="$c602_main" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "[HELD_SET:" && oc_has "$out" "not smoked" \
     && ! oc_has "$out" "ready VIA THEIR HARVEST"; then
    ok "#654 control: without a merged upstream PR the same member still refuses 'not smoked'"
  else
    echo "  bad  - #654 control expected rc=1 '[HELD_SET:' + 'not smoked' and no harvest note; got rc=$rc ($out)"
    return 1
  fi

  # (d) THE SOAK CLOCK SCANS THE WIDENED COMMITS. Pre-fix the clock printed
  #     "0 commit(s) scanned" for exactly this population -- the second half of
  #     the reported symptom. The clock reads the same members the predicate
  #     now accepts, or it silently ignores them.
  rc=0
  out="$(OC_HARVEST_MOCK_RELATIONS="$rel_one" OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" \
    OC_HARVEST_MOCK_COMMITS="$c600" OC_HARVEST_MOCK_MAIN_COMMITS="$c601_main" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  if ! oc_has "$out" "0 commit(s) scanned"; then
    ok "#625: the set soak clock scans the widened commits (no 'UNRESOLVABLE -- 0 commit(s) scanned' for a harvested member)"
  else
    echo "  bad  - #625 the soak clock still reports 0 commits scanned; got rc=$rc ($out)"
  fi

  # (e) FALLBACK, NEVER REPLACEMENT. When the delta DOES hold the member, the
  #     main-resident index must not override it. Load-bearing for the soak
  #     clock, which takes the MAX anchor over members: a widened twin that is
  #     newer would move the anchor and flip a clear set to held. Here the
  #     delta anchor is ancient (deployed_ts 100000 -> clock clear) while the
  #     main-resident twin sits ~1h before NOW_TS -> if it were consulted,
  #     HELD_SET_SOAK. A first version of this leg used rel_empty and passed
  #     BOTH ways for an unrelated reason (the target is excluded from its own
  #     set since #607, so the set was empty no matter what) -- a decorative
  #     leg. This shape can only pass if the precedence order is right.
  local c601_delta="$setdir/c601_delta.json" c601_recent="$setdir/c601_recent.json"
  cat << 'C601DEOF' > "$c601_delta"
[{"sha": "6010000cd000000000000000000000000000000",
  "short_sha": "6010000",
  "subject": "fix(set): a relative, in the delta (#601)",
  "trailer": "leshchenko1979/opencrabs#601",
  "commit_ts": 100000,
  "deployed_ts": 100000,
  "files": ["src/set607/rel.rs"]}]
C601DEOF
  cat << 'C601REOF' > "$c601_recent"
[{"sha": "6010000cr000000000000000000000000000000",
  "short_sha": "6010000",
  "subject": "fix(set): a recent main-resident twin (#601)",
  "trailer": "leshchenko1979/opencrabs#601",
  "commit_ts": 1790000000,
  "files": ["src/set607/rel.rs"]}]
C601REOF
  rc=0
  out="$(OC_HARVEST_NOW_TS=1790003600 \
    OC_HARVEST_MOCK_RELATIONS="$rel_one" OC_HARVEST_MOCK_ISSUE_STATE="$st_mixed" \
    OC_HARVEST_MOCK_COMMITS="$c601_delta" OC_HARVEST_MOCK_MAIN_COMMITS="$c601_recent" \
    OC_HARVEST_MOCK_PRS="$mock_prs" \
    OC_HARVEST_MOCK_LEDGER="$selftest_tmp/mock_ledger_empty.json" \
    run_engine "check" "mock/repo" "$selftest_tmp" "$mock_reg" "600" "" 2>&1)" || rc=$?
  # Assert the STATE, not a token: the disclosure note is labelled
  # NOTE(HELD_SET_SOAK) even when the clock is CLEAR, so searching that string
  # absent matches the note and reddens a correct run. The two anchors are
  # distinguishable by their age: the delta commit (deployed_ts 100000) reads
  # ">= 24h" (clear); a consulted twin (commit_ts 1790000000, NOW_TS
  # 1790003600) would read 1.0h and REFUSE. So a green run must be rc=0 AND
  # carry the clear-disclosure suffix.
  if [ "$rc" -eq 0 ] && oc_has "$out" ">= 24h"; then
    ok "#625: the main-resident index is a FALLBACK -- a member present in the delta keeps its own anchor (clock reads the ancient delta age, not the newer twin's)"
  else
    echo "  bad  - #625 the widened twin overrode the delta anchor; got rc=$rc ($out)"
  fi

  echo "selftest: ${ok_n}/${ok_n} OK"
  return 0
}

cmd_clusters() {
  local json_flag="" openfix_flag="" clock_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;;
      --json) json_flag="--json"; shift ;;
      --open-fix) openfix_flag="--open-fix"; shift ;;
      --clock) clock_flag="--clock"; shift ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  run_engine "clusters" "$UPSTREAM_REPO" "$REPO" "$REGISTRY_FILE" "" "$DECLARED_SUBJECT" $json_flag $openfix_flag $clock_flag
}

# --- Main Dispatcher ---
case "${1:-}" in
  scan) shift; cmd_scan "$@" ;;
  check) shift; cmd_check "$@" ;;
  record) shift; cmd_record "$@" ;;
  purge) shift; cmd_purge "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  clusters) shift; cmd_clusters "$@" ;;
  --selftest) cmd_selftest ;;
  -h|--help) usage 0 ;;
  *) usage ;;
esac