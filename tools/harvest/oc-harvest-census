  bash "$0" record --unit "ident-unit" --pr "555001" --issue "555001" --state-file "$mock_reg" >/dev/null 2>&1 || true
  bash "$0" record --unit "ident-unit" --pr "555002" --state-file "$mock_reg" >/dev/null 2>&1 || true
  if python3 -c '
