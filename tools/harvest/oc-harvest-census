cmd_purge() {
  local unit="" pr="" issue="" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --unit) [ $# -ge 2 ] || { echo "oc-harvest-census: --unit needs a value" >&2; usage; }; unit="$2"; shift 2 ;;
      --pr) [ $# -ge 2 ] || { echo "oc-harvest-census: --pr needs a value" >&2; usage; }; pr="$2"; shift 2 ;;
      --issue) [ $# -ge 2 ] || { echo "oc-harvest-census: --issue needs a value" >&2; usage; }; issue="$2"; shift 2 ;;
      --state-file) [ $# -ge 2 ] || { echo "oc-harvest-census: --state-file needs a value" >&2; usage; }; REGISTRY_FILE="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage 0 ;;
      *) usage ;;
    esac
  done
  if [ -z "$unit" ]; then
    usage
  fi
  # ---- REMOVAL IS FORBIDDEN (#707) -----------------------------------------
  # harvest.md: "REMOVAL IS FORBIDDEN -- there is deliberately no verb, flag or
  # procedure that deletes a `manual_records` entry. These records are
  # load-bearing in the direction that PREVENTS work ... deleting it would open
  # the way to filing a PR that is NOT owed."
  #
  # This verb contradicted that law: it deleted ANY matching record with no
  # status guard, so a `not-upstreamable` protection (#705) lasted only until
  # someone typed `purge --unit 705`. Its own selftest asserted the destruction
  # ("purged row no longer refuses the target").
  #
  # Refusal is the safe direction: refusing costs nothing, deleting re-opens an
  # unowed PR. `--dry-run` keeps its LISTING (information only, rc 0) and still
  # removes nothing.
  if [ "$dry_run" -ne 1 ]; then
    echo "purge: REFUSED -- removal is forbidden (harvest.md, #707)." >&2
    echo "       manual_records are load-bearing in the direction that PREVENTS work;" >&2
    echo "       deleting one re-opens filing a PR that is not owed." >&2
    echo "       Use --dry-run to LIST matching records (removes nothing)." >&2
    exit 2
  fi
  if [ ! -f "$REGISTRY_FILE" ]; then
    echo "Purge: registry uninitialized ($REGISTRY_FILE) - nothing to purge"
    exit 0
  fi
  python3 - "$REGISTRY_FILE" "$unit" "$pr" "$issue" "$dry_run" <<'OCPY'
import sys, json
reg_file, unit, pr_s, issue_s, dry_s = sys.argv[1:6]
with open(reg_file) as f:
    data = json.load(f)
records = data.get("manual_records", [])
pr = int(pr_s) if pr_s else None
issue = int(issue_s) if issue_s else None

def matches(r):
    if r.get("unit") != unit:
        return False
    if pr is not None and r.get("pr") != pr:
        return False
    if issue is not None and r.get("issue") != issue and issue not in (r.get("issues") or []):
        return False
    return True

kept, removed = [], []
for r in records:
    (removed if matches(r) else kept).append(r)

for r in removed:
    print("  - unit=%s pr=%s issue=%s recorded_at=%s" % (r.get("unit"), r.get("pr"), r.get("issue"), r.get("recorded_at")))
if dry_s == "1":
    print("DRY-RUN: %d of %d manual_records would be purged (unit=%s)" % (len(removed), len(records), unit))
    sys.exit(0)
# REMOVAL IS FORBIDDEN (#707): there is no code path here that writes the
# registry. The shell refuses a non-dry-run invocation before this point, and
# this block refuses too, so no future edit to the shell guard can leave a
# deletion reachable through the Python.
print("purge: REFUSED -- removal is forbidden (harvest.md, #707); "
      "%d matching of %d manual_records left intact." % (len(removed), len(records)),
      file=sys.stderr)
sys.exit(2)
OCPY
  exit 0
}

