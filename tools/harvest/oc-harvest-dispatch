    return 1
  fi

  # 11. issue #305: claim closure must be AUTHOR-QUALIFIED. A foreign lane's
  # closing row that merely MENTIONS #N in prose must NOT close the owner's
  # claim, while the two shapes that legitimately close a claim (a lane's own
  # completion row, and the administrative 'closed-issue stale claim sweep')
  # must keep working. Fixture lanes are distinct so no probe can be closed by
  # another probe's self-row.
  local clos_ledger="$st_dir/clos-ledger.json"
  cat << 'EOF' > "$clos_ledger"
{
  "workers": [
    {"uuid": "aaaa1111-1111-1111-1111-111111111111", "role": "editor", "topic_id": 201},
    {"uuid": "bbbb2222-2222-2222-2222-222222222222", "role": "editor", "topic_id": 202},
    {"uuid": "cccc3333-3333-3333-3333-333333333333", "role": "editor", "topic_id": 203},
    {"uuid": "dddd4444-4444-4444-4444-444444444444", "role": "editor", "topic_id": 204},
    {"uuid": "eeee5555-5555-5555-5555-555555555555", "role": "editor", "topic_id": 205},
    {"uuid": "ffff6666-6666-6666-6666-666666666666", "role": "editor", "topic_id": 206}
  ],
  "events": [
    {"n": 1, "kind": "claim", "by": "editor aaaa1111-1111-1111-1111-111111111111", "what": "CLAIM #264 — foreign-prose-close probe"},
    {"n": 2, "kind": "unclaim", "by": "editor bbbb2222-2222-2222-2222-222222222222", "what": "UNCLAIM #264 — stood down in favour of editor lane aaaa1111"},
    {"n": 3, "kind": "claim", "by": "editor cccc3333-3333-3333-3333-333333333333", "what": "CLAIM #301 — own-completion probe"},
    {"n": 4, "kind": "done", "by": "editor cccc3333-3333-3333-3333-333333333333", "what": "#301 COMPLETE - landed"},
    {"n": 5, "kind": "claim", "by": "editor dddd4444-4444-4444-4444-444444444444", "what": "CLAIM #305 — administrative-sweep probe"},
    {"n": 6, "kind": "unclaim", "by": "triage eeee5555-5555-5555-5555-555555555555", "what": "#305 — closed-issue stale claim sweep (H-5 batch)"},
    {"n": 7, "kind": "claim", "by": "editor-ffff6666", "what": "CLAIM #306 — short-form author probe"},
    {"n": 8, "kind": "close", "by": "editor ffff6666-6666-6666-6666-666666666666", "what": "COMPLETE #306 \u2014 short-form author resolved"},
    {"n": 9, "kind": "claim", "by": "", "what": "CLAIM #307 — author-less phantom probe (legacy by:null row)"}
  ]
}
EOF
  local clos_out="" clos_n=""
  clos_out="$(run_engine "test-active-claims" "$clos_ledger" "none" 2>&1)"
  clos_n="$(printf '%s' "$clos_out" | grep -o '"issue"' | wc -l | tr -d '[:space:]')"
  if [ "$clos_n" = "1" ]; then
