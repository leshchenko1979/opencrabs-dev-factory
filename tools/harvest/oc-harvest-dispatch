  git -C "$fence_repo" init -q -b main
  git -C "$fence_repo" config user.email "test@example.com"
  git -C "$fence_repo" config user.name "Test Runner"
  printf 'base\n' > "$fence_repo/src/fence/base.rs"
  git -C "$fence_repo" add -A
  git -C "$fence_repo" commit -q -m "base commit"

  # PROSE-ONLY: #701 in the subject, NO Issue-Ref trailer.
  printf 'prose\n' > "$fence_repo/src/fence/prose_only.rs"
  git -C "$fence_repo" add -A
  git -C "$fence_repo" commit -q -m "fix(unrelated): reword the note (#701)"

  # ANCHORED: a real Issue-Ref trailer for a DIFFERENT issue.
  printf 'anchored\n' > "$fence_repo/src/fence/anchored.rs"
  git -C "$fence_repo" add -A
  git -C "$fence_repo" commit -q -m "fix(anchored): real work on the anchored issue" --trailer "Issue-Ref: #702"

  local fence_ledger="$st_dir/fence-ledger.json"
  cat << 'EOF' > "$fence_ledger"
{
  "workers": [
    {"uuid": "99999999-9999-9999-9999-999999999999", "role": "editor", "topic_id": 301}
  ],
  "events": [
    {"n": 1, "kind": "claim", "by": "editor 99999999-9999-9999-9999-999999999999", "what": "CLAIM #701 — prose-only mention control"},
    {"n": 2, "kind": "claim", "by": "editor 99999999-9999-9999-9999-999999999999", "what": "CLAIM #702 — anchored trailer positive twin"}
  ]
}
EOF
  local fence_out="" fence_prose="" fence_anchor=""
  fence_out="$(run_engine "test-active-claims" "$fence_ledger" "$fence_repo" 2>&1)"
  fence_prose="$(printf '%s' "$fence_out" | python3 -c '
import json, sys
try:
    claims = json.load(sys.stdin)
except Exception:
    print("PARSE_FAIL"); raise SystemExit(0)
for c in claims:
    if c.get("issue") == 701:
        print(json.dumps(c.get("files"))); raise SystemExit(0)
print("NO_CLAIM")
')"
  if [ "$fence_prose" = "[]" ]; then
    echo "  ok 11e - #307: prose-only #N mention yields an EMPTY footprint (anchored fence)"
  else
    echo "  bad 11e - #307 prose-only #N mention must yield an EMPTY footprint, got ($fence_prose; out: $fence_out)"
    return 1
  fi
  fence_anchor="$(printf '%s' "$fence_out" | python3 -c '
import json, sys
try:
    claims = json.load(sys.stdin)
except Exception:
    print("PARSE_FAIL"); raise SystemExit(0)
for c in claims:
    if c.get("issue") == 702:
        print(json.dumps(c.get("files"))); raise SystemExit(0)
print("NO_CLAIM")
')"
  case "$fence_anchor" in
    *anchored.rs*)
      echo "  ok 11f - #307: trailer-anchored #N still resolves its footprint (positive twin)" ;;
    *)
      echo "  bad 11f - #307 anchored-trailer positive twin must resolve anchored.rs, got ($fence_anchor; out: $fence_out)"
      return 1 ;;
  esac

  # 11g/11h. The canonical closure predicate checks the AUTHOR arm against THIS
  # issue (#425). The deleted private copy closed a claim on lane identity
  # ALONE, so a lane's later row about a DIFFERENT issue closed this claim --
  # reporting an ACTIVE lane as IDLE. Fixture C: lane aaaa1111 claims #510 then
  # COMPLETEs #999 (a different issue); lane bbbb2222 claims #511 then COMPLETEs
  # #511. The #511 half is the POSITIVE CONTROL: a predicate that never closed
  # anything would satisfy the #510 half on its own.
  local diff_ledger="$st_dir/diff-ledger.json"
  cat << 'EOF' > "$diff_ledger"
{
  "workers": [
    {"uuid": "aaaa1111-1111-1111-1111-111111111111", "role": "editor", "topic_id": 201},
    {"uuid": "bbbb2222-2222-2222-2222-222222222222", "role": "editor", "topic_id": 202}
  ],
  "events": [
    {"n": 1, "kind": "claim", "by": "editor aaaa1111-1111-1111-1111-111111111111", "what": "CLAIM #510 — different-issue close probe"},
    {"n": 2, "kind": "done",  "by": "editor aaaa1111-1111-1111-1111-111111111111", "what": "COMPLETE #999 — an unrelated probe by the same lane"},
    {"n": 3, "kind": "claim", "by": "editor bbbb2222-2222-2222-2222-222222222222", "what": "CLAIM #511 — same-issue self-close control"},
    {"n": 4, "kind": "done",  "by": "editor bbbb2222-2222-2222-2222-222222222222", "what": "COMPLETE #511 — landed"}
  ]
}
EOF
  local diff_out=""
  diff_out="$(run_engine "test-active-claims" "$diff_ledger" "none" 2>&1)"
  if grep -q '"issue": 510' <<< "$diff_out" ; then
    echo "  ok 11g - #425: a same-lane close of a DIFFERENT issue leaves this claim OPEN"
  else
    echo "  bad 11g - #425 expected #510 to stay ACTIVE (the same lane closed a different issue), got ($diff_out)"
    return 1
  fi
  if grep -q '"issue": 511' <<< "$diff_out" ; then
    echo "  bad 11h - #425 same-issue self-close control: #511 must be CLOSED, got ($diff_out)"
    return 1
  else
    echo "  ok 11h - #425: same-issue self-close still closes (#511 gone - positive control)"
  fi

  # Leg count is DERIVED, never hardcoded: this line is only reached when every
  # leg passed, so the ok-count equals the total. A hardcoded total drifts the
  # moment a leg is added -- it read '19/19' while 20 legs ran.
  # The scan is over the whole script with an INDENT-ANCHORED pattern, not an
  # awk /^cmd_selftest()/,/^}/ range: a fixture heredoc inside this function
  # carries a column-0 brace, which closes the range after ~90 lines and
  # silently reported 0/0. The anchor also keeps this line out of its own count
  # (it starts with legs_total=, not with an echo).
  # 12. #564: a unit a prior lane SETTLED BY HAND must not be re-proposed. This
  #     tool had ZERO manual handling, so it gated only on check_upstream_pr,
  #     which looks for MERGED/OPEN upstream PRs and therefore cannot see a
  #     record whose entire point is that no PR is owed. Live instance: #209 was
  #     settled NOT UPSTREAMABLE on 2026-09-15 (ledger n=6231) and re-dispatched
  #     on 2026-09-24 to a lane that could only refuse it.
  echo "manual gate fixture" > "$mock_repo/manual.txt"
  git -C "$mock_repo" add manual.txt
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" \
    git -C "$mock_repo" commit -q -m "fix(config): manual gate fixture (#9911)" \
    --trailer "Issue-Ref: leshchenko1979/opencrabs#9911"
  local commit_m
  commit_m="$(git -C "$mock_repo" rev-parse HEAD)"

  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"
  export OC_HARVEST_NOW_TS="1789010000"

  # 12a. CONTROL FIRST: with an UNRELATED record present the unit still APPROVES,
  #      so 12b cannot pass merely because the gate refuses everything it sees.
  printf '{"manual_records": [{"unit": "some-other-unit", "pr": 1543, "issue": 9999}]}\n' > "$OC_HARVEST_REGISTRY_FILE"
  rc=0
  out="$(run_engine "vet" "$commit_m" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "APPROVED"; then
    echo "  ok 12a - #564 control: an UNRELATED manual record does not block a clean unit"
  else
    echo "  bad 12a - #564 control expected rc=0 APPROVED with an unrelated record, got rc=$rc ($out)"
    return 1
  fi

  # 12b. Match by ISSUE: the record names the issue, the target is the commit.
  printf '{"manual_records": [{"unit": "manual-gate-fixture", "pr": 1543, "issue": 9911}]}\n' > "$OC_HARVEST_REGISTRY_FILE"
  rc=0
  out="$(run_engine "vet" "$commit_m" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "MANUALLY_SETTLED"; then
    echo "  ok 12b - #564 a manual record matching by ISSUE refuses MANUALLY_SETTLED"
  else
    echo "  bad 12b - #564 expected rc=1 MANUALLY_SETTLED by issue, got rc=$rc ($out)"
    return 1
  fi

  # 12c. Match by UNIT: the record names the target STRING itself, which is how a
  #      lane records a unit whose issue number it never learned.
  printf '{"manual_records": [{"unit": "9911", "pr": 1543, "issue": 9999}]}\n' > "$OC_HARVEST_REGISTRY_FILE"
  rc=0
  out="$(run_engine "vet" "9911" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "MANUALLY_SETTLED"; then
    echo "  ok 12c - #564 a manual record matching by UNIT refuses MANUALLY_SETTLED"
  else
    echo "  bad 12c - #564 expected rc=1 MANUALLY_SETTLED by unit, got rc=$rc ($out)"
    return 1
  fi

  # 12d. A NOT-UPSTREAMABLE record says so and carries its reason. This is the
  #      half the registry could not express: the lane that settled #209 had only
  #      a `pr` field, wrote the upstream ISSUE number 1510 there, and the tool
  #      reported "filed in PR #1510" -- the OPPOSITE of the recorded decision.
  printf '{"manual_records": [{"unit": "manual-gate-fixture", "pr": 0, "issue": 9911, "status": "not-upstreamable", "reason": "carried upstream already"}]}\n' > "$OC_HARVEST_REGISTRY_FILE"
  rc=0
  out="$(run_engine "vet" "$commit_m" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "NOT UPSTREAMABLE" && oc_has "$out" "carried upstream already"; then
    echo "  ok 12d - #564 a not-upstreamable record refuses AS not-upstreamable, carrying its reason"
  else
    echo "  bad 12d - #564 expected rc=1 NOT UPSTREAMABLE + reason, got rc=$rc ($out)"
    return 1
  fi
  if oc_has "$out" "filed in PR"; then
    echo "  bad 12d-2 - #564 still emits a false 'filed in PR' claim for a not-upstreamable row: $out"
    return 1
  fi
  echo "  ok 12d-2 - #564 a not-upstreamable row emits NO 'filed in PR' claim"

  # 12e. A row with no PR number must not be reported as a filing either: three
  #      live rows carry pr:0 and the old emission rendered them as "filed in
  #      PR #0", which is a statement about the world that is false.
  printf '{"manual_records": [{"unit": "manual-gate-fixture", "pr": 0, "issue": 9911}]}\n' > "$OC_HARVEST_REGISTRY_FILE"
  rc=0
  out="$(run_engine "vet" "$commit_m" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 1 ] && oc_has "$out" "NO PR number recorded"; then
    echo "  ok 12e - #564 a row with no PR number refuses honestly instead of claiming PR #0"
  else
    echo "  bad 12e - #564 expected rc=1 'NO PR number recorded', got rc=$rc ($out)"
    return 1
  fi
  if oc_has "$out" "filed in PR #0"; then
    echo "  bad 12e-2 - #564 emitted the false 'filed in PR #0' claim: $out"
    return 1
  fi
  echo "  ok 12e-2 - #564 no false 'filed in PR #0' claim"

  # 12f. An ABSENT registry must not refuse: the gate is inert when there is no
  #      record file, so a box that has never recorded a unit behaves as before.
  export OC_HARVEST_REGISTRY_FILE="$st_dir/definitely-absent-registry.json"
  rm -f "$OC_HARVEST_REGISTRY_FILE"
  rc=0
  out="$(run_engine "vet" "$commit_m" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "APPROVED"; then
    echo "  ok 12f - #564 an ABSENT registry leaves the gate inert (no false refusal)"
  else
    echo "  bad 12f - #564 expected rc=0 APPROVED with no registry, got rc=$rc ($out)"
    return 1
  fi
  export OC_HARVEST_REGISTRY_FILE="$st_dir/harvest-registry.json"
  printf '{"manual_records": []}\n' > "$OC_HARVEST_REGISTRY_FILE"

  local legs_total
  legs_total="$(grep -cE '^[[:space:]]+echo "  ok ' "$0")"
  if [ "${legs_total:-0}" -lt 1 ]; then
    echo "  bad - leg-count derivation matched no ok-lines; the summary below cannot be trusted"
    return 1
  fi
  echo "selftest: ${legs_total}/${legs_total} OK"
  return 0
}

# --- Main Dispatcher ---
case "${1:-}" in
  vet) shift; cmd_vet "$@" ;;
  dispatch) shift; cmd_dispatch "$@" ;;
  --selftest) cmd_selftest ;;
  -h|--help) usage 0 ;;
  *) usage ;;
esac
