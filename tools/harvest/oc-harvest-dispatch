  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" \
    git -C "$mock_repo" commit -q -m "feat(orphan): add the file this issue exists to add (#601)" --trailer "Issue-Ref: #601"
  echo "follow-up truncation fix" > "$mock_repo/src/orphan/added.rs"
  git -C "$mock_repo" add src/orphan/added.rs
  GIT_COMMITTER_DATE="2026-08-01T12:00:00Z" GIT_AUTHOR_DATE="2026-08-01T12:00:00Z" \
    git -C "$mock_repo" commit -q -m "fix(orphan): truncate the record as a true prefix (#601)" --trailer "Issue-Ref: #601"
  local commit_601
  commit_601="$(git -C "$mock_repo" rev-parse HEAD)"

  export OC_HARVEST_MOCK_HIERARCHY="$mock_hier_file"
  export OC_HARVEST_MOCK_DEPLOYED_TS="100000"
  rc=0
  out="$(run_engine "vet" "$commit_601" "$mock_repo" "adolfousier/main" "adolfousier/opencrabs" "false" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ] && oc_has "$out" "APPROVED" && oc_has "$out" "ADVISORY" && ! oc_has "$out" "UPSTREAM_VOID"; then
    echo "  ok 8g - vet #601 (same-issue add+modify, path absent upstream) -> APPROVED with ADVISORY, exit 0"
  else
