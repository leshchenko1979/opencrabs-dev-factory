  # commit that merely MENTIONED the issue in its subject contributed its files
  # to the claim and fenced an unrelated harvest. A claim whose issue appears
  # ONLY in commit prose must now resolve to an EMPTY footprint (11e), while a
  # trailer-anchored commit still supplies its file (11f, the positive twin —
  # without it a resolver that always returned [] would pass 11e).
  local fence_repo="$st_dir/fence-repo"
