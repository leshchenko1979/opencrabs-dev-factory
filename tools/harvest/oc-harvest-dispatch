  else
    echo "  bad 11 - #305 expected exactly 1 active claim, got '$clos_n' ($clos_out)"
    return 1
  fi
  if grep -q '"issue": 264' <<< "$clos_out" ; then
    echo "  ok 11b - #305: the surviving active claim is the foreign-mentioned #264"
  else
    echo "  bad 11b - #305 expected #264 to survive as active, got ($clos_out)"
    return 1
  fi
  if ! grep -qE '"issue": (301|305|306)' <<< "$clos_out" ; then
    echo "  ok 11c - #305: own-completion, admin-sweep and short-form self-close all still close"
  else
    echo "  bad 11c - #305 expected #301/#305/#306 all closed, got ($clos_out)"
    return 1
  fi
  if grep -q '"uuid": ""' <<< "$clos_out" ; then
    echo "  bad 11d - #305 an author-less claim row surfaced as an active claim owned by the empty uuid"
    return 1
  else
