    t_ok "no_cancel: full-sha ref dispatch carries -f ref=<sha> -f no_cancel=true (immutable cutover)"
  else t_bad "no_cancel full-sha (rc=$ncl_sha_rc flag=$ncl_sha_flag ref=$ncl_sha_ref hits=$ncl_hits)"; fi
