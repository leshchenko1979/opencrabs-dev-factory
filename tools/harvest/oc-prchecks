  case "$ncl_hits" in *"-f ref=$SHA"*)   ncl_sha_ref=1 ;; esac
  ncl_br_flag=0; ncl_br_disp=0; ncl_br_rc=-1
  ncl_leg some-branch
  ncl_br_rc="$ncl_rc"
  case "$ncl_hits" in *"no_cancel=true"*) ncl_br_flag=1 ;; esac
  case "$ncl_hits" in *"workflow run"*)   ncl_br_disp=1 ;; esac
