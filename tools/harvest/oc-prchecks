#!/usr/bin/env bash
# =============================================================================
# oc-prchecks — one-command PR-lane lint gate over pr-checks.yml (KERNEL C5,
# 2026-08-29 four-lens review run-2; design: /root/oc-work/oc-prchecks-design-20260829.md).
#
# Kills the 4-step flag-sensitive hand ritual of editor.md Phase 5:
#   shape gate (full sha only) -> LOUD yml-on-carrier check -> dispatch under
#   a state-dir LOCK -> TIME-WINDOW RUN ADOPTION -> watch -> per-step report
#   with the fmt soft-fail EXPOSED (job-green hides fmt failures; this tool
#   reads the STEP).
#
# v0.4.48 Duty-7 rebuild (field lesson, run 33277921811): workflow_dispatch
# runs set headSha to the DISPATCH REF (the carrier branch head), NEVER to the
# `-f ref=<sha>` input — an old sha-bound filter on the INPUT could never match.
# v0.4.53 (owner-approved headSha adoption, rebuilt after a phantom): the
# selector now matches headSha==RESOLVED-CARRIER-HEAD (verified: every run lists
# the same carrier head, so this is a hard always-true gate for valid carrier
# dispatches, not a per-input discriminator), with a -5s-buffered window floor
# and LATEST-wins, all under the shared dispatch lock held through adoption.
# #631 (2026-09-27): the lock does NOT make the newest run ours — it only
# serializes dispatch+adopt, and a run created while we waited is another
# lane's. Every run-list field is identical across concurrent dispatches
# (all carry the carrier headSha), so the adopted run is now PINNED by the
# 40-hex in its job name, `PR-lane gates (<sha>)`, via oc_job_sha, and refused
# rc 4 on mismatch; a queued run whose jobs are not materialised journals
# adoption_pin=unpinned rather than passing silently.
# Cross-lane decoy adoption is impossible because the lock serializes
# dispatch+adopt and the newest run in window is always this lane's own.
#
# Usage:
#   oc-prchecks [<branch-or-sha> | resume <run-id> | wait <ref>] [--wait N] [--budget N] [--poll S] [--repo SLUG-or-PATH] [--carrier C] [--no-log]
#   oc-prchecks --selftest          offline, gh-shim injected (zero network)
#
# Defaults: --repo leshchenko1979/opencrabs, --carrier ci/quick-build-linux,
# --wait 600 (15s poll). Env: OC_GH (gh shim), OC_PRCHECKS_POLL,
# OC_PRCHECKS_RESOLVE_WAIT, OC_PRCHECKS_RESOLVE_POLL,
# OC_PRCHECKS_DEDUP_WINDOW (pre-dispatch dedup window, seconds, default 21600=6h;
# a same-sha/ref run witness inside the window is adopted if still live —
# kills the re-dispatch/concurrency-cancel loop, 2026-09-08 study),
# OC_DEPLOY_STATE_DIR (lock home), OC_PRCHECKS_LOCK_WAIT (tests/ops).
#
# Dispatch inputs: always `-f ref=<resolved sha>`; `-f fast=true` in --fast mode;
# `-f no_cancel=true` when the INPUT ref is a full 40-hex sha — an immutable
# cutover/swap-mode gate ref, where a same-sha re-dispatch must NOT SIGTERM the
# in-flight run (owner GO 2026-09-17 22:59Z; closes run 35279942039). Branch
# refs omit it: a moved PR-lane head genuinely invalidates the old verdict, so
# supersede-on-cancel stays correct there.
#
# Exit: 0 GREEN (terminal, run conclusion success, zero FAILED steps/jobs)
#       2 usage / sha-shape / unknown ref / repo-path-no-origin
#       3 RED (run conclusion failure/timed_out/startup_failure,
#         or a FAILED step — soft-fail exposed; skipped/neutral steps pass)
#       5 non-terminal at verdict time (resume: oc-prchecks resume <id> --wait N)
# Verdict rule (v0.4.56, owner Go 08-31 03:05Z): the RUN conclusion is the
# verdict; per-step detail is a tiebreak ONLY for conclusion=failure steps
# (kills false GREEN on cancelled and false RED on skipped fmt — issue-lane
# findings 2026-08-30, runs 33316539757/33341579381 et al).
#       4 dispatch-or-api-or-lock failure (incl. yml-missing-on-carrier,
#         adoption timeout, dispatch lock busy)
#       5 still in flight after --wait (run id + URL on stdout for resume)
#       7 carrier head unresolvable via branches API (fork-lane gate / missing carrier ref)
#         — NEVER adopt a run on a blind window (false-GREEN finding 2026-08-31)
#       8 AMBIGUOUS (#115 B, fail-closed per n=1663 Q2): C-F2 found a same-ref
#         run witness in the journal but gh cannot determine its liveness —
#         dispatch REFUSED (would risk concurrency-cancelling a live run).
#         Resolve: gh run view <id>; live -> resume <id>; dead -> re-run.
# =============================================================================
# --- oc-snap guard: run from an immutable mirror (fork #167; tools/lib/oc-snap.sh)
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(dirname "$0")"; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_SNAP="$OC_TOOLS_DIR/lib/oc-snap.sh"
if [ -f "$_OC_SNAP" ]; then . "$_OC_SNAP"; oc_snap_guard "$0" "$@"; fi

set -u
set -o pipefail   # F7 (lens F, v0.4.72): pipeline failures are never masked
set -e            # F-lens (HQ GO batch 2026-09-09): a bare-typo command like the
                  # old OC_PR_SKIPPED_DISPAT line (n=2226 batch) must abort the
                  # tool, not be swallowed — silent no-op on unbound var/typos
                  # is the #124 time-bomb class.
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-prchecks" "$@"; else oc_log_finish() { :; }; fi
_OC_PATCH_LIB="$OC_TOOLS_DIR/lib/oc-patch.sh"   # #631: oc_job_sha for the adoption sha pin
[ -f "$_OC_PATCH_LIB" ] && . "$_OC_PATCH_LIB"
# Exit-honesty guard (n=1725 A, Triage verdict n=1721; field tools.log:3190,
# 2026-09-06T18:22:17Z): a harness budget-kill of an in-flight watch journaled
# exit 0 with NO verdict and NO signal extras — a success-shaped row for an
# interrupted run, despite the lib TERM/INT/HUP traps (26da3914). The kill
# mechanism was not fully reconstructed; the CLASS is killed here instead:
_pr_cleanup_checkpoint() {
  if [ -n "${CHECKPOINT_FILE:-}" ] && [ -f "$CHECKPOINT_FILE" ]; then
    rm -f "$CHECKPOINT_FILE" 2>/dev/null || :
  fi
}

# once a run is ADOPTED (extra run_id/resume present), an exit 0 without
# extra.verdict is never legitimate in this tool's state machine — re-journal
# as 5 (in-flight-timeout, nearest RC-CONTRACT code) + anomaly marker.
# Pre-adoption exits (--help, usage, shape/fork gates) pass through untouched.
_pr_exit_guard() {
  local _rc="${1:-$?}"
  trap - EXIT
  if [ "$_rc" -eq 0 ] && command -v jq >/dev/null 2>&1; then
    local _e="${OC_LOG_EXTRA:-{\}}"
    if printf '%s' "$_e" | jq -e '(has("run_id") or has("resume")) and (has("verdict") | not)' >/dev/null 2>&1; then
      oc_log_extra "anomaly" "exit0-without-verdict"
      oc_log_extra "watch" "interrupted"
      _rc=5
    fi
  fi
  # Clean up in-flight checkpoint on clean / completed exits (< 128)
  # Preserves checkpoint if killed by signal (TERM=143, INT=130, HUP=129, KILL)
  local _sig=""
  if command -v jq >/dev/null 2>&1; then
    _sig="$(printf '%s' "${OC_LOG_EXTRA:-{\}}" | jq -r '.signal // empty' 2>/dev/null)"
  fi
  if [ "$_rc" -lt 128 ] && [ -z "$_sig" ]; then
    _pr_cleanup_checkpoint
  fi
  oc_log_finish "$_rc"
  exit "$_rc"
}
trap '_pr_exit_guard' EXIT

PROG="$(basename "$0")"
GH_BIN="${OC_GH:-gh}"
GH_RETRIES="${OC_PRCHECKS_GH_RETRIES:-3}"
GH_BACKOFF="${OC_PRCHECKS_GH_BACKOFF:-5}"
# gh_retry (Cycle c14): 403/rate-limit exponential backoff wrapper. Transient
# GitHub quota errors (rate limit / secondary rate / abuse / 403) sleep with
# exponential backoff instead of hard-failing the poll loop; any other error
# passes through immediately with its original rc. Poll loops MUST call this,
# never $GH_BIN directly.
gh_retry() {
  local attempt=0 delay="$GH_BACKOFF" _rc=0 _out="" _e=""
  local _errf; _errf="$(mktemp)" || return 1
  while :; do
    _out="$("$GH_BIN" "$@" 2>"$_errf")"; _rc=$?
    if [ "$_rc" -eq 0 ]; then printf '%s' "$_out"; rm -f "$_errf"; return 0; fi
    _e="$(cat "$_errf" 2>/dev/null)"
    case "$_e" in
      *[Rr]ate*limit*|*[Ss]econdary*rate*|*[Aa]buse*detection*|*403*)
        attempt=$((attempt+1))
        if [ "$attempt" -gt "$GH_RETRIES" ]; then cat "$_errf" >&2; rm -f "$_errf"; printf '%s' "$_out"; return "$_rc"; fi
        echo "$PROG: gh 403/rate-limit (attempt $attempt/$GH_RETRIES) - backoff ${delay}s" >&2
        oc_log_extra "gh_backoff" "$attempt" 2>/dev/null || :
        sleep "$delay" 2>/dev/null || sleep 1
        delay=$((delay*2));;
      *) cat "$_errf" >&2; rm -f "$_errf"; printf '%s' "$_out"; return "$_rc";;
    esac
  done
}
REPO="leshchenko1979/opencrabs"
CARRIER="ci/quick-build-linux"
WAIT_SECS=600
POLL="${OC_PRCHECKS_POLL:-30}"
RESOLVE_WAIT="${OC_PRCHECKS_RESOLVE_WAIT:-60}"
RESOLVE_POLL="${OC_PRCHECKS_RESOLVE_POLL:-15}"
LOCK_DIR="${OC_DEPLOY_STATE_DIR:-${OC_DEV_STATE:-$HOME/.opencrabs/profiles/ops/opencrabs-dev}}"
LOCK_FILE="$LOCK_DIR/.oc-prchecks-dispatch.lock"
LOCK_WAIT="${OC_PRCHECKS_LOCK_WAIT:-90}"
FAULT_TOOL="${OC_PRCHECKS_FAULT_SCOPE:-$OC_TOOLS_DIR/harvest/oc-pr-fault-scope}"   # E5: RED triage backend

# In-flight run checkpoint directory and state file
CHECKPOINT_DIR="$LOCK_DIR/runs/in-flight"
CHECKPOINT_FILE=""

_pr_write_checkpoint() {
  local actor="${OC_ACTOR:-unknown}"
  [ "$actor" = "unknown" ] && [ -n "${OPENCRABS_SESSION_ID:-}" ] && actor="$OPENCRABS_SESSION_ID"
  [ -n "$RUN_ID" ] || return 0
  mkdir -p "$CHECKPOINT_DIR" 2>/dev/null || return 0
  CHECKPOINT_FILE="$CHECKPOINT_DIR/${actor}.json"
  local tmp_cp="${CHECKPOINT_FILE}.tmp.$$"
  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg session_id "$actor" \
      --arg run_id "$RUN_ID" \
      --arg repo "$REPO" \
      --arg carrier "$CARRIER" \
      --arg ref "${REF:-}" \
      --arg sha "${SHA:-}" \
      --arg pid "$$" \
      --arg started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --argjson wait_secs "${WAIT_SECS:-600}" \
      --argjson poll "${POLL:-30}" \
      '{session_id:$session_id, run_id:$run_id, repo:$repo, carrier:$carrier, ref:$ref, sha:$sha, pid:($pid|tonumber), started_at:$started_at, wait_secs:$wait_secs, poll:$poll}' > "$tmp_cp" 2>/dev/null && mv -f "$tmp_cp" "$CHECKPOINT_FILE" 2>/dev/null || rm -f "$tmp_cp"
  fi
}

CALL_ARGS="$*"   # C-#1: backoff identity — same args dying rc=2 repeatedly
usage() { # [reason] — C-#1: prints WHY before the usage block. A repeat of the
  # SAME args inside 120s sleeps 2s..10s (60-row storm 2026-08-31 20:51Z: a
  # silent sub-second rc=2 got retried in a tight loop).
  [ $# -gt 0 ] && echo "$PROG: $1" >&2
  local _h _cf _now _ts=0 _cnt=0
  _h="$(printf '%s' "$CALL_ARGS" | cksum | cut -d' ' -f1)"
  _cf="$LOCK_DIR/.oc-prchecks-rc2"
  _now="$(date +%s)"
  if [ -f "$_cf" ]; then
    _ts="$(cut -d' ' -f1 "$_cf" 2>/dev/null)"; _ts="${_ts:-0}"
    [ "$(cut -d' ' -f2 "$_cf" 2>/dev/null)" = "$_h" ] || _cnt=0
    [ "$(( _now - _ts ))" -le 120 ] || _cnt=0
    case "$_cnt" in ''|*[!0-9]*) _cnt=0 ;; esac
  fi
  _cnt=$(( _cnt + 1 ))
  printf '%s %s %s\n' "$_now" "$_h" "$_cnt" > "$_cf" 2>/dev/null || :
  [ "$_cnt" -gt 1 ] && sleep $(( _cnt * 2 < 10 ? _cnt * 2 : 10 ))
  cat >&2 <<EOS
Usage: $PROG [<branch-or-sha> | resume <run-id> | wait <ref>] [--wait N] [--budget N] [--poll S] [--repo SLUG-or-PATH] [--carrier C] [--fault-scope PR] [--no-log]
  resume <run-id>  re-attach to a run this lane WITNESSED (rc-5 stdout / journal extra.run_id);
  wait <ref>       single-invocation wait/watch loop with budget (default 2700s, poll 30s) — Cycle 5 C-1
                   skips shape gate / yml check / dispatch / lock / adoption, goes straight to watch+verdict
Exit: 0 GREEN / 2 usage-or-shape-fork-lane / 3 RED / 4 dispatch-or-api-or-lock / 5 in-flight-timeout / 6 CANCELLED-superseded (P4) / 7 carrier-head-unresolvable / 8 AMBIGUOUS-same-ref-witness-unverifiable (fail-closed, dispatch refused, #115B)
EOS
  exit 2
}

# ---------- selftest (offline, injectable gh shim) ---------------------------
mk_shim() { # $1=path $2=scenario — emits a gh stub serving canned fixtures.
  # run list is CARRIER-SHAPED like reality (v0.4.48 field lesson + v0.4.53):
  # headSha on workflow_dispatch runs IS the carrier ref (all runs share the
  # carrier head), so the selector hard-matches headSha==carrier head and the
  # window discriminates (buffered floor + LATEST-wins: under the shared lock a
  # newer carrier run can only be this lane's own). Decoys: wrong event (333),
  # wrong branch (444), createdAt before the buffered floor (555); 222 = the
  # lane's own newly-created run (newest — must be adopted); 111 = an older run
  # the OLD earliest-wins rule would decoy-adopt.
  cat > "$1" <<EOS
#!/usr/bin/env bash
S="$2"
case "\$*" in
  *"api repos/"*"/commits/"*)
    [ "\$S" = "unknown_ref" ] && exit 1
    printf '%s\n' "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;;
  *"api repos/"*"contents/"*)
    [ "\$S" = "yml_missing" ] && exit 1
    # Raw yml body (Accept: application/vnd.github.raw) — the tool greps it for
    # the no_cancel input, so the fixture IS the live contract under test.
    # Default = the POST-HQ shape (input declared). yml_no_nocancel = the
    # 2026-09-17 live shape (tip 43fddde3d): NO such input, bare
    # cancel-in-progress — the tool must omit the flag, not 422.
    if [ "\$S" = "yml_no_nocancel" ]; then
      cat <<'YEOF'
name: PR-lane gates
on:
  workflow_dispatch:
    inputs:
      ref:
        type: string
concurrency:
  group: prchecks-live
  cancel-in-progress: true
YEOF
    else
      cat <<'YEOF'
name: PR-lane gates
on:
  workflow_dispatch:
    inputs:
      ref:
        type: string
      no_cancel:
        type: boolean
concurrency:
  group: prchecks-live
  cancel-in-progress: \${{ !inputs.no_cancel }}
YEOF
    fi ;;
  *"api repos/"*"git/ref/heads/"*)
    [ "\$S" = "carrier_unresolvable" ] && exit 1
    # emulate gh api --jq: the tool asks for '.object.sha', gh returns ONLY the sha
    printf '%s\n' 'ffffffffffffffffffffffffffffffffffffffff' ;;
  *"workflow run"*)
    [ "\$S" = "dispatch_fail" ] && exit 1
    # Race-guard fixture: rejects ONLY the no_cancel-carrying dispatch, with the
    # real 422 body, so the retry-without-flag path is exercised end to end.
    case "\$S" in
      dispatch_reject_nocancel)
        case "\$*" in
          *no_cancel=true*) echo 'could not create workflow dispatch event: HTTP 422: Unexpected inputs provided: ["no_cancel"]' >&2; exit 1 ;;
        esac ;;
    esac
    echo "dispatched \$*" >> "${GHDISPATCH_LOG:-/dev/null}"
    exit 0 ;;
  *"run list"*)
    case "\$S" in
      resolve_timeout)
        printf '[{"databaseId":333,"event":"push","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":555,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"}]\n' \
          "\$(date -u -d '+5 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '-60 seconds' +%Y-%m-%dT%H:%M:%SZ)" ;;
      supersede_pins|supersede_nopin)
        # #703 fixture. 900001 = MY cancelled run; 900003 = a NEWER peer pinning a
        # DIFFERENT sha (a different concurrency group - it cannot have cancelled
        # mine); 900002 = a peer pinning MY sha (same group - the real superseder).
        # supersede_nopin drops 900002, so no candidate shares the group.
        if [ "\$S" = "supersede_nopin" ]; then
          printf '[{"databaseId":900001,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":900003,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"}]\n' \
            "\$(date -u -d '-40 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '-2 seconds' +%Y-%m-%dT%H:%M:%SZ)"
        else
          printf '[{"databaseId":900001,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":900002,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":900003,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"}]\n' \
            "\$(date -u -d '-40 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '-5 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '-2 seconds' +%Y-%m-%dT%H:%M:%SZ)"
        fi ;;
      *)
        printf '[{"databaseId":222,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":111,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":333,"event":"push","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":444,"event":"workflow_dispatch","headBranch":"main","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"},{"databaseId":555,"event":"workflow_dispatch","headBranch":"ci/quick-build-linux","headSha":"ffffffffffffffffffffffffffffffffffffffff","createdAt":"%s"}]\n' \
          "\$(date -u -d '+9 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '+5 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '+5 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '+5 seconds' +%Y-%m-%dT%H:%M:%SZ)" "\$(date -u -d '-30 seconds' +%Y-%m-%dT%H:%M:%SZ)" ;;
    esac ;;
  *"run view"*"--json jobs"*)
    case "\$S" in
      adopt_sha_foreign) printf '{"jobs":[{"name":"gate / PR-lane gates (bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)","conclusion":"success","steps":[]}]}\n' ;;
      adopt_sha_own)     printf '{"jobs":[{"name":"gate / PR-lane gates (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)","conclusion":"success","steps":[]}]}\n' ;;
      fmt_failed)  printf '{"jobs":[{"name":"lint","conclusion":"success","steps":[{"name":"cargo fmt","conclusion":"failure"}]},{"name":"test","conclusion":"success","steps":[]}]}\n' ;;
      fmt_skipped) printf '{"jobs":[{"name":"lint","conclusion":"success","steps":[{"name":"cargo fmt","conclusion":"skipped"}]}]}\n' ;;
      job_failed)  printf '{"jobs":[{"name":"lint","conclusion":"failure","steps":[{"name":"cargo fmt","conclusion":"success"}]}]}\n' ;;
      fmt_gate_ok) printf '{"jobs":[{"name":"lint","conclusion":"success","steps":[{"name":"Check formatting","conclusion":"success"},{"name":"Apply cargo fmt (fix mode)","conclusion":"skipped"},{"name":"Upload fmt-fix patch","conclusion":"skipped"}]}]}\n' ;;
      fmt_gate_failed) printf '{"jobs":[{"name":"lint","conclusion":"success","steps":[{"name":"Check formatting","conclusion":"failure"}]}]}\n' ;;
      supersede_*)
        # #703: REAL gh keys the job list on the run id, so the fixture must too -
        # otherwise both sides of the comparison read the same pin and the
        # discriminator is untestable. 900001/900002 pin aaaa; 900003 pins bbbb.
        case "\$*" in
          *900001*) printf '{"jobs":[{"name":"gate / PR-lane gates (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)","conclusion":"cancelled","steps":[]}]}\n' ;;
          *900002*) printf '{"jobs":[{"name":"gate / PR-lane gates (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)","conclusion":"success","steps":[]}]}\n' ;;
          *900003*) printf '{"jobs":[{"name":"gate / PR-lane gates (bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb)","conclusion":"success","steps":[]}]}\n' ;;
          *)        printf '{"jobs":[{"name":"gate / PR-lane gates (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)","conclusion":"success","steps":[]}]}\n' ;;
        esac ;;
      *)           printf '{"jobs":[{"name":"gate / PR-lane gates (aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)","conclusion":"success","steps":[]},{"name":"lint","conclusion":"success","steps":[{"name":"cargo fmt","conclusion":"success"}]},{"name":"test","conclusion":"success","steps":[]}]}\n' ;;   # #631: real job names carry the tested sha
    esac ;;
  *"run view"*)
    case "\$S" in
      inflight)       printf '{"status":"in_progress","conclusion":null,"headBranch":"ci/quick-build-linux","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' && exit 0 ;;
      cancelled)      printf '{"status":"completed","conclusion":"cancelled","headBranch":"ci/quick-build-linux","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' ;;
      supersede_*)    printf '{"status":"completed","conclusion":"cancelled","headBranch":"ci/quick-build-linux","event":"workflow_dispatch","createdAt":"%s","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' "\$(date -u -d '-60 seconds' +%Y-%m-%dT%H:%M:%SZ)" ;;
      run_failed)     printf '{"status":"completed","conclusion":"failure","headBranch":"ci/quick-build-linux","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' ;;
      nullconclusion) printf '{"status":"completed","conclusion":null,"headBranch":"ci/quick-build-linux","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' ;;
      run_view_fail)  exit 1 ;;
      run_view_die)   exit 1 ;;
      rate_limited)
        _cf="\$0.count"; _nn="\$(cat "\$_cf" 2>/dev/null || echo 0)"; _nn=\$((_nn+1)); printf '%s' "\$_nn" > "\$_cf";
        if [ "\$_nn" -le 2 ]; then echo "gh: API rate limit exceeded (403 secondary rate limit, abuse detection)" >&2; exit 1; fi;
        printf '{"status":"completed","conclusion":"success","headBranch":"ci/quick-build-linux","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' ;;
      adopt_mismatch) printf '{"status":"completed","conclusion":"success","headBranch":"main","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' ;;
      *)              printf '{"status":"completed","conclusion":"success","headBranch":"ci/quick-build-linux","event":"workflow_dispatch","headSha":"ffffffffffffffffffffffffffffffffffffffff"}\n' ;;
    esac ;;
  *) printf '{}\n' ;;
esac
EOS
  chmod +x "$1"
}

do_selftest() {
  D="$(mktemp -d)"; trap '_rc=$?; rm -rf "$D"; oc_log_finish "$_rc"' EXIT
  mkdir -p "$D/state"
  local pass=0 fail=0 SHA="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  t_ok()  { pass=$((pass+1)); echo "selftest: $1  OK"; }
  t_bad() { fail=$((fail+1)); echo "selftest: $1 FAIL"; }
  export OC_PRCHECKS_PIN_TRIES=1   # #631: shim answers instantly; no wait loop in tests
  run_t() { # $1=scenario $2..=args ; echoes rc in $T_RC, out in $T_OUT
    mk_shim "$D/gh" "$1"; shift
    # set -e survival (v0.4.124): negative-path scenarios EXPECT nonzero rc —
    # capture it explicitly or set -e aborts the whole selftest on the first
    # expected failure (the exact silent-abort class this batch's set -e is
    # meant to surface, biting its own test harness first).
