  OC_ACTOR="test-actor-123" OC_GH="$D/gh" OC_DEPLOY_STATE_DIR="$D/state" OC_PRCHECKS_LOCK_WAIT=5 \
    OC_PRCHECKS_RESOLVE_WAIT=2 OC_PRCHECKS_RESOLVE_POLL=1 OC_PRCHECKS_POLL=1 \
    OC_TOOLS_NOLOG=1 "$SELF" "$SHA" --wait 120 >/dev/null 2>&1 &
