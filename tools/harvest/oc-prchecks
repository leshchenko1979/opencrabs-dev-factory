  # INPUT, so it may only be sent when the carrier yml declares it. Live shape at
  # the report (tip 43fddde3d) declares NO no_cancel and still 422s any dispatch
  # that carries it — every full-sha gate died rc 4. The tool must read the yml,
  # not assume: yml_no_nocancel fixture -> flag omitted, dispatch still proceeds.
  ncl_leg_nosha() { # $1=shim scenario -> rc in ncl_rc, dispatch log in ncl_hits, stdout+stderr in ncl_out
    : > "$NCL_LOG"
    mk_shim "$D/gh" "$1"
    ncl_out="$(OC_GH="$D/gh" OC_DEPLOY_STATE_DIR="$D/state" OC_PRCHECKS_LOCK_WAIT=5 \
      OC_PRCHECKS_RESOLVE_WAIT=2 OC_PRCHECKS_RESOLVE_POLL=1 OC_PRCHECKS_POLL=1 \
      OC_TOOLS_NOLOG=1 "$SELF" "$SHA" 2>&1)" && ncl_rc=0 || ncl_rc=$?
    ncl_hits="$(cat "$NCL_LOG" 2>/dev/null)"
  }
  ncl_leg_nosha yml_no_nocancel
  if [ "$ncl_rc" -eq 0 ] && case "$ncl_hits" in *"no_cancel=true"*) false ;; *) true ;; esac \
     && case "$ncl_hits" in *"-f ref=$SHA"*) true ;; *) false ;; esac; then
    t_ok "no_cancel: yml WITHOUT the input -> flag omitted, full-sha dispatch still succeeds (no 422)"
  else t_bad "no_cancel contract probe (rc=$ncl_rc hits=$ncl_hits)"; fi
  # RACE GUARD: probe saw the input but the dispatch 422s on it anyway (yml
  # reverted between the two calls) -> retry WITHOUT the flag, gate survives.
  # The shim writes a dispatch line ONLY on success, so exactly one line (the
  # retry, flag-free) plus the retry notice is the proof of the two-attempt path.
  ncl_leg_nosha dispatch_reject_nocancel
  ncl_tries="$(grep -c 'dispatched' "$NCL_LOG" 2>/dev/null || echo 0)"
  if [ "$ncl_rc" -eq 0 ] && [ "$ncl_tries" -eq 1 ] \
     && case "$ncl_out" in *"retrying without it"*) true ;; *) false ;; esac \
     && case "$ncl_hits" in *"no_cancel=true"*) false ;; *) true ;; esac \
     && case "$ncl_hits" in *"-f ref=$SHA"*) true ;; *) false ;; esac; then
    t_ok "no_cancel: 422 on the flag -> auto-retry without it, gate survives (race guard)"
  else t_bad "no_cancel race guard (rc=$ncl_rc tries=$ncl_tries hits=$ncl_hits out=$ncl_out)"; fi
  unset GHDISPATCH_LOG

  echo "selftest: $pass/$((pass+fail)) passed"
  [ "$fail" -eq 0 ]
}
