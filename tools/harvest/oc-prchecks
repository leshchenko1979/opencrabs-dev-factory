# 35279942039: `Run tests` cancelled by our own same-sha re-dispatch of 48c6f14b.
#
# GATED ON THE LIVE YML CONTRACT (Triage QUIRK 2026-09-17 23:03Z): the flag is
# passed ONLY when the carrier yml actually declares the input (step 2 probe).
# Until HQ lands it, full-sha dispatch keeps working exactly as before — the
# tool is correct against BOTH yml versions and needs no coordinated ordering.
NO_CANCEL_SENT=0
if [ "$REF_IS_SHA" -eq 1 ] && [ "$YML_HAS_NO_CANCEL" -eq 1 ]; then
  DISPATCH_ARGS+=(-f "no_cancel=true")
  NO_CANCEL_SENT=1
fi
# stderr captured (stdout to /dev/null): the 422 body names the offending input,
# which is the diagnostic a lane needs. `set -e` survival via explicit rc.
set +e
DISPATCH_ERR="$("$GH_BIN" workflow run pr-checks.yml --repo "$REPO" --ref "$CARRIER" "${DISPATCH_ARGS[@]}" 2>&1 >/dev/null)"
DISPATCH_RC=$?
set -e
if [ "$DISPATCH_RC" -ne 0 ] && [ "$NO_CANCEL_SENT" -eq 1 ]; then
  # Race guard: the probe saw the input but the dispatch 422s on it anyway (yml
  # reverted/rolled between the two calls). Retry WITHOUT the flag rather than
  # failing a full-sha gate over an optimisation — the no_cancel benefit is lost
  # for this dispatch, never the gate itself.
  echo "$PROG: dispatch with no_cancel=true rejected (rc=$DISPATCH_RC) — retrying without it: ${DISPATCH_ERR:-no stderr}" >&2
  oc_log_extra "no_cancel_retry" "1"
  DISPATCH_ARGS=(-f "ref=$SHA")
  [ "$FAST_MODE" -eq 1 ] && DISPATCH_ARGS+=(-f "fast=true")
  NO_CANCEL_SENT=0
  set +e
  DISPATCH_ERR="$("$GH_BIN" workflow run pr-checks.yml --repo "$REPO" --ref "$CARRIER" "${DISPATCH_ARGS[@]}" 2>&1 >/dev/null)"
  DISPATCH_RC=$?
  set -e
fi
if [ "$DISPATCH_RC" -ne 0 ]; then
  echo "$PROG: dispatch failed (repo=$REPO carrier=$CARRIER)${DISPATCH_ERR:+ — $DISPATCH_ERR}" >&2
  oc_log_extra "dispatch" "failed"
  flock -u 8
  exit 4
fi
oc_log_extra "dispatch" "ok"
oc_log_extra "no_cancel_sent" "$NO_CANCEL_SENT"
oc_log_extra "dispatch_ts" "$DISPATCH_TS"

RUN_ID=""
# Adoption, headSha-corrected (owner-approved fix 2026-08-30, rebuilt after the
# phantom): on a workflow_dispatch run headSha is ALWAYS the carrier ref
# (v0.4.48 field lesson, re-verified 2026-08-30 — every run lists the same
# carrier head fc1dc955), never the `-f ref=` input. So the selector matches
# headSha==RESOLVED-CARRIER-HEAD (a hard, always-true gate for valid dispatches;
# filters non-carrier events). The real cross-lane discriminator is the SHARED
# dispatch lock, already held through dispatch+adoption (flock -u 8 after the
# loop) so no two lanes interleave here. Two guards against the documented decoy
# (00:38:38Z race where both lanes adopted one run): (a) window floor buffered
# -5s — GitHub createdAt jitter can round a just-dispatched run below a strict
# `>= DISPATCH_TS` floor and self-exclude it; (b) LATEST-wins (.[-1]) not
# earliest — under the lock the newest carrier dispatch IS this lane's own run,
# so a stale older lane's run is never adopted.
CARRIER_HEAD="$("$GH_BIN" api "repos/$REPO/git/ref/heads/$CARRIER" --jq '.object.sha' 2>/dev/null || true)"
[ -n "$CARRIER_HEAD" ] || {
  echo "$PROG: carrier head unresolvable via branches API (ref $CARRIER on $REPO) — refusing time-window adoption (would match ANY run); re-run once the carrier ref resolves: oc-prchecks $REF --wait $WAIT_SECS" >&2
  oc_log_extra "carrier_head" "unresolvable"
  exit 7
}
TS_FLOOR="$(date -u -d "$DISPATCH_TS -5 seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '%s' "$DISPATCH_TS")"
deadline=$(( $(date +%s) + RESOLVE_WAIT ))
while [ -z "$RUN_ID" ]; do
  LIST="$(gh_retry run list --workflow pr-checks.yml --repo "$REPO" --limit 30 \
    --json databaseId,createdAt,event,headBranch,headSha)" || LIST="[]"
  RUN_ID="$(printf '%s' "$LIST" | jq -r --arg br "$CARRIER" --arg ch "${CARRIER_HEAD:-}" --arg ft "$TS_FLOOR" \
    '[.[] | select(.event=="workflow_dispatch" and .headBranch==$br and ($ch=="" or .headSha==$ch) and .createdAt >= $ft)] | sort_by(.createdAt) | .[-1].databaseId // empty' 2>/dev/null)"
  [ -n "$RUN_ID" ] && break
  [ "$(date +%s)" -ge "$deadline" ] && {
    echo "$PROG: no run adopted within ${RESOLVE_WAIT}s (dispatch ts $DISPATCH_TS, carrier $CARRIER)" >&2
    oc_log_extra "resolve" "timeout"
    flock -u 8
    exit 4
  }
  sleep "$RESOLVE_POLL"
done
flock -u 8
echo "adopted run=$RUN_ID (time-window attribution under dispatch lock)" >&2
oc_log_extra "run_id" "$RUN_ID"
fi  # C-F2 resume-skipped dispatch+adoption
fi  # RESUME branch vs normal dispatch path (#74 H2)
RUN_URL="${RUN_URL:-}"; RUN_URL="https://github.com/$REPO/actions/runs/$RUN_ID"

# run view is CARRIER-SHAPED for the identity pin: a dispatch run's headSha is
# the DISPATCH REF by GitHub design (n=1730, field run 34050967831), so sha
# equality with the tested sha can NEVER hold — the identity pin verifies what
# misadoption actually violated (event + branch; n=1721 B / goal re-open).
 adopting_pin() { # adopted run -> event+branch identity check (B, this batch)
  PIN_ST="$(gh_retry run view "$RUN_ID" --repo "$REPO" --json headBranch,event,headSha)" || PIN_ST=""
  PIN_EVENT="$(printf '%s' "$PIN_ST" | jq -r '.event // empty' 2>/dev/null)"
  PIN_BRANCH="$(printf '%s' "$PIN_ST" | jq -r '.headBranch // empty' 2>/dev/null)"
  PIN_HEADSHA="$(printf '%s' "$PIN_ST" | jq -r '.headSha // empty' 2>/dev/null)"
  oc_log_extra "adopted_headSha" "${PIN_HEADSHA:-unknown}"
  if [ "$PIN_EVENT" != "workflow_dispatch" ] || [ "$PIN_BRANCH" != "$CARRIER" ]; then
    echo "$PROG: ADOPTION IDENTITY MISMATCH: adopted run=$RUN_ID is event=$PIN_EVENT branch=$PIN_BRANCH (expected workflow_dispatch on $CARRIER) — refusing to watch a stranger's run (n=1721 B; field case adopted a main-branch run for a never-materialized carrier dispatch)" >&2
    echo "$PROG: OC_PR_SUPERSEDED: run superseded/foreign — do NOT resume run=$RUN_ID; verify with gh run view, then dispatch fresh" >&2
    oc_log_extra "adoption_pin" "mismatch"
    exit 4
  fi
  # #631 SHA PIN — the run-list fields CANNOT discriminate concurrent lanes:
  # every workflow_dispatch run on the carrier carries the SAME headSha (the
  # carrier ref, not the tested sha), so event+branch are satisfied by ANY lane's
  # run and the selector's only remaining tie-break was recency under the lock.
  # Measured 2026-09-27: three concurrent runs, every list field identical, while
  # their `PR-lane gates (<sha>)` job names pinned THREE DIFFERENT shas — a chain
  # adopted the newest and settled GREEN on a stranger's evidence (gate bypass).
  # The job name is the identity carrier; verify it before watching.
  if command -v oc_job_sha >/dev/null 2>&1; then
    _pin_sha=""; _pin_try=0; _pin_max="${OC_PRCHECKS_PIN_TRIES:-4}"
    while [ "$_pin_try" -lt "$_pin_max" ]; do
      _pin_sha="$(oc_job_sha "$("$GH_BIN" run view "$RUN_ID" --repo "$REPO" --json jobs --jq '[.jobs[].name]|join(" ")' 2>/dev/null || true)" || true)"   # oc_job_sha is a pipeline: pipefail makes it non-zero on no-match
      [ -n "$_pin_sha" ] && break
      _pin_try=$((_pin_try + 1))
      [ "$_pin_try" -lt "$_pin_max" ] && sleep 5
    done
    if [ -n "$_pin_sha" ] && [ -n "${SHA:-}" ] && [ "$_pin_sha" != "$SHA" ]; then   # ${SHA:-}: the resume path carries a run-id, not a sha
      echo "$PROG: ADOPTION SHA MISMATCH: adopted run=$RUN_ID pins sha $_pin_sha but this lane is armed with $SHA — run-list fields cannot discriminate concurrent dispatches, so this is another lane's gate; refusing to watch a stranger's evidence (#631)." >&2
      echo "$PROG: OC_PR_SUPERSEDED: run=$RUN_ID belongs to sha $_pin_sha — do NOT resume it; re-run this command to dispatch your own gate" >&2
      oc_log_extra "adoption_pin" "sha-mismatch"
      oc_log_extra "adoption_pin_sha" "$_pin_sha"
      exit 4
    fi
    if [ -n "$_pin_sha" ]; then
      oc_log_extra "adoption_job_sha" "$_pin_sha"
      oc_log_extra "adoption_pin" "ok"
    else
      # queued run: jobs not materialised yet. Cannot discriminate — DISCLOSE,
      # never a silent clean. (#631: this is the residual window.)
      oc_log_extra "adoption_pin" "unpinned"
    fi
  else
    oc_log_extra "adoption_pin" "unpinned"
  fi
}
# C-F2 resume-skipped dispatch+adoption and the plain resume path re-attach to
# a WITNESSED run (journal-matched by sha/ref) — the pin's target defect is
# LATEST-wins grabbing an unverified newest run, so witnessed re-attach skips it.
if [ "${OC_PR_SKIPPED_DISPATCH:-0}" != 1 ]; then adopting_pin; fi

# ---------- step 4: watch ------------------------------------------------------
_pr_write_checkpoint
deadline=$(( $(date +%s) + WAIT_SECS ))
while :; do
  ST="$(gh_retry run view "$RUN_ID" --repo "$REPO" --json status,conclusion,createdAt)" || {
    echo "$PROG: run view $RUN_ID failed" >&2; exit 4; }
  STATUS="$(printf '%s' "$ST" | jq -r '.status')"
  [ "$STATUS" = "completed" ] && break
  if [ "$(date +%s)" -ge "$deadline" ]; then
    echo "IN-FLIGHT run=$RUN_ID $RUN_URL (still $STATUS after ${WAIT_SECS}s — resume: oc-prchecks resume $RUN_ID --wait $WAIT_SECS)"
    oc_log_extra "watch" "timeout"
    exit 5
  fi
  sleep "$POLL"
done
CONCLUSION="$(printf '%s' "$ST" | jq -r '.conclusion')"
RUN_CREATED_AT="$(printf '%s' "$ST" | jq -r '.createdAt // empty')"
oc_log_extra "conclusion" "$CONCLUSION"

# ---------- step 5: verdict — RUN conclusion authoritative (v0.4.56) ----------
# Verdicts fire ONLY on a terminal run conclusion (the 23:45:07Z RED fired 7s
# BEFORE conclusion=success — stale reads must never verdict).
if [ -z "$CONCLUSION" ] || [ "$CONCLUSION" = "null" ]; then
  echo "IN-FLIGHT run=$RUN_ID $RUN_URL (non-terminal at verdict time — resume: oc-prchecks resume $RUN_ID --wait $WAIT_SECS)" >&2
  oc_log_extra "verdict_reason" "non-terminal"
  exit 5
fi
JOBS="$("$GH_BIN" run view "$RUN_ID" --repo "$REPO" --json jobs 2>/dev/null)" || {
  echo "$PROG: jobs fetch failed for run $RUN_ID" >&2; exit 4; }
printf '%s' "$JOBS" | jq -r '.jobs[] | "JOB\t\(.name)\t\(.conclusion)"'
# Step-name selector (defect fix 2026-09-11, lane 359fe71b report): the fmt
# leg must be identified by the GATE step, never by any name containing
# "fmt". The live workflow names it "Check formatting" (no "fmt" substring)
# while the fix-mode steps "Apply cargo fmt (fix mode)" and "Upload fmt-fix
# patch" are ALWAYS skipped on a normal gate run — so the old selector both
# mislabelled every green run as fmt-skipped-pass and left the soft-fail RED
# tiebreak unreachable (a real fmt failure never entered FMT_LINES).
FMT_LINES="$(printf '%s' "$JOBS" | jq -r '.jobs[].steps[]? | select(.name | test("fmt|format";"i")) | select((.name | test("fix mode|fmt-fix|lock-regen|upload";"i")) | not) | "STEP\t\(.name)\t\(.conclusion)"')"
[ -n "$FMT_LINES" ] && printf '%s\n' "$FMT_LINES"

VERDICT="GREEN"
REASON=""
case "$CONCLUSION" in
  success)
    # tiebreak ONLY: steps/jobs with conclusion=failure fail; skipped/neutral pass
    BAD_JOBS="$(printf '%s' "$JOBS" | jq -r '[.jobs[] | select(.conclusion=="failure" or .conclusion=="cancelled" or .conclusion=="timed_out" or .conclusion=="startup_failure") | .name] | join(",")')"
    if [ -n "$BAD_JOBS" ]; then VERDICT="RED"; REASON="jobs-failed: $BAD_JOBS"; fi
    if printf '%s\n' "$FMT_LINES" | awk -F'\t' '$3 == "failure" { found=1 } END { exit !found }'; then
      VERDICT="RED"; REASON="${REASON:+$REASON; }fmt step FAILED (soft-fail exposed)"
    elif [ "$VERDICT" = "GREEN" ] && printf '%s\n' "$FMT_LINES" | awk -F'\t' '$3 == "skipped" { found=1 } END { exit !found }'; then
      REASON="fmt-skipped-pass"
    fi
    ;;
  cancelled)
    # P4 (owner "Go all" 2026-08-31): cancelled = superseded by the concurrency
    # group, NOT a gate failure. v0.4.56 read it RED; field evidence (two wait
    # cycles burned on cross-lane churn, runs 33338254820 / 33344104187) says
    # that treats concurrency cleanup as code failure. Exit 6 = superseded,
    # never GREEN — the false-GREEN hole stays closed; the lane re-arms on the
    # superseding run instead of treating the gate as RED.
    # #703: the candidate set must be the concurrency GROUP, not the carrier
    # branch. The group is keyed on the dispatch input ref (ci-lane-impl.yml
    # `concurrency.group: prchecks-${{ inputs.ref }}`), which `run list` does not
    # expose; the observable proxy is the GATE JOB's sha pin - the same identity
    # carrier #631 already uses to keep two concurrent lanes apart. A run whose
    # job pins a different sha sits in a different group and CANNOT have
    # cancelled this one, so naming it is actionable in the WRONG direction: the
    # resume hint would hand the lane another lane's verdict, and a carried
    # forward GREEN on a stranger's tests is the false-GREEN hole this handler
    # exists to keep closed. Where the pin cannot be resolved we name NOTHING -
    # an unnamed superseder is honest, a misnamed one is a false lead.
    SUP=""
    if command -v oc_job_sha >/dev/null 2>&1; then
      _sup_mine="$(oc_job_sha "$("$GH_BIN" run view "$RUN_ID" --repo "$REPO" --json jobs --jq '[.jobs[].name]|join(" ")' 2>/dev/null || true)" || true)"
      if [ -n "$_sup_mine" ]; then
        _sup_cands="$("$GH_BIN" run list --workflow pr-checks.yml --repo "$REPO" --branch "$CARRIER" --limit 10 \
          --json databaseId,createdAt 2>/dev/null | jq -r --arg rid "$RUN_ID" --arg since "$RUN_CREATED_AT" --argjson n "${OC_PRCHECKS_SUP_TRIES:-3}" \
          '[.[] | select(.databaseId != ($rid|tonumber) and .createdAt >= $since)] | sort_by(.createdAt) | reverse | .[0:$n] | .[].databaseId' 2>/dev/null || true)"
        for _sup_cid in $_sup_cands; do
          _sup_pin="$(oc_job_sha "$("$GH_BIN" run view "$_sup_cid" --repo "$REPO" --json jobs --jq '[.jobs[].name]|join(" ")' 2>/dev/null || true)" || true)"
          if [ -n "$_sup_pin" ] && [ "$_sup_pin" = "$_sup_mine" ]; then SUP="$_sup_cid"; break; fi
        done
      fi
    fi
    oc_log_extra "verdict" "CANCELLED"
    oc_log_extra "verdict_reason" "superseded${SUP:+; superseding=$SUP}"
    echo "VERDICT CANCELLED (run $RUN_ID was concurrency-cancelled — superseded, not failed)"
    # #333: never interpolate a possibly-unset sha into the hint — on the resume
    # path SHA is unset by construction, and the bare `$SHA` aborted the handler
    # under `set -u` BEFORE `exit 6`, returning rc 1 where RC-CONTRACT documents
    # rc 6 and losing the recovery hint entirely. The handler must always reach
    # exit 6 with whatever hint it can build.
    if [ -n "${SHA:-}" ]; then
      REARM_HINT=" (re-arm: oc-prchecks $SHA --wait $WAIT_SECS${SUP:+ — or resume superseding run: oc-prchecks resume $SUP --wait $WAIT_SECS})"
    elif [ -n "$SUP" ]; then
      REARM_HINT=" (re-arm: oc-prchecks resume $SUP --wait $WAIT_SECS)"
    else
      REARM_HINT=""
    fi
    echo "  superseding run: ${SUP:-unknown}${SUP:+ — https://github.com/$REPO/actions/runs/$SUP}${REARM_HINT}"
    echo "RUN $RUN_URL"
    exit 6
    ;;
  failure|timed_out|startup_failure)
    VERDICT="RED"; REASON="run-$CONCLUSION"
    ;;
  *)
    VERDICT="RED"; REASON="run-conclusion-$CONCLUSION"
    ;;
esac
oc_log_extra "fmt" "$(printf '%s' "$FMT_LINES" | awk -F'\t' '{print $3}' | sort -u | tr '\n' ',' | sed 's/,$//')"
oc_log_extra "verdict" "$VERDICT"
oc_log_extra "verdict_reason" "$REASON"

echo "VERDICT $VERDICT${REASON:+ (reason: $REASON)}"
echo "RUN $RUN_URL"
if [ "$VERDICT" = "GREEN" ]; then exit 0; fi
echo "$PROG: RED — $REASON" >&2
if [ -n "$FAULT_PR" ]; then   # E5 (v0.4.78): RED triage auto-runs fault-scope — RED stays rc 3
  echo "--- fault-scope (RED triage: failing-files vs PR-files) ---"
  FS_OUT="$("$FAULT_TOOL" "$FAULT_PR" --run "$RUN_ID" --repo "$REPO" 2>&1)"; FS_RC=$?
  printf '%s\n' "$FS_OUT"
  oc_log_extra "fault_scope_rc" "$FS_RC"
  case "$FS_RC" in
    0) echo "FAULT-SCOPE: IN-SCOPE — the PR touches failing files (the lane owns it)" ;;
    1) echo "FAULT-SCOPE: BASE-FAULT — zero intersection (pre-existing; do NOT chase)" ;;
    *) echo "FAULT-SCOPE: inconclusive (rc=$FS_RC)" ;;
  esac
fi
exit 3
