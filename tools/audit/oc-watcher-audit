#!/usr/bin/env bash
# =============================================================================
# oc-watcher-audit — C2 (Duty-6 Cycle-5 review, 2026-09-11): detached watcher
# and background execution compliance audit.
#
# Scans detached task definitions in tmp/detached/*.json for policy violations:
#   1. UNTHROTTLED_WATCH: 'gh run watch' with NO --interval (the forbidden 3s default)
#   2. OFF_SPEC_INTERVAL: 'gh run watch' throttled, but not at the law's 30 or 60
#   3. NOHUP_SPAWN: 'nohup' used for background execution (bypasses detached tasks)
#   4. HANDROLLED_SLEEP_LOOP: Hand-rolled 'while ... sleep' or 'for ... sleep' pollers
#
# Usage:
#   oc-watcher-audit [--since <ts>] [--json] [--dir <dir>] [--notify-orphans] [--dry-run] | --selftest
#
# --since <ts>       Rolling audit window (ISO-8601). Tasks spawned BEFORE <ts> are
#                   skipped, so a long-terminal task stops re-alarming once it ages
#                   out. Timestamps are parsed as datetimes (fractional seconds and
#                   +00:00 offsets included); a task whose timestamp cannot be parsed
#                   is INCLUDED — its age is unprovable, so it is never silently
#                   dropped. Callers pass `date -u -d 'N hours ago' +%Y-%m-%dT%H:%M:%SZ`.
#
# --json             Emits a JSON ARRAY of violation objects (never an object), each:
#                   task_id, session_id, spawned_at, state, live, violation, detail,
#                   command. `live` is true when the recorded task state is Running.
#
# --notify-orphans   Scan for interrupted/dead detached tasks or in-flight checkpoints,
#                   resolve workflow run conclusion via gh run view, and wake the lane
#                   with session_notify so post-restart comas are broken automatically.
#
# --dry-run          Preview orphan recovery actions without sending notifies.
#
# Exit codes:
#   0 clean (zero violations)
#   1 violations found (audit alarm)
#   2 usage / bad argument
#   3 directory missing or unreadable
# =============================================================================
set -u
set -o pipefail
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-watcher-audit" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?' EXIT

PROG="oc-watcher-audit"
DEFAULT_DIR="${OC_DETACHED_DIR:-${HOME:-/root}/.opencrabs/profiles/ops/tmp/detached}"

usage() {
  echo "usage: $PROG [--since <ts>] [--json] [--dir <dir>] [--notify-orphans] [--dry-run] | --selftest" >&2
  exit 2
}

do_selftest() {
  local d
  d="$(mktemp -d)" || exit 3
  local SELF
  SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  local pass=0 fail=0

  assert_eq() {
    local name="$1" exp="$2" act="$3"
    if [ "$exp" = "$act" ]; then
      echo "  PASS: $name"
      pass=$((pass + 1))
    else
      echo "  FAIL: $name (expected '$exp', got '$act')" >&2
      fail=$((fail + 1))
    fi
  }

  echo "=== oc-watcher-audit selftest ==="

  # Test 1: Empty dir -> 0
  mkdir -p "$d/t1"
  local rc1=0
  "$SELF" --dir "$d/t1" >/dev/null 2>&1 || rc1=$?
  assert_eq "empty dir returns 0" "0" "$rc1"

  # Test 2: Compliant task -> 0
  mkdir -p "$d/t2"
  cat > "$d/t2/clean.json" <<'JSON'
{
  "id": "task-clean-1",
  "session_id": "sess-1",
  "task": "gh run watch 12345 --repo leshchenko1979/opencrabs --interval 30 --exit-status",
  "spawned_at": "2026-09-11T10:00:00Z"
}
JSON
  local rc2=0
  "$SELF" --dir "$d/t2" >/dev/null 2>&1 || rc2=$?
  assert_eq "compliant watch returns 0" "0" "$rc2"

  # Test 3: Unthrottled watch -> 1
  mkdir -p "$d/t3"
  cat > "$d/t3/bad_watch.json" <<'JSON'
{
  "id": "task-bad-1",
  "session_id": "sess-bad",
  "task": "gh run watch 99999 --repo leshchenko1979/opencrabs --exit-status",
  "spawned_at": "2026-09-11T10:00:00Z"
}
JSON
  local rc3=0
  local out3
  out3="$("$SELF" --dir "$d/t3" 2>/dev/null)" || rc3=$?
  assert_eq "unthrottled watch returns 1" "1" "$rc3"
  oc_has "$out3" "UNTHROTTLED_WATCH"
  assert_eq "reports UNTHROTTLED_WATCH violation" "0" "$?"

  # Test 4: Nohup spawn -> 1
  mkdir -p "$d/t4"
  cat > "$d/t4/bad_nohup.json" <<'JSON'
{
  "id": "task-nohup-1",
  "session_id": "sess-nohup",
  "task": "nohup /tmp/test.sh >/tmp/out.log 2>&1 &",
  "spawned_at": "2026-09-11T10:00:00Z"
}
JSON
  local rc4=0
  local out4
  out4="$("$SELF" --dir "$d/t4" 2>/dev/null)" || rc4=$?
  assert_eq "nohup spawn returns 1" "1" "$rc4"
  oc_has "$out4" "NOHUP_SPAWN"
  assert_eq "reports NOHUP_SPAWN violation" "0" "$?"

  # Test 5: Handrolled sleep loop -> 1
  mkdir -p "$d/t5"
  cat > "$d/t5/bad_loop.json" <<'JSON'
{
  "id": "task-loop-1",
  "session_id": "sess-loop",
  "task": "while kill -0 1234; do sleep 10; done",
  "spawned_at": "2026-09-11T10:00:00Z"
}
JSON
  local rc5=0
  local out5
  out5="$("$SELF" --dir "$d/t5" 2>/dev/null)" || rc5=$?
  assert_eq "handrolled loop returns 1" "1" "$rc5"
  oc_has "$out5" "HANDROLLED_SLEEP_LOOP"
  assert_eq "reports HANDROLLED_SLEEP_LOOP violation" "0" "$?"

  # Test 6: gh run watch --help is clean -> 0
  mkdir -p "$d/t6"
  cat > "$d/t6/help_watch.json" <<'JSON'
{
  "id": "task-help-1",
  "session_id": "sess-help",
  "task": "gh run watch --help",
  "spawned_at": "2026-09-11T10:00:00Z"
}
JSON
  local rc6=0
  "$SELF" --dir "$d/t6" >/dev/null 2>&1 || rc6=$?
  assert_eq "gh run watch --help returns 0" "0" "$rc6"

  # Test 7: --since filters older items -> 0
  local rc7=0
  "$SELF" --dir "$d/t3" --since "2026-09-11T12:00:00Z" >/dev/null 2>&1 || rc7=$?
  assert_eq "--since filtering out old task returns 0" "0" "$rc7"

  # Test 8: --json emits valid JSON array
  local json_out
  json_out="$("$SELF" --dir "$d/t3" --json 2>/dev/null || true)"
  local json_valid=1
  python3 -c "import json, sys; data=json.loads(sys.argv[1]); sys.exit(0 if isinstance(data, list) and len(data) == 1 else 1)" "$json_out" && json_valid=0
  assert_eq "--json outputs valid JSON array" "0" "$json_valid"

  # Test 9: --interval 30 is compliant -> 0
  mkdir -p "$d/t9"
  cat > "$d/t9/ok_watch.json" <<'JSON'
{
  "id": "task-ok-interval",
  "session_id": "sess-ok",
  "task": "gh run watch 4242 --repo leshchenko1979/opencrabs --interval 30 --exit-status",
  "spawned_at": "2026-09-11T10:00:00Z",
  "state": "Completed"
}
JSON
  local rc9=0
  "$SELF" --dir "$d/t9" >/dev/null 2>&1 || rc9=$?
  assert_eq "--interval 30 is compliant" "0" "$rc9"

  # Test 10: off-spec interval -> 1, typed OFF_SPEC_INTERVAL (not UNTHROTTLED_WATCH)
  mkdir -p "$d/t10"
  cat > "$d/t10/offspec.json" <<'JSON'
{
  "id": "task-offspec",
  "session_id": "sess-offspec",
  "task": "gh run watch 4243 -R leshchenko1979/opencrabs --exit-status --interval 45 > /tmp/w.log 2>&1; echo done",
  "spawned_at": "2026-09-11T10:00:00Z",
  "state": "Completed"
}
JSON
  local rc10=0
  local out10
  out10="$("$SELF" --dir "$d/t10" 2>/dev/null)" || rc10=$?
  assert_eq "off-spec interval returns 1" "1" "$rc10"
  oc_has "$out10" "OFF_SPEC_INTERVAL"
  assert_eq "reports OFF_SPEC_INTERVAL" "0" "$?"
  oc_has "$out10" "UNTHROTTLED_WATCH"
  assert_eq "off-spec is not mislabelled UNTHROTTLED_WATCH" "1" "$?"

  # Test 11: --since parses fractional-second +00:00 timestamps
  mkdir -p "$d/t11"
  cat > "$d/t11/old_frac.json" <<'JSON'
{
  "id": "task-old-frac",
  "session_id": "sess-frac",
  "task": "gh run watch 4244 --exit-status",
  "spawned_at": "2020-01-01T00:00:00.123456789+00:00",
  "state": "Completed"
}
JSON
  local rc11=0
  "$SELF" --dir "$d/t11" --since "2026-01-01T00:00:00Z" >/dev/null 2>&1 || rc11=$?
  assert_eq "--since filters fractional +00:00 timestamps" "0" "$rc11"

  # Test 12: an undated task is fail-open (age unprovable -> never silently dropped)
  mkdir -p "$d/t12"
  cat > "$d/t12/no_ts.json" <<'JSON'
{
  "id": "task-no-ts",
  "session_id": "sess-nots",
  "task": "gh run watch 4245 --exit-status",
  "state": "Running"
}
JSON
  local rc12=0
  local out12
  out12="$("$SELF" --dir "$d/t12" --since "2026-01-01T00:00:00Z" --json 2>/dev/null)" || rc12=$?
  assert_eq "undated task is not dropped by --since" "1" "$rc12"
  local lv=1
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); sys.exit(0 if len(d)==1 and d[0].get('live') is True and d[0].get('state')=='Running' else 1)" "$out12" && lv=0
  assert_eq "json carries state+live for a Running task" "0" "$lv"

  # Test 13: Missing dir -> 3
  local rc13=0
  "$SELF" --dir "$d/nonexistent_dir_12345" >/dev/null 2>&1 || rc13=$?
  assert_eq "missing dir returns 3" "3" "$rc13"

  # Test 14: Unknown flag -> 2
  local rc14=0
  "$SELF" --unknown-flag-xyz >/dev/null 2>&1 || rc14=$?
  assert_eq "unknown flag returns 2" "2" "$rc14"

  # Test 15: --notify-orphans resolves Interrupted detached task and in-flight checkpoint
  mkdir -p "$d/t15/detached" "$d/t15/state/runs/in-flight" "$d/bin"
  cat > "$d/t15/detached/interrupted.json" <<'JSON'
{
  "id": "task-interrupted",
  "session_id": "sess-interrupted-1",
  "task": "gh run watch 555111 --repo leshchenko1979/opencrabs --interval 30 --exit-status",
  "spawned_at": "2026-09-11T10:00:00Z",
  "state": "Interrupted"
}
JSON
  cat > "$d/t15/state/runs/in-flight/sess-cp-1.json" <<'JSON'
{
  "session_id": "sess-cp-1",
  "run_id": "555222",
  "repo": "leshchenko1979/opencrabs",
  "pid": 99999999
}
JSON
  cat > "$d/bin/fake-gh" <<'BINSCRIPT'
#!/usr/bin/env bash
if [ "$1" = "run" ] && [ "$2" = "view" ]; then
  rid="$3"
  echo "{\"status\":\"completed\",\"conclusion\":\"success\",\"url\":\"https://github.com/test/runs/$rid\",\"headBranch\":\"leshchenko1979/fix/487-image-title-caption\",\"createdAt\":\"2026-09-14T02:19:23Z\"}"
  exit 0
fi
exit 1
BINSCRIPT
  chmod +x "$d/bin/fake-gh"

  # A NON-terminal stub: the same watcher that is still legitimately resumable.
  # Paired with the terminal stub above this is the discriminating control for
  # the c22 ACCEPT contract -- terminal suppresses, in-flight still notifies.
  cat > "$d/bin/fake-gh-running" <<'BINSCRIPT'
#!/usr/bin/env bash
if [ "$1" = "run" ] && [ "$2" = "view" ]; then
  rid="$3"
  echo "{\"status\":\"in_progress\",\"conclusion\":null,\"url\":\"https://github.com/test/runs/$rid\",\"headBranch\":\"leshchenko1979/fix/487-image-title-caption\",\"createdAt\":\"2026-09-23T02:19:23Z\"}"
  exit 0
fi
exit 1
BINSCRIPT
  chmod +x "$d/bin/fake-gh-running"

  local rc15=0
  local out15
  out15="$(OC_GH="$d/bin/fake-gh" OC_DEV_STATE="$d/t15/state" OC_DEPLOY_STATE_DIR="$d/t15/state" "$SELF" --dir "$d/t15/detached" --notify-orphans --dry-run --json 2>/dev/null)" || rc15=$?
  assert_eq "orphan recovery clean audit returns 0" "0" "$rc15"
  local orph_count=0
  orph_count="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(len(d.get('orphans_recovered', [])))" "$out15" 2>/dev/null || echo 0)"
  assert_eq "recovers 2 orphan watchers (1 task + 1 checkpoint)" "2" "$orph_count"

  # Test 15b: LIVE run against a TERMINAL run (completed/success) -> the
  # watcher-recovery notice is SUPPRESSED (c22 ACCEPT, verdict-table:72). The
  # records still surface so the sweep is never silently empty; what must not
  # happen is a notify for a run that cannot be resumed.
  local out15b
  out15b="$(OC_GH="$d/bin/fake-gh" OC_DEV_STATE="$d/t15/state" OC_DEPLOY_STATE_DIR="$d/t15/state" "$SELF" --dir "$d/t15/detached" --notify-orphans --json 2>/dev/null)" || true
  local orph_live=0
  orph_live="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(len(d.get('orphans_recovered', [])))" "$out15b" 2>/dev/null || echo 0)"
  assert_eq "terminal live run still records 2 orphans" "2" "$orph_live"
  local term_notified=0
  term_notified="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for r in d.get('orphans_recovered', []) if r.get('notified')))" "$out15b" 2>/dev/null || echo -1)"
  assert_eq "terminal run notifies 0 watchers (suppressed)" "0" "$term_notified"
  local term_supp=0
  term_supp="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for r in d.get('orphans_recovered', []) if r.get('suppressed_terminal')))" "$out15b" 2>/dev/null || echo -1)"
  assert_eq "both terminal orphans recorded as suppressed_terminal" "2" "$term_supp"
  # The suppression must be RECORDED, not merely skipped: a terminal run never
  # becomes resumable, so re-querying it every sweep is pure waste.
  local supp_persisted=1
  python3 -c "import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if any(v.get('suppressed')=='terminal' for v in d.values()) else 1)" "$d/t15/state/orphans_notified.json" 2>/dev/null && supp_persisted=0
  assert_eq "suppression persisted via the dedup path" "0" "$supp_persisted"

  # Test 15d: the SAME watcher, same fixture, NON-terminal run -> still notified.
  # The fixture copy + planted helper, hoisted above t15d.
  # WHY A COPY AND NOT "$SELF": the child resolves its notify helper from the tools
  # dir the SHELL computed, so the only way to make a delivery leg hermetic is to
  # run a copy whose resolved tools dir is a fixture. A copy in a directory with no
  # lib/oc-root.sh above it resolves to its own directory (oc-root.sh case 2), so
  # the planted helper is the only thing that can be invoked.
  #
  # This also corrects a PRE-EXISTING false leg: t15d asserted notified=1 while
  # invoking the REAL lib/oc-notify.sh with the synthetic session id
  # "sess-running-arm", which the helper rejects outright (measured 2026-09-25:
  # rc=2, "oc-notify: invalid target uuid"). The record used to claim notified from
  # INTENTION, so the leg passed on a delivery that never happened and never could.
  # With the record now stating the OUTCOME, the leg needs a helper that can accept.
  local t17bin="$d/t17bin"
  mkdir -p "$t17bin/lib"
  cp -p "$SELF" "$t17bin/oc-watcher-audit"
  cat > "$t17bin/lib/oc-notify.sh" <<'BINSCRIPT'
#!/usr/bin/env bash
# fake notify helper -- exit code supplied by OC_FAKE_NOTIFY_RC
exit "${OC_FAKE_NOTIFY_RC:-0}"
BINSCRIPT
  chmod +x "$t17bin/lib/oc-notify.sh" "$t17bin/oc-watcher-audit"

  # This is the negative control for 15b: a fix that suppressed everything would
  # pass 15b and fail here.
  mkdir -p "$d/t15d/detached" "$d/t15d/state/runs/in-flight"
  cat > "$d/t15d/detached/interrupted.json" <<'JSON'
{
  "id": "task-interrupted-running",
  "session_id": "sess-running-arm",
  "task": "gh run watch 777111 --repo leshchenko1979/opencrabs --interval 30 --exit-status",
  "spawned_at": "2026-09-23T10:00:00Z",
  "state": "Interrupted"
}
JSON
  local out15d
  out15d="$(OC_GH="$d/bin/fake-gh-running" OC_DEV_STATE="$d/t15d/state" OC_DEPLOY_STATE_DIR="$d/t15d/state" OC_FAKE_NOTIFY_RC=0 "$t17bin/oc-watcher-audit" --dir "$d/t15d/detached" --notify-orphans --json 2>/dev/null)" || true
  local run_notified=0
  run_notified="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for r in d.get('orphans_recovered', []) if r.get('notified')))" "$out15d" 2>/dev/null || echo -1)"
  assert_eq "NON-terminal (in_progress) run still notifies" "1" "$run_notified"
  local run_supp=0
  run_supp="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for r in d.get('orphans_recovered', []) if r.get('suppressed_terminal')))" "$out15d" 2>/dev/null || echo -1)"
  assert_eq "NON-terminal run is not marked suppressed" "0" "$run_supp"

  # Test 15e: the notice that DOES fire must name branch + issue + age -- the
  # contract's second half, read from the record's own carried payload.
  local n_bran=1ch=1
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); n=[r['notice'] for r in d.get('orphans_recovered',[]) if r.get('notified')]; sys.exit(0 if n and 'issue #487' in n[0] else 1)" "$out15d" 2>/dev/null && n_bran=0
  assert_eq "fired notice names the branch's issue (#487)" "0" "$n_bran"
  local n_age=1
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); n=[r['notice'] for r in d.get('orphans_recovered',[]) if r.get('notified')]; sys.exit(0 if n and 'old' in n[0] else 1)" "$out15d" 2>/dev/null && n_age=0
  assert_eq "fired notice names the run age" "0" "$n_age"
  # Fail-open guard: an unreadable conclusion must NOT suppress. An API fault
  # may never silently swallow a real recovery.
  local fo_verdict
  fo_verdict="$(python3 - "$SELF" 2>/dev/null <<'OCPY'

import re,sys
src = open(sys.argv[1]).read()
# The slice MUST carry _TERMINAL_NULLS: extracting the function alone raises
# NameError, which a suppressed stderr would render as a silent pass.
m = re.search(r'^_TERMINAL_NULLS.*?(?=^def branch_issue)', src, re.S|re.M)
if not m:
    print('EXTRACT_FAIL'); sys.exit(0)
ns = {}
exec(m.group(0), ns)
f = ns['is_terminal_run']
bad = []
if f('unknown','unknown'): bad.append('unknown')
if f('completed',''): bad.append('empty')
if f('completed',None): bad.append('none')
if f('completed','action_required'): bad.append('action_required')
if not f('completed','success'): bad.append('NOT-TERMINAL:success')
print('BAD:' + ','.join(bad) if bad else 'OK')
OCPY
)"
  assert_eq "is_terminal_run fails OPEN on unknown/null/action_required" "OK" "$fo_verdict"

  # Verify tracking file exists and contains task key
  local track_exists=1
  [ -f "$d/t15/state/orphans_notified.json" ] && track_exists=0
  assert_eq "orphans_notified.json created on live notify" "0" "$track_exists"

  # Second live run on the same directory should notify 0 (idempotent deduplication)
  local out15c
  out15c="$(OC_GH="$d/bin/fake-gh" OC_DEV_STATE="$d/t15/state" OC_DEPLOY_STATE_DIR="$d/t15/state" "$SELF" --dir "$d/t15/detached" --notify-orphans --json 2>/dev/null)" || true
  local orph_dedup=0
  orph_dedup="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(len(d.get('orphans_recovered', [])))" "$out15c" 2>/dev/null || echo 0)"
  assert_eq "second live notify skips already notified orphans (deduplicated)" "0" "$orph_dedup"

  # Negative control: running task with active PID is NOT flagged as orphan
  mkdir -p "$d/t16/detached" "$d/t16/state/runs/in-flight"
  cat > "$d/t16/detached/running.json" <<'JSON'
{
  "id": "task-running",
  "session_id": "sess-running",
  "task": "gh run watch 555333 --repo leshchenko1979/opencrabs --interval 30 --exit-status",
  "spawned_at": "2026-09-11T10:00:00Z",
  "state": "Running"
}
JSON
  cat > "$d/t16/state/runs/in-flight/sess-active.json" <<JSON
{
  "session_id": "sess-active",
  "run_id": "555444",
  "repo": "leshchenko1979/opencrabs",
  "pid": $$
}
JSON
  local out16
  out16="$(OC_GH="$d/bin/fake-gh" OC_DEV_STATE="$d/t16/state" OC_DEPLOY_STATE_DIR="$d/t16/state" "$SELF" --dir "$d/t16/detached" --notify-orphans --dry-run --json 2>/dev/null || true)"
  local orph_active=0
  orph_active="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(len(d.get('orphans_recovered', [])))" "$out16" 2>/dev/null || echo 0)"
  assert_eq "negative control: running task and live PID checkpoint produce 0 orphans" "0" "$orph_active"

  # Test 17: the recovery notice's DELIVERY contract (F-M3, 2026-09-25, HQ lens F).
  # Runs on the fixture copy set up above t15d, which carries the reason a copy is
  # required for a hermetic delivery leg. What test 17 adds on top of t15d:
  #
  #   arm A  an ACCEPTING helper  -> notified, checkpoint consumed
  #   arm B  a REFUSING helper    -> loud on stderr, NOT notified, checkpoint KEPT
  #   arm C  NO helper at all     -> "CANNOT RESOLVE", never a silent pass
  #
  # Arm B is the half that matters most. A failed delivery must not be recorded as
  # notified and must not delete the checkpoint: the checkpoint is what re-detects
  # the orphan on a later sweep, so removing it after a failed send loses the
  # notice permanently.
  for arm in a b; do
    mkdir -p "$d/t17$arm/detached" "$d/t17$arm/state/runs/in-flight"
    cat > "$d/t17$arm/state/runs/in-flight/sess-cp.json" <<'JSON'
{
  "session_id": "sess-t17",
  "run_id": "888111",
  "repo": "leshchenko1979/opencrabs",
  "pid": 99999999
}
JSON
  done

  # ---- arm A: the helper accepts -> recorded, checkpoint consumed -----------
  local out17a
  out17a="$(OC_GH="$d/bin/fake-gh-running" OC_DEV_STATE="$d/t17a/state" \
    OC_DEPLOY_STATE_DIR="$d/t17a/state" OC_FAKE_NOTIFY_RC=0 \
    "$t17bin/oc-watcher-audit" --dir "$d/t17a/detached" --notify-orphans --json \
    2>"$d/t17a/err")" || true
  local a_notif=0
  a_notif="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for r in d.get('orphans_recovered',[]) if r.get('notified')))" "$out17a" 2>/dev/null || echo -1)"
  assert_eq "arm A: accepted delivery records notified" "1" "$a_notif"
  if [ -f "$d/t17a/state/runs/in-flight/sess-cp.json" ]; then
    assert_eq "arm A: consumed checkpoint removed" "gone" "present"
  else
    assert_eq "arm A: consumed checkpoint removed" "gone" "gone"
  fi

  # ---- arm B: the helper refuses -> loud, unrecorded, checkpoint KEPT -------
  local out17b
  out17b="$(OC_GH="$d/bin/fake-gh-running" OC_DEV_STATE="$d/t17b/state" \
    OC_DEPLOY_STATE_DIR="$d/t17b/state" OC_FAKE_NOTIFY_RC=3 \
    "$t17bin/oc-watcher-audit" --dir "$d/t17b/detached" --notify-orphans --json \
    2>"$d/t17b/err")" || true
  local b_notif=0
  b_notif="$(python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(sum(1 for r in d.get('orphans_recovered',[]) if r.get('notified')))" "$out17b" 2>/dev/null || echo -1)"
  assert_eq "arm B: refused delivery is NOT recorded as notified" "0" "$b_notif"
  local b_diag=1
  grep -q 'notify rc=3' "$d/t17b/err" 2>/dev/null && b_diag=0
  assert_eq "arm B: refused delivery states the helper's rc on stderr" "0" "$b_diag"
  if [ -f "$d/t17b/state/runs/in-flight/sess-cp.json" ]; then
    assert_eq "arm B: failed delivery leaves the checkpoint for a retry" "kept" "kept"
  else
    assert_eq "arm B: failed delivery leaves the checkpoint for a retry" "kept" "deleted"
  fi

  # ---- arm C: no helper at all -> the resolution fault is VISIBLE ----------
  rm -f "$t17bin/lib/oc-notify.sh"
  mkdir -p "$d/t17c/detached" "$d/t17c/state/runs/in-flight"
  cat > "$d/t17c/state/runs/in-flight/sess-cp.json" <<'JSON'
{
  "session_id": "sess-t17c",
  "run_id": "888222",
  "repo": "leshchenko1979/opencrabs",
  "pid": 99999999
}
JSON
  local out17c
  out17c="$(OC_GH="$d/bin/fake-gh-running" OC_DEV_STATE="$d/t17c/state" \
    OC_DEPLOY_STATE_DIR="$d/t17c/state" \
    "$t17bin/oc-watcher-audit" --dir "$d/t17c/detached" --notify-orphans --json \
    2>"$d/t17c/err")" || true
  local c_diag=1
  grep -q 'CANNOT RESOLVE' "$d/t17c/err" 2>/dev/null && c_diag=0
  assert_eq "arm C: an unresolvable helper says so, never passes silently" "0" "$c_diag"

  rm -rf "$d"
  echo "oc-watcher-audit selftest: PASS=$pass FAIL=$fail"
  [ "$fail" -eq 0 ] || exit 1
  exit 0
}

