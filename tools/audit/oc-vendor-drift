#!/usr/bin/env bash
# =============================================================================
# oc-vendor-drift — detect drift in files vendored from another repository
# =============================================================================
# Issue #700. The `oc-questions` register is developed upstream (the meta
# factory's TEMPLATE) and vendored here, because the live instrument must be
# findable at `tools/*/oc-questions` while its source of truth lives elsewhere.
# Three ports have been executed by 3-way merge and the live page reverted twice
# in one day, because NOTHING enforced even the weak contract the upstream law
# states -- "the union of FUNCTIONS and BEHAVIOUR, never a byte-identical copy".
#
# This guard makes that contract mechanical: a vendored file is compared against
# its recorded upstream revision, with a DECLARED delta allowed (the deployment
# naming the two copies legitimately differ in). Anything else is drift.
#
# Usage: oc-vendor-drift [--json] [--repo <path>] [--ref <ref>]
#                        [--advisory-only] [--selftest]
# Exit:  0 every entry IN_SYNC / 1 DRIFTED or LOCAL_MISSING found
#        2 usage (bad manifest) / 3 UPSTREAM_UNREACHABLE (nothing comparable)
# Emits: one line per entry plus a summary; --json emits the same as data.
#
# VERDICTS (each is the FACT read, never a guess):
#   IN_SYNC              normalized bytes equal at the recorded ref
#   DRIFTED              normalized bytes differ -- the vendored copy was edited
#   LOCAL_MISSING        the vendored path does not exist
#   UPSTREAM_UNREACHABLE repo, ref or path could not be read (never green)
#   +UPSTREAM_MOVED      suffix advisory: origin/main advanced past the recorded ref
#
# Two delta SHAPES are supported, because the manifest must be able to name any
# legitimate difference and nothing more:
#
#   {"match": ..., "match_upstream": ..., "why": ...}
#       A REGEX matched against whole lines (fullmatch) and stripped from BOTH
#       sides. Use when the line is UNIQUE in the file: a reworded upstream line
#       still reports DRIFTED rather than silently passing.
#
#   {"block": [<exact lines>], "side": "local"|"upstream", "why": ...}
#       A contiguous patch stripped as an EXACT run from ONE side only (#44).
#       Use when the lines are NOT unique -- a bare '#', a blank line, a
#       duplicated assertion -- where any per-line pattern broad enough to match
#       would also strip unrelated lines and stop the guard discriminating.
#       The block must occur EXACTLY ONCE on its own side; zero or two
#       occurrences is DRIFTED naming the count, never a silent pass (#343).

set -uo pipefail

ORIG_ARGS=("$@")

# --- unified tools log (#739) ------------------------------------------------
# Armed BEFORE the arg loop, so a usage refusal (rc 2) is logged too: this tool
# wrote NO row at all, and an unlogged refusal is indistinguishable from a run
# that never happened. The lib's documented wiring needs BOTH halves --
# oc_log_init AND an EXIT trap -- and the real path further down used to `exec`
# python3, which REPLACES the shell image and would leave that trap dead. That
# path no longer execs (see the CHECKER invocation below).
_oc_log_lib="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)/oc-log.sh"
if [ -f "$_oc_log_lib" ]; then
    . "$_oc_log_lib"
    oc_log_init "oc-vendor-drift" "$@"
    trap 'oc_log_finish $?' EXIT
fi

MODE="check"
JSON=0
REPO_OVERRIDE=""
REF_OVERRIDE=""
ADVISORY_ONLY=0
MANIFEST_OVERRIDE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --json)     JSON=1; shift ;;
        --repo) [ $# -ge 2 ] || { echo "oc-vendor-drift: --repo needs a value" >&2; exit 2; };     REPO_OVERRIDE=""$2""; shift 2 ;;
        --manifest) [ $# -ge 2 ] || { echo "oc-vendor-drift: --manifest needs a value" >&2; exit 2; }; MANIFEST_OVERRIDE=""$2""; shift 2 ;;
        --ref) [ $# -ge 2 ] || { echo "oc-vendor-drift: --ref needs a value" >&2; exit 2; };      REF_OVERRIDE=""$2""; shift 2 ;;
        --root)     shift 2 ;;
        --advisory-only) ADVISORY_ONLY=1; shift ;;
        --selftest) MODE="selftest"; shift ;;
        -h|--help)  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        --check-internal) shift ;;
        *) echo "oc-vendor-drift: unknown flag $1" >&2; exit 2 ;;
    esac
done

# Vendored paths in the manifest are relative to the skill repo root, two levels
# up from tools/audit/.
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
MANIFEST="${MANIFEST_OVERRIDE:-$REPO_ROOT/tools/docs/vendor-manifest.json}"

# --- selftest (drives the shipped checker against a scratch upstream) --------
if [ "$MODE" = "selftest" ]; then
    exec python3 - "$0" <<'PY'
import json, os, shutil, subprocess, sys, tempfile

TOOL = os.path.abspath(sys.argv[1])
ok = bad = 0
def ck(c, m):
    global ok, bad
    if c:
        ok += 1; print("ok   - %s" % m)
    else:
        bad += 1; print("FAIL - %s" % m)

def check(manifest, root, repo):
    """Drive the SHIPPED checker through the tool's own CLI."""
    p = subprocess.run(["bash", TOOL, "--check-internal",
                        "--manifest", manifest, "--repo", repo, "--root", root],
                       capture_output=True, text=True)
    return p.returncode, p.stdout

tmp = tempfile.mkdtemp(prefix="oc-vd-")
up = os.path.join(tmp, "upstream")
os.makedirs(os.path.join(up, "T"), exist_ok=True)
for cmd in (["init", "-q"], ["config", "user.email", "t@t"],
            ["config", "user.name", "t"]):
    subprocess.run(["git", "-C", up] + cmd, check=True,
                   capture_output=True)
BODY = ("#!/usr/bin/env python3\n"
        "PROG = \"upstream-name\"\n"
        "RENDER = \"x-render.mjs\"\n"
        "def main():\n"
        "    return 0\n")
with open(os.path.join(up, "T", "thing"), "w") as fh:
    fh.write(BODY)
subprocess.run(["git", "-C", up, "add", "-A"], check=True, capture_output=True)
subprocess.run(["git", "-C", up, "commit", "-qm", "one"], check=True,
               capture_output=True)
REF = subprocess.run(["git", "-C", up, "rev-parse", "HEAD"],
                     capture_output=True, text=True).stdout.strip()
# The scratch repo has no remote; give it origin/main = the checked-out commit,
# or rev-parse yields nothing and every advisory assertion passes VACUOUSLY.
subprocess.run(["git", "-C", up, "branch", "-f", "origin/main", "HEAD"],
               check=True, capture_output=True)

local = os.path.join(tmp, "local")
os.makedirs(os.path.join(local, "tools", "state"), exist_ok=True)
LOC = os.path.join(local, "tools", "state", "thing")
VEND = BODY.replace("upstream-name", "oc-questions")

man = {"upstream_repo": up,
       "vendor": [{"local": "tools/state/thing", "upstream_path": "T/thing",
                   "ref": REF,
                   "delta": [
                       {"match": '^PROG = "oc-questions"$',
                        "match_upstream": '^PROG = "upstream-name"$',
                        "why": "deployment name"},
                       {"match": '^RENDER = "x-render\\.mjs"$',
                        "why": "sibling name"}]}]}
mpath = os.path.join(tmp, "manifest.json")

def write_manifest(d):
    with open(mpath, "w") as fh:
        json.dump(d, fh, indent=2)

# LEG 1 -- a vendored copy differing ONLY by the declared delta is IN_SYNC.
with open(LOC, "w") as fh:
    fh.write(VEND)
write_manifest(man)
rc, out = check(mpath, local, up)
ck(rc == 0 and "IN_SYNC" in out,
   "declared delta only -> IN_SYNC rc=0 (rc=%d)" % rc)

# LEG 2 -- NEGATIVE CONTROL: one byte edited outside the delta -> DRIFTED rc=1.
with open(LOC, "w") as fh:
    fh.write(VEND.replace("return 0", "return 1"))
rc, out = check(mpath, local, up)
ck(rc == 1 and "DRIFTED" in out,
   "one byte outside the delta -> DRIFTED rc=1 (rc=%d)" % rc)

# LEG 2b -- an edit ON a delta line but OUTSIDE the declared part is drift.
# Regression control for the 2026-09-29 blindness: with a prefix-style delta
# pattern, appending text to the PROG line left the guard green.
with open(LOC, "w") as fh:
    fh.write(VEND.replace('PROG = "oc-questions"',
                          'PROG = "oc-questions"  # peer edit'))
rc, out = check(mpath, local, up)
ck(rc == 1 and "DRIFTED" in out,
   "edit after a declared delta line -> DRIFTED rc=1 (rc=%d)" % rc)

# LEG 2c -- the guard must not DEPEND on the manifest's pattern being end-anchored.
# A delta declared with an open-ended pattern ("^PROG = ") must still match only a
# WHOLE line: under the old search() it stripped any line carrying that prefix and
# the edited line read in-sync. This is the control for the search->fullmatch fix.
with open(LOC, "w") as fh:
    fh.write(VEND.replace('PROG = "oc-questions"',
                          'PROG = "oc-questions"  # peer edit'))
open_ended = json.loads(json.dumps(man))
open_ended["vendor"][0]["delta"][0]["match"] = "^PROG = "
open_ended["vendor"][0]["delta"][0].pop("match_upstream", None)
write_manifest(open_ended)
rc, out = check(mpath, local, up)
ck(rc == 1 and "DRIFTED" in out,
   "open_ended delta pattern still matches ONE line only -> DRIFTED (rc=%d)" % rc)

# LEG 3 -- a missing vendored file is reported, never assumed clean.
os.unlink(LOC)
rc, out = check(mpath, local, up)
ck(rc == 1 and "LOCAL_MISSING" in out,
   "absent vendored file -> LOCAL_MISSING rc=1 (rc=%d)" % rc)

# LEG 4 -- an unreachable upstream ref is rc 3, never a green.
with open(LOC, "w") as fh:
    fh.write(VEND)
man2 = json.loads(json.dumps(man))
man2["vendor"][0]["ref"] = "0" * 40
write_manifest(man2)
rc, out = check(mpath, local, up)
ck(rc == 3 and "UPSTREAM_UNREACHABLE" in out,
   "unresolvable ref -> UPSTREAM_UNREACHABLE rc=3 (rc=%d)" % rc)

# LEG 5 -- a SHORT-FORM recorded ref naming origin/main's own commit must NOT
# report MOVED: two spellings of one commit are not movement. Regression
# control for the 2026-09-29 defect, where a raw string compare against the
# 40-char head printed "is c0a8f614eef7 (recorded c0a8f614eef7)".
write_manifest(man)
with open(LOC, "w") as fh:
    fh.write(VEND)
short = json.loads(json.dumps(man))
short["vendor"][0]["ref"] = REF[:12]
write_manifest(short)
rc, out = check(mpath, local, up)
ck(rc == 0 and "UPSTREAM_MOVED" not in out,
   "short-form ref naming HEAD -> IN_SYNC, no MOVED advisory (rc=%d)" % rc)

# LEG 6 -- upstream moving past the recorded ref IS an advisory, not drift:
# the control proving LEG 5's fix did not silence real movement.
write_manifest(man)
with open(os.path.join(up, "T", "thing"), "a") as fh:
    fh.write("# peer edit\n")
subprocess.run(["git", "-C", up, "add", "-A"], check=True, capture_output=True)
subprocess.run(["git", "-C", up, "commit", "-qm", "two"], check=True,
               capture_output=True)
subprocess.run(["git", "-C", up, "branch", "-f", "origin/main", "HEAD"],
               check=True, capture_output=True)
rc, out = check(mpath, local, up)
ck("UPSTREAM_MOVED" in out,
   "upstream advanced -> UPSTREAM_MOVED advisory present (control)")

# LEG 7 -- a BLOCK delta (#44): a contiguous patch whose lines are NOT unique.
# The real case (measured 2026-10-17 on the vendored oc-questions) carried a bare
# '#', a blank line and a duplicated assertion, so NO per-line pattern can name
# it: a broad one strips unrelated lines and the guard stops discriminating (the
# #41 trap). A block is stripped as an EXACT contiguous run, own side only.
BLOCK_UP = ('#!/usr/bin/env python3\n'
            '# old one\n'
            'CLOSED = ("a", "b")\n'
            '# SHARED MARKER\n'
            'SHARED = 1\n'
            'def main():\n'
            '    return 0\n')
BLOCK_LOC = ('#!/usr/bin/env python3\n'
             '#\n'
             '# new\n'
             '#\n'
             'CLOSED = ("a", "b", "c")\n'
             '# SHARED MARKER\n'
             'SHARED = 1\n'
             'def main():\n'
             '    return 0\n')
with open(os.path.join(up, "T", "thing"), "w") as fh:
    fh.write(BLOCK_UP)
subprocess.run(["git", "-C", up, "add", "-A"], check=True, capture_output=True)
subprocess.run(["git", "-C", up, "commit", "-qm", "block"], check=True,
               capture_output=True)
subprocess.run(["git", "-C", up, "branch", "-f", "origin/main", "HEAD"],
               check=True, capture_output=True)
REF_B = subprocess.run(["git", "-C", up, "rev-parse", "HEAD"],
                       capture_output=True, text=True).stdout.strip()
with open(LOC, "w") as fh:
    fh.write(BLOCK_LOC)
blk = {"upstream_repo": up,
       "vendor": [{"local": "tools/state/thing", "upstream_path": "T/thing",
                   "ref": REF_B,
                   "delta": [
                       {"block": ["# old one", 'CLOSED = ("a", "b")'],
                        "side": "upstream", "why": "upstream form"},
                       {"block": ["#", "# new", "#",
                                  'CLOSED = ("a", "b", "c")'],
                        "side": "local",
                        "why": "local patch with a duplicated hash line"}]}]}
write_manifest(blk)
rc, out = check(mpath, local, up)
ck(rc == 0 and "IN_SYNC" in out,
   "block delta carrying non-unique lines -> IN_SYNC rc=0 (rc=%d)" % rc)

# LEG 7b -- one byte edited INSIDE a declared block is drift: a block is EXACT,
# never a fuzzy region.
with open(LOC, "w") as fh:
    fh.write(BLOCK_LOC.replace('"a", "b", "c"', '"a", "b", "d"'))
rc, out = check(mpath, local, up)
ck(rc == 1 and "DRIFTED" in out,
   "one byte inside a declared block -> DRIFTED rc=1 (rc=%d)" % rc)

# LEG 7c -- a block occurring TWICE is unusable and must FAIL CLOSED, naming the
# count. This is the control that stops "strip the first match" from passing.
with open(LOC, "w") as fh:
    fh.write(BLOCK_LOC + BLOCK_LOC)
rc, out = check(mpath, local, up)
ck(rc == 1 and "occurs 2 times" in out,
   "ambiguous block (2 occurrences) -> DRIFTED naming the count (rc=%d)" % rc)

# LEG 7d -- SIDE SCOPING: a block declared for ONE side must not be stripped
# from the other. Both files are IDENTICAL and carry the marker, and the marker
# is declared for 'upstream' ONLY: side respected leaves the local copy in place
# and the verdict is DRIFTED; ignoring `side` strips it from both, the files
# match, and the verdict reads IN_SYNC -- silently hiding that the declaration
# names the wrong side. (Measured 2026-10-17: the first version of this leg used
# divergent fixtures, so stripping the block from both sides STILL differed and
# the leg passed under the very mutant it exists to catch.)
SIDE_BOTH = ('#!/usr/bin/env python3\n'
             '# SHARED MARKER\n'
             'SHARED = 1\n'
             'def main():\n'
             '    return 0\n')
with open(os.path.join(up, "T", "thing"), "w") as fh:
    fh.write(SIDE_BOTH)
subprocess.run(["git", "-C", up, "add", "-A"], check=True, capture_output=True)
subprocess.run(["git", "-C", up, "commit", "-qm", "side"], check=True,
               capture_output=True)
subprocess.run(["git", "-C", up, "branch", "-f", "origin/main", "HEAD"],
               check=True, capture_output=True)
REF_C = subprocess.run(["git", "-C", up, "rev-parse", "HEAD"],
                       capture_output=True, text=True).stdout.strip()
with open(LOC, "w") as fh:
    fh.write(SIDE_BOTH)
side_man = {"upstream_repo": up,
            "vendor": [{"local": "tools/state/thing",
                        "upstream_path": "T/thing", "ref": REF_C,
                        "delta": [{"block": ["# SHARED MARKER", "SHARED = 1"],
                                   "side": "upstream",
                                   "why": "side-scoping control"}]}]}
write_manifest(side_man)
rc, out = check(mpath, local, up)
ck(rc == 1 and "DRIFTED" in out,
   "a block declared for one side is not stripped from the other -> DRIFTED "
   "(rc=%d)" % rc)

# LEG 7e -- a delta entry with NO matcher must FAIL CLOSED. The old code fell
# back to "$^", which under fullmatch matches the EMPTY string: it strips every
# blank line from both sides and the pair reads IN_SYNC -- a silent over-strip
# that makes the guard stop discriminating. The files here are IDENTICAL, so
# IN_SYNC is exactly the wrong answer and only the declaration is at fault.
with open(LOC, "w") as fh:
    fh.write(SIDE_BOTH)
nomatch_man = {"upstream_repo": up,
               "vendor": [{"local": "tools/state/thing",
                           "upstream_path": "T/thing", "ref": REF_C,
                           "delta": [{"why": "no matcher declared at all"}]}]}
write_manifest(nomatch_man)
rc, out = check(mpath, local, up)
ck(rc == 1 and "DRIFTED" in out and "neither 'match' nor" in out,
   "a delta with no matcher -> DRIFTED, never a silent strip (rc=%d)" % rc)

shutil.rmtree(tmp, ignore_errors=True)
print("selftest: %d passed, %d failed" % (ok, bad))
sys.exit(1 if bad else 0)
PY
fi

# NOT `exec`: the checker must stay a CHILD of this shell so the EXIT trap armed
# at the top can write the unified-log row -- `exec` replaces the image and the
# trap dies with it (#739).
python3 - "$0" "$MANIFEST" "$REPO_ROOT" "${ORIG_ARGS[@]}" <<'PY'
# --- CHECKER BEGIN --- (pure python; single source for selftest + runtime)
import json, os, re, subprocess, sys

TOOL = os.path.abspath(sys.argv[1])
MANIFEST = sys.argv[2] if len(sys.argv) > 2 else ""
ROOT = sys.argv[3] if len(sys.argv) > 3 else ""
argv = sys.argv[4:]

def opt(name, default=""):
    if name in argv:
        return argv[argv.index(name) + 1]
    return default

MANIFEST = opt("--manifest", MANIFEST) or os.environ.get("OC_VD_MANIFEST", "")
ROOT = opt("--root", ROOT) or os.environ.get("OC_VD_REPO_ROOT", "")
UPSTREAM = opt("--repo", os.environ.get("OC_VD_REPO", ""))
REF_OVERRIDE = opt("--ref", os.environ.get("OC_VD_REF", ""))
AS_JSON = "--json" in argv or os.environ.get("OC_VD_JSON", "0") == "1"

def git(repo, *args):
    p = subprocess.run(["git", "-C", repo] + list(args),
                       capture_output=True, text=True)
    return p.returncode, p.stdout

def norm(text, delta, side="local"):
    """Drop every line matching a declared delta pattern for THIS side.

    A delta line is a line the two copies legitimately differ in, so it must be
    droppable from BOTH sides -- but the local and upstream forms differ (ours
    derives the name, theirs hardcodes it), so an entry may carry
    `match_upstream` to name the upstream form. Without that, only our side is
    stripped and the upstream line shifts the comparison, reporting DRIFTED on a
    file that is exactly as declared.
    """
    pats = []
    blocks = []
    for i, d in enumerate(delta or []):
        if "block" in d:
            # A BLOCK delta (#44): a contiguous patch whose lines are NOT unique
            # in the file -- a bare '#', a blank line, a duplicated assertion --
            # so no per-line pattern can name it without stripping unrelated
            # lines. It is stripped from its OWN side only, as an exact
            # contiguous run.
            if (d.get("side") or "local") == side:
                blocks.append(d)
            continue
        m = d.get("match_upstream") if side == "upstream" else d.get("match")
        m = m or d.get("match")
        if not m:
            # FAIL CLOSED. The old fallback was "$^", which is a VALID
            # regex matching the EMPTY string: under fullmatch it strips
            # every blank line from BOTH sides, so a declaration that
            # names nothing silently over-strips and reads green -- the
            # #41 force-match trap wearing a default.
            raise ValueError(
                "delta entry #%d has neither 'match' nor 'match_upstream'"
                % (i + 1))
        pats.append(re.compile(m))
    out = []
    for line in text.splitlines(True):
        # FULLMATCH, not search: a prefix-style pattern silently strips a line
        # that was EDITED after the declared part, so any edit on a delta line
        # read as in-sync (measured 2026-09-29: appending "# peer edit" to the
        # PROG line left the guard green).
        if any(p.fullmatch(line.rstrip("\n")) for p in pats):
            continue
        out.append(line)
    text = "".join(out)
    for d in blocks:
        block = d["block"]
        lines = text.splitlines()
        spans = [i for i in range(len(lines) - len(block) + 1)
                 if block and lines[i:i + len(block)] == block]
        if len(spans) != 1:
            # FAIL CLOSED (#343): a block that is absent or AMBIGUOUS cannot be
            # declared, and must never read as stripped. The caller turns this
            # into DRIFTED naming the count -- never a silent pass, never a
            # traceback that bypasses the verdict vocabulary.
            raise ValueError(
                "declared block occurs %d times (need exactly 1): %s"
                % (len(spans), (d.get("why") or "")[:70] or repr(block[:1])))
        i = spans[0]
        del lines[i:i + len(block)]
        text = "\n".join(lines) + ("\n" if text.endswith("\n") else "")
    return text

try:
    with open(MANIFEST, encoding="utf-8") as fh:
        man = json.load(fh)
except (OSError, ValueError) as exc:
    print("oc-vendor-drift: manifest unreadable (%s): %s" % (MANIFEST, exc),
          file=sys.stderr)
    sys.exit(2)

repo = UPSTREAM or man.get("upstream_repo", "")
entries = man.get("vendor", [])
if not entries:
    print("oc-vendor-drift: manifest declares no vendored files", file=sys.stderr)
    sys.exit(2)

results = []
drift = 0
unreachable = 0

head = ""
if repo and os.path.isdir(os.path.join(repo, ".git")):
    rc, head = git(repo, "rev-parse", "origin/main")
    head = head.strip()

for e in entries:
    local_rel = e.get("local", "")
    up_path = e.get("upstream_path", "")
    ref = REF_OVERRIDE or e.get("ref", "")
    delta = e.get("delta", [])
    row = {"local": local_rel, "upstream_path": up_path, "ref": ref,
           "verdict": "IN_SYNC", "detail": ""}

    local_abs = os.path.join(ROOT, local_rel)
    if not ROOT or not os.path.isfile(local_abs):
        row["verdict"] = "LOCAL_MISSING"
        row["detail"] = "no file at %s" % (local_rel or "<unset>")
        results.append(row)
        drift += 1
        continue

    if not repo or not os.path.isdir(os.path.join(repo, ".git")):
        row["verdict"] = "UPSTREAM_UNREACHABLE"
        row["detail"] = "no git repo at %s" % (repo or "<unset>")
        results.append(row)
        unreachable += 1
        continue

    rc, up_text = git(repo, "show", "%s:%s" % (ref, up_path))
    if rc != 0:
        row["verdict"] = "UPSTREAM_UNREACHABLE"
        row["detail"] = "cannot read %s:%s" % ((ref or "<no ref>")[:12], up_path)
        results.append(row)
        unreachable += 1
        continue

    with open(local_abs, encoding="utf-8", errors="replace") as fh:
        local_text = fh.read()
    try:
        a = norm(local_text, delta, "local")
        b = norm(up_text, delta, "upstream")
    except ValueError as exc:
        # A declared delta that cannot be applied is DRIFT, never a pass and
        # never a crash: the manifest is part of the claim being made (#44).
        row["verdict"] = "DRIFTED"
        row["detail"] = "declared delta unusable: %s" % exc
        drift += 1
        results.append(row)
        continue
    if a == b:
        n_pats = sum(1 for d in delta if "block" not in d)
        n_block = sum(len(d.get("block") or []) for d in delta
                      if "block" in d)
        row["detail"] = ("%d lines match after %d delta entr%s "
                         "(%d per-line pattern%s, %d block line%s)") % (
            len(a.splitlines()), len(delta),
            "y" if len(delta) == 1 else "ies",
            n_pats, "" if n_pats == 1 else "s",
            n_block, "" if n_block == 1 else "s")
    else:
        al, bl = a.splitlines(), b.splitlines()
        first = ""
        for i in range(max(len(al), len(bl))):
            x = al[i] if i < len(al) else "<absent>"
            y = bl[i] if i < len(bl) else "<absent>"
            if x != y:
                first = "first diff line %d: vendored %r vs upstream %r" % (
                    i + 1, x[:70], y[:70])
                break
        row["verdict"] = "DRIFTED"
        row["detail"] = "%d vendored vs %d upstream lines; %s" % (
            len(al), len(bl), first)
        drift += 1

    if head and ref:
        # Compare FULL shas: a recorded ref may legitimately be a short form or a
        # tag/branch name, and a raw string compare then reports MOVED for two
        # spellings of the SAME commit (measured 2026-09-29: a 12-char ref against
        # the 40-char head printed "is c0a8f614eef7 (recorded c0a8f614eef7)").
        rc2, ref_full = git(repo, "rev-parse", "--verify", "--quiet",
                            "%s^{commit}" % ref)
        ref_full = ref_full.strip()
        if rc2 == 0 and ref_full and head != ref_full:
            row["verdict"] = row["verdict"] + "+UPSTREAM_MOVED"
            row["detail"] += " | upstream origin/main is %s (recorded %s)" % (
                head[:12], ref_full[:12])
        results.append(row)

if AS_JSON:
    print(json.dumps({"verdicts": results, "drifted": drift,
                      "unreachable": unreachable, "upstream_head": head},
                     indent=2))
else:
    for r in results:
        print("%-26s %s :: %s" % (r["verdict"], r["local"], r["detail"]))
    print("summary: %d vendored, %d drifted, %d unreachable" % (
        len(results), drift, unreachable))

if drift:
    sys.exit(1)
if unreachable == len(results):
    sys.exit(3)
sys.exit(0)
PY

# Propagate the checker's status EXPLICITLY (rather than relying on it being the
# last command) so the EXIT trap above logs the TRUE rc for every outcome.
_oc_rc=$?
exit "$_oc_rc"
