DISPATCH_WINDOW_DAYS = 30

def extract_claimed_issues(ledger_data):
    return {tok for claim in oc_claims.open_claims(ledger_data.get("events", []))
            for tok in claim["tokens"]}

def ledger_landed_issues(ledger_data):
    rows = oc_claims.parse_events(ledger_data.get("events", []))
    out = set()
    for row in rows:
        if row["kind"] in oc_claims.LANDED_KINDS:
            out.update(row["targets"])
    return out
'''

LEDGER_DELEGATE = '''#!/bin/sh
# The closure predicate lives in tools/lib/oc_claims.py - THE single
# implementation, shared with oc-harvest-dispatch (#305) and oc-roster (#314).
echo ok
'''

LEDGER_BLOB_COPY = '''#!/bin/sh
cmd_claims() {
  python3 -c '
import re
CLOSERS = {"close", "confirm", "reject", "done", "unclaim"}

def claims_index(events):
    opens = []
    for i, ev in enumerate(events):
        if ev.get("kind") != "claim":
            continue
        closed = False
        for later in events[i + 1:]:
            if later.get("kind") not in CLOSERS:
                continue
            closed = True
            break
        if not closed:
            opens.append(ev)
    return opens
' "$LEDGER"
}
'''


def _write_tree(root, files):
    os.makedirs(root, exist_ok=True)
    for name, text in files.items():
        with open(os.path.join(root, name), "w", encoding="utf-8") as fh:
            fh.write(text)

#: A copy carried by a SINGLE-LINE `python3 -c '...'` word — the shape that
#: swallowed the rest of the file under the old fence. The old extractor scanned
#: forward for a line BEGINNING with a quote, which a one-liner never has, so its
#: "blob" ran on through every following shell line and parsed as nothing. The
#: python here is ALL on line 2, and it declares the canonical constant, so ARM B
#: must fire — which is only possible if the blob was fenced at its own closing
#: quote and actually scanned.
SINGLE_LINE_BLOB_COPY = '''#!/bin/sh
LEDGER="$1"
n="$(python3 -c 'CLOSERS = ("close", "confirm", "reject", "done", "unclaim"); print(1)' "$LEDGER")"
echo "$n"
'''

#: A COMMENT that merely MENTIONS `python3 -c` (the oc-harvest-dispatch:37
#: shape). It is not python and must open no blob at all — under the old rule it
#: opened a "blob" that ran to the end of the file.
COMMENT_MENTION = '''#!/bin/sh
# The python engine runs as 'python3 -c', so sys.argv[0] is '-c' and cannot
# locate this tool's own lib/ -- hand it the tools dir explicitly.
export OC_TOOLS_DIR="$PWD"
'''

#: The mixed-quoting one-liner (oc-health's shape): a `$var` in the middle of a
#: single-quoted python blob, written `'"$X"'`. Reconstructed with the
#: substitution standing in for the value, the python must still PARSE, because
#: an unparsed blob is an unscanned blob.
MIXED_QUOTE_ONELINER = '''#!/bin/sh
first="$(python3 -c 'import json; print(json.load(open("'"$STATE/x.json"'"))["k"])')"
'''


def _run_cli(root):
    proc = subprocess.run([sys.executable, SELF, "--scan", root],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return proc.returncode, (proc.stdout + proc.stderr)


def _arm_counts(findings, rel):
    a = sum(1 for r, _, d in findings if r == rel and d.startswith("ARM A"))
    b = sum(1 for r, _, d in findings if r == rel and d.startswith("ARM B"))
    return a, b


def selftest():
    legs = []

    def ck(name, cond, detail=""):
        legs.append((name, bool(cond), detail))

    tmp = tempfile.mkdtemp(prefix="oc-css-selftest-")
    try:
        # ---- leg group 1: the current, fixed state must be silent -----------
        clean = os.path.join(tmp, "clean")
        _write_tree(clean, {
            "oc-harvest-dispatch": WRAPPER_NAMED,
            "oc-harvest-census": CENSUS_DELEGATE,
            "oc-issue-dispatch": ISSUE_DELEGATE,
            "oc-ledger": LEDGER_DELEGATE,
        })
        finds_clean, units, skipped_clean = scan(clean)
        ck("delegating tree: zero HARD findings", finds_clean == [], repr(finds_clean))
        ck("delegating tree: units were actually scanned", unit_count(units) > 0,
           "units=%d" % unit_count(units))
        rc, out = _run_cli(clean)
        ck("delegating tree: CLI exits 0", rc == 0, "rc=%d %s" % (rc, out.strip()[:100]))

        # ---- leg group 2: the two REAL deleted copies must both be caught --
        dirty = os.path.join(tmp, "dirty")
        _write_tree(dirty, {
            "oc-roster": ROSTER_COPY,
            "oc-harvest-dispatch": HD_COPY,
            "oc-harvest-census": CENSUS_DELEGATE,
            "oc-issue-dispatch": ISSUE_DELEGATE,
            "oc-ledger": LEDGER_DELEGATE,
        })
        finds, _, _ = scan(dirty)
        a, b = _arm_counts(finds, "oc-roster")
        ck("roster copy: ARM A fires on claims_index", a >= 1, "armA=%d" % a)
        ck("roster copy: ARM B fires on CLOSERS", b >= 1, "armB=%d" % b)
        a, b = _arm_counts(finds, "oc-harvest-dispatch")
        ck("dispatch copy: ARM A fires on claim_is_closed", a >= 1, "armA=%d" % a)
        ck("dispatch copy: ARM B fires on _CLOSING_KINDS", b >= 1, "armB=%d" % b)

        # ---- leg groups 3+4: the false-positive boundary -------------------
        a, b = _arm_counts(finds, "oc-harvest-census")
        ck("delegating oc-harvest-census does NOT fire", a == 0 and b == 0, "a=%d b=%d" % (a, b))
        a, b = _arm_counts(finds, "oc-issue-dispatch")
        ck("oc-issue-dispatch does NOT fire (delegates; LANDED_KINDS is a USE)",
           a == 0 and b == 0, "a=%d b=%d" % (a, b))
        a, b = _arm_counts(finds_clean, "oc-harvest-dispatch")
        ck("a delegating def named claim_is_closed does NOT fire (name-independence)",
           a == 0 and b == 0, "a=%d b=%d" % (a, b))

        # ---- leg group 6: the embedded-blob surface (oc-ledger's shape) ----
        blobs = os.path.join(tmp, "blobs")
        _write_tree(blobs, {"oc-ledger": LEDGER_BLOB_COPY})
        finds, _, _ = scan(blobs)
        a, b = _arm_counts(finds, "oc-ledger")
        ck("shell blob: ARM A fires inside a python3 -c blob", a >= 1, repr(finds))
        ck("shell blob: ARM B fires inside a python3 -c blob", b >= 1, repr(finds))
        rc, _ = _run_cli(blobs)
        ck("shell blob: CLI exits 1", rc == 1, "rc=%d" % rc)

        # ---- leg group 7: the CLI contract ---------------------------------
        rc, out = _run_cli(dirty)
        ck("dirty tree: CLI exits 1", rc == 1, "rc=%d" % rc)
        rc, _ = _run_cli(os.path.join(tmp, "no-such-dir"))
        ck("missing --scan DIR exits 2", rc == 2, "rc=%d" % rc)

        # ---- leg group 8: THE regression assertion -------------------------
        finds, units, skipped_live = scan(TOOLS_DIR)
        ck("LIVE tools/ tree: zero HARD findings", finds == [], repr(finds[:3]))
        # ANCHORED, never a substring (#16): `CANONICAL_REL in r` is true of
        # `lib/oc_claims.py.<ts>.bak`, so the leg used to red on a sidecar whose
        # name merely CONTAINS the canonical path. An exact-rel test asks the
        # question the exclusion actually answers.
        ck("LIVE tools/ tree: the canonical module was excluded",
           not any(r == CANONICAL_REL for r, _, _ in finds),
           "units=%d" % unit_count(units))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

        # ---- leg group 9: the coverage report cannot hide a skipped unit --
        # The defect this leg pins: the ok-line counted PARSED units while the
        # ENUMERATED denominator stayed invisible, so six units sat unscanned
        # behind a green line. Two independent facts must hold - the counts are
        # reported separately, and a skipped unit is NAMED (not merely counted).
        whole = unit_count(units) + len(skipped_live)
        # The leg that used to sit here asserted `whole >= unit_count(units)`
        # where `whole` is DEFINED as parsed + skipped - an identity that a
        # coverage hole SATISFIES. Leg group 11 already carries the real bar
        # (skipped_live == [] and declared == parsed), so this is not the place
        # for a second copy of it. What was missing is the ROOT IDENTITY: a
        # narrowed root passes every count leg in this file, because the counts
        # are internally consistent however little they see. Measured 2026-09-25:
        # with the flat derivation the tool reported "1 of 1" truthfully and
        # green, while the surface was 36. These two legs fail on a root that is
        # not the root, which no arithmetic over the scan can catch.
        ck("root: TOOLS_DIR holds lib/oc-root.sh (it IS the tools root)",
           os.path.isfile(os.path.join(TOOLS_DIR, "lib", "oc-root.sh")),
           "TOOLS_DIR=%s" % TOOLS_DIR)
        ck("root: the live scan saw more than one unit",
           whole > 1,
           "declared=%d TOOLS_DIR=%s - the root derivation resolved to the "
           "tool's own kind-dir, not the tools root" % (whole, TOOLS_DIR))
        ck("coverage: every unparsed unit carries a non-empty reason",
           all(r.strip() for _, _, r in skipped_live),
           repr([r for _, _, r in skipped_live][:3]))
        a, b2 = _arm_counts(scan(TOOLS_DIR)[0], "oc-ledger")
        ck("coverage: ARM scan still clean on the live tree", a == 0 and b2 == 0,
           "a=%d b=%d" % (a, b2))

        # ---- leg group 10: the BLOB FENCE (extractor coverage, 2026-09-21) ---
        # Reported by HQ: the guard ran green while scanning 14 of 19 units and
        # emitting 5 coverage notes. The host code was fine — the FENCE was not.
        # Two shapes, both measured live:
        #   (a) a single-line `python3 -c 'x' "$arg"` has no line beginning with a
        #       quote, so the forward scan ran to the NEXT such line and swallowed
        #       94/151/324/390 lines of shell (oc-health:192/796/406,
        #       oc-harvest-census:2156 — the 324-line one contained a `'` on a
        #       later line and stopped there by luck);
        #   (b) a COMMENT mentioning `python3 -c` opened a 2035-line "blob"
        #       (oc-harvest-dispatch:37).
        # Both are extractor artefacts that the report BLAMED ON THE HOST FILE.
        fenced = os.path.join(tmp, "fenced")
        _write_tree(fenced, {
            "oc-single-line-copy": SINGLE_LINE_BLOB_COPY,
            "oc-comment-mention": COMMENT_MENTION,
            "oc-mixed-quote": MIXED_QUOTE_ONELINER,
        })
        finds_f, units_f, skipped_f = scan(fenced)
        a, b = _arm_counts(finds_f, "oc-single-line-copy")
        # MUTATION KILL: restore the unconditional forward scan and this fails —
        # the blob swallows the following shell and parses as nothing, so the
        # unit is never scanned and ARM B cannot fire.
        ck("single-line blob: ARM B fires on the constant it carries", b >= 1,
           "armB=%d finds=%r skipped=%r" % (b, finds_f, skipped_f))
        # A blob that cannot be fenced is a coverage hole; these three files must
        # contribute NONE, which is the property the five live notes violated.
        ck("blob fence: no unit of the fenced tree is a coverage hole",
           skipped_f == [], "skipped=%r" % (skipped_f,))
        # MUTATION KILL: let a comment open a blob and this reddens — the mention
        # swallows the rest of the file (2 shell lines here, 2035 live).
        # The assertion is about the UNITS the file contributes, not about a count:
        # `units` carries a row per FILE (parsed units plus, separately, the skips),
        # and oc-comment-mention is neither python nor blob-bearing — so its row is
        # correctly EMPTY. Two earlier forms were wrong about the fixture in opposite
        # directions: `unit_count >= 3` demanded units that must not exist, and a
        # `name in units_f` test is true of every file. Pin the row.
        ck("a COMMENT mentioning python3 -c opens no blob",
           units_f.get("oc-comment-mention", ("", []))[1] == []
           and not any(r == "oc-comment-mention" for r, _, _ in skipped_f),
           "row=%r units=%d skipped=%r" % (units_f.get("oc-comment-mention", ("?", "ABSENT"))[1],
                                           unit_count(units_f), skipped_f))
        # The mixed-quoting one-liner is reconstructed rather than sliced, so its
        # python PARSES; before the reconstruction it sliced `...open("'"$X"'"))`
        # and every live oc-health blob of this shape was a hole.
        mixed = [(s, c) for s, c in python_units(os.path.join(fenced, "oc-mixed-quote"),
                                                 MIXED_QUOTE_ONELINER)]
        ck("mixed-quoting one-liner reconstructs to parseable python",
           bool(mixed) and all(_parse(c) is not None for _, c in mixed),
           repr([_unparsed_reason(c) for _, c in mixed][:2]))

        # ---- leg group 11: the LIVE tree has NO coverage hole ---------------
        # This is the regression assertion for the five notes. The old leg only
        # required `declared >= parsed`, which a hole SATISFIES — that is how the
        # defect stayed green. The bar is now full coverage on the real tree.
        ck("LIVE tools/ tree: every declared unit is scanned (no coverage hole)",
           skipped_live == [], "skipped=%r" % (skipped_live,))
        ck("LIVE tools/ tree: declared figure equals parsed figure",
           whole == unit_count(units),
           "declared=%d parsed=%d" % (whole, unit_count(units)))

        # ---- leg group 12: the GENERATED sidecar class is NOT source (#16) --
        # The harness's editing tools leave a pre-image beside the file they
        # touch, and a pre-image of a scanned module is byte-identical to its
        # source: it carries the predicate's exact shape, both arms fire on it,
        # and a CLEAN tree reds the battery (measured 2026-10-05). The exclusion
        # must be NARROW, so this fixture plants the sidecars BESIDE a real
        # private copy: the copy must still be caught, no finding may be
        # attributed to a sidecar, and the `oc-bakery` control kills a widened
        # exclusion (a bare `"bak" in name` test would silently skip it).
        side = os.path.join(tmp, "sidecar")
        _write_tree(side, {
            "oc-roster": ROSTER_COPY,
            "oc-roster.bak": ROSTER_COPY,
            "oc-roster.bak-2026-10-05T111834": ROSTER_COPY,
            "oc-roster.pre-2026-10-05T111834": ROSTER_COPY,
            "oc-bakery": ROSTER_COPY,
        })
        finds_s, units_s, _ = scan(side)
        a, b = _arm_counts(finds_s, "oc-roster")
        ck("sidecar: the real private copy beside it is still caught",
           a >= 1 and b >= 1, "a=%d b=%d finds=%r" % (a, b, finds_s))
        ck("sidecar: no .bak/.pre- sidecar is enumerated as a unit",
           not any(_is_generated_sidecar(r) for r in units_s),
           repr([r for r in units_s if _is_generated_sidecar(r)]))
        ck("sidecar: no finding is attributed to a sidecar",
           not any(_is_generated_sidecar(r) for r, _, _ in finds_s),
           repr([r for r, _, _ in finds_s if _is_generated_sidecar(r)][:3]))
        ck("sidecar: a name merely CONTAINING bak is still scanned (no blind spot)",
           _arm_counts(finds_s, "oc-bakery")[0] >= 1,
           "bakery armA=%d" % _arm_counts(finds_s, "oc-bakery")[0])
        # The REPORTED symptom, pinned exactly: a tree of sidecars ALONE is clean
        # and the CLI exits 0 - before the fix this was the red battery receipt.
        only_side = os.path.join(tmp, "only-sidecar")
        _write_tree(only_side, {
            "oc_roster.bak": ROSTER_COPY,
            "oc_roster.py.bak-2026-10-05T111834": ROSTER_COPY,
        })
        finds_only, _, _ = scan(only_side)
        ck("sidecar: a sidecar-only tree is CLEAN (the reported symptom)",
           finds_only == [], repr(finds_only))
        rc_only, _ = _run_cli(only_side)
        ck("sidecar: CLI exits 0 on a sidecar-only tree", rc_only == 0,
           "rc=%d" % rc_only)

    failed = [x for x in legs if not x[1]]
    for name, _, detail in failed:
        sys.stdout.write("FAIL  %s  %s\n" % (name, detail))
    sys.stdout.write("selftest: %d/%d OK\n" % (len(legs) - len(failed), len(legs)))
    return 2 if failed else 0


def main(argv):
    root = TOOLS_DIR
    args = list(argv[1:])
    while args:
        a = args.pop(0)
        if a == "--selftest":
            return selftest()
        if a == "--scan":
            if not args:
                sys.stderr.write("--scan needs a DIR\n")
                return 2
            root = os.path.abspath(args.pop(0))
        elif a in ("-h", "--help"):
            sys.stdout.write(__doc__.strip() + "\n")
            return 0
        else:
            sys.stderr.write("unknown argument: %s (try --help)\n" % a)
            return 2
    if not os.path.isdir(root):
        sys.stderr.write("not a directory: %s\n" % root)
        return 2

    findings, units, skipped = scan(root)
    for rel, line, desc in findings:
        sys.stdout.write("HARD  %s:%d  %s\n" % (rel, line, desc))
    for rel, start, reason in sorted(skipped):
        sys.stdout.write("NOTE  %s:%d  enumerated but NOT scanned (%s) - this unit is a "
                         "coverage hole; make it parseable, or scan the text another way\n"
                         % (rel, start, reason))
    declared = len(skipped) + unit_count(units)
    if findings:
        sys.stdout.write(
            "%d private copy(ies) of the claim-closure predicate under %s - delegate to "
            "tools/lib/oc_claims.py instead (see tools/skills/opencrabs-dev/SKILL.md)\n"
            % (len(findings), root))
        return 1
    sys.stdout.write("ok: %s: no private copy of the claim-closure predicate in %d of "
                     "%d python unit(s) declared%s\n"
                     % (root, unit_count(units), declared,
                        "" if not skipped else " (%d NOT scanned - see NOTE above)" % len(skipped)))
    return 0


if __name__ == "__main__":
    # Armed before main() so the rc the process ACTUALLY exits with is the rc the
    # row carries -- including a usage error (rc 2) (#739).
    oc_log_init("oc-claims-single-source")
    _rc = main(sys.argv)
    oc_log_finish(_rc)
    sys.exit(_rc)
