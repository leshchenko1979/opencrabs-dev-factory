#!/usr/bin/env python3
"""oc-claims-single-source - the claim-closure predicate has exactly ONE home.

JOB (JTBD): when a lane re-adds a private copy of the claim-closure predicate
under tools/, the battery must FAIL on the copy rather than let a second
implementation drift from tools/lib/oc_claims.py unnoticed.

WHY THIS EXISTS: the predicate was inlined FIVE times and the copies drifted
apart - two extracted issue tokens as ints and two as strings, so one copy's
comparison was forever-False; only one asked WHO authored the closing row, so a
foreign lane's prose mention of #N released a live claim. Every divergence was
found only after it had already produced wrong claim state:

  #305/#313  oc-ledger (embedded blob)  cross-lane standdown silently no-op'd
  #309       oc-issue-dispatch          closer-blind: closed issues read claimed
  #424       oc-roster                  claims_index carried its own copy
  #425       oc-harvest-dispatch        closed on ANY later closer, same lane
  #307       oc-harvest-census          unanchored prose grep made an overlap
  #329/#337  oc-issue-dispatch          target inferred from prose (13 phantoms)

All were fixed by delegation to the canonical module. Nothing mechanically
prevented a sixth; this tool is that prevention.

WHAT IT KEYS ON - NEVER A NAME. Both names were free to vary and did: the two
deleted copies were called claims_index (oc-roster) and claim_is_closed
(oc-harvest-dispatch), and the constant was CLOSERS in oc-roster against
_CLOSING_KINDS in oc-harvest-dispatch. A name-keyed guard misses both. So it
keys on what a copy must RE-IMPLEMENT:

  ARM A  closure VERDICT SHAPE (HARD) - a loop over the SUBSEQUENT slice of an
         event list (X[i + 1:]) that reads the kind dimension and yields a
         closed/open verdict.  Both deleted bodies match this exactly.
  ARM B  a canonical predicate CONSTANT declared locally (HARD) - a module-level
         ALL-CAPS tuple/set literal (optional leading underscore) whose VALUE set
         reconstructs CLOSING_KINDS or LANDED_KINDS.  Keyed on VALUES, so a
         rename still fires.  Restricted to module level, which is what excludes
         every fixture dict and every inline `kind in (...)` comparison.
SCAN UNITS, i.e. the surface this covers: every PYTHON UNIT under tools/ - a
whole .py or python oc-* file, AND (for a shell tool) every python blob it
embeds via `python3 -c '...'` or a `python3 - <<'PY'` heredoc.  The blob form is
not optional coverage: the sharpest historical copy (#305/#313) lived inside
oc-ledger's embedded blob, so a whole-file-only scanner would have missed the
family's centre of gravity.

SCOPE, stated rather than implied: tools/tests/ is EXCLUDED.  A test legitimately
exercises the predicate, and the test tree is not a runtime consumer - the
hazard is a copy that ANSWERS claim questions in production.  The GENERATED
sidecar class (`*.bak`, `*.bak-*`, `*.pre-*`) is EXCLUDED too: a pre-image is not
source, and the battery's own tree fingerprint and the state-dir law both
classify it GENERATED-IGNORED - this guard is the one instrument that disagreed,
so a clean tree red on a lane's own `.bak` (#16).

COVERAGE IS REPORTED, NOT ASSUMED.  A unit that fails to parse is SKIPPED - it
cannot be scanned - so the ok line states BOTH figures, `scanned of declared`,
and prints one `NOTE rel:start` line per skip.  A green report must never rest
on a silent skip: measured 2026-09-20, the tools/ tree declared 18 python units
and this tool scanned 12, so a third of the surface was invisible behind one
confident number.  A scanned file's OWN syntax is not a finding - the `ast.parse`
used to classify it runs with warnings muted and writes nothing to stderr.

Usage: oc-claims-single-source [--scan DIR] [--selftest] [-h]
Exit:  0 clean | 1 HARD finding | 2 usage / IO error
"""

import ast
import os
import re
import sys
import warnings

def _resolve_tools_dir(here):
    """The tools ROOT that owns lib/ - the Python port of the bash bootstrap.

    WHY NOT dirname(__file__): the fleet is grouped by KIND, so this file lives at
    tools/audit/ and its own directory is NOT the root. Measured 2026-09-25 after
    the regroup: the flat derivation scanned 1 of 36 python units and printed
    `ok ... rc=0` - the guard was green over a surface it could not see, which is
    the very failure this tool exists to prevent in others.

    Resolves the way tools/lib/oc-root.sh does, and the two must agree:
      - walk UP to the first ancestor holding lib/oc-root.sh. The marker is that
        file, not a bare lib/, so an unrelated project's lib/ is never our root.
      - a SYMLINKED lib/ is REJECTED: a borrowed lib/ means that ancestor is not
        our root (measured 2026-09-25 - /tmp/lib was a symlink to the real
        tools/lib, so a marker test that followed symlinks stopped the walk at
        /tmp for every script under it).
      - stop at a directory named `tools` even without the marker, so a stale or
        foreign flat layout cannot escape upward into some ancestor's lib/.
      - with NO root found, fall back to the script's own directory. That is the
        fixture case and it is load-bearing: a selftest copies a tool beside FAKE
        siblings and asserts the tool uses THOSE, so a walk that escaped the
        fixture to the real tools/ would silently defeat the test's isolation.
    """
    d = here
    while d != os.sep:
        lib = os.path.join(d, "lib")
        if (os.path.isdir(lib) and not os.path.islink(lib)
                and os.path.isfile(os.path.join(lib, "oc-root.sh"))):
            return d
        if os.path.basename(d) == "tools":
            break
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    return here


_HERE = os.path.dirname(os.path.abspath(__file__))
TOOLS_DIR = _resolve_tools_dir(_HERE)
CANONICAL_REL = os.path.join("lib", "oc_claims.py")

# Unified tools log (#739) - tools/lib/oc_log.py is the ONE Python home for the
# parity with tools/lib/oc-log.sh. This tool previously wrote NO row at all, so
# its absence from tools.log was indistinguishable from disuse. DEGRADES TO
# SILENCE on import failure -- scanning is this tool's job and a missing log
# module must not fail it -- but the gap is REPORTED to stderr, because a silent
# instrumentation failure is precisely what #739 was.
sys.path.insert(0, os.path.join(TOOLS_DIR, "lib"))
try:
    from oc_log import oc_log_init, oc_log_extra, oc_log_finish
except Exception as _oc_log_err:  # pragma: no cover
    sys.stderr.write(
        "oc-claims-single-source: tools/lib/oc_log.py unavailable (%s) - "
        "running UNLOGGED (#739)\n" % _oc_log_err)

    def oc_log_init(*_a, **_k):
        return None

    def oc_log_extra(*_a, **_k):
        return None

    def oc_log_finish(*_a, **_k):
        return None

# Keyed by VALUE, never by name - see the docstring for why.
CLOSING_KIND_VALUES = frozenset(("close", "confirm", "reject", "done", "unclaim"))
LANDED_KIND_VALUES = frozenset(("close", "done"))
CANONICAL_SETS = (CLOSING_KIND_VALUES, LANDED_KIND_VALUES)

# A CONSTANT declaration: CLOSERS, _CLOSING_KINDS, LANDED_KINDS.  The optional
# leading underscore is load-bearing - _CLOSING_KINDS is one of the two real
# deleted copies, and a guard that insisted on a bare-uppercase name would have
# missed it.
CONST_NAME_RE = re.compile(r"^_?[A-Z][A-Z0-9_]{2,}$")
# Verdict VARIABLE names (never function names - those are free to vary).
VERDICT_NAME_RE = re.compile(r"^(closed|is_closed|closer|is_open|open|opens|landed)$")
KINDSIDE_RE = re.compile(r"clos|landed|kind", re.I)
RE_PY_C = re.compile(r"\bpython3\s+-c\s*'")
RE_PY_HEREDOC = re.compile(r"\bpython3\s+-\s*<<-?\s*'?([A-Za-z_][A-Za-z0-9_]*)'?")
SKIP_DIRS = frozenset(("__pycache__", ".git", "tests"))

#: The GENERATED sidecar class - a pre-image the editing tools leave beside the
#: file they touch.  NOT source: the battery's own tree fingerprint excludes it
#: (`-not -name '*.pre-*' -not -name '*.bak'`, tools/tests/run.sh) and the
#: state-dir law classifies it GENERATED-IGNORED.  A sidecar of a scanned module
#: is byte-identical to its source, so it carries the predicate's exact shape and
#: BOTH arms fire on a copy of the canonical module - a clean tree reds the
#: battery (measured 2026-10-05, #16).  The test is on the SUFFIX/INFIX, never a
#: bare substring of "bak": a real source file whose name merely contains those
#: letters (oc-bakery) is still scanned, so the exclusion cannot widen into a
#: blind spot.
SIDECAR_SUFFIXES = (".bak",)
SIDECAR_INFIXES = (".bak-", ".pre-")

def _is_generated_sidecar(name):
    return name.endswith(SIDECAR_SUFFIXES) or any(i in name for i in SIDECAR_INFIXES)

MAX_UNIT_BYTES = 400_000

#: Stand-in for a shell substitution (`"$T/x.json"`) inside a reconstructed blob.
#: BARE, never quoted: a substitution in this corpus always sits INSIDE an open
#: python string (`open("` + value + `")`), so the value is that string's
#: CONTENT. Emitting a quoted placeholder instead makes the literal quote and the
#: placeholder's quote collide into an unterminated `"""` — measured, that
#: produced six holes from a working extractor.
_SUBST = "__OC_SUBST__"


def read_text(path):
    try:
        if os.path.getsize(path) > MAX_UNIT_BYTES:
            return None
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


def _parse(code):
    """Parse ONE unit. Returns the tree, or None when it cannot parse.

    SyntaxWarnings are MUTED here, and that is deliberate: CPython emits the
    warning while TOKENIZING, i.e. BEFORE it raises the SyntaxError this
    function catches, so an unparsed unit would leak its warning onto stderr.
    Measured 2026-09-20: tools/lib/oc-embed.sh line 15 is a sed pattern holding
    a literal backslash-paren; scanning it printed
    `<unknown>:15: SyntaxWarning` while that file yields NO unit at all (it is
    not python, and it embeds no python). Whether a scanned file's text is
    well-formed python is a CLASSIFICATION question for this guard, never a
    finding - the syntax of a scanned file is not the guard's business.

    The second, independent reason to mute: a unit that fails to parse is
    SKIPPED, so its text is never scanned for copies. That skip is a real
    coverage gap, and `scan` surfaces it explicitly (see the NOTE lines and the
    ok-line's two figures) rather than letting a green report sit on it.
    """
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        try:
            return ast.parse(code)
        except (SyntaxError, ValueError, RecursionError):
            return None

def _unparsed_reason(code):
    """Why one unit failed to parse, for the coverage note. Never raises."""
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        try:
            ast.parse(code)
        except SyntaxError as exc:
            return "SyntaxError line %s: %s" % (exc.lineno, exc.msg)
        except (ValueError, RecursionError) as exc:
            return "%s: %s" % (type(exc).__name__, exc)
    return "unknown"


def is_python(path):
    """Is this whole FILE a python unit?

    Deliberately not "does the text mention python": a shell tool's embedded
    `python3 -c` line would answer yes and the file would then be parsed as
    python, fail, and its blob would never be reached.
    """
    if os.path.basename(path).endswith(".py"):
        return True
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            first = fh.readline().strip()
    except OSError:
        return False
    if first.startswith("#!"):
        return "python" in first
    if "python" in first:
        return True
    src = read_text(path)
    return bool(src) and _parse(src) is not None


def iter_source_files(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
        for name in sorted(filenames):
            path = os.path.join(dirpath, name)
            if os.path.islink(path) or not os.path.isfile(path):
                continue
            if _is_generated_sidecar(name):
                continue
            rel = os.path.relpath(path, root)
            if rel == CANONICAL_REL:
                continue
            yield path, rel


def _shell_word_python(line, after_quote):
    """Reconstruct the python a `python3 -c '<seg>'"<seg>"...` shell word carries.

    Returns ``(text, closed_here)`` — ``closed_here`` False means the word runs on
    to the NEXT line (the multi-line `python3 -c '` form), which the caller must
    handle by line scanning.

    The problem this solves: a single-line blob is written in MIXED shell quoting,
    because a `$var` cannot appear inside single quotes. Taking "everything after
    the opening quote to end-of-line" therefore yields shell text
    (`...open("'"$T/x.json"'"))`) that is not python, and scanning forward for a
    line beginning with `'` — the old rule — then swallowed the REST OF THE FILE
    (measured: 390 and 94 and 324 and 151 lines of shell for four blobs that are
    each ONE line long). So the quoted segments are concatenated here and a
    `"$var"` substitution becomes an empty python string, which is the closest
    well-formed python to what the shell would hand the interpreter. Only the
    SHELL WORD is consumed; the trailing `"$mock_reg" 2>/dev/null ...` is not.
    """
    parts = []
    buf = []
    i = after_quote
    n = len(line)
    in_literal = True          # inside a single-quoted segment
    while i < n:
        c = line[i]
        if in_literal:
            if c == "'":
                parts.append("".join(buf))
                buf = []
                in_literal = False
                i += 1
                continue
            buf.append(c)
            i += 1
            continue
        if c in " \t":         # whitespace ENDS the shell word
            break
        if c == "'":
            in_literal = True
            i += 1
            continue
        if c == '"':           # `"$var"` -> a substituted value, never python text
            j = i + 1
            while j < n and line[j] != '"':
                j += 1
            parts.append(_SUBST)
            i = j + 1
            continue
        if c == "$":           # `'code'$var'code'` — also one word, also a value
            j = i + 1
            depth = 0
            while j < n:
                ch = line[j]
                if ch == "(":
                    depth += 1
                elif ch == ")":
                    if depth == 0:
                        break
                    depth -= 1
                elif depth == 0 and ch in " \t'\"":
                    break
                j += 1
            parts.append(_SUBST)
            i = j
            continue
        # ANYTHING ELSE IS SHELL SYNTAX, not python: the word ended at the
        # closing quote and what follows is the command's own punctuation. The
        # corpus's ugliest line (`...open("'"$T/x"'"))["current_class"])\')`) ends
        # `\')"`, and continuing through it appended two stray placeholders and
        # produced `...)"current_class"])__OC_SUBST____OC_SUBST__` — invalid syntax
        # from an otherwise-correct reconstruction.
        break
    if buf:
        parts.append("".join(buf))
    return "".join(parts), not in_literal


def extract_blobs(src):
    """(start_line, code) for each python blob a shell tool embeds.

    Two fences, because the corpus writes both shapes: a SINGLE-LINE word
    (`python3 -c 'x' "$arg"`) closes on its own line, and the multi-line form
    (`python3 -c '` newline code newline `'`) closes on a later one. The line
    scan is used ONLY for the second, which is what the old rule assumed for
    both — and assuming it for a single-line blob swallowed every following
    shell line up to the next one starting with `'`.

    A COMMENT line never opens a blob. `# The python engine runs as 'python3
    -c'` matched the regex and produced a 2035-line "blob" of shell comments
    (oc-harvest-dispatch:37), which is a parsing hole that blamed the host file
    for an extractor artefact.
    """
    lines = src.splitlines()
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.lstrip().startswith("#"):
            i += 1
            continue
        m = RE_PY_C.search(line)
        if m:
            text, closed_here = _shell_word_python(line, m.end())
            if closed_here:
                out.append((i + 1, text))
                i += 1
                continue
            body = [text] if text else []
            j = i + 1
            while j < len(lines) and not lines[j].startswith("'"):
                body.append(lines[j])
                j += 1
            out.append((i + 1, "\n".join(body)))
            i = j + 1
            continue
        h = RE_PY_HEREDOC.search(line)
        if h:
            delim = h.group(1)
            body = []
            j = i + 1
            while j < len(lines) and lines[j].strip() != delim:
                body.append(lines[j])
                j += 1
            out.append((i + 2, "\n".join(body)))
            i = j + 1
            continue
        i += 1
    return out


def python_units(path, src):
    """The python units of one file: the whole file, OR its embedded blobs."""
    if src is None:
        return []
    if is_python(path):
        return [(1, src)]
    return extract_blobs(src)


def _is_step1_slice(node):
    """X[i + 1:] - the SUBSEQUENT-slice walk a closure verdict needs."""
    if not isinstance(node, ast.Subscript):
        return False
    sl = node.slice
    if not isinstance(sl, ast.Slice) or sl.lower is None:
        return False
    lo = sl.lower
    return (isinstance(lo, ast.BinOp) and isinstance(lo.op, ast.Add)
            and isinstance(lo.right, ast.Constant) and lo.right.value == 1)


def _reads_kind(node):
    """The kind dimension: d['kind'], d.get('kind'), or a CLOSING/landed name."""
    for n in ast.walk(node):
        if isinstance(n, ast.Subscript):
            k = n.slice
            if isinstance(k, ast.Constant) and k.value == "kind":
                return True
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute):
            if n.func.attr == "get" and n.args:
                a0 = n.args[0]
                if isinstance(a0, ast.Constant) and a0.value == "kind":
                    return True
        if isinstance(n, ast.Compare):
            for c in [n.left] + list(n.comparators):
                if isinstance(c, ast.Name) and KINDSIDE_RE.search(c.id):
                    return True
                if isinstance(c, ast.Attribute) and KINDSIDE_RE.search(c.attr):
                    return True
    return False


def _yields_verdict(node):
    for n in ast.walk(node):
        if isinstance(n, ast.Return) and isinstance(n.value, ast.Constant):
            if isinstance(n.value.value, bool):
                return True
        if isinstance(n, ast.Assign):
            for t in n.targets:
                if isinstance(t, ast.Name) and VERDICT_NAME_RE.match(t.id):
                    return True
        if isinstance(n, ast.AnnAssign) and isinstance(n.target, ast.Name):
            if VERDICT_NAME_RE.match(n.target.id):
                return True
    return False


def arm_a_hits(tree):
    """Loop over a subsequent slice + kind dimension + verdict == a copy."""
    hits = []
    for fn in ast.walk(tree):
        if not isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        for n in ast.walk(fn):
            if isinstance(n, (ast.For, ast.comprehension)):
                it = n.iter
            else:
                continue
            if not _is_step1_slice(it):
                continue
            if _reads_kind(n) and _yields_verdict(n):
                hits.append((fn.name, getattr(n, "lineno", 0) or 0))
    return hits


def _literal_value_set(node):
    if isinstance(node, (ast.Tuple, ast.List, ast.Set)):
        vals = []
        for e in node.elts:
            if isinstance(e, ast.Constant) and isinstance(e.value, str):
                vals.append(e.value)
            else:
                return None
        return frozenset(vals)
    return None


def arm_b_hits(tree):
    """A MODULE-LEVEL ALL-CAPS literal reconstructing a canonical value set."""
    hits = []
    for n in getattr(tree, "body", []):
        if isinstance(n, ast.Assign):
            targets, val = n.targets, n.value
        elif isinstance(n, ast.AnnAssign):
            targets, val = [n.target], n.value
        else:
            continue
        if val is None:
            continue
        vals = _literal_value_set(val)
        if vals is None or vals not in CANONICAL_SETS:
            continue
        for t in targets:
            if isinstance(t, ast.Name) and CONST_NAME_RE.match(t.id):
                hits.append((t.id, n.lineno, tuple(sorted(vals))))
    return hits



def unit_count(units):
    """How many units were ACTUALLY SCANNED (parsed) across the tree.

    Distinct from the DECLARED count: a unit this tool cannot parse is never
    inspected for copies, so `scan` also returns the skipped list. Keep the two
    figures apart - `units` is a map, and reporting len(units) would count
    FILES while the ok line counts UNITS.
    """
    return sum(len(p) for _, p in units.values())

def scan(root):
    files = list(iter_source_files(root))

    units = {}          # rel -> (whole_file_text, [(blob_start, tree), ...])
    skipped = []        # (rel, blob_start, reason) - enumerated but NOT parsed
    for path, rel in files:
        src = read_text(path)
        if src is None:
            continue
        parsed = []
        for start, code in python_units(path, src):
            tree = _parse(code)
            if tree is not None:
                parsed.append((start, tree))
            else:
                # An enumerated unit that does not parse is never scanned, so
                # its text is a HOLE in this tool's coverage. Record it: a
                # count of survivors hides exactly this (measured: 18 declared
                # units, 12 scanned, 6 dropped with nothing said).
                skipped.append((rel, start, _unparsed_reason(code)))
        units[rel] = (src, parsed)

    findings = []
    for rel in sorted(units):
        _, parsed = units[rel]
        for start, tree in parsed:
            for name, ln in arm_a_hits(tree):
                line = start + ln - 1 if start > 1 else ln
                desc = ("ARM A  closure-verdict shape: def %s() walks a later-event "
                        "slice and yields a closed/open verdict" % name)
                findings.append((rel, line, desc))
            for name, ln, vals in arm_b_hits(tree):
                line = start + ln - 1 if start > 1 else ln
                desc = ("ARM B  local predicate constant %s = %s" % (name, vals))
                findings.append((rel, line, desc))

    return findings, units, skipped

