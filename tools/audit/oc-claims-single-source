ROSTER_COPY = '''#!/usr/bin/env python3
import re
ISSUE_RE = re.compile(r"#(\\d+)")
UUID_RE = re.compile(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})")
CLOSERS = {"close", "confirm", "reject", "done", "unclaim"}

def claims_index(events):
    opens, issues = [], {}
    for i, ev in enumerate(events):
        if ev.get("kind") != "claim":
            continue
        m = UUID_RE.search(ev.get("by") or "")
        if not m:
            continue
        uuid = m.group(0)
        mi = ISSUE_RE.search(ev.get("what") or "")
        num = mi.group(1) if mi else ""
        issues.setdefault(uuid, set()).add(num)
        closed = False
        for later in events[i + 1:]:
            if uuid not in (later.get("by") or ""):
                continue
            if later.get("kind") not in CLOSERS:
                continue
            if ("#" + num) in (later.get("what") or ""):
                closed = True
                break
        if not closed:
            opens.append({"uuid": uuid, "issue": num})
    return opens, issues
'''

HD_COPY = '''#!/usr/bin/env python3
import re
_ACTOR_ROLE_RE = re.compile(r"^\\s*(?:editor|triage|hq|toolsmith)\\s+", re.I)
_CLOSING_KINDS = ('close', 'confirm', 'reject', 'done', 'unclaim')

def actor_match(a, b):
    return a == b

def claim_is_closed(events, idx, claim_actor, iss):
    for later_ev in events[idx+1:]:
        if later_ev.get('kind') not in _CLOSING_KINDS:
