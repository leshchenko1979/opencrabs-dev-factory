#!/usr/bin/env bash
# =============================================================================
# oc-lint-laws — M2-18: law-vs-tool CORPUS LINT (HQ mechanical audit, n=3845).
#
# LAW TEXT NAMES TOOLS AND FLAGS. Nothing checked that those verbs and flags
# exist. Two phantom invocations reached editors and cost real time —
# `oc-ship --resume` and `oc-ledger stamp proposal` — both found by an
# editor RUNNING the dead verb, never by a check. This tool is the check.
#
# PREDICATE — deliberately conservative: a linter that cries wolf gets ignored,
# and a false accusation against a correct law is worse than a miss.
#
# AN INVOCATION IS SCOPED TO ITS MARKDOWN UNIT, not to the line. Outside a code
# fence only BACKTICK SPANS are scanned; inside a fence the whole line is one
# unit. That is what makes this usable — the first two drafts scoped to the
# line and reported 40 then 13 findings on a corpus that was clean, every one of
# them noise from a flag that belonged to a DIFFERENT command further along the
# same line (`cargo test --locked` after `oc-gate`; `--gated-run` after
# `oc-deploy`). A span is what a reader copies, so a span is what is checked.
#
#   PHANTOM-FLAG : a span invokes `oc-tool --flag`, and the tool's OWN SOURCE
#                  contains ZERO occurrences of `--flag`. It cannot accept it.
#                  (Catches the `--resume` class exactly.)
#   PHANTOM-VERB : `oc-tool verb --flag`, the tool dispatches subcommands, and
#                  its source contains ZERO occurrences of `verb`.
#   UNKNOWN-TOOL : a span invokes `oc-tool` and no such file exists.
#
# CITATIONS. A law that says "there is no `--resume` flag" is naming a phantom
# on purpose, and failing it would make the lint unusable — the incident table
# that RECORDS the family would itself fail forever. So when the line carries a
# strong absence marker (never existed · does not exist · no such · 0/zero
# occurrences · phantom · unavailable · is rejected · rejected with rc ·
# silently ignored) the hit is downgraded to a CITATION: counted, printable with
# --show-citations, and EXIT-NEUTRAL. This is a heuristic and its false-negative
# window is real — a prescription on a line that also says "phantom" is
# suppressed. The markers are deliberately narrow; `Do not forget to run X` does
# NOT suppress (asserted in the selftest).
#
# KNOWN means the tool's source mentions the flag anywhere (default) or — with
# --strict — declares it as a case arm (`^\s+--flag)`). Default under-reports;
# --strict catches a flag documented in prose but never wired.
#
# NOT checked: shell syntax, argument ORDER, value shapes, or whether a flag
# means what the law says. This verifies EXISTENCE, nothing more.
#
# Env: OC_LINT_LAWS_TOOLS_DIR  (TEST HOOK — point the tool scan at a fixture
#     tools/ dir. It exists so the selftest never depends on the live corpus.)
#      OC_LINT_LAWS_GAPMAX      (default 3) how far a flag may sit from the tool
#     token that owns it before attribution is REFUSED. Raising it re-attributes
#     wider gaps (the flag is then judged against that tool's source); lowering
#     it moves more flags into the UNATTRIBUTABLE class (#643).
#
# Exit: 0 clean / 1 findings / 2 usage / 3 tools dir or named corpus file missing
# =============================================================================
set -u
set -o pipefail

# Unified tools log (one JSONL line on exit) — mandatory for every live tool.
# The selftest's temp dir is cleaned from the SAME trap: a `trap ... EXIT` set
# inside a function REPLACES a top-level one, so a second trap would silently
# displace the logger for the whole selftest run.
# --- oc-root bootstrap: resolve the tools dir at ANY depth (tools/lib/oc-root.sh)
_oc_r="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || _oc_r="."; _oc_d="$_oc_r"; while [ "$_oc_r" != "/" ] && [ "$_oc_r" != "." ] && ! { [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; } && [ "$(basename "$_oc_r")" != "tools" ]; do _oc_r="$(dirname "$_oc_r")"; done
if [ "$(basename "$_oc_r")" = "tools" ]; then _oc_d="$_oc_r"; fi
if [ -f "$_oc_r/lib/oc-root.sh" ] && [ ! -L "$_oc_r/lib" ]; then . "$_oc_r/lib/oc-root.sh"; else OC_TOOLS_DIR="$(cd "$_oc_d" && pwd)"; fi
_OC_LIB="$OC_TOOLS_DIR/lib/oc-log.sh"
if [ -f "$_OC_LIB" ]; then source "$_OC_LIB"; oc_log_init "oc-lint-laws" "$@"; else oc_log_finish() { :; }; fi
trap 'oc_log_finish $?; [ -n "${ST_TMPDIR:-}" ] && rm -rf "$ST_TMPDIR"' EXIT

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
TOOLS_DIR="${OC_LINT_LAWS_TOOLS_DIR:-$OC_TOOLS_DIR}"
SKILL_DIR="$(dirname "$TOOLS_DIR")"

# HOST TOOLS (#88): tools that legitimately live on the HOST, not in tools/.
# The linter's job is to catch a law citing a tool that does not exist. It must
# not accuse a correct law -- a false finding against real law is the one
# failure this tool cannot afford, because the remedy (edit the law) destroys
# correct text. So a small, EXPLICIT declaration admits a named host tool and
# nothing else: a blanket "ignore unknown oc-* spans" would disable the very
# check that caught `oc-ship --resume` and `oc-ledger stamp proposal`.
# Membership is a claim about the box, not an exemption from existence: a
# declared tool that is NOT on PATH is still reported, with a message that says
# which half is missing.
#   OC_LINT_LAWS_HOST_TOOLS  (TEST HOOK) replaces the declaration wholesale.
HOST_TOOLS="${OC_LINT_LAWS_HOST_TOOLS-oc-fmt}"

# is_host_declared <name> -- is <name> in the HOST_TOOLS declaration?
is_host_declared() {
  case " $HOST_TOOLS " in *" $1 "*) return 0 ;; esac
  return 1
}

# host_tool_path <name> -- resolve a DECLARED host tool via PATH. Undeclared
# names never reach PATH: the declaration is the only door in.
host_tool_path() {
  is_host_declared "$1" || return 1
  command -v "$1" 2>/dev/null || return 1
}

# The LAW corpus: the skill's normative markdown. Two exclusions, both
# deliberate — CHANGELOG.md and war-stories.md quote historical invocations that
# were correct when written and may legitimately name a retired flag; failing on
# history makes the lint unusable. Law files are the live contract.
# The normative law files. CHANGELOG.md and war-stories.md are deliberately
# EXCLUDED (RC-CONTRACT): they quote historical invocations that were correct
# when written, so linting them reports findings against the record itself.
# editor-upstream-pr.md was folded into editor.md and no longer exists -- naming
# it made EVERY run exit rc 3 before a single file was checked, which is worse
# than a missed file: a corpus that cannot load reports nothing at all.
DEFAULT_CORPUS="SKILL.md README.md fleet-directives.md editor.md editor-ship.md editor-smoke.md harvest.md hq.md triage.md toolsmith.md review-lenses.md upstream-merge-runbook.md s2-swap-journal-spec.md session-notify.md environment.md reference-glossary.md reference-tools.md tools/docs/RC-CONTRACT.md"

usage() { awk 'NR>2 && /^#/ { sub(/^# ?/, ""); print; next } NR>2 { exit }' "$SELF"; exit 0; }

FILES=""; JSON=0; STRICT=0; SHOWCIT=0; MODE=scan
while [ $# -gt 0 ]; do
  case "$1" in
    --file)   FILES="${FILES} ${2:?--file needs a path}"; shift 2 ;;
    --strict) STRICT=1; shift ;;
    --json)   JSON=1; shift ;;
    --show-citations) SHOWCIT=1; shift ;;
    --help|-h) usage ;;
    --selftest) MODE=selftest; shift ;;
    *) printf 'oc-lint-laws: unknown arg: %s (see --help)\n' "$1" >&2; exit 2 ;;
  esac
done

FINDINGS=0; CITATIONS=0
OUT=""; OUTJ=""; OUTC=""

add() { # $1=file $2=line $3=class $4=tool $5=token $6=detail
  FINDINGS=$((FINDINGS + 1))
  OUT="${OUT}${1}:${2}: ${3} ${4} ${5} — ${6}
"
  OUTJ="${OUTJ}$(printf '{"file":"%s","line":%s,"class":"%s","tool":"%s","token":"%s"}' "$1" "$2" "$3" "$4" "$5")
"
}

add_cit() { # $1=file $2=line $3=tool $4=flag
  CITATIONS=$((CITATIONS + 1))
  OUTC="${OUTC}${1}:${2}: CITATION ${3} ${4} — the law names this flag as absent (it has zero occurrences in the tool)
"
}

# A law line that DOCUMENTS an absence is a citation, not a prescription.
citation_line() { # $1=file $2=line [$3=cited token]
  _cl="$(sed -n "$2p" "$1" 2>/dev/null)"
  # Word-level markers: a line that says a flag "does not exist" is citing it.
  grep -qE 'never existed|does not exist|no such|0 occurrences|zero occurrences|unavailable|is rejected|rejected with rc|silently ignored' <<< "$_cl" && return 0
  # `phantom` is PROXIMITY-SCOPED (c24 J-1). Line-level matching let ANY line
  # containing the word suppress its own findings, and the live corpus carries
  # lines that discuss phantom CLAIMS, or the lint's own phantom-flag verdicts,
  # while holding a perfectly good flag span -- measured: 4 live law lines were
  # suppressed by the bare word alone. A citation names THIS token as the
  # phantom ("`oc-ship --resume` phantom"), so the word must sit within 20
  # chars either side of the cited token. Narrowing it to the uppercase verdict
  # forms instead was tried and produced a FALSE POSITIVE on fleet-directives.md
  # :440, a correct law line -- a false accusation against a correct law is the
  # one failure this tool must not make, which is why proximity (not a stricter
  # spelling) is the fix.
  [ -n "${3:-}" ] || return 1
  _win="$(printf '%s' "$_cl" | awk -v t="$3" '{
      i = index($0, t); if (i == 0) { exit }
      s = i - 20; if (s < 1) s = 1
      print substr($0, s, 20 + length(t) + 20)
  }')"
  case "$_win" in *phantom*|*PHANTOM*|*Phantom*) return 0 ;; esac
  return 1
}

flag_known() { # $1=tool src  $2=flag
  # STRICT: the flag must be ACCEPTED by the tool, in ANY of the shapes real
  # CLIs use to accept one. The original single arm-regex (`^\s*--flag\)`)
  # demanded the flag BE the whole case arm, and measured NINE false positives
  # on the live corpus (#685) -- a permanently-red linter is one every lane
  # learns to ignore, and a real phantom then hides inside the noise. One flag
  # legitimately arrived that way (RC-CONTRACT.md:43 `--uuid`), and it was
  # invisible among the eight wrong ones.
  #   (1) bare case arm         --role)
  #   (2) alternation arm       --role|--role=*)                  [oc-roster:73]
  #   (3) inline cmp / argparse [ "$1" = "--help" ] / add_argument("--auto")
  # Each leg has a NEGATIVE control in the selftest, so this cannot degrade to
  # "accept everything".
  if [ "$STRICT" = 1 ]; then
    grep -qE "^[[:space:]]*$2\)" "$1" 2>/dev/null && return 0
    grep -qE "^[[:space:]]*[^#]*$2[|=]" "$1" 2>/dev/null && return 0
    grep -qE "(\(|,|=)[[:space:]]*[\"']$2[\"']" "$1" 2>/dev/null && return 0
    return 1
  fi
  grep -qF -- "$2" "$1" 2>/dev/null
}

dispatches() { grep -qE '^[[:space:]]*[a-z][a-z0-9-]*\)' "$1" 2>/dev/null; }

# ---------------------------------------------------------------------------
# SELFTEST — fixture-based. Never touches the live corpus, never writes the
# live home. The tool is re-invoked as a SUBPROCESS with --file (no recursion
# into --selftest), against a fixture tools/ dir via the OC_LINT_LAWS_TOOLS_DIR
# test hook.
# ---------------------------------------------------------------------------
_selftest_impl() {
  local T; T="$(mktemp -d "${TMPDIR:-/tmp}/oc-lint-laws-st.XXXXXX")" || { echo "selftest: mktemp failed"; return 3; }
  # Cleanup runs from the GLOBAL exit trap (see the top of this file), not from
  # a trap set here: a function-level EXIT trap would replace the logger's. The
  # var must be global-ish for the trap to see it, and `${ST_TMPDIR:-}` guards
  # the case where the trap fires before this assignment (set -u).
  ST_TMPDIR="$T"
  local pass=0 fail=0
  ok()  { pass=$((pass + 1)); printf 'ok   - %s\n' "$1"; }
  bad() { fail=$((fail + 1)); printf 'FAIL - %s\n' "$1"; }

  # run <fixture> [extra args] -> sets RC and OUTP
  RC=0; OUTP=""; ERR=""
  run() { # $1=fixture  rest=extra args — stdout and stderr captured SEPARATELY:
    # the split matters, because a CLEAN run writes its "clean" line to STDERR,
    # and merging the streams made the empty-stdout assertion fail on a clean run.
    local fx="$1"; shift
    OUTP="$(OC_LINT_LAWS_TOOLS_DIR="$T/tools" bash "$SELF" --file "$fx" "$@" 2>"$T/err")"; RC=$?
    ERR="$(cat "$T/err")"
  }
  # chk <name> <want-rc> <want-needle> [<forbid-needle>]
  chk() {
    if [ "$RC" != "$2" ]; then bad "$1 (rc=$RC want=$2)"; return; fi
    # #693: here-string, not a pipeline. With `set -o pipefail` and a payload
    # past the 64 KiB pipe buffer, grep -q exits on match and printf takes
    # SIGPIPE (141), which the `!` inverts into a reported MISS. Measured
    # 26/40 false-miss at 64 KiB, 40/40 at 128 KiB; this form 0/40 at 200 KiB.
    if [ -n "$3" ] && ! grep -qF -- "$3" <<<"$OUTP
$ERR"; then bad "$1 (missing: $3)"; return; fi
    if [ -n "${4:-}" ] && grep -qF -- "$4" <<<"$OUTP
$ERR"; then bad "$1 (unexpected: $4)"; return; fi
    ok "$1"
  }

  mkdir -p "$T/tools"
  cat > "$T/tools/oc-good" <<'EOT'
usage: oc-good [--alpha] [--beta]
  stamp   stamp a row
case "$1" in
  stamp) shift ;;
  --alpha) shift ;;
  --beta) shift ;;
esac
EOT
  cat > "$T/tools/oc-noverb" <<'EOT'
usage: oc-noverb [--alpha]
case "$1" in
  --alpha) shift ;;
esac
EOT

  # #685: the three flag shapes the original arm-regex could not see. One mock
  # per shape, so the leg that covers it fails for exactly one reason.
  cat > "$T/tools/oc-alt" <<'EOT'
usage: oc-alt [--role <r>]
case "$1" in
  --role|--role=*) shift ;;
esac
EOT
  cat > "$T/tools/oc-inline" <<'EOT'
usage: oc-inline [--help]
if [ "${1:-}" = "--help" ]; then exit 0; fi
EOT
  cat > "$T/tools/oc-argparse" <<'EOT'
usage: oc-argparse [--auto]
    p.add_argument("--auto", action="store_true")
EOT

  printf 'Recover with `oc-good --resume <id>` before re-running the chain.\n'            > "$T/planted-flag.md"
  printf 'Then `oc-good propose --alpha` writes the ledger row.\n'                        > "$T/planted-verb.md"
  printf 'Run `oc-nope --alpha` to do the thing.\n'                                       > "$T/unknown-tool.md"
  printf 'Run `oc-good stamp --alpha`, then `oc-good --beta`.\n'                          > "$T/clean.md"
  printf '`oc-good` executes the stamp and never looks back.\n'                           > "$T/prose.md"
  printf 'There is no `oc-good --resume` flag - it never existed (0 occurrences).\n'      > "$T/citation.md"
  printf 'Dispatches `oc-good` (`cargo test --locked --all-features`).\n'                 > "$T/cargo-span.md"
  printf '`oc-good`'"'"'s `--gamma` flag is rejected with rc 2.\n'                        > "$T/possessive.md"
  printf 'Do not forget to run `oc-good --bogus` before you start.\n'                     > "$T/weak-negation.md"
  # #685: one fixture per newly-covered flag shape, plus its negative control.
  printf 'Resolve the lane with `oc-alt --role editor`.\n'                              > "$T/alt-arm.md"
  printf 'Ask `oc-inline --help` for the usage line.\n'                                 > "$T/inline-cmp.md"
  printf 'Run `oc-argparse --auto` overnight.\n'                                         > "$T/argparse-flag.md"
  printf 'Then `oc-alt --no-such-flag` would be wrong.\n'                               > "$T/neg-alt.md"
  printf 'Then `oc-inline --no-such-flag` would be wrong.\n'                            > "$T/neg-inline.md"
  printf 'Then `oc-argparse --no-such-flag` would be wrong.\n'                          > "$T/neg-argparse.md"
  # c24 J-1: the `phantom` marker is PROXIMITY-SCOPED. Line-level matching let
  # any line containing the word suppress its own findings -- measured on the
  # live corpus, 4 law lines were suppressed by the bare word alone, and
  # narrowing it to the uppercase verdict spellings produced a FALSE POSITIVE on
  # fleet-directives.md:440 (a correct citation). These two legs pin both
  # directions of the real discriminator: DISTANCE, not spelling.
  printf 'The phantom claim author was excluded; run `oc-good --resume` now.\n'          > "$T/prox-real.md"
  printf 'Same family as the `oc-good --resume` phantom: law names only what exists.\n'  > "$T/prox-citation.md"
  cat > "$T/fence.md" <<'EOT'
Recovery:

```bash
oc-good --resume <id>
```
EOT

  # --- the checks that must FAIL loudly when the law is wrong ---------------
  run "$T/planted-flag.md";  chk "planted phantom flag -> rc 1"        1 "PHANTOM-FLAG oc-good --resume"
  run "$T/planted-verb.md";  chk "planted phantom verb -> rc 1"        1 "PHANTOM-VERB oc-good propose"
  run "$T/unknown-tool.md";  chk "unknown tool -> rc 1"                1 "UNKNOWN-TOOL oc-nope"
  run "$T/fence.md";         chk "invocation inside a fence -> rc 1"   1 "PHANTOM-FLAG oc-good --resume"
  run "$T/weak-negation.md"; chk "weak negation does NOT suppress"     1 "PHANTOM-FLAG oc-good --bogus"
  run "$T/prox-real.md";     chk "a DISTANT 'phantom' word does NOT suppress"  1 "PHANTOM-FLAG oc-good --resume"
  run "$T/prox-citation.md"; chk "an ADJACENT 'phantom' still suppresses"      0 "" "PHANTOM-FLAG"

  # #685 NEGATIVE CONTROLS: the widened predicate must NOT accept a flag the
  # tool does not implement. One per newly-covered shape; if the fix ever
  # degrades to "accept everything", these three redden and it does not ship.
  # The non-strict form of each control, plus its --strict twin: the strict
  # branch is the one with the live false positives, so the discriminator has
  # to hold THERE, not only on the substring branch.
  run "$T/neg-alt.md";       chk "NEG: absent flag on an alt-arm tool"  1 "PHANTOM-FLAG oc-alt --no-such-flag"
  run "$T/neg-inline.md";    chk "NEG: absent flag on an inline tool"   1 "PHANTOM-FLAG oc-inline --no-such-flag"
  run "$T/neg-argparse.md";  chk "NEG: absent flag on an argparse tool" 1 "PHANTOM-FLAG oc-argparse --no-such-flag"
  run "$T/neg-alt.md" --strict;      chk "NEG(strict): absent flag on an alt-arm tool"  1 "PHANTOM-FLAG oc-alt --no-such-flag"
  run "$T/neg-inline.md" --strict;   chk "NEG(strict): absent flag on an inline tool"   1 "PHANTOM-FLAG oc-inline --no-such-flag"
  run "$T/neg-argparse.md" --strict; chk "NEG(strict): absent flag on an argparse tool" 1 "PHANTOM-FLAG oc-argparse --no-such-flag"

  # --- the checks that must stay SILENT (the false-positive wall) ----------
  run "$T/clean.md";       chk "clean corpus -> rc 0"                 0 "" ""
  run "$T/prose.md";       chk "prose mention -> rc 0"                0 "" "PHANTOM"
  run "$T/citation.md";    chk "documented-absent flag -> rc 0"       0 "" "PHANTOM-FLAG"
  run "$T/cargo-span.md";  chk "foreign tool flag in another span"    0 "" "PHANTOM"
  run "$T/possessive.md";  chk "possessive is not a tool name"        0 "" "UNKNOWN-TOOL"

  # #685: a flag accepted through an ALTERNATION arm, an INLINE comparison, or
  # an ARGPARSE declaration is a KNOWN flag. Each is paired with a negative
  # control below -- without them this fix degrades to "accept everything".
  # #685: --strict is MANDATORY on these three. Without it flag_known takes the
  # substring branch, which finds the flag inside `--role|--role=*)` by plain
  # text and passes under BOTH predicates -- measured: 24/0 with the old
  # single-arm predicate installed, i.e. the legs asserted nothing.
  run "$T/alt-arm.md" --strict;       chk "alternation arm is a KNOWN flag (strict)"      0 "" "PHANTOM-FLAG"
  run "$T/inline-cmp.md" --strict;    chk "inline [ x = --flag ] is KNOWN (strict)"       0 "" "PHANTOM-FLAG"
  run "$T/argparse-flag.md" --strict; chk "argparse add_argument is KNOWN (strict)"       0 "" "PHANTOM-FLAG"

  # citations are counted and printable, just not failing
  run "$T/citation.md" --show-citations
  if grep -qF "CITATION oc-good --resume" <<< "$OUTP" ; then ok "citation is reported with --show-citations"; else bad "citation not reported with --show-citations"; fi
  run "$T/clean.md" --json
  if [ "$RC" = 0 ] && [ -z "$OUTP" ]; then ok "--json on a clean corpus is empty, rc 0"; else bad "--json clean (rc=$RC stdout=$OUTP)"; fi

  # #643: a flag past GAPMAX used to be SILENTLY dropped, so a wide-gap phantom
  # read exactly like a clean corpus. Two legs pin the new behaviour. NOTE the flag
  # must sit INSIDE the code span: the scanner only lints spans/fences, so a flag in
  # plain prose is never a candidate at all — the previous guard here put it in
  # prose and therefore asserted rc 0 VACUOUSLY (a disarmed control).
  #  (a) NO tool owns the flag -> a real finding (class UNATTRIBUTABLE), and it is
  #      never misattributed to the tool named five tokens back;
  #  (b) SOME tool owns it -> a legitimate wide-gap citation, dropped (rc 0), which
  #      is what GAPMAX is for (live shape: `--create`, owned by oc-audit-ship).
  printf 'The law cites `oc-good stays the fallback only when --gamma` in prose.\n' > "$T/wide-gap.md"
  run "$T/wide-gap.md"; chk "wide-gap flag NO tool owns -> UNATTRIBUTABLE, rc 1" 1 "UNATTRIBUTABLE" "oc-good --gamma"
  printf 'The law cites `oc-good stays the fallback only when --beta` in prose.\n' > "$T/wide-gap-owned.md"
  run "$T/wide-gap-owned.md"; chk "wide-gap flag SOME tool owns -> dropped, rc 0" 0 "" "UNATTRIBUTABLE"

  # --- #88: HOST TOOLS ------------------------------------------------------
  # A tool that legitimately lives on the host (oc-fmt) is backed by no file in
  # tools/, so the walk reports it UNKNOWN-TOOL and the law gets accused of
  # citing a phantom. Three arms, and the CONTROL is the load-bearing one: an
  # allowlist with no arm proving an UNDECLARED name still fails is
  # indistinguishable from a resolver that accepts everything, which is the
  # blanket-ignore this fix must not become.
  mkdir -p "$T/hostbin"
  cat > "$T/hostbin/oc-hostonly" <<'EOT'
#!/bin/sh
# a host tool that is NOT in tools/ -- supports --check
case "$1" in --check) exit 0 ;; esac
exit 0
EOT
  chmod +x "$T/hostbin/oc-hostonly"
  printf 'Run `oc-hostonly --check` before committing.\n' > "$T/host-tool.md"
  OUTP="$(OC_LINT_LAWS_TOOLS_DIR="$T/tools" OC_LINT_LAWS_HOST_TOOLS="oc-hostonly" \
    PATH="$T/hostbin:$PATH" bash "$SELF" --file "$T/host-tool.md" 2>"$T/err")"; RC=$?
  ERR="$(cat "$T/err")"
  chk "declared host tool resolves clean (no UNKNOWN-TOOL)" 0 "" "UNKNOWN-TOOL"
  OUTP="$(OC_LINT_LAWS_TOOLS_DIR="$T/tools" OC_LINT_LAWS_HOST_TOOLS="" \
    PATH="$T/hostbin:$PATH" bash "$SELF" --file "$T/host-tool.md" 2>"$T/err")"; RC=$?
  ERR="$(cat "$T/err")"
  chk "CONTROL: the SAME name UNDECLARED is still UNKNOWN-TOOL" 1 "UNKNOWN-TOOL oc-hostonly"
  OUTP="$(OC_LINT_LAWS_TOOLS_DIR="$T/tools" OC_LINT_LAWS_HOST_TOOLS="oc-hostonly" \
    PATH="/usr/bin:/bin" bash "$SELF" --file "$T/host-tool.md" 2>"$T/err")"; RC=$?
  ERR="$(cat "$T/err")"
  chk "declared but OFF PATH -> UNKNOWN-TOOL naming the missing half" 1 "declared in HOST_TOOLS but NOT on PATH"

  # --- usage / arg contract ------------------------------------------------
  run "$T/clean.md" --bogus-arg; chk "unknown arg -> rc 2" 2 "unknown arg"
  OUTP="$(OC_LINT_LAWS_TOOLS_DIR="$T/tools" bash "$SELF" --file "$T/nope.md" 2>&1)"; RC=$?
  chk "missing corpus file -> rc 3 (never a silent empty verdict)" 3 ""

  # --- F-M2: the LIVE corpus, not just the fixture -------------------------
  # Every run above points OC_LINT_LAWS_TOOLS_DIR at "$T/tools", so SKILL_DIR
  # becomes the FIXTURE's parent and DEFAULT_CORPUS is never read at all. That
  # is exactly how #575 stayed green: the corpus named the renamed
  # editor-upstream-pr.md, every REAL run died rc 3 before checking a single
  # file, and this selftest reported clean throughout. A fixture-only corpus
  # check cannot see the corpus that ships.
  #
  # This leg reads DEFAULT_CORPUS out of the tool's OWN source and asserts each
  # member is readable in the live skill dir. It is deliberately a STATIC read
  # of the declared list rather than a re-declaration here: a second copy would
  # drift from the one the linter uses, which is the defect it guards against.
  # The pattern is anchored on the assignment so a mention inside a comment
  # cannot satisfy it (and CANNOT_FIRE is asserted, so a broken extraction fails
  # loudly instead of passing over an empty list).
  _corpus="$(sed -n 's/^DEFAULT_CORPUS="\(.*\)"$/\1/p' "$SELF" | head -n1)"
  if [ -z "$_corpus" ]; then
    bad "live corpus: could not extract DEFAULT_CORPUS from the tool source"
  else
    _live_skill="$(dirname "$OC_TOOLS_DIR")"
    _missing=""
    for _f in $_corpus; do
      [ -r "$_live_skill/$_f" ] || _missing="$_missing $_f"
    done
    if [ -z "$_missing" ]; then
      ok "live corpus: all $(printf '%s' "$_corpus" | wc -w | tr -d ' ') declared law files exist"
    else
      bad "live corpus: declared but MISSING on the live tree:$_missing"
    fi
  fi

  # --- F-M2b: PATH-FORM citations must resolve too --------------------------
  # The candidate extractor above attributes flags to `oc-<name>` TOKENS, so a
  # citation written as a PATH (`./tools/ship/oc-swap`, `tools/lib/oc-log.sh`)
  # is never checked for existence — the tool reads as real because its NAME
  # parses, whether or not the file it names is there. #575 proved the class: a
  # corpus naming a renamed file reported clean while every REAL run died rc 3.
  # This leg resolves every path-form citation against the live tree. It
  # tolerates an ELIDED extension (`tools/lib/oc-log` for `oc-log.sh`) because
  # law prose cites a module by name, and it is a STATIC read of the corpus for
  # the same reason the leg above is: a re-declared list drifts.
  _pf_unresolved() { # $1=skill dir  $2=citation ; rc 0 = UNRESOLVED
    _q="${2#./}"
    [ -e "$1/$_q" ] && return 1
    for _e in "$1/$_q".* "$1/$_q"/*; do [ -e "$_e" ] && return 1; done
    return 0
  }
  _pf_live="$(dirname "$OC_TOOLS_DIR")"
  _pf_n=0; _pf_bad=""
  for _f in $_corpus; do
    [ -r "$_pf_live/$_f" ] || continue
    while IFS= read -r _c; do
      [ -n "$_c" ] || continue
      _pf_n=$((_pf_n+1))
      _pf_unresolved "$_pf_live" "$_c" && _pf_bad="$_pf_bad $_f:$_c"
    done <<PFEOF
$(grep -oE '(\./)?tools/[A-Za-z0-9_./-]*oc-[a-z0-9-]+' "$_pf_live/$_f" 2>/dev/null)
PFEOF
  done
  if [ "$_pf_n" = 0 ]; then
    bad "path-form: extraction found ZERO citations — the leg cannot see anything"
  elif [ -z "$_pf_bad" ]; then
    ok "path-form: all $_pf_n cited tool paths resolve on the live tree"
  else
    bad "path-form: UNRESOLVED:$_pf_bad"
  fi
  # NEGATIVE CONTROL — a fabricated path MUST be reported. Without this the leg
  # can degrade to "accept everything" and still read green, which is the exact
  # failure the positive leg exists to prevent.
  if _pf_unresolved "$_pf_live" "./tools/ship/oc-definitely-not-a-tool-$$"; then
    ok "path-form negative control: a fabricated citation IS detected"
  else
    bad "path-form negative control: resolver ACCEPTED a fabricated path"
  fi

  mkdir -p "$T/tools/state"
  printf '%s\n' '#!/bin/bash' 'jq -r ".events[]" "$HOME/x/workers-ledger.json"' > "$T/tools/state/oc-bad-reader"
  chmod +x "$T/tools/state/oc-bad-reader"
  run "$T/clean.md"
  chk "direct jq of workers-ledger.json is DIRECT-LEDGER-READ" 1 "DIRECT-LEDGER-READ"
  rm -f "$T/tools/state/oc-bad-reader"
  printf '%s\n' '#!/bin/bash' 'exec "$TOOLS_DIR/state/oc-ledger" --ledger "$HOME/x/workers-ledger.json" workers --json' > "$T/tools/state/oc-ok-reader"
  chmod +x "$T/tools/state/oc-ok-reader"
  run "$T/clean.md"
  chk "oc-ledger --ledger path is not a direct read" 0 "" "DIRECT-LEDGER-READ"
  rm -f "$T/tools/state/oc-ok-reader"

  printf 'selftest: %d passed, %d failed\n' "$pass" "$fail"
  [ "$fail" = 0 ] || return 1
  return 0
}

if [ "$MODE" = selftest ]; then
  _selftest_impl; exit $?
fi

# ---------------------------------------------------------------------------
# MAIN
# ---------------------------------------------------------------------------
[ -d "$TOOLS_DIR" ] || { printf 'oc-lint-laws: tools dir missing: %s\n' "$TOOLS_DIR" >&2; exit 3; }

ABS=""
for f in ${FILES:- $DEFAULT_CORPUS}; do
  case "$f" in
    /*) p="$f" ;;
    *)  p="$SKILL_DIR/$f" ;;
  esac
  # A probe against a path that does not exist returns silence, not a verdict —
  # so a missing corpus file is a HARD error, never an empty clean run.
  [ -r "$p" ] || { printf 'oc-lint-laws: corpus file missing or unreadable: %s\n' "$p" >&2; exit 3; }
  ABS="$ABS $p"
done

# GAPMAX bounds how far a flag may sit from the tool token that owns it. An
# invocation is `oc-tool [verb] [value] --flag`, so 3 covers verb+value; a wider
# gap means the line moved on to PROSE and the flag belongs to a DIFFERENT
# command. Live case: "standalone oc-wt stays the fallback only when
# --create is unavailable" — that --create belongs to oc-wt, named three
# lines earlier. Gap 5 correctly refuses to attribute.
CANDS="$(awk -v GAPMAX="${OC_LINT_LAWS_GAPMAX:-3}" '
  { line = $0
    if (line ~ /^[ \t]*(```|~~~)/) { fence = !fence; next }
    if (fence) { unit(line, FNR, FILENAME); next }
    n = split(line, parts, "`")
    for (i = 2; i <= n; i += 2) unit(parts[i], FNR, FILENAME)
    next }
  function unit(u, ln, fn,   m, i, tok, t, f) {
    gsub(/[",;:()\[\]`]/, " ", u)
    m = split(u, toks, /[ \t]+/)
    cur = ""; pv = ""; gap = 0; seenf = 0; lost = 0
    for (i = 1; i <= m; i++) {
      tok = toks[i]
      sub(/[.,*!?]+$/, "", tok)
      if (tok == "") continue
      if (tok ~ /^oc-[a-z0-9]/) { t = tok; sub(/[^a-z0-9-].*$/, "", t); cur = t; pv = ""; gap = 0; seenf = 0; lost = 0; continue }
      if (cur == "") {
        # #643: attribution was refused past GAPMAX (lost=1). Emit the flag with a
        # "-" owner so the shell can ask "does ANY tool carry this flag?". The old
        # code dropped it here, which is exactly the silent blind spot the issue
        # names: a wide-gap PHANTOM read identically to a clean corpus.
        if (lost && tok ~ /^--[a-z0-9]/) { f = tok; sub(/=.*$/, "", f); printf "%s\t%d\t-\t%s\t\n", fn, ln, f }
        continue
      }
      if (tok ~ /^--[a-z0-9]/) {
        f = tok; sub(/=.*$/, "", f)
        printf "%s\t%d\t%s\t%s\t%s\n", fn, ln, cur, f, (seenf ? "" : pv)
        seenf = 1; pv = ""; gap = 0; continue
      }
      if (tok ~ /^[a-z][a-z0-9-]*$/) { if (gap == 0) pv = tok; gap++; if (gap > GAPMAX) { cur = ""; lost = 1 }; continue }
      gap++; if (gap > GAPMAX) { cur = ""; lost = 1 }
    }
  }
' $ABS)"

SEEN_UNKNOWN=""
# #643: dedup set for wide-gap flags that NO tool owns (see the "-" branch below).
SEEN_UNATTR=""
OLDIFS="$IFS"; IFS='
'
# tool_path <name> — resolve a tool to its real path.
# tools/ is structured by KIND (owner order 2026-09-25): the oc-* executables live
# in functional subdirs (ship/ harvest/ issue/ state/ audit/ git/ notify/ smoke/).
# A flat-only test therefore reports EVERY documented tool as UNKNOWN-TOOL.
# Flat is still tried FIRST so the selftest fixture ($T/tools, deliberately flat)
# keeps working.
tool_path() {
  _tp="$TOOLS_DIR/$1"
  if [ -f "$_tp" ]; then printf '%s\n' "$_tp"; return 0; fi
  for _d in "$TOOLS_DIR"/*/; do
    [ -d "$_d" ] || continue
    case "${_d%/}" in */lib|*/tests|*/archive|*/docs|*/instruments) continue ;; esac
    if [ -f "$_d$1" ]; then printf '%s\n' "$_d$1"; return 0; fi
  done
  # Only now, and only for a DECLARED name: a host tool is real but lives
  # outside the versioned corpus, so it resolves by PATH rather than by file.
  _hp="$(host_tool_path "$1" || true)"
  [ -n "$_hp" ] && { printf '%s\n' "$_hp"; return 0; }
  return 1
}

# flag_owned_anywhere <flag> — does ANY tool under tools/ carry this flag? (#643)
# Used only for wide-gap candidates, to tell a LEGITIMATE citation from a phantom:
#   owned  -> the law cites a real flag of some other tool a few tokens back
#             (live case: `--create`, owned by oc-audit-ship, cited 5 tokens after
#             `oc-wt`) — drop it, exactly as GAPMAX intends.
#   unowned-> NO tool has the flag, so the law names a flag that does not exist.
#             That is a real defect and must be reported, never silently dropped.
# Backup sidecars are skipped: a .bak copy is not a tool.
flag_owned_anywhere() {
  _fo="$1"
  for _fp in "$TOOLS_DIR"/oc-* "$TOOLS_DIR"/*/oc-*; do
    [ -f "$_fp" ] || continue
    case "$_fp" in *.bak|*.bak-*) continue ;; esac
    if grep -qF -- "$_fo" "$_fp" 2>/dev/null; then return 0; fi
  done
  return 1
}

for cand in $CANDS; do
  IFS="$(printf '\t')" read -r cfile cln ctool cflag cverb <<EOC
$cand
EOC
  if [ "${ctool:-}" = "-" ]; then
    # #643: the flag sat past GAPMAX from EVERY tool token, so no owner can be
    # attributed. Reporting it against the nearest tool would be a false positive;
    # dropping it (the old behaviour) hides a phantom. So report it as its own
    # class, and only when NO tool owns the flag at all.
    if ! flag_owned_anywhere "$cflag"; then
      _uk="$cfile:$cln:$cflag"
      case " $SEEN_UNATTR " in
        *" $_uk "*) : ;;
        *) SEEN_UNATTR="$SEEN_UNATTR $_uk"
           add "${cfile#"$SKILL_DIR"/}" "$cln" "UNATTRIBUTABLE" "-" "$cflag" "no tool token within GAPMAX of it, and NO tool in tools/ carries this flag" ;;
      esac
    fi
    continue
  fi
  [ -n "${ctool:-}" ] || continue
  rel="${cfile#"$SKILL_DIR"/}"
  CTOOL_PATH="$(tool_path "$ctool" || true)"
  if [ -z "$CTOOL_PATH" ]; then
    key="$cfile:$cln:$ctool"
    case " $SEEN_UNKNOWN " in *" $key "*) continue ;; esac
    SEEN_UNKNOWN="$SEEN_UNKNOWN $key"
    if is_host_declared "$ctool"; then
      add "$rel" "$cln" "UNKNOWN-TOOL" "$ctool" "$cflag" "declared in HOST_TOOLS but NOT on PATH — install it; the law prescribes a tool this box lacks"
    else
      add "$rel" "$cln" "UNKNOWN-TOOL" "$ctool" "$cflag" "no such file in tools/ — the law invokes a tool that does not exist"
    fi
    continue
  fi
  if ! flag_known "$CTOOL_PATH" "$cflag"; then
    if citation_line "$cfile" "$cln" "$cflag"; then
      add_cit "$rel" "$cln" "$ctool" "$cflag"
    else
      add "$rel" "$cln" "PHANTOM-FLAG" "$ctool" "$cflag" "the tool's source contains ZERO occurrences of this flag"
    fi
  fi
  if [ -n "${cverb:-}" ] && dispatches "$CTOOL_PATH" && ! grep -qF -- "$cverb" "$CTOOL_PATH" 2>/dev/null; then
    add "$rel" "$cln" "PHANTOM-VERB" "$ctool" "$cverb" "the tool's source contains ZERO occurrences of this verb"
  fi
done
IFS="$OLDIFS"

# ---- #177: flag direct reads of the ledger outside oc-ledger --------------
# Readers must go through oc-ledger verbs (workers / worker / events / ok).
# Writes, existence checks, --ledger arguments, comments, and oc-ledger itself
# are allowed. The view (workers-ledger.json) and the record (events.jsonl)
# are both covered, so a later view removal cannot sneak a raw jsonl slurp
# back in.
scan_direct_ledger_reads() {
  python3 - "$TOOLS_DIR" <<'SCAN'
import os, re, sys
root = sys.argv[1]
skip_dir = {"tests", "docs", "__pycache__", "archive"}
skip_name_re = re.compile(r"\.(bak|pre-)|\.bak-")
allow_re = re.compile(
    r"--ledger\b|\boc-ledger\b|"
    r"\[\s*-f\b|os\.path\.exists|os\.path\.isfile|"
    r"^\s*#"
)
write_re = re.compile(
    r"(^|[^=<>!])>(?!>)|>>|"
    r"\becho\b|\bprintf\b|\btouch\b|\bcp\b|\bmv\b|\brm\b|\bls\b|"
    r"\bjson\.dump\b|\bmkdir\b"
)
read_re = re.compile(
    r"json\.load\s*\(|(?<![-\w])jq\b|"
    r"<\s*[\"'$]|([^$]|^)open\s*\(|\bcat\s+"
)
name_re = re.compile(
    r"workers-ledger\.json|events\.jsonl|"
    r"\$LEDGER\b|\$OC_ROSTER_LEDGER\b|\$OC_FANOUT_LEDGER\b|"
    r"\$\{LEDGER\}|\$\{OC_ROSTER_LEDGER\}|\$\{OC_FANOUT_LEDGER\}"
)
findings = []
for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = [d for d in dirnames if d not in skip_dir and not d.startswith(".")]
    for fn in filenames:
        if skip_name_re.search(fn):
            continue
        path = os.path.join(dirpath, fn)
        base = os.path.basename(path)
        if base in ("oc-ledger", "oc-lint-laws"):
            continue
        if not os.path.isfile(path):
            continue
        if not (base.startswith("oc-") or base.endswith((".sh", ".py"))):
            continue
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        rel = os.path.relpath(path, root)
        for i, line in enumerate(text.splitlines(), 1):
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            if not name_re.search(line):
                continue
            if "dirname" in line and "workers-ledger.json" not in line and "events.jsonl" not in line:
                continue
            if allow_re.search(line):
                continue
            if write_re.search(line) and not read_re.search(line):
                continue
            if not read_re.search(line):
                continue
            token = "workers-ledger.json" if "workers-ledger.json" in line else (
                "events.jsonl" if "events.jsonl" in line else "$LEDGER")
            findings.append((rel, i, token, s[:160]))
for rel, i, token, s in findings:
    print("%s\t%s\t%s\t%s" % (rel, i, token, s))
SCAN
}

while IFS="$(printf '\t')" read -r _lr_rel _lr_ln _lr_tok _lr_detail; do
  [ -n "${_lr_rel:-}" ] || continue
  add "tools/${_lr_rel}" "$_lr_ln" "DIRECT-LEDGER-READ" "oc-ledger" "$_lr_tok" "direct read of the ledger; go through oc-ledger verbs: ${_lr_detail}"
done < <(scan_direct_ledger_reads)

